[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 Words of Wonders\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ubc30\uc6b0\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: **STEP1** - \ubb38\uc790 \uc5f0\uacb0\uacfc \uac19\uc740 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. **STEP2** - 'CAT' \ub610\ub294 'DOG'\uc640 \uac19\uc740 \uac04\ub2e8\ud55c \ub2e8\uc5b4\ub97c \uc870\ud569\ud558\uc5ec \uc778\ud130\ud398\uc774\uc2a4\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. **STEP3** - \uac8c\uc784\uc774 \uc81c\uc2dc\ud558\ub294 \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \uc774\ud574\ud558\uae30 \uc704\ud574 \ud78c\ud2b8 \uc2dc\uc2a4\ud15c\uc744 \uc801\uc808\ud788 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ub2e8\uacc4\uc5d0\uc11c\ub294 \uac8c\uc784\uc774 'BAT'\ub77c\ub294 \ub2e8\uc5b4\ub97c \ud78c\ud2b8\ub85c \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uac8c\uc784\uc758 \uc9c0\ud615\uc744 \uc548\ub0b4\ud558\ub294 \uc9c0\ub3c4\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Words of Wonders\uc5d0\uc11c \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc5d0\uc11c \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc740 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. **STEP1** - \uc5b4\ub824\uc6b4 \ubb38\uc790 \uc870\ud569\uc5d0 \ub9c9\ud614\uc744 \ub54c '\uc11e\uae30'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc800\uc7a5\ud569\ub2c8\ub2e4. **STEP2** - \ub808\ubca8 \uc644\ub8cc\uc5d0 \uac00\uae4c\uc6cc\uc84c\uc9c0\ub9cc \ub9c8\uc9c0\ub9c9 \ub2e8\uc5b4\uac00 \ud544\uc694\ud560 \ub54c '\ub2e8\uc5b4 \ub4dc\ub7ec\ub0b4\uae30' \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. **STEP3** - \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uacb0\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc11e\uae30' \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud55c \ud6c4 '\ub2e8\uc5b4 \ub4dc\ub7ec\ub0b4\uae30'\ub97c \uc0ac\uc6a9\ud558\uba74 \ubcf5\uc7a1\ud55c \ud37c\uc990\uc744 \ube60\ub974\uac8c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\uc6cc\uc5c5\uc744 \uc77c\ucc0d \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0 \uc800\uc7a5\ud558\ub294 \uac83\uc774 \uc885\uc885 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "Words of Wonders\uc5d0\uc11c \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc640 \uc77c\ubc18 \ub808\ubca8\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc5d0\uc11c \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc640 \uc77c\ubc18 \ub808\ubca8\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: **1** - \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ub3d9\uc804\uacfc \ud30c\uc6cc\uc5c5\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \ubc18\uba74, \uc77c\ubc18 \ub808\ubca8\uc740 \ubcc4\uacfc \uc9c4\ud589 \uc0c1\ud669\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. **2** - \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub9e4\uc77c \ub3cc\uc544\uc624\ub3c4\ub85d \uc7a5\ub824\ud558\ub294 \uc2dc\uac04 \uc81c\ud55c\uc774 \uc788\ub294 \ubc18\uba74, \uc77c\ubc18 \ub808\ubca8\uc740 \uc5b8\uc81c\ub4e0\uc9c0 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. **3** - \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc758 \ub09c\uc774\ub3c4\ub294 \uc885\uc885 \ub192\uc544\uc11c \uc555\ubc15\uac10 \uc18d\uc5d0\uc11c \ub2e8\uc5b4 \ud615\uc131 \ub2a5\ub825\uc744 \uc2dc\ud5d8\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 3\ubd84 \uc548\uc5d0 10\uac1c\uc758 \ub2e8\uc5b4\ub97c \ub9cc\ub4e4 \uac83\uc744 \uc694\uad6c\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc77c\ubc18 \ub808\ubca8\uc740 \uc2dc\uac04 \uc81c\ud55c\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \ub300 \uc77c\ubc18 \ub808\ubca8 | \ubcf4\uc0c1: \ub3d9\uc804 \ub300 \ubcc4 | \uc2dc\uac04 \uc81c\ud55c: \uc788\uc74c \ub300 \uc5c6\uc74c | \ub09c\uc774\ub3c4: \ub192\uc74c \ub300 \ub2e4\uc591\ud568]"}, {"question": "Words of Wonders\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Words of Wonders\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4: **1** - \ub2e8\uc5b4 \uae38\uc774: \ub2e8\uc5b4\uac00 \uae38\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'ELEPHANT'\ub294 'CAT'\ubcf4\ub2e4 \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. **2** - \ubb38\uc790 \ud76c\uadc0\ub3c4: 'Q'\ub098 'Z'\uc640 \uac19\uc740 \ud754\ud558\uc9c0 \uc54a\uc740 \ubb38\uc790\ub97c \uc0ac\uc6a9\ud558\uba74 \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. **3** - \ubcf4\ub108\uc2a4 \ud0c0\uc77c: \ub354\ube14 \ub610\ub294 \ud2b8\ub9ac\ud50c \ubb38\uc790 \uc810\uc218\uc640 \uac19\uc740 \ubcf4\ub108\uc2a4 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uba74 \uc810\uc218\uac00 \uacf1\ud574\uc9d1\ub2c8\ub2e4. **STEP1** - \uac00\ub2a5\ud55c \uac00\uc7a5 \uae34 \ub2e8\uc5b4\ub97c \ub9cc\ub4e4\ub824\uace0 \ud569\ub2c8\ub2e4. **STEP2** - \uac00\ub2a5\ud560 \ub54c \ud76c\uadc0\ud55c \ubb38\uc790\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. **STEP3** - \ucd5c\ub300 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \ubcf4\ub108\uc2a4 \ud0c0\uc77c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ub178\ub824\ubd05\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub2e8\uc5b4 \ud615\uc131 \u2192 \ubb38\uc790 \ud76c\uadc0\ub3c4 \ud655\uc778 \u2192 \ubcf4\ub108\uc2a4 \ud0c0\uc77c \ud65c\uc131\ud654 \u2192 \ucd5c\uc885 \uc810\uc218 \uacc4\uc0b0]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 Words of Wonders\uc5d0\uc11c \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 Words of Wonders\uc5d0\uc11c \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc774 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: **STEP1** - 'UN-' \ub610\ub294 '-ING'\uc640 \uac19\uc740 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4 \ud328\ud134\uacfc \uc811\ub450\uc0ac/\uc811\ubbf8\uc0ac\ub97c \uc554\uae30\ud558\uc5ec \ub2e8\uc5b4\ub97c \uc2e0\uc18d\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. **STEP2** - '\uc11e\uae30' \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uc5ec \ubb38\uc790\ub97c \uc7ac\ubc30\uc5f4\ud558\uace0 \uc228\uaca8\uc9c4 \ub2e8\uc5b4\ub97c \ub354 \uc27d\uac8c \ucc3e\uc2b5\ub2c8\ub2e4. **STEP3** - \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \ubcf4\ub4dc\ub97c \uc2a4\uce94\ud558\uc5ec \uc7a0\uc7ac\uc801\uc778 \ub2e8\uc5b4 \uc870\ud569\uc744 \ubbf8\ub9ac \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 50\ub2e8\uacc4\uc5d0\uc11c\ub294 '\uc804\ub7b5'\uc774\ub77c\ub294 \ub2e8\uc5b4\ub97c \uc77c\ucc0d \ubc1c\uacac\ud558\uba74 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784 \ubcf4\ub4dc\ub97c \uccb4\uc2a4\ud310\uc73c\ub85c \uc0dd\uac01\ud558\uba74 \ubbf8\ub9ac \uacc4\ud68d\ud558\ub294 \uac83\uc774 \uc2b9\ub9ac\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4.]"}, {"question": "Words of Wonders\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud569\ub2c8\ub2e4: **STEP1** - '\uc11e\uae30'\uc640 '\ub2e8\uc5b4 \ub4dc\ub7ec\ub0b4\uae30'\uc640 \uac19\uc740 \ud544\uc218 \ud30c\uc6cc\uc5c5\uc5d0 \ucf54\uc778\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. **STEP2** - \uc678\ud615 \uc544\uc774\ud15c\uacfc \uac19\uc740 \ubd88\ud544\uc694\ud55c \uad6c\ub9e4\ub294 \uc5ec\uc720 \uc788\ub294 \ucf54\uc778 \uc608\uc0b0\uc774 \uc788\uc744 \ub54c\uae4c\uc9c0 \ud53c\ud569\ub2c8\ub2e4. **STEP3** - \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uace0 \uad11\uace0\ub97c \uc2dc\uccad\ud558\uc5ec \uc2e4\uc81c \ub3c8\uc744 \uc4f0\uc9c0 \uc54a\uace0 \ud1b5\ud654\ub97c \uc313\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 50\uac1c\uc758 \ub3d9\uc804\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ucf54\uc778\uc744 \ubc14\ub85c \uc0ac\uc6a9\ud558\uc9c0\ub9cc, \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0 \uc800\uc7a5\ud558\ub294 \uac83\uc774 \uc885\uc885 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "Words of Wonders\uc758 \ub808\ubca8 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615 \uc7a1\ud78c \ub09c\uc774\ub3c4 \uace1\uc120\uc744 \ubcf4\uc7a5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc758 \ub808\ubca8 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc74c\uacfc \uac19\uc774 \uade0\ud615 \uc7a1\ud78c \ub09c\uc774\ub3c4 \uace1\uc120\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4: **1** - \uc810\ucc28\uc801\uc778 \ubb38\uc790 \uc870\ud569\uacfc \ub2e8\uc5b4 \uae38\uc774\uc758 \ub3c4\uc785. **2** - \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \ubcf4\ub108\uc2a4 \ud0c0\uc77c\uacfc \uc7a5\uc560\ubb3c\uc744 \ud3ec\ud568\ud558\uc5ec \ubcf5\uc7a1\uc131\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. **3** - \ud50c\ub808\uc774\uc5b4\uc758 \uc131\ub2a5\uc5d0 \ub530\ub77c \uc810\uc218 \uc694\uac74\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub808\ubca8\uc5d0\uc11c\ub294 15\uac1c\uc758 \ub2e8\uc5b4\ub97c \uc0dd\uc131\ud574\uc57c \ud558\uc9c0\ub9cc, 20\ub808\ubca8\uc5d0\uc11c\ub294 \uae38\uc774\uac00 \ub354 \uae34 20\uac1c\uc758 \ub2e8\uc5b4\ub97c \uc0dd\uc131\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: 1\ub808\ubca8 \ub300 20\ub808\ubca8 | \ub2e8\uc5b4 \uae38\uc774: \uc9e7\uc74c \ub300 \ud07c | \ubcf4\ub108\uc2a4 \ud0c0\uc77c: \uc5c6\uc74c \ub300 \uc5ec\ub7ec \uac1c | \uc810\uc218 \uc694\uad6c \uc0ac\ud56d: \ub0ae\uc74c \ub300 \ub192\uc74c]"}, {"question": "\uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c Words of Wonders\ub97c \ud50c\ub808\uc774\ud558\ub824\uba74 \uc5b4\ub5a4 \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc774 \ud544\uc694\ud569\ub2c8\uae4c?", "answer": "\uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c Words of Wonders\ub97c \ud50c\ub808\uc774\ud558\ub824\uba74 \ub2e4\uc74c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: **1** - \uc5ec\ub7ec \uae30\uae30 \uac04 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uae30 \uc704\ud55c \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0. **2** - iOS \ubc0f Android \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ubaa8\ub4e0 \uae30\uae30\uc5d0 \uac8c\uc784 \uc124\uce58. **3** - \ub370\uc774\ud130 \uc77c\uad00\uc131\uc744 \uc704\ud574 \uac01 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c \ub808\ubca8\uc744 \uc2dc\uc791\ud558\uba74 \ud0dc\ube14\ub9bf\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc740 \uc62c\ubc14\ub978 \ub85c\uadf8\uc778\uc774 \uc788\ub294 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \ud074\ub77c\uc6b0\ub4dc \ubb38\uc11c\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Words of Wonders\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub098 \ube44\ubc00 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 Words of Wonders\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub098 \ube44\ubc00 \ucf58\ud150\uce20\ub97c \ucc3e\uae30 \uc704\ud574 \ub2e4\uc74c\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: **STEP1** - \ubaa8\ub4e0 \ubaa8\uc74c\uc744 \ud558\ub098\uc758 \ub2e8\uc5b4\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\uc740 \ub35c \uba85\ubc31\ud55c \ub2e8\uc5b4 \uc870\ud569\uc744 \ud0d0\uc0c9\ud569\ub2c8\ub2e4. **STEP2** - \ub808\ubca8 \ud14c\ub9c8\uc640 \uc228\uaca8\uc9c4 \ub2e8\uc5b4\ub97c \uc554\uc2dc\ud558\ub294 \ud78c\ud2b8\uc5d0 \uc8fc\uc758\ud569\ub2c8\ub2e4. **STEP3** - \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ube44\ubc00\uc744 \uacf5\uc720\ud558\uace0 \ubc1c\uacac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc790\uc5f0 \uc8fc\uc81c\uc758 \ub808\ubca8\uc5d0\uc11c '\ubb34\uc9c0\uac1c'\ub77c\ub294 \ub2e8\uc5b4\ub97c \ub9cc\ub4e4\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774 \uc2dc\uc791\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubb3b\ud78c \ubcf4\ubb3c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ucc3e\uc73c\ub824\uba74 \uc778\ub0b4\uc640 \ucc3d\uc758\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "Words of Wonders\uc5d0\uc11c \uc5f0\ud328\uc5d0\uc11c \ud68c\ubcf5\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Words of Wonders\uc5d0\uc11c \uc5f0\ud328\uc5d0\uc11c \ud68c\ubcf5\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: **STEP1** - \ub9c8\uc74c\uc744 \ube44\uc6b0\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc73c\ub85c \ub3cc\uc544\uac00\uae30 \uc704\ud574 \uc7a0\uc2dc \ud734\uc2dd\uc744 \ucde8\ud569\ub2c8\ub2e4. **STEP2** - \uacfc\uac70 \ub808\ubca8\uc744 \uac80\ud1a0\ud558\uc5ec \ub2e8\uc5b4 \uc120\ud0dd\uc5d0\uc11c\uc758 \ud328\ud134\uc774\ub098 \uc2e4\uc218\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. **STEP3** - \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 25\ub808\ubca8\uc5d0\uc11c \ub9c9\ud614\ub2e4\uba74 '\uc11e\uae30' \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec '\ud034\uc988'\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \ub2e8\uc5b4\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uacc4\uc18d \uc9c4\ud589\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \ud734\uc2dd\uc744 \ucde8\ud558\ub294 \uac83\uc774 \uc885\uc885 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}]
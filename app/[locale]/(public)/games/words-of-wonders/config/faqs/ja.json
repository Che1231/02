[{"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u5b66\u3076\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u5b66\u3076\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u304b\u3089\u59cb\u3081\u3066\u3001\u6587\u5b57\u3092\u7e4b\u3052\u308b\u305f\u3081\u306e\u30b9\u30ef\u30a4\u30d7\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5b66\u3073\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u521d\u671f\u30ec\u30d9\u30eb\u3067\u300cCAT\u300d\u3084\u300cDOG\u300d\u306a\u3069\u306e\u7c21\u5358\u306a\u5358\u8a9e\u3092\u4f5c\u308a\u3001\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u306b\u6163\u308c\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u30d2\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u9069\u5ea6\u306b\u6d3b\u7528\u3057\u3001\u30b2\u30fc\u30e0\u304c\u63d0\u793a\u3059\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306f\u300cBAT\u300d\u3068\u3044\u3046\u5358\u8a9e\u3092\u30d2\u30f3\u30c8\u306b\u3057\u3066\u304f\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u6bd4\u55a9\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306f\u3001\u30b2\u30fc\u30e0\u306e\u5730\u5f62\u3092\u6848\u5185\u3057\u3066\u304f\u308c\u308b\u5730\u56f3\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u3046\u3053\u3068\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u3046\u3053\u3068\u306f\u3001\u9032\u6b69\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u96e3\u3057\u3044\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\u3067\u8a70\u307e\u3063\u3066\u3044\u308b\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306b\u3001\u300c\u30b7\u30e3\u30c3\u30d5\u30eb\u300d\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4fdd\u5b58\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u30ec\u30d9\u30eb\u306e\u5b8c\u4e86\u306b\u3042\u3068\u4e00\u6b69\u3068\u3044\u3046\u6642\u306b\u3001\u300c\u5358\u8a9e\u306e\u30ec\u30d9\u30ea\u30f3\u30b0\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u6700\u5927\u9650\u306e\u52b9\u679c\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u4f8b\u3048\u3070\u300c\u30b7\u30e3\u30c3\u30d5\u30eb\u300d\u306b\u7d9a\u3044\u3066\u300c\u5358\u8a9e\u306e\u30ec\u30d9\u30ea\u30f3\u30b0\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u7d20\u65e9\u304f\u89e3\u6c7a\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u7b56\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u65e9\u304f\u4f7f\u7528\u3059\u308b\u3053\u3068\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306b\u4fdd\u5b58\u3059\u308b\u65b9\u304c\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u3088\u308a\u512a\u308c\u305f\u7d50\u679c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u306e\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002**1**\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u7279\u5225\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u306f\u661f\u3068\u9032\u6357\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002**2**\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u6642\u9593\u5236\u9650\u304c\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6bce\u65e5\u623b\u3063\u3066\u304f\u308b\u3053\u3068\u3092\u5968\u52b1\u3057\u307e\u3059\u3002\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u306f\u3044\u3064\u3067\u3082\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002**3**\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306e\u96e3\u6613\u5ea6\u306f\u9ad8\u304f\u3001\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u306e\u4e2d\u3067\u5358\u8a9e\u5f62\u6210\u30b9\u30ad\u30eb\u3092\u8a66\u3059\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f3\u5206\u4ee5\u5185\u306b10\u500b\u306e\u5358\u8a9e\u3092\u4f5c\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e00\u65b9\u3001\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7121\u5236\u9650\u306e\u6642\u9593\u3067\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u5bfe\u901a\u5e38\u306e\u30ec\u30d9\u30eb\uff5c\u5831\u916c\uff1a\u30b3\u30a4\u30f3\u5bfe\u661f\uff5c\u6642\u9593\u5236\u9650\uff1a\u3042\u308a\u5bfe\u306a\u3057\uff5c\u96e3\u6613\u5ea6\uff1a\u9ad8\u5bfe\u5909\u52d5]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u3068\u3001\u305d\u308c\u3092\u5de6\u53f3\u3059\u308b\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002**1**\uff1a\u5358\u8a9e\u306e\u9577\u3055\uff1a\u3088\u308a\u9577\u3044\u5358\u8a9e\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cELEPHANT\u300d\u306f\u300cCAT\u300d\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u307e\u3059\u3002**2**\uff1a\u6587\u5b57\u306e\u30ec\u30a2\u30ea\u30c6\u30a3\uff1a\u7a00\u306a\u6587\u5b57\uff08\u4f8b\u3048\u3070\u300cQ\u300d\u3084\u300cZ\u300d\u306a\u3069\uff09\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002**3**\uff1a\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\uff1a\u500d\u7387\u307e\u305f\u306f3\u500d\u306e\u6587\u5b57\u30dd\u30a4\u30f3\u30c8\u306e\u3088\u3046\u306a\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\u306b\u5f53\u305f\u308b\u3068\u3001\u30dd\u30a4\u30f3\u30c8\u304c\u500d\u52a0\u3055\u308c\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u53ef\u80fd\u306a\u9650\u308a\u6700\u9577\u306e\u5358\u8a9e\u3092\u4f5c\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u4f7f\u7528\u53ef\u80fd\u306a\u5834\u5408\u3001\u7a00\u306a\u6587\u5b57\u3092\u512a\u5148\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u6226\u7565\u7684\u306b\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5358\u8a9e\u306e\u5f62\u6210\u2192\u6587\u5b57\u306e\u30ec\u30a2\u30ea\u30c6\u30a3\u30c1\u30a7\u30c3\u30af\u2192\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\u306e\u6d3b\u6027\u5316\u2192\u6700\u7d42\u30b9\u30b3\u30a2\u306e\u8a08\u7b97]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u52b9\u7387\u6027\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u52b9\u7387\u6027\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u4e00\u822c\u7684\u306a\u5358\u8a9e\u30d1\u30bf\u30fc\u30f3\u3068\u63a5\u982d\u8f9e/\u63a5\u5c3e\u8f9e\uff08\u4f8b\u3048\u3070\u300cUN-\u300d\u3084\u300c-ING\u300d\u306a\u3069\uff09\u3092\u6697\u8a18\u3057\u3066\u3001\u5358\u8a9e\u3092\u7d20\u65e9\u304f\u5f62\u6210\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u300c\u30b7\u30e3\u30c3\u30d5\u30eb\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u6587\u5b57\u3092\u4e26\u3079\u66ff\u3048\u3066\u3001\u96a0\u308c\u305f\u5358\u8a9e\u3092\u3088\u308a\u7c21\u5358\u306b\u767a\u898b\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u79fb\u52d5\u306e\u524d\u306b\u3001\u6f5c\u5728\u7684\u306a\u5358\u8a9e\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u6b21\u306e\u624b\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb50\u3067\u306f\u3001\u65e9\u671f\u306b\u300cSTRATEGY\u300d\u3068\u3044\u3046\u5358\u8a9e\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\uff1a\u30b2\u30fc\u30e0\u30dc\u30fc\u30c9\u3092\u30c1\u30a7\u30b9\u76e4\u3068\u6349\u3048\u3001\u5148\u3092\u8aad\u3080\u3053\u3068\u304c\u52dd\u5229\u3078\u306e\u30ab\u30ae\u3067\u3059\u3002]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u306e\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u306e\u7ba1\u7406\u306b\u304a\u3051\u308b\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u306e\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u306e\u7ba1\u7406\u3092\u52b9\u679c\u7684\u306b\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u30b3\u30a4\u30f3\u306f\u300c\u30b7\u30e3\u30c3\u30d5\u30eb\u300d\u3084\u300c\u5358\u8a9e\u306e\u30ec\u30d9\u30ea\u30f3\u30b0\u300d\u306e\u3088\u3046\u306a\u4e0d\u53ef\u6b20\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u88c5\u98fe\u54c1\u306a\u3069\u306e\u4e0d\u5fc5\u8981\u306a\u8cfc\u5165\u306f\u3001\u4f59\u88d5\u306e\u3042\u308b\u30b3\u30a4\u30f3\u306e\u8caf\u91d1\u304c\u3067\u304d\u308b\u307e\u3067\u907f\u3051\u307e\u3057\u3087\u3046\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3001\u5e83\u544a\u3092\u898b\u3066\u7121\u6599\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u3067\u3001\u5b9f\u8cbb\u3092\u652f\u6255\u308f\u305a\u306b\u901a\u8ca8\u3092\u5897\u3084\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u306850\u30b3\u30a4\u30f3\u304c\u7372\u5f97\u3055\u308c\u307e\u3059\u3002[\u8907\u6570\u7b56\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b3\u30a4\u30f3\u3092\u3059\u3050\u306b\u4f7f\u3044\u307e\u3059\u304c\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306b\u7bc0\u7d04\u3059\u308b\u65b9\u304c\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u826f\u3044\u7d50\u679c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30ec\u30d9\u30eb\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u96e3\u6613\u5ea6\u66f2\u7dda\u3092\u5b9f\u73fe\u3059\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u306e\u30ec\u30d9\u30eb\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5747\u8861\u306e\u3068\u308c\u305f\u96e3\u6613\u5ea6\u66f2\u7dda\u3092\u5b9f\u73fe\u3059\u308b\u305f\u3081\u306b\u3001\u6b21\u306e\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002**1**\uff1a\u6bb5\u968e\u7684\u306b\u65b0\u3057\u3044\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\u3068\u5358\u8a9e\u306e\u9577\u3055\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002**2**\uff1a\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u3067\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\u3084\u969c\u5bb3\u7269\u3092\u7d44\u307f\u8fbc\u3080\u3053\u3068\u3067\u3001\u8907\u96d1\u3055\u3092\u5897\u3057\u307e\u3059\u3002**3**\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u3001\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u8981\u4ef6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f15\u500b\u306e\u5358\u8a9e\u306e\u4f5c\u6210\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3088\u308a\u9577\u3044\u5358\u8a9e\u306720\u500b\u306e\u5358\u8a9e\u304c\u5fc5\u8981\u3067\u3059\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u30ec\u30d9\u30eb1\u5bfe\u30ec\u30d9\u30eb20\uff5c\u5358\u8a9e\u306e\u9577\u3055\uff1a\u77ed\u304f\u5bfe\u9577\u304f\uff5c\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30eb\uff1a\u306a\u3057\u5bfe\u8907\u6570\uff5c\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u8981\u4ef6\uff1a\u4f4e\u304f\u5bfe\u9ad8\u304f]"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3092\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u304c\u5fc5\u8981\u3067\u3059\u3002**1**\uff1a\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u305f\u3081\u306b\u3001\u5b89\u5b9a\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u304c\u5fc5\u8981\u3067\u3059\u3002**2**\uff1aiOS\u304a\u3088\u3073Android\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e21\u65b9\u3067\u3001\u3059\u3079\u3066\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30b2\u30fc\u30e0\u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002**3**\uff1a\u30c7\u30fc\u30bf\u306e\u4e00\u8cab\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u5404\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96fb\u8a71\u3067\u30ec\u30d9\u30eb\u3092\u958b\u59cb\u3059\u308b\u3068\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u7d9a\u884c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\uff1a\u30b2\u30fc\u30e0\u306e\u9032\u6357\u3092\u30af\u30e9\u30a6\u30c9\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3068\u6349\u3048\u3001\u9069\u5207\u306a\u30ed\u30b0\u30a4\u30f3\u3067\u3069\u306e\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u3082\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u660e\u3089\u304b\u306a\u5358\u8a9e\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8d85\u3048\u3066\u3001\u4f8b\u3048\u3070\u3001\u5358\u4e00\u306e\u5358\u8a9e\u306b\u3059\u3079\u3066\u306e\u6bcd\u97f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u30ec\u30d9\u30eb\u306e\u30c6\u30fc\u30de\u3068\u96a0\u3055\u308c\u305f\u5358\u8a9e\u3092\u793a\u5506\u3059\u308b\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3092\u6255\u3044\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u53c2\u52a0\u3057\u3066\u3001\u79d8\u5bc6\u3092\u5171\u6709\u3057\u3001\u767a\u898b\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u81ea\u7136\u3092\u30c6\u30fc\u30de\u306b\u3057\u305f\u30ec\u30d9\u30eb\u3067\u300cRAINBOW\u300d\u3068\u3044\u3046\u5358\u8a9e\u3092\u4f5c\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u6bd4\u55a9\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u57cb\u8535\u7269\u3068\u6349\u3048\u3001\u767a\u898b\u3059\u308b\u306b\u306f\u5fcd\u8010\u3068\u5275\u9020\u6027\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u8ca0\u3051\u306e\u9023\u9396\u304b\u3089\u56de\u5fa9\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u300c\u30ef\u30fc\u30c9\u30aa\u30d6\u30ef\u30f3\u30c0\u30fc\u30ba\u300d\u3067\u8ca0\u3051\u306e\u9023\u9396\u304b\u3089\u56de\u5fa9\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d71**\uff1a\u5fc3\u3092\u30af\u30ea\u30a2\u3057\u3066\u3001\u65b0\u3057\u3044\u8996\u70b9\u3067\u30b2\u30fc\u30e0\u306b\u623b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d72**\uff1a\u904e\u53bb\u306e\u30ec\u30d9\u30eb\u3092\u30ec\u30d3\u30e5\u30fc\u3057\u3066\u3001\u3042\u306a\u305f\u306e\u5358\u8a9e\u9078\u629e\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u9593\u9055\u3044\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002**\u30b9\u30c6\u30c3\u30d73**\uff1a\u56f0\u96e3\u306a\u30ec\u30d9\u30eb\u3092\u514b\u670d\u3059\u308b\u305f\u3081\u306b\u6226\u7565\u7684\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u8a70\u307e\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u300c\u30b7\u30e3\u30c3\u30d5\u30eb\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u300cQUIZ\u300d\u306e\u3088\u3046\u306a\u96a0\u308c\u305f\u5358\u8a9e\u304c\u898b\u3064\u304b\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002 [\u8907\u6570\u7b56\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u4eba\u3005\u306f\u4e57\u308a\u5207\u308b\u3053\u3068\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u4f11\u61a9\u3092\u53d6\u308b\u3053\u3068\u306e\u65b9\u304c\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u3088\u308a\u826f\u3044\u7d50\u679c\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}]
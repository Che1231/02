[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c Ooze Odyssey\uc758 \uae30\ubcf8 \uc774\ub3d9 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 \uac8c\uc784 \uc138\uacc4\ub97c \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\ub824\uba74 \ud654\uba74 \uc67c\ucabd\uc758 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc870\uc774\uc2a4\ud2f1\uc744 \uc704\ub85c \ubc00\uba74 \uce90\ub9ad\ud130\uac00 \uc55e\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub610\ud55c, \ubc29\ud5a5\ud0a4\ub97c \ub450 \ubc88 \ube60\ub974\uac8c \ud0ed\ud558\uc5ec \ube60\ub978 \ub3cc\uc9c4\uc744 \ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \uc720\uc6a9\ud569\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \uc601\uc5ed\uc5d0\uc11c \uc774\ub7ec\ud55c \uc774\ub3d9 \ubc29\ubc95\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc775\uc219\ud574\uc9c0\uc138\uc694."}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \uc774\ud6c4 Ooze Odyssey\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc5d0\uc11c 100\uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc790\uc6d0 \uad00\ub9ac\uac00 \ub9e4\uc6b0 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. STEP1: \uace0\uc704\ud5d8 \uc9c0\uc5ed\uc5d0\uc11c '\ube5b\ub098\ub294 \uc824\ub9ac'\uc640 \uac19\uc740 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: \ud544\uc218 \uc544\uc774\ud15c, \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825 \ud68c\ubcf5 \ubb3c\uc57d\uacfc \uac19\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc744 \uba3c\uc800 \uc81c\uc791\ud558\uc5ec \uade0\ud615 \uc788\ub294 \uc811\uadfc \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3: NPC\uc640 \ub0a8\ub294 \uc790\uc6d0\uc744 \uad50\ud658\ud558\uc5ec \ub354 \ub098\uc740 \uc7a5\ube44\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\uac1c\uc758 '\ube5b\ub098\ub294 \uc824\ub9ac'\ub97c '\uc824\ub9ac \uac11\uc637'\uc73c\ub85c \uad50\ud658\ud558\uba74 \ubc29\uc5b4\ub825\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ooze Odyssey\uc758 \uc804\ud22c \uc2dc\uc2a4\ud15c\uc774 \ub9f9\ub82c\ud55c \ud798\ubcf4\ub2e4 \uc804\uc220\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc120\ud638\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc758 \uc804\ud22c \uc2dc\uc2a4\ud15c\uc740 \uc804\uc220\uc801\uc778 \ud50c\ub808\uc774\ub97c \ubcf4\uc0c1\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub9f9\ub82c\ud55c \ud798\uc740 \uc790\uc6d0\uc744 \ube60\ub974\uac8c \uc18c\ubaa8\ud558\ub294 \ubc18\uba74, \ud658\uacbd\uc801\uc778 \uc704\ud5d8\uc694\uc18c\ub97c \ud65c\uc6a9\ud558\ub294 \uc804\uc220\uc801 \uc811\uadfc \ubc29\uc2dd\uc740 \uc804\ud22c\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc744 '\uc0b0\uc131 \uc6c5\ub369\uc774'\ub85c \uc720\uc778\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \uc18c\ubaa8\ud558\uc9c0 \uc54a\uace0\ub3c4 \ud070 \ub370\ubbf8\uc9c0\ub97c \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc801\uc73c\ub85c \uc0dd\uac01\ud558\ub3c4\ub85d \uc7a5\ub824\ud558\uc5ec \uac01 \ub9cc\ub0a8\uc744 \ub354\uc6b1 \ub9e4\ub825\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "Ooze Odyssey\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc591\ud55c \uc7ac\ub8cc\ub97c \uacb0\ud569\ud558\uc5ec \uc720\uc6a9\ud55c \uc544\uc774\ud15c\uc744 \ub9cc\ub4dc\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4. \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\ub294 '\uae30\ubcf8 \uc824\ub9ac', '\ud76c\uadc0 \uacb0\uc815', '\ub9c8\ubc95 \uc5d0\uc13c\uc2a4'\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\uac1c\uc758 '\uae30\ubcf8 \uc824\ub9ac'\uc640 1\uac1c\uc758 '\ud76c\uadc0 \uacb0\uc815'\uc744 \uacb0\ud569\ud558\uba74 \uc801\uad70\uc5d0 \ud6a8\uacfc\uc801\uc778 '\uc824\ub9ac \ud3ed\ud0c4'\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc81c\uc791\uc5d0 \ud544\uc694\ud55c \uad6c\uc131 \uc694\uc18c\uac00 \uc788\ub294\uc9c0 \ud56d\uc0c1 \uc790\uc2e0\uc758 \uc778\ubca4\ud1a0\ub9ac\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \uacbd\ud5d8\uc744 \uc704\ud574 Ooze Odyssey\uc5d0\uc11c \uc5b4\ub5a4 \uae30\uc220\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574\uc57c \ud558\ub098\uc694?", "answer": "Ooze Odyssey\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \uacbd\ud5d8\uc744 \uc704\ud574 \uacf5\uaca9 \ubc0f \ubc29\uc5b4 \ubaa8\ub450\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uae30\uc220\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. '\uc824\ub9ac \ubc29\ud328'\ub294 \uc0dd\uc874\uc131\uc744 \ub192\uc774\uace0, '\uc0b0\uc131 \ud3ed\ubc1c'\uc740 \ud070 \uc9c0\uc5ed \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc824\ub9ac \ubc29\ud328'\ub97c 3\ub2e8\uacc4\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc5b4\ub824\uc6b4 \uc804\ud22c\uc5d0\uc11c \ub9e4\uc6b0 \uadc0\uc911\ud55c 50%\uc758 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\ub97c \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ub09c\uad00\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\ub3c4\ub85d \uae30\uc220 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uade0\ud615 \uc788\uac8c \ud558\uc2ed\uc2dc\uc624."}, {"question": "Ooze Odyssey\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc11c\ub85c \ub2e4\ub978 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc2a4\ud1a0\ub9ac \uc9c4\ud589\uacfc \uc194\ub85c \ucc4c\ub9b0\uc9c0\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud300\uc6cc\ud06c\uc640 \uc870\uc815\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c '\uc824\ub9ac \ud568\uc815'\uc744 \uc0ac\uc6a9\ud55c \ud6c4 '\ubd88\uaf43 \ud3ed\ubc1c'\uacfc \uac19\uc740 \ud300\uc6d0\ub4e4\uacfc \ub2a5\ub825\uc744 \uacb0\ud569\ud558\uc5ec \uac15\ub825\ud55c \uc5f0\uacc4 \uacf5\uaca9\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ubaa8\ub4dc\ub294 \uace0\uc720\ud55c \ubcf4\uc0c1\uacfc \ucc4c\ub9b0\uc9c0\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Ooze Odyssey\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc774\uc804\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Ooze Odyssey\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. STEP1: \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. STEP2: \uac8c\uc784 \uc124\uc815\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. STEP3: PC\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uacf3\uc5d0\uc11c \uacc4\uc18d \uc9c4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130 \ub808\ubca8\uacfc \uc778\ubca4\ud1a0\ub9ac\ub294 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4."}, {"question": "Ooze Odyssey\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc740 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "Ooze Odyssey\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud48d\uc131\ud558\uac8c \ub9cc\ub4dc\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \ube44\ubc00 \uc911 \ud558\ub098\ub294 \uc77c\ub828\uc758 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c\ub9cc \uc811\uadfc\ud560 \uc218 \uc788\ub294 '\uace0\ub300 \uc824\ub9ac \uc0ac\uc6d0'\uc785\ub2c8\ub2e4. \uc774 \uc0ac\uc6d0\uc744 \ubc1c\uacac\ud558\uba74 \ubaa8\ub4e0 \ub2a5\ub825\uce58\ub97c 20% \uc99d\uac00\uc2dc\ud0a4\ub294 '\uc824\ub9ac \uc655\uad00'\uc744 \uc5bb\uac8c \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc740 \uac15\ub825\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784\uc758 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\uc640 \ud0d0\ud5d8 \uc694\uc18c\ub97c \ub354\uc6b1 \uae4a\uc774 \uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "Ooze Odyssey\uc758 \ud658\uacbd\uc801 \uc704\ud5d8 \uc694\uc18c\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Ooze Odyssey\uc758 \ud658\uacbd\uc801 \uc704\ud5d8 \uc694\uc18c, \uc608\ub97c \ub4e4\uc5b4 '\uc0b0\uc131 \uc6c5\ub369\uc774'\uc640 '\uc6a9\uc554 \ud750\ub984'\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc704\ud5d8 \uc694\uc18c\ub294 \ud50c\ub808\uc774\uc5b4\uc640 \uc801 \ubaa8\ub450\uc5d0\uac8c \ud53c\ud574\ub97c \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc744 '\uc0b0\uc131 \uc6c5\ub369\uc774'\ub85c \uc720\uc778\ud558\uc5ec \uc804\ud22c\uc5d0 \uc55e\uc11c \uc57d\ud654\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc704\ud5d8 \uc694\uc18c\ub97c \uc774\ud574\ud558\uace0 \ud65c\uc6a9\ud558\uba74 \uc5b4\ub824\uc6b4 \uc0c1\ud669\uc744 \uc804\ub7b5\uc801\uc778 \uae30\ud68c\ub85c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc911\uae09 PC\uc5d0\uc11c Ooze Odyssey\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \ucd5c\uc801 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc911\uae09 PC\uc5d0\uc11c Ooze Odyssey\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \ub2e4\uc74c \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. '\ud14d\uc2a4\ucc98 \ud488\uc9c8'\uc744 \uc911\uac04, '\uc250\uc774\ub354 \ud488\uc9c8'\uc744 \ub0ae\uc74c, '\uc548\ud2f0\uc568\ub9ac\uc5b4\uc2f1'\uc744 FXAA\ub85c \uc124\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub7ec\ud55c \uc124\uc815\uc740 \uc2dc\uac01\uc801 \ucda9\uc2e4\ub3c4\uc640 \uc131\ub2a5 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \uc720\uc9c0\ud558\uc5ec \uac8c\uc784\uc774 \uc548\uc815\uc801\uc778 60 FPS\ub85c \uc2e4\ud589\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ud56d\uc0c1 \uc2dc\uc2a4\ud15c \uc131\ub2a5\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\uace0 \ucd5c\uc0c1\uc758 \uacbd\ud5d8\uc744 \uc704\ud574 \ud544\uc694\uc5d0 \ub530\ub77c \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}]
[{"question": "\u65b0\u624b\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u5982\u4f55\u8fdb\u884c\u57fa\u7840\u79fb\u52a8\uff1f", "answer": "\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\uff0c\u57fa\u7840\u79fb\u52a8\u5bf9\u4e8e\u5728\u6e38\u620f\u4e2d\u4e16\u754c\u4e2d\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u8981\u79fb\u52a8\u4f60\u7684\u89d2\u8272\uff0c\u8bf7\u4f7f\u7528\u5c4f\u5e55\u5de6\u4fa7\u7684\u64cd\u7eb5\u6746\u3002\u4f8b\u5982\uff0c\u5411\u4e0a\u6ed1\u52a8\u64cd\u7eb5\u6746\u4f1a\u4f7f\u4f60\u7684\u89d2\u8272\u5411\u524d\u79fb\u52a8\u3002\u6b64\u5916\uff0c\u4f60\u8fd8\u53ef\u4ee5\u901a\u8fc7\u5728\u4efb\u4f55\u65b9\u5411\u4e0a\u53cc\u51fb\u6765\u6267\u884c\u5feb\u901f\u51b2\u523a\uff0c\u8fd9\u5bf9\u4e8e\u8eb2\u907f\u969c\u788d\u7269\u5f88\u6709\u7528\u3002\u5728\u6559\u7a0b\u533a\u57df\u7ec3\u4e60\u8fd9\u4e9b\u79fb\u52a8\uff0c\u4ee5\u4fbf\u719f\u6089\u5b83\u4eec\u3002"}, {"question": "\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u73a9\u6ee1 100 \u5c0f\u65f6\u540e\uff0c\u6700\u4f73\u7684\u8d44\u6e90\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u73a9\u6ee1 100 \u5c0f\u65f6\u540e\uff0c\u8d44\u6e90\u7ba1\u7406\u663e\u5f97\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u4f18\u5148\u6536\u96c6\u9ad8\u98ce\u9669\u533a\u57df\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u201c\u53d1\u5149\u9ecf\u6db2\u201d\u3002\u6b65\u9aa4\u4e8c\uff1a\u91c7\u7528\u5e73\u8861\u7684\u65b9\u6cd5\uff0c\u4f18\u5148\u5236\u4f5c\u5fc5\u8981\u7269\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u836f\u6c34\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0e NPC \u4ea4\u6613\u5269\u4f59\u8d44\u6e90\uff0c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u88c5\u5907\u3002\u4f8b\u5982\uff0c\u7528 10 \u4e2a\u201c\u53d1\u5149\u9ecf\u6db2\u201d\u4ea4\u6362\u4e00\u4e2a\u201c\u9ecf\u6db2\u76d4\u7532\u201d\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u9632\u5fa1\u529b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u6218\u6597\u7cfb\u7edf\u66f4\u9752\u7750\u6218\u672f\u800c\u975e\u86ee\u529b\uff1f", "answer": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u6218\u6597\u7cfb\u7edf\u65e8\u5728\u5956\u52b1\u6218\u672f\u73a9\u6cd5\u3002\u4e0e\u86ee\u529b\uff08\u5feb\u901f\u6d88\u8017\u8d44\u6e90\uff09\u4e0d\u540c\uff0c\u6218\u672f\u65b9\u6cd5\uff0c\u4f8b\u5982\u5229\u7528\u73af\u5883\u5371\u5bb3\uff0c\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002\u4f8b\u5982\uff0c\u5f15\u8bf1\u654c\u4eba\u8fdb\u5165\u201c\u9178\u6c60\u201d\u53ef\u4ee5\u9020\u6210\u5927\u91cf\u4f24\u5bb3\uff0c\u800c\u65e0\u9700\u8017\u8d39\u4f60\u7684\u7cbe\u529b\u3002\u6b64\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u6218\u7565\u601d\u8003\uff0c\u4f7f\u6bcf\u6b21\u906d\u9047\u90fd\u66f4\u5f15\u4eba\u5165\u80dc\u3002"}, {"question": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u5236\u4f5c\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f\u5173\u952e\u7ec4\u4ef6\u662f\u4ec0\u4e48\uff1f", "answer": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u5236\u4f5c\u7cfb\u7edf\u6d89\u53ca\u7ec4\u5408\u5404\u79cd\u6750\u6599\u6765\u5236\u4f5c\u6709\u7528\u7684\u7269\u54c1\u3002\u5173\u952e\u7ec4\u4ef6\u5305\u62ec\u201c\u57fa\u7840\u9ecf\u6db2\u201d\u3001\u201c\u7a00\u6709\u6676\u4f53\u201d\u548c\u201c\u9b54\u6cd5\u7cbe\u534e\u201d\u3002\u4f8b\u5982\uff0c\u7ec4\u5408 5 \u4e2a\u201c\u57fa\u7840\u9ecf\u6db2\u201d\u548c 1 \u4e2a\u201c\u7a00\u6709\u6676\u4f53\u201d\u53ef\u4ee5\u5236\u4f5c\u201c\u9ecf\u6db2\u70b8\u5f39\u201d\uff0c\u5b83\u6709\u6548\u5730\u5bf9\u4ed8\u654c\u4eba\u7fa4\u3002\u59cb\u7ec8\u5173\u6ce8\u4f60\u7684\u80cc\u5305\uff0c\u4ee5\u786e\u4fdd\u4f60\u62e5\u6709\u5236\u4f5c\u6240\u9700\u7684\u6240\u6709\u7ec4\u4ef6\u3002"}, {"question": "\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\uff0c\u4e3a\u4e86\u83b7\u5f97\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u4e3a\u4e86\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u83b7\u5f97\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u589e\u5f3a\u653b\u51fb\u548c\u9632\u5fa1\u7684\u6280\u80fd\u3002\u201c\u9ecf\u6db2\u62a4\u76fe\u201d\u63d0\u9ad8\u4e86\u4f60\u7684\u751f\u5b58\u80fd\u529b\uff0c\u201c\u9178\u7206\u201d\u9020\u6210\u5927\u91cf\u533a\u57df\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u9ecf\u6db2\u62a4\u76fe\u201d\u5347\u7ea7\u5230 3 \u7ea7\u53ef\u4ee5\u6321\u4f4f 50% \u7684\u4f24\u5bb3\uff0c\u8fd9\u5728\u8270\u82e6\u7684\u6218\u6597\u4e2d\u975e\u5e38\u5b9d\u8d35\u3002\u5e73\u8861\u4f60\u7684\u6280\u80fd\u5347\u7ea7\uff0c\u4ee5\u9002\u5e94\u5404\u79cd\u6311\u6218\u3002"}, {"question": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u4e13\u6ce8\u4e8e\u5267\u60c5\u53d1\u5c55\u548c\u5355\u4eba\u6311\u6218\u3002\u7136\u800c\uff0c\u591a\u4eba\u6a21\u5f0f\u5f3a\u8c03\u56e2\u961f\u5408\u4f5c\u548c\u534f\u8c03\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u961f\u53cb\u7ed3\u5408\u6280\u80fd\u521b\u9020\u5f3a\u5927\u7684\u8fde\u51fb\uff0c\u4f8b\u5982\u4f7f\u7528\u201c\u9ecf\u6db2\u9677\u9631\u201d\u540e\u8ddf\u201c\u706b\u7130\u51b2\u51fb\u201d\u4ee5\u6700\u5927\u5316\u4f24\u5bb3\u3002\u6bcf\u4e2a\u6a21\u5f0f\u90fd\u63d0\u4f9b\u72ec\u7279\u7684\u5956\u52b1\u548c\u6311\u6218\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u9ecf\u6db2\u5965\u5fb7\u8d5b\u6e38\u620f\u8fdb\u5ea6\u4ece\u79fb\u52a8\u7aef\u8f6c\u79fb\u5230\u7535\u8111\u7aef\uff1f", "answer": "\u5c06\u4f60\u7684\u9ecf\u6db2\u5965\u5fb7\u8d5b\u6e38\u620f\u8fdb\u5ea6\u4ece\u79fb\u52a8\u7aef\u8f6c\u79fb\u5230\u7535\u8111\u7aef\u975e\u5e38\u7b80\u5355\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6e38\u620f\u8bbe\u7f6e\u4e2d\u7684\u4e91\u7aef\u5b58\u6863\u529f\u80fd\u5c06\u4f60\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4f60\u7684\u7535\u8111\u4e0a\u4e0b\u8f7d\u4e91\u7aef\u5b58\u6863\uff0c\u4ee5\u7ee7\u7eed\u4f60\u4e0a\u6b21\u79bb\u5f00\u7684\u5730\u65b9\u3002\u4f8b\u5982\uff0c\u4f60\u7684\u89d2\u8272\u7b49\u7ea7\u548c\u80cc\u5305\u5185\u5bb9\u5c06\u8de8\u5e73\u53f0\u540c\u6b65\u3002"}, {"question": "\u5728\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u79d8\u5bc6\uff0c\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u5145\u6ee1\u4e86\u4e30\u5bcc\u7684\u9690\u85cf\u79d8\u5bc6\uff0c\u4e30\u5bcc\u4e86\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u79d8\u5bc6\u662f\u201c\u53e4\u4ee3\u9ecf\u6db2\u795e\u5e99\u201d\uff0c\u53ea\u6709\u901a\u8fc7\u89e3\u51b3\u4e00\u7cfb\u5217\u8c1c\u9898\u624d\u80fd\u8fdb\u5165\u3002\u53d1\u73b0\u8fd9\u4e2a\u795e\u5e99\u4f1a\u5956\u52b1\u4f60\u201c\u9ecf\u6db2\u738b\u51a0\u201d\uff0c\u5b83\u4f1a\u5c06\u6240\u6709\u5c5e\u6027\u63d0\u5347 20%\u3002\u8fd9\u4e9b\u79d8\u5bc6\u4e0d\u4ec5\u63d0\u4f9b\u5f3a\u5927\u7684\u5956\u52b1\uff0c\u800c\u4e14\u8fd8\u589e\u52a0\u4e86\u6e38\u620f\u80cc\u666f\u6545\u4e8b\u548c\u63a2\u7d22\u5143\u7d20\u7684\u6df1\u5ea6\u3002"}, {"question": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u7684\u73af\u5883\u5371\u5bb3\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u6211\u8be5\u5982\u4f55\u5229\u7528\u5b83\u4eec\uff1f", "answer": "\u9ecf\u6db2\u5965\u5fb7\u8d5b\u4e2d\u7684\u73af\u5883\u5371\u5bb3\uff0c\u4f8b\u5982\u201c\u9178\u6c60\u201d\u548c\u201c\u7194\u5ca9\u6d41\u201d\uff0c\u6781\u5927\u5730\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\u3002\u8fd9\u4e9b\u5371\u5bb3\u4f1a\u4f24\u5bb3\u4f60\u548c\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5f15\u8bf1\u654c\u4eba\u8fdb\u5165\u201c\u9178\u6c60\u201d\u6765\u524a\u5f31\u4ed6\u4eec\uff0c\u7136\u540e\u518d\u8fdb\u884c\u6218\u6597\u3002\u7406\u89e3\u548c\u5229\u7528\u8fd9\u4e9b\u5371\u5bb3\u53ef\u4ee5\u5c06\u5145\u6ee1\u6311\u6218\u7684\u60c5\u51b5\u8f6c\u53d8\u4e3a\u6218\u7565\u4f18\u52bf\u7684\u673a\u4f1a\u3002"}, {"question": "\u5728\u4e2d\u7aef\u7535\u8111\u4e0a\u8fd0\u884c\u9ecf\u6db2\u5965\u5fb7\u8d5b\u7684\u6700\u4f73\u8bbe\u7f6e\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5728\u4e2d\u7aef\u7535\u8111\u4e0a\u6d41\u7545\u8fd0\u884c\u9ecf\u6db2\u5965\u5fb7\u8d5b\uff0c\u8bf7\u8c03\u6574\u4ee5\u4e0b\u8bbe\u7f6e\uff1a\u5c06\u201c\u7eb9\u7406\u8d28\u91cf\u201d\u8bbe\u7f6e\u4e3a\u4e2d\u7b49\uff0c\u201c\u9634\u5f71\u8d28\u91cf\u201d\u8bbe\u7f6e\u4e3a\u4f4e\uff0c\u201c\u6297\u952f\u9f7f\u201d\u8bbe\u7f6e\u4e3a FXAA\u3002\u4f8b\u5982\uff0c\u8fd9\u4e9b\u8bbe\u7f6e\u786e\u4fdd\u5728\u89c6\u89c9\u4fdd\u771f\u5ea6\u548c\u6027\u80fd\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\uff0c\u4ece\u800c\u4f7f\u6e38\u620f\u80fd\u591f\u4ee5\u7a33\u5b9a\u7684 60 \u5e27\u8fd0\u884c\u3002\u59cb\u7ec8\u76d1\u63a7\u7cfb\u7edf\u7684\u6027\u80fd\uff0c\u5e76\u6839\u636e\u9700\u8981\u8c03\u6574\u8bbe\u7f6e\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u4f53\u9a8c\u3002"}]
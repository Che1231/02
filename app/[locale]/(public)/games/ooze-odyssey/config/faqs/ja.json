[{"question": "\u521d\u671f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001Ooze Odyssey\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u65b9\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Ooze Odyssey\u3067\u306f\u3001\u30b2\u30fc\u30e0\u4e16\u754c\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u304c\u91cd\u8981\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52d5\u304b\u3059\u306b\u306f\u3001\u753b\u9762\u5de6\u5074\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4e0a\u306b\u30b9\u30e9\u30a4\u30c9\u3059\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u524d\u9032\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4efb\u610f\u306e\u65b9\u5411\u306b\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u30c0\u30d6\u30eb\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u30af\u30a4\u30c3\u30af\u30c0\u30c3\u30b7\u30e5\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30a8\u30ea\u30a2\u3067\u3053\u308c\u3089\u306e\u52d5\u304d\u3092\u7df4\u7fd2\u3057\u3066\u3001\u4f7f\u3044\u6163\u308c\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Ooze Odyssey\u3067\u3001100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ooze Odyssey\u3067100\u6642\u9593\u3092\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306f\u975e\u5e38\u306b\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u30ea\u30b9\u30af\u30a8\u30ea\u30a2\u3067\u300c\u8f1d\u304f\u30b9\u30e9\u30a4\u30e0\u300d\u306e\u3088\u3046\u306a\u30ec\u30a2\u306a\u7d20\u6750\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3001\u4f8b\u3048\u3070\u3001\u56de\u5fa9\u85ac\u3092\u6700\u521d\u306b\u4f5c\u6210\u3059\u308b\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f59\u5270\u30ea\u30bd\u30fc\u30b9\u3092NPC\u3068\u4ea4\u63db\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u88c5\u5099\u3092\u5165\u624b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u300110\u500b\u306e\u300c\u8f1d\u304f\u30b9\u30e9\u30a4\u30e0\u300d\u3092\u300c\u30b9\u30e9\u30a4\u30e0\u30a2\u30fc\u30de\u30fc\u300d\u3068\u4ea4\u63db\u3059\u308b\u3068\u3001\u9632\u5fa1\u529b\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305cOoze Odyssey\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b66\u529b\u3088\u308a\u3082\u6226\u8853\u3092\u91cd\u8996\u3059\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "Ooze Odyssey\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6226\u8853\u7684\u306a\u30d7\u30ec\u30a4\u3092\u5968\u52b1\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6b66\u529b\u3068\u306f\u7570\u306a\u308a\u3001\u8fc5\u901f\u306b\u30ea\u30bd\u30fc\u30b9\u3092\u4f7f\u3044\u679c\u305f\u3057\u307e\u3059\u304c\u3001\u74b0\u5883\u306e\u8105\u5a01\u3092\u5229\u7528\u3059\u308b\u3068\u3044\u3063\u305f\u6226\u8853\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u6226\u95d8\u306e\u72b6\u6cc1\u3092\u5909\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6575\u3092\u300c\u9178\u6027\u30d7\u30fc\u30eb\u300d\u306b\u8a98\u3044\u8fbc\u3080\u3053\u3068\u3067\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3059\u308b\u3053\u3068\u306a\u304f\u591a\u5927\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6226\u7565\u7684\u306b\u8003\u3048\u308b\u3053\u3068\u3092\u5968\u52b1\u3057\u3001\u5404\u906d\u9047\u3092\u3055\u3089\u306b\u9b45\u529b\u7684\u306b\u3057\u307e\u3059\u3002"}, {"question": "Ooze Odyssey\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u4e3b\u306a\u69cb\u6210\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ooze Odyssey\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u69d8\u3005\u306a\u7d20\u6750\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u6709\u7528\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u4e3b\u306a\u69cb\u6210\u8981\u7d20\u306b\u306f\u3001\u300c\u57fa\u672c\u7684\u306a\u30b9\u30e9\u30a4\u30e0\u300d\u3001\u300c\u5e0c\u5c11\u306a\u7d50\u6676\u300d\u3001\u300c\u9b54\u6cd5\u306e\u30a8\u30c3\u30bb\u30f3\u30b9\u300d\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u30015\u500b\u306e\u300c\u57fa\u672c\u7684\u306a\u30b9\u30e9\u30a4\u30e0\u300d\u30681\u500b\u306e\u300c\u5e0c\u5c11\u306a\u7d50\u6676\u300d\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u300c\u30b9\u30e9\u30a4\u30e0\u30dc\u30e0\u300d\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u306a\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\u5e38\u306b\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u78ba\u8a8d\u3057\u3066\u3001\u30af\u30e9\u30d5\u30c8\u306b\u5fc5\u8981\u306a\u69cb\u6210\u8981\u7d20\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Ooze Odyssey\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b2\u30fc\u30e0\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u3069\u306e\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Ooze Odyssey\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u3092\u5f37\u5316\u3059\u308b\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u30b9\u30e9\u30a4\u30e0\u30b7\u30fc\u30eb\u30c9\u300d\u306f\u3042\u306a\u305f\u306e\u751f\u5b58\u529b\u3092\u9ad8\u3081\u3001\u300c\u9178\u6027\u30d0\u30fc\u30b9\u30c8\u300d\u306f\u5927\u304d\u306a\u7bc4\u56f2\u653b\u6483\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30e9\u30a4\u30e0\u30b7\u30fc\u30eb\u30c9\u300d\u3092\u30ec\u30d9\u30eb3\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u306e50%\u3092\u30d6\u30ed\u30c3\u30af\u3067\u304d\u308b\u305f\u3081\u3001\u53b3\u3057\u3044\u6226\u95d8\u3067\u975e\u5e38\u306b\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u3002\u69d8\u3005\u306a\u6311\u6226\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30ad\u30eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u30d0\u30e9\u30f3\u30b9\u3088\u304f\u884c\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Ooze Odyssey\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ooze Odyssey\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u660e\u78ba\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u3068\u30bd\u30ed\u306e\u6311\u6226\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4e00\u65b9\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u9023\u643a\u306b\u91cd\u70b9\u304c\u7f6e\u304b\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u306e\u80fd\u529b\u3092\u7d44\u307f\u5408\u308f\u305b\u3001\u5f37\u529b\u306a\u30b3\u30f3\u30dc\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u300c\u30b9\u30e9\u30a4\u30e0\u30c8\u30e9\u30c3\u30d7\u300d\u306b\u7d9a\u3044\u3066\u300c\u30d5\u30a1\u30a4\u30a2\u30d6\u30e9\u30b9\u30c8\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6700\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u30e2\u30fc\u30c9\u306f\u3001\u72ec\u81ea\u306e\u5831\u916c\u3068\u6311\u6226\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "\u3069\u306e\u3088\u3046\u306bOoze Odyssey\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Ooze Odyssey\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u306b\u79fb\u884c\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u306b\u3042\u308b\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1aPC\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3057\u307e\u3059
[{"question": "\u5982\u4f55\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\u4f5c\u70ba\u65b0\u624b\u9032\u884c\u57fa\u672c\u79fb\u52d5\uff1f", "answer": "\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\uff0c\u57fa\u672c\u79fb\u52d5\u5c0d\u65bc\u904a\u73a9\u904a\u6232\u4e16\u754c\u81f3\u95dc\u91cd\u8981\u3002\u8981\u79fb\u52d5\u4f60\u7684\u89d2\u8272\uff0c\u8acb\u4f7f\u7528\u87a2\u5e55\u5de6\u5074\u7684\u6416\u687f\u3002\u4f8b\u5982\uff0c\u5c07\u6416\u687f\u5411\u4e0a\u6ed1\u52d5\u6703\u4f7f\u4f60\u7684\u89d2\u8272\u5411\u524d\u79fb\u52d5\u3002\u6b64\u5916\uff0c\u4f60\u4e5f\u53ef\u4ee5\u5728\u4efb\u4f55\u65b9\u5411\u96d9\u64ca\u4f86\u57f7\u884c\u5feb\u901f\u885d\u523a\uff0c\u9019\u5c0d\u65bc\u8eb2\u907f\u969c\u7919\u7269\u5f88\u6709\u7528\u3002\u8acb\u5728\u6559\u5b78\u5340\u57df\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\uff0c\u4ee5\u719f\u6089\u904a\u6232\u64cd\u4f5c\u3002"}, {"question": "\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u904a\u6232\u5f8c 100 \u5c0f\u6642\u7684\u904a\u73a9\u7d93\u9a57\u4e2d\uff0c\u6700\u4f73\u7684\u8cc7\u6e90\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u904a\u73a9 100 \u5c0f\u6642\u5f8c\uff0c\u8cc7\u6e90\u7ba1\u7406\u8b8a\u5f97\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u6536\u96c6\u9ad8\u98a8\u96aa\u5340\u57df\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u300c\u767c\u5149\u9ecf\u6db2\u300d\u3002\u6b65\u9a5f\u4e8c\uff1a\u63a1\u53d6\u5747\u8861\u7684\u65b9\u6cd5\uff0c\u9996\u5148\u88fd\u4f5c\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u85e5\u6c34\u3002\u6b65\u9a5f\u4e09\uff1a\u8207 NPC \u4ea4\u6613\u591a\u9918\u7684\u8cc7\u6e90\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u88dd\u5099\u3002\u4f8b\u5982\uff0c\u7528 10 \u500b\u300c\u767c\u5149\u9ecf\u6db2\u300d\u4ea4\u63db\u4e00\u4ef6\u300c\u9ecf\u6db2\u76d4\u7532\u300d\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u9632\u5fa1\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u6230\u9b25\u7cfb\u7d71\u504f\u5411\u65bc\u7b56\u7565\u800c\u975e\u883b\u529b\uff1f", "answer": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u6230\u9b25\u7cfb\u7d71\u65e8\u5728\u734e\u52f5\u7b56\u7565\u6027\u904a\u6232\u3002\u8207\u5feb\u901f\u8017\u76e1\u8cc7\u6e90\u7684\u883b\u529b\u4e0d\u540c\uff0c\u7b56\u7565\u6027\u65b9\u6cd5\uff0c\u4f8b\u5982\u5229\u7528\u74b0\u5883\u9677\u9631\uff0c\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002\u4f8b\u5982\uff0c\u5c07\u6575\u4eba\u5f15\u8a98\u5230\u300c\u9178\u6c60\u300d\u4e2d\u53ef\u4ee5\u9020\u6210\u5de8\u5927\u7684\u50b7\u5bb3\uff0c\u800c\u7121\u9700\u8017\u8cbb\u4f60\u7684\u80fd\u91cf\u3002\u9019\u500b\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u9032\u884c\u7b56\u7565\u601d\u8003\uff0c\u4f7f\u6bcf\u6b21\u906d\u9047\u90fd\u66f4\u5177\u5438\u5f15\u529b\u3002"}, {"question": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u5de5\u85dd\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5176\u95dc\u9375\u7d44\u6210\u90e8\u5206\u6709\u54ea\u4e9b\uff1f", "answer": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u5de5\u85dd\u7cfb\u7d71\u9700\u8981\u7d50\u5408\u5404\u7a2e\u6750\u6599\u4f86\u88fd\u4f5c\u6709\u7528\u7684\u7269\u54c1\u3002\u95dc\u9375\u7d44\u6210\u90e8\u5206\u5305\u62ec\u300c\u57fa\u672c\u9ecf\u6db2\u300d\u3001\u300c\u7a00\u6709\u6c34\u6676\u300d\u548c\u300c\u9b54\u6cd5\u7cbe\u83ef\u300d\u3002\u4f8b\u5982\uff0c\u7d50\u5408 5 \u500b\u300c\u57fa\u672c\u9ecf\u6db2\u300d\u548c 1 \u500b\u300c\u7a00\u6709\u6c34\u6676\u300d\u53ef\u4ee5\u88fd\u4f5c\u300c\u9ecf\u6db2\u70b8\u5f48\u300d\uff0c\u9019\u5c0d\u4ed8\u6575\u4eba\u7fa4\u9ad4\u975e\u5e38\u6709\u6548\u3002\u8acb\u96a8\u6642\u6ce8\u610f\u4f60\u7684\u80cc\u5305\uff0c\u78ba\u4fdd\u4f60\u64c1\u6709\u5fc5\u8981\u7684\u5de5\u85dd\u6750\u6599\u3002"}, {"question": "\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\uff0c\u70ba\u4e86\u7372\u5f97\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u70ba\u4e86\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\u7372\u5f97\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u8acb\u512a\u5148\u5347\u7d1a\u90a3\u4e9b\u80fd\u589e\u5f37\u653b\u9632\u7684\u6280\u80fd\u3002\u300c\u9ecf\u6db2\u76fe\u300d\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u80fd\u529b\uff0c\u300c\u9178\u6027\u7206\u767c\u300d\u9020\u6210\u5de8\u5927\u7684\u5340\u57df\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u9ecf\u6db2\u76fe\u300d\u5347\u7d1a\u5230 3 \u7d1a\u53ef\u4ee5\u963b\u64cb 50% \u7684\u6575\u4eba\u653b\u64ca\u50b7\u5bb3\uff0c\u9019\u5728\u8271\u96e3\u7684\u6230\u9b25\u4e2d\u975e\u5e38\u5bf6\u8cb4\u3002\u5e73\u8861\u4f60\u7684\u6280\u80fd\u5347\u7d1a\u4ee5\u9069\u61c9\u5404\u7a2e\u6311\u6230\u3002"}, {"question": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e86\u622a\u7136\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u7684\u76ee\u6a19\u5728\u65bc\u5287\u60c5\u9032\u5c55\u548c\u55ae\u4eba\u6311\u6230\u3002\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f37\u8abf\u5718\u968a\u5408\u4f5c\u548c\u5354\u8abf\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u8207\u968a\u53cb\u7d50\u5408\u80fd\u529b\u767c\u51fa\u5f37\u5927\u7684\u9023\u64ca\uff0c\u4f8b\u5982\u4f7f\u7528\u300c\u9ecf\u6db2\u9677\u9631\u300d\u7136\u5f8c\u63a5\u8457\u300c\u706b\u7130\u7206\u88c2\u300d\u4ee5\u9054\u5230\u6700\u5927\u7684\u50b7\u5bb3\u3002\u6bcf\u500b\u6a21\u5f0f\u90fd\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u548c\u6311\u6230\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u300a\u9ecf\u6db2\u5947\u5883\u300b\u904a\u6232\u9032\u5ea6\u5f9e\u624b\u6a5f\u8f49\u79fb\u5230\u96fb\u8166\uff1f", "answer": "\u5c07\u4f60\u7684\u300a\u9ecf\u6db2\u5947\u5883\u300b\u904a\u6232\u9032\u5ea6\u5f9e\u624b\u6a5f\u8f49\u79fb\u5230\u96fb\u8166\u76f8\u7576\u7c21\u55ae\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u904a\u6232\u8a2d\u5b9a\u4e2d\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u4f60\u7684\u9032\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u4f60\u7684\u96fb\u8166\u4e0a\u4e0b\u8f09\u96f2\u7aef\u5132\u5b58\u4ee5\u7e7c\u7e8c\u672a\u5b8c\u6210\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u4f60\u7684\u89d2\u8272\u7b49\u7d1a\u548c\u80cc\u5305\u5167\u5bb9\u6703\u5728\u8de8\u5e73\u53f0\u540c\u6b65\u3002"}, {"question": "\u5728\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\uff0c\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u7684\u79d8\u5bc6\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u5145\u6eff\u4e86\u8c50\u5bcc\u904a\u6232\u9ad4\u9a57\u7684\u96b1\u85cf\u79d8\u5bc6\u3002\u4e00\u500b\u986f\u8457\u7684\u79d8\u5bc6\u662f\u300c\u53e4\u4ee3\u9ecf\u6db2\u795e\u5edf\u300d\uff0c\u53ea\u6709\u900f\u904e\u89e3\u6c7a\u4e00\u7cfb\u5217\u8b0e\u984c\u624d\u80fd\u9032\u5165\u3002\u767c\u73fe\u9019\u500b\u795e\u5edf\u53ef\u4ee5\u7372\u5f97\u300c\u9ecf\u6db2\u738b\u51a0\u300d\uff0c\u5b83\u80fd\u63d0\u5347\u6240\u6709\u5c6c\u6027 20%\u3002\u9019\u4e9b\u79d8\u5bc6\u4e0d\u50c5\u63d0\u4f9b\u4e86\u5f37\u5927\u7684\u734e\u52f5\uff0c\u9084\u70ba\u904a\u6232\u7684\u6545\u4e8b\u548c\u63a2\u7d22\u5143\u7d20\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002"}, {"question": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\u7684\u74b0\u5883\u9677\u9631\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u4ee5\u53ca\u5982\u4f55\u5229\u7528\u5b83\u5011\u4f86\u9054\u5230\u512a\u52e2\uff1f", "answer": "\u300a\u9ecf\u6db2\u5947\u5883\u300b\u4e2d\u7684\u74b0\u5883\u9677\u9631\uff0c\u4f8b\u5982\u300c\u9178\u6c60\u300d\u548c\u300c\u7194\u5ca9\u6d41\u300d\uff0c\u6703\u986f\u8457\u5f71\u97ff\u904a\u6232\u3002\u9019\u4e9b\u9677\u9631\u6703\u50b7\u5bb3\u4f60\u548c\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5f15\u8a98\u6575\u4eba\u9032\u5165\u300c\u9178\u6c60\u300d\u4ee5\u524a\u5f31\u4ed6\u5011\uff0c\u7136\u5f8c\u518d\u9032\u884c\u6230\u9b25\u3002\u4e86\u89e3\u4e26\u5229\u7528\u9019\u4e9b\u9677\u9631\u53ef\u4ee5\u5c07\u56f0\u96e3\u5c40\u9762\u8f49\u5316\u70ba\u7b56\u7565\u512a\u52e2\u7684\u6a5f\u6703\u3002"}, {"question": "\u5728\u4e2d\u7aef\u96fb\u8166\u4e0a\u904b\u884c\u300a\u9ecf\u6db2\u5947\u5883\u300b\u7684\u6700\u4f73\u8a2d\u5b9a\u662f\u4ec0\u9ebc\uff1f", "answer": "\u70ba\u4e86\u5728\u4e2d\u7aef\u96fb\u8166\u4e0a\u9806\u5229\u904b\u884c\u300a\u9ecf\u6db2\u5947\u5883\u300b\uff0c\u8acb\u8abf\u6574\u4ee5\u4e0b\u8a2d\u5b9a\uff1a\u5c07\u300c\u6750\u8cea\u54c1\u8cea\u300d\u8a2d\u5b9a\u70ba\u4e2d\u7b49\uff0c\u300c\u9670\u5f71\u54c1\u8cea\u300d\u8a2d\u5b9a\u70ba\u4f4e\uff0c\u300c\u6297\u92f8\u9f52\u300d\u8a2d\u5b9a\u70ba FXAA\u3002\u4f8b\u5982\uff0c\u9019\u4e9b\u8a2d\u5b9a\u5728\u8996\u89ba\u4fdd\u771f\u5ea6\u8207\u6027\u80fd\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\uff0c\u8b93\u904a\u6232\u80fd\u5920\u4ee5\u7a69\u5b9a 60 \u5e40\u904b\u884c\u3002\u8acb\u59cb\u7d42\u76e3\u63a7\u7cfb\u7d71\u7684\u6027\u80fd\uff0c\u4e26\u6839\u64da\u9700\u8981\u8abf\u6574\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u9ad4\u9a57\u3002"}]
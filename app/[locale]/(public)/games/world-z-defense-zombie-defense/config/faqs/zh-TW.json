[{"question": "\u5982\u4f55\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u958b\u59cb\u5efa\u9020\u57fa\u5730\uff1f", "answer": "\u8981\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u958b\u59cb\u5efa\u9020\u57fa\u5730\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u900f\u904e\u5b8c\u6210\u4efb\u52d9\u6216\u5728\u958b\u653e\u4e16\u754c\u4e2d\u641c\u522e\u4f86\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f2\uff1a\u958b\u555f\u5efa\u9020\u9078\u55ae\uff0c\u9078\u64c7\u60a8\u60f3\u8981\u5efa\u7acb\u7684\u5efa\u7bc9\u985e\u578b\uff0c\u4f8b\u5982\u77ad\u671b\u5854\u6216\u8cc7\u6e90\u5132\u5b58\u8a2d\u65bd\u3002\u6b65\u9a5f3\uff1a\u5c07\u5efa\u7bc9\u7269\u653e\u7f6e\u5728\u57fa\u5730\u7684\u6700\u4f73\u4f4d\u7f6e\uff0c\u4ee5\u6700\u5927\u5316\u5176\u6548\u76ca\u3002\u4f8b\u5982\uff0c\u5c07\u77ad\u671b\u5854\u653e\u7f6e\u5728\u5165\u53e3\u9644\u8fd1\uff0c\u53ef\u4ee5\u5e6b\u52a9\u62b5\u79a6\u4f86\u8972\u7684\u6bad\u5c4d\u7fa4\u3002"}, {"question": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u62b5\u6297\u5927\u898f\u6a21\u6bad\u5c4d\u7fa4\uff1f", "answer": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u62b5\u6297\u5927\u898f\u6a21\u6bad\u5c4d\u7fa4\u9700\u8981\u7d50\u5408\u7b56\u7565\u6027\u90e8\u7f72\u548c\u8cc7\u6e90\u7ba1\u7406\u3002\u6b65\u9a5f1\uff1a\u5347\u7d1a\u60a8\u7684\u9632\u79a6\u5efa\u7bc9\uff0c\u4f8b\u5982\u570d\u7246\u548c\u70ae\u5854\uff0c\u4ee5\u63d0\u9ad8\u5176\u8010\u4e45\u6027\u548c\u706b\u529b\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u5340\u57df\u6027\u6b66\u5668\uff0c\u4f8b\u5982\u624b\u69b4\u5f48\u6216\u706b\u7130\u5674\u5c04\u5668\uff0c\u4f86\u524a\u5f31\u6bad\u5c4d\u7fa4\u3002\u6b65\u9a5f3\uff1a\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\u8207\u5176\u4ed6\u73a9\u5bb6\u5354\u8abf\uff0c\u4ee5\u8986\u84cb\u6240\u6709\u5165\u53e3\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6d3b\u5c4d\u4e4b\u591c\u300f\u6d3b\u52d5\u671f\u9593\uff0c\u8207\u5176\u4ed6\u73a9\u5bb6\u8a2d\u7f6e\u91cd\u758a\u7684\u706b\u529b\u7bc4\u570d\u53ef\u4ee5\u986f\u8457\u6e1b\u5c11\u6bad\u5c4d\u7fa4\u7684\u6578\u91cf\u3002"}, {"question": "\u8cc7\u6e90\u7ba1\u7406\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u70ba\u4f55\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u8cc7\u6e90\u7ba1\u7406\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u5efa\u9020\u3001\u5347\u7d1a\u548c\u7dad\u6301\u57fa\u5730\u7684\u80fd\u529b\u3002\u6709\u6548\u5730\u7ba1\u7406\u6728\u6750\u3001\u91d1\u5c6c\u548c\u98df\u7269\u7b49\u8cc7\u6e90\uff0c\u53ef\u78ba\u4fdd\u60a8\u80fd\u6301\u7e8c\u6539\u5584\u9632\u79a6\u80fd\u529b\uff0c\u4e26\u5728\u6bad\u5c4d\u653b\u64ca\u4e2d\u5b58\u6d3b\u66f4\u4e45\u3002\u4f8b\u5982\uff0c\u5728\u5efa\u9020\u65b0\u5efa\u7bc9\u548c\u5347\u7d1a\u73fe\u6709\u5efa\u7bc9\u4e4b\u9593\u5e73\u8861\u8cc7\u6e90\u5206\u914d\uff0c\u53ef\u4ee5\u9632\u6b62\u5728\u95dc\u9375\u6642\u523b\uff08\u4f8b\u5982\u7a81\u7136\u51fa\u73fe\u6bad\u5c4d\u7fa4\uff09\u767c\u751f\u77ed\u7f3a\u3002"}, {"question": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u54ea\u4e9b\u82f1\u96c4\u55ae\u4f4d\u5728\u4e0d\u540c\u4efb\u52d9\u4e2d\u6548\u679c\u6700\u4f73\uff1f", "answer": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u4e0d\u540c\u7684\u82f1\u96c4\u55ae\u4f4d\u5728\u5404\u7a2e\u4efb\u52d9\u4e2d\u8868\u73fe\u51fa\u8272\u3002\u5c0d\u65bc\u641c\u522e\u4efb\u52d9\uff0c\u64c1\u6709\u9ad8\u6a5f\u52d5\u6027\u548c\u96b1\u853d\u6027\u7684\u82f1\u96c4\uff0c\u4f8b\u5982\u300e\u5f71\u5b50\u8dd1\u8005\u300f\uff0c\u662f\u7406\u60f3\u4e4b\u9078\u3002\u5c0d\u65bc\u9632\u79a6\u4efb\u52d9\uff0c\u5177\u6709\u9ad8\u8010\u4e45\u6027\u7684\u5766\u514b\u578b\u82f1\u96c4\uff0c\u4f8b\u5982\u300e\u9435\u885b\u300f\uff0c\u5247\u66f4\u6709\u6548\u3002\u4f8b\u5982\uff0c\u5728\u641c\u522e\u4efb\u52d9\u4e2d\u4f7f\u7528\u300e\u5f71\u5b50\u8dd1\u8005\u300f\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5feb\u901f\u6536\u96c6\u8cc7\u6e90\uff0c\u540c\u6642\u907f\u514d\u6bad\u5c4d\u63a2\u6e2c\u3002"}, {"question": "\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u70ba\u904a\u6232\u73a9\u6cd5\u589e\u6dfb\u4e86\u8907\u96dc\u6027\u3002\u4e0d\u540c\u7684\u5929\u6c23\u72c0\u6cc1\u6703\u5f71\u97ff\u80fd\u898b\u5ea6\u3001\u6bad\u5c4d\u884c\u70ba\u548c\u8cc7\u6e90\u7684\u53ef\u7528\u6027\u3002\u4f8b\u5982\uff0c\u5728\u66b4\u96e8\u671f\u9593\uff0c\u7531\u65bc\u5730\u9762\u6fd5\u6ed1\uff0c\u6bad\u5c4d\u53ef\u80fd\u6703\u79fb\u52d5\u5f97\u66f4\u5feb\uff0c\u800c\u9727\u6c23\u6703\u964d\u4f4e\u80fd\u898b\u5ea6\uff0c\u8b93\u73a9\u5bb6\u66f4\u96e3\u767c\u73fe\u8972\u4f86\u7684\u5a01\u8105\u3002\u73a9\u5bb6\u5fc5\u9808\u76f8\u61c9\u5730\u8abf\u6574\u7b56\u7565\uff0c\u4f8b\u5982\u5728\u9727\u5929\u4f7f\u7528\u7167\u660e\u5f48\u4f86\u63d0\u9ad8\u80fd\u898b\u5ea6\u3002"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u6709\u54ea\u4e9b\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u5354\u8abf\u7a0b\u5ea6\u548c\u8cc7\u6e90\u5171\u4eab\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u9700\u8981\u7368\u81ea\u7ba1\u7406\u57fa\u5730\u548c\u8cc7\u6e90\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u8207\u5176\u4ed6\u73a9\u5bb6\u5408\u4f5c\uff0c\u5efa\u7acb\u66f4\u5f37\u5927\u7684\u9632\u79a6\u4e26\u5171\u4eab\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u5206\u914d\u7279\u5b9a\u89d2\u8272\u7d66\u73a9\u5bb6\uff0c\u4f8b\u5982\u4e00\u500b\u4eba\u5c08\u6ce8\u65bc\u8cc7\u6e90\u6536\u96c6\uff0c\u800c\u53e6\u4e00\u500b\u4eba\u5c08\u6ce8\u65bc\u57fa\u5730\u9632\u79a6\u3002"}, {"question": "\u5982\u4f55\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u512a\u5316\u57fa\u5730\u4f48\u5c40\u4ee5\u9054\u5230\u6700\u4f73\u6548\u7387\uff1f", "answer": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u512a\u5316\u57fa\u5730\u4f48\u5c40\uff0c\u5305\u62ec\u7b56\u7565\u6027\u5730\u90e8\u7f72\u5efa\u7bc9\u7269\u548c\u9632\u79a6\u8a2d\u65bd\u3002\u6b65\u9a5f1\uff1a\u5c07\u8cc7\u6e90\u751f\u6210\u5efa\u7bc9\u7269\uff08\u4f8b\u5982\u8fb2\u5834\u548c\u7926\u5834\uff09\u653e\u7f6e\u5728\u5b89\u5168\u5340\u57df\uff0c\u4ee5\u9632\u6b62\u5b83\u5011\u88ab\u6467\u6bc0\u3002\u6b65\u9a5f2\uff1a\u5c07\u9632\u79a6\u5efa\u7bc9\u7269\uff08\u4f8b\u5982\u70ae\u5854\u548c\u570d\u7246\uff09\u653e\u7f6e\u5728\u74f6\u9838\u4f4d\u7f6e\uff0c\u4ee5\u6e1b\u7de9\u6bad\u5c4d\u7684\u9032\u653b\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u5730\u5f62\u512a\u52e2\uff0c\u5c07\u9ad8\u5730\u5efa\u7bc9\u7269\u653e\u7f6e\u5728\u8996\u91ce\u548c\u5c04\u7a0b\u66f4\u597d\u7684\u5730\u65b9\u3002\u4f8b\u5982\uff0c\u5728\u5c0f\u5c71\u4e18\u4e0a\u653e\u7f6e\u72d9\u64ca\u5854\u53ef\u4ee5\u70ba\u4f86\u8972\u6bad\u5c4d\u63d0\u4f9b\u66f4\u6e05\u6670\u7684\u8996\u91ce\u3002"}, {"question": "\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u6bad\u5c4d\u7522\u751f\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u6bad\u5c4d\u7684\u7522\u751f\u53d7\u5230\u591a\u500b\u56e0\u7d20\u5f71\u97ff\uff0c\u5305\u62ec\u6642\u9593\u3001\u73a9\u5bb6\u6d3b\u52d5\u548c\u57fa\u5730\u4f4d\u7f6e\u3002\u6bad\u5c4d\u5728\u665a\u4e0a\u548c\u73a9\u5bb6\u6d3b\u52d5\u983b\u7e41\u7684\u5730\u5340\u66f4\u5bb9\u6613\u7522\u751f\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u4e8b\u4ef6\u6703\u89f8\u767c\u66f4\u5927\u7684\u6bad\u5c4d\u6ce2\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6eff\u6708\u300f\u6d3b\u52d5\u671f\u9593\uff0c\u6bad\u5c4d\u7522\u751f\u7684\u983b\u7387\u548c\u5f37\u5ea6\u90fd\u6703\u986f\u8457\u589e\u52a0\uff0c\u9019\u9700\u8981\u73a9\u5bb6\u52a0\u5f37\u9632\u79a6\u3002"}, {"question": "\u5982\u4f55\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u5c07\u6211\u7684\u884c\u52d5\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u79fb\u5230\u500b\u4eba\u96fb\u8166\uff1f", "answer": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u5c07\u884c\u52d5\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u79fb\u5230\u500b\u4eba\u96fb\u8166\u975e\u5e38\u7c21\u55ae\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5132\u5b58\u5e33\u6236\uff0c\u4f8b\u5982Google Play\u6216Apple Game Center\u3002\u6b65\u9a5f2\uff1a\u5728\u60a8\u7684\u500b\u4eba\u96fb\u8166\u4e0a\u5b89\u88dd\u904a\u6232\uff0c\u4e26\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b65\u9a5f3\uff1a\u5c07\u9032\u5ea6\u5f9e\u96f2\u7aef\u540c\u6b65\u4ee5\u7e7c\u7e8c\u60a8\u4e4b\u524d\u7684\u5de5\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u5df2\u5efa\u7acb\u5b8c\u5584\u7684\u57fa\u5730\uff0c\u60a8\u53ef\u4ee5\u9806\u5229\u5c07\u5176\u8f49\u79fb\u5230\u500b\u4eba\u96fb\u8166\uff0c\u800c\u4e0d\u6703\u907a\u5931\u4efb\u4f55\u9032\u5ea6\u3002"}, {"question": "\u5728\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\uff0c\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u4e16\u754cZ\u9632\u79a6 - \u6bad\u5c4d\u9632\u79a6\u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u9019\u4e9b\u5f69\u86cb\u53c3\u8003\u4e86\u6d41\u884c\u7684\u6bad\u5c4d\u6587\u5316\u3002\u5176\u4e2d\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u8096\u6069\u7684\u7d55\u671b\u300f\u53c3\u8003\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u7279\u5b9a\u4f4d\u7f6e\u627e\u5230\u4e00\u4f4d\u540d\u70ba\u8096\u6069\u7684\u89d2\u8272\uff0c\u624b\u6301\u677f\u7403\u68d2\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u300e\u60e1\u9748\u53e4\u5821\u300f\u81f4\u656c\uff0c\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\u4e00\u500b\u96b1\u85cf\u5be6\u9a57\u5ba4\uff0c\u4e0a\u9762\u6709\u5098\u516c\u53f8\u6a19\u8a8c\u3002\u9019\u4e9b\u5f69\u86cb\u70ba\u904a\u6232\u7c89\u7d72\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u61f7\u820a\u611f\u3002"}]
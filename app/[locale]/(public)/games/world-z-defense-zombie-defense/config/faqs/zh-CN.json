[{"question": "\u5982\u4f55\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u5efa\u7acb\u57fa\u5730\uff1f", "answer": "\u8981\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u5efa\u7acb\u57fa\u5730\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u6216\u5728\u5f00\u653e\u4e16\u754c\u4e2d\u641c\u522e\u6765\u6536\u96c6\u8d44\u6e90\u3002\u6b65\u9aa42\uff1a\u8fdb\u5165\u5efa\u9020\u83dc\u5355\uff0c\u9009\u62e9\u8981\u521b\u5efa\u7684\u5efa\u7b51\u7c7b\u578b\uff0c\u4f8b\u5982\u77ad\u671b\u5854\u6216\u8d44\u6e90\u4ed3\u5e93\u3002\u6b65\u9aa43\uff1a\u5c06\u5efa\u7b51\u7269\u653e\u7f6e\u5728\u57fa\u5730\u5185\u7684\u6700\u4f73\u4f4d\u7f6e\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5176\u6709\u6548\u6027\u3002\u4f8b\u5982\uff0c\u5c06\u77ad\u671b\u5854\u653e\u7f6e\u5728\u5165\u53e3\u9644\u8fd1\u53ef\u4ee5\u5e2e\u52a9\u62b5\u5fa1\u50f5\u5c38\u6d6a\u6f6e\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5982\u4f55\u5e94\u5bf9\u5927\u89c4\u6a21\u50f5\u5c38\u7fa4\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5e94\u5bf9\u5927\u89c4\u6a21\u50f5\u5c38\u7fa4\u9700\u8981\u7ed3\u5408\u6218\u7565\u90e8\u7f72\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u6b65\u9aa41\uff1a\u5347\u7ea7\u4f60\u7684\u9632\u5fa1\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u57ce\u5899\u548c\u70ae\u5854\uff0c\u4ee5\u63d0\u9ad8\u5176\u8010\u4e45\u6027\u548c\u706b\u529b\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u8303\u56f4\u6027\u6b66\u5668\uff0c\u5982\u624b\u69b4\u5f39\u6216\u706b\u7130\u55b7\u5c04\u5668\uff0c\u6e05\u9664\u50f5\u5c38\u7fa4\u3002\u6b65\u9aa43\uff1a\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\u4e0e\u5176\u4ed6\u73a9\u5bb6\u534f\u8c03\uff0c\u8986\u76d6\u6240\u6709\u5165\u53e3\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6d3b\u6b7b\u4eba\u591c\u201d\u6d3b\u52a8\u671f\u95f4\uff0c\u4e0e\u5176\u4ed6\u73a9\u5bb6\u8bbe\u7f6e\u91cd\u53e0\u7684\u706b\u529b\u533a\u57df\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u50f5\u5c38\u7fa4\u7684\u6570\u91cf\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u6784\u5efa\u3001\u5347\u7ea7\u548c\u7ef4\u6301\u57fa\u5730\u7684\u80fd\u529b\u3002\u6709\u6548\u7ba1\u7406\u6728\u6750\u3001\u91d1\u5c5e\u548c\u98df\u7269\u7b49\u8d44\u6e90\uff0c\u786e\u4fdd\u4f60\u80fd\u6301\u7eed\u6539\u8fdb\u9632\u5fa1\u63aa\u65bd\u5e76\u62b5\u5fa1\u66f4\u957f\u65f6\u95f4\u7684\u50f5\u5c38\u88ad\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u5173\u952e\u65f6\u523b\uff08\u4f8b\u5982\u7a81\u7136\u7684\u50f5\u5c38\u6d6a\u6f6e\uff09\u5e73\u8861\u8d44\u6e90\u5206\u914d\uff0c\u5728\u5efa\u9020\u65b0\u5efa\u7b51\u7269\u548c\u5347\u7ea7\u73b0\u6709\u5efa\u7b51\u7269\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\uff0c\u53ef\u4ee5\u9632\u6b62\u8d44\u6e90\u77ed\u7f3a\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u54ea\u4e9b\u82f1\u96c4\u5355\u4f4d\u6700\u9002\u5408\u4e0d\u540c\u7c7b\u578b\u7684\u4efb\u52a1\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u4e0d\u540c\u7684\u82f1\u96c4\u5355\u4f4d\u64c5\u957f\u5404\u79cd\u7c7b\u578b\u7684\u4efb\u52a1\u3002\u5bf9\u4e8e\u641c\u522e\u4efb\u52a1\uff0c\u5177\u6709\u9ad8\u673a\u52a8\u6027\u548c\u9690\u853d\u6027\u7684\u82f1\u96c4\uff0c\u4f8b\u5982\u201c\u5f71\u5b50\u8dd1\u8005\u201d\uff0c\u662f\u7406\u60f3\u9009\u62e9\u3002\u5bf9\u4e8e\u9632\u5fa1\u4efb\u52a1\uff0c\u62e5\u6709\u9ad8\u8010\u4e45\u6027\u7684\u5766\u514b\u82f1\u96c4\uff0c\u4f8b\u5982\u201c\u94a2\u94c1\u5b88\u62a4\u8005\u201d\uff0c\u66f4\u6709\u6548\u3002\u4f8b\u5982\uff0c\u5728\u641c\u522e\u4efb\u52a1\u4e2d\u4f7f\u7528\u201c\u5f71\u5b50\u8dd1\u8005\u201d\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5feb\u901f\u6536\u96c6\u8d44\u6e90\uff0c\u540c\u65f6\u907f\u514d\u50f5\u5c38\u7684\u4fa6\u5bdf\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u589e\u52a0\u4e86\u6e38\u620f\u73a9\u6cd5\u7684\u590d\u6742\u6027\u3002\u4e0d\u540c\u7684\u5929\u6c14\u72b6\u51b5\u4f1a\u5f71\u54cd\u80fd\u89c1\u5ea6\u3001\u50f5\u5c38\u884c\u4e3a\u548c\u8d44\u6e90\u83b7\u53d6\u3002\u4f8b\u5982\uff0c\u5728\u66b4\u96e8\u671f\u95f4\uff0c\u7531\u4e8e\u5730\u9762\u6e7f\u6ed1\uff0c\u50f5\u5c38\u53ef\u80fd\u79fb\u52a8\u5f97\u66f4\u5feb\uff0c\u800c\u96fe\u5929\u4f1a\u964d\u4f4e\u80fd\u89c1\u5ea6\uff0c\u4f7f\u4f60\u66f4\u96be\u53d1\u73b0\u6765\u88ad\u7684\u5a01\u80c1\u3002\u73a9\u5bb6\u5fc5\u987b\u76f8\u5e94\u5730\u8c03\u6574\u7b56\u7565\uff0c\u4f8b\u5982\u5728\u96fe\u5929\u4f7f\u7528\u4fe1\u53f7\u5f39\u6765\u63d0\u9ad8\u80fd\u89c1\u5ea6\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u534f\u8c03\u548c\u8d44\u6e90\u5171\u4eab\u7684\u7a0b\u5ea6\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u72ec\u81ea\u8d1f\u8d23\u7ba1\u7406\u4f60\u7684\u57fa\u5730\u548c\u8d44\u6e90\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u5176\u4ed6\u73a9\u5bb6\u5408\u4f5c\u5efa\u7acb\u66f4\u5f3a\u5927\u7684\u9632\u5fa1\u5e76\u5206\u4eab\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e3a\u73a9\u5bb6\u5206\u914d\u7279\u5b9a\u89d2\u8272\uff0c\u6bd4\u5982\u4e00\u4e2a\u4eba\u4e13\u6ce8\u4e8e\u8d44\u6e90\u6536\u96c6\uff0c\u800c\u53e6\u4e00\u4e2a\u4eba\u4e13\u6ce8\u4e8e\u57fa\u5730\u9632\u5fa1\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u4f18\u5316\u57fa\u5730\u5e03\u5c40\u4ee5\u6700\u5927\u9650\u5ea6\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u4f18\u5316\u57fa\u5730\u5e03\u5c40\u5305\u62ec\u6218\u7565\u6027\u5730\u653e\u7f6e\u5efa\u7b51\u7269\u548c\u9632\u5fa1\u8bbe\u65bd\u3002\u6b65\u9aa41\uff1a\u5c06\u8d44\u6e90\u751f\u6210\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u519c\u573a\u548c\u77ff\u4e95\uff0c\u653e\u7f6e\u5728\u5b89\u5168\u533a\u57df\uff0c\u4ee5\u9632\u6b62\u5b83\u4eec\u88ab\u6467\u6bc1\u3002\u6b65\u9aa42\uff1a\u5c06\u9632\u5fa1\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u70ae\u5854\u548c\u57ce\u5899\uff0c\u653e\u7f6e\u5728\u9698\u53e3\u5904\uff0c\u4ee5\u51cf\u7f13\u50f5\u5c38\u7684\u63a8\u8fdb\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u5730\u5f62\u4f18\u52bf\uff0c\u5c06\u9ad8\u5730\u5efa\u7b51\u7269\u653e\u7f6e\u5728\u6709\u5229\u4f4d\u7f6e\uff0c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u89c6\u91ce\u548c\u5c04\u7a0b\u3002\u4f8b\u5982\uff0c\u5c06\u72d9\u51fb\u5854\u653e\u7f6e\u5728\u5c71\u4e0a\u53ef\u4ee5\u63d0\u4f9b\u6e05\u6670\u7684\u89c6\u91ce\u6765\u89c2\u5bdf\u6765\u88ad\u7684\u50f5\u5c38\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u50f5\u5c38\u751f\u6210\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u50f5\u5c38\u7684\u751f\u6210\u53d7\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\uff0c\u5305\u62ec\u65f6\u95f4\u3001\u73a9\u5bb6\u6d3b\u52a8\u548c\u57fa\u5730\u4f4d\u7f6e\u3002\u50f5\u5c38\u5728\u591c\u665a\u548c\u73a9\u5bb6\u6d3b\u52a8\u9891\u7e41\u7684\u533a\u57df\u66f4\u5bb9\u6613\u751f\u6210\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u4e8b\u4ef6\u8fd8\u4f1a\u89e6\u53d1\u5927\u89c4\u6a21\u50f5\u5c38\u6d6a\u6f6e\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6ee1\u6708\u201d\u6d3b\u52a8\u671f\u95f4\uff0c\u50f5\u5c38\u751f\u6210\u7684\u9891\u7387\u548c\u5f3a\u5ea6\u90fd\u4f1a\u663e\u8457\u589e\u52a0\uff0c\u8981\u6c42\u73a9\u5bb6\u52a0\u5f3a\u9632\u5fa1\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u5c06\u624b\u673a\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\uff1f", "answer": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u5c06\u624b\u673a\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u975e\u5e38\u7b80\u5355\u3002\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u4e91\u7aef\u5b58\u6863\u5e10\u6237\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\u3002\u6b65\u9aa42\uff1a\u5728\u7535\u8111\u4e0a\u5b89\u88c5\u6e38\u620f\u5e76\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa43\uff1a\u5c06\u8fdb\u5ea6\u4ece\u4e91\u7aef\u540c\u6b65\uff0c\u7ee7\u7eed\u4e0a\u6b21\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u624b\u673a\u4e0a\u5efa\u7acb\u4e86\u4e00\u4e2a\u6210\u719f\u7684\u57fa\u5730\uff0c\u4f60\u53ef\u4ee5\u8f7b\u677e\u5730\u5c06\u5176\u8f6c\u79fb\u5230\u7535\u8111\u4e0a\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u8fdb\u5ea6\u3002"}, {"question": "\u5728\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\uff0c\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u300a\u4e16\u754cZ\u9632\u5fa1 - \u50f5\u5c38\u9632\u5fa1\u300b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u5b83\u4eec\u53c2\u8003\u4e86\u6d41\u884c\u7684\u50f5\u5c38\u6587\u5316\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201c\u50f5\u5c38\u8096\u6069\u201d\u7684\u53c2\u8003\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u7279\u5b9a\u4f4d\u7f6e\u627e\u5230\u4e00\u4e2a\u540d\u4e3a\u8096\u6069\u7684\u89d2\u8272\uff0c\u624b\u91cc\u62ff\u7740\u677f\u7403\u68d2\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u201c\u751f\u5316\u5371\u673a\u201d\u81f4\u656c\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e00\u4e2a\u9690\u85cf\u7684\u5b9e\u9a8c\u5ba4\u91cc\u53d1\u73b0\u4f1e\u516c\u53f8\u6807\u5fd7\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u559c\u6b22\u8be5\u7c7b\u578b\u7684\u7c89\u4e1d\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u6000\u65e7\u611f\u3002"}]
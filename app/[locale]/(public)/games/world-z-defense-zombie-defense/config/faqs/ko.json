[{"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uae30\uc9c0\ub97c \uc5b4\ub5bb\uac8c \uac74\uc124\ud558\uae30 \uc2dc\uc791\ud558\ub098\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \uae30\uc9c0\ub97c \uac74\uc124\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4: \uc784\ubb34\ub97c \uc644\ub8cc\ud558\uac70\ub098 \uc624\ud508 \uc6d4\ub4dc\uc5d0\uc11c \uc790\uc6d0\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uac74\uc124 \uba54\ub274\uc5d0 \uc561\uc138\uc2a4\ud558\uc5ec \uac10\uc2dc\ud0d1\uc774\ub098 \uc790\uc6d0 \uc800\uc7a5\uc18c\uc640 \uac19\uc774 \ub9cc\ub4e4\uace0 \uc2f6\uc740 \uad6c\uc870\ubb3c\uc758 \uc720\ud615\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uae30\uc9c0 \ub0b4 \ucd5c\uc801\uc758 \uc704\uce58\uc5d0 \uad6c\uc870\ubb3c\uc744 \ubc30\uce58\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc785\uad6c \uadfc\ucc98\uc5d0 \uac10\uc2dc\ud0d1\uc744 \ubc30\uce58\ud558\uba74 \ubab0\ub824\uc624\ub294 \uc880\ube44 \ubb34\ub9ac\ub97c \ub9c9\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \ub300\uaddc\ubaa8 \uc880\ube44 \ubb34\ub9ac\ub97c \ub9c9\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \ub300\uaddc\ubaa8 \uc880\ube44 \ubb34\ub9ac\ub97c \ub9c9\uc73c\ub824\uba74 \uc804\ub7b5\uc801 \ubc30\uce58\uc640 \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ubcbd\uacfc \ud3ec\ud0d1\uacfc \uac19\uc740 \ubc29\uc5b4 \uad6c\uc870\ubb3c\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ub0b4\uad6c\uc131\uacfc \ud654\ub825\uc744 \ub192\uc785\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc218\ub958\ud0c4\uc774\ub098 \ud654\uc5fc \ubc29\uc0ac\uae30\uc640 \uac19\uc740 \uad11\uc5ed \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb34\ub9ac\ub97c \uc904\uc785\ub2c8\ub2e4. 3\ub2e8\uacc4: \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ud611\ub825\ud558\uc5ec \ubaa8\ub4e0 \uc9c4\uc785 \uc9c0\uc810\uc744 \ucee4\ubc84\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0b4\uc544\uc788\ub294 \uc2dc\uccb4\ub4e4\uc758 \ubc24' \uc774\ubca4\ud2b8 \ub3d9\uc548 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uacb9\uce58\ub294 \uc0ac\uaca9 \uc9c4\uc9c0\ub97c \uc124\uc815\ud558\uba74 \ubb34\ub9ac\uc758 \uc218\ub97c \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub294 \uae30\uc9c0\ub97c \uac74\uc124, \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \uc720\uc9c0\ud558\ub294 \ub2a5\ub825\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub098\ubb34, \uae08\uc18d, \uc74c\uc2dd\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uba74 \ubc29\uc5b4\ub825\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uac1c\uc120\ud558\uace0 \uc880\ube44 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ub354 \uc624\ub798 \uc0dd\uc874\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\ub294 \uac83\uacfc \uae30\uc874 \uad6c\uc870\ubb3c\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83 \uc0ac\uc774\uc5d0 \uc790\uc6d0 \ud560\ub2f9\uc758 \uade0\ud615\uc744 \ub9de\ucd94\uba74 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc880\ube44 \uc6e8\uc774\ube0c\uc640 \uac19\uc740 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ubd80\uc871\uc744 \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc5b4\ub5a4 \uc601\uc6c5 \uc720\ub2db\uc774 \ub2e4\uc591\ud55c \uc720\ud615\uc758 \uc784\ubb34\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778\uac00\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \ub2e4\uc591\ud55c \uc601\uc6c5 \uc720\ub2db\uc740 \ub2e4\uc591\ud55c \uc720\ud615\uc758 \uc784\ubb34\uc5d0\uc11c \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. \uccad\uc18c \uc784\ubb34\uc758 \uacbd\uc6b0 '\uc100\ub3c4\uc6b0 \ub7ec\ub108'\uc640 \uac19\uc774 \uc774\ub3d9\uc131\uacfc \uc740\uc2e0\uc774 \ub6f0\uc5b4\ub09c \uc601\uc6c5\uc774 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \ubc29\uc5b4 \uc784\ubb34\uc758 \uacbd\uc6b0 '\uc544\uc774\uc5b8 \uac00\ub514\uc5b8'\uacfc \uac19\uc774 \ub0b4\uad6c\uc131\uc774 \ub192\uc740 \ud0f1\ucee4 \uc601\uc6c5\uc774 \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccad\uc18c \uc784\ubb34\uc5d0\uc11c '\uc100\ub3c4\uc6b0 \ub7ec\ub108'\ub97c \uc0ac\uc6a9\ud558\uba74 \uc880\ube44 \ud0d0\uc9c0\ub97c \ud53c\ud558\uba74\uc11c \ube60\ub974\uac8c \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc774 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "World Z Defense - Zombie Defense\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ubcf5\uc7a1\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ub0a0\uc528 \uc870\uac74\uc740 \uac00\uc2dc\uc131, \uc880\ube44 \ud589\ub3d9 \ubc0f \uc790\uc6d0 \uac00\uc6a9\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud3ed\uc6b0\uac00 \ub0b4\ub9ac\ub294 \ub3d9\uc548 \uc880\ube44\ub294 \ubbf8\ub044\ub7ec\uc6b4 \uc9c0\ud615\uc73c\ub85c \uc778\ud574 \ub354 \ube68\ub9ac \uc6c0\uc9c1\uc77c \uc218 \uc788\uc73c\uba70, \uc548\uac1c\ub294 \uac00\uc2dc\uc131\uc744 \uc904\uc5ec \ub2e4\uac00\uc624\ub294 \uc704\ud611\uc744 \ubc1c\uacac\ud558\uae30 \uc5b4\ub835\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc548\uac1c\uac00 \uc790\uc6b1\ud55c \uc870\uac74\uc5d0\uc11c \uac00\uc2dc\uc131\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc870\uba85\ud0c4\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\uc774 \uc804\ub7b5\uc744 \uc801\uc808\ud788 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ud611\ub825 \uc218\uc900\uacfc \uc790\uc6d0 \uacf5\uc720\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uae30\uc9c0\uc640 \uc790\uc6d0 \uad00\ub9ac\uc5d0 \ub300\ud55c \ucc45\uc784\uc740 \uc804\uc801\uc73c\ub85c \uadc0\ud558\uc5d0\uac8c \uc788\uc2b5\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ud611\ub825\ud558\uc5ec \ub354 \uac15\ub825\ud55c \ubc29\uc5b4\ub825\uc744 \uad6c\ucd95\ud558\uace0 \uc790\uc6d0\uc744 \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\uc815 \uc5ed\ud560\uc744 \ud560\ub2f9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uba85\uc740 \uc790\uc6d0 \uc218\uc9d1\uc5d0 \uc9d1\uc911\ud558\uace0 \ub2e4\ub978 \ud55c \uba85\uc740 \uae30\uc9c0 \ubc29\uc5b4\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud574 \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uad6c\uc870\ubb3c\uacfc \ubc29\uc5b4 \uc2dc\uc124\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ubc30\uce58\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub18d\uc7a5 \ubc0f \uad11\uc0b0\uacfc \uac19\uc740 \uc790\uc6d0 \uc0dd\uc131 \uad6c\uc870\ubb3c\uc744 \ud30c\uad34\ub418\uc9c0 \uc54a\ub3c4\ub85d \uc548\uc804\ud55c \uc9c0\uc5ed\uc5d0 \ubc30\uce58\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud3ec\ud0d1 \ubc0f \ubcbd\uacfc \uac19\uc740 \ubc29\uc5b4 \uad6c\uc870\ubb3c\uc744 \uc880\ube44\uc758 \uc9c4\uaca9\uc744 \ub2a6\ucd94\uae30 \uc704\ud574 \ubcd1\ubaa9 \uc9c0\uc810\uc5d0 \ubc30\uce58\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub354 \ub098\uc740 \uac00\uc2dc\uc131\uacfc \ubc94\uc704\ub97c \uc704\ud574 \ub192\uc740 \uc9c0\uc0c1 \uad6c\uc870\ubb3c\uc744 \ubc30\uce58\ud558\uc5ec \uc9c0\ud615\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b8\ub355\uc5d0 \uc800\uaca9\uc218 \ud0c0\uc6cc\ub97c \ubc30\uce58\ud558\uba74 \ub2e4\uac00\uc624\ub294 \uc880\ube44\uc5d0 \ub300\ud55c \uba85\ud655\ud55c \uc2dc\uc57c\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc880\ube44 \uc2a4\ud3f0\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc880\ube44 \uc2a4\ud3f0\uc740 \uc2dc\uac04, \ud50c\ub808\uc774\uc5b4 \ud65c\ub3d9 \ubc0f \uae30\uc9c0 \uc704\uce58\ub97c \ud3ec\ud568\ud55c \uc5ec\ub7ec \uc694\uc778\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc880\ube44\ub294 \ubc24\uacfc \ud50c\ub808\uc774\uc5b4 \ud65c\ub3d9\uc774 \ub9ce\uc740 \uc9c0\uc5ed\uc5d0\uc11c \uc2a4\ud3f0\ub420 \uac00\ub2a5\uc131\uc774 \ub354 \ub192\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud2b9\uc815 \uc774\ubca4\ud2b8\ub294 \ub354 \ud070 \uc880\ube44 \uc6e8\uc774\ube0c\ub97c \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub9cc\uc6d4' \uc774\ubca4\ud2b8 \ub3d9\uc548 \uc880\ube44 \uc2a4\ud3f0\uc758 \ube48\ub3c4\uc640 \uac15\ub3c4\uac00 \ud06c\uac8c \uc99d\uac00\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \ubc29\uc5b4\ub825\uc744 \uac15\ud654\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud558\ub098\uc694?", "answer": "World Z Defense - Zombie Defense\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac8c\uc784\uc774 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: PC\uc5d0 \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc5ec \uc911\ub2e8\ud55c \ubd80\ubd84\ubd80\ud130 \uacc4\uc18d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0 \uc798 \uad6c\ucd95\ub41c \uae30\uc9c0\uac00 \uc788\ub294 \uacbd\uc6b0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uace0 PC\ub85c \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "World Z Defense - Zombie Defense\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "World Z Defense - Zombie Defense\ub294 \uc778\uae30 \uc788\ub294 \uc880\ube44 \ubb38\ud654\ub97c \ucc38\uc870\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 '\uc0c8\ubcbd\uc758 \ud669\ub2f9\ud55c \uc800\uc8fc' \ub808\ud37c\ub7f0\uc2a4\ub85c, \ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc815 \uc704\uce58\uc5d0\uc11c \ud06c\ub9ac\ucf13 \ubc30\ud2b8\ub97c \ud718\ub450\ub974\ub294 Shaun\uc774\ub77c\ub294 \uce90\ub9ad\ud130\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\ub808\uc9c0\ub358\ud2b8 \uc774\ube14' \uc624\ub9c8\uc8fc\ub85c, \ud50c\ub808\uc774\uc5b4\ub294 Umbrella Corporation \ub85c\uace0\uac00 \uc788\ub294 \uc228\uaca8\uc9c4 \uc5f0\uad6c\uc18c\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc7a5\ub974 \ud32c\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\uc640 \ud5a5\uc218\ub97c \ub354\ud569\ub2c8\ub2e4."}]
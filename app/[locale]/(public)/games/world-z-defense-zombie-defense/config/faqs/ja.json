[{"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u57fa\u5730\u3092\u3069\u306e\u3088\u3046\u306b\u69cb\u7bc9\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u57fa\u5730\u3092\u69cb\u7bc9\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u304b\u3001\u30aa\u30fc\u30d7\u30f3\u30ef\u30fc\u30eb\u30c9\u3067\u8cc7\u6e90\u3092\u53ce\u96c6\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5efa\u8a2d\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u30a6\u30a9\u30fc\u30bf\u30ef\u30fc\u3084\u8cc7\u6e90\u5009\u5eab\u306a\u3069\u306e\u69cb\u9020\u7269\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u305d\u306e\u69cb\u9020\u7269\u3092\u57fa\u5730\u5185\u3067\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u767a\u63ee\u3067\u304d\u308b\u6700\u9069\u306a\u5834\u6240\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5165\u308a\u53e3\u8fd1\u304f\u306b\u30a6\u30a9\u30fc\u30bf\u30ef\u30fc\u3092\u8a2d\u7f6e\u3059\u308b\u3068\u3001\u8972\u3044\u304b\u304b\u308b\u30be\u30f3\u30d3\u306e\u6ce2\u3092\u9632\u3050\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u5927\u91cf\u306e\u30be\u30f3\u30d3\u7fa4\u3092\u9632\u3050\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u5927\u91cf\u306e\u30be\u30f3\u30d3\u7fa4\u3092\u9632\u3050\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u914d\u7f6e\u3068\u8cc7\u6e90\u7ba1\u7406\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u58c1\u3084\u30bf\u30fc\u30ec\u30c3\u30c8\u306a\u3069\u306e\u9632\u5fa1\u69cb\u9020\u7269\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u3001\u8010\u4e45\u6027\u3068\u706b\u529b\u30a2\u30c3\u30d7\u30b0\u30ec\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30ec\u30cd\u30fc\u30c9\u3084\u706b\u708e\u653e\u5c04\u5668\u306a\u3069\u306e\u7bc4\u56f2\u653b\u6483\u5175\u5668\u3092\u4f7f\u7528\u3057\u3066\u3001\u7fa4\u308c\u3092\u8584\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5354\u529b\u3057\u3066\u3001\u3059\u3079\u3066\u306e\u5165\u308a\u53e3\u3092\u30ab\u30d0\u30fc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u6b7b\u8005\u306e\u591c\u300f\u30a4\u30d9\u30f3\u30c8\u4e2d\u306f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u91cd\u8907\u3059\u308b\u653b\u6483\u7bc4\u56f2\u3092\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u3067\u3001\u7fa4\u308c\u306e\u6570\u3092\u5927\u5e45\u306b\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u57fa\u5730\u3092\u69cb\u7bc9\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u7dad\u6301\u3059\u308b\u305f\u3081\u306e\u80fd\u529b\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u6728\u6750\u3001\u91d1\u5c5e\u3001\u98df\u6599\u306a\u3069\u306e\u8cc7\u6e90\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u30be\u30f3\u30d3\u653b\u6483\u304b\u3089\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308c\u308b\u3088\u3046\u3001\u7d99\u7d9a\u7684\u306b\u9632\u5fa1\u529b\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u65b0\u3057\u3044\u69cb\u9020\u7269\u306e\u5efa\u8a2d\u3068\u65e2\u5b58\u69cb\u9020\u7269\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u9593\u306b\u8cc7\u6e90\u306e\u5272\u308a\u5f53\u3066\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u7a81\u7136\u306e\u30be\u30f3\u30d3\u306e\u6ce2\u306a\u3069\u3001\u91cd\u8981\u306a\u77ac\u9593\u306b\u4e0d\u8db3\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30d7\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d2\u30fc\u30ed\u30fc\u30e6\u30cb\u30c3\u30c8\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30d7\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u30d2\u30fc\u30ed\u30fc\u30e6\u30cb\u30c3\u30c8\u306e\u52b9\u679c\u306f\u7570\u306a\u308a\u307e\u3059\u3002\u7565\u596a\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u300e\u5f71\u306e\u30e9\u30f3\u30ca\u30fc\u300f\u306e\u3088\u3046\u306a\u9ad8\u3044\u79fb\u52d5\u6027\u3068\u30b9\u30c6\u30eb\u30b9\u80fd\u529b\u3092\u6301\u3064\u30d2\u30fc\u30ed\u30fc\u304c\u7406\u60f3\u7684\u3067\u3059\u3002\u9632\u885b\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u300e\u9244\u306e\u5b88\u8b77\u8005\u300f\u306e\u3088\u3046\u306a\u9ad8\u3044\u8010\u4e45\u529b\u3092\u6301\u3064\u30bf\u30d5\u306a\u30d2\u30fc\u30ed\u30fc\u304c\u3088\u308a\u52b9\u679c\u7684\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7565\u596a\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u300e\u5f71\u306e\u30e9\u30f3\u30ca\u30fc\u300f\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30be\u30f3\u30d3\u306e\u691c\u77e5\u3092\u56de\u907f\u3057\u306a\u304c\u3089\u8fc5\u901f\u306b\u8cc7\u6e90\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u8907\u96d1\u3055\u3092\u52a0\u3048\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u5929\u5019\u6761\u4ef6\u306f\u3001\u8996\u754c\u3001\u30be\u30f3\u30d3\u306e\u884c\u52d5\u3001\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6fc0\u3057\u3044\u96e8\u306e\u65e5\u306f\u3001\u30be\u30f3\u30d3\u304c\u6ed1\u308a\u3084\u3059\u3044\u5730\u5f62\u306e\u305f\u3081\u306b\u79fb\u52d5\u901f\u5ea6\u304c\u901f\u304f\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u4e00\u65b9\u3067\u3001\u9727\u306f\u8996\u754c\u3092\u4f4e\u4e0b\u3055\u305b\u3066\u3001\u8972\u3044\u304b\u304b\u308b\u8105\u5a01\u3092\u898b\u3064\u3051\u308b\u306e\u3092\u96e3\u3057\u304f\u3057\u307e\u3059\u3002\u30d7\u30ec\u30fc\u30e4\u30fc\u306f\u3001\u9727\u306e\u72b6\u6cc1\u4e0b\u3067\u306e\u8996\u754c\u6539\u5584\u306e\u305f\u3081\u306b\u4fe1\u53f7\u5f3e\u3092\u4f7f\u7528\u3059\u308b\u306a\u3069\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u9023\u643a\u3068\u8cc7\u6e90\u5171\u6709\u306e\u30ec\u30d9\u30eb\u306b\u3042\u308a\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u57fa\u5730\u3068\u8cc7\u6e90\u306e\u7ba1\u7406\u3092\u5358\u72ec\u3067\u884c\u3044\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5354\u529b\u3057\u3066\u3088\u308a\u5f37\u529b\u306a\u9632\u5fa1\u3092\u69cb\u7bc9\u3057\u3001\u8cc7\u6e90\u3092\u5171\u6709\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u7279\u5b9a\u306e\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8cc7\u6e90\u53ce\u96c6\u306b\u96c6\u4e2d\u3057\u3001\u5225\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u57fa\u5730\u9632\u885b\u306b\u96c6\u4e2d\u3059\u308b\u3068\u3044\u3046\u3088\u3046\u306b\u3067\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u57fa\u5730\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u5927\u9650\u306b\u52b9\u7387\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u57fa\u5730\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u69cb\u9020\u7269\u3068\u9632\u5fa1\u306e\u6226\u7565\u7684\u306a\u914d\u7f6e\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8fb2\u5834\u3084\u9271\u5c71\u306a\u3069\u306e\u8cc7\u6e90\u751f\u6210\u69cb\u9020\u7269\u3092\u5b89\u5168\u306a\u5834\u6240\u306b\u914d\u7f6e\u3057\u3066\u3001\u7834\u58ca\u3092\u9632\u304e\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bf\u30fc\u30ec\u30c3\u30c8\u3084\u58c1\u306a\u3069\u306e\u9632\u5fa1\u69cb\u9020\u7269\u3092\u9698\u8def\u306b\u914d\u7f6e\u3057\u3066\u3001\u30be\u30f3\u30d3\u306e\u9032\u884c\u3092\u9045\u3089\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5730\u5f62\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u3066\u3001\u9ad8\u5730\u306e\u69cb\u9020\u7269\u3092\u914d\u7f6e\u3057\u3001\u3088\u308a\u826f\u3044\u8996\u754c\u3068\u5c04\u7a0b\u3092\u5f97\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e18\u306e\u4e0a\u306b\u30b9\u30ca\u30a4\u30d1\u30fc\u30bf\u30ef\u30fc\u3092\u8a2d\u7f6e\u3059\u308b\u3068\u3001\u8972\u3044\u304b\u304b\u308b\u30be\u30f3\u30d3\u306b\u660e\u78ba\u306a\u8996\u754c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306b\u304a\u3051\u308b\u30be\u30f3\u30d3\u306e\u51fa\u73fe\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306b\u304a\u3051\u308b\u30be\u30f3\u30d3\u306e\u51fa\u73fe\u306f\u3001\u6642\u9593\u5e2f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6d3b\u52d5\u3001\u57fa\u5730\u306e\u4f4d\u7f6e\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30be\u30f3\u30d3\u306f\u591c\u9593\u306b\u3001\u305d\u3057\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6d3b\u52d5\u304c\u6d3b\u767a\u306a\u30a8\u30ea\u30a2\u3067\u51fa\u73fe\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u7279\u5b9a\u306e\u30a4\u30d9\u30f3\u30c8\u306b\u3088\u3063\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u30be\u30f3\u30d3\u306e\u6ce2\u304c\u767a\u751f\u3059\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u6e80\u6708\u300f\u30a4\u30d9\u30f3\u30c8\u4e2d\u306f\u3001\u30be\u30f3\u30d3\u306e\u51fa\u73fe\u983b\u5ea6\u3068\u5f37\u5ea6\u304c\u5897\u52a0\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9632\u5fa1\u529b\u3092\u5f37\u5316\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u65b9\u6cd5\u306f\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u306f\u7c21\u5358\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u3092Google Play\u3084Apple Game Center\u306a\u3069\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aPC\u306b\u30b2\u30fc\u30e0\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u304b\u3089\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u3066\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u78ba\u7acb\u3055\u308c\u305f\u57fa\u5730\u304c\u3042\u308b\u5834\u5408\u3001PC\u306b\u79fb\u884c\u3057\u3066\u3082\u9032\u6357\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9Z\u9632\u885b - \u30be\u30f3\u30d3\u9632\u885b\u306b\u306f\u3001\u4eba\u6c17\u306e\u3042\u308b\u30be\u30f3\u30d3\u6587\u5316\u3092\u53c2\u7167\u3057\u305f\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300e\u30b7\u30e3\u30a6\u30f3\u306e\u6b7b\u300f\u3078\u306e\u8a00\u53ca\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7279\u5b9a\u306e\u5834\u6240\u306b\u3001\u30af\u30ea\u30b1\u30c3\u30c8\u30d0\u30c3\u30c8\u3092\u6301\u3064\u30b7\u30e3\u30a6\u30f3\u3068\u3044\u3046\u4eba\u7269\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300e\u30d0\u30a4\u30aa\u30cf\u30b6\u30fc\u30c9\u300f\u3078\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30a2\u30f3\u30d6\u30ec\u30e9\u793e\u306e\u30ed\u30b4\u304c\u5165\u3063\u305f\u79d8\u5bc6\u306e\u7814\u7a76\u6240\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u3053\u306e\u30b8\u30e3\u30f3\u30eb\u306e\u30d5\u30a1\u30f3\u306b\u3068\u3063\u3066\u3001\u3055\u3089\u306a\u308b\u697d\u3057\u307f\u3068\u30ce\u30b9\u30bf\u30eb\u30b8\u30fc\u3092\u4e0e\u3048\u307e\u3059\u3002"}]
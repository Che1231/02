[{"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u6700\u521d\u306e\u5e97\u8217\u3092\u3069\u306e\u3088\u3046\u306b\u8a2d\u5b9a\u3057\u307e\u3059\u304b\uff1f", "answer": "\u6700\u521d\u306e\u5e97\u8217\u3092\u8a2d\u5b9a\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e88\u7b97\u3068\u30bf\u30fc\u30b2\u30c3\u30c8\u9867\u5ba2\u5c64\u306b\u5408\u3063\u305f\u30de\u30c3\u30d7\u4e0a\u306e\u5834\u6240\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u68da\u3001\u30ab\u30a6\u30f3\u30bf\u30fc\u3001\u30ec\u30b8\u306a\u3069\u306e\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5728\u5eab\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u5546\u54c1\u3092\u68da\u306b\u88dc\u5145\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u306e\u9867\u5ba2\u3092\u5f15\u304d\u4ed8\u3051\u308b\u305f\u3081\u306b\u3001\u30d1\u30f3\u3084\u725b\u4e73\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u98df\u6599\u54c1\u304b\u3089\u59cb\u3081\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u9867\u5ba2\u6e80\u8db3\u5ea6\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9867\u5ba2\u6e80\u8db3\u5ea6\u306f\u3001\u5e97\u8217\u306e\u8a55\u5224\u3068\u58f2\u4e0a\u9ad8\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u6539\u5584\u3059\u308b\u306b\u306f\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u68da\u306b\u5e38\u306b\u4eba\u6c17\u5546\u54c1\u304c\u88dc\u5145\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5e97\u8217\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6e05\u6f54\u3067\u6574\u7406\u6574\u9813\u3055\u308c\u305f\u72b6\u614b\u306b\u4fdd\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30bf\u30c3\u30d5\u3092\u8a13\u7df4\u3057\u3066\u3001\u9867\u5ba2\u306e\u554f\u3044\u5408\u308f\u305b\u3092\u52b9\u7387\u7684\u306b\u51e6\u7406\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30b8\u8fd1\u304f\u306e\u30b9\u30ca\u30c3\u30af\u306a\u3069\u3001\u3088\u304f\u8cfc\u5165\u3055\u308c\u308b\u5546\u54c1\u3092\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u5f85\u3061\u6642\u9593\u3092\u77ed\u7e2e\u3057\u3001\u6e80\u8db3\u5ea6\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u5546\u54c1\u306e\u4fa1\u683c\u8a2d\u5b9a\u3092\u884c\u3046\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u52b9\u679c\u7684\u306a\u4fa1\u683c\u8a2d\u5b9a\u6226\u7565\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e02\u5834\u8abf\u67fb\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u3066\u7af6\u5408\u4ed6\u793e\u306e\u4fa1\u683c\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9700\u8981\u3068\u4f9b\u7d66\u306b\u57fa\u3065\u3044\u3066\u4fa1\u683c\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9591\u6563\u671f\u306b\u306f\u4fa1\u683c\u3092\u4e0b\u3052\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u9867\u5ba2\u3092\u5f15\u304d\u4ed8\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5b63\u7bc0\u5546\u54c1\u306b\u306f\u52d5\u7684\u4fa1\u683c\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96e8\u5b63\u306b\u306f\u5098\u306e\u4fa1\u683c\u3092\u4e0a\u3052\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u9867\u5ba2\u306e\u79fb\u52d5\u6642\u9593\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u5e97\u8217\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c7\u30fc\u30bf\u5206\u6790\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u53ce\u76ca\u88fd\u54c1\u3092\u7279\u5b9a\u3057\u3001\u305d\u306e\u8ca9\u58f2\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30d4\u30fc\u30bf\u30fc\u9867\u5ba2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u3001\u30ed\u30a4\u30e4\u30eb\u30c6\u30a3\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u65bd\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u300110\u56de\u76ee\u306e\u8cfc\u5165\u3067\u5272\u5f15\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u3001\u9867\u5ba2\u306e\u7dad\u6301\u7387\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u306e\u4f9b\u7d66\u30c1\u30a7\u30fc\u30f3\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u4f9b\u7d66\u30c1\u30a7\u30fc\u30f3\u30b7\u30b9\u30c6\u30e0\u306f\u4ee5\u4e0b\u306e\u624b\u9806\u3092\u542b\u307f\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u9700\u8981\u4e88\u6e2c\u306b\u57fa\u3065\u3044\u3066\u30b5\u30d7\u30e9\u30a4\u30e4\u30fc\u304b\u3089\u5546\u54c1\u3092\u6ce8\u6587\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5728\u5eab\u30ec\u30d9\u30eb\u3092\u7ba1\u7406\u3057\u3066\u3001\u904e\u5270\u5728\u5eab\u3084\u5728\u5eab\u5207\u308c\u3092\u9632\u304e\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7d0d\u671f\u3092\u6d3b\u7528\u3057\u3066\u3001\u6642\u9593\u901a\u308a\u306e\u88dc\u5145\u3092\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u58f2\u308c\u7b4b\u5546\u54c1\u3067\u3042\u308b\u65b0\u9bae\u306a\u8fb2\u7523\u7269\u81ea\u52d5\u518d\u767a\u6ce8\u3092\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u3067\u3001\u696d\u52d9\u3092\u5408\u7406\u5316\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u5c0f\u898f\u6a21\u5e97\u8217\u3068\u5927\u898f\u6a21\u5e97\u8217\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5c0f\u898f\u6a21\u5e97\u8217\u306f\u7ba1\u7406\u304c\u5bb9\u6613\u3067\u521d\u671f\u6295\u8cc7\u3082\u5c11\u306a\u304f\u3066\u6e08\u307f\u307e\u3059\u304c\u3001\u5927\u898f\u6a21\u5e97\u8217\u306f\u53ce\u76ca\u6027\u304c\u9ad8\u3044\u3082\u306e\u306e\u3001\u30b9\u30bf\u30c3\u30d5\u3068\u8907\u96d1\u306a\u7269\u6d41\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5c0f\u898f\u6a21\u5e97\u8217\u306f\u30aa\u30fc\u30ac\u30cb\u30c3\u30af\u88fd\u54c1\u306e\u3088\u3046\u306a\u30cb\u30c3\u30c1\u306a\u5e02\u5834\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u306e\u306b\u5bfe\u3057\u3001\u5927\u898f\u6a21\u5e97\u8217\u306f\u591a\u69d8\u306a\u9867\u5ba2\u5c64\u3092\u5f15\u304d\u4ed8\u3051\u308b\u305f\u3081\u306b\u5e45\u5e83\u3044\u5546\u54c1\u3092\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u3092\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u304b\u3089\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Google Play\u30b2\u30fc\u30e0\u3084Apple\u30b2\u30fc\u30e0\u30bb\u30f3\u30bf\u30fc\u306a\u3069\u306e\u30b5\u30fc\u30d3\u30b9\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u4fc3\u9032\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306b\u306f\u4ee5\u4e0b\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u9023\u5ba2\u306b\u30e9\u30f3\u30c0\u30e0\u306b\u8868\u793a\u3055\u308c\u308b\u7279\u5225\u306a\u5272\u5f15\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7279\u5b9a\u306e\u8ab2\u984c\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3057\u304b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u306a\u3044\u79d8\u5bc6\u30a2\u30a4\u30c6\u30e0\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5e97\u8217\u306e\u30c8\u30e9\u30d5\u30a3\u30c3\u30af\u3092\u5897\u52a0\u3055\u305b\u308b\u30bb\u30ec\u30d6\u306e\u6765\u5e97\u306a\u3069\u306e\u30ec\u30a2\u30a4\u30d9\u30f3\u30c8\u3002\u4f8b\u3048\u3070\u3001\u5e97\u5185\u3067\u91d1\u306e\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30ab\u30fc\u30c8\u3092\u898b\u3064\u3051\u308b\u3068\u3001\u9650\u5b9a\u88c5\u98fe\u30a2\u30a4\u30c6\u30e0\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u5f93\u696d\u54e1\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u5f93\u696d\u54e1\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e97\u8217\u306e\u898f\u6a21\u306b\u57fa\u3065\u3044\u3066\u9069\u5207\u306a\u6570\u306e\u5f93\u696d\u54e1\u3092\u96c7\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ec\u30b8\u4fc2\u3001\u5728\u5eab\u4fc2\u3001\u6e05\u6383\u4fc2\u306a\u3069\u306e\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u3001\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f93\u696d\u54e1\u306e\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u5b9a\u671f\u7684\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9867\u5ba2\u306e\u82e6\u60c5\u306b\u5bfe\u5fdc\u3059\u308b\u62c5\u5f53\u8005\u3092\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30b5\u30fc\u30d3\u30b9\u306e\u8cea\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30de\u30fc\u30b1\u30c3\u30c8\u30fb\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\uff1a\u30b9\u30c8\u30a2\u30fb\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u3067\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u72af\u3057\u3084\u3059\u3044\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u56de\u907f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e00\u822c\u7684\u306a\u30df\u30b9\u306b\u306f\u4ee5\u4e0b\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u3059\u3050\u306b\u58f2\u308c\u306a\u3044\u5546\u54c1\u3092\u904e\u5270\u306b\u5728\u5eab\u3057\u3001\u7121\u99c4\u306b\u306a\u308b\u3053\u3068\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9867\u5ba2\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u7121\u8996\u3057\u3001\u305d\u308c\u304c\u5e97\u8217\u306e\u8a55\u5224\u3092\u640d\u306a\u3046\u3053\u3068\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d4\u30fc\u30af\u6642\u306e\u4eba\u54e1\u4e0d\u8db3\u3067\u3001\u9577\u3044\u5f85\u3061\u6642\u9593\u306b\u306a\u308b\u3053\u3068\u3002\u3053\u308c\u3089\u306e\u554f\u984c\u3092\u907f\u3051\u308b\u306b\u306f\u3001\u8ca9\u58f2\u30c7\u30fc\u30bf\u3092\u5b9a\u671f\u7684\u306b\u78ba\u8a8d\u3057\u3001\u6226\u7565\u3092\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}]
[{"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uccab \ubc88\uc9f8 \ub9e4\uc7a5\uc744 \uc5b4\ub5bb\uac8c \uc124\uc815\ud569\ub2c8\uae4c?", "answer": "\uccab \ubc88\uc9f8 \ub9e4\uc7a5\uc744 \uc124\uc815\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc608\uc0b0\uacfc \ud0c0\uac9f \uace0\uac1d\uce35\uc5d0 \uc801\ud569\ud55c \uc9c0\ub3c4\uc5d0\uc11c \uc704\uce58\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \uc120\ubc18, \uacc4\uc0b0\ub300 \ubc0f \uacc4\uc0b0\uae30\uc640 \uac19\uc740 \ud544\uc218\ud488\uc744 \uad6c\ub9e4\ud569\ub2c8\ub2e4. STEP3 - \uc7ac\uace0 \uba54\ub274\uc5d0\uc11c \uc81c\ud488\uc73c\ub85c \uc120\ubc18\uc744 \ucc44\uc6c1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \uace0\uac1d\uc744 \uc720\uce58\ud558\uae30 \uc704\ud574 \ube75\uacfc \uc6b0\uc720\uc640 \uac19\uc740 \uae30\ubcf8 \uc2dd\ub8cc\ud488\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uace0\uac1d \ub9cc\uc871\ub3c4\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uace0\uac1d \ub9cc\uc871\ub3c4\ub294 \ub9e4\uc7a5\uc758 \ud3c9\ud310\uacfc \ud310\ub9e4\ub7c9\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uac1c\uc120\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - \uc120\ubc18\uc5d0 \uc778\uae30 \uc788\ub294 \ud488\ubaa9\uc774 \ud56d\uc0c1 \ucc44\uc6cc\uc838 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - \uae54\ub054\ud558\uace0 \uc815\ub3c8\ub41c \ub9e4\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. STEP3 - \uc9c1\uc6d0\uc744 \uad50\uc721\ud558\uc5ec \uace0\uac1d \ubb38\uc758\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ucc98\ub9ac\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacc4\uc0b0\ub300 \uadfc\ucc98\uc5d0 \uc2a4\ub0b5\uacfc \uac19\uc740 \uc790\uc8fc \uad6c\ub9e4\ud558\ub294 \ud488\ubaa9\uc744 \ubc30\uce58\ud558\uba74 \ub300\uae30 \uc2dc\uac04\uc744 \uc904\uc774\uace0 \ub9cc\uc871\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc81c\ud488 \uac00\uaca9 \ucc45\uc815 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud6a8\uacfc\uc801\uc778 \uac00\uaca9 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \uc2dc\uc7a5 \uc870\uc0ac \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacbd\uc7c1\uc0ac \uac00\uaca9\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. STEP2 - \uc218\uc694\uc640 \uacf5\uae09\uc5d0 \ub530\ub77c \uac00\uaca9\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube44\uc218\uae30\uc5d0 \uac00\uaca9\uc744 \uc778\ud558\ud558\uc5ec \ub354 \ub9ce\uc740 \uace0\uac1d\uc744 \uc720\uce58\ud569\ub2c8\ub2e4. STEP3 - \uacc4\uc808 \uc0c1\ud488\uc5d0 \ub300\ud574 \ub3d9\uc801 \uac00\uaca9 \ucc45\uc815\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6b0\uae30\uc5d0\ub294 \uc6b0\uc0b0 \uac00\uaca9\uc744 \uc778\uc0c1\ud569\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - \uace0\uac1d\uc758 \uc774\ub3d9 \uc2dc\uac04\uc744 \uc904\uc774\uae30 \uc704\ud574 \ub9e4\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. STEP2 - \ub370\uc774\ud130 \ubd84\uc11d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \ub9c8\uc9c4 \uc81c\ud488\uc744 \uc2dd\ubcc4\ud558\uace0 \ud310\ub9e4\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP3 - \ucda9\uc131 \uace0\uac1d\uc744 \uc720\uce58\ud558\uae30 \uc704\ud574 \uace0\uac1d \ucda9\uc131\ub3c4 \ud504\ub85c\uadf8\ub7a8\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubc88\uc9f8 \uad6c\ub9e4 \uc2dc \ud560\uc778\uc744 \uc81c\uacf5\ud558\uba74 \uace0\uac1d \uc720\uc9c0\uc728\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uacf5\uae09\ub9dd \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uacf5\uae09\ub9dd \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc74c\uacfc \uac19\uc774 \uc791\ub3d9\ud569\ub2c8\ub2e4: STEP1 - \uc218\uc694 \uc608\uce21\uc5d0 \ub530\ub77c \uacf5\uae09\uc5c5\uccb4\ub85c\ubd80\ud130 \uc81c\ud488\uc744 \uc8fc\ubb38\ud569\ub2c8\ub2e4. STEP2 - \uc7ac\uace0 \ubd80\uc871\uc774\ub098 \uc7ac\uace0 \ucd08\uacfc\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc7ac\uace0 \uc218\uc900\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4. STEP3 - \uc801\uc2dc \uc7ac\uace0 \ubcf4\ucda9\uc744 \uc704\ud574 \ubc30\uc1a1 \uc77c\uc815\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2e0\uc120\ud55c \ub18d\uc0b0\ubb3c\uacfc \uac19\uc774 \ud310\ub9e4\uac00 \ube60\ub978 \ud488\ubaa9\uc5d0 \ub300\ud55c \uc790\ub3d9 \uc7ac\uc8fc\ubb38 \uc124\uc815\uc740 \uc6b4\uc601\uc744 \uac04\uc18c\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc18c\uaddc\ubaa8 \ub9e4\uc7a5\uacfc \ub300\uaddc\ubaa8 \ub9e4\uc7a5\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc18c\uaddc\ubaa8 \ub9e4\uc7a5\uc740 \uad00\ub9ac\uac00 \ub354 \uc27d\uace0 \ucd08\uae30 \ud22c\uc790\uac00 \uc801\uac8c \ud544\uc694\ud558\uc9c0\ub9cc, \ub300\uaddc\ubaa8 \ub9e4\uc7a5\uc740 \uc218\uc775 \uc7a0\uc7ac\ub825\uc774 \ub192\uc9c0\ub9cc \ub354 \ub9ce\uc740 \uc9c1\uc6d0\uacfc \ubcf5\uc7a1\ud55c \ubb3c\ub958\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc18c\uaddc\ubaa8 \ub9e4\uc7a5\uc740 \uc720\uae30\ub18d \uc81c\ud488\uacfc \uac19\uc740 \ud2b9\uc815 \uc2dc\uc7a5\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\ub294 \ubc18\uba74, \ub300\uaddc\ubaa8 \ub9e4\uc7a5\uc740 \ub2e4\uc591\ud55c \uace0\uac1d\uce35\uc744 \uc720\uce58\ud558\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \ud488\ubaa9\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - \uac8c\uc784\uc744 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. STEP2 - \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP3 - \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Google Play \uac8c\uc784 \ub610\ub294 Apple \uac8c\uc784 \uc13c\ud130\uc640 \uac19\uc740 \uc11c\ube44\uc2a4\ub97c \uc0ac\uc6a9\ud558\uba74 \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \ucda9\uc131 \uace0\uac1d\uc744 \uc704\ud55c \ud2b9\ubcc4 \ud560\uc778\uc774 \uc784\uc758\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. STEP2 - \ud2b9\uc815 \ub3c4\uc804 \uacfc\uc81c\ub97c \uc644\ub8cc\ud55c \ud6c4\uc5d0\ub9cc \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ud488\ubaa9\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP3 - \ub9e4\uc7a5 \ubc29\ubb38\uac1d\uc744 \ub298\ub9ac\ub294 \uc720\uba85\uc778 \ubc29\ubb38\uacfc \uac19\uc740 \ud76c\uadc0 \uc774\ubca4\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9e4\uc7a5\uc5d0\uc11c \ud669\uae08 \uc1fc\ud551 \uce74\ud2b8\ub97c \ucc3e\uc73c\uba74 \ub3c5\uc810 \uc7a5\uc2dd\ud488\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc9c1\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud6a8\uacfc\uc801\uc778 \uc9c1\uc6d0 \uad00\ub9ac\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: STEP1 - \ub9e4\uc7a5 \ud06c\uae30\uc5d0 \ub530\ub77c \uc801\uc808\ud55c \uc218\uc758 \uc9c1\uc6d0\uc744 \uace0\uc6a9\ud569\ub2c8\ub2e4. STEP2 - \uacc4\uc0b0\uc6d0, \uc9c4\uc5f4\uc6d0 \ubc0f \uccad\uc18c\uc6d0\uacfc \uac19\uc740 \uc5ed\ud560\uc744 \ud560\ub2f9\ud558\uc5ec \uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. STEP3 - \uc9c1\uc6d0\uc744 \uc815\uae30\uc801\uc73c\ub85c \uad50\uc721\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d \ubd88\ub9cc\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc804\ub2f4 \uc9c1\uc6d0\uc744 \uc9c0\uc815\ud558\uba74 \uc11c\ube44\uc2a4 \ud488\uc9c8\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c\ub9c8\ucf13 \uc2dc\ubbac\ub808\uc774\ud130: \uc2a4\ud1a0\uc5b4 \ub9e4\ub2c8\uc800\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud754\ud55c \uc2e4\uc218\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \ube68\ub9ac \ud314\ub9ac\uc9c0 \uc54a\ub294 \ud488\ubaa9\uc744 \uacfc\ub2e4\ud558\uac8c \uc7ac\uace0\ud558\uc5ec \ub0ad\ube44\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4. STEP2 - \uace0\uac1d \ud53c\ub4dc\ubc31\uc744 \ubb34\uc2dc\ud558\uba74 \ub9e4\uc7a5 \ud3c9\ud310\uc5d0 \uc545\uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. STEP3 - \ud63c\uc7a1 \uc2dc\uac04\uc5d0 \uc9c1\uc6d0\uc774 \ubd80\uc871\ud558\uc5ec \ub300\uae30 \uc2dc\uac04\uc774 \uae38\uc5b4\uc9d1\ub2c8\ub2e4. \uc774\ub97c \ud53c\ud558\ub824\uba74 \ud310\ub9e4 \ub370\uc774\ud130\ub97c \uc815\uae30\uc801\uc73c\ub85c \uac80\ud1a0\ud558\uace0 \uc804\ub7b5\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}]
[{"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\u8a2d\u7acb\u6211\u7684\u7b2c\u4e00\u5bb6\u5546\u5e97\uff1f", "answer": "\u8981\u8a2d\u7acb\u60a8\u7684\u7b2c\u4e00\u5bb6\u5546\u5e97\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5f9e\u5730\u5716\u4e2d\u9078\u64c7\u7b26\u5408\u60a8\u7684\u9810\u7b97\u548c\u76ee\u6a19\u5ba2\u7fa4\u7684\u5730\u9ede\u3002\u6b65\u9a5f2 - \u8cfc\u8cb7\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u8ca8\u67b6\u3001\u6ac3\u6aaf\u548c\u6536\u9280\u6a5f\u3002\u6b65\u9a5f3 - \u5f9e\u5eab\u5b58\u9078\u55ae\u4e2d\u88dc\u5145\u8ca8\u67b6\u4e0a\u7684\u5546\u54c1\u3002\u4f8b\u5982\uff0c\u5f9e\u57fa\u672c\u7684\u96dc\u8ca8\uff0c\u4f8b\u5982\u9eb5\u5305\u548c\u725b\u5976\u958b\u59cb\uff0c\u4ee5\u5438\u5f15\u65e9\u671f\u9867\u5ba2\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u9867\u5ba2\u6eff\u610f\u5ea6\u5f88\u91cd\u8981\uff1f\u4ee5\u53ca\u5982\u4f55\u63d0\u5347\u5b83\uff1f", "answer": "\u9867\u5ba2\u6eff\u610f\u5ea6\u76f4\u63a5\u5f71\u97ff\u60a8\u5546\u5e97\u7684\u8072\u8b7d\u548c\u92b7\u552e\u984d\u3002\u8981\u63d0\u5347\u5b83\uff0c\u8acb\u57f7\u884c\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u8ca8\u67b6\u4e0a\u59cb\u7d42\u6709\u66a2\u92b7\u5546\u54c1\u3002\u6b65\u9a5f2 - \u4fdd\u6301\u4e7e\u6de8\u6574\u6f54\u7684\u5e97\u92ea\u4f48\u5c40\u3002\u6b65\u9a5f3 - \u8a13\u7df4\u54e1\u5de5\u6709\u6548\u8655\u7406\u9867\u5ba2\u8a62\u554f\u3002\u4f8b\u5982\uff0c\u5c07\u7d93\u5e38\u8cfc\u8cb7\u7684\u5546\u54c1\uff08\u5982\u96f6\u98df\uff09\u653e\u7f6e\u5728\u7d50\u5e33\u53f0\u9644\u8fd1\uff0c\u53ef\u4ee5\u7e2e\u77ed\u7b49\u5019\u6642\u9593\uff0c\u4e26\u63d0\u5347\u6eff\u610f\u5ea6\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u6700\u4f73\u7684\u5546\u54c1\u5b9a\u50f9\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6709\u6548\u7684\u5b9a\u50f9\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u4f7f\u7528\u5e02\u5834\u7814\u7a76\u5de5\u5177\u5206\u6790\u7af6\u722d\u5c0d\u624b\u7684\u50f9\u683c\u3002\u6b65\u9a5f2 - \u4f9d\u64da\u9700\u6c42\u548c\u4f9b\u61c9\u8abf\u6574\u50f9\u683c\uff1b\u4f8b\u5982\uff0c\u5728\u975e\u5c16\u5cf0\u6642\u6bb5\u964d\u4f4e\u50f9\u683c\uff0c\u4ee5\u5438\u5f15\u66f4\u591a\u9867\u5ba2\u3002\u6b65\u9a5f3 - \u5be6\u65bd\u5b63\u7bc0\u6027\u5546\u54c1\u7684\u52d5\u614b\u5b9a\u50f9\uff0c\u4f8b\u5982\u96e8\u5b63\u63d0\u9ad8\u96e8\u5098\u7684\u50f9\u683c\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u54ea\u4e9b\u5148\u9032\u6280\u8853\u53ef\u4ee5\u5e6b\u52a9\u6211\u6700\u5927\u5316\u5229\u6f64\uff1f", "answer": "\u6700\u5927\u5316\u5229\u6f64\u7684\u65b9\u6cd5\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u512a\u5316\u5e97\u92ea\u4f48\u5c40\uff0c\u4ee5\u7e2e\u77ed\u9867\u5ba2\u884c\u8d70\u6642\u9593\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u6578\u64da\u5206\u6790\u4f86\u8b58\u5225\u9ad8\u5229\u6f64\u7522\u54c1\uff0c\u4e26\u96c6\u4e2d\u65bc\u5176\u92b7\u552e\u3002\u6b65\u9a5f3 - \u5be6\u65bd\u5fe0\u8aa0\u5ea6\u8a08\u5283\uff0c\u4ee5\u9f13\u52f5\u9867\u5ba2\u91cd\u8907\u8cfc\u8cb7\u3002\u4f8b\u5982\uff0c\u5728\u7b2c10\u6b21\u8cfc\u8cb7\u6642\u63d0\u4f9b\u6298\u6263\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u9867\u5ba2\u7684\u4fdd\u7559\u7387\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u4f9b\u61c9\u93c8\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u4f9b\u61c9\u93c8\u7cfb\u7d71\u5305\u542b\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u4f9d\u64da\u9700\u6c42\u9810\u6e2c\u5f9e\u4f9b\u61c9\u5546\u8655\u8a02\u8cfc\u7522\u54c1\u3002\u6b65\u9a5f2 - \u7ba1\u7406\u5eab\u5b58\u91cf\uff0c\u907f\u514d\u904e\u5ea6\u56e4\u8ca8\u6216\u7f3a\u8ca8\u3002\u6b65\u9a5f3 - \u5229\u7528\u4ea4\u4ed8\u6642\u9593\u8868\uff0c\u78ba\u4fdd\u53ca\u6642\u88dc\u5145\u5eab\u5b58\u3002\u4f8b\u5982\uff0c\u70ba\u66a2\u92b7\u5546\u54c1\uff08\u4f8b\u5982\u65b0\u9bae\u8fb2\u7522\u54c1\uff09\u8a2d\u5b9a\u81ea\u52d5\u91cd\u65b0\u8a02\u8cfc\uff0c\u53ef\u4ee5\u7c21\u5316\u4f5c\u696d\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u5c0f\u578b\u5546\u5e97\u548c\u5927\u5546\u5e97\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0f\u578b\u5546\u5e97\u66f4\u5bb9\u6613\u7ba1\u7406\uff0c\u4e14\u521d\u59cb\u6295\u8cc7\u8f03\u5c11\uff0c\u800c\u5927\u578b\u5546\u5e97\u5247\u5177\u6709\u66f4\u9ad8\u7684\u71df\u6536\u6f5b\u529b\uff0c\u4f46\u9700\u8981\u66f4\u591a\u54e1\u5de5\u548c\u66f4\u8907\u96dc\u7684\u7269\u6d41\u3002\u4f8b\u5982\uff0c\u5c0f\u578b\u5546\u5e97\u53ef\u80fd\u5c08\u6ce8\u65bc\u5229\u57fa\u5e02\u5834\uff0c\u4f8b\u5982\u6709\u6a5f\u7522\u54c1\uff0c\u800c\u5927\u578b\u5546\u5e97\u5247\u53ef\u4ee5\u63d0\u4f9b\u5404\u7a2e\u5546\u54c1\uff0c\u4ee5\u5438\u5f15\u4e0d\u540c\u985e\u578b\u7684\u9867\u5ba2\u7fa4\u3002"}, {"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u8a2d\u5099\uff1f", "answer": "\u8981\u8f49\u79fb\u60a8\u7684\u9032\u5ea6\uff0c\u8acb\u57f7\u884c\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5132\u5b58\u5e33\u6236\u3002\u6b65\u9a5f2 - \u5728\u60a8\u7684\u65b0\u8a2d\u5099\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u3002\u6b65\u9a5f3 - \u5f9e\u96f2\u7aef\u4e0b\u8f09\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 Google Play Games \u6216 Apple Game Center \u7b49\u670d\u52d9\u53ef\u4ee5\u4fc3\u9032\u9806\u66a2\u7684\u8cc7\u6599\u9077\u79fb\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u6211\u80fd\u5920\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u96b1\u85cf\u529f\u80fd\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u5fe0\u8aa0\u9867\u5ba2\u96a8\u6a5f\u51fa\u73fe\u7684\u7279\u5225\u6298\u6263\u3002\u6b65\u9a5f2 - \u53ea\u6709\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u624d\u80fd\u89e3\u9396\u7684\u79d8\u5bc6\u7269\u54c1\u3002\u6b65\u9a5f3 - \u7a00\u6709\u7684\u6d3b\u52d5\uff0c\u4f8b\u5982\u540d\u4eba\u9020\u8a2a\uff0c\u53ef\u4ee5\u63d0\u5347\u5546\u5e97\u7684\u6d41\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u60a8\u7684\u5546\u5e97\u4e2d\u627e\u5230\u4e00\u500b\u91d1\u8272\u7684\u8cfc\u7269\u8eca\uff0c\u53ef\u4ee5\u89e3\u9396\u7368\u5bb6\u88dd\u98fe\u7269\u54c1\u3002"}, {"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\u6709\u6548\u7ba1\u7406\u54e1\u5de5\uff1f", "answer": "\u6709\u6548\u7684\u54e1\u5de5\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u4f9d\u64da\u5546\u5e97\u898f\u6a21\u50f1\u7528\u9069\u7576\u6578\u91cf\u7684\u54e1\u5de5\u3002\u6b65\u9a5f2 - \u5206\u914d\u6536\u9280\u54e1\u3001\u88dc\u8ca8\u54e1\u548c\u6e05\u6f54\u54e1\u7b49\u89d2\u8272\uff0c\u512a\u5316\u5de5\u4f5c\u6d41\u7a0b\u3002\u6b65\u9a5f3 - \u5b9a\u671f\u57f9\u8a13\u54e1\u5de5\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5206\u914d\u4e00\u4f4d\u5c08\u9580\u8655\u7406\u9867\u5ba2\u6295\u8a34\u7684\u54e1\u5de5\uff0c\u53ef\u4ee5\u63d0\u5347\u670d\u52d9\u8cea\u91cf\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u64ec\u5668\uff1a\u5e97\u8216\u7d93\u7406\u4e2d\uff0c\u65b0\u73a9\u5bb6\u6700\u5e38\u72af\u54ea\u4e9b\u932f\u8aa4\uff1f\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u5e38\u898b\u932f\u8aa4\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u904e\u5ea6\u56e4\u7a4d\u92b7\u552e\u901f\u5ea6\u6162\u7684\u5546\u54c1\uff0c\u5c0e\u81f4\u6d6a\u8cbb\u3002\u6b65\u9a5f2 - \u5ffd\u8996\u9867\u5ba2\u7684\u53cd\u994b\uff0c\u9019\u53ef\u80fd\u6703\u640d\u5bb3\u60a8\u5546\u5e97\u7684\u8072\u8b7d\u3002\u6b65\u9a5f3 - \u5c16\u5cf0\u6642\u6bb5\u54e1\u5de5\u4e0d\u8db3\uff0c\u5c0e\u81f4\u7b49\u5019\u6642\u9593\u904e\u9577\u3002\u70ba\u907f\u514d\u9019\u4e9b\u554f\u984c\uff0c\u8acb\u5b9a\u671f\u6aa2\u8996\u92b7\u552e\u6578\u64da\uff0c\u4e26\u76f8\u61c9\u8abf\u6574\u60a8\u7684\u7b56\u7565\u3002"}]
[{"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\u8bbe\u7f6e\u6211\u7684\u7b2c\u4e00\u4e2a\u5546\u5e97\uff1f", "answer": "\u8981\u8bbe\u7f6e\u60a8\u7684\u7b2c\u4e00\u4e2a\u5546\u5e97\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u4ece\u5730\u56fe\u4e2d\u9009\u62e9\u4e00\u4e2a\u9002\u5408\u60a8\u7684\u9884\u7b97\u548c\u76ee\u6807\u5ba2\u6237\u7fa4\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa42 - \u8d2d\u4e70\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u8d27\u67b6\u3001\u67dc\u53f0\u548c\u6536\u94f6\u673a\u3002\u6b65\u9aa43 - \u4ece\u5e93\u5b58\u83dc\u5355\u4e2d\u5c06\u5546\u54c1\u5b58\u5165\u8d27\u67b6\u3002\u4f8b\u5982\uff0c\u9996\u5148\u653e\u5165\u4e00\u4e9b\u57fa\u672c\u7684\u6742\u8d27\uff0c\u4f8b\u5982\u9762\u5305\u548c\u725b\u5976\uff0c\u4ee5\u5438\u5f15\u65e9\u671f\u5ba2\u6237\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\u5ba2\u6237\u6ee1\u610f\u5ea6\u5f88\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u63d0\u9ad8\u5b83\uff1f", "answer": "\u5ba2\u6237\u6ee1\u610f\u5ea6\u76f4\u63a5\u5f71\u54cd\u60a8\u5546\u5e97\u7684\u58f0\u8a89\u548c\u9500\u552e\u989d\u3002\u8981\u63d0\u9ad8\u5b83\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u8d27\u67b6\u4e0a\u59cb\u7ec8\u6709\u7545\u9500\u5546\u54c1\u3002\u6b65\u9aa42 - \u4fdd\u6301\u5546\u5e97\u5e03\u5c40\u6574\u6d01\u6709\u5e8f\u3002\u6b65\u9aa43 - \u57f9\u8bad\u5458\u5de5\u6709\u6548\u5904\u7406\u5ba2\u6237\u54a8\u8be2\u3002\u4f8b\u5982\uff0c\u5c06\u7ecf\u5e38\u8d2d\u4e70\u7684\u5546\u54c1\uff08\u5982\u96f6\u98df\uff09\u653e\u5728\u6536\u94f6\u53f0\u9644\u8fd1\uff0c\u53ef\u4ee5\u7f29\u77ed\u7b49\u5f85\u65f6\u95f4\uff0c\u63d0\u9ad8\u6ee1\u610f\u5ea6\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\uff0c\u4e3a\u5546\u54c1\u5b9a\u4ef7\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u6709\u6548\u7684\u5b9a\u4ef7\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u5e02\u573a\u8c03\u7814\u5de5\u5177\u5206\u6790\u7ade\u4e89\u5bf9\u624b\u7684\u4ef7\u683c\u3002\u6b65\u9aa42 - \u6839\u636e\u9700\u6c42\u548c\u4f9b\u6c42\u60c5\u51b5\u8c03\u6574\u4ef7\u683c\uff1b\u4f8b\u5982\uff0c\u5728\u975e\u9ad8\u5cf0\u65f6\u6bb5\u964d\u4f4e\u4ef7\u683c\u4ee5\u5438\u5f15\u66f4\u591a\u5ba2\u6237\u3002\u6b65\u9aa43 - \u5b9e\u65bd\u52a8\u6001\u5b9a\u4ef7\u7b56\u7565\uff0c\u4f8b\u5982\u5728\u96e8\u5b63\u63d0\u9ad8\u96e8\u4f1e\u7684\u4ef7\u683c\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6280\u672f\u6765\u6700\u5927\u5316\u5229\u6da6\uff1f", "answer": "\u6700\u5927\u5316\u5229\u6da6\u7684\u65b9\u6cd5\u5305\u62ec\uff1a\u6b65\u9aa41 - \u4f18\u5316\u5546\u5e97\u5e03\u5c40\uff0c\u51cf\u5c11\u5ba2\u6237\u884c\u8d70\u65f6\u95f4\u3002\u6b65\u9aa42 - \u4f7f\u7528\u6570\u636e\u5206\u6790\u8bc6\u522b\u9ad8\u5229\u6da6\u5546\u54c1\u5e76\u4e13\u6ce8\u4e8e\u9500\u552e\u8fd9\u4e9b\u5546\u54c1\u3002\u6b65\u9aa43 - \u5b9e\u65bd\u5fe0\u8bda\u5ea6\u8ba1\u5212\u4ee5\u9f13\u52b1\u56de\u5934\u5ba2\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u6b21\u8d2d\u4e70\u65f6\u63d0\u4f9b\u6298\u6263\u53ef\u4ee5\u663e\u7740\u63d0\u9ad8\u5ba2\u6237\u4fdd\u7559\u7387\u3002"}, {"question": "\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\u7684\u4f9b\u5e94\u94fe\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u4f9b\u5e94\u94fe\u7cfb\u7edf\u6d89\u53ca\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u6839\u636e\u9700\u6c42\u9884\u6d4b\u5411\u4f9b\u5e94\u5546\u8ba2\u8d2d\u4ea7\u54c1\u3002\u6b65\u9aa42 - \u7ba1\u7406\u5e93\u5b58\u6c34\u5e73\uff0c\u4ee5\u907f\u514d\u8fc7\u91cf\u6216\u7f3a\u8d27\u3002\u6b65\u9aa43 - \u5229\u7528\u914d\u9001\u8ba1\u5212\u786e\u4fdd\u53ca\u65f6\u8865\u8d27\u3002\u4f8b\u5982\uff0c\u4e3a\u7545\u9500\u5546\u54c1\uff08\u5982\u65b0\u9c9c\u519c\u4ea7\u54c1\uff09\u8bbe\u7f6e\u81ea\u52a8\u91cd\u65b0\u8ba2\u8d2d\uff0c\u53ef\u4ee5\u7b80\u5316\u8fd0\u8425\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\uff0c\u5c0f\u578b\u5546\u5e97\u548c\u5927\u5546\u5e97\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5c0f\u578b\u5546\u5e97\u66f4\u5bb9\u6613\u7ba1\u7406\uff0c\u521d\u59cb\u6295\u8d44\u4e5f\u8f83\u5c11\uff0c\u800c\u5927\u578b\u5546\u5e97\u5177\u6709\u66f4\u9ad8\u7684\u76c8\u5229\u6f5c\u529b\uff0c\u4f46\u4e5f\u9700\u8981\u66f4\u591a\u5458\u5de5\u548c\u66f4\u590d\u6742\u7684\u7269\u6d41\u3002\u4f8b\u5982\uff0c\u5c0f\u578b\u5546\u5e97\u53ef\u80fd\u4e13\u6ce8\u4e8e\u5229\u57fa\u5e02\u573a\uff0c\u4f8b\u5982\u6709\u673a\u4ea7\u54c1\uff0c\u800c\u5927\u578b\u5546\u5e97\u5219\u53ef\u4ee5\u63d0\u4f9b\u5404\u79cd\u5546\u54c1\uff0c\u5438\u5f15\u5404\u79cd\u5ba2\u6237\u7fa4\u4f53\u3002"}, {"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\u5c06\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u4e91\u4fdd\u5b58\u5e10\u6237\u3002\u6b65\u9aa42 - \u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u76f8\u540c\u7684\u5e10\u6237\u3002\u6b65\u9aa43 - \u4ece\u4e91\u7aef\u4e0b\u8f7d\u60a8\u7684\u4fdd\u5b58\u6570\u636e\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 Google Play \u6e38\u620f\u6216 Apple \u6e38\u620f\u4e2d\u5fc3\u7b49\u670d\u52a1\u53ef\u4ee5\u5b9e\u73b0\u65e0\u7f1d\u6570\u636e\u8fc1\u79fb\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\uff0c\u6211\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u9690\u85cf\u529f\u80fd\u5305\u62ec\uff1a\u6b65\u9aa41 - \u968f\u673a\u51fa\u73b0\u9762\u5411\u5fe0\u5b9e\u5ba2\u6237\u7684\u7279\u522b\u6298\u6263\u3002\u6b65\u9aa42 - \u53ea\u6709\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u624d\u80fd\u89e3\u9501\u7684\u79d8\u5bc6\u7269\u54c1\u3002\u6b65\u9aa43 - \u7a00\u6709\u4e8b\u4ef6\uff0c\u4f8b\u5982\u540d\u4eba\u8bbf\u95ee\uff0c\u53ef\u63d0\u5347\u5546\u5e97\u5ba2\u6d41\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u5546\u5e97\u4e2d\u627e\u5230\u4e00\u8f86\u91d1\u8272\u7684\u8d2d\u7269\u8f66\u53ef\u4ee5\u89e3\u9501\u72ec\u5bb6\u88c5\u9970\u7269\u54c1\u3002"}, {"question": "\u5982\u4f55\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u5458\u5de5\uff1f", "answer": "\u6709\u6548\u7684\u5458\u5de5\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9aa41 - \u6839\u636e\u5546\u5e97\u89c4\u6a21\u62db\u8058\u5408\u9002\u6570\u91cf\u7684\u5458\u5de5\u3002\u6b65\u9aa42 - \u5206\u914d\u6536\u94f6\u5458\u3001\u7406\u8d27\u5458\u548c\u6e05\u6d01\u5458\u7b49\u89d2\u8272\u4ee5\u4f18\u5316\u5de5\u4f5c\u6d41\u7a0b\u3002\u6b65\u9aa43 - \u5b9a\u671f\u57f9\u8bad\u5458\u5de5\uff0c\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u6307\u6d3e\u4e00\u540d\u5458\u5de5\u4e13\u95e8\u5904\u7406\u5ba2\u6237\u6295\u8bc9\uff0c\u53ef\u4ee5\u63d0\u9ad8\u670d\u52a1\u8d28\u91cf\u3002"}, {"question": "\u5728\u8d85\u5e02\u6a21\u62df\u5668\uff1a\u5e97\u957f\u4e2d\uff0c\u65b0\u73a9\u5bb6\u6700\u5e38\u72af\u54ea\u4e9b\u9519\u8bef\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u5e38\u89c1\u9519\u8bef\u5305\u62ec\uff1a\u6b65\u9aa41 - \u56e4\u79ef\u4e0d\u6613\u552e\u51fa\u7684\u5546\u54c1\uff0c\u5bfc\u81f4\u6d6a\u8d39\u3002\u6b65\u9aa42 - \u5ffd\u7565\u5ba2\u6237\u53cd\u9988\uff0c\u8fd9\u53ef\u80fd\u4f1a\u635f\u5bb3\u60a8\u5546\u5e97\u7684\u58f0\u8a89\u3002\u6b65\u9aa43 - \u5728\u9ad8\u5cf0\u65f6\u6bb5\u4eba\u5458\u4e0d\u8db3\uff0c\u5bfc\u81f4\u7b49\u5f85\u65f6\u95f4\u8fc7\u957f\u3002\u8981\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u5b9a\u671f\u67e5\u770b\u9500\u552e\u6570\u636e\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u7b56\u7565\u3002"}]
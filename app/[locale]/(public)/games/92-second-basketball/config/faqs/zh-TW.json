[{"question": "\u521d\u5b78\u8005\u5982\u4f55\u6709\u6548\u5730\u958b\u59cb\u73a992\u79d2\u7c43\u7403\u904a\u6232\uff1f", "answer": "\u8981\u6709\u6548\u5730\u958b\u59cb\u73a992\u79d2\u7c43\u7403\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5b8c\u6210\u6559\u5b78\u4ee5\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u6b65\u9a5f2 - \u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u6295\u7c43\u548c\u904b\u7403\uff0c\u611f\u53d7\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f3 - \u73a9\u5e7e\u5834\u5feb\u901f\u6bd4\u8cfd\uff0c\u4e86\u89e3\u904a\u6232\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u7b2c\u4e00\u5834\u6bd4\u8cfd\u4e2d\uff0c\u5c08\u6ce8\u65bc\u76e1\u53ef\u80fd\u591a\u5730\u5b8c\u6210\u6210\u529f\u6295\u7c43\uff0c\u800c\u4e0d\u662f\u64d4\u5fc3\u5206\u6578\u3002\u9019\u7a2e\u65b9\u6cd5\u5c07\u5e6b\u52a9\u4f60\u9010\u6f38\u5efa\u7acb\u4fe1\u5fc3\u4e26\u63d0\u9ad8\u4f60\u7684\u6280\u80fd\u3002"}, {"question": "92\u79d2\u7c43\u7403\u70ba\u4f55\u6642\u9593\u638c\u63a7\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u638c\u63e1\u5b83\uff1f", "answer": "92\u79d2\u7c43\u7403\u6642\u9593\u638c\u63a7\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u7684\u6295\u7c43\u6e96\u78ba\u6027\u548c\u9632\u5b88\u6548\u7387\u3002\u8981\u638c\u63e1\u6642\u9593\u638c\u63a7\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u6ce8\u610f\u5728\u5617\u8a66\u6295\u7c43\u6642\u51fa\u73fe\u7684\u6295\u7c43\u8a08\u91cf\u8868\u3002\u6b65\u9a5f2 - \u5728\u8a08\u91cf\u8868\u9054\u5230\u5cf0\u503c\u6642\u91cb\u653e\u6295\u7c43\u6309\u9215\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u6e96\u78ba\u6027\u3002\u6b65\u9a5f3 - \u7df4\u7fd2\u9632\u5b88\u52d5\u4f5c\uff0c\u4f8b\u5982\u963b\u64cb\u548c\u6436\u65b7\uff0c\u4e26\u9810\u6e2c\u5c0d\u624b\u7684\u884c\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8cfd\u4e2d\uff0c\u5617\u8a66\u5728\u5c0d\u624b\u91cb\u653e\u7403\u7684\u540c\u6642\uff0c\u901a\u904e\u53ca\u6642\u8d77\u8df3\u4f86\u963b\u64cb\u6295\u7c43\u3002\u6301\u7e8c\u7684\u7df4\u7fd2\u5c07\u5e6b\u52a9\u4f60\u767c\u5c55\u51fa\u80fd\u986f\u8457\u6539\u5584\u904a\u6232\u8868\u73fe\u7684\u6642\u9593\u611f\u3002"}, {"question": "\u5c0d\u65bc\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff0c92\u79d2\u7c43\u7403\u7684\u5fc5\u5099\u63a7\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "92\u79d2\u7c43\u7403\u7684\u5fc5\u5099\u63a7\u5236\u5305\u62ec\u6295\u7c43\u3001\u904b\u7403\u3001\u50b3\u7403\u548c\u9632\u5b88\u3002\u8981\u6295\u7c43\uff0c\u8acb\u6309\u4f4f\u6295\u7c43\u6309\u9215\uff0c\u7136\u5f8c\u5728\u6295\u7c43\u8a08\u91cf\u8868\u9054\u5230\u5cf0\u503c\u6642\u91cb\u653e\u3002\u8981\u904b\u7403\uff0c\u8acb\u4f7f\u7528\u65b9\u5411\u9375\u6216\u64cd\u7e31\u687f\u79fb\u52d5\u4f60\u7684\u7403\u54e1\u5728\u7403\u5834\u4e0a\u3002\u50b3\u7403\u662f\u901a\u904e\u5728\u7784\u6e96\u968a\u53cb\u6642\u6309\u4e0b\u50b3\u7403\u6309\u9215\u4f86\u5b8c\u6210\u7684\u3002\u8981\u9632\u5b88\uff0c\u8acb\u4f7f\u7528\u963b\u64cb\u6309\u9215\u5617\u8a66\u963b\u64cb\u6216\u4f7f\u7528\u6436\u65b7\u6309\u9215\u5617\u8a66\u5f9e\u5c0d\u624b\u624b\u4e2d\u6436\u7403\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u4e2d\uff0c\u4f60\u53ef\u80fd\u6703\u7d50\u5408\u904b\u7403\u548c\u50b3\u7403\u4f86\u5275\u9020\u4e00\u6b21\u516c\u958b\u7684\u6295\u7c43\u6a5f\u6703\u3002"}, {"question": "\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u572892\u79d2\u7c43\u7403\u4e2d\u53d6\u5f97\u512a\u52e2\uff1f", "answer": "\u8981\u572892\u79d2\u7c43\u7403\u4e2d\u53d6\u5f97\u512a\u52e2\uff0c\u8acb\u63a1\u7528\u9019\u4e9b\u5148\u9032\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u638c\u63e1\u7d44\u5408\u52d5\u4f5c\u7684\u6280\u5de7\uff0c\u4f8b\u5982\u904b\u7403\u7a81\u7834\u5f8c\u5feb\u901f\u50b3\u7403\u3002\u6b65\u9a5f2 - \u5229\u7528\u9632\u5b88\u7b56\u7565\uff0c\u4f8b\u5982\u5340\u57df\u9632\u5b88\u4f86\u9650\u5236\u5c0d\u624b\u7684\u5f97\u5206\u6a5f\u6703\u3002\u6b65\u9a5f3 - \u5b78\u7fd2\u95b1\u8b80\u5c0d\u624b\u7684\u6a21\u5f0f\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6ce8\u610f\u5230\u5c0d\u624b\u504f\u611b\u7279\u5b9a\u6295\u7c43\u4f4d\u7f6e\uff0c\u5247\u5c07\u4f60\u7684\u9632\u5b88\u8005\u64fa\u653e\u5728\u8a72\u5340\u57df\u963b\u64cb\u3002\u6b63\u78ba\u57f7\u884c\u9019\u4e9b\u7b56\u7565\uff0c\u53ef\u4ee5\u8b93\u4f60\u5728\u5c0d\u624b\u8eab\u4e0a\u4f54\u64da\u660e\u986f\u7684\u512a\u52e2\u3002"}, {"question": "\u5982\u4f55\u572892\u79d2\u7c43\u7403\u4e2d\u63d0\u9ad8\u6211\u7684\u6295\u7c43\u6e96\u78ba\u6027\uff1f", "answer": "\u63d0\u9ad892\u79d2\u7c43\u7403\u4e2d\u7684\u6295\u7c43\u6e96\u78ba\u6027\u9700\u8981\u591a\u9805\u95dc\u9375\u7df4\u7fd2\uff1a\u6b65\u9a5f1 -\u59cb\u7d42\u6ce8\u610f\u6295\u7c43\u8a08\u91cf\u8868\uff0c\u4e26\u5728\u6700\u4f73\u6642\u6a5f\u91cb\u653e\u6295\u7c43\u6309\u9215\u3002\u6b65\u9a5f2 - \u5728\u7403\u5834\u7684\u4e0d\u540c\u4f4d\u7f6e\u7df4\u7fd2\u6295\u7c43\uff0c\u4ee5\u4e86\u89e3\u6bcf\u4e00\u500b\u6295\u7c43\u6240\u9700\u7684\u5c04\u7a0b\u548c\u89d2\u5ea6\u3002\u6b65\u9a5f3 - \u5229\u7528\u7df4\u7fd2\u6a21\u5f0f\u53cd\u8986\u5617\u8a66\u6295\u7c43\uff0c\u76f4\u5230\u4f60\u57f9\u990a\u51fa\u808c\u8089\u8a18\u61b6\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8cfd\u4e2d\uff0c\u5617\u8a66\u5f9e\u4f60\u7df4\u7fd2\u904e\u6700\u591a\u7684\u4f4d\u7f6e\u9032\u884c\u6295\u7c43\uff0c\u5f9e\u800c\u589e\u52a0\u5f97\u5206\u6a5f\u6703\u3002\u6301\u7e8c\u7df4\u7fd2\u4e26\u5c08\u6ce8\u65bc\u9019\u4e9b\u65b9\u9762\u5c07\u6703\u63d0\u9ad8\u4f60\u7684\u6295\u7c43\u6e96\u78ba\u6027\u3002"}, {"question": "\u4e86\u89e3\u7403\u54e1\u4f4d\u7f6e\u572892\u79d2\u7c43\u7403\u4e2d\u70ba\u4f55\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u5229\u7528\u5b83\u4f86\u53d6\u52dd\uff1f", "answer": "\u4e86\u89e392\u79d2\u7c43\u7403\u4e2d\u7684\u7403\u54e1\u4f4d\u7f6e\u5f88\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6709\u52a9\u65bc\u4f60\u5236\u5b9a\u9032\u653b\u548c\u9632\u5b88\u7b56\u7565\u3002\u8981\u5229\u7528\u5b83\u4f86\u53d6\u52dd\uff1a\u6b65\u9a5f1 - \u5b78\u7fd2\u6bcf\u500b\u4f4d\u7f6e\u7684\u512a\u52e2\u548c\u52a3\u52e2\uff0c\u4f8b\u5982\u5f97\u5206\u5f8c\u885b\u9060\u8ddd\u96e2\u6295\u7c43\u7684\u80fd\u529b\u3002\u6b65\u9a5f2 - \u5c07\u4f60\u7684\u7403\u54e1\u5b89\u6392\u5728\u7403\u5834\u4e0a\uff0c\u4ee5\u6700\u5927\u5316\u4ed6\u5011\u7684\u6548\u7387\uff0c\u4f8b\u5982\u5c07\u5f37\u529b\u7684\u9632\u5b88\u8005\u653e\u5728\u7c43\u6846\u9644\u8fd1\u3002\u6b65\u9a5f3-\u6839\u64da\u5c0d\u624b\u7684\u9663\u5bb9\u4f4d\u7f6e\u8abf\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6ce8\u610f\u5230\u5c0d\u624b\u7684\u63a7\u7403\u5f8c\u885b\u662f\u4ed6\u5011\u7684\u4e3b\u8981\u5f97\u5206\u9ede\uff0c\u5247\u96c6\u4e2d\u4f60\u7684\u9632\u5b88\u4f86\u9650\u5236\u4ed6\u5011\u7684\u5f97\u5206\u6a5f\u6703\u3002\u9019\u7a2e\u4f4d\u7f6e\u610f\u8b58\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u3002"}, {"question": "92\u79d2\u7c43\u7403\u5f97\u5206\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "92\u79d2\u7c43\u7403\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u9805\u95dc\u9375\u6a5f\u5236\uff1a\u6b65\u9a5f1 -\u5f97\u5206\u6839\u64da\u6295\u7c43\u985e\u578b\u800c\u5b9a\uff0c\u4e09\u5206\u7403\u6bd4\u5169\u5206\u7403\u7372\u5f97\u66f4\u591a\u5206\u6578\u3002\u6b65\u9a5f2 - \u6210\u529f\u7684\u7f70\u7403\u4e5f\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\uff0c\u4e26\u4e14\u5728\u72af\u898f\u5f8c\u7372\u5f97\u3002\u6b65\u9a5f3 - \u904a\u6232\u8a08\u6642\u589e\u52a0\u4e86\u7dca\u8feb\u611f\uff0c\u9f13\u52f5\u5feb\u901f\u6709\u6548\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8cfd\u4e2d\uff0c\u4e00\u8a18\u53ca\u6642\u7684\u8df3\u6295\u4e09\u5206\u7403\u53ef\u4ee5\u8fc5\u901f\u6539\u8b8a\u6bd4\u8cfd\u7684\u52e2\u982d\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u8b93\u4f60\u6709\u6548\u5730\u5236\u5b9a\u5f97\u5206\u7b56\u7565\u3002"}, {"question": "92\u79d2\u7c43\u7403\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u4ee5\u53ca\u5982\u4f55\u7ba1\u7406\uff1f", "answer": "92\u79d2\u7c43\u7403\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u6703\u5f71\u97ff\u904a\u6232\uff0c\u56e0\u70ba\u5b83\u6703\u9650\u5236\u7403\u54e1\u53ef\u4ee5\u57f7\u884c\u7684\u9023\u7e8c\u52d5\u4f5c\u3002\u8981\u6709\u6548\u5730\u7ba1\u7406\u9ad4\u529b\uff1a\u6b65\u9a5f1 -\u76e3\u63a7\u7403\u54e1\u7684\u9ad4\u529b\u689d\uff0c\u907f\u514d\u904e\u5ea6\u64cd\u52de\uff0c\u5728\u9ad8\u5f37\u5ea6\u52d5\u4f5c\u9593\u4f11\u606f\u3002\u6b65\u9a5f2 - \u660e\u667a\u5730\u4f7f\u7528\u66ff\u88dc\uff0c\u8b93\u4f60\u7684\u7403\u54e1\u5728\u6574\u500b\u6bd4\u8cfd\u904e\u7a0b\u4e2d\u4fdd\u6301\u65b0\u9bae\u72c0\u614b\u3002\u6b65\u9a5f3 - \u5c07\u6fc0\u9032\u7684\u904a\u6232\u7b56\u7565\u8207\u6230\u7565\u505c\u9813\u76f8\u7d50\u5408\uff0c\u4ee5\u4fdd\u5b58\u9ad4\u529b\u7528\u65bc\u95dc\u9375\u6642\u523b\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u7684\u6bd4\u8cfd\u4e2d\uff0c\u78ba\u4fdd\u4f60\u7684\u4e3b\u529b\u7403\u54e1\u5728\u6700\u5f8c\u5e7e\u79d2\u6709\u8db3\u5920\u7684\u9ad4\u529b\uff0c\u9019\u53ef\u80fd\u662f\u8d0f\u548c\u8f38\u7684\u95dc\u9375\u3002\u9069\u7576\u7684\u9ad4\u529b\u7ba1\u7406\u5c0d\u65bc\u6301\u7e8c\u7684\u8868\u73fe\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb92\u79d2\u7c43\u7403\u7684\u9032\u5ea6\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u900f\u904e\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u904a\u6232\u500b\u4eba\u6a94\u6848\uff0c\u4f8b\u5982 Google Play Games \u6216 Apple Game Center\uff0c\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb92\u79d2\u7c43\u7403\u7684\u9032\u5ea6\u3002\u6b65\u9a5f1 - \u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07\u4f60\u7684\u9032\u5ea6\u5f9e\u539f\u59cb\u5e73\u53f0\u4e0a\u50b3\u3002\u6b65\u9a5f3 - \u5728\u65b0\u5e73\u53f0\u4e0a\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\uff0c\u4ee5\u7e7c\u7e8c\u4e0a\u6b21\u904a\u6232\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e\u884c\u52d5\u88dd\u7f6e\u5207\u63db\u5230\u500b\u4eba\u96fb\u8166\uff0c\u4f60\u7684\u7403\u54e1\u7d71\u8a08\u3001\u6210\u5c31\u548c\u904a\u6232\u9032\u5ea6\u5c07\u6703\u4fdd\u7559\uff0c\u5141\u8a31\u9806\u66a2\u7684\u8f49\u63db\u3002"}, {"question": "92\u79d2\u7c43\u7403\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\u53ef\u4ee5\u767c\u73fe\uff1f", "answer": "\u572892\u79d2\u7c43\u7403\u4e2d\uff0c\u6709\u4e00\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f1 - \u63a2\u7d22\u4e0d\u540c\u7684\u7403\u5834\uff0c\u627e\u5230\u7368\u7279\u7684\u8a2d\u8a08\u548c\u80cc\u666f\u5143\u7d20\uff0c\u9019\u4e9b\u5143\u7d20\u53c3\u8003\u7d93\u5178\u7c43\u7403\u6642\u523b\u3002\u6b65\u9a5f2 - \u57f7\u884c\u7279\u5b9a\u7d44\u5408\u52d5\u4f5c\u4ee5\u89e3\u9396\u7279\u6b8a\u52d5\u756b\u6216\u89e3\u8aaa\u3002\u6b65\u9a5f3 - \u6ce8\u610f\u904a\u6232\u6210\u5c31\uff0c\u5176\u4e2d\u4e00\u4e9b\u6697\u793a\u4e86\u96b1\u85cf\u7684\u6311\u6230\u3002\u4f8b\u5982\uff0c\u6210\u529f\u5b8c\u6210\u4e00\u500b\u80cc\u5f8c\u50b3\u7403\u63a5\u8457\u6263\u7c43\uff0c\u53ef\u80fd\u6703\u89f8\u767c\u4e00\u500b\u7279\u6b8a\u7684\u6176\u795d\u52d5\u756b\u3002\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u3002"}]
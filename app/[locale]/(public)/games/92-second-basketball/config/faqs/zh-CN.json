[{"question": "92\u79d2\u7bee\u7403\u65b0\u624b\u5982\u4f55\u6709\u6548\u5165\u95e8\uff1f", "answer": "\u8981\u6709\u6548\u5165\u95e892\u79d2\u7bee\u7403\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u5b8c\u6210\u6559\u7a0b\uff0c\u719f\u6089\u57fa\u672c\u64cd\u4f5c\uff1b\u6b65\u9aa42 - \u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u6295\u7bee\u548c\u8fd0\u7403\uff0c\u611f\u53d7\u6e38\u620f\u673a\u5236\uff1b\u6b65\u9aa43 - \u8fdb\u884c\u51e0\u573a\u5feb\u901f\u6bd4\u8d5b\uff0c\u4e86\u89e3\u6e38\u620f\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u7b2c\u4e00\u573a\u6bd4\u8d5b\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u5c3d\u53ef\u80fd\u591a\u5730\u547d\u4e2d\u6295\u7bee\uff0c\u800c\u4e0d\u662f\u62c5\u5fc3\u5206\u6570\u3002\u8fd9\u79cd\u65b9\u6cd5\u5c06\u5e2e\u52a9\u4f60\u9010\u6e10\u5efa\u7acb\u4fe1\u5fc3\u5e76\u63d0\u9ad8\u6280\u80fd\u3002"}, {"question": "92\u79d2\u7bee\u7403\u4e2d\uff0c\u65f6\u95f4\u628a\u63e1\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff1f\u6211\u5982\u4f55\u638c\u63e1\u5b83\uff1f", "answer": "92\u79d2\u7bee\u7403\u4e2d\uff0c\u65f6\u95f4\u628a\u63e1\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u6295\u7bee\u51c6\u786e\u6027\u548c\u9632\u5b88\u6548\u679c\u3002\u8981\u638c\u63e1\u65f6\u95f4\u628a\u63e1\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u6ce8\u610f\u5728\u5c1d\u8bd5\u6295\u7bee\u65f6\u51fa\u73b0\u7684\u6295\u7bee\u8ba1\u91cf\u5668\uff1b\u6b65\u9aa42 - \u5728\u8ba1\u91cf\u5668\u8fbe\u5230\u5cf0\u503c\u65f6\u91ca\u653e\u6295\u7bee\u6309\u94ae\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u51c6\u786e\u7387\uff1b\u6b65\u9aa43 - \u901a\u8fc7\u9884\u6d4b\u5bf9\u624b\u7684\u52a8\u4f5c\u6765\u7ec3\u4e60\u9632\u5b88\u52a8\u4f5c\uff0c\u4f8b\u5982\u5c01\u76d6\u548c\u62a2\u65ad\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8d5b\u4e2d\uff0c\u5c1d\u8bd5\u5728\u5bf9\u624b\u91ca\u653e\u7403\u65f6\uff0c\u901a\u8fc7\u8c03\u6574\u4f60\u7684\u8df3\u8dc3\u65f6\u673a\u6765\u5c01\u76d6\u5bf9\u65b9\u7684\u6295\u7bee\u3002\u6301\u7eed\u7ec3\u4e60\u5c06\u5e2e\u52a9\u4f60\u57f9\u517b\u51fa\u80fd\u663e\u8457\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u7684\u65f6\u95f4\u611f\u3002"}, {"question": "92\u79d2\u7bee\u7403\u65b0\u624b\u73a9\u5bb6\u5fc5\u5907\u7684\u64cd\u4f5c\u6709\u54ea\u4e9b\uff1f", "answer": "92\u79d2\u7bee\u7403\u65b0\u624b\u73a9\u5bb6\u5fc5\u5907\u7684\u64cd\u4f5c\u5305\u62ec\u6295\u7bee\u3001\u8fd0\u7403\u3001\u4f20\u7403\u548c\u9632\u5b88\u3002\u8981\u6295\u7bee\uff0c\u8bf7\u6309\u4f4f\u6295\u7bee\u6309\u94ae\uff0c\u7136\u540e\u5728\u6295\u7bee\u8ba1\u91cf\u5668\u8fbe\u5230\u5cf0\u503c\u65f6\u91ca\u653e\u3002\u8981\u8fd0\u7403\uff0c\u8bf7\u4f7f\u7528\u65b9\u5411\u952e\u6216\u64cd\u7eb5\u6746\u79fb\u52a8\u4f60\u7684\u7403\u5458\u5728\u573a\u5730\u4e2d\u3002\u4f20\u7403\u662f\u901a\u8fc7\u6309\u4f4f\u4f20\u7403\u6309\u94ae\u5e76\u7784\u51c6\u961f\u53cb\u6765\u5b8c\u6210\u7684\u3002\u9632\u5b88\u65f6\uff0c\u4f7f\u7528\u5c01\u76d6\u6309\u94ae\u5c1d\u8bd5\u5c01\u76d6\u6216\u4f7f\u7528\u62a2\u65ad\u6309\u94ae\u8bd5\u62a2\u593a\u5bf9\u624b\u7684\u7403\u3002\u4f8b\u5982\uff0c\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u7ed3\u5408\u8fd0\u7403\u548c\u4f20\u7403\u6765\u521b\u9020\u4e00\u4e2a\u5f00\u653e\u7684\u6295\u7bee\u673a\u4f1a\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u572892\u79d2\u7bee\u7403\u4e2d\u5360\u636e\u4f18\u52bf\uff1f", "answer": "\u8981\u572892\u79d2\u7bee\u7403\u4e2d\u5360\u636e\u4f18\u52bf\uff0c\u8bf7\u8fd0\u7528\u4ee5\u4e0b\u9ad8\u7ea7\u7b56\u7565\uff1a\u6b65\u9aa41 - \u638c\u63e1\u8fde\u62db\u6280\u5de7\uff0c\u4f8b\u5982\u8fd0\u7403\u7a81\u7834\u540e\u5feb\u901f\u4f20\u7403\uff1b\u6b65\u9aa42 - \u5229\u7528\u533a\u57df\u9632\u5b88\u6218\u672f\u9650\u5236\u5bf9\u624b\u5f97\u5206\u673a\u4f1a\uff1b\u6b65\u9aa43 - \u5b66\u4e60\u5206\u6790\u5bf9\u624b\u7684\u6a21\u5f0f\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6ce8\u610f\u5230\u5bf9\u624b\u504f\u7231\u67d0\u4e2a\u7279\u5b9a\u7684\u6295\u7bee\u4f4d\u7f6e\uff0c\u5c06\u4f60\u7684\u9632\u5b88\u7403\u5458\u5b89\u6392\u5728\u8be5\u533a\u57df\u8fdb\u884c\u5c01\u76d6\u3002\u5982\u679c\u6b63\u786e\u6267\u884c\u8fd9\u4e9b\u7b56\u7565\uff0c\u53ef\u4ee5\u4f7f\u4f60\u83b7\u5f97\u660e\u663e\u7684\u4f18\u52bf\u3002"}, {"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u572892\u79d2\u7bee\u7403\u4e2d\u7684\u6295\u7bee\u51c6\u786e\u7387\uff1f", "answer": "\u63d0\u9ad892\u79d2\u7bee\u7403\u4e2d\u7684\u6295\u7bee\u51c6\u786e\u7387\u9700\u8981\u4e00\u4e9b\u5173\u952e\u7ec3\u4e60\uff1a\u6b65\u9aa41 - \u59cb\u7ec8\u5173\u6ce8\u6295\u7bee\u8ba1\u91cf\u5668\uff0c\u5e76\u5728\u6700\u4f73\u65f6\u673a\u91ca\u653e\u6295\u7bee\u6309\u94ae\uff1b\u6b65\u9aa42 - \u4ece\u573a\u5730\u4e0d\u540c\u4f4d\u7f6e\u7ec3\u4e60\u6295\u7bee\uff0c\u4e86\u89e3\u6bcf\u6b21\u6295\u7bee\u6240\u9700\u7684\u8303\u56f4\u548c\u89d2\u5ea6\uff1b\u6b65\u9aa43 - \u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u53cd\u590d\u5c1d\u8bd5\u6295\u7bee\uff0c\u76f4\u5230\u4f60\u5f62\u6210\u808c\u8089\u8bb0\u5fc6\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8d5b\u4e2d\uff0c\u5c1d\u8bd5\u4ece\u4f60\u7ec3\u4e60\u6700\u591a\u3001\u5f97\u5206\u673a\u4f1a\u6700\u5927\u7684\u4f4d\u7f6e\u6295\u7bee\u3002\u6301\u7eed\u7ec3\u4e60\u5e76\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u65b9\u9762\u5c06\u63d0\u9ad8\u4f60\u7684\u6295\u7bee\u51c6\u786e\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u7403\u5458\u4f4d\u7f6e\u572892\u79d2\u7bee\u7403\u4e2d\u5f88\u91cd\u8981\uff1f\u6211\u8be5\u5982\u4f55\u5229\u7528\u5b83\u6765\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u572892\u79d2\u7bee\u7403\u4e2d\u7406\u89e3\u7403\u5458\u4f4d\u7f6e\u5f88\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u6709\u52a9\u4e8e\u4f60\u5236\u5b9a\u8fdb\u653b\u548c\u9632\u5b88\u7b56\u7565\u3002\u8981\u5229\u7528\u8fd9\u4e00\u70b9\u83b7\u5f97\u4f18\u52bf\uff1a\u6b65\u9aa41 - \u5b66\u4e60\u6bcf\u4e2a\u4f4d\u7f6e\u7684\u4f18\u52bf\u548c\u52a3\u52bf\uff0c\u4f8b\u5982\u5f97\u5206\u540e\u536b\u8fdc\u7a0b\u5f97\u5206\u7684\u80fd\u529b\uff1b\u6b65\u9aa42 - \u5c06\u7403\u5458\u5b89\u6392\u5728\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u53d1\u6325\u5176\u6548\u529b\u7684\u573a\u4e0a\u4f4d\u7f6e\uff0c\u4f8b\u5982\u5c06\u5f3a\u529b\u9632\u5b88\u7403\u5458\u5b89\u6392\u5728\u7bee\u4e0b\u9644\u8fd1\uff1b\u6b65\u9aa43 - \u6839\u636e\u5bf9\u624b\u7403\u5458\u7684\u4f4d\u7f6e\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6ce8\u610f\u5230\u5bf9\u624b\u63a7\u7403\u540e\u536b\u662f\u4ed6\u4eec\u7684\u4e3b\u8981\u5f97\u5206\u70b9\uff0c\u5c31\u4e13\u6ce8\u4e8e\u9650\u5236\u4ed6\u4eec\u5f97\u5206\u7684\u673a\u4f1a\u3002\u8fd9\u79cd\u5bf9\u4f4d\u7f6e\u7684\u8ba4\u8bc6\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "92\u79d2\u7bee\u7403\u7684\u5f97\u5206\u7cfb\u7edf\u80cc\u540e\u6709\u54ea\u4e9b\u5173\u952e\u673a\u5236\uff1f", "answer": "92\u79d2\u7bee\u7403\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u4ee5\u4e0b\u5173\u952e\u673a\u5236\uff1a\u6b65\u9aa41 - \u6839\u636e\u6295\u7bee\u7c7b\u578b\u5956\u52b1\u5f97\u5206\uff0c\u4e09\u5206\u7403\u6bd4\u4e24\u5206\u7403\u83b7\u5f97\u66f4\u591a\u5206\u6570\uff1b\u6b65\u9aa42 - \u6210\u529f\u7684\u7f5a\u7403\u4e5f\u80fd\u4e3a\u4f60\u7684\u5f97\u5206\u505a\u51fa\u8d21\u732e\uff0c\u5728\u67d0\u4e9b\u72af\u89c4\u4e4b\u540e\u4f1a\u5f97\u5230\u7f5a\u7403\u673a\u4f1a\uff1b\u6b65\u9aa43 - \u6e38\u620f\u8ba1\u65f6\u5668\u589e\u52a0\u4e86\u7d27\u8feb\u611f\uff0c\u9f13\u52b1\u5feb\u901f\u800c\u9ad8\u6548\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5728\u6bd4\u8d5b\u4e2d\uff0c\u4e00\u4e2a\u65f6\u673a\u628a\u63e1\u597d\u7684\u4e09\u5206\u7403\u53ef\u4ee5\u8fc5\u901f\u6539\u53d8\u6bd4\u8d5b\u7684\u52bf\u5934\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u80fd\u8ba9\u4f60\u6709\u6548\u5236\u5b9a\u5f97\u5206\u7b56\u7565\u3002"}, {"question": "92\u79d2\u7bee\u7403\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u6211\u8be5\u5982\u4f55\u7ba1\u7406\u5b83\uff1f", "answer": "92\u79d2\u7bee\u7403\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u4f1a\u9650\u5236\u7403\u5458\u80fd\u6267\u884c\u7684\u8fde\u7eed\u52a8\u4f5c\u3002\u8981\u6709\u6548\u7ba1\u7406\u4f53\u529b\uff1a\u6b65\u9aa41 - \u76d1\u63a7\u7403\u5458\u7684\u4f53\u529b\u6761\uff0c\u907f\u514d\u8fc7\u5ea6\u6d88\u8017\u4f53\u529b\uff1b\u6b65\u9aa42 - \u660e\u667a\u5730\u8fdb\u884c\u7403\u5458\u66ff\u8865\uff0c\u4ee5\u4fdd\u6301\u7403\u5458\u5728\u6574\u4e2a\u6bd4\u8d5b\u4e2d\u7684\u4f53\u529b\uff1b\u6b65\u9aa43 - \u5e73\u8861\u79ef\u6781\u7684\u6bd4\u8d5b\u4e0e\u6218\u7565\u6682\u505c\uff0c\u4ee5\u8282\u7701\u4f53\u529b\u4f9b\u5173\u952e\u65f6\u523b\u4f7f\u7528\u3002\u4f8b\u5982\uff0c\u5728\u5173\u952e\u7684\u6bd4\u8d5b\u4e2d\uff0c\u786e\u4fdd\u4f60\u7684\u5173\u952e\u7403\u5458\u5728\u6700\u540e\u51e0\u79d2\u949f\u6709\u8db3\u591f\u7684\u4f53\u529b\uff0c\u8fd9\u662f\u83b7\u80dc\u4e0e\u5931\u8d25\u7684\u5173\u952e\u6240\u5728\u3002\u6709\u6548\u7684\u4f53\u529b\u7ba1\u7406\u5bf9\u4e8e\u6301\u7eed\u4fdd\u6301\u826f\u597d\u8868\u73b0\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e00\u4e2a\u5e73\u53f0\u4e0a\u8fdb\u884c92\u79d2\u7bee\u7403\u6e38\u620f\u8fdb\u5ea6\uff0c\u7136\u540e\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\u4e0a\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u6e38\u620f\u5e10\u6237\u94fe\u63a5\u5230\u901a\u7528\u6e38\u620f\u914d\u7f6e\u6587\u4ef6\uff08\u4f8b\u5982Google Play\u6e38\u620f\u6216Apple\u6e38\u620f\u4e2d\u5fc3\uff09\u5c0692\u79d2\u7bee\u7403\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\u3002\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\uff1b\u6b65\u9aa42 - \u4f7f\u7528\u6e38\u620f\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u8fdb\u5ea6\u4ece\u539f\u6765\u7684\u5e73\u53f0\u4e0a\u4f20\uff1b\u6b65\u9aa43 - \u4e0b\u8f7d\u65b0\u5e73\u53f0\u4e0a\u7684\u4fdd\u5b58\u6570\u636e\uff0c\u7ee7\u7eed\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u79fb\u52a8\u8bbe\u5907\u5207\u6362\u5230PC\uff0c\u4f60\u7684\u7403\u5458\u6570\u636e\u3001\u6210\u5c31\u548c\u6e38\u620f\u8fdb\u5ea6\u90fd\u4f1a\u5f97\u5230\u4fdd\u7559\uff0c\u8fd9\u5c06\u4f7f\u8f6c\u6362\u8fc7\u7a0b\u65e0\u7f1d\u8fdb\u884c\u3002"}, {"question": "92\u79d2\u7bee\u7403\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u572892\u79d2\u7bee\u7403\u4e2d\uff0c\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41 - \u63a2\u7d22\u4e0d\u540c\u7684\u573a\u5730\uff0c\u627e\u5230\u5e26\u6709\u7ecf\u5178\u7bee\u7403\u65f6\u523b\u53c2\u8003\u7684\u72ec\u7279\u8bbe\u8ba1\u548c\u80cc\u666f\u5143\u7d20\uff1b\u6b65\u9aa42 - \u6267\u884c\u7279\u5b9a\u7ec4\u5408\u52a8\u4f5c\u6765\u89e3\u9501\u7279\u6b8a\u52a8\u753b\u6216\u89e3\u8bf4\uff1b\u6b65\u9aa43 - \u6ce8\u610f\u6e38\u620f\u6210\u5c31\uff0c\u8fd9\u4e9b\u6210\u5c31\u4e2d\u6709\u4e9b\u6697\u793a\u7740\u9690\u85cf\u6311\u6218\u3002\u4f8b\u5982\uff0c\u6210\u529f\u5b8c\u6210\u4e00\u4e2a\u80cc\u540e\u4f20\u7403\u52a0\u6263\u7bee\u52a8\u4f5c\u53ef\u80fd\u4f1a\u89e6\u53d1\u4e00\u4e2a\u7279\u522b\u7684\u5e86\u795d\u52a8\u753b\u3002\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4f1a\u4e3a\u6e38\u620f\u589e\u6dfb\u989d\u5916\u7684\u4e50\u8da3\u3002"}]
[{"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u63b4\u3080\u305f\u3081\u306b\u3001\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u30b7\u30e5\u30fc\u30c8\u3068\u30c9\u30ea\u30d6\u30eb\u306e\u7df4\u7fd2\u3092\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u306e\u6d41\u308c\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u3001\u6570\u8a66\u5408\u30af\u30a4\u30c3\u30af\u30de\u30c3\u30c1\u3092\u30d7\u30ec\u30a4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u8a66\u5408\u3067\u306f\u3001\u30b9\u30b3\u30a2\u3092\u6c17\u306b\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u53ef\u80fd\u306a\u9650\u308a\u6210\u529f\u3057\u305f\u30b7\u30e5\u30fc\u30c8\u3092\u591a\u304f\u6c7a\u3081\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u81ea\u4fe1\u3092\u7bc9\u304d\u3001\u5f90\u3005\u306b\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u7fd2\u5f97\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u30b7\u30e5\u30fc\u30c8\u306e\u7cbe\u5ea6\u3068\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306e\u6709\u52b9\u6027\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b7\u30e5\u30fc\u30c8\u3092\u8a66\u307f\u308b\u969b\u306b\u8868\u793a\u3055\u308c\u308b\u30b7\u30e5\u30fc\u30c8\u30b2\u30fc\u30b8\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u9069\u306a\u7cbe\u5ea6\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30b8\u304c\u30d4\u30fc\u30af\u306b\u3042\u308b\u3068\u304d\u306b\u30b7\u30e5\u30fc\u30c8\u30dc\u30bf\u30f3\u3092\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3067\u3001\u30d6\u30ed\u30c3\u30af\u3084\u30b9\u30c1\u30fc\u30eb\u306a\u3069\u306e\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306e\u52d5\u304d\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u8a66\u5408\u4e2d\u306b\u76f8\u624b\u304c\u30dc\u30fc\u30eb\u3092\u653e\u3064\u3068\u540c\u6642\u306b\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u30d6\u30ed\u30c3\u30af\u3059\u308b\u3001\u3068\u3044\u3063\u305f\u8a66\u307f\u3092\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u611f\u899a\u3092\u990a\u3046\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u91cd\u8981\u306a\u64cd\u4f5c\u306b\u306f\u3001\u30b7\u30e5\u30fc\u30c8\u3001\u30c9\u30ea\u30d6\u30eb\u3001\u30d1\u30b9\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b7\u30e5\u30fc\u30c8\u3092\u3059\u308b\u306b\u306f\u3001\u30b7\u30e5\u30fc\u30c8\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u4fdd\u6301\u3057\u3001\u30b7\u30e5\u30fc\u30c8\u30b2\u30fc\u30b8\u304c\u30d4\u30fc\u30af\u306b\u3042\u308b\u3068\u304d\u306b\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c9\u30ea\u30d6\u30eb\u3092\u3059\u308b\u306b\u306f\u3001\u65b9\u5411\u30d1\u30c3\u30c9\u307e\u305f\u306f\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b3\u30fc\u30c8\u4e0a\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u52d5\u304b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d1\u30b9\u306f\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u30d1\u30b9\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3053\u3068\u3067\u884c\u308f\u308c\u307e\u3059\u3002\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u3067\u306f\u3001\u30d6\u30ed\u30c3\u30af\u3092\u8a66\u307f\u308b\u306b\u306f\u30d6\u30ed\u30c3\u30af\u30dc\u30bf\u30f3\u3001\u307e\u305f\u306f\u76f8\u624b\u304b\u3089\u30dc\u30fc\u30eb\u3092\u53d6\u308a\u4e0a\u3052\u3088\u3046\u3068\u3059\u308b\u306b\u306f\u30b9\u30c1\u30fc\u30eb\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u30c9\u30ea\u30d6\u30eb\u3068\u30d1\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u30aa\u30fc\u30d7\u30f3\u306a\u30b7\u30e5\u30fc\u30c8\u306e\u6a5f\u4f1a\u3092\u4f5c\u308a\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u512a\u4f4d\u306b\u7acb\u3064\u306b\u306f\u3001\u6b21\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c9\u30ea\u30d6\u30eb\u30c9\u30e9\u30a4\u30d6\u3068\u8fc5\u901f\u306a\u30d1\u30b9\u306a\u3069\u306e\u30b3\u30f3\u30dc\u30e2\u30fc\u30b7\u30e7\u30f3\u306e\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30be\u30fc\u30f3\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306a\u3069\u306e\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306e\u6226\u8853\u3092\u6d3b\u7528\u3057\u3066\u3001\u76f8\u624b\u306e\u5f97\u70b9\u6a5f\u4f1a\u3092\u5236\u9650\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306e\u52d5\u304d\u3092\u8aad\u307f\u53d6\u3063\u3066\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u76f8\u624b\u306e\u3042\u308b\u7279\u5b9a\u306e\u30b7\u30e5\u30fc\u30c8\u5834\u6240\u3092\u597d\u3093\u3067\u3044\u308b\u3053\u3068\u306b\u6c17\u3065\u3051\u3070\u3001\u305d\u306e\u30a8\u30ea\u30a2\u3092\u30d6\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306b\u30c7\u30a3\u30d5\u30a7\u30f3\u30c0\u30fc\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u6b63\u3057\u304f\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u3001\u76f8\u624b\u306b\u5927\u304d\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30b7\u30e5\u30fc\u30c8\u306e\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30b7\u30e5\u30fc\u30c8\u306e\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u7df4\u7fd2\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30b7\u30e5\u30fc\u30c8\u30b2\u30fc\u30b8\u306b\u6ce8\u610f\u3057\u3001\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b7\u30e5\u30fc\u30c8\u30dc\u30bf\u30f3\u3092\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b3\u30fc\u30c8\u4e0a\u306e\u3055\u307e\u3056\u307e\u306a\u4f4d\u7f6e\u304b\u3089\u306e\u30b7\u30e5\u30fc\u30c8\u7df4\u7fd2\u3092\u884c\u3044\u3001\u5404\u30b7\u30e5\u30fc\u30c8\u306b\u5fc5\u8981\u306a\u7bc4\u56f2\u3068\u89d2\u5ea6\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u80b2\u3080\u307e\u3067\u7e70\u308a\u8fd4\u3057\u30b7\u30e5\u30fc\u30c8\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8a66\u5408\u4e2d\u306b\u6700\u3082\u7df4\u7fd2\u3057\u305f\u4f4d\u7f6e\u304b\u3089\u306e\u30b7\u30e5\u30fc\u30c8\u3092\u8a66\u307f\u308b\u3053\u3068\u3067\u3001\u5f97\u70b9\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9762\u3078\u306e\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u96c6\u4e2d\u306f\u3001\u3088\u308a\u826f\u3044\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u6709\u5229\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u306e\u6226\u7565\u3092\u7acb\u3066\u308b\u306e\u306b\u5f79\u7acb\u3064\u304b\u3089\u3067\u3059\u3002\u3042\u306a\u305f\u306e\u5229\u70b9\u306b\u3059\u308b\u305f\u3081\u306b\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u305d\u308c\u305e\u308c\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u306e\u5f37\u307f\u3084\u5f31\u307f\u3092\u5b66\u3073\u307e\u3059\uff08\u4f8b\u3048\u3070\u3001\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30ac\u30fc\u30c9\u306f\u30ed\u30f3\u30b0\u30ec\u30f3\u30b8\u304b\u3089\u306e\u5f97\u70b9\u80fd\u529b\u304c\u3042\u308a\u307e\u3059\uff09\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30b3\u30fc\u30c8\u4e0a\u306b\u914d\u7f6e\u3057\u3066\u3001\u5f7c\u3089\u306e\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\uff08\u4f8b\u3048\u3070\u3001\u5f37\u529b\u306a\u30c7\u30a3\u30d5\u30a7\u30f3\u30c0\u30fc\u3092\u30d0\u30b9\u30b1\u30c3\u30c8\u306e\u8fd1\u304f\u3078\u914d\u7f6e\u3057\u307e\u3059\uff09\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u306b\u57fa\u3065\u3044\u3066\u3001\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u76f8\u624b\u306e\u30dd\u30a4\u30f3\u30c8\u30ac\u30fc\u30c9\u304c\u4e3b\u306a\u30b9\u30b3\u30a2\u30e9\u30fc\u3067\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u3051\u3070\u3001\u5f7c\u3089\u306e\u5f97\u70b9\u6a5f\u4f1a\u3092\u5236\u9650\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u3053\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u8a8d\u8b58\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u304d\u304f\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5f97\u70b9\u306f\u3001\u30b7\u30e5\u30fc\u30c8\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u4e0e\u3048\u3089\u308c\u307e\u3059\u30023\u30dd\u30a4\u30f3\u30c8\u30b7\u30e5\u30fc\u30c8\u306f2\u30dd\u30a4\u30f3\u30c8\u30b7\u30e5\u30fc\u30c8\u3088\u308a\u3082\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6210\u529f\u3057\u305f\u30d5\u30ea\u30fc\u30b9\u30ed\u30fc\u3082\u5f97\u70b9\u306b\u8ca2\u732e\u3057\u3001\u7279\u5b9a\u306e\u30d5\u30a1\u30fc\u30eb\u5f8c\u306b\u306f\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u306e\u30bf\u30a4\u30de\u30fc\u306f\u7dca\u8feb\u611f\u3092\u52a0\u3048\u3001\u8fc5\u901f\u3067\u52b9\u7387\u7684\u306a\u5f97\u70b9\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8a66\u5408\u4e2d\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u30443\u30dd\u30a4\u30f3\u30c8\u30b7\u30e5\u30fc\u30c8\u306f\u3001\u30b2\u30fc\u30e0\u306e\u52e2\u3044\u3092\u8fc5\u901f\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u5f97\u70b9\u6226\u7565\u3092\u52b9\u679c\u7684\u306b\u7b56\u5b9a\u3067\u304d\u307e\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9023\u7d9a\u3057\u3066\u5b9f\u884c\u3067\u304d\u308b\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5236\u9650\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30bf\u30df\u30ca\u30b2\u30fc\u30b8\u3092\u76e3\u8996\u3057\u3001\u6fc0\u3057\u3044\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u9593\u306b\u4f11\u61a9\u3092\u53d6\u308b\u3053\u3068\u3067\u904e\u5ea6\u306e\u75b2\u52b4\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a66\u5408\u3092\u901a\u3057\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d5\u30ec\u30c3\u30b7\u30e5\u306b\u4fdd\u3064\u305f\u3081\u306b\u3001\u63a7\u3048\u9078\u624b\u3092\u8ce2\u304f\u4f7f\u3044\u5206\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7a4d\u6975\u7684\u306a\u30d7\u30ec\u30a4\u3068\u6226\u7565\u7684\u306a\u4e00\u6642\u505c\u6b62\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u91cd\u8981\u306a\u77ac\u9593\u306e\u305f\u3081\u306b\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u63a5\u6226\u306e\u30b2\u30fc\u30e0\u3067\u3001\u6700\u5f8c\u306e\u6570\u79d2\u9593\u3001\u30ad\u30fc\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b9\u30bf\u30df\u30ca\u3092\u5341\u5206\u306b\u78ba\u4fdd\u3057\u3066\u3044\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u52dd\u5229\u3068\u6557\u5317\u3092\u5206\u3051\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u9069\u5207\u306a\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u306f\u3001\u6301\u7d9a\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "92\u79d2\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308
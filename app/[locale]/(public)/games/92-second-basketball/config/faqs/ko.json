[{"question": "\ucd08\ubcf4\uc790\uac00 92\ucd08 \ub18d\uad6c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc5ec \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \uc288\ud305\uacfc \ub4dc\ub9ac\ube14 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud30c\uc545\ud558\uc138\uc694. STEP3 - \uba87 \ucc28\ub840 \ube60\ub978 \uacbd\uae30\ub97c \ud574\uc11c \uac8c\uc784\uc758 \ud750\ub984\uc744 \uc774\ud574\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uacbd\uae30\uc5d0\uc11c\ub294 \uc810\uc218\uc5d0 \uc2e0\uacbd \uc4f0\uc9c0 \ub9d0\uace0 \uac00\ub2a5\ud55c \ub9ce\uc740 \uc131\uacf5\uc801\uc778 \uc29b\uc744 \uc2dc\ub3c4\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc790\uc2e0\uac10\uc744 \uae38\ub7ec\uc8fc\uace0 \uc810\uc9c4\uc801\uc73c\ub85c \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uc288\ud305 \uc815\ud655\ub3c4\uc640 \uc218\ube44 \ud6a8\uc728\uc131\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc29b\uc744 \uc2dc\ub3c4\ud560 \ub54c \ub098\ud0c0\ub098\ub294 \uc29b \ubbf8\ud130\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694. STEP2 - \ucd5c\uc801\uc758 \uc815\ud655\ub3c4\ub97c \uc704\ud574 \ubbf8\ud130\uac00 \ucd5c\uace0\uc810\uc5d0 \uc788\uc744 \ub54c \uc29b \ubc84\ud2bc\uc744 \ub204\ub974\uc138\uc694. STEP3 - \uc0c1\ub300\ubc29\uc758 \ud589\ub3d9\uc744 \uc608\uce21\ud558\uc5ec \ube14\ub85c\ud0b9 \ubc0f \uc2a4\ud2f8\uacfc \uac19\uc740 \uc218\ube44 \ub3d9\uc791\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uae30 \uc911 \uc0c1\ub300\ubc29\uc774 \uacf5\uc744 \ub358\uc9c0\ub294 \uc21c\uac04 \ubc14\ub85c \uc810\ud504\ud558\uc5ec \uc29b\uc744 \ube14\ub85d\ud558\ub824\uace0 \ub178\ub825\ud558\uc138\uc694. \uc9c0\uc18d\uc801\uc778 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \ud0c0\uc774\ubc0d \uac10\uac01\uc744 \uac1c\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c 92\ucd08 \ub18d\uad6c\uc758 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc758 \ud544\uc218 \ucee8\ud2b8\ub864\uc5d0\ub294 \uc288\ud305, \ub4dc\ub9ac\ube14, \ud328\uc2a4 \ubc0f \uc218\ube44\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc29b\uc744 \ud558\ub824\uba74 \uc29b \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc29b \ubbf8\ud130\uac00 \ucd5c\uace0\uc810\uc5d0 \uc788\uc744 \ub54c \ub193\uc73c\uc138\uc694. \ub4dc\ub9ac\ube14\uc744 \ud558\ub824\uba74 \ubc29\ud5a5 \ud328\ub4dc \ub610\ub294 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\ub97c \ucf54\ud2b8 \uc704\ub85c \uc6c0\uc9c1\uc774\uc138\uc694. \ud328\uc2a4\ub294 \ub3d9\ub8cc\ub97c \ud5a5\ud574 \ud328\uc2a4 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uc218\ud589\ub429\ub2c8\ub2e4. \uc218\ube44\ub97c \uc704\ud574 \ube14\ub85d \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube14\ub85d\uc744 \uc2dc\ub3c4\ud558\uac70\ub098 \uc2a4\ud2f8 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c1\ub300\ubc29\uc758 \uacf5\uc744 \ube7c\uc557\uc73c\ub824\uace0 \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uae30 \uc911\uc5d0\ub294 \ub4dc\ub9ac\ube14\uacfc \ud328\uc2a4\ub97c \uc870\ud569\ud558\uc5ec \uc29b \uae30\ud68c\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uac8c\uc784\uc744 \uc9c0\ubc30\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uac8c\uc784\uc744 \uc9c0\ubc30\ud558\uae30 \uc704\ud574 \ub2e4\uc74c \uace0\uae09 \uc804\ub7b5\uc744 \ud65c\uc6a9\ud558\uc138\uc694: STEP1 - \ub4dc\ub9ac\ube14 \ub4dc\ub77c\uc774\ube0c \ud6c4 \ube60\ub978 \ud328\uc2a4\uc640 \uac19\uc740 \ucf64\ubcf4 \ub3d9\uc791\uc744 \uc219\ub2ec\ud558\uc138\uc694. STEP2 - \uc0c1\ub300\ubc29\uc758 \ub4dd\uc810 \uae30\ud68c\ub97c \uc81c\ud55c\ud558\uae30 \uc704\ud574 \uc874 \uc218\ube44\uc640 \uac19\uc740 \uc218\ube44 \uc804\uc220\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \uc0c1\ub300\ubc29\uc758 \ud328\ud134\uc744 \ud30c\uc545\ud558\uace0 \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\ubc29\uc774 \ud2b9\uc815 \uc288\ud305 \uc704\uce58\ub97c \uc120\ud638\ud558\ub294 \uac83\uc744 \uc54c\uc544\ucc28\ub9ac\uba74 \uc218\ube44\uc218\ub97c \ubc30\uce58\ud558\uc5ec \uadf8 \uc9c0\uc5ed\uc744 \ucc28\ub2e8\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc774 \uc62c\ubc14\ub974\uac8c \uc2e4\ud589\ub418\uba74 \uc0c1\ub300\ubc29\ubcf4\ub2e4 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uc288\ud305 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uc288\ud305 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uba87 \uac00\uc9c0 \ud575\uc2ec \uc5f0\uc2b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: STEP1 - \ud56d\uc0c1 \uc29b \ubbf8\ud130\uc5d0 \uc8fc\uc758\ud558\uace0 \ucd5c\uc801\uc758 \uc21c\uac04\uc5d0 \uc29b \ubc84\ud2bc\uc744 \ub193\uc73c\uc138\uc694. STEP2 - \ucf54\ud2b8\uc758 \uc11c\ub85c \ub2e4\ub978 \uc704\uce58\uc5d0\uc11c \uc29b \uc5f0\uc2b5\uc744 \ud558\uc5ec \uac01 \uc29b\ub9c8\ub2e4 \ud544\uc694\ud55c \ubc94\uc704\uc640 \uac01\ub3c4\ub97c \ud30c\uc545\ud558\uc138\uc694. STEP3 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\uc744 \uac1c\ubc1c\ud560 \ub54c\uae4c\uc9c0 \ubc18\ubcf5\uc801\uc73c\ub85c \uc29b\uc744 \uc2dc\ub3c4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uae30\uc5d0\uc11c \uac00\uc7a5 \uc5f0\uc2b5\ud55c \uc704\uce58\uc5d0\uc11c \uc29b\uc744 \uc2dc\ub3c4\ud558\uba74 \ub4dd\uc810 \ud655\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uce21\uba74\uc5d0 \ub300\ud55c \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc9d1\uc911\uc740 \uc288\ud305 \uc815\ud655\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uc120\uc218 \ud3ec\uc9c0\uc158\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc774\ub97c \uc5b4\ub5bb\uac8c \uc790\uc2e0\uc758 \uc774\uc810\uc73c\ub85c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \uc120\uc218 \ud3ec\uc9c0\uc158\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uacf5\uaca9 \ubc0f \uc218\ube44 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774\ub97c \uc790\uc2e0\uc758 \uc774\uc810\uc73c\ub85c \ud65c\uc6a9\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - \uac01 \ud3ec\uc9c0\uc158(\uc608: \uc288\ud305 \uac00\ub4dc\uc758 \uc7a5\uac70\ub9ac \ub4dd\uc810 \ub2a5\ub825)\uc758 \uac15\uc810\uacfc \uc57d\uc810\uc744 \ud30c\uc545\ud558\uc138\uc694. STEP2 - \uc120\uc218\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uae30 \uc704\ud574 \ucf54\ud2b8\uc5d0 \ubc30\uce58\ud558\uc138\uc694(\uc608: \uac15\ub825\ud55c \uc218\ube44\uc218\ub97c \ubc14\uc2a4\ucf13 \uadfc\ucc98\uc5d0 \ubc30\uce58). STEP3 - \uc0c1\ub300\ubc29\uc758 \ud3ec\uc9c0\uc158\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\ubc29\uc758 \ud3ec\uc778\ud2b8 \uac00\ub4dc\uac00 \uc8fc\uc694 \ub4dd\uc810\uc6d0\uc778 \uac83\uc744 \uc54c\uc544\ucc28\ub9ac\uba74 \uadf8\ub4e4\uc758 \uae30\ud68c\ub97c \uc81c\ud55c\ud558\ub294 \ub370 \uc218\ube44\ub97c \uc9d1\uc911\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ud3ec\uc9c0\uc154\ub2dd \uc778\uc2dd\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc788\ub294 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \uba87 \uac00\uc9c0 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4: STEP1 - \ub4dd\uc810\uc740 \uc2e4\uc2dc\ub41c \uc0f7\uc758 \uc720\ud615\uc5d0 \ub530\ub77c \ubd80\uc5ec\ub418\uba70, 3\uc810\uc29b\uc740 2\uc810\uc29b\ubcf4\ub2e4 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4. STEP2 - \uc131\uacf5\uc801\uc778 \uc790\uc720\ud22c\ub3c4 \ub4dd\uc810\uc5d0 \uae30\uc5ec\ud558\uba70, \ud2b9\uc815 \ud30c\uc6b8 \ud6c4 \uc218\uc5ec\ub429\ub2c8\ub2e4. STEP3 - \uac8c\uc784\uc758 \ud0c0\uc774\uba38\ub294 \uc2e0\uc18d\ud558\uace0 \ud6a8\uc728\uc801\uc778 \ub4dd\uc810\uc744 \uc7a5\ub824\ud558\uba74\uc11c \uae34\uae09\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uae30 \uc911 \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc758 3\uc810\uc29b\uc740 \uac8c\uc784\uc758 \ud750\ub984\uc744 \ube60\ub974\uac8c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud568\uc73c\ub85c\uc368 \ub4dd\uc810 \uc804\ub7b5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc218\ub9bd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc758 \uccb4\ub825 \uc2dc\uc2a4\ud15c\uc774 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc758 \uccb4\ub825 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c0\uc18d\uc801\uc73c\ub85c \uc218\ud589\ud560 \uc218 \uc788\ub294 \ub3d9\uc791\uc744 \uc81c\ud55c\ud568\uc73c\ub85c\uc368 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uccb4\ub825\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - \ud50c\ub808\uc774\uc5b4\uc758 \uccb4\ub825 \uac8c\uc774\uc9c0\ub97c \ud655\uc778\ud558\uace0 \uac15\ub3c4 \ub192\uc740 \ub3d9\uc791 \uc0ac\uc774\uc5d0 \ud734\uc2dd\uc744 \ucde8\ud558\uc5ec \uacfc\ub3c4\ud55c \ub178\ub825\uc744 \ud53c\ud558\uc138\uc694. STEP2 - \uacbd\uae30 \ub0b4\ub0b4 \uc120\uc218\uac00 \uc2e0\uc120\ud558\uac8c \uc720\uc9c0\ub418\ub3c4\ub85d \uad50\uccb4\ub97c \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc804\ub7b5\uc801\uc778 \uc77c\uc2dc \uc815\uc9c0\uc640 \uade0\ud615\uc788\uac8c \uc0ac\uc6a9\ud558\uc5ec \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uccb4\ub825\uc744 \ubcf4\uc874\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub9c9\ud310 \uc811\uc804 \uc0c1\ud669\uc5d0\uc11c \uc8fc\uc694 \uc120\uc218\ub4e4\uc774 \uc2b9\ubd80\ucc98\uc5d0 \ud544\uc694\ud55c \uccb4\ub825\uc744 \ud655\ubcf4\ud558\ub294 \uac83\uc740 \uc2b9\ud328\ub97c \uac00\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc801\uc808\ud55c \uccb4\ub825 \uad00\ub9ac\uac00 \uc9c0\uc18d\uc801\uc778 \uc131\ub2a5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc758 \uc9c4\ucc99\ub3c4\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc608, Google Play \uac8c\uc784 \ub610\ub294 Apple \uac8c\uc784 \uc13c\ud130\uc640 \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \uac8c\uc784 \ud504\ub85c\ud544\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud568\uc73c\ub85c\uc368 92\ucd08 \ub18d\uad6c\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc758 \uc9c4\ucc99\ub3c4\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2 - \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc758 \uc9c4\ucc99\ub3c4\ub97c \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. STEP3 - \uc911\ub2e8\ud588\ub358 \uacf3\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\ub3c4\ub85d \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c PC\ub85c \uc804\ud658\ud558\uba74 \ud50c\ub808\uc774\uc5b4 \ud1b5\uacc4, \uc5c5\uc801 \ubc0f \uac8c\uc784 \uc9c4\ucc99\ub3c4\uac00 \uc720\uc9c0\ub418\uc5b4 \uc6d0\ud65c\ud55c \uc804\ud658\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."}, {"question": "92\ucd08 \ub18d\uad6c\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "92\ucd08 \ub18d\uad6c\uc5d0\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ud074\ub798\uc2dd \ub18d\uad6c \uc21c\uac04\uc744 \ucc38\uace0\ud558\ub294 \ub3c5\ud2b9\ud55c \ub514\uc790\uc778\uacfc \ubc30\uacbd \uc694\uc18c\ub97c \ucc3e\uc73c\ub824\uba74 \uc11c\ub85c \ub2e4\ub978 \ucf54\ud2b8\ub97c \ud0d0\ud5d8\ud558\uc138\uc694. STEP2 - \ud2b9\uc815 \ub3d9\uc791 \uc870\ud569\uc744 \uc218\ud589\ud558\uc5ec \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774\ub098 \ucf54\uba58\ud130\ub9ac\ub97c \ud574\uc81c\ud558\uc138\uc694. STEP3 - \uc228\uaca8\uc9c4 \ucc4c\ub9b0\uc9c0\uc5d0 \ub300\ud55c \ud78c\ud2b8\ub97c \uc81c\uacf5\ud558\ub294 \uac8c\uc784 \ub0b4 \uc5c5\uc801\uc5d0 \uc8fc\uc758\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc31\ub118\ubc84 \ud328\uc2a4\ub97c \uc131\uacf5\uc801\uc73c\ub85c \ub9c8\uce5c \ud6c4 \ub369\ud06c\ub97c \uc131\uacf5\ud558\uba74 \ud2b9\ubcc4\ud55c \ucd95\ud558 \uc560\ub2c8\uba54\uc774\uc158\uc774 \ud2b8\ub9ac\uac70\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ubc1c\uacac\ud558\uba74 \uac8c\uc784\uc5d0 \uc990\uac70\uc6c0\uc774 \ub354\ud574\uc9d1\ub2c8\ub2e4."}]
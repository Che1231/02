[{"question": "\ud50c\ub808\uc774\uc5b4\uac00 \ud50c\ub798\uae00\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1 - \uc774\ub3d9 \ud0a4(WASD)\uc640 \uc810\ud504 \ud0a4(\uc2a4\ud398\uc774\uc2a4\ubc14)\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 2 - 'E' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3 - \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\ubcc0\uc744 \uc0b4\ud3b4\ubcf4\uace0 \uc870\uc900\ud558\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uace0 \ub808\ubc84\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \ubb38\uc744 \uc5f4\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc2b5\uc744 \ud1b5\ud574 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \ub2ec\ub9ac\uae30, \uc810\ud504, \uacf5\uaca9\uacfc \uac19\uc740 \ud589\ub3d9\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub294 \ub2a5\ub825\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uae30 \ub54c\ubb38\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ud654\uba74 \ud558\ub2e8\uc5d0 \uc788\ub294 \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uc9c0\uc18d\uc801\uc778 \ub2ec\ub9ac\uae30\ub97c \ud53c\ud558\uace0, \ub300\uc2e0 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc808\uc57d\ud558\uae30 \uc704\ud574 \uc9e7\uc740 \uc2dc\uac04 \ub3d9\uc548 \ub2ec\ub9bd\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ud734\uc2dd \uc7a5\uc18c \ub610\ub294 \uc2a4\ud0dc\ubbf8\ub098\ub97c \ud68c\ubcf5\ud558\ub294 \uc544\uc774\ud15c\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc232 \ub808\ubca8\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098\ub97c \ubcf4\ucda9\ud558\ub294 \ubca0\ub9ac\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc801\uc808\ud788 \uad00\ub9ac\ud558\uba74 \ud56d\uc0c1 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ub300\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc758 \ub2e4\uc591\ud55c \ubb34\uae30 \uc720\ud615 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \ucd08\ubcf4\uc790\ub294 \uc5b4\ub5a4 \ubb34\uae30\ub97c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\ub294 \uac01\uae30 \uace0\uc720\ud55c \uc18d\uc131\uc744 \uac00\uc9c4 \uc5ec\ub7ec \ubb34\uae30 \uc720\ud615\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac80\uc740 \uc18d\ub3c4\uc640 \ud53c\ud574\ub7c9\uc774 \uade0\ud615\uc744 \uc774\ub8e8\uc5b4 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \ud65c\uc740 \uc6d0\uac70\ub9ac \uacf5\uaca9\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \uc815\ud655\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub3c4\ub07c\ub294 \ub192\uc740 \ud53c\ud574\ub97c \uc8fc\uc9c0\ub9cc \uc18d\ub3c4\uac00 \ub290\ub9bd\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub294 \ub2e4\uc7ac\ub2e4\ub2a5\ud568 \ub54c\ubb38\uc5d0 \uac80\uc744 \uc2dc\uc791\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubc18 \uac8c\uc784\uc758 \ucca0\uac80\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5ec\ub7ec \uc720\ud615\uc758 \uc801\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacbd\ud5d8\uc744 \uc313\uc73c\uba74 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ub2e4\ub978 \ubb34\uae30\ub97c \uc2dc\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud50c\ub798\uae00\uc5d0\uc11c \ucd5c\ub300 \ud53c\ud574\ub7c9\uc744 \uc704\ud574 \uc2a4\ud0ac \ud68c\uc804\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub984\uc73c\ub85c\uc368 \uc2a4\ud0ac \ud68c\uc804\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uce90\ub9ad\ud130\uc758 \uac00\uc7a5 \uac15\ub825\ud55c \uc2a4\ud0ac\uacfc \uadf8 \ucfe8\ub2e4\uc6b4\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uc11c\ub85c \ubcf4\uc644\ud558\ub294 \uc2a4\ud0ac\uc744 \uc5f0\uc18d\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4(\uc608: \uae30\uc808\uc2dc\ud0a4\ub294 \uc2a4\ud0ac \uc774\ud6c4 \ub192\uc740 \ud53c\ud574 \uc2a4\ud0ac). \ub2e8\uacc4 3 - \uc2a4\ud0ac \uac04\uc758 \ub300\uae30 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4\uc804\uc5d0\uc11c '\uae30\uc808 \ud0c0\uaca9'\uc744 \uc0ac\uc6a9\ud55c \ud6c4 '\ud30c\uc6cc \uc2ac\ub798\uc2dc'\ub97c \uc0ac\uc6a9\ud558\uba74 \ubcf4\uc2a4\ub97c \uc81c\uc5b4\ud558\uba74\uc11c \ud53c\ud574\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2a4\ud0ac\uc5d0 \ub300\ud55c \uc9c0\uc18d\uc801\uc778 \uc5f0\uc2b5\uacfc \uc219\ub2ec\uc740 \uc774 \uc804\ub7b5\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc5d0\uc11c \uc804\ud22c \uc911\uc5d0 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \ud658\uacbd \uc694\uc778\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \uc804\ud22c \uc911\uc5d0 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \ud658\uacbd \uc694\uc778\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub192\uc740 \uc9c0\ub300\ub294 \uc2dc\uc57c \ud655\ubcf4\uc640 \uc6d0\uac70\ub9ac \uacf5\uaca9 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc881\uc740 \ud1b5\ub85c\ub294 \uc801\uc744 \ubab0\uc544\ub123\uc5b4 \uad00\ub9ac\ud558\uae30 \uc27d\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \ud3ed\ubc1c\uc131 \ub4dc\ub7fc\ud1b5\uc740 \ud65c\uc131\ud654\ub418\uc5b4 \uc9c0\uc5ed \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3d9\uad74 \ub808\ubca8\uc5d0\uc11c \ubcbc\ub791 \uc704\uc5d0 \uc790\ub9ac \uc7a1\uc73c\uba74 \ud65c\ub85c \uc801\uc744 \uc0ac\uaca9\ud558\uba74\uc11c \uc801\uc758 \uacf5\uaca9 \ubc94\uc704 \ubc16\uc5d0 \uba38\ubb3c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc778\uc2dd\ud558\uace0 \ud65c\uc6a9\ud558\uba74 \uc804\ud22c \ud6a8\uc728\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc5d0\uc11c \ub0ae\uacfc \ubc24\uc758 \uc8fc\uae30\ub294 \ubb34\uc2a8 \uc758\ubbf8\uac00 \uc788\uc73c\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \ub0ae\uacfc \ubc24\uc758 \uc8fc\uae30\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ub2e4\uc591\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub0ae\uc5d0\ub294 \uc2dc\uc57c\uac00 \ub192\uace0 \uc801\uc758 \uacf5\uaca9\uc131\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. \ubc24\uc5d0\ub294 \uc2dc\uc57c\uac00 \uac10\uc18c\ud558\uace0 \uc801\uc758 \uacf5\uaca9\uc131\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc77c\ubd80 \ud018\uc2a4\ud2b8\uc640 \uc774\ubca4\ud2b8\ub3c4 \uc2dc\uac04\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub2ec\ube5b \uc758\uc2dd' \ud018\uc2a4\ud2b8\ub294 \ubc24\uc5d0\ub9cc \uc644\ub8cc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ud0d0\ud5d8\uacfc \uc790\uc6d0 \uc218\uc9d1\uc5d0 \ub0ae\uc744 \uc0ac\uc6a9\ud558\uace0 \ubc24\uc5d0\ub294 \ub354 \uc5b4\ub824\uc6b4 \ub9cc\ub0a8\uc5d0 \ub300\ube44\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc758 \ubc29\uc5b4 \uc7a5\ube44 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc801\uc808\ud55c \ubc29\uc5b4 \uc7a5\ube44\ub97c \uc120\ud0dd\ud558\uae30 \uc704\ud55c \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc758 \ubc29\uc5b4 \uc7a5\ube44 \uc2dc\uc2a4\ud15c\uc740 \ubc29\uc5b4\ub825 \ub4f1\uae09\uacfc \ud2b9\uc218 \uc18d\uc131\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \ubb34\uac70\uc6b4 \ubc29\uc5b4 \uc7a5\ube44\ub294 \ubc29\uc5b4\ub825\uc774 \ub192\uc9c0\ub9cc \uc774\ub3d9\uc131\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. \uac00\ubcbc\uc6b4 \ubc29\uc5b4 \uc7a5\ube44\ub294 \ubc29\uc5b4\ub825\uc774 \ub0ae\uc9c0\ub9cc \ubbfc\ucca9\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ub610\ub294 \uc9c1\uba74\ud558\ub294 \uc801\uc758 \uc720\ud615\uc5d0 \ub530\ub77c \ubc29\uc5b4 \uc7a5\ube44\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \uc801\uacfc \uc2f8\uc6b8 \ub54c\ub294 '\uac00\uc8fd \uc138\ud2b8'\uc640 \uac19\uc740 \uac00\ubcbc\uc6b4 \ubc29\uc5b4 \uc7a5\ube44\uac00 \ub354 \uc88b\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \ubcf4\ud638\uc640 \uc774\ub3d9\uc131 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \ud56d\uc0c1 \uace0\ub824\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud50c\ub798\uae00\uc758 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uc758 \uc5b4\ub824\uc6c0\uacfc \uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc6d0\ud65c\ud55c \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc758 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \ud1b5\ud574 \ub2e4\ub978 \uae30\uae30\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ud568\uaed8 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc5b4 \ucee4\ubba4\ub2c8\ud2f0 \uacbd\ud5d8\uc744 \ud48d\ubd80\ud558\uac8c \ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub2e4\uc591\ud55c \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \uc131\ub2a5 \ubb38\uc81c\ub85c \uc778\ud574 \uc5b4\ub824\uc6c0\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6d0\ud65c\ud55c \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1 - \uac8c\uc784\uc744 \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2 - \ud50c\ub7ab\ud3fc \uac04 \uc804\ud658 \uc2dc \ud638\ud658 \uac00\ub2a5\ud55c \uc8fc\ubcc0 \uc7a5\uce58\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3 - \uc7a5\uce58\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC \ud50c\ub808\uc774\uc5b4\ub294 \ucf58\uc194 \uc0ac\uc6a9\uc790\uc640 \ud568\uaed8 \ud50c\ub808\uc774\ud560 \ub54c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc801\uc808\ud55c \uc124\uc815 \ubc0f \uc758\uc0ac\uc18c\ud1b5\uc744 \ud1b5\ud574 \ub300\ubd80\ubd84\uc758 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ubb38\uc81c\ub97c \uc644\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubc30\uacbd \uc774\uc57c\uae30\uc640 \ube44\ubc00 \uc9c0\uc5ed\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5a4 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubc30\uacbd \uc774\uc57c\uae30\uc640 \ube44\ubc00 \uc9c0\uc5ed\uc744 \ucc3e\uc73c\ub824\uba74 \uc138\uc2ec\ud55c \uad00\ucc30\uacfc \ud0d0\ud5d8\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud2b9\uc774\ud55c \ubcbd \ud328\ud134\uc774\ub098 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\uc640 \uac19\uc740 \ubbf8\ubb18\ud55c \ub2e8\uc11c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ud2b9\uc815 NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \ube44\ubc00\uc744 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\ub300 \uc720\uc801\uc5d0\uc11c \ub3d9\uc0c1 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \uc791\ub3d9\ud558\uba74 \ud76c\uadc0 \uc544\uc774\ud15c\uacfc \uc5ed\uc0ac\ucc45\uc774 \ub4e4\uc5b4\uc788\ub294 \ubcf4\ubb3c\ubc29\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \ud1b5\ub85c\uac00 \uc5f4\ub9bd\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc1c\uacac\uc740 \uc774\uc57c\uae30\ub97c \ud48d\ubd80\ud558\uac8c \ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uadc0\uc911\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub798\uae00\uc5d0\uc11c, \ud2b9\ud788 \uc7a5\uae30 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub798\uae00\uc5d0\uc11c \uc7a5\uae30 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uce58\uc720 \ubb3c\uc57d\uacfc \ud0c4\uc57d\uacfc \uac19\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc744 \uc6b0\uc120 \uc21c\uc704\uc5d0 \ub450\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2 - \uc815\uae30\uc801\uc73c\ub85c \ub0ae\uc740 \uac00\uce58\uc758 \uc544\uc774\ud15c\uc744 \ud310\ub9e4\ud558\uac70\ub098 \ubc84\ub824\uc11c \uacf5\uac04\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc548\uc804\ud55c \uc9c0\uc5ed\uc758 \ubcf4\uad00 \uc0c1\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud76c\uadc0\ud558\uac70\ub098 \uc0c1\ud669\uc5d0 \ub530\ub978 \uc544\uc774\ud15c\uc744 \ubcf4\uad00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc744 \ud5c8\ube0c\uc5d0\uc11c \ub098\uc911\uc5d0 \uc0ac\uc6a9\ud560 \ucd94\uac00 \uc81c\uc791 \uc7ac\ub8cc\ub97c \uc0c1\uc790\uc5d0 \ubcf4\uad00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud6a8\uc728\uc801\uc778 \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\ub97c \ud1b5\ud574 \ubd88\ud544\uc694\ud55c \uc544\uc774\ud15c\uc5d0 \uc9d3\ub20c\ub9ac\uc9c0 \uc54a\uace0 \ud56d\uc0c1 \uc900\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u65d7\u5e1c\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u4e3a\u4e86\u5feb\u901f\u638c\u63e1\u300a\u65d7\u5e1c\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u8df3\u8dc3\u952e\uff08\u7a7a\u683c\u952e\uff09\u3002\u6b65\u9aa42 - \u5b66\u4e60\u5982\u4f55\u4f7f\u7528\u201cE\u201d\u952e\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u6b65\u9aa43 - \u7ec3\u4e60\u4f7f\u7528\u9f20\u6807\u8fdb\u884c\u89c6\u89d2\u8f6c\u6362\u548c\u7784\u51c6\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u5173\u5361\u4e2d\uff0c\u4f60\u9700\u8981\u8df3\u8fc7\u969c\u788d\u5e76\u4e0e\u6760\u6746\u4e92\u52a8\u6253\u5f00\u95e8\u3002\u901a\u8fc7\u5b9e\u8df5\u64cd\u4f5c\uff0c\u4f60\u5c06\u80fd\u591f\u719f\u7ec3\u638c\u63e1\u6e38\u620f\u63a7\u5236\u3002"}, {"question": "\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7ba1\u7406\u4f53\u529b\u5f88\u91cd\u8981\uff1f\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u4f53\u529b\uff1f", "answer": "\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\uff0c\u7ba1\u7406\u4f53\u529b\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u4f60\u8fdb\u884c\u8dd1\u6b65\u3001\u8df3\u8dc3\u548c\u653b\u51fb\u7b49\u52a8\u4f5c\u7684\u80fd\u529b\u3002\u4e3a\u4e86\u6709\u6548\u5730\u7ba1\u7406\u4f53\u529b\uff1a\u6b65\u9aa41 - \u5173\u6ce8\u5c4f\u5e55\u5e95\u90e8\u663e\u793a\u7684\u4f53\u529b\u6761\u3002\u6b65\u9aa42 - \u907f\u514d\u6301\u7eed\u5954\u8dd1\uff0c\u800c\u5e94\u4f7f\u7528\u77ed\u65f6\u95f4\u51b2\u523a\u6765\u8282\u7701\u4f53\u529b\u3002\u6b65\u9aa43 - \u5229\u7528\u4f11\u606f\u70b9\u6216\u6062\u590d\u4f53\u529b\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u68ee\u6797\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u627e\u5230\u6d46\u679c\u6765\u6062\u590d\u4f53\u529b\u3002\u9002\u5f53\u7684\u4f53\u529b\u7ba1\u7406\u80fd\u591f\u786e\u4fdd\u4f60\u5728\u5173\u952e\u65f6\u523b\u4fdd\u6301\u5145\u8db3\u7684\u4f53\u529b\u3002"}, {"question": "\u300a\u65d7\u5e1c\u300b\u4e2d\u4e0d\u540c\u6b66\u5668\u7c7b\u578b\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f\u65b0\u624b\u5e94\u8be5\u4ece\u54ea\u79cd\u6b66\u5668\u5f00\u59cb\uff1f", "answer": "\u300a\u65d7\u5e1c\u300b\u63d0\u4f9b\u4e86\u591a\u79cd\u6b66\u5668\u7c7b\u578b\uff0c\u6bcf\u79cd\u6b66\u5668\u90fd\u6709\u72ec\u7279\u7684\u5c5e\u6027\u3002\u5251\u5728\u901f\u5ea6\u548c\u4f24\u5bb3\u65b9\u9762\u6bd4\u8f83\u5e73\u8861\uff0c\u975e\u5e38\u9002\u5408\u65b0\u624b\u73a9\u5bb6\u3002\u5f13\u7bad\u63d0\u4f9b\u8fdc\u7a0b\u653b\u51fb\uff0c\u4f46\u9700\u8981\u7cbe\u51c6\u5ea6\u3002\u65a7\u5934\u9020\u6210\u9ad8\u4f24\u5bb3\uff0c\u4f46\u901f\u5ea6\u8f83\u6162\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u63a8\u8350\u4ece\u5251\u5f00\u59cb\uff0c\u56e0\u4e3a\u5b83\u9002\u7528\u6027\u5f3a\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u521d\u671f\uff0c\u94c1\u5251\u53ef\u4ee5\u6709\u6548\u5730\u5bf9\u4ed8\u591a\u79cd\u654c\u4eba\u7c7b\u578b\u3002\u968f\u7740\u7ecf\u9a8c\u7684\u79ef\u7d2f\uff0c\u4f60\u53ef\u4ee5\u5c1d\u8bd5\u5176\u4ed6\u6b66\u5668\u4ee5\u9002\u5e94\u4f60\u7684\u6e38\u620f\u98ce\u683c\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\u4f18\u5316\u6280\u80fd\u7ec4\u5408\uff0c\u4ee5\u6700\u5927\u5316\u4f24\u5bb3\u8f93\u51fa\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u6b65\u9aa4\u4f18\u5316\u6280\u80fd\u7ec4\u5408\uff0c\u4ee5\u6700\u5927\u5316\u4f24\u5bb3\u8f93\u51fa\uff1a\u6b65\u9aa41 - \u8bc6\u522b\u4f60\u7684\u89d2\u8272\u6700\u5f3a\u7684\u6280\u80fd\u53ca\u5176\u51b7\u5374\u65f6\u95f4\u3002\u6b65\u9aa42 - \u94fe\u63a5\u4e92\u8865\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u5148\u6655\u7729\u654c\u4eba\u518d\u8fdb\u884c\u9ad8\u4f24\u5bb3\u653b\u51fb\u3002\u6b65\u9aa43 - \u7ec3\u4e60\u6280\u80fd\u7684\u8854\u63a5\u65f6\u95f4\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6280\u80fd\u4e4b\u95f4\u7684\u7a7a\u95f2\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5728Boss\u6218\u4e2d\uff0c\u4f7f\u7528\u201c\u7729\u6655\u6253\u51fb\u201d\u6280\u80fd\uff0c\u63a5\u7740\u4f7f\u7528\u201c\u5f3a\u529b\u65a9\u51fb\u201d\u6280\u80fd\uff0c\u53ef\u4ee5\u6700\u5927\u5316\u4f24\u5bb3\u5e76\u63a7\u5236Boss\u3002\u6301\u7eed\u7684\u7ec3\u4e60\u548c\u5bf9\u6280\u80fd\u7684\u719f\u6089\u662f\u638c\u63e1\u8fd9\u79cd\u7b56\u7565\u7684\u5173\u952e\u3002"}, {"question": "\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\uff0c\u54ea\u4e9b\u73af\u5883\u56e0\u7d20\u53ef\u4ee5\u7528\u4e8e\u5728\u6218\u6597\u4e2d\u83b7\u5f97\u6218\u672f\u4f18\u52bf\uff1f", "answer": "\u300a\u65d7\u5e1c\u300b\u4e2d\u6709\u591a\u79cd\u73af\u5883\u56e0\u7d20\u53ef\u4ee5\u7528\u6765\u83b7\u5f97\u6218\u672f\u4f18\u52bf\uff1a\u9ad8\u5730\u53ef\u4ee5\u63d0\u4f9b\u66f4\u597d\u7684\u89c6\u91ce\u548c\u8fdc\u7a0b\u653b\u51fb\u673a\u4f1a\u3002\u72ed\u7a84\u7684\u901a\u9053\u53ef\u4ee5\u5c06\u654c\u4eba\u5f15\u5bfc\u5230\u7279\u5b9a\u533a\u57df\uff0c\u4f7f\u5b83\u4eec\u66f4\u5bb9\u6613\u63a7\u5236\u3002\u70b8\u836f\u6876\u53ef\u4ee5\u5f15\u7206\u9020\u6210\u533a\u57df\u6027\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u6d1e\u7a74\u5173\u5361\u4e2d\uff0c\u7ad9\u5728\u5ca9\u77f3\u7a81\u51fa\u7684\u4f4d\u7f6e\u53ef\u4ee5\u8ba9\u4f60\u5229\u7528\u5f13\u7bad\u7cbe\u786e\u72d9\u51fb\u654c\u4eba\uff0c\u540c\u65f6\u628a\u81ea\u5df1\u7f6e\u8eab\u4e8e\u5b89\u5168\u5730\u5e26\u3002\u610f\u8bc6\u5230\u5e76\u5229\u7528\u8fd9\u4e9b\u5143\u7d20\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6218\u6597\u6548\u7387\u3002"}, {"question": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u663c\u591c\u5faa\u73af\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u663c\u591c\u5faa\u73af\u4f1a\u4ee5\u5404\u79cd\u65b9\u5f0f\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u767d\u5929\uff0c\u89c6\u91ce\u5f00\u9614\uff0c\u654c\u4eba\u653b\u51fb\u6027\u8f83\u4f4e\u3002\u665a\u4e0a\uff0c\u89c6\u91ce\u4f1a\u53d8\u5dee\uff0c\u654c\u4eba\u4f1a\u53d8\u5f97\u66f4\u52a0\u5371\u9669\u3002\u6709\u4e9b\u4efb\u52a1\u548c\u4e8b\u4ef6\u4e5f\u662f\u7279\u5b9a\u65f6\u95f4\u7684\u3002\u4f8b\u5982\uff0c\u201c\u6708\u5149\u4eea\u5f0f\u201d\u4efb\u52a1\u53ea\u80fd\u5728\u665a\u4e0a\u5b8c\u6210\u3002\u73a9\u5bb6\u5e94\u8be5\u6839\u636e\u60c5\u51b5\u5b89\u6392\u81ea\u5df1\u7684\u6d3b\u52a8\uff0c\u5229\u7528\u767d\u5929\u8fdb\u884c\u63a2\u7d22\u548c\u8d44\u6e90\u6536\u96c6\uff0c\u5e76\u5728\u665a\u4e0a\u4e3a\u66f4\u5177\u6311\u6218\u6027\u7684\u906d\u9047\u505a\u597d\u51c6\u5907\u3002"}, {"question": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u76d4\u7532\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u9009\u62e9\u5408\u9002\u7684\u76d4\u7532\u6709\u54ea\u4e9b\u6700\u4f73\u5b9e\u8df5\uff1f", "answer": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u76d4\u7532\u7cfb\u7edf\u57fa\u4e8e\u9632\u5fa1\u7b49\u7ea7\u548c\u7279\u6b8a\u5c5e\u6027\u3002\u91cd\u578b\u76d4\u7532\u63d0\u4f9b\u9ad8\u9632\u5fa1\uff0c\u4f46\u4f1a\u964d\u4f4e\u79fb\u52a8\u901f\u5ea6\uff0c\u800c\u8f7b\u578b\u76d4\u7532\u9632\u5fa1\u8f83\u4f4e\uff0c\u4f46\u589e\u52a0\u4e86\u654f\u6377\u6027\u3002\u6839\u636e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u548c\u9762\u5bf9\u7684\u654c\u4eba\u7c7b\u578b\u9009\u62e9\u76d4\u7532\u3002\u4f8b\u5982\uff0c\u5728\u9762\u5bf9\u5feb\u901f\u79fb\u52a8\u7684\u654c\u4eba\u65f6\uff0c\u9009\u62e9\u8f7b\u578b\u76d4\u7532\u5982\u201c\u76ae\u9769\u5957\u88c5\u201d\u66f4\u5408\u9002\u3002\u59cb\u7ec8\u5e73\u8861\u9632\u5fa1\u548c\u79fb\u52a8\u6027\uff0c\u4ee5\u4f18\u5316\u4f60\u5728\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u8868\u73b0\u3002"}, {"question": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u8de8\u5e73\u53f0\u6e38\u620f\u6709\u54ea\u4e9b\u6311\u6218\u548c\u4f18\u52bf\uff1f\u73a9\u5bb6\u5982\u4f55\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u8de8\u5e73\u53f0\u6e38\u620f\u5141\u8bb8\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u73a9\u5bb6\u4e00\u8d77\u6e38\u620f\uff0c\u589e\u5f3a\u793e\u533a\u4f53\u9a8c\u3002\u7136\u800c\uff0c\u5b83\u4e5f\u53ef\u80fd\u5b58\u5728\u4e00\u4e9b\u6311\u6218\uff0c\u4f8b\u5982\u4e0d\u540c\u7684\u63a7\u5236\u65b9\u6848\u548c\u6027\u80fd\u95ee\u9898\u3002\u4e3a\u4e86\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u7684\u6e38\u620f\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u3002 \u6b65\u9aa42 - \u5728\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u5207\u6362\u65f6\uff0c\u4f7f\u7528\u517c\u5bb9\u7684\u5468\u8fb9\u8bbe\u5907\u3002 \u6b65\u9aa43 - \u8c03\u6574\u8bbe\u7f6e\u4ee5\u5728\u4f60\u7684\u8bbe\u5907\u4e0a\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002\u4f8b\u5982\uff0cPC\u73a9\u5bb6\u5728\u4e0e\u4e3b\u673a\u73a9\u5bb6\u4e00\u8d77\u6e38\u620f\u65f6\uff0c\u53ef\u80fd\u9700\u8981\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u3002\u9002\u5f53\u7684\u8bbe\u7f6e\u548c\u6c9f\u901a\u53ef\u4ee5\u51cf\u8f7b\u5927\u591a\u6570\u8de8\u5e73\u53f0\u95ee\u9898\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u6545\u4e8b\u548c\u79d8\u5bc6\u533a\u57df\uff0c\u4ee5\u53ca\u8fd9\u4e9b\u5956\u52b1\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u6545\u4e8b\u548c\u79d8\u5bc6\u533a\u57df\u9700\u8981\u4ed4\u7ec6\u89c2\u5bdf\u548c\u63a2\u7d22\u3002\u5bfb\u627e\u7ec6\u5fae\u7684\u7ebf\u7d22\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u5899\u58c1\u56fe\u6848\u6216\u9690\u85cf\u7684\u5f00\u5173\u3002\u4e0e\u7279\u5b9aNPC\u4e92\u52a8\u4e5f\u53ef\u4ee5\u63ed\u793a\u79d8\u5bc6\u3002\u4f8b\u5982\uff0c\u5728\u53e4\u4ee3\u9057\u8ff9\u4e2d\uff0c\u96d5\u50cf\u80cc\u540e\u7684\u4e00\u4e2a\u9690\u85cf\u5f00\u5173\u53ef\u4ee5\u6253\u5f00\u901a\u5f80\u5b9d\u85cf\u5ba4\u7684\u901a\u9053\uff0c\u91cc\u9762\u5305\u542b\u7a00\u6709\u7269\u54c1\u548c\u6545\u4e8b\u4e66\u3002\u8fd9\u4e9b\u53d1\u73b0\u4e0d\u4ec5\u4e30\u5bcc\u4e86\u6545\u4e8b\uff0c\u8fd8\u63d0\u4f9b\u4e86\u6709\u4ef7\u503c\u7684\u5956\u52b1\uff0c\u4ece\u800c\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u300a\u65d7\u5e1c\u300b\u4e2d\u7684\u7269\u54c1\u680f\u7a7a\u95f4\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u957f\u671f\u6e38\u620f\uff1f", "answer": "\u5728\u300a\u65d7\u5e1c\u300b\u4e2d\u7ba1\u7406\u7269\u54c1\u680f\u7a7a\u95f4\u5bf9\u4e8e\u957f\u671f\u6e38\u620f\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41 - \u4f18\u5148\u8003\u8651\u91cd\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u6cbb\u7597\u836f\u6c34\u548c\u5f39\u836f\u3002 \u6b65\u9aa42 - \u5b9a\u671f\u51fa\u552e\u6216\u4e22\u5f03\u4f4e\u4ef7\u503c\u7269\u54c1\uff0c\u817e\u51fa\u7a7a\u95f4\u3002 \u6b65\u9aa43 - \u5229\u7528\u5b89\u5168\u533a\u57df\u7684\u50a8\u85cf\u7bb1\u6765\u5b58\u653e\u7a00\u6709\u6216\u7279\u5b9a\u60c5\u51b5\u4e0b\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u57ce\u9547\u4e2d\u5fc3\uff0c\u4f60\u53ef\u4ee5\u5c06\u989d\u5916\u7684\u5236\u4f5c\u6750\u6599\u50a8\u5b58\u5728\u7bb1\u5b50\u4e2d\u4ee5\u5907\u540e\u7528\u3002\u6709\u6548\u7684\u7269\u54c1\u680f\u7ba1\u7406\u53ef\u4ee5\u786e\u4fdd\u4f60\u968f\u65f6\u505a\u597d\u51c6\u5907\uff0c\u800c\u4e0d\u4f1a\u88ab\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\u538b\u57ae\u3002"}]
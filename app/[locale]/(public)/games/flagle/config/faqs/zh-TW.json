[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u4e86\u89e3 Flagle \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1 Flagle \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u79fb\u52d5\u9375 (WASD) \u548c\u8df3\u8e8d\u9375 (\u7a7a\u683c\u9375)\u3002\u6b65\u9a5f2 - \u5b78\u7fd2\u5982\u4f55\u4f7f\u7528\u300eE\u300f\u9375\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u6b65\u9a5f3 - \u7df4\u7fd2\u4f7f\u7528\u6ed1\u9f20\u9032\u884c\u89c0\u770b\u548c\u7784\u6e96\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u95dc\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u8df3\u904e\u969c\u7919\u7269\u4e26\u8207\u69d3\u687f\u4e92\u52d5\u4ee5\u958b\u555f\u9580\u3002\u900f\u904e\u5be6\u969b\u64cd\u4f5c\uff0c\u60a8\u5c07\u80fd\u719f\u6089\u9019\u4e9b\u63a7\u5236\u9805\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728 Flagle \u4e2d\u7ba1\u7406\u9ad4\u529b\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\uff1f", "answer": "\u5728 Flagle \u4e2d\u7ba1\u7406\u9ad4\u529b\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u60a8\u57f7\u884c\u8dd1\u6b65\u3001\u8df3\u8e8d\u548c\u653b\u64ca\u7b49\u52d5\u4f5c\u7684\u80fd\u529b\u3002\u8981\u6709\u6548\u5730\u7ba1\u7406\u9ad4\u529b\uff1a\u6b65\u9a5f1 - \u6ce8\u610f\u87a2\u5e55\u5e95\u90e8\u986f\u793a\u7684\u9ad4\u529b\u689d\u3002\u6b65\u9a5f2 - \u907f\u514d\u6301\u7e8c\u5954\u8dd1\uff1b\u6539\u7528\u77ed\u6642\u9593\u7684\u885d\u523a\u4f86\u7bc0\u7d04\u9ad4\u529b\u3002\u6b65\u9a5f3 - \u5229\u7528\u6062\u5fa9\u9ad4\u529b\u7684\u4f11\u606f\u5730\u9ede\u6216\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u68ee\u6797\u95dc\u5361\uff0c\u60a8\u53ef\u4ee5\u627e\u5230\u88dc\u5145\u9ad4\u529b\u7684\u6f3f\u679c\u3002\u9069\u7576\u5730\u7ba1\u7406\u9ad4\u529b\uff0c\u78ba\u4fdd\u60a8\u5728\u95dc\u9375\u6642\u523b\u96a8\u6642\u6e96\u5099\u597d\u3002"}, {"question": "Flagle \u4e2d\u5404\u7a2e\u6b66\u5668\u985e\u578b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f\u65b0\u624b\u61c9\u8a72\u5f9e\u54ea\u7a2e\u6b66\u5668\u958b\u59cb\uff1f", "answer": "Flagle \u63d0\u4f9b\u5e7e\u7a2e\u6b66\u5668\u985e\u578b\uff0c\u6bcf\u7a2e\u6b66\u5668\u90fd\u5177\u6709\u7368\u7279\u7684\u5c6c\u6027\u3002\u528d\u5728\u901f\u5ea6\u548c\u50b7\u5bb3\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\uff0c\u975e\u5e38\u9069\u5408\u65b0\u624b\u4f7f\u7528\u3002\u5f13\u63d0\u4f9b\u9060\u7a0b\u653b\u64ca\uff0c\u4f46\u9700\u8981\u6e96\u78ba\u5ea6\u3002\u65a7\u982d\u9020\u6210\u9ad8\u50b7\u5bb3\uff0c\u4f46\u901f\u5ea6\u8f03\u6162\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u5efa\u8b70\u5f9e\u528d\u958b\u59cb\uff0c\u56e0\u70ba\u5b83\u5177\u6709\u591a\u529f\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u904a\u6232\u521d\u671f\u9435\u528d\u80fd\u6709\u6548\u5c0d\u4ed8\u591a\u7a2e\u6575\u4eba\u985e\u578b\u3002\u96a8\u8457\u7d93\u9a57\u7684\u7d2f\u7a4d\uff0c\u60a8\u53ef\u4ee5\u5617\u8a66\u5176\u4ed6\u6b66\u5668\u4f86\u914d\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u3002"}, {"question": "\u9ad8\u968e\u73a9\u5bb6\u5982\u4f55\u5728 Flagle \u4e2d\u6700\u4f73\u5316\u6280\u80fd\u65cb\u8f49\u4ee5\u6700\u5927\u5316\u50b7\u5bb3\u8f38\u51fa\uff1f", "answer": "\u9ad8\u968e\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u6b65\u9a5f\u6700\u4f73\u5316\u6280\u80fd\u65cb\u8f49\uff1a\u6b65\u9a5f1 - \u8fa8\u5225\u89d2\u8272\u6700\u5f37\u5927\u7684\u6280\u80fd\u53ca\u5176\u51b7\u537b\u6642\u9593\u3002\u6b65\u9a5f2 - \u9023\u63a5\u4e92\u88dc\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u5148\u6688\u7729\u518d\u9032\u884c\u9ad8\u50b7\u5bb3\u653b\u64ca\u3002\u6b65\u9a5f3 - \u7df4\u7fd2\u8a08\u6642\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u6280\u80fd\u4e4b\u9593\u7684\u7a7a\u6a94\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728 Boss \u6230\u4e2d\uff0c\u4f7f\u7528\u300c\u6688\u7729\u7a81\u64ca\u300d\u63a5\u8457\u300c\u5f37\u529b\u65ac\u64ca\u300d\u53ef\u4ee5\u6700\u5927\u5316\u50b7\u5bb3\u4e26\u63a7\u5236 Boss\u3002\u6301\u7e8c\u7684\u7df4\u7fd2\u548c\u719f\u7df4\u638c\u63e1\u6280\u80fd\u662f\u638c\u63e1\u6b64\u7b56\u7565\u7684\u95dc\u9375\u3002"}, {"question": "Flagle \u4e2d\u54ea\u4e9b\u74b0\u5883\u56e0\u7d20\u53ef\u7528\u65bc\u5728\u6230\u9b25\u4e2d\u7372\u5f97\u6230\u8853\u512a\u52e2\uff1f", "answer": "Flagle \u4e2d\u6709\u5e7e\u500b\u74b0\u5883\u56e0\u7d20\u53ef\u7528\u65bc\u6230\u8853\u512a\u52e2\uff1a\u9ad8\u8655\u80fd\u63d0\u4f9b\u66f4\u597d\u7684\u8996\u91ce\u548c\u9060\u7a0b\u653b\u64ca\u6a5f\u6703\u3002\u72f9\u7a84\u7684\u901a\u9053\u53ef\u4ee5\u5c07\u6575\u4eba\u5f15\u5c0e\u5230\u4e00\u500b\u5340\u57df\uff0c\u8b93\u4ed6\u5011\u66f4\u5bb9\u6613\u88ab\u63a7\u5236\u3002\u70b8\u85e5\u6876\u53ef\u4ee5\u5f15\u7206\u4ee5\u9020\u6210\u5340\u57df\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u6d1e\u7a74\u95dc\u5361\u4e2d\uff0c\u7ad9\u5728\u61f8\u5d16\u908a\u53ef\u4ee5\u8b93\u60a8\u4f7f\u7528\u5f13\u7bad\u5c04\u64ca\u6575\u4eba\uff0c\u540c\u6642\u4fdd\u6301\u8ddd\u96e2\u3002\u77e5\u9053\u4e26\u5229\u7528\u9019\u4e9b\u5143\u7d20\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u6230\u9b25\u6548\u7387\u3002"}, {"question": "Flagle \u4e2d\u665d\u591c\u5faa\u74b0\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Flagle \u4e2d\u7684\u665d\u591c\u5faa\u74b0\u4ee5\u5404\u7a2e\u65b9\u5f0f\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u767d\u5929\uff0c\u8996\u91ce\u826f\u597d\uff0c\u6575\u4eba\u8f03\u4e0d\u5177\u6709\u4fb5\u7565\u6027\u3002\u665a\u4e0a\uff0c\u8996\u91ce\u4e0b\u964d\uff0c\u6575\u4eba\u8b8a\u5f97\u66f4\u52a0\u5371\u96aa\u3002\u67d0\u4e9b\u4efb\u52d9\u548c\u4e8b\u4ef6\u4e5f\u8207\u6642\u9593\u76f8\u95dc\u3002\u4f8b\u5982\uff0c\u300c\u6708\u5149\u5100\u5f0f\u300d\u4efb\u52d9\u53ea\u80fd\u5728\u665a\u4e0a\u5b8c\u6210\u3002\u73a9\u5bb6\u61c9\u8a72\u6839\u64da\u60c5\u6cc1\u5b89\u6392\u6d3b\u52d5\uff0c\u767d\u5929\u7528\u65bc\u63a2\u7d22\u548c\u8cc7\u6e90\u6536\u96c6\uff0c\u4e26\u70ba\u591c\u665a\u66f4\u5177\u6311\u6230\u6027\u7684\u906d\u9047\u505a\u597d\u6e96\u5099\u3002"}, {"question": "Flagle \u4e2d\u7684\u9632\u79a6\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u9078\u64c7\u6b63\u78ba\u9632\u79a6\u88dd\u5099\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "Flagle \u7684\u9632\u79a6\u7cfb\u7d71\u57fa\u65bc\u9632\u79a6\u8a55\u5206\u548c\u7279\u6b8a\u5c6c\u6027\u3002\u91cd\u88dd\u7532\u63d0\u4f9b\u9ad8\u9632\u79a6\uff0c\u4f46\u6703\u964d\u4f4e\u884c\u52d5\u901f\u5ea6\uff0c\u800c\u8f15\u88dd\u7532\u5247\u63d0\u4f9b\u8f03\u4f4e\u7684\u9632\u79a6\uff0c\u4f46\u63d0\u9ad8\u9748\u6d3b\u6027\u3002\u6839\u64da\u60a8\u7684\u904a\u6232\u98a8\u683c\u548c\u9762\u5c0d\u7684\u6575\u4eba\u985e\u578b\u9078\u64c7\u88dd\u7532\u3002\u4f8b\u5982\uff0c\u5728\u5c0d\u6297\u5feb\u901f\u79fb\u52d5\u7684\u6575\u4eba\u6642\uff0c\u8f15\u88dd\u7532\uff0c\u4f8b\u5982\u300c\u76ae\u9769\u88dd\u5099\u300d\uff0c\u66f4\u53ef\u53d6\u3002\u59cb\u7d42\u8003\u616e\u9632\u79a6\u548c\u884c\u52d5\u901f\u5ea6\u4e4b\u9593\u7684\u5e73\u8861\uff0c\u4ee5\u6700\u4f73\u5316\u60a8\u5728\u4e0d\u540c\u5834\u666f\u4e0b\u7684\u8868\u73fe\u3002"}, {"question": "Flagle \u4e2d\u8de8\u5e73\u53f0\u904a\u6232\u7684\u6311\u6230\u548c\u597d\u8655\u662f\u4ec0\u9ebc\uff1f\u73a9\u5bb6\u5982\u4f55\u78ba\u4fdd\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Flagle \u4e2d\u7684\u8de8\u5e73\u53f0\u904a\u6232\u5141\u8a31\u4e0d\u540c\u88dd\u7f6e\u7684\u73a9\u5bb6\u4e00\u8d77\u904a\u6232\uff0c\u589e\u9032\u793e\u7fa4\u9ad4\u9a57\u3002\u7136\u800c\uff0c\u5b83\u53ef\u80fd\u5e36\u4f86\u5404\u7a2e\u6311\u6230\uff0c\u4f8b\u5982\u4e0d\u540c\u7684\u63a7\u5236\u65b9\u5f0f\u548c\u8868\u73fe\u554f\u984c\u3002\u8981\u78ba\u4fdd\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u66f4\u65b0\u81f3\u6700\u65b0\u7248\u672c\u3002\u6b65\u9a5f2 - \u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u5207\u63db\u6642\uff0c\u4f7f\u7528\u76f8\u5bb9\u7684\u5916\u570d\u88dd\u7f6e\u3002\u6b65\u9a5f3 - \u8abf\u6574\u8a2d\u5b9a\u4ee5\u6700\u4f73\u5316\u60a8\u88dd\u7f6e\u4e0a\u7684\u904a\u6232\u6548\u80fd\u3002\u4f8b\u5982\uff0cPC \u73a9\u5bb6\u5728\u8207\u4e3b\u6a5f\u73a9\u5bb6\u4e00\u8d77\u904a\u6232\u6642\uff0c\u53ef\u80fd\u9700\u8981\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\u3002\u9069\u7576\u7684\u8a2d\u5b9a\u548c\u6e9d\u901a\u53ef\u4ee5\u6e1b\u8f15\u5927\u591a\u6578\u8de8\u5e73\u53f0\u554f\u984c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Flagle \u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u548c\u79d8\u5bc6\u5340\u57df\uff0c\u4ee5\u53ca\u5b83\u5011\u6709\u4ec0\u9ebc\u734e\u52f5\uff1f", "answer": "\u5728Flagle\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u548c\u79d8\u5bc6\u5340\u57df\u9700\u8981\u4ed4\u7d30\u89c0\u5bdf\u548c\u63a2\u7d22\u3002\u5c0b\u627e\u50cf\u4e0d\u5c0b\u5e38\u7684\u7246\u58c1\u5716\u6848\u6216\u96b1\u85cf\u7684\u958b\u95dc\u4e4b\u985e\u7684\u7d30\u5fae\u7dda\u7d22\u3002\u8207\u7279\u5b9a NPC \u4e92\u52d5\u4e5f\u80fd\u63ed\u793a\u79d8\u5bc6\u3002\u4f8b\u5982\uff0c\u5728\u53e4\u4ee3\u907a\u8e5f\u4e2d\uff0c\u96d5\u50cf\u5f8c\u9762\u96b1\u85cf\u7684\u958b\u95dc\u6703\u6253\u958b\u901a\u5f80\u5bf6\u85cf\u623f\u9593\u7684\u901a\u9053\uff0c\u5176\u4e2d\u5305\u542b\u7a00\u6709\u7269\u54c1\u548c\u80cc\u666f\u6545\u4e8b\u66f8\u7c4d\u3002\u9019\u4e9b\u767c\u73fe\u4e0d\u50c5\u8c50\u5bcc\u4e86\u6545\u4e8b\uff0c\u9084\u63d0\u4f9b\u6709\u50f9\u503c\u7684\u734e\u52f5\uff0c\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728 Flagle \u4e2d\uff0c\u7279\u5225\u662f\u5728\u9577\u671f\u904a\u6232\u4e2d\uff0c\u6700\u4f73\u7684\u7269\u54c1\u6b04\u4f4d\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Flagle\u4e2d\uff0c\u9577\u671f\u904a\u6232\u9700\u8981\u6709\u6548\u7684\u7269\u54c1\u6b04\u4f4d\u7ba1\u7406\u3002\u6b65\u9a5f1 - \u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u6cbb\u7642\u85e5\u6c34\u548c\u5f48\u85e5\u3002\u6b65\u9a5f2 - \u5b9a\u671f\u51fa\u552e\u6216\u4e1f\u68c4\u4f4e\u50f9\u503c\u7269\u54c1\u4ee5\u9a30\u51fa\u7a7a\u9593\u3002\u6b65\u9a5f3 - \u5229\u7528\u5b89\u5168\u5340\u57df\u7684\u5132\u5b58\u7bb1\u5b58\u653e\u7a00\u6709\u6216\u7279\u5b9a\u60c5\u6cc1\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u57ce\u93ae\u4e2d\u5fc3\uff0c\u60a8\u53ef\u4ee5\u5c07\u984d\u5916\u7684\u5de5\u85dd\u6750\u6599\u5b58\u653e\u5728\u7bb1\u5b50\u4e2d\u4ee5\u5099\u5f8c\u7528\u3002\u6709\u6548\u7684\u7269\u54c1\u6b04\u4f4d\u7ba1\u7406\uff0c\u78ba\u4fdd\u60a8\u59cb\u7d42\u6e96\u5099\u5c31\u7dd2\uff0c\u4e0d\u6703\u56e0\u70ba\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\u800c\u8ca0\u64d4\u6c89\u91cd\u3002"}]
[{"question": "\u30d5\u30e9\u30b0\u30eb\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7406\u89e3\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u3068\u30b8\u30e3\u30f3\u30d7\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\uff09\u3092\u899a\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a \"E\"\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3057\u3066\u5468\u56f2\u3092\u898b\u56de\u3057\u3001\u76ee\u6a19\u3092\u5b9a\u3081\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u98db\u3073\u8d8a\u3048\u3001\u30ec\u30d0\u30fc\u3068\u5bfe\u8a71\u3057\u3066\u6249\u3092\u958b\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u5b9f\u8df5\u7684\u306a\u7df4\u7fd2\u306b\u3088\u308a\u3001\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u3067\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u52b9\u679c\u7684\u306b\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u3067\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u8d70\u308b\u3001\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3001\u653b\u6483\u3059\u308b\u3068\u3044\u3063\u305f\u884c\u52d5\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u753b\u9762\u4e0b\u90e8\u306b\u8868\u793a\u3055\u308c\u3066\u3044\u308b\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9023\u7d9a\u3057\u3066\u8d70\u308a\u7d9a\u3051\u308b\u306e\u3092\u907f\u3051\u3001\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3059\u308b\u305f\u3081\u306b\u77ed\u3044\u30d0\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f11\u61a9\u5834\u6240\u307e\u305f\u306f\u30b9\u30bf\u30df\u30ca\u3092\u56de\u5fa9\u3055\u305b\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u68ee\u6797\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b9\u30bf\u30df\u30ca\u3092\u56de\u5fa9\u3055\u305b\u308b\u30d9\u30ea\u30fc\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u9069\u5207\u306a\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u306b\u3088\u308a\u3001\u91cd\u8981\u306a\u5c40\u9762\u3067\u3044\u3064\u3067\u3082\u6e96\u5099\u304c\u6574\u3044\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u306e\u5404\u7a2e\u6b66\u5668\u30bf\u30a4\u30d7\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u521d\u5fc3\u8005\u306b\u304a\u3059\u3059\u3081\u306e\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306b\u306f\u3001\u305d\u308c\u305e\u308c\u72ec\u81ea\u306e\u7279\u6027\u3092\u6301\u3064\u69d8\u3005\u306a\u6b66\u5668\u304c\u3042\u308a\u307e\u3059\u3002\u5263\u306f\u901f\u5ea6\u3068\u30c0\u30e1\u30fc\u30b8\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u308c\u3066\u304a\u308a\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u7406\u60f3\u7684\u3067\u3059\u3002\u5f13\u306f\u5c04\u7a0b\u653b\u6483\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u6b63\u78ba\u6027\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u65a7\u306f\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u304c\u3001\u901f\u5ea6\u304c\u9045\u3044\u3067\u3059\u3002\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u4e07\u80fd\u6027\u304b\u3089\u5263\u3092\u59cb\u3081\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u306e\u30b2\u30fc\u30e0\u306b\u3042\u308b\u9244\u5263\u306f\u3001\u8907\u6570\u306e\u6575\u306e\u7a2e\u985e\u3092\u52b9\u679c\u7684\u306b\u51e6\u7406\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7d4c\u9a13\u3092\u7a4d\u3080\u306b\u3064\u308c\u3066\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u6b66\u5668\u3092\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d5\u30e9\u30b0\u30eb\u3067\u6700\u5927\u9650\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u3001\u30b9\u30ad\u30eb\u56de\u8ee2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u5f93\u3063\u3066\u3001\u30b9\u30ad\u30eb\u56de\u8ee2\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6700\u3082\u5f37\u529b\u306a\u30b9\u30ad\u30eb\u3068\u305d\u306e\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30bf\u30f3\u3068\u9ad8\u30c0\u30e1\u30fc\u30b8\u653b\u6483\u306e\u3088\u3046\u306a\u4e92\u3044\u3092\u88dc\u5b8c\u3059\u308b\u30b9\u30ad\u30eb\u3092\u9023\u9396\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30ad\u30eb\u9593\u306e\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30b9\u6226\u3067\u306f\u3001\u300c\u30b9\u30bf\u30f3\u30b9\u30c8\u30e9\u30a4\u30af\u300d\u306e\u5f8c\u306b\u300c\u30d1\u30ef\u30fc\u30b9\u30e9\u30c3\u30b7\u30e5\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30dc\u30b9\u3092\u62d8\u675f\u3057\u305f\u307e\u307e\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30ad\u30eb\u306b\u6163\u308c\u3066\u3001\u7d99\u7d9a\u7684\u306b\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3001\u3053\u306e\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u9375\u3067\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u306e\u74b0\u5883\u8981\u56e0\u306e\u4e2d\u3067\u3001\u6226\u95d8\u4e2d\u306b\u6226\u8853\u7684\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u6d3b\u7528\u3067\u304d\u308b\u3082\u306e\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306e\u3044\u304f\u3064\u304b\u306e\u74b0\u5883\u8981\u56e0\u306f\u3001\u6226\u8853\u7684\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u6d3b\u7528\u3067\u304d\u307e\u3059\u3002\u9ad8\u5730\u306f\u3088\u308a\u826f\u3044\u8996\u754c\u3068\u5c04\u7a0b\u653b\u6483\u306e\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u72ed\u3044\u901a\u8def\u306f\u6575\u3092\u8a98\u5c0e\u3057\u3001\u7ba1\u7406\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\u7206\u767a\u6027\u306e\u6a3d\u306f\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u3066\u3001\u7bc4\u56f2\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6d1e\u7a9f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5d16\u306e\u4e0a\u306b\u7acb\u3064\u3053\u3068\u3067\u3001\u5f13\u3067\u6575\u3092\u5c04\u6483\u3057\u3001\u6575\u306e\u653b\u6483\u7bc4\u56f2\u306e\u5916\u306b\u7559\u307e\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u8a8d\u8b58\u3057\u3001\u6d3b\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u95d8\u80fd\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u306b\u304a\u3051\u308b\u663c\u591c\u306e\u30b5\u30a4\u30af\u30eb\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306b\u304a\u3051\u308b\u663c\u591c\u306e\u30b5\u30a4\u30af\u30eb\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u69d8\u3005\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u663c\u9593\u306f\u8996\u754c\u304c\u826f\u304f\u3001\u6575\u306e\u653b\u6483\u6027\u3082\u4f4e\u304f\u306a\u308a\u307e\u3059\u3002\u591c\u9593\u306f\u8996\u754c\u304c\u60aa\u304f\u306a\u308a\u3001\u6575\u306f\u3088\u308a\u5371\u967a\u306b\u306a\u308a\u307e\u3059\u3002\u4e00\u90e8\u306e\u30af\u30a8\u30b9\u30c8\u3084\u30a4\u30d9\u30f3\u30c8\u3082\u6642\u9593\u9650\u5b9a\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6708\u591c\u306e\u5100\u5f0f\u300d\u30af\u30a8\u30b9\u30c8\u306f\u3001\u591c\u3057\u304b\u5b8c\u4e86\u3067\u304d\u307e\u305b\u3093\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u63a2\u691c\u3068\u8cc7\u6e90\u53ce\u96c6\u306b\u663c\u3092\u4f7f\u7528\u3057\u3001\u591c\u306b\u3088\u308a\u56f0\u96e3\u306a\u906d\u9047\u306b\u5099\u3048\u308b\u306a\u3069\u3001\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u8a08\u753b\u3092\u7acb\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u306e\u88c5\u5099\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u9069\u5207\u306a\u88c5\u5099\u3092\u9078\u3076\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306e\u88c5\u5099\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9632\u5fa1\u529b\u3068\u7279\u5225\u306a\u5c5e\u6027\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u91cd\u88c5\u5099\u306f\u9ad8\u3044\u9632\u5fa1\u529b\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u6a5f\u52d5\u529b\u3082\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u4e00\u65b9\u3001\u8efd\u88c5\u5099\u306f\u9632\u5fa1\u529b\u306f\u4f4e\u304f\u306a\u308a\u307e\u3059\u304c\u3001\u6a5f\u654f\u6027\u306f\u9ad8\u307e\u308a\u307e\u3059\u3002\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u76f4\u9762\u3059\u308b\u6575\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u3001\u88c5\u5099\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u7d20\u65e9\u304f\u52d5\u304f\u6575\u3068\u6226\u3046\u5834\u5408\u306f\u3001\u300c\u9769\u88fd\u30bb\u30c3\u30c8\u300d\u306e\u3088\u3046\u306a\u8efd\u88c5\u5099\u304c\u597d\u307e\u3057\u3044\u3067\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u72b6\u6cc1\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5e38\u306b\u4fdd\u8b77\u3068\u6a5f\u52d5\u529b\u306e\u9593\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u306b\u304a\u3051\u308b\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u8ab2\u984c\u3068\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u65b9\u6cd5\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u4f53\u9a13\u3092\u4fdd\u8a3c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u306b\u304a\u3051\u308b\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3088\u308a\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e00\u7dd2\u306b\u30d7\u30ec\u30a4\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u4f53\u9a13\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u69d8\u3005\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3084\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u554f\u984c\u306a\u3069\u3001\u8ab2\u984c\u3082\u3042\u308a\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306a\u4f53\u9a13\u3092\u4fdd\u8a3c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001\u4e92\u63db\u6027\u306e\u3042\u308b\u5468\u8fba\u6a5f\u5668\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c7\u30d0\u30a4\u30b9\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u30e6\u30fc\u30b6\u30fc\u3068\u30d7\u30ec\u30a4\u3059\u308b\u3068\u304d\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u9069\u5207\u306a\u8a2d\u5b9a\u3068\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u306b\u3088\u308a\u3001\u307b\u3068\u3093\u3069\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u554f\u984c\u3092\u8efd\u6e1b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u3067\u96a0\u3055\u308c\u305f\u30ed\u30a2\u3084\u79d8\u5bc6\u30a8\u30ea\u30a2\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u3067\u96a0\u3055\u308c\u305f\u30ed\u30a2\u3084\u79d8\u5bc6\u30a8\u30ea\u30a2\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u89b3\u5bdf\u529b\u3068\u63a2\u6c42\u5fc3\u304c\u5fc5\u8981\u3067\u3059\u3002\u73cd\u3057\u3044\u58c1\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u306a\u3069\u306e\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7279\u5b9a\u306eNPC\u3068\u5bfe\u8a71\u3059\u308b\u3053\u3068\u3082\u3001\u79d8\u5bc6\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u53e4\u4ee3\u907a\u8de1\u3067\u306f\u3001\u50cf\u306e\u5f8c\u308d\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u306b\u3088\u308a\u3001\u8cb4\u91cd\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u30ed\u30a2\u672c\u304c\u8a70\u307e\u3063\u305f\u5b9d\u7bb1\u3078\u306e\u901a\u8def\u304c\u958b\u304b\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u306f\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u3092\u8c4a\u304b\u306b\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u8cb4\u91cd\u306a\u5831\u916c\u3082\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "\u30d5\u30e9\u30b0\u30eb\u3067\u3001\u7279\u306b\u9577\u671f\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30e9\u30b0\u30eb\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u9577\u671f\u30d7\u30ec\u30a4\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u56de\u5fa9\u85ac\u3084\u5f3e\u85ac\u306a\u3069\u306e\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5b9a\u671f\u7684\u306b\u4fa1\u5024\u306e\u4f4e\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u58f2\u5374\u307e\u305f\u306f\u5ec3\u68c4\u3057\u3066\u30b9\u30da\u30fc\u30b9\u3092\u7a7a\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5b89\u5168\u306a\u30a8\u30ea\u30a2\u306b\u3042\u308b\u4fdd\u7ba1\u5eab\u3092\u5229\u7528\u3057\u3066\u3001\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u72b6\u6cc1\u306b\u5fdc\u3058\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u4fdd\u7ba1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u753a\u306e\u4e2d\u5fc3\u90e8\u3067\u306f\u3001\u5f8c\u306e\u305f\u3081\u306b\u5fc5\u8981\u306a\u30af\u30e9\u30d5\u30c8\u6750\u6599\u3092\u4fdd\u7ba1\u5eab\u306b\u4fdd\u7ba1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u52b9\u7387\u7684\u306a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u306b\u3088\u308a\u3001\u4e0d\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306b\u8ca0\u62c5\u3055\u308c\u308b\u3053\u3068\u306a\u304f\u3001\u5e38\u306b\u6e96\u5099\u304c\u6574\u3044\u307e\u3059\u3002"}]
[{"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u65b0\u73a9\u5bb6\u53ef\u4ee5\u4ece\u4e3b\u83dc\u5355\u7684\u300e\u6559\u7a0b\u300f\u90e8\u5206\u5f00\u59cb\u3002\u8be5\u90e8\u5206\u6307\u5bfc\u73a9\u5bb6\u57fa\u672c\u64cd\u4f5c\uff0c\u4f8b\u5982\u4f7f\u7528\u53f3\u6447\u6746\u52a0\u901f\uff0c\u5de6\u6447\u6746\u5236\u52a8\uff0c\u4ee5\u53ca\u4f7f\u7528\u5de6\u6447\u6746\u64cd\u63a7\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u4e2d\uff0c\u73a9\u5bb6\u5c06\u88ab\u8981\u6c42\u5728\u8d5b\u9053\u4e0a\u5b8c\u6210\u4e00\u4e2a\u7b80\u5355\u7684\u5708\u901f\u7ec3\u4e60\u6765\u5b9e\u8df5\u8fd9\u4e9b\u64cd\u4f5c\u3002\u6b64\u5916\uff0c\u73a9\u5bb6\u8fd8\u53ef\u4ee5\u8bbf\u95ee\u300e\u63a7\u5236\u8bbe\u7f6e\u300f\u4ee5\u81ea\u5b9a\u4e49\u6309\u952e\u5e03\u5c40\uff0c\u83b7\u5f97\u66f4\u8212\u9002\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u8d85\u8d8a\u5bf9\u624b\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u8d85\u8d8a\u5bf9\u624b\u9700\u8981\u6280\u5de7\u548c\u7b56\u7565\u76f8\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u300e\u8ddf\u968f\u300f\u6280\u5de7\uff0c\u7d27\u8ddf\u5bf9\u624b\u8eab\u540e\uff0c\u51cf\u5c11\u7a7a\u6c14\u963b\u529b\uff0c\u83b7\u5f97\u901f\u5ea6\u63d0\u5347\u3002\u6b65\u9aa4\u4e8c\uff1a\u5bfb\u627e\u76f4\u9053\u6216\u5bbd\u9614\u5f2f\u9053\uff0c\u5b89\u5168\u5730\u8d85\u8d8a\u5bf9\u624b\u3002\u6b65\u9aa4\u4e09\uff1a\u6218\u7565\u6027\u5730\u5229\u7528\u300e\u52a0\u901f\u300f\u529f\u80fd\uff0c\u5c06\u5176\u7559\u5f85\u5173\u952e\u65f6\u523b\uff0c\u6bd4\u5982\u6700\u540e\u4e00\u5708\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u51b2\u523a\u300f\u8d5b\u9053\u4e0a\uff0c\u5728\u957f\u76f4\u9053\u4e0a\u8ddf\u968f\u9886\u5148\u7684\u6469\u6258\u8f66\uff0c\u53ef\u4ee5\u5728\u51b2\u523a\u7ebf\u524d\u5b8c\u6210\u4e00\u6b21\u6210\u529f\u7684\u8d85\u8d8a\u3002"}, {"question": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u6469\u6258\u8f66\u5b9a\u5236\u5f88\u91cd\u8981\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u90e8\u4ef6\uff1f", "answer": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u6469\u6258\u8f66\u5b9a\u5236\u4f1a\u663e\u8457\u5f71\u54cd\u6027\u80fd\uff0c\u63d0\u5347\u901f\u5ea6\u3001\u64cd\u63a7\u6027\u548c\u8010\u4e45\u6027\u3002\u4f18\u5148\u5347\u7ea7\u300e\u5f15\u64ce\u300f\u4ee5\u63d0\u9ad8\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\uff0c\u5176\u6b21\u662f\u300e\u8f6e\u80ce\u300f\u4ee5\u589e\u5f3a\u6293\u5730\u529b\u53ca\u8fc7\u5f2f\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u5c06\u300e\u96f7\u9706\u300f\u6469\u6258\u8f66\u7684\u5f15\u64ce\u5347\u7ea7\u52303\u7ea7\uff0c\u53ef\u4ee5\u5728\u300e\u57ce\u5e02\u8d5b\u9053\u300f\u8d5b\u9053\u4e0a\u5c06\u5708\u901f\u7f29\u77ed\u81f32\u79d2\u4ee5\u5185\u3002\u6b64\u5916\uff0c\u8fd8\u5e94\u8be5\u8003\u8651\u5347\u7ea7\u300e\u60ac\u6302\u7cfb\u7edf\u300f\u4ee5\u5728\u5d0e\u5c96\u5730\u5f62\u4e0a\u83b7\u5f97\u66f4\u5e73\u7a33\u7684\u9a91\u884c\u4f53\u9a8c\uff0c\u907f\u514d\u56e0\u98a0\u7c38\u800c\u635f\u5931\u901f\u5ea6\u3002"}, {"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u73a9\u5bb6\u5e94\u8be5\u5982\u4f55\u9002\u5e94\uff1f", "answer": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u4f1a\u52a8\u6001\u5f71\u54cd\u8d5b\u9053\u72b6\u51b5\uff0c\u8981\u6c42\u73a9\u5bb6\u8c03\u6574\u7b56\u7565\u3002\u96e8\u5929\u4f1a\u964d\u4f4e\u8f6e\u80ce\u6293\u5730\u529b\uff0c\u4f7f\u5f2f\u9053\u66f4\u52a0\u6e7f\u6ed1\uff1b\u96fe\u5929\u4f1a\u964d\u4f4e\u80fd\u89c1\u5ea6\u3002\u4e3a\u4e86\u9002\u5e94\uff0c\u4e0b\u96e8\u65f6\u5207\u6362\u81f3\u300e\u96e8\u80ce\u300f\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7275\u5f15\u529b\uff0c\u5728\u96fe\u5929\u964d\u4f4e\u901f\u5ea6\u4ee5\u907f\u514d\u78b0\u649e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c71\u8def\u300f\u8d5b\u9053\u4e0b\u96e8\u65f6\uff0c\u4f7f\u7528\u96e8\u80ce\u53ef\u4ee5\u5e2e\u52a9\u5728\u6025\u5f2f\u4e2d\u4fdd\u6301\u63a7\u5236\uff0c\u9632\u6b62\u56e0\u6253\u6ed1\u800c\u635f\u5931\u5b9d\u8d35\u65f6\u95f4\u3002"}, {"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u300e\u8857\u673a\u300f\u6a21\u5f0f\u548c\u300e\u6a21\u62df\u300f\u6a21\u5f0f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u300e\u8857\u673a\u300f\u6a21\u5f0f\u548c\u300e\u6a21\u62df\u300f\u6a21\u5f0f\u8fce\u5408\u4e0d\u540c\u7684\u73a9\u5bb6\u559c\u597d\u3002\u300e\u8857\u673a\u300f\u6a21\u5f0f\u6ce8\u91cd\u5feb\u901f\u3001\u6613\u4e8e\u4e0a\u624b\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u7269\u7406\u5f15\u64ce\u7b80\u5316\uff0c\u64cd\u4f5c\u5bbd\u5bb9\uff0c\u9002\u5408\u4f11\u95f2\u73a9\u5bb6\u3002\u300e\u6a21\u62df\u300f\u6a21\u5f0f\u5219\u63d0\u4f9b\u66f4\u771f\u5b9e\u7684\u4f53\u9a8c\uff0c\u62e5\u6709\u9ad8\u7ea7\u7269\u7406\u5f15\u64ce\uff0c\u8f6e\u80ce\u78e8\u635f\u548c\u71c3\u6cb9\u7ba1\u7406\uff0c\u9002\u5408\u6838\u5fc3\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u8857\u673a\u300f\u6a21\u5f0f\u4e2d\uff0c\u53ef\u4ee5\u6267\u884c\u6025\u8f6c\u5f2f\u64cd\u4f5c\u800c\u4e0d\u4f1a\u635f\u5931\u592a\u591a\u901f\u5ea6\uff0c\u800c\u5728\u300e\u6a21\u62df\u300f\u6a21\u5f0f\u4e2d\uff0c\u6b64\u7c7b\u64cd\u4f5c\u53ef\u80fd\u5bfc\u81f4\u6253\u6ed1\u6216\u78b0\u649e\u3002"}, {"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u54ea\u4e9b\u8d5b\u9053\u6700\u9002\u5408\u65b0\u624b\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u7684\u65b0\u624b\u73a9\u5bb6\u5e94\u8be5\u4ece\u300e\u7eff\u8c37\u300f\u548c\u300e\u65e5\u843d\u5927\u9053\u300f\u7b49\u8d5b\u9053\u5f00\u59cb\uff0c\u56e0\u4e3a\u5176\u5e03\u5c40\u7b80\u5355\uff0c\u5371\u9669\u56e0\u7d20\u8f83\u5c11\u3002\u7eff\u8c37\u8d5b\u9053\u5f2f\u9053\u5bbd\u9614\uff0c\u8def\u9762\u5e73\u6ed1\uff0c\u66f4\u6613\u4e8e\u7ec3\u4e60\u5f2f\u9053\u548c\u52a0\u901f\u3002\u65e5\u843d\u5927\u9053\u8d5b\u9053\u62e5\u6709\u957f\u76f4\u9053\uff0c\u8ba9\u73a9\u5bb6\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u638c\u63e1\u901f\u5ea6\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7eff\u8c37\u8d5b\u9053\u4e0a\u5b8c\u6210\u5e72\u51c0\u7684\u5708\u901f\u53ef\u4ee5\u5e2e\u52a9\u65b0\u624b\u5728\u6311\u6218\u66f4\u590d\u6742\u7684\u8d5b\u9053\uff0c\u4f8b\u5982\u300e\u51b0\u5cf0\u300f\u6216\u300e\u57ce\u5e02\u4e1b\u6797\u300f\u4e4b\u524d\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u5c06\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u4e3a\u4e86\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u8de8\u5e73\u53f0\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u73a9\u5bb6\u9700\u8981\u5c06\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u8d44\u6599\uff0c\u4f8b\u5982Google Play\u6216Apple ID\u3002\u4e00\u65e6\u94fe\u63a5\uff0c\u8fdb\u5ea6\uff0c\u5305\u62ec\u89e3\u9501\u7684\u6469\u6258\u8f66\u548c\u6210\u5c31\uff0c\u4f1a\u5728\u767b\u5f55\u65b0\u8bbe\u5907\u65f6\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4eceiOS\u8bbe\u5907\u5207\u6362\u5230Android\u624b\u673a\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684Apple ID\u767b\u5f55\u5373\u53ef\u8bbf\u95ee\u4f60\u7684\u4fdd\u5b58\u6570\u636e\u3002\u786e\u4fdd\u4e24\u4e2a\u8bbe\u5907\u90fd\u66f4\u65b0\u5230\u6700\u65b0\u7684\u6e38\u620f\u7248\u672c\u4ee5\u907f\u514d\u517c\u5bb9\u6027\u95ee\u9898\u3002"}, {"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u9690\u85cf\u6311\u6218\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u8bbe\u6709\u9690\u85cf\u6311\u6218\uff0c\u8fd9\u4e9b\u6311\u6218\u4f1a\u5956\u52b1\u73a9\u5bb6\u72ec\u5bb6\u6469\u6258\u8f66\u548c\u5b9a\u5236\u9009\u9879\u3002\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\u8fd9\u4e9b\u6311\u6218\uff0c\u4f8b\u5982\u8fde\u7eed\u8d62\u5f9710\u573a\u6bd4\u8d5b\u6216\u5728\u67d0\u4e9b\u8d5b\u9053\u4e0a\u8fbe\u5230\u5b8c\u7f8e\u7684\u5708\u901f\u3002\u4f8b\u5982\uff0c\u300e\u5e7d\u7075\u9a91\u58eb\u300f\u6469\u6258\u8f66\u53ef\u4ee5\u901a\u8fc7\u5728\u300e\u5669\u68a6\u8d5b\u9053\u300f\u8d5b\u9053\u4e0a\u57282\u5206\u949f\u5185\u5b8c\u6210\u6bd4\u8d5b\u6765\u89e3\u9501\u3002\u8bf7\u5bc6\u5207\u5173\u6ce8\u300e\u6210\u5c31\u300f\u9009\u9879\u5361\uff0c\u4e86\u89e3\u8fd9\u4e9b\u9690\u85cf\u76ee\u6807\u3002"}, {"question": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u7684\u6392\u884c\u699c\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u73a9\u5bb6\u6392\u540d\uff1f", "answer": "\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u7684\u6392\u884c\u699c\u7cfb\u7edf\u57fa\u4e8e\u8d5b\u573a\u7684\u8868\u73b0\u3001\u7a33\u5b9a\u6027\u4ee5\u53ca\u6574\u4f53\u8fdb\u5ea6\u76f8\u7ed3\u5408\u3002\u56e0\u7d20\u5305\u62ec\u6700\u7ec8\u6392\u540d\u3001\u5708\u901f\u4ee5\u53ca\u8d5b\u4e8b\u7684\u96be\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u4e13\u5bb6\u300f\u96be\u5ea6\u4e0b\uff0c\u6301\u7eed\u5728\u524d\u4e09\u540d\u4e2d\u4f1a\u6bd4\u5728\u300e\u521d\u5b66\u8005\u300f\u96be\u5ea6\u8d62\u5f97\u6bd4\u8d5b\u66f4\u5feb\u5730\u63d0\u5347\u4f60\u7684\u6392\u540d\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u8bf8\u5982\u7279\u6280\u6216\u907f\u514d\u78b0\u649e\u4e4b\u7c7b\u7684\u989d\u5916\u76ee\u6807\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u79ef\u5206\u3002\u73a9\u5bb6\u53ef\u4ee5\u5728\u300e\u6392\u884c\u699c\u300f\u90e8\u5206\u8ddf\u8e2a\u4ed6\u4eec\u7684\u6392\u540d\u3002"}, {"question": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\u638c\u63e1\u6025\u5f2f\u7684\u6709\u6548\u6280\u5de7\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u8d85\u7ea7\u6469\u6258\u51a0\u519b\u4e2d\uff0c\u638c\u63e1\u6025\u5f2f\u9700\u8981\u7ed3\u5408\u5236\u52a8\u3001\u8f6c\u5411\u548c\u6cb9\u95e8\u63a7\u5236\u3002\u6b65\u9aa4\u4e00\uff1a \u901a\u8fc7\u51cf\u901f\u6cb9\u95e8\u5e76\u8f7b\u5fae\u5236\u52a8\u6765\u8fdb\u5165\u5f2f\u9053\u3002\u6b65\u9aa4\u4e8c\uff1a \u5229\u7528\u5de6\u6447\u6746\u503e\u659c\u8fdb\u5165\u5f2f\u9053\uff0c\u4fdd\u6301\u7a33\u5b9a\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u9010\u6e10\u52a0\u901f\u9a76\u51fa\u5f2f\u9053\u4ee5\u6062\u590d\u901f\u5ea6\u3002 \u4f8b\u5982\uff0c\u5728\u300e\u873f\u8712\u5c0f\u5f84\u300f\u8d5b\u9053\u4e0a\uff0c\u6b64\u6280\u5de7\u6709\u52a9\u4e8e\u5e94\u5bf9\u591a\u91cd\u53d1\u5939\u5f2f\u9053\uff0c\u5e76\u4fdd\u6301\u901f\u5ea6\u3002\u5728\u300e\u8ba1\u65f6\u8d5b\u300f\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u6b64\u65b9\u6cd5\u4ee5\u7cbe\u8fdb\u6280\u5de7\u3002"}]
[{"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \uc870\uc791\uc744 \ube60\ub974\uac8c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c '\ud29c\ud1a0\ub9ac\uc5bc' \uc139\uc158\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc139\uc158\uc5d0\uc11c\ub294 \uc624\ub978\ucabd \ud2b8\ub9ac\uac70\ub85c \uac00\uc18d\ud558\uace0, \uc67c\ucabd \ud2b8\ub9ac\uac70\ub85c \uc81c\ub3d9\ud558\uace0, \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uc870\ud5a5\ud558\ub294 \ub4f1 \uae30\ubcf8 \uc870\uc791\uc744 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc \uc911\uc5d0\ub294 \uc774\ub7ec\ud55c \uc870\uc791\uc744 \uc5f0\uc2b5\ud558\uae30 \uc704\ud574 \ud2b8\ub799\uc744 \ud55c \ubc14\ud034 \ub3c4\ub294 \uac04\ub2e8\ud55c \ub808\uc774\uc2a4\ub97c \uc644\ub8cc\ud558\ub3c4\ub85d \uc694\uccad\ubc1b\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud50c\ub808\uc774\uc5b4\ub294 '\uc870\uc791 \uc124\uc815'\uc5d0 \uc811\uadfc\ud558\uc5ec \ub354 \ud3b8\uc548\ud55c \uc0ac\uc6a9 \uacbd\ud5d8\uc744 \uc704\ud574 \ubc84\ud2bc \ub808\uc774\uc544\uc6c3\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\ub294 \ub370\ub294 \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uacf5\uae30 \uc800\ud56d\uc744 \uc904\uc774\uace0 \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uc0c1\ub300 \ubc14\uc774\ud06c \ubc14\ub85c \ub4a4\uc5d0 \uba38\ubb3c\ub7ec '\ub4dc\ub798\ud504\ud305' \uae30\ubc95\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP2: \uc548\uc804\ud558\uac8c \ucd94\uc6d4\ud560 \uc218 \uc788\ub294 \uc9c1\uc120 \ucf54\uc2a4 \ub610\ub294 \ub113\uc740 \ucf54\ub108\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP3: \uacb0\uc2b9 \ub808\uc774\uc2a4\uc640 \uac19\uc740 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uc804\ub7b5\uc801\uc73c\ub85c '\ubd80\uc2a4\ud2b8' \uae30\ub2a5\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \ub300\uc2dc' \ud2b8\ub799\uc5d0\uc11c \uae34 \uc9c1\uc120 \ucf54\uc2a4\uc5d0\uc11c \uc120\ub450 \ubc14\uc774\ud06c \ub4a4\ub97c \ub530\ub77c \ub4dc\ub798\ud504\ud305\ud558\uba74 \uacb0\uc2b9\uc120 \ubc14\ub85c \uc804\uc5d0 \uc131\uacf5\uc801\uc778 \ucd94\uc6d4\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \ubc14\uc774\ud06c \uac1c\uc870\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \ubd80\ubd84\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uac1c\uc870\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \ubc14\uc774\ud06c \uac1c\uc870\ub294 \uc18d\ub3c4, \uc870\ud5a5\uc131 \ubc0f \ub0b4\uad6c\uc131\uc744 \ud5a5\uc0c1\uc2dc\ucf1c \uc131\ub2a5\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uac00\uc18d \ubc0f \ucd5c\uace0 \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uba3c\uc800 '\uc5d4\uc9c4'\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uace0, \uadf8 \ub2e4\uc74c '\ud0c0\uc774\uc5b4'\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uadf8\ub9bd\ub825\uacfc \ucf54\ub108\ub9c1 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ucf1c\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc36c\ub354\ubcfc\ud2b8' \ubc14\uc774\ud06c\uc758 \uc5d4\uc9c4\uc744 \ub808\ubca8 3\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 '\uc2dc\ud2f0 \uc11c\ud0b7' \ud2b8\ub799\uc5d0\uc11c \ub7a9 \ud0c0\uc784\uc744 \ucd5c\ub300 2\ucd08\uae4c\uc9c0 \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac70\uce5c \uc9c0\ud615\uc5d0\uc11c \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uc8fc\ud589\uc744 \uc704\ud574 '\uc11c\uc2a4\ud39c\uc158'\uc5d0 \ud22c\uc790\ud558\ub294 \uac83\ub3c4 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub294 \ucda9\uaca9\uc744 \ubc1b\uc558\uc744 \ub54c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc774 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \ud2b8\ub799 \uc0c1\ud0dc\uc5d0 \uc5ed\ub3d9\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uccd0 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \ube44\ub294 \ud0c0\uc774\uc5b4 \uadf8\ub9bd\uc744 \uac10\uc18c\uc2dc\ucf1c \ucf54\ub108\ub97c \ub354 \ubbf8\ub044\ub7fd\uac8c \ub9cc\ub4e4\uace0, \uc548\uac1c\ub294 \uc2dc\uc57c\ub97c \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4. \uc801\uc751\ud558\uae30 \uc704\ud574 \ube44\uac00 \uc624\ub294 \uacbd\uc6b0 '\uc816\uc740 \ud0c0\uc774\uc5b4'\ub85c \uad50\uccb4\ud558\uc5ec \uc811\uc9c0\ub825\uc744 \ub192\uc774\uace0 \uc548\uac1c\uac00 \ub080 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \ucda9\ub3cc\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc18d\ub3c4\ub97c \uc904\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uae38' \ud2b8\ub799\uc5d0\uc11c \ube44\uac00 \uc624\ub294 \ub808\uc774\uc2a4 \uc911\uc5d0\ub294 \uc816\uc740 \ud0c0\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uba74 \ub0a0\uce74\ub85c\uc6b4 \ucf54\ub108\uc5d0\uc11c \uc81c\uc5b4\ub825\uc744 \uc720\uc9c0\ud558\uace0, \uac12\uc9c4 \uc2dc\uac04\uc744 \ub0ad\ube44\ud560 \uc218 \uc788\ub294 \ubbf8\ub044\ub7ec\uc9d0\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 '\uc544\ucf00\uc774\ub4dc' \ubaa8\ub4dc\uc640 '\uc2dc\ubbac\ub808\uc774\uc158' \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 '\uc544\ucf00\uc774\ub4dc' \ubaa8\ub4dc\uc640 '\uc2dc\ubbac\ub808\uc774\uc158' \ubaa8\ub4dc\ub294 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4 \uc120\ud638\ub3c4\uc5d0 \ub9de\ucdb0 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc544\ucf00\uc774\ub4dc \ubaa8\ub4dc\ub294 \ub2e8\uc21c\ud654\ub41c \ubb3c\ub9ac \uc5d4\uc9c4\uacfc \uad00\ub300\ud55c \uc870\uc791\uc73c\ub85c \ube60\ub974\uace0 \uc811\uadfc\ud558\uae30 \uc26c\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uba70 \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \ubc18\uba74, \uc2dc\ubbac\ub808\uc774\uc158 \ubaa8\ub4dc\ub294 \uace0\ub3c4\uc758 \ubb3c\ub9ac \uc5d4\uc9c4, \ud0c0\uc774\uc5b4 \ub9c8\ubaa8\ub7c9 \ubc0f \uc5f0\ub8cc \uad00\ub9ac\ub85c \ub354 \ud604\uc2e4\uc801\uc778 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uba70 \ud558\ub4dc\ucf54\uc5b4 \uc720\uc800\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uc544\ucf00\uc774\ub4dc \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uae09\uaca9\ud55c \ucf54\ub108\ub9c1\uc744 \ud574\ub3c4 \uc18d\ub3c4\ub97c \ub9ce\uc774 \uc783\uc9c0 \uc54a\uc9c0\ub9cc, \uc2dc\ubbac\ub808\uc774\uc158 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc774\ub7ec\ud55c \uc870\uc791\uc774 \ubbf8\ub044\ub7ec\uc9d0\uc774\ub098 \ucda9\ub3cc\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \ud2b8\ub799\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \ucd08\ubcf4\uc790\ub294 '\uadf8\ub9b0 \ubc38\ub9ac'\uc640 '\uc120\uc14b \uc2a4\ud2b8\ub9bd'\uacfc \uac19\uc740 \ud2b8\ub799\ubd80\ud130 \uc2dc\uc791\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774 \ud2b8\ub799\uc740 \uad6c\uc131\uc774 \uac04\ub2e8\ud558\uace0 \uc704\ud5d8 \uc694\uc18c\uac00 \uc801\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uadf8\ub9b0 \ubc38\ub9ac\ub294 \ub113\uc740 \ucf54\ub108\uc640 \ubd80\ub4dc\ub7ec\uc6b4 \ud45c\uba74\uc744 \uac16\ucd94\uace0 \uc788\uc5b4 \ucf54\ub108\ub9c1\uacfc \uac00\uc18d\uc744 \uc5f0\uc2b5\ud558\uae30\uc5d0 \uc6a9\uc774\ud569\ub2c8\ub2e4. \uc120\uc14b \uc2a4\ud2b8\ub9bd\uc740 \uae34 \uc9c1\uc120 \ucf54\uc2a4\ub97c \uc81c\uacf5\ud558\uc5ec \uc18d\ub3c4 \uc81c\uc5b4\ub97c \uc775\ud788\ub294\ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadf8\ub9b0 \ubc38\ub9ac\uc5d0\uc11c \uae68\ub057\ud55c \ub7a9\uc744 \uc644\ub8cc\ud558\uba74 '\uc544\uc774\uc2a4 \ud53c\ud06c'\ub098 '\uc5b4\ubc18 \uc815\uae00'\uacfc \uac19\uc740 \ub354 \ubcf5\uc7a1\ud55c \ud2b8\ub799\uc5d0 \ub3c4\uc804\ud558\uae30 \uc804\uc5d0 \uc790\uc2e0\uac10\uc744 \uc313\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\uc804\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 Google Play \ub610\ub294 Apple ID\uc640 \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ud504\ub85c\ud544\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc5f0\uacb0\ub418\uba74 \uc7a0\uae08 \ud574\uc81c\ub41c \ubc14\uc774\ud06c \ubc0f \uc5c5\uc801\uc744 \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc0c8 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud560 \ub54c \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 iOS \uae30\uae30\uc5d0\uc11c \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\uc804\ud654\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \ub3d9\uc77c\ud55c Apple ID\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub85c\uadf8\uc778\ud558\uba74 \uc800\uc7a5\ub41c \ub370\uc774\ud130\uc5d0 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc591\ucabd \uae30\uae30 \ubaa8\ub450 \ucd5c\uc2e0 \uac8c\uc784 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uc5b4 \ud638\ud658\uc131 \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \uc228\uaca8\uc9c4 \ucc4c\ub9b0\uc9c0\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\ub294 \ud2b9\ubcc4\ud55c \ubc14\uc774\ud06c\uc640 \uac1c\uc870 \uc635\uc158\uc73c\ub85c \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \ucc4c\ub9b0\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc4c\ub9b0\uc9c0\ub294 \uc5f0\uc18d 10\ubc88\uc758 \ub808\uc774\uc2a4 \uc6b0\uc2b9\uc774\ub098 \ud2b9\uc815 \ud2b8\ub799\uc5d0\uc11c \uc644\ubcbd\ud55c \ub7a9 \uc2dc\uac04 \ub2ec\uc131\uacfc \uac19\uc740 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc744 \ub2ec\uc131\ud568\uc73c\ub85c\uc368 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uace0\uc2a4\ud2b8 \ub77c\uc774\ub354' \ubc14\uc774\ud06c\ub294 '\ub098\uc774\ud2b8\uba54\uc5b4 \uc11c\ud0b7' \ud2b8\ub799\uc744 2\ubd84 \ubbf8\ub9cc\uc73c\ub85c \uc644\uc8fc\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubaa9\ud45c\uc5d0 \ub300\ud55c \ud78c\ud2b8\ub294 '\uc5c5\uc801' \ud0ed\uc744 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ud50c\ub808\uc774\uc5b4 \ub7ad\ud0b9\uc5d0 \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc758 \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \ub808\uc774\uc2a4 \uc131\uc801, \uc77c\uad00\uc131 \ubc0f \uc804\ubc18\uc801\uc778 \uc9c4\ud589 \uc0c1\ud669\uc758 \uc870\ud569\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \ub808\uc774\uc2a4 \uc21c\uc704, \ub7a9 \ud0c0\uc784 \ubc0f \ub808\uc774\uc2a4 \ub09c\uc774\ub3c4\ub294 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc804\ubb38\uac00' \ub09c\uc774\ub3c4\uc5d0\uc11c \uafb8\uc900\ud788 \uc0c1\uc704 3\uc704 \uc548\uc5d0 \ub4dc\ub294 \uac83\uc774 \ucd08\ubcf4\uc790 \ub09c\uc774\ub3c4\uc5d0\uc11c \uc6b0\uc2b9\ud558\ub294 \uac83\ubcf4\ub2e4 \ub7ad\ud0b9\uc774 \ub354 \ube60\ub974\uac8c \uc0c1\uc2b9\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc2a4\ud134\ud2b8 \uc218\ud589 \ub610\ub294 \ucda9\ub3cc \ud68c\ud53c\uc640 \uac19\uc740 \ubcf4\ub108\uc2a4 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uba74 \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 '\ub9ac\ub354\ubcf4\ub4dc' \uc139\uc158\uc5d0\uc11c \uc790\uc2e0\uc758 \ub7ad\ud0b9\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \ub0a0\uce74\ub85c\uc6b4 \ucf54\ub108\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uae30\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \ubc14\uc774\ud06c \ucc54\ud53c\uc5b8\uc5d0\uc11c \ub0a0\uce74\ub85c\uc6b4 \ucf54\ub108\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc81c\ub3d9, \uc870\ud5a5 \ubc0f \uac00\uc18d \ud398\ub2ec \uc870\uc791\uc744 \uc870\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ucf54\ub108\uc5d0 \uc811\uadfc\ud560 \ub54c \uac00\uc18d \ud398\ub2ec\uc744 \ub5bc\uace0 \ubd80\ub4dc\ub7fd\uac8c \ube0c\ub808\uc774\ud06c\ub97c \ubc1f\uc2b5\ub2c8\ub2e4. STEP2: \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucf54\ub108\uc5d0 \uae30\uc6b8\uba74\uc11c \uafb8\uc900\ud55c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. STEP3: \uac00\uc18d \ud398\ub2ec\uc744 \uc11c\uc11c\ud788 \ubc1f\uc544 \ucf54\ub108\uc5d0\uc11c \ubaa8\uba58\ud140\uc744 \ud68c\ubcf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud2b8\uc704\uc2a4\ud2f0 \ud2b8\ub808\uc77c' \ud2b8\ub799\uc5d0\uc11c \uc774 \uae30\ubc95\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5ec\ub7ec \uac1c\uc758 \uae09\ucee4\ube0c\ub97c \uc18d\ub3c4\ub97c \uc783\uc9c0 \uc54a\uace0 \ud1b5\uacfc\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. '\ud0c0\uc784 \ud2b8\ub77c\uc774\uc5bc' \ubaa8\ub4dc\uc5d0\uc11c \uc774 \ubc29\ubc95\uc744 \uc5f0\uc2b5\ud558\uc5ec \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694."}]
[{"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u5b66\u3076\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u306f\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u300e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u300f\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3057\u3066\u958b\u59cb\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u53f3\u30c8\u30ea\u30ac\u30fc\u3067\u52a0\u901f\u3001\u5de6\u30c8\u30ea\u30ac\u30fc\u3067\u30d6\u30ec\u30fc\u30ad\u3001\u5de6\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u30cf\u30f3\u30c9\u30eb\u64cd\u4f5c\u3068\u3044\u3063\u305f\u57fa\u672c\u64cd\u4f5c\u3092\u8aac\u660e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306b\u3001\u30b3\u30fc\u30b9\u30921\u5468\u3059\u308b\u7c21\u5358\u306a\u8ab2\u984c\u304c\u63d0\u793a\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u8a2d\u5b9a\u300f\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u3001\u3088\u308a\u5feb\u9069\u306a\u64cd\u4f5c\u306e\u305f\u3081\u306e\u30dc\u30bf\u30f3\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u305f\u3081\u306e\u6700\u5584\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7a7a\u6c17\u62b5\u6297\u3092\u6e1b\u3089\u3057\u3001\u901f\u5ea6\u3092\u4e0a\u3052\u308b\u305f\u3081\u306b\u5bfe\u6226\u76f8\u624b\u306e\u5f8c\u65b9\u306b\u5bc4\u308a\u6dfb\u3044\u3001\u300c\u30c9\u30e9\u30d5\u30c8\u300d\u30c6\u30af\u30cb\u30c3\u30af\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5b89\u5168\u306b\u5f7c\u3089\u3092\u8ffd\u3044\u629c\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u30b9\u30c8\u30ec\u30fc\u30c8\u3084\u5e83\u3044\u30ab\u30fc\u30d6\u3067\u30c1\u30e3\u30f3\u30b9\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u91cd\u8981\u306a\u77ac\u9593\u3001\u305f\u3068\u3048\u3070\u6700\u7d42\u30e9\u30c3\u30d7\u306e\u3088\u3046\u306a\u77ac\u9593\u306e\u305f\u3081\u306b\u3001\u300c\u30d6\u30fc\u30b9\u30c8\u300d\u6a5f\u80fd\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3001\u7bc0\u7d04\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7802\u6f20\u306e\u30c0\u30c3\u30b7\u30e5\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u9577\u3044\u30b9\u30c8\u30ec\u30fc\u30c8\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u5148\u884c\u30d0\u30a4\u30af\u306e\u5f8c\u65b9\u306b\u30c9\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u7d42\u30e9\u30a4\u30f3\u76f4\u524d\u3067\u6210\u529f\u7684\u306a\u8ffd\u3044\u629c\u304d\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u30d0\u30a4\u30af\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u90e8\u54c1\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u306e\u30d0\u30a4\u30af\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306f\u3001\u901f\u5ea6\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3001\u8010\u4e45\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u3067\u6027\u80fd\u306b\u5927\u304d\u304f\u5f71\u97ff\u3057\u307e\u3059\u3002\u3088\u308a\u826f\u3044\u52a0\u901f\u3068\u6700\u9ad8\u901f\u5ea6\u306e\u305f\u3081\u306b\u300e\u30a8\u30f3\u30b8\u30f3\u300f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u3001\u305d\u306e\u5f8c\u300e\u30bf\u30a4\u30e4\u300f\u3092\u6539\u826f\u3057\u3066\u30b0\u30ea\u30c3\u30d7\u529b\u3068\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0\u6027\u80fd\u3092\u9ad8\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b5\u30f3\u30c0\u30fc\u30dc\u30eb\u30c8\u300d\u30d0\u30a4\u30af\u306e\u30a8\u30f3\u30b8\u30f3\u3092\u30ec\u30d9\u30eb3\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u300c\u30b7\u30c6\u30a3\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u30b3\u30fc\u30b9\u3067\u306e\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u6700\u59272\u79d2\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u8352\u308c\u305f\u8def\u9762\u3067\u3082\u30b9\u30e0\u30fc\u30ba\u306a\u8d70\u884c\u306e\u305f\u3081\u306b\u300e\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u300f\u3078\u306e\u6295\u8cc7\u3082\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u6bb5\u5dee\u306a\u3069\u3067\u901f\u5ea6\u3092\u5931\u3046\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u5bfe\u5fdc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b3\u30fc\u30b9\u72b6\u6cc1\u306b\u52d5\u7684\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u96e8\u306f\u30bf\u30a4\u30e4\u306e\u30b0\u30ea\u30c3\u30d7\u529b\u3092\u4f4e\u4e0b\u3055\u305b\u3001\u30b3\u30fc\u30ca\u30fc\u3092\u3088\u308a\u6ed1\u308a\u3084\u3059\u304f\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u9727\u306f\u8996\u754c\u3092\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u96e8\u5929\u6642\u306f\u3088\u308a\u826f\u3044\u30c8\u30e9\u30af\u30b7\u30e7\u30f3\u306e\u305f\u3081\u306b\u300c\u30a6\u30a7\u30c3\u30c8\u30bf\u30a4\u30e4\u300d\u306b\u5207\u308a\u66ff\u3048\u3066\u3001\u9727\u6df1\u3044\u5730\u57df\u3067\u306f\u885d\u7a81\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u901f\u5ea6\u3092\u843d\u3068\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30de\u30a6\u30f3\u30c6\u30f3\u30d1\u30b9\u300d\u30b3\u30fc\u30b9\u306e\u96e8\u5929\u30ec\u30fc\u30b9\u3067\u306f\u3001\u30a6\u30a7\u30c3\u30c8\u30bf\u30a4\u30e4\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u8cb4\u91cd\u306a\u6642\u9593\u3092\u5931\u3046\u53ef\u80fd\u6027\u306e\u3042\u308b\u30b9\u30ad\u30c3\u30c9\u3092\u9632\u304e\u306a\u304c\u3089\u3001\u92ed\u3044\u30ab\u30fc\u30d6\u3092\u7dad\u6301\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u300e\u30a2\u30fc\u30b1\u30fc\u30c9\u300f\u30e2\u30fc\u30c9\u3068\u300e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u300f\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u300e\u30a2\u30fc\u30b1\u30fc\u30c9\u300f\u30e2\u30fc\u30c9\u3068\u300e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u300f\u30e2\u30fc\u30c9\u306f\u3001\u7570\u306a\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u597d\u307f\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\u30a2\u30fc\u30b1\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u3001\u9ad8\u901f\u3067\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u3044\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u7269\u7406\u6cd5\u5247\u306f\u30b7\u30f3\u30d7\u30eb\u3067\u64cd\u4f5c\u306f\u5bdb\u5927\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6700\u9069\u3067\u3059\u3002\u4e00\u65b9\u3001\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u30e2\u30fc\u30c9\u306f\u3001\u3088\u308a\u9ad8\u5ea6\u306a\u7269\u7406\u6cd5\u5247\u3001\u30bf\u30a4\u30e4\u306e\u6469\u8017\u3001\u71c3\u6599\u7ba1\u7406\u306b\u3088\u308b\u3088\u308a\u73fe\u5b9f\u7684\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d8\u30d3\u30fc\u30e6\u30fc\u30b6\u30fc\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30fc\u30b1\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6025\u30ab\u30fc\u30d6\u3092\u8d70\u884c\u3057\u3066\u3082\u901f\u5ea6\u3092\u3042\u307e\u308a\u5931\u3044\u307e\u305b\u3093\u304c\u3001\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u30e2\u30fc\u30c9\u3067\u306f\u3001\u305d\u306e\u3088\u3046\u306a\u64cd\u4f5c\u306f\u30b9\u30ad\u30c3\u30c9\u3084\u30af\u30e9\u30c3\u30b7\u30e5\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u521d\u5fc3\u8005\u306b\u6700\u9069\u306a\u30b3\u30fc\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u306e\u7406\u7531\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u521d\u5fc3\u8005\u306b\u306f\u3001\u300c\u30b0\u30ea\u30fc\u30f3\u30d0\u30ec\u30fc\u300d\u3068\u300c\u30b5\u30f3\u30bb\u30c3\u30c8\u30b9\u30c8\u30ea\u30c3\u30d7\u300d\u306e\u3088\u3046\u306a\u30b3\u30fc\u30b9\u304c\u6700\u9069\u3067\u3059\u3002\u305d\u306e\u7406\u7531\u306f\u3001\u3053\u308c\u3089\u306e\u30b3\u30fc\u30b9\u306f\u30ec\u30a4\u30a2\u30a6\u30c8\u304c\u30b7\u30f3\u30d7\u30eb\u3067\u3001\u969c\u5bb3\u7269\u304c\u5c11\u306a\u3044\u305f\u3081\u3067\u3059\u3002\u30b0\u30ea\u30fc\u30f3\u30d0\u30ec\u30fc\u306f\u5e83\u3044\u30ab\u30fc\u30d6\u3068\u6ed1\u3089\u304b\u306a\u8def\u9762\u3092\u6301\u3061\u3001\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0\u3068\u52a0\u901f\u306e\u7df4\u7fd2\u306b\u6700\u9069\u3067\u3059\u3002\u30b5\u30f3\u30bb\u30c3\u30c8\u30b9\u30c8\u30ea\u30c3\u30d7\u306f\u9577\u5927\u306a\u30b9\u30c8\u30ec\u30fc\u30c8\u304c\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u901f\u5ea6\u306e\u5236\u5fa1\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b0\u30ea\u30fc\u30f3\u30d0\u30ec\u30fc\u3067\u30b9\u30e0\u30fc\u30ba\u306a1\u5468\u3092\u7d42\u3048\u308b\u3053\u3068\u306f\u3001\u300c\u30a2\u30a4\u30b9\u30d4\u30fc\u30af\u300d\u3084\u300c\u30a2\u30fc\u30d0\u30f3\u30b8\u30e3\u30f3\u30b0\u30eb\u300d\u306e\u3088\u3046\u306a\u3088\u308a\u8907\u96d1\u306a\u30b3\u30fc\u30b9\u306b\u6311\u6226\u3059\u308b\u524d\u306b\u81ea\u4fe1\u3092\u3064\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306fGoogle Play\u3084Apple ID\u306e\u3088\u3046\u306a\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ea\u30f3\u30af\u3057\u305f\u3089\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u30d0\u30a4\u30af\u3084\u5b9f\u7e3e\u3092\u542b\u3080\u9032\u884c\u72b6\u6cc1\u304c\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS\u30c7\u30d0\u30a4\u30b9\u304b\u3089Android\u643a\u5e2f\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001\u540c\u3058Apple ID\u3067\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u6700\u65b0\u306e\u30b2\u30fc\u30e0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u3001\u4e92\u63db\u6027\u306e\u554f\u984c\u3092\u56de\u907f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u96a0\u3055\u308c\u305f\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306b\u306f\u3001\u9650\u5b9a\u7684\u306a\u30d0\u30a4\u30af\u3084\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3067\u5831\u916c\u3092\u5f97\u3089\u308c\u308b\u96a0\u3055\u308c\u305f\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u300110\u30ec\u30fc\u30b9\u9023\u7d9a\u3067\u52dd\u5229\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u30b3\u30fc\u30b9\u3067\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u306a\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u9054\u6210\u3057\u305f\u308a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b4\u30fc\u30b9\u30c8\u30e9\u30a4\u30c0\u30fc\u300d\u30d0\u30a4\u30af\u306f\u3001\u300c\u30ca\u30a4\u30c8\u30e1\u30a2\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u30b3\u30fc\u30b9\u30922\u5206\u672a\u6e80\u3067\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3057\u76ee\u6a19\u306b\u95a2\u3059\u308b\u30d2\u30f3\u30c8\u306f\u3001\u300c\u5b9f\u7e3e\u300d\u30bf\u30d6\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30fc\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3001\u5b89\u5b9a\u6027\u3001\u5168\u4f53\u7684\u306a\u9032\u884c\u72b6\u6cc1\u3092\u7d44\u307f\u5408\u308f\u305b\u305f\u3082\u306e\u3067\u3059\u3002\u8981\u56e0\u306b\u306f\u3001\u9806\u4f4d\u3001\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3001\u30ec\u30fc\u30b9\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u300d\u96e3\u6613\u5ea6\u3067\u5e38\u306b\u4e0a\u4f4d3\u4f4d\u4ee5\u5185\u306b\u5165\u308b\u3068\u3001\u300c\u30d3\u30ae\u30ca\u30fc\u300d\u3067\u52dd\u5229\u3059\u308b\u3088\u308a\u3082\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u304c\u65e9\u304f\u4e0a\u6607\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b9\u30bf\u30f3\u30c8\u3084\u885d\u7a81\u56de\u907f\u3068\u3044\u3063\u305f\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3068\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u300d\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u81ea\u5206\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u8ffd\u8de1\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u6025\u30ab\u30fc\u30d6\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d0\u30a4\u30af\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u3067\u6025\u30ab\u30fc\u30d6\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30d6\u30ec\u30fc\u30ad\u3001\u30cf\u30f3\u30c9\u30eb\u64cd\u4f5c\u3001\u30a2\u30af\u30bb\u30eb\u5236\u5fa1\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ab\u30fc\u30d6\u306b\u9032\u5165\u3059\u308b\u969b\u306f\u3001\u30a2\u30af\u30bb\u30eb\u3092\u7de9\u3081\u3001\u8efd\u304f\u30d6\u30ec\u30fc\u30ad\u3092\u304b\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5de6\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u3063\u3066\u30ab\u30fc\u30d6\u306b\u4f53\u3092\u50be\u3051\u306a\u304c\u3089\u3001\u5b89\u5b9a\u3057\u305f\u901f\u5ea6\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f90\u3005\u306b\u30a2\u30af\u30bb\u30eb\u3092\u8e0f\u307f\u8fbc\u3093\u3067\u30ab\u30fc\u30d6\u304b\u3089\u8131\u51fa\u3057\u3001\u52e2\u3044\u3092\u56de\u5fa9\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c4\u30a4\u30b9\u30c8\u30c8\u30ec\u30a4\u30eb\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u8907\u6570\u306e\u30d8\u30a2\u30d4\u30f3\u30ab\u30fc\u30d6\u3092\u901f\u5ea6\u3092\u843d\u3068\u3055\u305a\u306b\u8d70\u884c\u3067\u304d\u307e\u3059\u3002\u300c\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u300d\u30e2\u30fc\u30c9\u3067\u3053\u306e\u65b9\u6cd5\u3092\u7df4\u7fd2\u3059\u308b\u3068\u3001\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
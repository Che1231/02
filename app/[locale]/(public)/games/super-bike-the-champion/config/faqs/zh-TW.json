[{"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u5b78\u7fd2\u57fa\u672c\u63a7\u5236?", "answer": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\uff0c\u65b0\u73a9\u5bb6\u53ef\u4ee5\u5f9e\u4e3b\u9078\u55ae\u7684\u300e\u6559\u5b78\u300f\u90e8\u5206\u958b\u59cb\u3002\u9019\u500b\u90e8\u5206\u6703\u5f15\u5c0e\u4f60\u5b78\u7fd2\u57fa\u672c\u63a7\u5236\uff0c\u4f8b\u5982\uff1a\u7528\u53f3\u89f8\u767c\u5668\u52a0\u901f\u3001\u7528\u5de6\u89f8\u767c\u5668\u715e\u8eca\u3001\u548c\u7528\u5de6\u6416\u687f\u64cd\u63a7\u65b9\u5411\u76e4\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u904e\u7a0b\u4e2d\uff0c\u4f60\u5c07\u88ab\u8981\u6c42\u7e5e\u8457\u8cfd\u9053\u5b8c\u6210\u4e00\u500b\u7c21\u55ae\u7684\u5708\u6578\u4f86\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\u3002\u6b64\u5916\uff0c\u73a9\u5bb6\u4e5f\u53ef\u4ee5\u9032\u5165\u300e\u63a7\u5236\u8a2d\u5b9a\u300f\u4f86\u81ea\u8a02\u6309\u9215\u4f48\u5c40\uff0c\u4ee5\u7372\u5f97\u66f4\u8212\u9069\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u8d85\u8d8a\u5c0d\u624b\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc?", "answer": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u8d85\u8d8a\u5c0d\u624b\u9700\u8981\u6280\u5de7\u548c\u7b56\u7565\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u904b\u7528\u300c\u8ddf\u8eca\u300d\u6280\u5de7\uff0c\u7dca\u8ddf\u5728\u5c0d\u624b\u5f8c\u65b9\u4ee5\u6e1b\u5c11\u7a7a\u6c23\u963b\u529b\u4e26\u7372\u5f97\u901f\u5ea6\u63d0\u5347\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c0b\u627e\u5728\u76f4\u9053\u6216\u5bec\u8f49\u5f4e\u8655\u7684\u6a5f\u6703\uff0c\u5b89\u5168\u5730\u8d85\u8d8a\u4ed6\u5011\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u904b\u7528\u300c\u52a0\u901f\u300d\u529f\u80fd\uff0c\u5c07\u5176\u5132\u5b58\u65bc\u95dc\u9375\u6642\u523b\uff0c\u4f8b\u5982\u6700\u5f8c\u4e00\u5708\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u885d\u523a\u300d\u8cfd\u9053\uff0c\u5728\u9577\u76f4\u9053\u4e0a\u8ddf\u96a8\u9818\u5148\u7684\u8cfd\u8eca\u53ef\u4ee5\u8b93\u4f60\u6210\u529f\u8d85\u8d8a\uff0c\u4e26\u5728\u7d42\u9ede\u7dda\u524d\u5b8c\u6210\u8d85\u8d8a\u3002"}, {"question": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u6539\u88dd\u8cfd\u8eca\u5f88\u91cd\u8981\uff0c\u54ea\u4e9b\u90e8\u4ef6\u61c9\u8a72\u512a\u5148\u5347\u7d1a?", "answer": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\uff0c\u8cfd\u8eca\u6539\u88dd\u6703\u986f\u8457\u5f71\u97ff\u8868\u73fe\uff0c\u63d0\u5347\u901f\u5ea6\u3001\u64cd\u63a7\u6027\u548c\u8010\u7528\u6027\u3002\u512a\u5148\u5347\u7d1a\u300c\u5f15\u64ce\u300d\uff0c\u4ee5\u63d0\u5347\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\uff0c\u5176\u6b21\u662f\u300c\u8f2a\u80ce\u300d\uff0c\u4ee5\u6539\u5584\u6293\u5730\u529b\u548c\u5f4e\u9053\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u96f7\u96fb\u300d\u8cfd\u8eca\u7684\u5f15\u64ce\u5347\u7d1a\u5230\u4e09\u7d1a\uff0c\u53ef\u4ee5\u5728\u300c\u57ce\u5e02\u8cfd\u9053\u300d\u8cfd\u9053\u7e2e\u77ed\u5708\u901f\u9ad8\u9054\u5169\u79d2\u3002\u6b64\u5916\uff0c\u9084\u53ef\u8003\u616e\u6295\u8cc7\u300c\u61f8\u540a\u7cfb\u7d71\u300d\uff0c\u4ee5\u5728\u5d0e\u5d87\u5730\u5f62\u4e0a\u7372\u5f97\u66f4\u5e73\u7a69\u7684\u9a0e\u4e58\uff0c\u9019\u53ef\u4ee5\u9632\u6b62\u5728\u985b\u7c38\u8def\u9762\u4e0a\u640d\u5931\u901f\u5ea6\u3002"}, {"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u73a9\u5bb6\u5982\u4f55\u9069\u61c9?", "answer": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u6703\u52d5\u614b\u5f71\u97ff\u8cfd\u9053\u72c0\u6cc1\uff0c\u8981\u6c42\u73a9\u5bb6\u8abf\u6574\u7b56\u7565\u3002\u4e0b\u96e8\u6703\u964d\u4f4e\u8f2a\u80ce\u6293\u5730\u529b\uff0c\u4f7f\u5f4e\u9053\u8b8a\u5f97\u66f4\u6fd5\u6ed1\uff0c\u800c\u9727\u6c23\u5247\u6703\u964d\u4f4e\u80fd\u898b\u5ea6\u3002\u70ba\u4e86\u9069\u61c9\uff0c\u5728\u96e8\u5929\u5207\u63db\u5230\u300c\u96e8\u80ce\u300d\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6293\u5730\u529b\uff0c\u4e26\u5728\u9727\u5929\u964d\u4f4e\u901f\u5ea6\u4ee5\u907f\u514d\u78b0\u649e\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5c71\u8def\u300d\u8cfd\u9053\u7684\u96e8\u5929\u6bd4\u8cfd\u4e2d\uff0c\u4f7f\u7528\u96e8\u80ce\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5728\u6025\u5f4e\u4e2d\u4fdd\u6301\u63a7\u5236\uff0c\u907f\u514d\u53ef\u80fd\u5c0e\u81f4\u6642\u9593\u640d\u5931\u7684\u6253\u6ed1\u3002"}, {"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u300e\u8857\u6a5f\u300f\u6a21\u5f0f\u548c\u300e\u6a21\u64ec\u300f\u6a21\u5f0f\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570?", "answer": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u300e\u8857\u6a5f\u300f\u6a21\u5f0f\u548c\u300e\u6a21\u64ec\u300f\u6a21\u5f0f\u8fce\u5408\u4e0d\u540c\u7684\u73a9\u5bb6\u559c\u597d\u3002\u300e\u8857\u6a5f\u300f\u6a21\u5f0f\u8457\u91cd\u65bc\u5feb\u901f\u3001\u6613\u65bc\u4e0a\u624b\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u5177\u6709\u7c21\u5316\u7684\u7269\u7406\u5f15\u64ce\u548c\u5bec\u5bb9\u7684\u64cd\u63a7\u6027\uff0c\u975e\u5e38\u9069\u5408\u4f11\u9592\u73a9\u5bb6\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u300e\u6a21\u64ec\u300f\u6a21\u5f0f\u5247\u63d0\u4f9b\u66f4\u771f\u5be6\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u5177\u6709\u5148\u9032\u7684\u7269\u7406\u5f15\u64ce\u3001\u8f2a\u80ce\u78e8\u640d\u548c\u71c3\u6cb9\u7ba1\u7406\uff0c\u66f4\u9069\u5408\u71b1\u8877\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u8857\u6a5f\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u57f7\u884c\u6025\u8f49\u5f4e\u52d5\u4f5c\u800c\u4e0d\u6703\u5931\u53bb\u592a\u591a\u901f\u5ea6\uff0c\u800c\u5728\u6a21\u64ec\u6a21\u5f0f\u4e0b\uff0c\u6b64\u985e\u64cd\u4f5c\u53ef\u80fd\u6703\u5c0e\u81f4\u6253\u6ed1\u6216\u78b0\u649e\u3002"}, {"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u54ea\u4e9b\u8cfd\u9053\u6700\u9069\u5408\u65b0\u624b\uff0c\u70ba\u4ec0\u9ebc?", "answer": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u65b0\u624b\u73a9\u5bb6\u61c9\u8a72\u5f9e\u300c\u7da0\u8c37\u300d\u548c\u300c\u65e5\u843d\u5927\u9053\u300d\u7b49\u8cfd\u9053\u958b\u59cb\uff0c\u56e0\u70ba\u5b83\u5011\u7684\u4f48\u5c40\u7c21\u55ae\uff0c\u5371\u96aa\u6027\u6700\u5c0f\u3002\u7da0\u8c37\u7684\u5f4e\u9053\u5bec\u655e\uff0c\u8868\u9762\u5e73\u6ed1\uff0c\u66f4\u6613\u65bc\u7df4\u7fd2\u5f4e\u9053\u548c\u52a0\u901f\u3002\u65e5\u843d\u5927\u9053\u6709\u9577\u76f4\u7dda\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5c08\u6ce8\u65bc\u638c\u63e1\u901f\u5ea6\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7da0\u8c37\u5b8c\u6210\u4e00\u6b21\u4e7e\u6de8\u7684\u5708\u901f\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728\u6311\u6230\u66f4\u8907\u96dc\u7684\u8cfd\u9053\uff0c\u5982\u300c\u51b0\u5cf0\u300d\u6216\u300c\u90fd\u6703\u53e2\u6797\u300d\u4e4b\u524d\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u5c07\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0?", "answer": "\u8981\u5c07\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u7684\u9032\u5ea6\u8de8\u5e73\u53f0\u8f49\u79fb\uff0c\u73a9\u5bb6\u9700\u8981\u5c07\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u5e33\u6236\uff0c\u4f8b\u5982 Google Play \u6216 Apple ID\u3002\u9023\u7d50\u5f8c\uff0c\u9032\u5ea6\uff0c\u5305\u62ec\u89e3\u9396\u7684\u8cfd\u8eca\u548c\u6210\u5c31\uff0c\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u5230\u65b0\u88dd\u7f6e\u767b\u5165\u6642\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9e iOS \u88dd\u7f6e\u5207\u63db\u5230 Android \u624b\u6a5f\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684 Apple ID \u767b\u5165\u5373\u53ef\u5b58\u53d6\u4f60\u7684\u5132\u5b58\u6578\u64da\u3002\u8acb\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u66f4\u65b0\u5230\u6700\u65b0\u7684\u904a\u6232\u7248\u672c\uff0c\u4ee5\u907f\u514d\u76f8\u5bb9\u6027\u554f\u984c\u3002"}, {"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u96b1\u85cf\u6311\u6230\u662f\u4ec0\u9ebc\uff0c\u73a9\u5bb6\u5982\u4f55\u89e3\u9396?", "answer": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u6709\u96b1\u85cf\u6311\u6230\uff0c\u5b8c\u6210\u9019\u4e9b\u6311\u6230\u5c07\u6703\u734e\u52f5\u73a9\u5bb6\u7368\u5bb6\u8cfd\u8eca\u548c\u6539\u88dd\u9078\u9805\u3002\u9019\u4e9b\u6311\u6230\u662f\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u4f86\u89e3\u9396\uff0c\u4f8b\u5982\u9023\u7e8c\u8d0f\u5f97 10 \u5834\u6bd4\u8cfd\u6216\u5728\u7279\u5b9a\u8cfd\u9053\u9054\u5230\u5b8c\u7f8e\u7684\u5708\u901f\u3002\u4f8b\u5982\uff0c\u300e\u5e7d\u9748\u9a0e\u58eb\u300f\u8cfd\u8eca\u662f\u900f\u904e\u5728\u300e\u60e1\u5922\u8cfd\u9053\u300f\u8cfd\u9053\u5728 2 \u5206\u9418\u5167\u5b8c\u6210\u6bd4\u8cfd\u4f86\u89e3\u9396\u3002\u8acb\u5bc6\u5207\u6ce8\u610f\u300c\u6210\u5c31\u300d\u6a19\u7c64\uff0c\u4ee5\u77ad\u89e3\u9019\u4e9b\u96b1\u85cf\u76ee\u6a19\u3002"}, {"question": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u6392\u540d\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u5f71\u97ff\u73a9\u5bb6\u6392\u540d?", "answer": "\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u7684\u6392\u540d\u7cfb\u7d71\u57fa\u65bc\u8cfd\u4e8b\u8868\u73fe\u3001\u7a69\u5b9a\u6027\u548c\u6574\u9ad4\u9032\u5ea6\u76f8\u7d50\u5408\u3002\u5f71\u97ff\u56e0\u7d20\u5305\u62ec\u5b8c\u8cfd\u4f4d\u7f6e\u3001\u5708\u901f\u548c\u6bd4\u8cfd\u96e3\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5c08\u5bb6\u300d\u96e3\u5ea6\u4e0b\u6301\u7e8c\u6392\u540d\u524d\u4e09\uff0c\u5c07\u6bd4\u5728\u300c\u521d\u5b78\u8005\u300d\u96e3\u5ea6\u4e0b\u7372\u52dd\u80fd\u66f4\u5feb\u63d0\u5347\u6392\u540d\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u984d\u5916\u76ee\u6a19\uff0c\u4f8b\u5982\u8868\u6f14\u7279\u6280\u6216\u907f\u514d\u78b0\u649e\uff0c\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u73a9\u5bb6\u53ef\u4ee5\u5728\u300c\u6392\u884c\u699c\u300d\u90e8\u5206\u8ffd\u8e64\u81ea\u5df1\u7684\u6392\u540d\u3002"}, {"question": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u638c\u63e1\u6025\u8f49\u5f4e\u7684\u6709\u6548\u6280\u5de7\u662f\u4ec0\u9ebc?", "answer": "\u5728\u8d85\u7d1a\u8cfd\u8eca\u51a0\u8ecd\u4e2d\u638c\u63e1\u6025\u8f49\u5f4e\u9700\u8981\u7d50\u5408\u715e\u8eca\u3001\u65b9\u5411\u76e4\u64cd\u63a7\u548c\u6cb9\u9580\u63a7\u5236\u3002\u6b65\u9a5f\u4e00\uff1a\u900f\u904e\u6e1b\u7de9\u6cb9\u9580\u548c\u8f15\u8f15\u715e\u8eca\u4f86\u9032\u5165\u5f4e\u9053\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5de6\u6416\u687f\u50be\u659c\u8cfd\u8eca\uff0c\u4e26\u4fdd\u6301\u7a69\u5b9a\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u9010\u6b65\u52a0\u901f\u96e2\u958b\u5f4e\u9053\uff0c\u4ee5\u6062\u5fa9\u52d5\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5f4e\u9053\u53e2\u6797\u300d\u8cfd\u9053\uff0c\u9019\u500b\u6280\u5de7\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728\u591a\u500b\u9aee\u593e\u5f4e\u4e2d\u99d5\u99db\u8cfd\u8eca\uff0c\u800c\u4e0d\u6703\u5931\u53bb\u901f\u5ea6\u3002\u5efa\u8b70\u5728\u300c\u8a08\u6642\u8cfd\u300d\u6a21\u5f0f\u4e0b\u7df4\u7fd2\u9019\u500b\u65b9\u6cd5\uff0c\u4ee5\u7cbe\u9032\u4f60\u7684\u6280\u5de7\u3002"}]
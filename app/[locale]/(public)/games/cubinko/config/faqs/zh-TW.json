[{"question": "Cubinko\u65b0\u624b\u6c42\u52a9\uff1a\u5982\u4f55\u6709\u6548\u5730\u5728\u904a\u6232\u521d\u671f\u79fb\u52d5\u548c\u65cb\u8f49\u65b9\u584a\uff1f", "answer": "\u5c0d\u65bcCubinko\u65b0\u624b\u4f86\u8aaa\uff0c\u6709\u6548\u5730\u79fb\u52d5\u548c\u65cb\u8f49\u65b9\u584a\u662f\u57fa\u790e\u3002\u901a\u5e38\u4f7f\u7528\u65b9\u5411\u9375\u79fb\u52d5\u6d3b\u52d5\u65b9\u584a\u5de6\u53f3\u3002\u9375\u76e4\u4e0a\u7684'A'\u548c'D'\u9375\uff08\u6216\u60a8\u5e73\u53f0\u4e0a\u7684\u7b49\u6548\u9375\uff09\u6703\u9806\u6642\u91dd\u6216\u9006\u6642\u91dd\u65cb\u8f49\u65b9\u584a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u500b'L'\u5f62\u65b9\u584a\uff0c\u60a8\u53ef\u80fd\u60f3\u65cb\u8f49\u5b83\u624d\u80fd\u5b8c\u5168\u9069\u5408\u89d2\u843d\u3002\u7df4\u7fd2\u5feb\u901f\u679c\u65b7\u7684\u52d5\u4f5c\u4ee5\u512a\u5316\u60a8\u7684\u7a7a\u9593\u4f7f\u7528\u7387\u3002\u60f3\u8c61\u4e00\u4e0bTetris\u7684\u65e9\u671f\u95dc\u5361\u3002\u5229\u7528\u9810\u89bd\u4e0b\u4e00\u500b\u65b9\u584a\u7684\u8996\u89ba\u63d0\u793a\u5c07\u5c0d\u60a8\u6709\u5f88\u5927\u5e6b\u52a9\u3002\u904a\u6232\u521d\u671f\u653e\u7f6e\u5931\u6557\u53ef\u80fd\u6703\u5f71\u97ff\u7e3d\u5f97\u5206\u3002"}, {"question": "\u70ba\u4ec0\u9ebcCubinko\u5982\u6b64\u4e0a\u766e\uff1f\u7dad\u6301\u73a9\u5bb6\u5728\u5b8c\u6210\u8a31\u591a\u95dc\u5361\u5f8c\u4ecd\u8457\u8ff7\u7684\u300e\u5fc3\u6d41\u72c0\u614b\u300f\u662f\u4ec0\u9ebc\uff1f", "answer": "Cubinko\u4e0a\u766e\u7684\u672c\u8cea\u4f86\u81ea\u65bc\u5176\u512a\u96c5\u7684\u8a2d\u8a08\uff0c\u4fc3\u9032\u4e86\u300e\u5fc3\u6d41\u72c0\u614b\u300f\u3002\u9019\u901a\u904e\u6311\u6230\u548c\u6280\u80fd\u4e4b\u9593\u7684\u5e73\u8861\u4f86\u5be6\u73fe\u3002\u6bcf\u500b\u653e\u7f6e\u6c7a\u7b56\u90fd\u6703\u5f71\u97ff\u60a8\u5728\u7db2\u683c\u9650\u5236\u5167\u6709\u6548\u6e05\u9664\u7dda\u7684\u80fd\u529b\u3002\u6bcf\u6e05\u9664\u4e00\u689dCubinko\u7dda\u90fd\u6703\u63d0\u4f9b\u5373\u6642\u7684\u6b63\u9762\u53cd\u994b\u3002\u4f8b\u5982\uff0c\u540c\u6642\u6e05\u9664\u591a\u689d\u7dda\u6703\u7522\u751f\u4ee4\u4eba\u6eff\u610f\u7684\u9023\u9396\u53cd\u61c9\u6548\u679c\u3002\u6b64\u5916\uff0c\u904a\u6232\u8a2d\u8a08\u770b\u8d77\u4f86\u975e\u5e38\u7c21\u55ae\u3002\u7136\u800c\uff0c\u5b83\u9700\u8981\u76f8\u7576\u591a\u7684\u7a7a\u9593\u63a8\u7406\u548c\u6230\u7565\u898f\u5283\u4f86\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u9019\u6703\u5275\u9020\u51fa\u6301\u7e8c\u7684\u638c\u63a7\u611f\u548c\u9032\u6b65\u611f\uff0c\u9019\u662f\u904a\u6232\u7dad\u6301\u73a9\u5bb6\u8208\u8da3\u7684\u5fc5\u8981\u5c6c\u6027\u3002"}, {"question": "Cubinko\u9032\u968e\u554f\u984c\uff1a\u6709\u4ec0\u9ebc\u672a\u5145\u5206\u5229\u7528\u7684\u7b56\u7565\u53ef\u4ee5\u6700\u5927\u5316\u5f97\u5206\u9023\u9396\uff1f", "answer": "\u5728Cubinko\u4e2d\u6700\u5927\u5316\u5f97\u5206\u9023\u9396\u9700\u8981\u6230\u7565\u898f\u5283\u548c\u6a21\u5f0f\u8b58\u5225\u3002\n\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u901a\u904e\u7b56\u7565\u6027\u5730\u7559\u4e0b\u9593\u9699\u4f86\u5275\u9020\u591a\u884c\u6e05\u9664\u7684\u6a5f\u6703\u3002\n\u6b65\u9a5f2\uff1a\u4f7f\u7528\u6c34\u5e73\u7dda\u4f86\u8a2d\u7f6e\u89f8\u767c\u9023\u9396\u53cd\u61c9\u7684\u5782\u76f4\u4e0b\u964d\u3002\n\u6b65\u9a5f3\uff1a\u512a\u5316\u65b9\u584a\u653e\u7f6e\u4ee5\u5275\u9020\u6f5b\u5728\u7684\u9023\u9396\u53cd\u61c9\u6548\u679c\uff0c\u9019\u53ef\u4ee5\u66f4\u597d\u5730\u5229\u7528\u6709\u9650\u7684\u53ef\u7528\u7a7a\u9593\u3002\u5f9e\u672c\u8cea\u4e0a\u8b1b\uff0c\u76ee\u6a19\u662f\u8a2d\u7f6e\u9023\u9396\u53cd\u61c9\u4e26\u5229\u7528\u904a\u6232\u5143\u7d20\u4f86\u512a\u5316\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u653e\u7f6e\u65b9\u584a\uff0c\u4f7f\u5176\u5141\u8a31\u60a8\u5b8c\u6210\u4e00\u884c\u4ee5\u7372\u5f97\u7d44\u5408\u5206\u6578\u3002\u60f3\u50cf\u4e00\u4e0b\u591a\u7c73\u8afe\u9aa8\u724c\u9806\u5e8f\u6392\u5217\uff0c\u4ed4\u7d30\u7684\u898f\u5283\u662f\u512a\u5316\u5206\u6578\u7684\u95dc\u9375\u3002"}, {"question": "\u89e3\u91cbCubinko\u7684\u8a08\u5206\u7cfb\u7d71\uff1f\u54ea\u4e9b\u56e0\u7d20\u6c7a\u5b9a\u4e86\u6bcf\u500b\u65b9\u584a\u653e\u7f6e\u548c\u7dda\u6e05\u9664\u7684\u5f97\u5206\uff1f", "answer": "Cubinko\u7684\u8a08\u5206\u7cfb\u7d71\u53d6\u6c7a\u65bc\u55ae\u6b21\u64cd\u4f5c\u4e2d\u6d88\u9664\u7684\u65b9\u584a\u6578\u91cf\u3002\u65b9\u584a\u653e\u7f6e\u5f97\u5206\u3002\u4e3b\u8981\u5f97\u5206\u4f86\u81ea\u65bc\u5b8c\u6210\u7dda\u3002\u7372\u5f97\u7684\u5206\u6578\u8207\u540c\u6642\u6e05\u9664\u7684\u7dda\u6578\u6210\u6b63\u6bd4\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u4e00\u689d\u7dda\u53ef\u80fd\u734e\u52f5100\u5206\u3002\u4e00\u6b21\u6e05\u9664\u5169\u689d\u7dda\u53ef\u80fd\u63d0\u4f9b\u984d\u5916\u734e\u52f5\uff0c\u4f8b\u5982300\u5206\uff0c\u6e05\u9664\u4e09\u689d\u6216\u66f4\u591a\u7dda\u6642\u984d\u5916\u734e\u52f5\u7684\u5f97\u5206\u6703\u589e\u52a0\u3002\u653e\u7f6e\u4e5f\u91cd\u8981\uff0c\u653e\u7f6e\u8f03\u5927\u7684\u65b9\u584a\u4e5f\u6703\u63d0\u9ad8\u5206\u6578\u3002\u9019\u4e9b\u734e\u52f5\u8da8\u65bc\u76f8\u4e58\uff0c\u734e\u52f5\u5c0d\u65b9\u584a\u9032\u884c\u6230\u7565\u6027\u6392\u5217\u4ee5\u5275\u9020\u9019\u4e9b\u591a\u884c\u6d88\u9664\u3002\u6e05\u9664\u56db\u689d\u7dda\u901a\u5e38\u6703\u7372\u5f97\u9ad8\u5f97\u591a\u7684\u5f97\u5206\u3002\u56e0\u6b64\uff0c\u512a\u5316\u7dda\u6e05\u9664\u81f3\u95dc\u91cd\u8981\u3002\u9084\u6709\u6839\u64da\u65b9\u584a\u5927\u5c0f\u7684\u500d\u6578\u734e\u52f5\uff0c\u65b9\u584a\u8d8a\u5927\uff0c\u500d\u6578\u8d8a\u9ad8\u3002"}, {"question": "Cubinko\u9ad8\u624b\u8acb\u6559\uff1a\u70ba\u4ec0\u9ebc\u65b9\u584a\u5f62\u72c0\u7684\u5206\u914d\u4f3c\u4e4e\u5b58\u5728\u7d71\u8a08\u504f\u5dee\uff1f\u5728\u904a\u6232\u7684\u7279\u5b9a\u968e\u6bb5\uff0c\u662f\u5426\u5b58\u5728\u67d0\u4e9b\u51fa\u73fe\u983b\u7387\u8f03\u4f4e\u7684\u7279\u5b9a\u5f62\u72c0\uff1f", "answer": "Cubinko\u4e2d\u6240\u611f\u77e5\u7684\u65b9\u584a\u5f62\u72c0\u5206\u914d\u504f\u5dee\u662f\u904a\u6232\u904e\u7a0b\u751f\u6210\u6f14\u7b97\u6cd5\u7684\u7d50\u679c\u3002\u5118\u7ba1\u6f14\u7b97\u6cd5\u65e8\u5728\u96a8\u6a5f\uff0c\u4f46\u5b83\u53ef\u80fd\u6703\u6839\u64da\u904a\u6232\u677f\u7684\u7576\u524d\u72c0\u614b\u5fae\u5999\u5730\u512a\u5148\u8003\u616e\u67d0\u4e9b\u5f62\u72c0\uff0c\u4ee5\u7dad\u6301\u96e3\u5ea6\u4e26\u9632\u6b62\u7463\u788e\u7684\u89e3\u6c7a\u65b9\u6848\u3002\u4f8b\u5982\uff0c\u7576\u904a\u6232\u5834\u4e0a\u5df2\u7d93\u6709\u5f88\u591a\u7a7a\u9699\u6642\uff0c\u9577\u76f4\u7684\u65b9\u584a\uff08'I'\u5f62\uff09\u53ef\u80fd\u51fa\u73fe\u7684\u983b\u7387\u8f03\u4f4e\u3002\u60f3\u8fa6\u6cd5\u8655\u7406\u9019\u7a2e\u660e\u986f\u7684\u504f\u5dee\uff0c\u8a66\u60f3\u4e00\u4e0b\u64b2\u514b\u724c\u662f\u5982\u4f55\u9032\u884c\u300c\u6d17\u724c\u300d\u4ee5\u78ba\u4fdd\u96a8\u6a5f\u7684\uff0c\u4f46\u662f\u4e8b\u5be6\u4e0a\uff0c\u9019\u901a\u5e38\u4e0d\u662f\u771f\u6b63\u96a8\u6a5f\u7684\u3002\u8b58\u5225\u57fa\u65bc\u904a\u6232\u72c0\u614b\u6700\u5e38\u7528\u65b9\u584a\u7684\u73a9\u5bb6\u5728Cubinko\u4e2d\u5177\u6709\u986f\u8457\u512a\u52e2\u3002"}, {"question": "Cubinko\u6280\u8853\u5206\u6790\uff1a\u70ba\u4e86\u7dad\u6301\u904a\u6232\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u7684\u6a94\u6848\u5927\u5c0f\uff0c\u540c\u6642\u4e0d\u5f71\u97ff\u8cc7\u7522/\u8cc7\u6599\u52a0\u8f09\u901f\u5ea6\uff0c\u904a\u6232\u4f7f\u7528\u4e86\u54ea\u4e9b\u8cc7\u6599\u58d3\u7e2e\u6f14\u7b97\u6cd5\uff1f", "answer": "\u5728Cubinko\u4e2d\u7dad\u6301\u8f03\u5c0f\u7684\u6a94\u6848\u5927\u5c0f\uff0c\u540c\u6642\u4e0d\u5f71\u97ff\u8cc7\u7522\u52a0\u8f09\u901f\u5ea6\uff0c\u53ef\u80fd\u6d89\u53ca\u591a\u7a2e\u8cc7\u6599\u58d3\u7e2e\u6280\u8853\u7684\u7d44\u5408\u3002\u7d0b\u7406\u58d3\u7e2e\u662f\u5fc5\u8981\u7684\u3002PNG\u6216JPEG\u7b49\u6f14\u7b97\u6cd5\u901a\u5e38\u88ab\u4f7f\u7528\uff0c\u56e0\u70ba\u5b83\u5011\u5728\u58d3\u7e2e\u6bd4\u7387\u548c\u5f71\u50cf\u54c1\u8cea\u4e4b\u9593\u53d6\u5f97\u4e86\u5e73\u8861\u3002\u5c0d\u65bc\u904a\u6232\u8cc7\u6599\uff0cZLib\u6216Deflate\u6f14\u7b97\u6cd5\u7528\u65bc\u58d3\u7e2e\u95dc\u5361\u8cc7\u6599\u548c\u5176\u4ed6\u904a\u6232\u8a2d\u5b9a\u3002\u7db2\u683c\u548c\u5e7e\u4f55\u8cc7\u6599\u901a\u5e38\u6703\u9032\u884c\u7de8\u78bc\u3002\u4f8b\u5982\uff0cZLib\u88ab\u7528\u65bc\u8a31\u591a\u7db2\u9801\u6280\u8853\u4e2d\uff0c\u4ee5\u58d3\u7e2e\u7a0b\u5f0f\u78bc\uff0c\u4f7f\u5176\u4e0b\u8f09\u901f\u5ea6\u66f4\u5feb\u3002\u95dc\u9375\u662f\u8981\u5c0d\u5728\u6240\u6709\u8a2d\u5099\u4e0a\u904b\u884c\u7684\u904a\u6232\u5f15\u64ce\u9032\u884c\u6982\u6cc1\u5206\u6790\uff0c\u4ee5\u78ba\u5b9a\u54ea\u4e9b\u58d3\u7e2e\u7b56\u7565\u7522\u751f\u6700\u4f73\u7d50\u679c\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u540c\u6b65Cubinko\u904a\u6232\u9032\u5ea6\u55ce\uff1f\u4f7f\u7528\u540c\u4e00\u500b\u5e33\u6236\u5728iOS\u548cAndroid\u88dd\u7f6e\u4e4b\u9593\u9032\u884c\u8cc7\u6599\u9077\u79fb\u7684\u9078\u9805\u6709\u54ea\u4e9b\uff1f", "answer": "Cubinko\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u5132\u5b58\u8cc7\u6599\u540c\u6b65\uff0c\u901a\u5e38\u53d6\u6c7a\u65bc\u904a\u6232\u7684\u5be6\u73fe\u65b9\u5f0f\u3002\u5982\u679c\u904a\u6232\u63d0\u4f9b\u8207\u5e33\u6236\u9023\u7d50\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff08\u4f8b\u5982Google Play Games\u3001Apple Game Center\u6216\u5c08\u7528\u7684Cubinko\u5e33\u6236\uff09\uff0c\u60a8\u5f88\u53ef\u80fd\u53ef\u4ee5\u5728iOS\u548cAndroid\u88dd\u7f6e\u4e4b\u9593\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u904a\u6232\u4f7f\u7528Google Play Games\uff0c\u53ea\u9700\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u6236\u5373\u53ef\u3002\u8cc7\u6599\u9077\u79fb\u4e5f\u53ef\u80fd\u53ef\u4ee5\u4f7f\u7528\u624b\u52d5\u5099\u4efd\u548c\u9084\u539f\u529f\u80fd\uff0c\u4f46\u9019\u53d6\u6c7a\u65bc\u958b\u767c\u4eba\u54e1\u662f\u5426\u63d0\u4f9b\u6b64\u529f\u80fd\u3002"}, {"question": "Cubinko\u5f69\u86cb\u6316\u6398\uff1a\u5728\u591a\u6b21\u56de\u5408\u5b8c\u6210\u904a\u6232\u6216\u9054\u5230\u7279\u5b9a\u5f97\u5206\u9580\u6abb\u5f8c\uff0c\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "Cubinko\u5f88\u53ef\u80fd\u5305\u542b\u8a31\u591a\u96b1\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff0c\u4ee5\u734e\u52f5\u6295\u5165\u7684\u73a9\u5bb6\u3002\u6709\u4e9b\u5e38\u898b\u7684\u5f69\u86cb\u985e\u578b\u662f\u5728\u73a9\u5bb6\u7372\u5f97\u7279\u5b9a\u9ad8\u5206\u6642\u51fa\u73fe\u7279\u5b9a\u7684\u8996\u89ba\u8b8a\u5316\u3002\u5f69\u86cb\u7d93\u5e38\u88ab\u9396\u5b9a\u5728\u91cd\u8907\u52d5\u4f5c\u80cc\u5f8c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u76f8\u540c\u984f\u8272\u7684\u65b9\u584a\u5b8c\u5168\u586b\u6eff\u904a\u6232\u677f\uff0c\u901a\u5e38\u6703\u89e3\u9396\u904a\u6232\u4e2d\u96b1\u85cf\u7684\u89d2\u8272\u76ae\u819a\uff0c\u6539\u8b8a\u65b9\u584a\u7684\u5916\u89c0\u3002\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\u548c\u5f97\u5206\u9580\u6abb\u4f86\u63ed\u793a\u9a5a\u559c\u3002\u5728\u8a31\u591a\u60c5\u6cc1\u4e0b\uff0c\u67e5\u770bCubinko\u7dda\u4e0a\u8ad6\u58c7\uff0c\u770b\u770b\u5176\u4ed6\u73a9\u5bb6\u7684\u767c\u73fe\u662f\u5f88\u597d\u7684\u4e3b\u610f\u3002\u6ce8\u610f\u904a\u6232\u7684\u516c\u544a\uff0c\u901a\u5e38\u5728\u904a\u6232\u91cc\u7a0b\u7891\u4e4b\u5f8c\uff0c\u4ed6\u5011\u6703\u63d0\u4f9b\u63d0\u793a\u3002"}, {"question": "Cubinko\u8cc7\u6df1\u73a9\u5bb6\uff1aCubinko\u662f\u57fa\u65bc\u904b\u6c23\u9084\u662f\u57fa\u65bc\u7b56\u7565\uff1f\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u5c0d\u65bc\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u66f4\u91cd\u8981\uff1f", "answer": "Cubinko\u7d50\u5408\u4e86\u904b\u6c23\u548c\u7b56\u7565\uff0c\u4f46\u6210\u529f\u53d6\u6c7a\u65bc\u66f4\u5ee3\u6cdb\u7684\u6230\u7565\u898f\u5283\u548c\u8cc7\u6e90\u7ba1\u7406\u3002\u5118\u7ba1\u65b9\u584a\u5f62\u72c0\u7684\u9806\u5e8f\u662f\u96a8\u6a5f\u7684\uff0c\u4f46\u60a8\u9810\u6e2c\u548c\u6709\u6548\u6574\u5408\u9019\u4e9b\u65b9\u584a\u7684\u80fd\u529b\u6c7a\u5b9a\u4e86\u60a8\u7684\u6210\u529f\u3002\u4ee5\u4e0b\u904a\u6232\u6a5f\u5236\u6c7a\u5b9a\u7d50\u679c\uff1a\n1. \u9810\u6e2c\u5e7e\u6b65\u3002\n2. \u5e73\u8861\u5373\u6642\u7dda\u6e05\u9664\u8207\u9577\u671f\u7a7a\u9593\u512a\u5316\u3002\n3. \u8b58\u5225\u4e26\u5229\u7528\u5275\u9020\u9023\u9396\u53cd\u61c9\u7684\u6a5f\u6703\u3002\u904b\u6c23\u5728\u60a8\u7372\u5f97\u6700\u4f73\u6642\u6a5f\u7684\u5b8c\u7f8e\u65b9\u584a\u6642\u8d77\u8457\u5f88\u5c0f\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u6709\u6642\u4e00\u500b\u9577\u7684\u76f4\u584a\u5141\u8a31\u60a8\u6e05\u96644\u689d\u7dda\u4e26\u8b93\u60a8\u901a\u904e\u4e0b\u4e00\u95dc\u3002Cubinko\u8a2d\u8a08\u7528\u65bc\u6311\u6230\u60a8\u7684\u898f\u5283\u6280\u5de7\uff0c\u7121\u8ad6\u9047\u5230\u4ec0\u9ebc\u3002"}, {"question": "\u5982\u4f55\u63d0\u9ad8Cubinko\u7684\u6280\u5de7\uff1f\u8aaa\u660e\u300c\u4e95\u300d\u7684\u6982\u5ff5\u4f5c\u70ba\u9ad8\u968e\u904a\u6232\u7b56\u7565\u3002", "answer": "\u63d0\u5347Cubinko\u6280\u5de7\u7684\u4e00\u7a2e\u7b56\u7565\u662f\u7cbe\u901a\u300c\u4e95\u300d\u7684\u6982\u5ff5\u3002\u9019\u662f\u4e00\u7a2e\u6230\u7565\u6027\u653e\u7f6e\uff0c\u60a8\u9700\u8981\u5275\u9020\u4e00\u500b\u9577\u800c\u72f9\u7a84\u7684\u5782\u76f4\u5217\uff08\u300c\u4e95\u300d\uff09\u3002\u9019\u7528\u65bc\u63a5\u6536\u76f4\u7dda\u3001'I'\u5f62\u7684\u65b9\u584a\uff0c\u4ee5\u6709\u6548\u5730\u6e05\u9664\u591a\u884c\u3002\n\u6b65\u9a5f1\uff1a\u5728\u653e\u7f6e\u65b9\u584a\u671f\u9593\u81f3\u5c11\u7559\u4e0b\u4e00\u5217\u5782\u76f4\u67f1\u3002\n\u6b65\u9a5f2\uff1a\u5617\u8a66\u4f7f\u5176\u4ed6\u65b9\u584a\u671d\u5411\u5275\u9020\u9019\u4e9b\u6709\u7528\u7684\u4e95\u3002\n\u6b65\u9a5f3\uff1a\u6ce8\u610f\u76f4\u7dda\u65b9\u584a\u3002\u8003\u616e\u4ee5\u4e0b\u89c0\u9ede\uff1a\u4e95\u8d8a\u5927\uff0c\u901a\u904e\u653e\u7f6e\u5728\u5e95\u90e8\u6e05\u9664\u591a\u884c\u7684\u53ef\u80fd\u6027\u8d8a\u5927\u3002\u6c92\u6709\u4ed4\u7d30\u7684\u8a08\u5283\uff0c\u5efa\u7acb\u4e95\uff0c\u6709\u6548\u6e05\u9664\u7dda\u7684\u53ef\u80fd\u6027\u5c31\u964d\u4f4e\u4e86\u3002\u5c0d\u65bc\u5728Cubinko\u4e2d\u53d6\u5f97\u9ad8\u5206\uff0c\u9019\u662f\u4e00\u500b\u4e3b\u8981\u7684\u7b56\u7565\u3002"}]
[{"question": "Cubinko \u043d\u043e\u0432\u0430\u0447\u043e\u043a \u0448\u0443\u043a\u0430\u0454 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0438: \u042f\u043a \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0430\u0442\u0438 \u0442\u0430 \u043e\u0431\u0435\u0440\u0442\u0430\u0442\u0438 \u0431\u043b\u043e\u043a\u0438 \u043d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443?", "answer": "\u042f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a \u0443 Cubinko, \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0442\u0430 \u043e\u0431\u0435\u0440\u0442\u0430\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432 \u0454 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0438\u043c. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439, \u0432\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0438, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0430\u0442\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u0431\u043b\u043e\u043a \u0432\u043b\u0456\u0432\u043e \u0447\u0438 \u0432\u043f\u0440\u0430\u0432\u043e. \u041a\u043b\u0430\u0432\u0456\u0448\u0456 'A' \u0442\u0430 'D' (\u0430\u0431\u043e \u0457\u0445 \u0430\u043d\u0430\u043b\u043e\u0433\u0438 \u043d\u0430 \u0432\u0430\u0448\u0456\u0439 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0456) \u043e\u0431\u0435\u0440\u0442\u0430\u044e\u0442\u044c \u0431\u043b\u043e\u043a \u0437\u0430 \u0433\u043e\u0434\u0438\u043d\u043d\u0438\u043a\u043e\u0432\u043e\u044e \u0441\u0442\u0440\u0456\u043b\u043a\u043e\u044e \u0430\u0431\u043e \u043f\u0440\u043e\u0442\u0438 \u0433\u043e\u0434\u0438\u043d\u043d\u0438\u043a\u043e\u0432\u043e\u0457 \u0441\u0442\u0440\u0456\u043b\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0431\u043b\u043e\u043a \u0444\u043e\u0440\u043c\u0438 \"L\", \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438 \u0439\u043e\u0433\u043e, \u0449\u043e\u0431 \u0432\u0456\u043d \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0432\u043f\u0438\u0441\u0430\u0432\u0441\u044f \u0432 \u043a\u0443\u0442. \u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u0448\u0432\u0438\u0434\u043a\u0456 \u0439 \u0440\u0456\u0448\u0443\u0447\u0456 \u0440\u0443\u0445\u0438, \u0449\u043e\u0431 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443. \u041f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u043e \u0440\u0430\u043d\u043d\u0456 \u0440\u0456\u0432\u043d\u0456 \u0422\u0435tris. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0456\u0434\u043a\u0430\u0437\u043e\u043a, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0431\u043b\u043e\u043a\u0443, \u0437\u043d\u0430\u0447\u043d\u043e \u0432\u0430\u043c \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435. \u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u043d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043c\u043e\u0436\u0435 \u0432\u043f\u043b\u0438\u043d\u0443\u0442\u0438 \u043d\u0430 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0443 \u043c\u043e\u0436\u043b\u0438\u0432\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0431\u0430\u043b\u0456\u0432."}, {"question": "\u0427\u043e\u043c\u0443 Cubinko \u043d\u0430\u0441\u0442\u0456\u043b\u044c\u043a\u0438 \u0437\u0430\u0445\u043e\u043f\u043b\u044e\u044e\u0447\u0438\u0439? \u0429\u043e \u0442\u0430\u043a\u0435 \u0441\u0442\u0430\u043d \"\u043f\u043e\u0442\u043e\u043a\u0443\", \u044f\u043a\u0438\u0439 \u0443\u0442\u0440\u0438\u043c\u0443\u0454 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0437\u0430\u0445\u043e\u043f\u043b\u0435\u043d\u0438\u043c\u0438 \u043d\u0430\u0432\u0456\u0442\u044c \u043f\u0456\u0441\u043b\u044f \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0431\u0430\u0433\u0430\u0442\u044c\u043e\u0445 \u0440\u0456\u0432\u043d\u0456\u0432?", "answer": "\u0417\u0430\u0445\u043e\u043f\u043b\u044e\u044e\u0447\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u0430 Cubinko \u0432\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0437 \u0439\u043e\u0433\u043e \u0435\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0433\u043e \u0434\u0438\u0437\u0430\u0439\u043d\u0443, \u044f\u043a\u0438\u0439 \u0441\u043f\u0440\u0438\u044f\u0454 \u0441\u0442\u0430\u043d\u0443 \"\u043f\u043e\u0442\u043e\u043a\u0443\". \u0426\u0435 \u0434\u043e\u0441\u044f\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0431\u0430\u043b\u0430\u043d\u0441\u0443 \u043c\u0456\u0436 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044e \u0442\u0430 \u043d\u0430\u0432\u0438\u0447\u043a\u0430\u043c\u0438. \u041a\u043e\u0436\u043d\u0435 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0449\u043e\u0434\u043e \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0443 \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0432\u0430\u0448\u0443 \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043e\u0447\u0438\u0449\u0430\u0442\u0438 \u0440\u044f\u0434\u043a\u0438 \u0432 \u043c\u0435\u0436\u0430\u0445 \u0441\u0456\u0442\u043a\u0438. \u041a\u043e\u0436\u0435\u043d \u043e\u0447\u0438\u0449\u0435\u043d\u0438\u0439 \u0440\u044f\u0434\u043e\u043a \u043a\u0443\u0431\u0438\u043a\u0456\u0432 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u043d\u0435\u0433\u0430\u0439\u043d\u0438\u0439 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u0438\u0439 \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0456\u0439 \u0437\u0432'\u044f\u0437\u043e\u043a. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432 \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e \u0441\u0442\u0432\u043e\u0440\u044e\u0454 \u0437\u0430\u0434\u043e\u0432\u0456\u043b\u044c\u043d\u0438\u0439 \u0435\u0444\u0435\u043a\u0442 \u043a\u0430\u0441\u043a\u0430\u0434\u0443. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0433\u0440\u0430 \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0437 \u0432\u0438\u0433\u043b\u044f\u0434\u0443 \u0431\u0443\u0446\u0456\u043c\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u044e. \u041e\u0434\u043d\u0430\u043a \u0432\u043e\u043d\u0430 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0445\u043e\u0440\u043e\u0448\u043e\u0457 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u043e\u0432\u043e\u0457 \u043b\u043e\u0433\u0456\u043a\u0438 \u0442\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0441\u0442\u0432\u043e\u0440\u044e\u0454 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f \u043c\u0430\u0439\u0441\u0442\u0435\u0440\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443, \u0449\u043e \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c\u0438 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0430\u043c\u0438 \u0434\u043b\u044f \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u0456\u043d\u0442\u0435\u0440\u0435\u0441\u0443 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 \u0433\u0440\u0456."}, {"question": "Cubinko \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u043f\u0438\u0442\u0430\u043d\u043d\u044f: \u042f\u043a\u0456 \u043c\u0430\u043b\u043e\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u043a\u043e\u043c\u0431\u043e \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0456\u0432 \u0431\u0430\u043b\u0456\u0432?", "answer": "\u041c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u043a\u043e\u043c\u0431\u043e \u0431\u0430\u043b\u0456\u0432 \u0443 Cubinko \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0435\u0439.\n\u041a\u0420\u041e\u041a 1: \u0421\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0443\u0439\u0442\u0435\u0441\u044f \u043d\u0430 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0434\u043b\u044f \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432, \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0447\u0438 \u043f\u0440\u043e\u0433\u0430\u043b\u0438\u043d\u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e.\n\u041a\u0420\u041e\u041a 2: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u0456 \u0440\u044f\u0434\u043a\u0438, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0456 \u043f\u0430\u0434\u0456\u043d\u043d\u044f, \u044f\u043a\u0456 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c \u043b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0456 \u0440\u0435\u0430\u043a\u0446\u0456\u0457.\n\u041a\u0420\u041e\u041a 3: \u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0439\u0442\u0435 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0430\u043b \u043a\u0430\u0441\u043a\u0430\u0434\u043d\u0438\u0445 \u0435\u0444\u0435\u043a\u0442\u0456\u0432, \u0446\u0435 \u043a\u0440\u0430\u0449\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043f\u0440\u043e\u0441\u0442\u0456\u0440. \u041f\u043e \u0441\u0443\u0442\u0456, \u043c\u0435\u0442\u0430 \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0432 \u0442\u043e\u043c\u0443, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u043b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0456 \u0440\u0435\u0430\u043a\u0446\u0456\u0457 \u0442\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0433\u0440\u0438 \u043d\u0430 \u0441\u0432\u043e\u044e \u043a\u043e\u0440\u0438\u0441\u0442\u044c. \u041f\u0440\u0438\u043a\u043b\u0430\u0434\u043e\u043c \u0431\u0443\u0434\u0435 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0443 \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u0449\u043e\u0431 \u0432\u0456\u043d \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0432 \u0437\u0430\u043a\u0456\u043d\u0447\u0438\u0442\u0438 \u0440\u044f\u0434\u043e\u043a, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u043a\u043e\u043c\u0431\u043e. \u0423\u044f\u0432\u0456\u0442\u044c \u0441\u043e\u0431\u0456 \u0434\u043e\u043c\u0456\u043d\u043e, \u0449\u043e \u043f\u0430\u0434\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u0432\u043e\u0454 \u043c\u0456\u0441\u0446\u0435, \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u0435 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0454 \u043a\u043b\u044e\u0447\u0435\u043c \u0434\u043e \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u0432\u0430\u0448\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443."}, {"question": "\u041f\u043e\u044f\u0441\u043d\u0456\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0430\u043b\u0456\u0432 \u0443 Cubinko? \u042f\u043a\u0456 \u0444\u0430\u043a\u0442\u043e\u0440\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c \u0431\u0430\u043b\u0438, \u0449\u043e \u043f\u0440\u0438\u0441\u0443\u0434\u0436\u0443\u044e\u0442\u044c\u0441\u044f \u0437\u0430 \u043a\u043e\u0436\u043d\u0435 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432 \u0442\u0430 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043d\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0430\u043b\u0456\u0432 \u0443 Cubinko \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u043a\u0443\u0431\u0456\u0432, \u0443\u0441\u0443\u043d\u0435\u043d\u0438\u0445 \u0437\u0430 \u043e\u0434\u0438\u043d \u0445\u0456\u0434. \u041e\u0447\u043a\u0438 \u043d\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u044f\u043a \u0437\u0430 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432, \u0442\u0430\u043a \u0456 \u0437\u0430 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432. \u041e\u0441\u043d\u043e\u0432\u043d\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e - \u0446\u0435 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432. \u041e\u0447\u043a\u0438, \u044f\u043a\u0456 \u043d\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f, \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0456\u0439\u043d\u0456 \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0440\u044f\u0434\u043a\u0456\u0432, \u0449\u043e \u043e\u0447\u0438\u0449\u0443\u044e\u0442\u044c\u0441\u044f \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u044f\u0434\u043a\u0430 \u043c\u043e\u0436\u0435 \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438\u0442\u0438 100 \u0431\u0430\u043b\u0430\u043c\u0438. \u041e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0434\u0432\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432 \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e \u043c\u043e\u0436\u0435 \u043d\u0430\u0434\u0430\u0442\u0438 \u0431\u043e\u043d\u0443\u0441\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a 300 \u0431\u0430\u043b\u0456\u0432, \u0449\u043e \u0437\u0440\u043e\u0441\u0442\u0430\u044e\u0442\u044c \u0449\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u0434\u043b\u044f \u0442\u0440\u044c\u043e\u0445 \u0447\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u0440\u044f\u0434\u043a\u0456\u0432. \u0420\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0442\u0430\u043a\u043e\u0436 \u043c\u0430\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f, \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u0456\u043b\u044c\u0448\u043e\u0433\u043e \u0431\u043b\u043e\u043a\u0443 \u0442\u0430\u043a\u043e\u0436 \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0456 \u0431\u043e\u043d\u0443\u0441\u0438 \u0441\u0445\u0438\u043b\u044c\u043d\u0456 \u043c\u043d\u043e\u0436\u0438\u0442\u0438\u0441\u044f, \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0443\u044e\u0447\u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0435 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432 \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0446\u0438\u0445 \u043e\u0447\u0438\u0449\u0435\u043d\u044c \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432. \u041e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0447\u043e\u0442\u0438\u0440\u044c\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432 \u0447\u0430\u0441\u0442\u043e \u0434\u0430\u0454 \u0432\u0438\u0449\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043d\u0430 \u0437\u043d\u0430\u0447\u043d\u043e \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u043c\u043d\u043e\u0436\u043d\u0438\u043a. \u0422\u043e\u043c\u0443 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432 \u0441\u0442\u0430\u0454 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e\u044e. \u0422\u0430\u043a\u043e\u0436 \u0454 \u043c\u043d\u043e\u0436\u043d\u0438\u043a, \u0449\u043e \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u0431\u043b\u043e\u043a\u0456\u0432, \u0447\u0438\u043c \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0431\u043b\u043e\u043a, \u0442\u0438\u043c \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u043c\u043d\u043e\u0436\u043d\u0438\u043a."}, {"question": "\u0415\u043a\u0441\u043f\u0435\u0440\u0442\u0438 Cubinko, \u0431\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u043e\u044f\u0441\u043d\u0456\u0442\u044c: \u0427\u043e\u043c\u0443 \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b \u0444\u043e\u0440\u043c \u0431\u043b\u043e\u043a\u0456\u0432 \u0432\u0438\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u043e \u0441\u043f\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u043c? \u0427\u0438 \u0454 \u043f\u0435\u0432\u043d\u0456 \u0444\u043e\u0440\u043c\u0438, \u044f\u043a\u0456 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044e\u0442\u044c\u0441\u044f \u0440\u0456\u0434\u0448\u0435 \u043d\u0430 \u043f\u0435\u0432\u043d\u0438\u0445 \u0441\u0442\u0430\u0434\u0456\u044f\u0445 \u0433\u0440\u0438?", "answer": "\u0421\u043f\u0440\u0438\u0439\u043c\u0430\u043d\u0435 \u0441\u043f\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0443 \u0444\u043e\u0440\u043c \u0431\u043b\u043e\u043a\u0456\u0432 \u0443 Cubinko \u0454 \u043d\u0430\u0441\u043b\u0456\u0434\u043a\u043e\u043c \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u043d\u043e\u0433\u043e \u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u0438. \u0425\u043e\u0447\u0430 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u043e \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e\u0441\u0442\u0456, \u0432\u0456\u043d \u043c\u043e\u0436\u0435 \u0442\u043e\u043d\u043a\u043e \u043d\u0430\u0434\u0430\u0432\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u043f\u0435\u0432\u043d\u0438\u043c \u0444\u043e\u0440\u043c\u0430\u043c \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0457 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457 \u043d\u0430 \u0434\u043e\u0448\u0446\u0456, \u0449\u043e\u0431 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0437\u0430\u043f\u043e\u0431\u0456\u0433\u0430\u0442\u0438 \u0442\u0440\u0438\u0432\u0456\u0430\u043b\u044c\u043d\u0438\u043c \u0440\u0456\u0448\u0435\u043d\u043d\u044f\u043c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0434\u043e\u0432\u0433\u0456 \u043f\u0440\u044f\u043c\u0456 \u0431\u043b\u043e\u043a\u0438 (\u0444\u043e\u0440\u043c\u0430 \"I\") \u043c\u043e\u0436\u0443\u0442\u044c \u0437'\u044f\u0432\u043b\u044f\u0442\u0438\u0441\u044f \u0440\u0456\u0434\u0448\u0435, \u043a\u043e\u043b\u0438 \u0433\u0440\u0430\u043b\u044c\u043d\u0430 \u043f\u043b\u043e\u0449\u0430 \u0432\u0436\u0435 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u0430 \u0431\u0430\u0433\u0430\u0442\u044c\u043c\u0430 \u043f\u0440\u043e\u0433\u0430\u043b\u0438\u043d\u0430\u043c\u0438. \u0429\u043e\u0431 \u043a\u0440\u0430\u0449\u0435 \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u0438\u0441\u044f \u0437 \u0446\u0438\u043c \u044f\u0432\u043d\u0438\u043c \u0443\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f\u043c, \u043f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u043e \u0442\u0435, \u044f\u043a \u043a\u043e\u043b\u043e\u0434\u0430 \u043a\u0430\u0440\u0442 \"\u043f\u0435\u0440\u0435\u0442\u0430\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f\", \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0442\u0438\u0441\u044f, \u0449\u043e \u0432\u043e\u043d\u0430 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0430. \u041f\u0440\u043e\u0442\u0435 \u043d\u0430\u0441\u043f\u0440\u0430\u0432\u0434\u0456 \u0446\u0435 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043d\u0435 \u0437\u043e\u0432\u0441\u0456\u043c \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e. \u0413\u0440\u0430\u0432\u0446\u0456, \u044f\u043a\u0456 \u0432\u043f\u0456\u0437\u043d\u0430\u044e\u0442\u044c \u043d\u0430\u0439\u0447\u0430\u0441\u0442\u0456\u0448\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u043d\u0456 \u0431\u043b\u043e\u043a\u0438 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0441\u0442\u0430\u043d\u0443 \u0433\u0440\u0438, \u043c\u0430\u044e\u0442\u044c \u0437\u043d\u0430\u0447\u043d\u0443 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0432 Cubinko."}, {"question": "Cubinko \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437: \u042f\u043a\u0456 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438 \u0441\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438 \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u0444\u0430\u0439\u043b\u0443 \u0433\u0440\u0438 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445 \u0431\u0435\u0437 \u0432\u043f\u043b\u0438\u0432\u0443 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0430\u043a\u0442\u0438\u0432\u0456\u0432/\u0434\u0430\u043d\u0438\u0445?", "answer": "\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 \u043c\u0430\u043b\u043e\u0433\u043e \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u0444\u0430\u0439\u043b\u0443 \u0431\u0435\u0437 \u0432\u043f\u043b\u0438\u0432\u0443 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0430\u043a\u0442\u0438\u0432\u0456\u0432 \u0443 Cubinko, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044e \u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u0441\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445. \u0421\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u0442\u0435\u043a\u0441\u0442\u0443\u0440 \u0454 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0438\u043c. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438, \u044f\u043a PNG \u0430\u0431\u043e JPEG, \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0431\u0430\u043b\u0430\u043d\u0441 \u043c\u0456\u0436 \u043a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442\u043e\u043c \u0441\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u044f\u043a\u0456\u0441\u0442\u044e \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f. \u0414\u043b\u044f \u0434\u0430\u043d\u0438\u0445 \u0433\u0440\u0438 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0438, \u044f\u043a ZLib \u0430\u0431\u043e Deflate, \u0441\u0442\u0438\u0441\u043a\u0430\u044e\u0442\u044c \u0434\u0430\u043d\u0456 \u0440\u0456\u0432\u043d\u044f \u0442\u0430 \u0456\u043d\u0448\u0456 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457 \u0433\u0440\u0438. \u042f\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u043a\u043e\u0434\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u0430\u043d\u0456 \u043c\u0435\u0440\u0435\u0436\u0456 \u0442\u0430 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0456\u0457. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, ZLib \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0443 \u0431\u0430\u0433\u0430\u0442\u044c\u043e\u0445 \u0432\u0435\u0431-\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0456\u044f\u0445 \u0434\u043b\u044f \u0441\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u043a\u043e\u0434\u0443 \u0434\u043b\u044f \u0448\u0432\u0438\u0434\u0448\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f. \u0413\u043e\u043b\u043e\u0432\u043d\u0435 - \u043f\u0440\u043e\u0444\u0456\u043b\u044e\u0432\u0430\u0442\u0438 \u0434\u0432\u0438\u0436\u043e\u043a, \u0449\u043e \u043f\u0440\u0430\u0446\u044e\u0454 \u0437 \u0433\u0440\u043e\u044e \u043d\u0430 \u0432\u0441\u0456\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445, \u0449\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u044f\u043a\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0441\u0442\u0438\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u044e\u0442\u044c \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438."}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0433\u0440\u0438 Cubinko \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445? \u042f\u043a\u0456 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0438 \u043c\u0456\u0433\u0440\u0430\u0446\u0456\u0457 \u0434\u0430\u043d\u0438\u0445 \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438 iOS \u0442\u0430 Android \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043e\u0434\u043d\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443?", "answer": "\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 Cubinko \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0440\u0435\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u0433\u0440\u0438. \u042f\u043a\u0449\u043e \u0433\u0440\u0430 \u043d\u0430\u0434\u0430\u0454 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u0443 \u0437 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u043c \u0437\u0430\u043f\u0438\u0441\u043e\u043c (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, Google Play Games, Apple Game Center \u0430\u0431\u043e \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 Cubinko), \u0432\u0438, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438 iOS \u0442\u0430 Android. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0433\u0440\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 Google Play Games, \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0443 \u0441\u0432\u0456\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u041c\u0456\u0433\u0440\u0430\u0446\u0456\u044f \u0434\u0430\u043d\u0438\u0445 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u044e \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0446\u0435 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0442\u043e\u0433\u043e, \u043d\u0430\u0434\u0430\u0454 \u0447\u0438 \u043d\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a \u0446\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u044e."}, {"question": "Cubinko \u043f\u043e\u0448\u0443\u043a \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c: \u0427\u0438 \u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u0456 \u0437 \u0431\u0430\u0433\u0430\u0442\u043e\u0440\u0430\u0437\u043e\u0432\u0438\u043c \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f\u043c \u0433\u0440\u0438 \u0430\u0431\u043e \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f\u043c \u043f\u0435\u0432\u043d\u0438\u0445 \u043f\u043e\u0440\u043e\u0433\u043e\u0432\u0438\u0445 \u0437\u043d\u0430\u0447\u0435\u043d\u044c \u0431\u0430\u043b\u0456\u0432?", "answer": "Cubinko, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u043c\u0430\u0454 \u0440\u044f\u0434 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u044c \u0430\u0431\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c, \u0449\u043e\u0431 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438\u0442\u0438 \u043f\u0440\u0438\u0441\u0432\u044f\u0447\u0435\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432. \u0414\u0435\u044f\u043a\u0456 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0442\u0438\u043f\u0438 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c - \u0446\u0435 \u043f\u0435\u0432\u043d\u0456 \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0456 \u0437\u043c\u0456\u043d\u0438, \u043a\u043e\u043b\u0438 \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u043f\u0435\u0432\u043d\u0438\u0439 \u0432\u0438\u0441\u043e\u043a\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f \u0447\u0430\u0441\u0442\u043e \u0437\u0430\u043a\u043e\u0434\u043e\u0432\u0430\u043d\u0456 \u0437\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0432\u0430\u043d\u0438\u043c\u0438 \u0434\u0456\u044f\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0434\u043e\u0448\u043a\u0438 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0431\u043b\u043e\u043a\u0430\u043c\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u043a\u043e\u043b\u044c\u043e\u0440\u0443 \u0432\u0456\u0434\u043e\u043c\u043e \u044f\u043a \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0442\u044f \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0448\u043a\u0456\u0440\u044f\u043d\u043e\u0433\u043e \u043a\u043e\u0441\u0442\u044e\u043c\u0443 \u0434\u043b\u044f \u0433\u0440\u0438, \u0437\u043c\u0456\u043d\u044e\u044e\u0447\u0438 \u0432\u0438\u0433\u043b\u044f\u0434 \u0431\u043b\u043e\u043a\u0456\u0432. \u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u0440\u0456\u0437\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0442\u0430 \u043f\u043e\u0440\u043e\u0433\u043e\u0432\u0456 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0431\u0430\u043b\u0456\u0432, \u0449\u043e\u0431 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438 \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u0438. \u0423 \u0431\u0430\u0433\u0430\u0442\u044c\u043e\u0445 \u0432\u0438\u043f\u0430\u0434\u043a\u0430\u0445 \u043a\u043e\u0440\u0438\u0441\u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0444\u043e\u0440\u0443\u043c\u0438 Cubinko \u0432 \u0406\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0456, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u044f\u043a \u0456\u043d\u0448\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u044e\u0442\u044c \u0441\u0432\u043e\u0457 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f. \u0417\u0432\u0435\u0440\u0442\u0430\u0439\u0442\u0435 \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u0433\u0440\u0443 - \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043f\u0456\u0441\u043b\u044f \u0435\u0442\u0430\u043f\u0456\u0432 \u0433\u0440\u0438 \u0432\u043e\u043d\u0438 \u0434\u0430\u044e\u0442\u044c \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438."}, {"question": "Cubinko \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0456 \u0433\u0440\u0430\u0432\u0446\u0456: \u0427\u0438 \u0454 Cubinko \u0431\u0456\u043b\u044c\u0448\u0435 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u043e\u044e \u043d\u0430 \u0443\u0434\u0430\u0447\u0456 \u0447\u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457? \u042f\u043a\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0438 \u0433\u0440\u0438 \u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0456 \u0434\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0432\u0438\u0449\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443?", "answer": "Cubinko \u043f\u043e\u0454\u0434\u043d\u0443\u0454 \u0432 \u0441\u043e\u0431\u0456 \u0443\u0434\u0430\u0447\u0443 \u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e, \u0430\u043b\u0435 \u0443\u0441\u043f\u0456\u0445 \u0431\u0456\u043b\u044c\u0448\u0435 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438. \u0425\u043e\u0447\u0430 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0456\u0441\u0442\u044c \u0444\u043e\u0440\u043c \u0431\u043b\u043e\u043a\u0456\u0432 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0430, \u0432\u0430\u0448\u0430 \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0442\u0438 \u0442\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0456\u043d\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0442\u0438 \u0446\u0456 \u0431\u043b\u043e\u043a\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0432\u0430\u0448 \u0443\u0441\u043f\u0456\u0445. \u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0438 \u0433\u0440\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442:\n1. \u041f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0430 \u0445\u043e\u0434\u0456\u0432 \u0443\u043f\u0435\u0440\u0435\u0434.\n2. \u0411\u0430\u043b\u0430\u043d\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0433\u0430\u0439\u043d\u043e\u0433\u043e \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432 \u0437 \u0434\u043e\u0432\u0433\u043e\u0441\u0442\u0440\u043e\u043a\u043e\u0432\u043e\u044e \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u0454\u044e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443.\n3. \u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0438\u0445 \u0440\u0435\u0430\u043a\u0446\u0456\u0439. \u0423\u0434\u0430\u0447\u0430 \u043c\u043e\u0436\u0435 \u0432\u0456\u0434\u0456\u0433\u0440\u0430\u0432\u0430\u0442\u0438 \u043d\u0435\u0432\u0435\u043b\u0438\u043a\u0443 \u0440\u043e\u043b\u044c, \u043a\u043e\u043b\u0438 \u0432\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u0435 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0431\u043b\u043e\u043a \u0443 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0447\u0430\u0441. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0456\u043d\u043e\u0434\u0456 \u0434\u043e\u0432\u0433\u0438\u0439 \u043f\u0440\u044f\u043c\u0438\u0439 \u0431\u043b\u043e\u043a \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 4 \u0440\u044f\u0434\u043a\u0438 \u0456 \u043f\u0440\u043e\u0439\u0442\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c. Cubinko \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u043e \u0434\u043b\u044f \u0432\u0438\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0438\u0445 \u043d\u0430\u0432\u0438\u0447\u043e\u043a \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0442\u043e\u0433\u043e, \u0449\u043e \u0432\u0430\u043c \u0432\u0438\u043a\u0438\u0434\u0430\u0454."}, {"question": "\u042f\u043a \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 Cubinko? \u041f\u043e\u044f\u0441\u043d\u0456\u0442\u044c \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0456\u044e \"\u043a\u043e\u043b\u043e\u0434\u044f\u0437\u044f\" \u044f\u043a \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043b\u044f \u0433\u0440\u0438 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f.", "answer": "\u041e\u0434\u043d\u0456\u0454\u044e \u0437 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f Cubinko \u0454 \u043e\u043f\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0456\u0457 \"\u043a\u043e\u043b\u043e\u0434\u044f\u0437\u044f\". \u0426\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0435 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f, \u0434\u0435 \u0432\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u0435 \u0434\u043e\u0432\u0433\u0438\u0439 \u0456 \u0432\u0443\u0437\u044c\u043a\u0438\u0439 \u0441\u0442\u043e\u0432\u043f\u0435\u0446\u044c (\u043a\u043e\u043b\u043e\u0434\u044f\u0437\u044c). \u0426\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043f\u0440\u044f\u043c\u0438\u0445 \u0431\u043b\u043e\u043a\u0456\u0432 \u0444\u043e\u0440\u043c\u0438 \"I\", \u0449\u043e\u0431 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043e\u0447\u0438\u0449\u0430\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0430 \u0440\u044f\u0434\u043a\u0456\u0432. \n\u041a\u0420\u041e\u041a 1: \u041f\u0456\u0434 \u0447\u0430\u0441 \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0431\u043b\u043e\u043a\u0456\u0432 \u0437\u0430\u043b\u0438\u0448\u0442\u0435 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 \u043e\u0434\u0438\u043d \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u0438\u0439 \u0441\u0442\u043e\u0432\u043f\u0435\u0446\u044c \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u043c.\n\u041a\u0420\u041e\u041a 2: \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043e\u0440\u0456\u0454\u043d\u0442\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0448\u0456 \u0431\u043b\u043e\u043a\u0438 \u0442\u0430\u043a, \u0449\u043e\u0431 \u0432\u043e\u043d\u0438 \u043c\u043e\u0433\u043b\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0456 \u043a\u043e\u043b\u043e\u0434\u044f\u0437\u0456.\n\u041a\u0420\u041e\u041a 3: \u0421\u0442\u0435\u0436\u0442\u0435 \u0437\u0430 \u043f\u0440\u044f\u043c\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0430\u043c\u0438.\n\u041f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u043e \u0446\u0435: \u0447\u0438\u043c \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u043a\u043e\u043b\u043e\u0434\u044f\u0437\u044c, \u0442\u0438\u043c \u0431\u0456\u043b\u044c\u0448\u0430 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0440\u044f\u0434\u043a\u0456\u0432 \u0448\u043b\u044f\u0445\u043e\u043c \u0440\u043e\u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f \u0437\u043d\u0438\u0437\u0443. \u0411\u0435\u0437 \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430 \u043a\u043e\u043b\u043e\u0434\u044f\u0437\u044f, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u044f\u0434\u043a\u0456\u0432 \u0437\u043c\u0435\u043d\u0448\u0443\u0454\u0442\u044c\u0441\u044f. \u0412\u043e\u043d\u0430 \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u043e\u044e \u044f\u043a \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043d\u0430\u0439\u0432\u0438\u0449\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u0443 Cubinko."}]
[{"question": "Cubinko \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ub3c4\uc6c0 \uc694\uccad: \ucc98\uc74c\uc5d0 \ube14\ub85d\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \ud68c\uc804\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Cubinko \ucd08\ubcf4\uc790\ub85c\uc11c \ud6a8\uc728\uc801\uc73c\ub85c \ube14\ub85d\uc744 \uc774\ub3d9\ud558\uace0 \ud68c\uc804\ud558\ub294 \uac83\uc740 \uae30\ubcf8\uc801\uc785\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud65c\uc131 \ube14\ub85d\uc744 \uc88c\uc6b0\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. 'A' \ud0a4\uc640 'D' \ud0a4(\ub610\ub294 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\ub4f1\ud55c \ud0a4)\ub97c \uc0ac\uc6a9\ud558\uc5ec \ube14\ub85d\uc744 \uc2dc\uacc4 \ubc29\ud5a5 \ub610\ub294 \ubc18\uc2dc\uacc4 \ubc29\ud5a5\uc73c\ub85c \ud68c\uc804\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'L' \ubaa8\uc591\uc758 \ube14\ub85d\uc774 \uc788\ub2e4\uba74 \ubaa8\uc11c\ub9ac\uc5d0 \uc644\ubcbd\ud558\uac8c \ub9de\ucd9c \uc218 \uc788\ub3c4\ub85d \ud68c\uc804\ud558\uace0 \uc2f6\uc744 \uac83\uc785\ub2c8\ub2e4. \uacf5\uac04 \ud65c\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \ube60\ub974\uace0 \uacb0\uc815\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \ud14c\ud2b8\ub9ac\uc2a4 \ucd08\uae09 \ub808\ubca8\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ub2e4\uc74c \ube14\ub85d \ubbf8\ub9ac\ubcf4\uae30\uc640 \uac19\uc740 \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \uc0ac\uc6a9\ud558\uba74 \ud070 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ucd08\uae30\uc5d0 \uc2e4\ud328\ud55c \ubc30\uce58\ub294 \ucd1d \uac00\ub2a5\ud55c \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Cubinko\uac00 \uc911\ub3c5\uc131\uc774 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694? \uc218\ub9ce\uc740 \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud6c4\uc5d0\ub3c4 \ud50c\ub808\uc774\uc5b4\ub97c \uc0ac\ub85c\uc7a1\ub294 '\ubab0\uc785 \uc0c1\ud0dc'\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Cubinko\uc758 \uc911\ub3c5\uc131\uc740 '\ubab0\uc785 \uc0c1\ud0dc'\ub97c \uc870\uc7a5\ud558\ub294 \uc6b0\uc544\ud55c \ub514\uc790\uc778\uc5d0\uc11c \ube44\ub86f\ub429\ub2c8\ub2e4. \uc774\ub294 \ub09c\uc774\ub3c4\uc640 \uae30\uc220 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \ud1b5\ud574 \ub2ec\uc131\ub429\ub2c8\ub2e4. \ubaa8\ub4e0 \ubc30\uce58 \uacb0\uc815\uc740 \uadf8\ub9ac\ub4dc \ub0b4\uc5d0\uc11c \ub77c\uc778\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc9c0\uc6b8 \uc218 \uc788\ub294 \ub2a5\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uac01 \ud074\ub9ac\uc5b4\ub41c Cubinko \ub77c\uc778\uc740 \uc989\uac01\uc801\uc778 \uae0d\uc815\uc801\uc778 \ud53c\ub4dc\ubc31\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \ub77c\uc778\uc744 \ub3d9\uc2dc\uc5d0 \uc9c0\uc6b0\uba74 \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uce90\uc2a4\ucf00\uc774\ub4dc \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uac8c\ub2e4\uac00, \uc774 \uac8c\uc784\uc740 \uc678\uad00\uc0c1\uc73c\ub85c\ub294 \ub9e4\uc6b0 \uac04\ub2e8\ud558\uac8c \uc124\uacc4\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \uc0c1\ub2f9\ud55c \uacf5\uac04\uc801 \uc0ac\uace0 \ub2a5\ub825\uacfc \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uad00\uc2ec\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc9c0\uc18d\uc801\uc778 \uc219\ub2ec\uac10\uacfc \uc9c4\ubcf4\uac10\uc744 \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "Cubinko \uace0\uae09 \ubb38\uc81c: \uc810\uc218 \uc870\ud569 \uccb4\uc778\uc744 \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud55c \ud65c\uc6a9\ub3c4\uac00 \ub0ae\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Cubinko\uc5d0\uc11c \uc810\uc218 \uc870\ud569\uc744 \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \ud328\ud134 \uc778\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\ub2e8\uacc4 1: \ud2c8\uc0c8\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \ub0a8\uaca8\ub450\uc5b4 \ub2e4\uc911 \ub77c\uc778 \ud074\ub9ac\uc5b4 \uae30\ud68c\ub97c \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694.\n\ub2e8\uacc4 2: \uc218\uc9c1 \ub4dc\ub86d\uc744 \uc720\ubc1c\ud558\ub294 \uc218\ud3c9 \ub77c\uc778\uc744 \uc0ac\uc6a9\ud558\uc5ec \uccb4\uc778 \ubc18\uc751\uc744 \uc124\uc815\ud558\uc138\uc694.\n\ub2e8\uacc4 3: \ube14\ub85d \ubc30\uce58\ub97c \ucd5c\uc801\ud654\ud558\uc5ec \uc7a0\uc7ac\uc801\uc778 \uce90\uc2a4\ucf00\uc774\ub4dc \ud6a8\uacfc\ub97c \ub9cc\ub4dc\uc138\uc694. \uc774\ub294 \uc81c\ud55c\ub41c \uacf5\uac04\uc744 \ub354 \uc798 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \ubcf8\uc9c8\uc801\uc73c\ub85c \ubaa9\ud45c\ub294 \uccb4\uc778 \ubc18\uc751\uc744 \uc124\uc815\ud558\uace0 \uac8c\uc784 \uc694\uc18c\ub97c \ud65c\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc870\ud569\uc744 \uc5bb\uae30 \uc704\ud574 \ub77c\uc778\uc744 \uc644\ub8cc\ud560 \uc218 \uc788\ub3c4\ub85d \ube14\ub85d\uc744 \ubc30\uce58\ud558\ub294 \uac83\uc774 \uc608\uac00 \ub420 \uac83\uc785\ub2c8\ub2e4. \ub3c4\ubbf8\ub178\uac00 \uc81c\uc790\ub9ac\uc5d0 \ub193\uc774\ub294 \uac83\uc744 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694. \uc138\uc2ec\ud55c \uacc4\ud68d\uc774 \uc810\uc218 \ucd5c\uc801\ud654\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4."}, {"question": "Cubinko\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc744 \uc124\uba85\ud574\uc8fc\uc138\uc694. \uac01 \ube14\ub85d \ubc30\uce58\uc640 \ub77c\uc778 \ud074\ub9ac\uc5b4\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \uacb0\uc815\ud558\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Cubinko\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2e8\uc77c \ud134\uc5d0\uc11c \uc81c\uac70\ub41c \ud050\ube0c \uc218\uc758 \ud568\uc218\uc785\ub2c8\ub2e4. \uc810\uc218\ub294 \ube14\ub85d \ubc30\uce58 \ubaa8\ub450\uc5d0 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc8fc\uc694 \ucd9c\ucc98\ub294 \ub77c\uc778 \uc644\ub8cc\uc5d0 \uc218\uc5ec\ub429\ub2c8\ub2e4. \uc5bb\ub294 \uc810\uc218\ub294 \ub3d9\uc2dc\uc5d0 \uc9c0\uc6cc\uc9c4 \ub77c\uc778 \uc218\uc5d0 \uc815\ube44\ub840\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ub77c\uc778\uc744 \uc9c0\uc6b0\uba74 100\uc810\uc774 \ubd80\uc5ec\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud55c \ubc88\uc5d0 \ub450 \uac1c\uc758 \ub77c\uc778\uc744 \uc9c0\uc6b0\uba74 300\uc810\uacfc \uac19\uc740 \ubcf4\ub108\uc2a4\uac00 \uc8fc\uc5b4\uc9c0\uace0 \uc138 \uac1c \uc774\uc0c1\uc758 \ub77c\uc778\uc744 \uc9c0\uc6b0\uba74 \uc810\uc810 \ub354 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ubc30\uce58\ub3c4 \uc911\uc694\ud558\uba70, \ud070 \ube14\ub85d\uc744 \ubc30\uce58\ud558\uba74 \uc810\uc218\uac00 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcf4\ub108\uc2a4\ub294 \uc774\ub7ec\ud55c \ub2e4\uc911 \ub77c\uc778 \uc81c\uac70\ub97c \uc0dd\uc131\ud558\uae30 \uc704\ud55c \ube14\ub85d\uc758 \uc804\ub7b5\uc801 \ubc30\uc5f4\uc744 \ubcf4\uc0c1\ud558\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub124 \uac1c\uc758 \ub77c\uc778\uc744 \uc9c0\uc6b0\uba74 \uc885\uc885 \uc0c1\ub2f9\ud55c \ubc30\uc218\ub85c \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uac8c \ub429\ub2c8\ub2e4. \ub530\ub77c\uc11c \ub77c\uc778 \ud074\ub9ac\uc5b4 \ucd5c\uc801\ud654\uac00 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. \ube14\ub85d \ud06c\uae30\uc5d0 \ub530\ub77c \uacf1\uc148\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ube14\ub85d\uc774 \ud074\uc218\ub85d \uacf1\uc148\uae30\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4."}, {"question": "Cubinko \uace0\uc218\ub2d8\uaed8 \uc9c8\ubb38\ub4dc\ub9bd\ub2c8\ub2e4. \ube14\ub85d \ubaa8\uc591\uc758 \ubd84\ud3ec\uac00 \ud1b5\uacc4\uc801\uc73c\ub85c \uce58\uc6b0\uccd0 \ubcf4\uc774\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694? \uac8c\uc784\uc758 \ud2b9\uc815 \ub2e8\uacc4\uc5d0\uc11c \ub35c \uc790\uc8fc \ub098\ud0c0\ub098\ub294 \ud2b9\uc815 \ubaa8\uc591\uc774 \uc788\ub098\uc694?", "answer": "Cubinko\uc5d0\uc11c \ube14\ub85d \ubaa8\uc591\uc758 \ubd84\ud3ec\uac00 \uce58\uc6b0\uccd0 \ubcf4\uc774\ub294 \uac83\uc740 \uac8c\uc784\uc758 \uc808\ucc28\uc801 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc791\uc704\uc131\uc744 \uc9c0\ud5a5\ud558\uc9c0\ub9cc \ud2b9\uc815 \ubaa8\uc591\uc5d0 \ud604\uc7ac \ubcf4\ub4dc \uc0c1\ud0dc\ub97c \uae30\ubc18\uc73c\ub85c \ubbf8\ubb18\ud558\uac8c \uc6b0\uc120\uc21c\uc704\ub97c \ubd80\uc5ec\ud558\uc5ec \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \uc720\uc9c0\ud558\uace0 \uc0ac\uc18c\ud55c \ud574\uacb0\ucc45\uc744 \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774 \ud544\ub4dc\uac00 \uc774\ubbf8 \ub9ce\uc740 \ube48 \uacf5\uac04\uc73c\ub85c \ucc44\uc6cc\uc838 \uc788\uc744 \ub54c \uae34 \uc9c1\uc120 \ube14\ub85d( 'I' \ubaa8\uc591)\uc774 \ub35c \uc790\uc8fc \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba85\ubc31\ud55c \ud3b8\ud5a5\uc744 \ucc98\ub9ac\ud558\ub294 \ubc29\ubc95\uc744 \uac1c\uc120\ud558\ub824\uba74 \uce74\ub4dc \ub371\uc774 '\uc11e\uc774\ub294' \ubc29\ubc95\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uadf8\ub7ec\ub098 \uc2e4\uc81c\ub85c\ub294 \uc774\uac83\uc774 \uc77c\ubc18\uc801\uc73c\ub85c \uc2e4\uc81c\ub85c \uc644\uc804\ud788 \ubb34\uc791\uc704\uc778 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uac8c\uc784 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \uac00\uc7a5 \ub9ce\uc774 \uc0ac\uc6a9\ub418\ub294 \ube14\ub85d\uc744 \uc778\uc2dd\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub294 Cubinko\uc5d0\uc11c \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uac00\uc9d1\ub2c8\ub2e4."}, {"question": "Cubinko \uae30\uc220 \ubd84\uc11d: \uac8c\uc784\uc758 \ud30c\uc77c \ud06c\uae30\ub97c \uc720\uc9c0\ud558\uba74\uc11c \uc790\uc0b0/\ub370\uc774\ud130 \ub85c\ub529 \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uc73c\ub824\uba74 \uc5b4\ub5a4 \ub370\uc774\ud130 \uc555\ucd95 \uc54c\uace0\ub9ac\uc998\uc774 \uc0ac\uc6a9\ub418\ub098\uc694?", "answer": "Cubinko\uc5d0\uc11c \uc790\uc0b0 \ub85c\ub529 \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uace0 \uc791\uc740 \ud30c\uc77c \ud06c\uae30\ub97c \uc720\uc9c0\ud558\ub824\uba74 \uc77c\ubc18\uc801\uc73c\ub85c \ub370\uc774\ud130 \uc555\ucd95 \uae30\ubc95\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud14d\uc2a4\ucc98 \uc555\ucd95\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. PNG \ub610\ub294 JPEG\uc640 \uac19\uc740 \uc54c\uace0\ub9ac\uc998\uc740 \uc555\ucd95\ub960\uacfc \uc774\ubbf8\uc9c0 \ud488\uc9c8 \uc0ac\uc774\uc758 \uade0\ud615\uc73c\ub85c \uc778\ud574 \uc77c\ubc18\uc801\uc73c\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uac8c\uc784 \ub370\uc774\ud130\uc758 \uacbd\uc6b0 ZLib \ub610\ub294 Deflate\uc640 \uac19\uc740 \uc54c\uace0\ub9ac\uc998\uc740 \ub808\ubca8 \ub370\uc774\ud130\uc640 \ub2e4\ub978 \uac8c\uc784 \uad6c\uc131\uc744 \uc555\ucd95\ud569\ub2c8\ub2e4. \uba54\uc2dc \ubc0f \uae30\ud558 \ub370\uc774\ud130\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc778\ucf54\ub529\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, ZLib\uc740 \ub9ce\uc740 \uc6f9 \uae30\uc220\uc5d0\uc11c \ucf54\ub4dc\ub97c \uc555\ucd95\ud558\uc5ec \ub2e4\uc6b4\ub85c\ub4dc \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ud575\uc2ec\uc740 \ubaa8\ub4e0 \uc7a5\uce58\uc5d0\uc11c \uac8c\uc784\uc744 \uc2e4\ud589\ud558\ub294 \uc5d4\uc9c4\uc744 \ud504\ub85c\ud30c\uc77c\ub9c1\ud558\uc5ec \ucd5c\uc801\uc758 \uacb0\uacfc\ub97c \uc5bb\ub294 \uc555\ucd95 \uc804\ub7b5\uc744 \uacb0\uc815\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."}, {"question": "iOS \ubc0f Android \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec Cubinko \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc Cubinko \uc800\uc7a5 \ub370\uc774\ud130 \ub3d9\uae30\ud654\uc5d0 \ub300\ud55c \uc9c0\uc6d0\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uad6c\ud604\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uac8c\uc784\uc5d0 \uacc4\uc815(\uc608: Google Play \uac8c\uc784, Apple \uac8c\uc784 \uc13c\ud130 \ub610\ub294 \uc804\uc6a9 Cubinko \uacc4\uc815)\uc5d0 \uc5f0\uacb0\ub41c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\uba74 iOS \ubc0f Android \uae30\uae30 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc5d0 Google Play \uac8c\uc784\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc740 \uc218\ub3d9 \ubc31\uc5c5 \ubc0f \ubcf5\uc6d0 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\ub3c4 \uac00\ub2a5\ud558\uc9c0\ub9cc \uac1c\ubc1c\uc790\uac00 \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \uc81c\uacf5\ud558\ub294\uc9c0 \uc5ec\ubd80\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."}, {"question": "Cubinko\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8 \ub610\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac8c\uc784\uc744 \uc5ec\ub7ec \ubc88 \uc644\ub8cc\ud558\uac70\ub098 \ud2b9\uc815 \uc810\uc218 \uc784\uacc4\uce58\ub97c \ub2ec\uc131\ud558\ub294 \uac83\uacfc \uad00\ub828\ub418\uc5b4 \uc788\ub098\uc694?", "answer": "Cubinko\ub294 \uc5f4\uc131\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud558\uae30 \uc704\ud574 \uc5ec\ub7ec \uac1c\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \uc81c\uacf5\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc720\ud615 \uc911 \ud558\ub098\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud2b9\uc815 \uace0\uc810\uc218\ub97c \uc5bb\uc744 \ub54c \ud2b9\uc815 \uc2dc\uac01\uc801 \ubcc0\ud654\uc785\ub2c8\ub2e4. \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubc18\ubcf5\uc801\uc778 \ud589\ub3d9 \ub4a4\uc5d0 \uc790\uc8fc \uc7a0\uaca8 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\ub4dc\ub97c \ub3d9\uc77c\ud55c \uc0c9\uc0c1\uc758 \ube14\ub85d\uc73c\ub85c \uc644\uc804\ud788 \ucc44\uc6b0\uba74 \ube14\ub85d\uc758 \ubaa8\uc591\uc744 \ubc14\uafb8\ub294 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130 \uc2a4\ud0a8\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \uc804\ub7b5\uacfc \uc810\uc218 \uc784\uacc4\uac12\uc744 \ud0d0\uc0c9\ud558\uc5ec \uc11c\ud504\ub77c\uc774\uc988\ub97c \ubc1c\uacac\ud558\uc138\uc694. \ub9ce\uc740 \uacbd\uc6b0 Cubinko \ud3ec\ub7fc\uc744 \uc628\ub77c\uc778\uc73c\ub85c \ud655\uc778\ud558\uc5ec \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud55c \uac83\uc744 \uac8c\uc2dc\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ubc1c\ud45c\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \ub9c8\uc77c\uc2a4\ud1a4\uc774 \uc9c0\ub09c \ud6c4 \ud78c\ud2b8\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Cubinko\ub294 \uc6b4\uc5d0 \uae30\ubc18\ud55c \uac8c\uc784\uc778\uac00\uc694 \uc544\ub2c8\uba74 \uc804\ub7b5\uc5d0 \uae30\ubc18\ud55c \uac8c\uc784\uc778\uac00\uc694? \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub354 \uc911\uc694\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Cubinko\ub294 \uc6b4\uacfc \uc804\ub7b5\uc758 \ud63c\ud569\uc774\uc9c0\ub9cc \uc131\uacf5\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uc790\uc6d0 \uad00\ub9ac\uc5d0 \ub354 \ud06c\uac8c \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \ube14\ub85d \ubaa8\uc591\uc758 \uc21c\uc11c\ub294 \ubb34\uc791\uc704\uc774\uc9c0\ub9cc, \uc774\ub7ec\ud55c \ube14\ub85d\uc744 \uc608\uc0c1\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ud1b5\ud569\ud558\ub294 \ub2a5\ub825\uc774 \uc131\uacf5\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4. \ub2e4\uc74c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc774 \uacb0\uacfc\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4.\n1. \uc5ec\ub7ec \ub2e8\uacc4 \uc55e\uc11c \uacc4\ud68d\ud558\uae30\n2. \uc989\uac01\uc801\uc778 \ub77c\uc778 \ud074\ub9ac\uc5b4\uc640 \uc7a5\uae30\uc801\uc778 \uacf5\uac04 \ucd5c\uc801\ud654 \uade0\ud615 \ub9de\ucd94\uae30\n3. \uccb4\uc778 \ubc18\uc751\uc744 \ub9cc\ub4dc\ub294 \uae30\ud68c\ub97c \uc778\uc2dd\ud558\uace0 \ud65c\uc6a9\ud558\uae30\uc6b4\uc740 \ucd5c\uace0\uc758 \uc21c\uac04\uc5d0 \uc644\ubcbd\ud55c \uc870\uac01\uc744 \uc5bb\uc744 \ub54c \uc791\uc740 \uc5ed\ud560\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub54c\ub54c\ub85c \uae34 \uc9c1\uc120 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uba74 4\uac1c\uc758 \ub77c\uc778\uc744 \uc9c0\uc6b0\uace0 \ub2e4\uc74c \ub808\ubca8\uc744 \ud1b5\uacfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Cubinko\ub294 \uc5b4\ub5a4 \uac83\uc774 \ub358\uc838\uc9c0\ub4e0 \uacc4\ud68d \ub2a5\ub825\uc744 \uc2dc\ud5d8\ud558\uae30 \uc704\ud574 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "Cubinko\uc5d0\uc11c \uc2e4\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uace0\uc218 \ud50c\ub808\uc774\uc5d0\uc11c '\uc6b0\ubb3c' \uac1c\ub150\uc744 \uc804\ub7b5\uc73c\ub85c \uc124\uba85\ud574\uc8fc\uc138\uc694.", "answer": "Cubinko\uc5d0\uc11c \uc2e4\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud55c \uac00\uc9c0 \uc804\ub7b5\uc740 '\uc6b0\ubb3c' \uac1c\ub150\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\uac83\uc740 \uc5ec\ub7ec \uc904\uc758 \uc881\uc740 \uc5f4( '\uc6b0\ubb3c')\uc744 \ub9cc\ub4dc\ub294 \uc804\ub7b5\uc801 \ubc30\uce58\uc785\ub2c8\ub2e4. \uc774\ub294 \ud6a8\uc728\uc801\uc73c\ub85c \uc5ec\ub7ec \uc904\uc744 \uc9c0\uc6b0\uae30 \uc704\ud574 \uc9c1\uc120\ud615 'I' \ubaa8\uc591\uc758 \ube14\ub85d\uc744 \ubc1b\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n\ub2e8\uacc4 1: \ube14\ub85d \ubc30\uce58 \uc911 \ud558\ub098\uc758 \uc218\uc9c1 \uc5f4\uc744 \ud65c\uc131 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\ub2e8\uacc4 2: \ub2e4\ub978 \ube14\ub85d\uc744 \ubc29\ud5a5\uc744 \ub9de\ucd94\uc5b4 \uc774\ub7ec\ud55c \uc720\uc6a9\ud55c \uc6b0\ubb3c\uc744 \uc0dd\uc131\ud558\ub824\uace0 \ud569\ub2c8\ub2e4.\n\ub2e8\uacc4 3: \uc9c1\uc120\ud615 \ube14\ub85d\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624.\uace0\ub824 \uc0ac\ud56d: \uc6b0\ubb3c\uc774 \ud074\uc218\ub85d, \uc544\ub798\uc5d0 \ub193\uc544 \uc5ec\ub7ec \uc904\uc744 \uc9c0\uc6b8 \uac00\ub2a5\uc131\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc2e0\uc911\ud55c \uacc4\ud68d \uc5c6\uc774 \uc6b0\ubb3c\uc744 \uad6c\ucd95\ud558\uba74 \ud6a8\uc728\uc801\uc73c\ub85c \ub77c\uc778\uc744 \uc9c0\uc6b8 \uac00\ub2a5\uc131\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. Cubinko\uc5d0\uc11c \ucd5c\uace0 \uc810\uc218\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc73c\ub85c\uc11c \uc911\uc694\ud569\ub2c8\ub2e4."}]
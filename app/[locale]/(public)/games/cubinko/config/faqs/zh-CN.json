[{"question": "Cubinko\u65b0\u624b\u6c42\u52a9\uff1a\u5982\u4f55\u6709\u6548\u5730\u79fb\u52a8\u548c\u65cb\u8f6c\u79ef\u6728\uff0c\u5c24\u5176\u662f\u5728\u6e38\u620f\u5f00\u59cb\u9636\u6bb5\uff1f", "answer": "\u5bf9\u4e8eCubinko\u65b0\u624b\u6765\u8bf4\uff0c\u9ad8\u6548\u5730\u79fb\u52a8\u548c\u65cb\u8f6c\u79ef\u6728\u81f3\u5173\u91cd\u8981\u3002\u901a\u5e38\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u65b9\u5411\u952e\u5de6\u53f3\u79fb\u52a8\u6d3b\u52a8\u79ef\u6728\u3002'A'\u952e\u548c'D'\u952e\uff08\u6216\u60a8\u5e73\u53f0\u4e0a\u7684\u7b49\u6548\u952e\uff09\u53ef\u4ee5\u987a\u65f6\u9488\u6216\u9006\u65f6\u9488\u65cb\u8f6c\u79ef\u6728\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u4e2a'L'\u5f62\u79ef\u6728\uff0c\u60a8\u53ef\u80fd\u5e0c\u671b\u5c06\u5176\u65cb\u8f6c\u4ee5\u5b8c\u7f8e\u5730\u5d4c\u5165\u89d2\u843d\u3002\u7ec3\u4e60\u5feb\u901f\u3001\u679c\u65ad\u7684\u52a8\u4f5c\uff0c\u4ee5\u4f18\u5316\u7a7a\u95f4\u5229\u7528\u7387\u3002\u60f3\u60f3\u4fc4\u7f57\u65af\u65b9\u5757\u7684\u65e9\u671f\u5173\u5361\u3002\u5229\u7528\u89c6\u89c9\u63d0\u793a\uff0c\u4f8b\u5982\u4e0b\u4e00\u4e2a\u79ef\u6728\u9884\u89c8\uff0c\u5c06\u5bf9\u60a8\u6709\u5f88\u5927\u5e2e\u52a9\u3002\u6e38\u620f\u521d\u671f\u653e\u7f6e\u5931\u8d25\u53ef\u80fd\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Cubinko\u5982\u6b64\u4e0a\u763e\uff1f\u662f\u4ec0\u4e48\u6837\u7684'\u5fc3\u6d41'\u72b6\u6001\u8ba9\u73a9\u5bb6\u5373\u4f7f\u5b8c\u6210\u8bb8\u591a\u5173\u5361\u540e\u4ecd\u7136\u7740\u8ff7\uff1f", "answer": "Cubinko\u7684\u4e0a\u763e\u6027\u6e90\u4e8e\u5176\u7cbe\u5999\u7684\u8bbe\u8ba1\uff0c\u5b83\u4fc3\u8fdb\u4e86\u201c\u5fc3\u6d41\u201d\u72b6\u6001\u3002\u8fd9\u662f\u901a\u8fc7\u6311\u6218\u548c\u6280\u80fd\u4e4b\u95f4\u7684\u5e73\u8861\u5b9e\u73b0\u7684\u3002\u6bcf\u4e00\u6b21\u653e\u7f6e\u51b3\u7b56\u90fd\u4f1a\u5f71\u54cd\u60a8\u5728\u7f51\u683c\u8303\u56f4\u5185\u6709\u6548\u6e05\u9664\u7ebf\u6761\u7684\u80fd\u529b\u3002\u6bcf\u6b21\u6e05\u9664\u7684\u79ef\u6728\u7ebf\u90fd\u4f1a\u63d0\u4f9b\u5373\u65f6\u79ef\u6781\u53cd\u9988\u3002\u4f8b\u5982\uff0c\u540c\u65f6\u6e05\u9664\u591a\u884c\u79ef\u6728\u4f1a\u4ea7\u751f\u4ee4\u4eba\u6ee1\u610f\u7684\u8fde\u9501\u53cd\u5e94\u3002\u6b64\u5916\uff0c\u8fd9\u6b3e\u6e38\u620f\u5728\u5916\u89c2\u4e0a\u8bbe\u8ba1\u5f97\u4ee4\u4eba\u96be\u4ee5\u7f6e\u4fe1\u5730\u7b80\u5355\u3002\u4f46\u662f\uff0c\u5b83\u9700\u8981\u76f8\u5f53\u591a\u7684\u7a7a\u95f4\u63a8\u7406\u548c\u6218\u7565\u89c4\u5212\u624d\u80fd\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u8fd9\u4f1a\u6301\u7eed\u8425\u9020\u51fa\u7cbe\u901a\u548c\u8fdb\u6b65\u7684\u611f\u89c9\uff0c\u8fd9\u662f\u6e38\u620f\u7ef4\u6301\u73a9\u5bb6\u5174\u8da3\u7684\u5173\u952e\u56e0\u7d20\u3002"}, {"question": "Cubinko\u8fdb\u9636\u95ee\u9898\uff1a\u6709\u54ea\u4e9b\u672a\u5145\u5206\u5229\u7528\u7684\u7b56\u7565\u53ef\u4ee5\u6700\u5927\u5316\u8fde\u51fb\u5f97\u5206\uff1f", "answer": "\u5728Cubinko\u4e2d\u6700\u5927\u5316\u8fde\u51fb\u5f97\u5206\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u6a21\u5f0f\u8bc6\u522b\u3002\n\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u901a\u8fc7\u6218\u7565\u6027\u5730\u7559\u51fa\u7a7a\u9699\u6765\u521b\u9020\u591a\u884c\u6e05\u9664\u7684\u673a\u4f1a\u3002\n\u6b65\u9aa42\uff1a\u4f7f\u7528\u6c34\u5e73\u7ebf\u6765\u8bbe\u7f6e\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\u7684\u5782\u76f4\u4e0b\u964d\u3002\n\u6b65\u9aa43\uff1a\u4f18\u5316\u79ef\u6728\u653e\u7f6e\uff0c\u521b\u9020\u6f5c\u5728\u7684\u8fde\u9501\u53cd\u5e94\u6548\u679c\uff0c\u4ece\u800c\u66f4\u597d\u5730\u5229\u7528\u6709\u9650\u7684\u7a7a\u95f4\u3002\u672c\u8d28\u4e0a\uff0c\u76ee\u6807\u662f\u5efa\u7acb\u8fde\u9501\u53cd\u5e94\uff0c\u5e76\u5229\u7528\u6e38\u620f\u5143\u7d20\u6765\u8fbe\u5230\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u5c06\u79ef\u6728\u653e\u7f6e\u5728\u5141\u8bb8\u60a8\u5b8c\u6210\u4e00\u884c\u4ee5\u83b7\u5f97\u8fde\u51fb\u7684\u4f4d\u7f6e\u3002\u53ef\u4ee5\u60f3\u8c61\u6210\u591a\u7c73\u8bfa\u9aa8\u724c\u4f9d\u6b21\u5012\u4e0b\uff0c\u7cbe\u5fc3\u7684\u8ba1\u5212\u662f\u4f18\u5316\u5206\u6570\u7684\u5173\u952e\u3002"}, {"question": "\u89e3\u91caCubinko\u7684\u8bc4\u5206\u7cfb\u7edf\uff1f\u54ea\u4e9b\u56e0\u7d20\u51b3\u5b9a\u4e86\u6bcf\u6b21\u79ef\u6728\u653e\u7f6e\u548c\u6d88\u9664\u7ebf\u7684\u5f97\u5206\uff1f", "answer": "Cubinko\u7684\u8bc4\u5206\u7cfb\u7edf\u53d6\u51b3\u4e8e\u5355\u6b21\u6d88\u9664\u7684\u65b9\u5757\u6570\u91cf\u3002\u5206\u6570\u65e2\u5956\u52b1\u79ef\u6728\u653e\u7f6e\uff0c\u4e5f\u5956\u52b1\u5b8c\u6210\u884c\u3002\u4e3b\u8981\u5206\u6570\u6765\u81ea\u5b8c\u6210\u884c\u3002\u83b7\u5f97\u7684\u5206\u6570\u4e0e\u540c\u65f6\u6e05\u9664\u7684\u884c\u6570\u6210\u6b63\u6bd4\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u4e00\u884c\u53ef\u80fd\u5956\u52b1100\u5206\u3002\u540c\u65f6\u6e05\u9664\u4e24\u884c\u53ef\u80fd\u4f1a\u83b7\u5f97\u5956\u52b1\uff0c\u4f8b\u5982300\u5206\uff0c\u5bf9\u4e8e\u4e09\u884c\u6216\u66f4\u591a\u884c\u6e05\u9664\uff0c\u5956\u52b1\u4f1a\u8fdb\u4e00\u6b65\u589e\u52a0\u3002\u653e\u7f6e\u987a\u5e8f\u4e5f\u5f88\u91cd\u8981\uff0c\u653e\u7f6e\u66f4\u5927\u7684\u79ef\u6728\u4e5f\u4f1a\u63d0\u9ad8\u5206\u6570\u3002\u8fd9\u4e9b\u5956\u52b1\u5f80\u5f80\u4f1a\u6210\u500d\u589e\u957f\uff0c\u5956\u52b1\u73a9\u5bb6\u6218\u7565\u6027\u5730\u5b89\u6392\u79ef\u6728\u4ee5\u521b\u9020\u8fd9\u4e9b\u591a\u884c\u6d88\u9664\u3002\u6e05\u9664\u56db\u884c\u901a\u5e38\u4f1a\u83b7\u5f97\u66f4\u9ad8\u7684\u5f97\u5206\uff0c\u500d\u6570\u4e5f\u66f4\u5927\u3002\u56e0\u6b64\uff0c\u4f18\u5316\u7ebf\u8def\u6e05\u9664\u53d8\u5f97\u81f3\u5173\u91cd\u8981\u3002\u8fd8\u6839\u636e\u79ef\u6728\u7684\u5927\u5c0f\u6709\u4e00\u4e2a\u500d\u6570\uff0c\u79ef\u6728\u8d8a\u5927\uff0c\u500d\u6570\u8d8a\u9ad8\u3002"}, {"question": "Cubinko\u9ad8\u624b\u8bf7\u6559\uff1a\u4e3a\u4ec0\u4e48\u79ef\u6728\u5f62\u72b6\u7684\u5206\u5e03\u4f3c\u4e4e\u5b58\u5728\u7edf\u8ba1\u504f\u5dee\uff1f\u5728\u6e38\u620f\u7279\u5b9a\u9636\u6bb5\uff0c\u662f\u5426\u5b58\u5728\u51fa\u73b0\u9891\u7387\u8f83\u4f4e\u7684\u7279\u5b9a\u5f62\u72b6\uff1f", "answer": "Cubinko\u4e2d\u79ef\u6728\u5f62\u72b6\u7684\u611f\u77e5\u504f\u5dee\u5206\u5e03\u662f\u6e38\u620f\u7a0b\u5e8f\u751f\u6210\u7b97\u6cd5\u7684\u7ed3\u679c\u3002\u867d\u7136\u7b97\u6cd5\u7684\u76ee\u6807\u662f\u968f\u673a\u6027\uff0c\u4f46\u5b83\u53ef\u80fd\u4f1a\u6839\u636e\u6e38\u620f\u677f\u5f53\u524d\u72b6\u6001\u5fae\u5999\u5730\u4f18\u5148\u8003\u8651\u67d0\u4e9b\u5f62\u72b6\uff0c\u4ee5\u4fdd\u6301\u96be\u5ea6\u5e76\u9632\u6b62\u7b80\u5355\u89e3\u6cd5\u3002\u4f8b\u5982\uff0c\u5f53\u6e38\u620f\u573a\u5730\u5df2\u7ecf\u5145\u6ee1\u8bb8\u591a\u95f4\u9699\u65f6\uff0c\u8f83\u957f\u7684\u76f4\u7ebf\u79ef\u6728\uff08\u201cI\u201d\u5f62\uff09\u53ef\u80fd\u51fa\u73b0\u7684\u9891\u7387\u8f83\u4f4e\u3002\u4e3a\u4e86\u66f4\u597d\u5730\u5904\u7406\u8fd9\u79cd\u660e\u663e\u7684\u504f\u5dee\uff0c\u8bf7\u601d\u8003\u6251\u514b\u724c\u662f\u5982\u4f55\u201c\u6d17\u724c\u201d\u4ee5\u786e\u4fdd\u968f\u673a\u7684\u3002\u7136\u800c\uff0c\u5b9e\u9645\u4e0a\uff0c\u8fd9\u901a\u5e38\u5e76\u975e\u771f\u6b63\u7684\u968f\u673a\u3002\u80fd\u591f\u8bc6\u522b\u57fa\u4e8e\u6e38\u620f\u72b6\u6001\u6700\u5e38\u7528\u7684\u79ef\u6728\u7684\u73a9\u5bb6\u5728Cubinko\u4e2d\u5177\u6709\u663e\u8457\u4f18\u52bf\u3002"}, {"question": "Cubinko\u6280\u672f\u5206\u6790\uff1a\u4e3a\u4e86\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7ef4\u6301\u6e38\u620f\u6587\u4ef6\u5927\u5c0f\u800c\u4e0d\u5f71\u54cd\u8d44\u4ea7/\u6570\u636e\u52a0\u8f7d\u901f\u5ea6\uff0c\u4f7f\u7528\u4e86\u54ea\u4e9b\u6570\u636e\u538b\u7f29\u7b97\u6cd5\uff1f", "answer": "\u4e3a\u4e86\u5728\u4e0d\u5f71\u54cd\u8d44\u4ea7\u52a0\u8f7d\u901f\u5ea6\u7684\u60c5\u51b5\u4e0b\u4fdd\u6301Cubinko\u7684\u5c0f\u6587\u4ef6\u5927\u5c0f\uff0c\u53ef\u80fd\u6d89\u53ca\u591a\u79cd\u6570\u636e\u538b\u7f29\u6280\u672f\u3002\u7eb9\u7406\u538b\u7f29\u662f\u5fc5\u987b\u7684\u3002PNG\u6216JPEG\u7b49\u7b97\u6cd5\u901a\u5e38\u88ab\u4f7f\u7528\uff0c\u56e0\u4e3a\u5b83\u4eec\u5728\u538b\u7f29\u7387\u548c\u56fe\u50cf\u8d28\u91cf\u4e4b\u95f4\u53d6\u5f97\u4e86\u5f88\u597d\u7684\u5e73\u8861\u3002\u5bf9\u4e8e\u6e38\u620f\u6570\u636e\uff0cZLib\u6216Deflate\u7b49\u7b97\u6cd5\u538b\u7f29\u5173\u5361\u6570\u636e\u548c\u5176\u4ed6\u6e38\u620f\u914d\u7f6e\u3002\u7f51\u683c\u548c\u51e0\u4f55\u6570\u636e\u901a\u5e38\u4f1a\u8fdb\u884c\u7f16\u7801\u3002\u4f8b\u5982\uff0cZLib\u5728\u5f88\u591aWeb\u6280\u672f\u4e2d\u88ab\u7528\u4e8e\u538b\u7f29\u4ee3\u7801\uff0c\u4ee5\u5b9e\u73b0\u66f4\u5feb\u5730\u4e0b\u8f7d\u3002\u5173\u952e\u662f\u5206\u6790\u5f15\u64ce\u5728\u6240\u6709\u8bbe\u5907\u4e0a\u7684\u8fd0\u884c\u60c5\u51b5\uff0c\u4ee5\u786e\u5b9a\u54ea\u4e9b\u538b\u7f29\u7b56\u7565\u80fd\u591f\u4ea7\u751f\u6700\u4f73\u7ed3\u679c\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u540c\u6b65Cubinko\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f\u4f7f\u7528\u540c\u4e00\u4e2a\u5e10\u6237\u5728iOS\u548cAndroid\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u6570\u636e\u7684\u9009\u9879\u662f\u4ec0\u4e48\uff1f", "answer": "\u652f\u6301\u8de8\u5e73\u53f0Cubinko\u5b58\u6863\u6570\u636e\u540c\u6b65\u901a\u5e38\u53d6\u51b3\u4e8e\u6e38\u620f\u7684\u5b9e\u73b0\u65b9\u5f0f\u3002\u5982\u679c\u6e38\u620f\u63d0\u4f9b\u94fe\u63a5\u5230\u5e10\u6237\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\uff08\u4f8b\u5982Google Play\u6e38\u620f\u3001Apple\u6e38\u620f\u4e2d\u5fc3\u6216\u4e13\u7528\u7684Cubinko\u5e10\u6237\uff09\uff0c\u5219\u5f88\u53ef\u80fd\u5728iOS\u548cAndroid\u8bbe\u5907\u4e4b\u95f4\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6e38\u620f\u4f7f\u7528Google Play\u6e38\u620f\uff0c\u53ea\u9700\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u767b\u5f55\u60a8\u7684\u5e10\u6237\u5373\u53ef\u3002\u4e5f\u53ef\u80fd\u4f7f\u7528\u624b\u52a8\u5907\u4efd\u548c\u6062\u590d\u529f\u80fd\u8fdb\u884c\u6570\u636e\u8fc1\u79fb\uff0c\u4f46\u8fd9\u53d6\u51b3\u4e8e\u5f00\u53d1\u4eba\u5458\u662f\u5426\u63d0\u4f9b\u6b64\u529f\u80fd\u3002"}, {"question": "Cubinko\u5f69\u86cb\u6316\u6398\uff1a\u5728\u5b8c\u6210\u6e38\u620f\u591a\u6b21\u6216\u8fbe\u5230\u7279\u5b9a\u5206\u6570\u9608\u503c\u540e\uff0c\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "Cubinko\u5f88\u53ef\u80fd\u5305\u542b\u8bb8\u591a\u9690\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff0c\u4ee5\u5956\u52b1\u6709\u8010\u5fc3\u7684\u73a9\u5bb6\u3002\u67d0\u4e9b\u5e38\u89c1\u7684\u5f69\u86cb\u7c7b\u578b\u662f\u5728\u73a9\u5bb6\u83b7\u5f97\u7279\u5b9a\u9ad8\u5206\u65f6\u4f1a\u53d1\u751f\u7279\u5b9a\u89c6\u89c9\u53d8\u5316\u3002\u5f69\u86cb\u901a\u5e38\u9690\u85cf\u5728\u91cd\u590d\u64cd\u4f5c\u4e4b\u540e\u3002\u4f8b\u5982\uff0c\u7528\u76f8\u540c\u989c\u8272\u7684\u79ef\u6728\u5b8c\u5168\u586b\u5145\u6e38\u620f\u677f\u4f1a\u89e3\u9501\u6e38\u620f\u4e2d\u7684\u9690\u85cf\u89d2\u8272\u76ae\u80a4\uff0c\u6539\u53d8\u79ef\u6728\u7684\u5916\u89c2\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u7b56\u7565\u548c\u5206\u6570\u9608\u503c\u6765\u63ed\u793a\u60ca\u559c\u3002\u5728\u8bb8\u591a\u60c5\u51b5\u4e0b\uff0c\u67e5\u770bCubinko\u5728\u7ebf\u8bba\u575b\uff0c\u67e5\u770b\u5176\u4ed6\u73a9\u5bb6\u7684\u53d1\u73b0\u662f\u4e00\u4e2a\u4e0d\u9519\u7684\u9009\u62e9\u3002\u8bf7\u6ce8\u610f\u6e38\u620f\u7684\u516c\u544a\uff0c\u901a\u5e38\u5728\u6e38\u620f\u91cc\u7a0b\u7891\u4e4b\u540e\uff0c\u4ed6\u4eec\u4f1a\u63d0\u4f9b\u63d0\u793a\u3002"}, {"question": "Cubinko\u8d44\u6df1\u73a9\u5bb6\uff1aCubinko\u662f\u57fa\u4e8e\u8fd0\u6c14\u8fd8\u662f\u7b56\u7565\uff1f\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u5bf9\u4e8e\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u66f4\u91cd\u8981\uff1f", "answer": "Cubinko\u65e2\u6709\u8fd0\u6c14\u6210\u5206\uff0c\u4e5f\u6709\u7b56\u7565\u6210\u5206\uff0c\u4f46\u6210\u529f\u66f4\u591a\u5730\u53d6\u51b3\u4e8e\u6218\u7565\u89c4\u5212\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u5c3d\u7ba1\u79ef\u6728\u5f62\u72b6\u7684\u987a\u5e8f\u662f\u968f\u673a\u7684\uff0c\u4f46\u60a8\u9884\u6d4b\u548c\u6709\u6548\u6574\u5408\u8fd9\u4e9b\u79ef\u6728\u7684\u80fd\u529b\u51b3\u5b9a\u4e86\u60a8\u7684\u6210\u529f\u3002\u51b3\u5b9a\u6e38\u620f\u7ed3\u679c\u7684\u6e38\u620f\u673a\u5236\u5982\u4e0b\uff1a\n1. \u8ba1\u5212\u6570\u6b65\u4e4b\u540e\u3002\n2. \u5e73\u8861\u5373\u65f6\u7684\u7ebf\u8def\u6e05\u9664\u4e0e\u957f\u671f\u7684\u7a7a\u95f4\u4f18\u5316\u3002\n3. \u8bc6\u522b\u548c\u5229\u7528\u521b\u5efa\u8fde\u9501\u53cd\u5e94\u7684\u673a\u4f1a\u3002\u8fd0\u6c14\u53ef\u80fd\u5728\u60a8\u5728\u6700\u4f73\u65f6\u673a\u83b7\u5f97\u5b8c\u7f8e\u79ef\u6728\u65f6\u53d1\u6325\u5c0f\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u6709\u65f6\u4e00\u4e2a\u957f\u7684\u76f4\u7ebf\u79ef\u6728\u5141\u8bb8\u60a8\u6e05\u96644\u884c\uff0c\u5e76\u8ba9\u60a8\u901a\u8fc7\u4e0b\u4e00\u4e2a\u5173\u5361\u3002Cubinko\u65e8\u5728\u6311\u6218\u60a8\u7684\u89c4\u5212\u6280\u80fd\uff0c\u65e0\u8bba\u53d1\u751f\u4ec0\u4e48\u3002"}, {"question": "\u5982\u4f55\u63d0\u9ad8Cubinko\u7684\u6e38\u620f\u6280\u5de7\uff1f\u89e3\u91ca\u201c\u4e95\u201d\u7684\u6982\u5ff5\u5728\u9ad8\u7ea7\u6e38\u620f\u4e2d\u4f5c\u4e3a\u4e00\u79cd\u7b56\u7565\u3002", "answer": "\u63d0\u9ad8Cubinko\u6280\u5de7\u7684\u4e00\u79cd\u7b56\u7565\u662f\u638c\u63e1\u201c\u4e95\u201d\u7684\u6982\u5ff5\u3002\u8fd9\u662f\u4e00\u4e2a\u6218\u7565\u6027\u653e\u7f6e\uff0c\u60a8\u521b\u5efa\u4e86\u4e00\u4e2a\u957f\u800c\u72ed\u7a84\u7684\u5217\uff08\u201c\u4e95\u201d\uff09\u3002\u8fd9\u7528\u4e8e\u63a5\u6536\u76f4\u7ebf\u3001\u201cI\u201d\u5f62\u79ef\u6728\uff0c\u4ee5\u6709\u6548\u6e05\u9664\u591a\u884c\u3002\n\u6b65\u9aa41\uff1a\u5728\u653e\u7f6e\u79ef\u6728\u65f6\u81f3\u5c11\u7559\u51fa\u4e00\u4e2a\u5782\u76f4\u5217\u3002\n\u6b65\u9aa42\uff1a\u5c1d\u8bd5\u4f7f\u5176\u4ed6\u79ef\u6728\u5b9a\u5411\u5f62\u6210\u8fd9\u4e9b\u6709\u7528\u7684\u4e95\u3002\n\u6b65\u9aa43\uff1a\u6ce8\u610f\u76f4\u7ebf\u79ef\u6728\u3002\n\u8003\u8651\u8fd9\u4e00\u70b9\uff1a\u4e95\u8d8a\u5927\uff0c\u5728\u5e95\u90e8\u653e\u7f6e\u79ef\u6728\u6e05\u9664\u591a\u884c\u7684\u53ef\u80fd\u6027\u8d8a\u5927\u3002\u5982\u679c\u6ca1\u6709\u4ed4\u7ec6\u7684\u8ba1\u5212\uff0c\u6784\u5efa\u4e95\uff0c\u6709\u6548\u6e05\u9664\u7ebf\u8def\u7684\u53ef\u80fd\u6027\u5c31\u4f1a\u964d\u4f4e\u3002\u8fd9\u662f\u5728Cubinko\u4e2d\u83b7\u5f97\u6700\u9ad8\u5206\u7684\u9996\u8981\u7b56\u7565\u3002"}]
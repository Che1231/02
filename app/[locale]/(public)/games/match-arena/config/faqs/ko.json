[{"question": "\ub9e4\uce58 \uc544\ub808\ub098 \ucd08\uc2ec\uc790\ub97c \uc704\ud55c \uae30\ubcf8 \uacf5\uaca9\uacfc \uc5f0\uacc4 \uae30\uc220\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\ub098\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc5d0\uc11c \uae30\ubcf8 \uacf5\uaca9\uc740 \uae30\ubcf8 \uacf5\uaca9 \ubc84\ud2bc(\uae30\ubcf8\uac12: \uc67c\ucabd \ud074\ub9ad)\uc744 \ub204\ub974\ub294 \ubc29\uc2dd\uc73c\ub85c \uc218\ud589\ud569\ub2c8\ub2e4. \uc5f0\uacc4 \uae30\uc220\uc740 \uae30\ubcf8 \uacf5\uaca9\uacfc \ud2b9\uc218 \ub2a5\ub825\uc744 \uc5f0\uc18d\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc218\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \uacf5\uaca9 \ud6c4 '\ud30c\uc774\uc5b4\ubcfc'(\uae30\ubcf8\uac12: Q) \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac15\ub825\ud55c \uc5f0\uacc4 \uae30\uc220\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uae30\ubcf8 \uacf5\uaca9\uc740 \uc67c\ucabd \ud074\ub9ad\uc744 \ub204\ub985\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubc14\ub85c Q\ub97c \ub20c\ub7ec '\ud30c\uc774\uc5b4\ubcfc'\uc744 \ubc1c\ub3d9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc5f0\uc18d\uc801\uc778 \ud53c\ud574\ub97c \uc704\ud574 \uc774 \uc21c\uc11c\ub97c \ubc18\ubcf5\ud569\ub2c8\ub2e4. \uc774 \uc5f0\uacc4 \uae30\uc220\uc740 \ucd08\uc2ec\uc790\uc5d0\uac8c \uce5c\uc219\ud558\uace0 \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc5d0\ub108\uc9c0 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc5d0\ub108\uc9c0 \uc2dc\uc2a4\ud15c\uc740 \ub2a5\ub825\uacfc \ucd5c\uc885 \uae30\uc220\uc758 \uc0ac\uc6a9\uc744 \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc5ec \ucd5c\ub300\uc758 \ud6a8\uacfc\ub97c \ubc1c\ud718\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc36c\ub354 \uc2a4\ud2b8\ub77c\uc774\ud06c' \ub2a5\ub825\uc740 50\uc758 \uc5d0\ub108\uc9c0\uac00 \uc18c\ubaa8\ub418\uace0, \ucd5c\uc885 \uae30\uc220 '\uc778\ud398\ub974\ub178 \ube14\ub798\uc2a4\ud2b8'\ub294 100\uc758 \uc5d0\ub108\uc9c0\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc804\ud22c \uc911 \uc5d0\ub108\uc9c0 \uc218\uce58\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc800\ub834\ud55c \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5d0\ub108\uc9c0\ub97c \ucd95\uc801\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ucd5c\uc885 \uae30\uc220\uc744 \uc704\ud574 \uc5d0\ub108\uc9c0\ub97c \uc808\uc57d\ud569\ub2c8\ub2e4. \uc5d0\ub108\uc9c0 \uc18c\ubaa8\ub7c9 \ube44\uad50\ud45c: \uae30\ubcf8 \ub2a5\ub825(50), \ucd5c\uc885 \uae30\uc220(100), \ud2b9\uc218 \ub2a5\ub825(75). \ud6a8\uc728\uc801\uc778 \uc5d0\ub108\uc9c0 \uad00\ub9ac\ub85c \uc804\uc138\ub97c \ub4a4\uc9d1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 PvP\uc640 PvE \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 PvP(\ud50c\ub808\uc774\uc5b4 \ub300 \ud50c\ub808\uc774\uc5b4)\uc640 PvE(\ud50c\ub808\uc774\uc5b4 \ub300 \ud658\uacbd) \ubaa8\ub4dc\ub294 \uac01\uac01 \ub2e4\ub978 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. PvP\ub294 '\uc544\ub808\ub098 \ud074\ub798\uc2dc' \ubaa8\ub4dc\ucc98\ub7fc \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uc11c\ub85c \ub9de\ubd99\ub294 \uacbd\uc7c1 \uac8c\uc784\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. PvE\ub294 '\ub358\uc804 \ub808\uc774\ub4dc' \ubaa8\ub4dc\ucc98\ub7fc AI \uc801\ub4e4\uacfc \ud611\ub825 \ud50c\ub808\uc774\ub97c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PvP\uc5d0\uc11c\ub294 \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc774 \uc911\uc694\ud558\uace0, PvE\uc5d0\uc11c\ub294 \ud300\uc6cc\ud06c\uc640 \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \uc758\uc0ac\uacb0\uc815 \uacfc\uc815\uc744 \ub098\ud0c0\ub0b4\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8: PvP \u2192 \uacbd\uc7c1 \u2192 \uc2e4\uc2dc\uac04 \uc804\ub7b5; PvE \u2192 \ud611\ub825 \u2192 \uc790\uc6d0 \ubc30\ubd84."}, {"question": "\uc5d4\ub4dc\uac8c\uc784 \ucf58\ud150\uce20\ub97c \uc704\ud574 \ub9e4\uce58 \uc544\ub808\ub098 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc5d0\uc11c \uc5d4\ub4dc\uac8c\uc784 \ucf58\ud150\uce20\ub97c \uc704\ud574 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc801\uc808\ud55c \uc7a5\ube44\uc640 \ub2a5\ub825\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc100\ub3c4\uc6b0 \uc5b4\uc314\uc2e0' \ube4c\ub4dc\ub294 \ub192\uc740 \uce58\uba85\ud0c0 \ud655\ub960\uacfc \ubbfc\ucca9\uc131\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \ub2e8\uacc4 1: '\uc100\ub3c4\uc6b0 \ub9dd\ud1a0'\uc640 \uac19\uc774 \uce58\uba85\ud0c0 \ud655\ub960\uc744 \ub192\uc774\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc774\ub3d9\uc131\uc744 \uc704\ud55c '\uc100\ub3c4\uc6b0 \uc2a4\ud15d'\uacfc \ud3ed\ubc1c\uc801\uc778 \ud53c\ud574\ub97c \uc704\ud55c '\uc5b4\uc314\uc2e0' \uac19\uc740 \ub2a5\ub825\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubbfc\ucca9\uc131\uc744 \uc99d\uac00\uc2dc\ud0a4\ub294 \ub8ec\uc73c\ub85c \uc7a5\ube44\ub97c \uac15\ud654\ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \ud1b5\uacc4\uce58\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uad6c\uc131\ud45c: \uce58\uba85\ud0c0(50%), \ubbfc\ucca9\uc131(30%), \uccb4\ub825(20%). \uc774 \ube4c\ub4dc\ub294 \uace0\ub09c\ub3c4 \ub808\uc774\ub4dc\uc5d0\uc11c \ud0c1\uc6d4\ud55c \uc131\ub2a5\uc744 \ubc1c\ud718\ud569\ub2c8\ub2e4."}, {"question": "\ud300 \uc804\ud22c\uc5d0\uc11c \ud0f1\ud06c \uc5ed\ud560\uc744 \uc704\ud574 \ucd5c\uc801\uc758 \ub9e4\uce58 \uc544\ub808\ub098 \ub2a5\ub825\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc5d0\uc11c \ud300 \uc804\ud22c\uc5d0\uc11c \uc798 \uc5b4\uc6b8\ub9ac\ub294 \ud0f1\ud06c \ub2a5\ub825\uc5d0\ub294 '\uc2e4\ub4dc \ubc30\uc26c'\uc640 '\ub3c4\ubc1c'\uc774 \uc788\uc2b5\ub2c8\ub2e4. '\uc2e4\ub4dc \ubc30\uc26c'\ub294 \uc801\uc744 \uae30\uc808\uc2dc\ud0a4\uace0, '\ub3c4\ubc1c'\uc740 \uc801\uc758 \uacf5\uaca9\uc744 \ub04c\uc5b4\ub4e4\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300 \uc804\ud22c\uc5d0\uc11c '\ub3c4\ubc1c'\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \uc790\uc2e0\uc5d0\uac8c \uc9d1\uc911\uc2dc\ud0a8 \ub2e4\uc74c, '\uc2e4\ub4dc \ubc30\uc26c'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc911\uc694\ud55c \uc801\uc744 \uc81c\uc555\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: '\ub3c4\ubc1c'\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uc8fc\uc758\ub97c \ub04c\uc5b4\ub4e4\uc785\ub2c8\ub2e4. \ub2e8\uacc4 2: '\uc2e4\ub4dc \ubc30\uc26c'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc6b0\uc120\uc21c\uc704\uac00 \ub192\uc740 \uc801\uc744 \uae30\uc808\uc2dc\ud0b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud300\uc6d0\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud55c \uc704\uce58\ub97c \uc120\uc815\ud569\ub2c8\ub2e4. \ud750\ub984\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc2dc\ub108\uc9c0 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \ub3c4\ubc1c \u2192 \uacf5\uaca9 \uc9d1\uc911 \u2192 \uc2e4\ub4dc \ubc30\uc26c \u2192 \uc81c\uc5b4. \uc774 \uc870\ud569\uc740 \ud300 \uc0dd\uc874\ub825\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uacf5\uc815\ud55c PvP \uc804\ud22c\ub97c \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud558\ub098\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4 \ub4f1\uae09, \uc2b9/\ud328\uc728 \ubc0f \ucd5c\uadfc \uc131\ub2a5\uc744 \uacb0\ud569\ud558\uc5ec \uacf5\uc815\ud55c PvP \uc804\ud22c\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub4f1\uae09\uc774 1500\uc778 \ud50c\ub808\uc774\uc5b4\ub294 100\uc810 \uc774\ub0b4\uc758 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc2dc\uc2a4\ud15c\uc740 \ud604\uc7ac \ub4f1\uae09\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc720\uc0ac\ud55c \ud1b5\uacc4\uce58\ub97c \uac00\uc9c4 \uc0c1\ub300\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucd5c\uadfc \uc131\ub2a5\uc744 \ubc14\ud0d5\uc73c\ub85c \ub9e4\uce6d\uc744 \uc870\uc815\ud558\uc5ec \uc2e4\ub825 \uade0\ud615\uc744 \ub9de\ucda5\ub2c8\ub2e4. \ub9e4\uce6d \ub9e4\uac1c\ubcc0\uc218\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ube44\uad50\ud45c: \ub4f1\uae09(1500), \uc2b9/\ud328\uc728(1.2), \ucd5c\uadfc \uc131\ub2a5(\uae0d\uc815\uc801). \uc774 \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615 \uc788\uace0 \uacbd\uc7c1\uc801\uc778 \ub9e4\uce58\ub97c \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c\uc740 \uc6b4 \uc694\uc18c \uc601\ud5a5\uacfc \ubaac\uc2a4\ud130 \uc885\ub958\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6b4\uc774 \uc88b\uc740 '\uc6a9'\uc744 \ucc98\uce58\ud558\uba74 \ud76c\uadc0\ud55c \ubcf4\uc0c1\uc744 \uc5bb\uc744 \ud655\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc6b4\uc744 \ub192\uc774\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud76c\uadc0\ud55c \ubcf4\uc0c1\uc73c\ub85c \uc54c\ub824\uc9c4 \ud2b9\uc815 \ubaac\uc2a4\ud130\ub97c \uacf5\uaca9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub4dc\ub78d\ub960\uc744 \ub192\uc774\ub294 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \ubcf4\uc0c1 \ub4dc\ub78d \ud655\ub960\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ucc28\ud2b8: \uc77c\ubc18(70%), \ud76c\uadc0(20%), \uc601\uc6c5(8%), \uc804\uc124(2%). \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ubcf4\uc0c1\uc744 \uc5bb\ub294 \ub370 \ud070 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc5d0\uc11c\ub294 \uc5f0\uacb0\ub41c \uacc4\uc815 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc640 \ubaa8\ubc14\uc77c\uc5d0\uc11c \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc124\uc815 \uba54\ub274\uc5d0\uc11c '\uacc4\uc815 \uc5f0\uacb0' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uc9c0\uc6d0\ub418\ub294 \ud50c\ub7ab\ud3fc\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131 \ud45c: PC(\uc608), \ubaa8\ubc14\uc77c(\uc608), \ucf58\uc194(\uc608). \uc774 \uae30\ub2a5\uc740 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc911\ub2e8 \uc5c6\uc774 \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130 \uc2a4\ud0a8\uc744 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130 \uc2a4\ud0a8\uc744 \ud574\uc81c\ud558\ub824\uba74 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\uc640 \uc131\ucde8\ub3c4\ub97c \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud398\ub2c9\uc2a4' \uc2a4\ud0a8\uc740 50\ubc88\uc758 PvP \ub9e4\uce58\uc5d0\uc11c \uc2b9\ub9ac\ud558\uba74 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: PvP \ub9e4\uce58 \uc2b9\ub9ac\uc640 \uac19\uc740 \ud544\uc218 \ucc4c\ub9b0\uc9c0\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc131\ucde8\ub3c4 \uba54\ub274\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd94\uc801\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \uc2a4\ud0a8\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc2a4\ud0a8 \ud574\uc81c \uacfc\uc815\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc2a4\ud0a8 \ud574\uc81c \ud50c\ub85c\uc6b0\ucc28\ud2b8: \ucc4c\ub9b0\uc9c0 \u2192 \uc9c4\ud589 \uc0c1\ud669 \ucd94\uc801 \u2192 \uc2a4\ud0a8 \ud574\uc81c. \uc774\ub7ec\ud55c \uc2a4\ud0a8\uc740 \uce90\ub9ad\ud130\uc5d0 \ub3c5\ud2b9\ud55c \ub9e4\ub825\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc21c\uc704 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud558\ub098\uc694?", "answer": "\ub9e4\uce58 \uc544\ub808\ub098\uc758 \uc21c\uc704 \uc2dc\uc2a4\ud15c\uc740 \uc2b9/\ud328\uc728, \ub9e4\uce58 \uc131\ub2a5 \ubc0f \uc0c1\ub300 \ub09c\uc774\ub3c4\ub97c \uae30\ubc18\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uacc4\uc0b0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub192\uc740 \ub4f1\uae09\uc758 \uc0c1\ub300\ub97c \uc774\uae30\uba74 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc2dc\uc2a4\ud15c\uc740 \ub9e4\uce58 \uacb0\uacfc\ub97c \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud0ac\uacfc \uc5b4\uc2dc\uc2a4\ud2b8\uc640 \uac19\uc740 \uc131\ub2a5 \uc9c0\ud45c\ub97c \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c1\ub300 \ub09c\uc774\ub3c4\ub97c \uae30\ubc18\uc73c\ub85c \ub4f1\uae09\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc810\uc218 \ubc30\ubd84\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc9c4\ud589 \ucc28\ud2b8: \uc2b9\ub9ac(+20), \ud328\ubc30(-10), \uace0\uc131\ub2a5 \ubcf4\ub108\uc2a4(+5). \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\ud558\uace0 \uacf5\uc815\ud55c \ud50c\ub808\uc774\uc5b4 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}]
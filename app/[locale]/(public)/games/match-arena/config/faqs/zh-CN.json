[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u6a21\u5f0f\u7684\u7ade\u6280\u573a\u8fdb\u884c\u57fa\u7840\u653b\u51fb\u548c\u8fde\u62db\uff1f", "answer": "\u5728\u7ade\u6280\u573a\u4e2d\uff0c\u57fa\u7840\u653b\u51fb\u53ef\u4ee5\u901a\u8fc7\u6309\u4e0b\u4e3b\u653b\u51fb\u952e\uff08\u9ed8\u8ba4\uff1a\u5de6\u952e\u70b9\u51fb\uff09\u6765\u6267\u884c\u3002\u8fde\u62db\u662f\u901a\u8fc7\u5c06\u57fa\u672c\u653b\u51fb\u4e0e\u7279\u6b8a\u80fd\u529b\u4e32\u8054\u8d77\u6765\u5b8c\u6210\u7684\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u4e00\u6b21\u57fa\u672c\u653b\u51fb\uff0c\u7136\u540e\u4f7f\u7528\u201c\u706b\u7403\u201d\u6280\u80fd\uff08\u9ed8\u8ba4\uff1aQ\uff09\u6765\u521b\u9020\u4e00\u4e2a\u5f3a\u5927\u7684\u8fde\u62db\u3002\u6b65\u9aa4 1\uff1a\u6309\u4e0b\u5de6\u952e\u8fdb\u884c\u57fa\u672c\u653b\u51fb\u3002\u6b65\u9aa4 2\uff1a\u7acb\u5373\u6309\u4e0b Q \u65bd\u653e\u201c\u706b\u7403\u201d\u3002\u6b65\u9aa4 3\uff1a\u91cd\u590d\u6b64\u5e8f\u5217\u4ee5\u6301\u7eed\u9020\u6210\u4f24\u5bb3\u3002\u8fd9\u4e2a\u8fde\u62db\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\u53cb\u597d\u4e14\u5728\u65e9\u671f\u9636\u6bb5\u6709\u6548\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u9ad8\u7ea7\u73a9\u5bb6\u9700\u8981\u7406\u89e3\u7ade\u6280\u573a\u7684\u80fd\u91cf\u7cfb\u7edf\uff1f", "answer": "\u7ade\u6280\u573a\u7684\u80fd\u91cf\u7cfb\u7edf\u63a7\u5236\u7740\u6280\u80fd\u548c\u7ec8\u6781\u6280\u80fd\u7684\u4f7f\u7528\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5fc5\u987b\u6709\u6548\u5730\u7ba1\u7406\u80fd\u91cf\u4ee5\u6700\u5927\u5316\u5176\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u201c\u96f7\u51fb\u201d\u6280\u80fd\u9700\u8981 50 \u80fd\u91cf\uff0c\u800c\u7ec8\u6781\u6280\u80fd\u201c\u70c8\u7130\u51b2\u51fb\u201d\u9700\u8981 100 \u80fd\u91cf\u3002\u6b65\u9aa4 1\uff1a\u5728\u6218\u6597\u4e2d\u76d1\u63a7\u80fd\u91cf\u6c34\u5e73\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u4f4e\u6210\u672c\u6280\u80fd\u6765\u79ef\u6512\u80fd\u91cf\u3002\u6b65\u9aa4 3\uff1a\u5728\u5173\u952e\u65f6\u523b\u4fdd\u5b58\u80fd\u91cf\u4ee5\u4f7f\u7528\u7ec8\u6781\u6280\u80fd\u3002\u80fd\u91cf\u6d88\u8017\u5bf9\u6bd4\u8868\uff1a\u57fa\u672c\u6280\u80fd\uff0850\uff09\uff0c\u7ec8\u6781\u6280\u80fd\uff08100\uff09\uff0c\u7279\u6b8a\u6280\u80fd\uff0875\uff09\u3002\u6709\u6548\u7684\u80fd\u91cf\u7ba1\u7406\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002"}, {"question": "\u7ade\u6280\u573a\u4e2d\u7684 PvP \u548c PvE \u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u7ade\u6280\u573a\u7684 PvP\uff08\u73a9\u5bb6\u5bf9\u73a9\u5bb6\uff09\u548c PvE\uff08\u73a9\u5bb6\u5bf9\u73af\u5883\uff09\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u4f53\u9a8c\u3002PvP \u6a21\u5f0f\u4fa7\u91cd\u4e8e\u7ade\u6280\u6e38\u620f\uff0c\u73a9\u5bb6\u76f8\u4e92\u5bf9\u6297\uff0c\u4f8b\u5982\u201c\u7ade\u6280\u573a\u51b3\u6597\u201d\u6a21\u5f0f\u3002PvE \u6a21\u5f0f\u6d89\u53ca\u4e0e AI \u654c\u4eba\u534f\u540c\u4f5c\u6218\uff0c\u4f8b\u5982\u201c\u5730\u4e0b\u57ce\u7a81\u88ad\u201d\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728 PvP \u6a21\u5f0f\u4e2d\uff0c\u65f6\u673a\u548c\u7b56\u7565\u81f3\u5173\u91cd\u8981\uff0c\u800c\u5728 PvE \u6a21\u5f0f\u4e2d\uff0c\u56e2\u961f\u5408\u4f5c\u548c\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\u3002\u6d41\u7a0b\u56fe\u8bf4\u660e\u4e86\u51b3\u7b56\u8fc7\u7a0b\uff1aPvP \u2192 \u7ade\u6280 \u2192 \u5b9e\u65f6\u7b56\u7565\uff1bPvE \u2192 \u5408\u4f5c \u2192 \u8d44\u6e90\u5206\u914d\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u4ed6\u4eec\u7684\u7ade\u6280\u573a\u89d2\u8272\u6784\u5efa\u4ee5\u5e94\u5bf9\u6700\u7ec8\u5185\u5bb9\uff1f", "answer": "\u4f18\u5316\u7ade\u6280\u573a\u89d2\u8272\u6784\u5efa\u4ee5\u5e94\u5bf9\u6700\u7ec8\u5185\u5bb9\u6d89\u53ca\u9009\u62e9\u5408\u9002\u7684\u88c5\u5907\u548c\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u201c\u6697\u5f71\u523a\u5ba2\u201d\u6784\u5efa\u4fa7\u91cd\u4e8e\u9ad8\u66b4\u51fb\u7387\u548c\u654f\u6377\u6027\u3002\u6b65\u9aa4 1\uff1a\u88c5\u5907\u63d0\u9ad8\u66b4\u51fb\u7387\u7684\u88c5\u5907\uff0c\u4f8b\u5982\u201c\u6697\u5f71\u6597\u7bf7\u201d\u3002\u6b65\u9aa4 2\uff1a\u9009\u62e9\u8bf8\u5982\u201c\u6697\u5f71\u6b65\u6cd5\u201d\u7684\u6280\u80fd\uff0c\u7528\u4e8e\u673a\u52a8\u6027\u548c\u201c\u6697\u6740\u201d\u7528\u4e8e\u7206\u53d1\u4f24\u5bb3\u3002\u6b65\u9aa4 3\uff1a\u4f7f\u7528\u589e\u52a0\u654f\u6377\u6027\u7684\u7b26\u6587\u6765\u5f3a\u5316\u88c5\u5907\u3002\u914d\u7f6e\u8868\u663e\u793a\u4e86\u6700\u4f73\u5c5e\u6027\uff1a\u66b4\u51fb\u7387\uff0850%\uff09\uff0c\u654f\u6377\u6027\uff0830%\uff09\uff0c\u751f\u547d\u503c\uff0820%\uff09\u3002\u6b64\u6784\u5efa\u5728\u9ad8\u96be\u5ea6\u7a81\u88ad\u4e2d\u8868\u73b0\u51fa\u8272\u3002"}, {"question": "\u54ea\u4e9b\u7ade\u6280\u573a\u6280\u80fd\u5728\u56e2\u961f\u6218\u6597\u4e2d\u5bf9\u4e8e\u5766\u514b\u89d2\u8272\u7684\u534f\u540c\u4f5c\u7528\u6700\u597d\uff1f", "answer": "\u5728\u7ade\u6280\u573a\u4e2d\uff0c\u534f\u540c\u4f5c\u7528\u826f\u597d\u7684\u5766\u514b\u6280\u80fd\u5305\u62ec\u201c\u9632\u5fa1\u51b2\u649e\u201d\u548c\u201c\u6311\u8845\u201d\u3002\u201c\u9632\u5fa1\u51b2\u649e\u201d\u4f1a\u4f7f\u654c\u4eba\u7729\u6655\uff0c\u201c\u6311\u8845\u201d\u4f1a\u5438\u5f15\u4ec7\u6068\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u6218\u6597\u4e2d\uff0c\u4f7f\u7528\u201c\u6311\u8845\u201d\u6765\u5c06\u654c\u4eba\u7684\u653b\u51fb\u96c6\u4e2d\u5728\u4f60\u8eab\u4e0a\uff0c\u7136\u540e\u4f7f\u7528\u201c\u9632\u5fa1\u51b2\u649e\u201d\u6765\u7981\u7528\u5173\u952e\u76ee\u6807\u3002\u6b65\u9aa4 1\uff1a\u65bd\u653e\u201c\u6311\u8845\u201d\u4ee5\u5438\u5f15\u654c\u4eba\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u201c\u9632\u5fa1\u51b2\u649e\u201d\u4f7f\u9ad8\u4f18\u5148\u7ea7\u654c\u4eba\u7729\u6655\u3002\u6b65\u9aa4 3\uff1a\u8ba9\u81ea\u5df1\u5904\u4e8e\u4fdd\u62a4\u961f\u53cb\u7684\u4f4d\u7f6e\u3002\u534f\u540c\u4f5c\u7528\u56fe\u663e\u793a\u4e86\u6d41\u7a0b\uff1a\u6311\u8845 \u2192 \u4ec7\u6068\u63a7\u5236 \u2192 \u9632\u5fa1\u51b2\u649e \u2192 \u7fa4\u4f53\u63a7\u5236\u3002\u8fd9\u79cd\u7ec4\u5408\u786e\u4fdd\u4e86\u56e2\u961f\u751f\u5b58\u3002"}, {"question": "\u7ade\u6280\u573a\u5339\u914d\u7cfb\u7edf\u5982\u4f55\u786e\u4fdd\u516c\u5e73\u7684 PvP \u6218\u6597\uff1f", "answer": "\u7ade\u6280\u573a\u5339\u914d\u7cfb\u7edf\u7ed3\u5408\u4e86\u73a9\u5bb6\u7b49\u7ea7\u3001\u80dc/\u8d1f\u6bd4\u548c\u6700\u8fd1\u7684\u8868\u73b0\u6765\u786e\u4fdd\u516c\u5e73\u7684 PvP \u6218\u6597\u3002\u4f8b\u5982\uff0c\u7b49\u7ea7\u4e3a 1500 \u7684\u73a9\u5bb6\u5c06\u4e0e\u7b49\u7ea7\u5728 100 \u5206\u8303\u56f4\u5185\u7684\u4eba\u5339\u914d\u3002\u6b65\u9aa4 1\uff1a\u7cfb\u7edf\u8bc4\u4f30\u60a8\u7684\u5f53\u524d\u7b49\u7ea7\u3002\u6b65\u9aa4 2\uff1a\u5b83\u641c\u7d22\u5177\u6709\u7c7b\u4f3c\u7edf\u8ba1\u6570\u636e\u7684\u5bf9\u624b\u3002\u6b65\u9aa4 3\uff1a\u57fa\u4e8e\u6700\u8fd1\u7684\u8868\u73b0\u8c03\u6574\u5339\u914d\uff0c\u4ee5\u5e73\u8861\u6280\u80fd\u6c34\u5e73\u3002\u6bd4\u8f83\u8868\u663e\u793a\u4e86\u5339\u914d\u53c2\u6570\uff1a\u7b49\u7ea7 (1500)\uff0c\u80dc/\u8d1f\u6bd4 (1.2)\uff0c\u8fd1\u671f\u8868\u73b0 (\u79ef\u6781)\u3002\u6b64\u7cfb\u7edf\u4fc3\u8fdb\u4e86\u5e73\u8861\u4e14\u5177\u6709\u7ade\u4e89\u529b\u7684\u6bd4\u8d5b\u3002"}, {"question": "\u7ade\u6280\u573a\u6389\u843d\u7cfb\u7edf\u80cc\u540e\u7684\u9690\u85cf\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u7ade\u6280\u573a\u6389\u843d\u7cfb\u7edf\u5305\u542b\u9690\u85cf\u673a\u5236\uff0c\u4f8b\u5982\u8fd0\u6c14\u5c5e\u6027\u7684\u5f71\u54cd\u548c\u602a\u7269\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u51fb\u8d25\u62e5\u6709\u9ad8\u8fd0\u6c14\u5c5e\u6027\u7684\u201c\u9f99\u201d\u589e\u52a0\u4e86\u83b7\u5f97\u7a00\u6709\u6389\u843d\u7684\u51e0\u7387\u3002\u6b65\u9aa4 1\uff1a\u88c5\u5907\u63d0\u5347\u8fd0\u6c14\u7684\u88c5\u5907\u3002\u6b65\u9aa4 2\uff1a\u76ee\u6807\u660e\u786e\u5df2\u77e5\u6709\u7a00\u6709\u6389\u843d\u7684\u7279\u5b9a\u602a\u7269\u3002\u6b65\u9aa4 3\uff1a\u53c2\u4e0e\u63d0\u5347\u6389\u843d\u7387\u7684\u6d3b\u52a8\u3002\u6389\u843d\u56fe\u663e\u793a\u4e86\u6982\u7387\uff1a\u5e38\u89c1 (70%)\uff0c\u7a00\u6709 (20%)\uff0c\u53f2\u8bd7 (8%)\uff0c\u4f20\u5947 (2%)\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6389\u843d\u7269\u7684\u83b7\u53d6\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u4ed6\u4eec\u7684\u7ade\u6280\u573a\u8fdb\u5ea6\uff1f", "answer": "\u7ade\u6280\u573a\u5141\u8bb8\u901a\u8fc7\u94fe\u63a5\u5e10\u6237\u7cfb\u7edf\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5c06\u60a8\u7684 PC \u548c\u79fb\u52a8\u8bbe\u5907\u5e10\u6237\u94fe\u63a5\u8d77\u6765\u4fdd\u8bc1\u4e86\u65e0\u7f1d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u3002\u6b65\u9aa4 1\uff1a\u767b\u5f55\u5230\u539f\u59cb\u5e73\u53f0\u4e0a\u7684\u5e10\u6237\u3002\u6b65\u9aa4 2\uff1a\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u4f7f\u7528\u201c\u94fe\u63a5\u5e10\u6237\u201d\u529f\u80fd\u3002\u6b65\u9aa4 3\uff1a\u767b\u5f55\u5230\u65b0\u5e73\u53f0\u4e0a\u7684\u540c\u4e00\u5e10\u6237\u3002\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u8868\u663e\u793a\u4e86\u652f\u6301\u7684\u5e73\u53f0\uff1aPC\uff08\u662f\uff09\uff0c\u79fb\u52a8\u8bbe\u5907\uff08\u662f\uff09\uff0c\u6e38\u620f\u673a\uff08\u662f\uff09\u3002\u6b64\u529f\u80fd\u4f7f\u60a8\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u65e0\u7f1d\u5730\u8fdb\u884c\u6e38\u620f\u3002"}, {"question": "\u5982\u4f55\u89e3\u9501\u7ade\u6280\u573a\u9690\u85cf\u7684\u89d2\u8272\u76ae\u80a4\uff1f", "answer": "\u5728\u7ade\u6280\u573a\u4e2d\u89e3\u9501\u9690\u85cf\u89d2\u8272\u76ae\u80a4\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u201c\u51e4\u51f0\u201d\u76ae\u80a4\u53ef\u4ee5\u901a\u8fc7\u8d62\u5f97 50 \u573a PvP \u6bd4\u8d5b\u6765\u89e3\u9501\u3002\u6b65\u9aa4 1\uff1a\u4e13\u6ce8\u4e8e\u6240\u9700\u7684\u6311\u6218\uff0c\u4f8b\u5982\u8d62\u5f97 PvP \u6bd4\u8d5b\u3002\u6b65\u9aa4 2\uff1a\u5728\u6210\u5c31\u83dc\u5355\u4e2d\u8ddf\u8e2a\u60a8\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa4 3\uff1a\u6311\u6218\u5b8c\u6210\u540e\uff0c\u9886\u53d6\u76ae\u80a4\u3002\u76ae\u80a4\u89e3\u9501\u6d41\u7a0b\u56fe\u663e\u793a\u4e86\u8be5\u8fc7\u7a0b\uff1a\u6311\u6218 \u2192 \u8fdb\u5ea6\u8ddf\u8e2a \u2192 \u76ae\u80a4\u89e3\u9501\u3002\u8fd9\u4e9b\u76ae\u80a4\u4e3a\u60a8\u7684\u89d2\u8272\u589e\u6dfb\u4e86\u72ec\u7279\u7684\u9b45\u529b\u3002"}, {"question": "\u7ade\u6280\u573a\u7684\u6392\u540d\u7cfb\u7edf\u5982\u4f55\u8ba1\u7b97\u73a9\u5bb6\u7684\u8fdb\u6b65\uff1f", "answer": "\u7ade\u6280\u573a\u6392\u540d\u7cfb\u7edf\u6839\u636e\u80dc/\u8d1f\u6bd4\u3001\u6bd4\u8d5b\u8868\u73b0\u548c\u5bf9\u624b\u96be\u5ea6\u8ba1\u7b97\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u51fb\u8d25\u66f4\u9ad8\u7b49\u7ea7\u7684\u5bf9\u624b\u4f1a\u83b7\u5f97\u66f4\u591a\u79ef\u5206\u3002\u6b65\u9aa4 1\uff1a\u7cfb\u7edf\u8bc4\u4f30\u60a8\u7684\u6bd4\u8d5b\u7ed3\u679c\u3002\u6b65\u9aa4 2\uff1a\u5b83\u8bc4\u4f30\u60a8\u7684\u7ee9\u6548\u6307\u6807\uff0c\u4f8b\u5982\u51fb\u6740\u548c\u52a9\u653b\u3002\u6b65\u9aa4 3\uff1a\u6839\u636e\u5bf9\u624b\u96be\u5ea6\u8c03\u6574\u60a8\u7684\u7b49\u7ea7\u3002\u8fdb\u5ea6\u56fe\u663e\u793a\u4e86\u79ef\u5206\u5206\u914d\uff1a\u80dc\u5229 (+20)\uff0c\u5931\u8d25 (-10)\uff0c\u9ad8\u6027\u80fd\u52a0\u5206 (+5)\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u4e86\u51c6\u786e\u4e14\u516c\u5e73\u7684\u73a9\u5bb6\u8fdb\u5ea6\u3002"}]
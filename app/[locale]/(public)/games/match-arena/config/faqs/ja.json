[{"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u653b\u6483\u3068\u30b3\u30f3\u30dc\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u3067\u306f\u3001\u57fa\u672c\u653b\u6483\u306f\u30d7\u30e9\u30a4\u30de\u30ea\u653b\u6483\u30dc\u30bf\u30f3\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\uff1a\u5de6\u30af\u30ea\u30c3\u30af\uff09\u3092\u62bc\u3059\u3053\u3068\u3067\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u30b3\u30f3\u30dc\u306f\u3001\u57fa\u672c\u653b\u6483\u3092\u7279\u6b8a\u80fd\u529b\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u57fa\u672c\u653b\u6483\u306e\u5f8c\u306b\u300c\u30d5\u30a1\u30a4\u30a2\u30dc\u30fc\u30eb\u300d\u80fd\u529b\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\uff1aQ\uff09\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u5f37\u529b\u306a\u30b3\u30f3\u30dc\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u57fa\u672c\u653b\u6483\u3092\u884c\u3046\u305f\u3081\u306b\u5de6\u30af\u30ea\u30c3\u30af\u3092\u62bc\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u3059\u3050\u306bQ\u3092\u62bc\u3057\u3066\u300c\u30d5\u30a1\u30a4\u30a2\u30dc\u30fc\u30eb\u300d\u3092\u653e\u3061\u307e\u3059\u3002\u624b\u98063\uff1a\u9023\u7d9a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u3053\u306e\u30b3\u30f3\u30dc\u306f\u521d\u5fc3\u8005\u5411\u3051\u3067\u3001\u521d\u671f\u6bb5\u968e\u3067\u52b9\u679c\u7684\u3067\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u80fd\u529b\u3068\u7a76\u6975\u306e\u6280\u306e\u4f7f\u7528\u3092\u652f\u914d\u3057\u3066\u3044\u307e\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6700\u5927\u9650\u306e\u52b9\u679c\u3092\u767a\u63ee\u3059\u308b\u305f\u3081\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b5\u30f3\u30c0\u30fc\u30b9\u30c8\u30e9\u30a4\u30af\u300d\u80fd\u529b\u306f50\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3057\u3001\u7a76\u6975\u306e\u300c\u30a4\u30f3\u30d5\u30a7\u30eb\u30ce\u30d6\u30e9\u30b9\u30c8\u300d\u306f100\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u624b\u98061\uff1a\u6226\u95d8\u4e2d\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u30ec\u30d9\u30eb\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u4f4e\u30b3\u30b9\u30c8\u306e\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u84c4\u7a4d\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u91cd\u8981\u306a\u77ac\u9593\u306b\u306f\u7a76\u6975\u306e\u6280\u306e\u305f\u3081\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u30b3\u30b9\u30c8\u3092\u793a\u3057\u307e\u3059\uff1a\u57fa\u672c\u80fd\u529b\uff0850\uff09\u3001\u7a76\u6975\uff08100\uff09\u3001\u7279\u6b8a\uff0875\uff09\u3002\u52b9\u7387\u7684\u306a\u30a8\u30cd\u30eb\u30ae\u30fc\u7ba1\u7406\u306f\u3001\u6226\u6cc1\u3092\u8ee2\u63db\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306ePvP\u30e2\u30fc\u30c9\u3068PvE\u30e2\u30fc\u30c9\u306e\u91cd\u8981\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306ePvP\uff08\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u30d7\u30ec\u30a4\u30e4\u30fc\uff09\u30e2\u30fc\u30c9\u3068PvE\uff08\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u74b0\u5883\uff09\u30e2\u30fc\u30c9\u306f\u3001\u7570\u306a\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002PvP\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e92\u3044\u306b\u5bfe\u6226\u3059\u308b\u3001\u7af6\u4e89\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30a2\u30ea\u30fc\u30ca\u30af\u30e9\u30c3\u30b7\u30e5\u300d\u30e2\u30fc\u30c9\u3002PvE\u306f\u3001AI\u6575\u3068\u5354\u529b\u3057\u3066\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u300c\u30c0\u30f3\u30b8\u30e7\u30f3\u30ec\u30a4\u30c9\u300d\u30e2\u30fc\u30c9\u306a\u3069\u3002\u4f8b\u3068\u3057\u3066\u3001PvP\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u304c\u91cd\u8981\u3067\u3042\u308b\u4e00\u65b9\u3067\u3001PvE\u3067\u306f\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u91cd\u8981\u3067\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u610f\u601d\u6c7a\u5b9a\u30d7\u30ed\u30bb\u30b9\u3092\u793a\u3057\u3066\u3044\u307e\u3059\uff1aPvP\u2192\u7af6\u4e89\u7684\u2192\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u6226\u7565; PvE\u2192\u5354\u529b\u7684\u2192\u30ea\u30bd\u30fc\u30b9\u306e\u5272\u308a\u5f53\u3066\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u30b3\u30f3\u30c6\u30f3\u30c4\u5411\u3051\u306b\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u30b3\u30f3\u30c6\u30f3\u30c4\u5411\u3051\u306b\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u9069\u5207\u306a\u88c5\u5099\u3068\u80fd\u529b\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b7\u30e3\u30c9\u30a6\u30a2\u30b5\u30b7\u30f3\u300d\u30d3\u30eb\u30c9\u306f\u3001\u9ad8\u3044\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3068\u6a5f\u654f\u6027\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u624b\u98061\uff1a\u300c\u30b7\u30e3\u30c9\u30a6\u30af\u30ed\u30c3\u30af\u300d\u306e\u3088\u3046\u306a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3092\u9ad8\u3081\u308b\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u79fb\u52d5\u6027\u306e\u305f\u3081\u306e\u300c\u30b7\u30e3\u30c9\u30a6\u30b9\u30c6\u30c3\u30d7\u300d\u3084\u7206\u767a\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u306e\u305f\u3081\u306e\u300c\u6697\u6bba\u300d\u306a\u3069\u306e\u80fd\u529b\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u6a5f\u654f\u6027\u3092\u9ad8\u3081\u308b\u30eb\u30fc\u30f3\u3067\u88c5\u5099\u3092\u5f37\u5316\u3057\u307e\u3059\u3002\u69cb\u6210\u8868\u306b\u6700\u9069\u306a\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u793a\u3057\u307e\u3059\uff1a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\uff0850\uff05\uff09\u3001\u6a5f\u654f\u6027\uff0830\uff05\uff09\u3001\u4f53\u529b\uff0820\uff05\uff09\u3002\u3053\u306e\u30d3\u30eb\u30c9\u306f\u9ad8\u96e3\u6613\u5ea6\u30ec\u30a4\u30c9\u3067\u512a\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30c1\u30fc\u30e0\u6226\u3067\u30bf\u30f3\u30af\u5f79\u3068\u3057\u3066\u6700\u9069\u306a\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u80fd\u529b\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u3067\u306f\u3001\u30b7\u30ca\u30fc\u30b8\u30fc\u52b9\u679c\u306e\u9ad8\u3044\u30bf\u30f3\u30af\u80fd\u529b\u306b\u306f\u300c\u30b7\u30fc\u30eb\u30c9\u30d0\u30c3\u30b7\u30e5\u300d\u3068\u300c\u6311\u767a\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u30b7\u30fc\u30eb\u30c9\u30d0\u30c3\u30b7\u30e5\u300d\u306f\u6575\u3092\u30b9\u30bf\u30f3\u3055\u305b\u3001\u300c\u6311\u767a\u300d\u306f\u6575\u306e\u653b\u6483\u3092\u5f15\u304d\u4ed8\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u6226\u3067\u306f\u3001\u300c\u6311\u767a\u300d\u3092\u4f7f\u7528\u3057\u3066\u6575\u306e\u653b\u6483\u3092\u81ea\u5206\u306b\u5411\u3051\u3001\u305d\u306e\u5f8c\u306b\u300c\u30b7\u30fc\u30eb\u30c9\u30d0\u30c3\u30b7\u30e5\u300d\u3067\u91cd\u8981\u306a\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7121\u52b9\u5316\u3057\u307e\u3059\u3002\u624b\u98061\uff1a\u300c\u6311\u767a\u300d\u3067\u6575\u306e\u6ce8\u610f\u3092\u5f15\u304d\u4ed8\u3051\u307e\u3059\u3002\u624b\u98062\uff1a\u300c\u30b7\u30fc\u30eb\u30c9\u30d0\u30c3\u30b7\u30e5\u300d\u3092\u4f7f\u7528\u3057\u3066\u512a\u5148\u5ea6\u306e\u9ad8\u3044\u6575\u3092\u30b9\u30bf\u30f3\u3055\u305b\u307e\u3059\u3002\u624b\u98063\uff1a\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3092\u4fdd\u8b77\u3059\u308b\u305f\u3081\u306b\u81ea\u5206\u81ea\u8eab\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b7\u30ca\u30b8\u30fc\u56f3\u306f\u30d5\u30ed\u30fc\u3092\u793a\u3057\u307e\u3059\uff1a\u6311\u767a\u2192\u30a2\u30b0\u30ed\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u2192\u30b7\u30fc\u30eb\u30c9\u30d0\u30c3\u30b7\u30e5\u2192\u30af\u30e9\u30a6\u30c9\u30e9\u30a4\u30c9\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3002\u3053\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u3001\u30c1\u30fc\u30e0\u306e\u751f\u5b58\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u516c\u5e73\u306aPvP\u30d0\u30c8\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u78ba\u4fdd\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u30e9\u30f3\u30af\u3001\u52dd\u6557\u6bd4\u3001\u6700\u8fd1\u306e\u6210\u679c\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u516c\u5e73\u306aPvP\u30d0\u30c8\u30eb\u3092\u78ba\u4fdd\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e9\u30f3\u30af1500\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30e9\u30f3\u30af100\u30dd\u30a4\u30f3\u30c8\u7bc4\u56f2\u5185\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002\u624b\u98061\uff1a\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u306e\u73fe\u5728\u306e\u30e9\u30f3\u30af\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u305d\u308c\u306f\u540c\u69d8\u306e\u7d71\u8a08\u3092\u6301\u3064\u5bfe\u6226\u76f8\u624b\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u305d\u308c\u306f\u3001\u30b9\u30ad\u30eb\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u305f\u3081\u306b\u3001\u6700\u8fd1\u306e\u6210\u679c\u306b\u57fa\u3065\u3044\u3066\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306b\u30de\u30c3\u30c1\u30f3\u30b0\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u793a\u3057\u307e\u3059\uff1a\u30e9\u30f3\u30af\uff081500\uff09\u3001\u52dd\u6557\u6bd4\uff081.2\uff09\u3001\u6700\u8fd1\u306e\u6210\u679c\uff08\u80af\u5b9a\u7684\uff09\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u7af6\u4e89\u7684\u306a\u8a66\u5408\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002"}, {"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u6226\u5229\u54c1\u30c9\u30ed\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u6226\u5229\u54c1\u30c9\u30ed\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u3001\u904b\u5c5e\u6027\u306e\u5f71\u97ff\u3084\u30e2\u30f3\u30b9\u30bf\u30fc\u30bf\u30a4\u30d7\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u3044\u904b\u5c5e\u6027\u3092\u6301\u3064\u300c\u30c9\u30e9\u30b4\u30f3\u300d\u3092\u5012\u3059\u3068\u3001\u30ec\u30a2\u306a\u6226\u5229\u54c1\u306e\u7372\u5f97\u7387\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u904b\u3092\u9ad8\u3081\u308b\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u30ec\u30a2\u306a\u6226\u5229\u54c1\u3067\u77e5\u3089\u308c\u3066\u3044\u308b\u7279\u5b9a\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30c9\u30ed\u30c3\u30d7\u7387\u3092\u9ad8\u3081\u308b\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u6226\u5229\u54c1\u30c9\u30ed\u30c3\u30d7\u30c1\u30e3\u30fc\u30c8\u306b\u78ba\u7387\u3092\u793a\u3057\u307e\u3059\uff1a\u4e00\u822c\u7684\uff0870\uff05\uff09\u3001\u30ec\u30a2\uff0820\uff05\uff09\u3001\u30a8\u30d4\u30c3\u30af\uff088\uff05\uff09\u3001\u4f1d\u8aac\u7684\uff082\uff05\uff09\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u6226\u5229\u54c1\u306e\u7372\u5f97\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u9032\u884c\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306f\u3001\u9023\u643a\u30a2\u30ab\u30a6\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u9023\u643a\u3059\u308b\u3068\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u9032\u884c\u72b6\u6cc1\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002\u624b\u98061\uff1a\u5143\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u9023\u643a\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u8868\u306b\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u793a\u3057\u307e\u3059\uff1aPC\uff08\u306f\u3044\uff09\u3001\u30e2\u30d0\u30a4\u30eb\uff08\u306f\u3044\uff09\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\uff08\u306f\u3044\uff09\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9014\u5207\u308c\u308b\u3053\u3068\u306a\u304f\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306e\u79d8\u8a23\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u6210\u679c\u3092\u9054\u6210\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d5\u30a7\u30cb\u30c3\u30af\u30b9\u300d\u30b9\u30ad\u30f3\u306f\u300150\u56de\u306ePvP\u30de\u30c3\u30c1\u306b\u52dd\u5229\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u624b\u98061\uff1aPvP\u30de\u30c3\u30c1\u306b\u52dd\u5229\u3059\u308b\u3068\u3044\u3046\u3088\u3046\u306a\u5fc5\u8981\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u5b9f\u7e3e\u30e1\u30cb\u30e5\u30fc\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ffd\u8de1\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u5b8c\u4e86\u3057\u305f\u3089\u3001\u30b9\u30ad\u30f3\u3092\u5165\u624b\u3057\u307e\u3059\u3002\u30b9\u30ad\u30f3\u30a2\u30f3\u30ed\u30c3\u30af\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u793a\u3057\u3066\u3044\u307e\u3059\uff1a\u30c1\u30e3\u30ec\u30f3\u30b8\u2192\u9032\u884c\u72b6\u6cc1\u8ffd\u8de1\u2192\u30b9\u30ad\u30f3\u30a2\u30f3\u30ed\u30c3\u30af\u3002\u3053\u308c\u3089\u306e\u30b9\u30ad\u30f3\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u30e6\u30cb\u30fc\u30af\u306a\u9b45\u529b\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30c3\u30c1\u30a2\u30ea\u30fc\u30ca\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u52dd\u6557\u6bd4\u3001\u8a66\u5408\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3001\u5bfe\u6226\u76f8\u624b\u306e\u96e3\u6613\u5ea6\u306b\u57fa\u3065\u3044\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e0a\u4f4d\u30e9\u30f3\u30af\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u52dd\u5229\u3059\u308b\u3068\u3001\u3088\u308a\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8a66\u5408\u7d50\u679c\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u30ad\u30eb\u6570\u3084\u30a2\u30b7\u30b9\u30c8\u306a\u3069\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u6307\u6a19\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u96e3\u6613\u5ea6\u306b\u57fa\u3065\u3044\u3066\u3001\u30e9\u30f3\u30af\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u9032\u884c\u72b6\u6cc1\u30c1\u30e3\u30fc\u30c8\u306b\u30dd\u30a4\u30f3\u30c8\u306e\u914d\u5206\u3092\u793a\u3057\u307e\u3059\uff1a\u52dd\u5229\uff08+20\uff09\u3001\u6557\u5317\uff08-10\uff09\u3001\u9ad8\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30dc\u30fc\u30ca\u30b9\uff08+5\uff09\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306b\u3088\u308a\u3001\u6b63\u78ba\u3067\u516c\u5e73\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}]
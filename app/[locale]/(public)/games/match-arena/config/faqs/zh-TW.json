[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u5165\u9580\u7684\u7af6\u6280\u5834\u9032\u884c\u57fa\u672c\u653b\u64ca\u548c\u9023\u64ca\uff1f", "answer": "\u5728\u7af6\u6280\u5834\u4e2d\uff0c\u57fa\u672c\u653b\u64ca\u662f\u901a\u904e\u6309\u4e0b\u4e3b\u8981\u653b\u64ca\u6309\u9215\uff08\u9810\u8a2d\uff1a\u5de6\u9375\u9ede\u64ca\uff09\u4f86\u57f7\u884c\u7684\u3002\u9023\u64ca\u662f\u901a\u904e\u5c07\u57fa\u672c\u653b\u64ca\u8207\u7279\u6b8a\u80fd\u529b\u9023\u63a5\u8d77\u4f86\u5b8c\u6210\u7684\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u57fa\u672c\u653b\u64ca\uff0c\u63a5\u8457\u4f7f\u7528\u300e\u706b\u7403\u300f\u6280\u80fd\uff08\u9810\u8a2d\uff1aQ\uff09\u4f86\u5275\u9020\u5f37\u5927\u7684\u9023\u64ca\u3002\u6b65\u9a5f 1\uff1a\u6309\u4e0b\u5de6\u9375\u9ede\u64ca\u9032\u884c\u57fa\u672c\u653b\u64ca\u3002\u6b65\u9a5f 2\uff1a\u7acb\u5373\u6309\u4e0b Q \u65bd\u653e\u300e\u706b\u7403\u300f\u3002\u6b65\u9a5f 3\uff1a\u91cd\u8907\u6b64\u5e8f\u5217\u4ee5\u6301\u7e8c\u9020\u6210\u50b7\u5bb3\u3002\u6b64\u9023\u64ca\u5c0d\u65b0\u624b\u4f86\u8aaa\u5bb9\u6613\u4e0a\u624b\uff0c\u4e26\u4e14\u5728\u65e9\u671f\u968e\u6bb5\u6709\u6548\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u7af6\u6280\u5834\u7684\u80fd\u91cf\u7cfb\u7d71\u5c0d\u65bc\u9032\u968e\u73a9\u5bb6\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7af6\u6280\u5834\u7684\u80fd\u91cf\u7cfb\u7d71\u63a7\u5236\u8457\u6280\u80fd\u548c\u6700\u7d42\u62db\u5f0f\u7684\u4f7f\u7528\u3002\u9032\u968e\u73a9\u5bb6\u5fc5\u9808\u6709\u6548\u5730\u7ba1\u7406\u80fd\u91cf\uff0c\u4ee5\u6700\u5927\u5316\u5176\u5f71\u97ff\u529b\u3002\u4f8b\u5982\uff0c\u300e\u96f7\u96fb\u885d\u64ca\u300f\u6280\u80fd\u6d88\u8017 50 \u9ede\u80fd\u91cf\uff0c\u800c\u6700\u7d42\u62db\u5f0f\u300e\u70c8\u7130\u7206\u7834\u300f\u5247\u9700\u8981 100 \u9ede\u3002\u6b65\u9a5f 1\uff1a\u5728\u6230\u9b25\u4e2d\u76e3\u63a7\u80fd\u91cf\u503c\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u4f4e\u6210\u672c\u6280\u80fd\u4f86\u7d2f\u7a4d\u80fd\u91cf\u3002\u6b65\u9a5f 3\uff1a\u5728\u95dc\u9375\u6642\u523b\u5132\u5b58\u80fd\u91cf\u4ee5\u4f7f\u7528\u6700\u7d42\u62db\u5f0f\u3002\u80fd\u91cf\u6210\u672c\u6bd4\u8f03\u8868\uff1a\u57fa\u672c\u6280\u80fd (50)\uff0c\u6700\u7d42\u62db\u5f0f (100)\uff0c\u7279\u6b8a\u6280\u80fd (75)\u3002\u6709\u6548\u7684\u80fd\u91cf\u7ba1\u7406\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002"}, {"question": "\u7af6\u6280\u5834\u7684 PvP \u548c PvE \u6a21\u5f0f\u4e4b\u9593\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u7af6\u6280\u5834\u7684 PvP\uff08\u73a9\u5bb6\u5c0d\u73a9\u5bb6\uff09\u548c PvE\uff08\u73a9\u5bb6\u5c0d\u74b0\u5883\uff09\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u9ad4\u9a57\u3002PvP \u95dc\u6ce8\u7af6\u722d\u6027\u904a\u6232\uff0c\u73a9\u5bb6\u4e92\u76f8\u5c0d\u6297\uff0c\u4f8b\u5982\u300e\u7af6\u6280\u5834\u885d\u7a81\u300f\u6a21\u5f0f\u3002PvE \u6d89\u53ca\u8207 AI \u6575\u4eba\u5408\u4f5c\u7684\u904a\u6232\uff0c\u4f8b\u5982\u300e\u5730\u4e0b\u57ce\u7a81\u8972\u300f\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728 PvP \u4e2d\uff0c\u6642\u9593\u548c\u7b56\u7565\u81f3\u95dc\u91cd\u8981\uff0c\u800c\u5728 PvE \u4e2d\uff0c\u5718\u968a\u5408\u4f5c\u548c\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\u3002\u6d41\u7a0b\u5716\u8aaa\u660e\u4e86\u6c7a\u7b56\u904e\u7a0b\uff1aPvP \u2192 \u7af6\u722d\u6027 \u2192 \u5373\u6642\u7b56\u7565\uff1bPvE \u2192 \u5354\u4f5c\u6027 \u2192 \u8cc7\u6e90\u5206\u914d\u3002"}, {"question": "\u5982\u4f55\u91dd\u5c0d\u7d42\u6975\u5167\u5bb9\u512a\u5316\u7af6\u6280\u5834\u89d2\u8272\u7684\u88dd\u5099\uff1f", "answer": "\u70ba\u7af6\u6280\u5834\u7684\u7d42\u6975\u5167\u5bb9\u512a\u5316\u89d2\u8272\u88dd\u5099\uff0c\u9700\u8981\u9078\u64c7\u6b63\u78ba\u7684\u88dd\u5099\u548c\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u300e\u6697\u5f71\u523a\u5ba2\u300f\u7684\u88dd\u5099\u91cd\u9ede\u662f\u9ad8\u66b4\u64ca\u7387\u548c\u654f\u6377\u3002\u6b65\u9a5f 1\uff1a\u88dd\u5099\u63d0\u5347\u66b4\u64ca\u7387\u7684\u88dd\u5099\uff0c\u4f8b\u5982\u300e\u6697\u5f71\u6597\u7bf7\u300f\u3002\u6b65\u9a5f 2\uff1a\u9078\u64c7\u50cf\u662f\u300e\u6697\u5f71\u77ac\u79fb\u300f\u7684\u6280\u80fd\u4f86\u63d0\u5347\u6a5f\u52d5\u6027\u4ee5\u53ca\u300e\u6697\u6bba\u300f\u6280\u80fd\u4f86\u9020\u6210\u7a81\u767c\u50b7\u5bb3\u3002\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u589e\u52a0\u654f\u6377\u5ea6\u7684\u7b26\u6587\u5f37\u5316\u88dd\u5099\u3002\u914d\u7f6e\u8868\u986f\u793a\u6700\u4f73\u6578\u503c\uff1a\u66b4\u64ca\u7387 (50%)\uff0c\u654f\u6377 (30%)\uff0c\u751f\u547d\u503c (20%)\u3002\u6b64\u88dd\u5099\u8a2d\u5b9a\u5728\u9ad8\u96e3\u5ea6\u7a81\u8972\u4e2d\u8868\u73fe\u51fa\u8272\u3002"}, {"question": "\u5728\u5718\u968a\u6230\u9b25\u4e2d\uff0c\u54ea\u4e9b\u7af6\u6280\u5834\u6280\u80fd\u6700\u9069\u5408\u5766\u514b\u89d2\u8272\uff1f", "answer": "\u5728\u7af6\u6280\u5834\u4e2d\uff0c\u9069\u5408\u7684\u5766\u514b\u6280\u80fd\u5305\u62ec\u300e\u76fe\u64ca\u300f\u548c\u300e\u6311\u91c1\u300f\u3002\u300e\u76fe\u64ca\u300f\u80fd\u4f7f\u6575\u4eba\u6688\u7729\uff0c\u800c\u300e\u6311\u91c1\u300f\u5247\u80fd\u5438\u5f15\u6575\u4eba\u7684\u4ec7\u6068\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6230\u9b25\u4e2d\uff0c\u4f7f\u7528\u300e\u6311\u91c1\u300f\u4f86\u5c07\u6575\u4eba\u7684\u653b\u64ca\u96c6\u4e2d\u5728\u60a8\u8eab\u4e0a\uff0c\u63a5\u8457\u4f7f\u7528\u300e\u76fe\u64ca\u300f\u4f86\u4f7f\u95dc\u9375\u6575\u4eba\u5931\u53bb\u6230\u9b25\u80fd\u529b\u3002\u6b65\u9a5f 1\uff1a\u65bd\u653e\u300e\u6311\u91c1\u300f\u4f86\u5438\u5f15\u6575\u4eba\u7684\u6ce8\u610f\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u300e\u76fe\u64ca\u300f\u4f86\u4f7f\u9ad8\u512a\u5148\u7d1a\u6575\u4eba\u6688\u7729\u3002\u6b65\u9a5f 3\uff1a\u5c07\u81ea\u5df1\u5b9a\u4f4d\u5728\u4fdd\u8b77\u968a\u53cb\u7684\u4f4d\u7f6e\u3002\u5354\u540c\u5716\u986f\u793a\u6d41\u7a0b\uff1a\u6311\u91c1 \u2192 \u4ec7\u6068\u63a7\u5236 \u2192 \u76fe\u64ca \u2192 \u7fa4\u9ad4\u63a7\u5236\u3002\u6b64\u7d44\u5408\u78ba\u4fdd\u5718\u968a\u7684\u751f\u5b58\u3002"}, {"question": "\u7af6\u6280\u5834\u7684\u5339\u914d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u516c\u5e73\u7684 PvP \u6230\u9b25\uff1f", "answer": "\u7af6\u6280\u5834\u7684\u5339\u914d\u7cfb\u7d71\u4f7f\u7528\u73a9\u5bb6\u7b49\u7d1a\u3001\u52dd\u7387\u548c\u8fd1\u671f\u8868\u73fe\u7684\u7d44\u5408\u4f86\u78ba\u4fdd\u516c\u5e73\u7684 PvP \u6230\u9b25\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u64c1\u6709 1500 \u7b49\u7d1a\uff0c\u5c07\u8207\u7b49\u7d1a\u5728 100 \u5206\u7bc4\u570d\u5167\u7684\u73a9\u5bb6\u9032\u884c\u5339\u914d\u3002\u6b65\u9a5f 1\uff1a\u7cfb\u7d71\u8a55\u4f30\u60a8\u7684\u7576\u524d\u7b49\u7d1a\u3002\u6b65\u9a5f 2\uff1a\u5b83\u5c0b\u627e\u5177\u6709\u985e\u4f3c\u7d71\u8a08\u6578\u64da\u7684\u5c0d\u624b\u3002\u6b65\u9a5f 3\uff1a\u6839\u64da\u8fd1\u671f\u8868\u73fe\u8abf\u6574\u5339\u914d\uff0c\u4ee5\u5e73\u8861\u6280\u80fd\u7b49\u7d1a\u3002\u6bd4\u8f03\u8868\u683c\u986f\u793a\u5339\u914d\u53c3\u6578\uff1a\u7b49\u7d1a (1500)\uff0c\u52dd\u7387 (1.2)\uff0c\u8fd1\u671f\u8868\u73fe (\u6b63\u9762)\u3002\u6b64\u7cfb\u7d71\u4fc3\u9032\u5e73\u8861\u4e14\u7af6\u722d\u6027\u7684\u5339\u914d\u3002"}, {"question": "\u7af6\u6280\u5834\u7684\u6389\u843d\u7cfb\u7d71\u80cc\u5f8c\u7684\u96b1\u85cf\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7af6\u6280\u5834\u7684\u6389\u843d\u7cfb\u7d71\u5305\u542b\u96b1\u85cf\u6a5f\u5236\uff0c\u4f8b\u5982\u5e78\u904b\u5c6c\u6027\u5f71\u97ff\u548c\u602a\u7269\u985e\u578b\u3002\u4f8b\u5982\uff0c\u64ca\u6557\u64c1\u6709\u9ad8\u5e78\u904b\u5c6c\u6027\u7684\u300e\u9f8d\u300f\uff0c\u53ef\u4ee5\u63d0\u9ad8\u7a00\u6709\u6389\u843d\u7684\u6a5f\u7387\u3002\u6b65\u9a5f 1\uff1a\u88dd\u5099\u63d0\u5347\u5e78\u904b\u7684\u88dd\u5099\u3002\u6b65\u9a5f 2\uff1a\u9396\u5b9a\u5df2\u77e5\u6389\u843d\u7a00\u6709\u7269\u54c1\u7684\u7279\u5b9a\u602a\u7269\u3002\u6b65\u9a5f 3\uff1a\u53c3\u8207\u63d0\u9ad8\u6389\u843d\u7387\u7684\u6d3b\u52d5\u3002\u6389\u843d\u5716\u8868\u8aaa\u660e\u6a5f\u7387\uff1a\u5e38\u898b (70%)\uff0c\u7a00\u6709 (20%)\uff0c\u53f2\u8a69 (8%)\uff0c\u50b3\u5947 (2%)\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u6389\u843d\u7269\u54c1\u7684\u7372\u5f97\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u7af6\u6280\u5834\u7684\u9032\u5ea6\uff1f", "answer": "\u7af6\u6280\u5834\u5141\u8a31\u4f7f\u7528\u9023\u7d50\u5e33\u6236\u7cfb\u7d71\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u9023\u7d50\u60a8\u7684\u96fb\u8166\u548c\u624b\u6a5f\u5e33\u6236\uff0c\u53ef\u4ee5\u78ba\u4fdd\u9806\u5229\u8f49\u79fb\u9032\u5ea6\u3002\u6b65\u9a5f 1\uff1a\u767b\u5165\u539f\u59cb\u5e73\u53f0\u7684\u5e33\u6236\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u300e\u9023\u7d50\u5e33\u6236\u300f\u529f\u80fd\u3002\u6b65\u9a5f 3\uff1a\u767b\u5165\u65b0\u5e73\u53f0\u4e0a\u7684\u76f8\u540c\u5e33\u6236\u3002\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u8868\u683c\u986f\u793a\u652f\u63f4\u7684\u5e73\u53f0\uff1aPC (\u662f)\uff0c\u624b\u6a5f (\u662f)\uff0c\u4e3b\u6a5f (\u662f)\u3002\u6b64\u529f\u80fd\u53ef\u5728\u5404\u88dd\u7f6e\u9593\u7121\u7e2b\u5730\u9032\u884c\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u89e3\u9396\u7af6\u6280\u5834\u7684\u96b1\u85cf\u89d2\u8272\u76ae\u819a\uff1f", "answer": "\u89e3\u9396\u7af6\u6280\u5834\u7684\u96b1\u85cf\u89d2\u8272\u76ae\u819a\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u300e\u9cf3\u51f0\u300f\u76ae\u819a\u662f\u901a\u904e\u8d0f\u5f97 50 \u5834 PvP \u6bd4\u8cfd\u4f86\u89e3\u9396\u3002\u6b65\u9a5f 1\uff1a\u5c08\u6ce8\u65bc\u6240\u9700\u7684\u6311\u6230\uff0c\u4f8b\u5982\u8d0f\u5f97 PvP \u6bd4\u8cfd\u3002\u6b65\u9a5f 2\uff1a\u5728\u6210\u5c31\u9078\u55ae\u4e2d\u8ffd\u8e64\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f 3\uff1a\u6311\u6230\u5b8c\u6210\u5f8c\uff0c\u5373\u53ef\u9818\u53d6\u76ae\u819a\u3002\u76ae\u819a\u89e3\u9396\u6d41\u7a0b\u5716\u986f\u793a\u904e\u7a0b\uff1a\u6311\u6230 \u2192 \u9032\u5ea6\u8ffd\u8e64 \u2192 \u76ae\u819a\u89e3\u9396\u3002\u9019\u4e9b\u76ae\u819a\u70ba\u60a8\u7684\u89d2\u8272\u589e\u6dfb\u7368\u7279\u98a8\u683c\u3002"}, {"question": "\u7af6\u6280\u5834\u7684\u6392\u540d\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u73a9\u5bb6\u7684\u9032\u5ea6\uff1f", "answer": "\u7af6\u6280\u5834\u7684\u6392\u540d\u7cfb\u7d71\u6839\u64da\u52dd\u7387\u3001\u6bd4\u8cfd\u8868\u73fe\u548c\u5c0d\u624b\u96e3\u5ea6\u4f86\u8a08\u7b97\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u64ca\u6557\u66f4\u9ad8\u6392\u540d\u5c0d\u624b\u53ef\u4ee5\u7372\u5f97\u66f4\u591a\u7a4d\u5206\u3002\u6b65\u9a5f 1\uff1a\u7cfb\u7d71\u8a55\u4f30\u60a8\u7684\u6bd4\u8cfd\u7d50\u679c\u3002\u6b65\u9a5f 2\uff1a\u5b83\u8a55\u4f30\u60a8\u7684\u8868\u73fe\u6307\u6a19\uff0c\u4f8b\u5982\u6bba\u6575\u6578\u548c\u52a9\u653b\u6578\u3002\u6b65\u9a5f 3\uff1a\u6839\u64da\u5c0d\u624b\u96e3\u5ea6\u8abf\u6574\u60a8\u7684\u7b49\u7d1a\u3002\u9032\u5ea6\u5716\u8868\u986f\u793a\u7a4d\u5206\u5206\u914d\uff1a\u52dd\u5229 (+20)\uff0c\u5931\u6557 (-10)\uff0c\u9ad8\u8868\u73fe\u734e\u52f5 (+5)\u3002\u6b64\u7cfb\u7d71\u78ba\u4fdd\u6e96\u78ba\u4e14\u516c\u5e73\u7684\u73a9\u5bb6\u9032\u5ea6\u3002"}]
[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5f00\u59cb FNF vs Touhou \u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb FNF vs Touhou\uff0c\u4f60\u9700\u8981\u4e86\u89e3\u6e38\u620f\u7684\u57fa\u672c\u673a\u5236\u3002\u9996\u5148\uff0c\u4ece\u5b98\u65b9\u7f51\u7ad9\u6216\u53ef\u4fe1\u6765\u6e90\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u5bfc\u822a\u5230\u8bbe\u7f6e\u8c03\u6574\u6309\u952e\u7ed1\u5b9a\u4ee5\u6ee1\u8db3\u4f60\u7684\u559c\u597d\u3002\u4f8b\u5982\uff0c\u8bb8\u591a\u73a9\u5bb6\u559c\u6b22\u4f7f\u7528\u65b9\u5411\u952e\u8fdb\u884c\u65b9\u5411\u63a7\u5236\uff0c\u5e76\u4f7f\u7528'Z'\u548c'X'\u8fdb\u884c\u64cd\u4f5c\u3002\u4ece\u6559\u7a0b\u5f00\u59cb\uff0c\u4f53\u9a8c\u8282\u594f\u7c7b\u6e38\u620f\u73a9\u6cd5\u3002\u5148\u7528\u7b80\u5355\u96be\u5ea6\u7ec3\u4e60\u524d\u51e0\u9996\u6b4c\uff0c\u5efa\u7acb\u4f60\u7684\u4fe1\u5fc3\u3002\u8bb0\u4f4f\uff0c\u6301\u7eed\u6027\u81f3\u5173\u91cd\u8981\uff0c\u6240\u4ee5\u8981\u5b9a\u671f\u8fdb\u884c\u6e38\u620f\u4ee5\u63d0\u9ad8\u4f60\u7684\u65f6\u95f4\u611f\u548c\u53cd\u5e94\u901f\u5ea6\u3002"}, {"question": "\u5728 FNF vs Touhou \u4e2d\uff0c\u638c\u63e1\u9ad8\u7ea7\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728 FNF vs Touhou \u4e2d\u638c\u63e1\u9ad8\u7ea7\u5173\u5361\u9700\u8981\u7ed3\u5408\u7ec3\u4e60\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u8bb0\u4f4f\u6b4c\u66f2\u7684\u6a21\u5f0f\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u6709\u72ec\u7279\u7684\u91cd\u590d\u51fa\u73b0\u7684\u97f3\u7b26\u5e8f\u5217\u3002\u6b65\u9aa4\u4e8c\uff1a\u9010\u6e10\u63d0\u9ad8\u6e38\u620f\u901f\u5ea6\u3002\u4ece\u8f83\u6162\u7684\u901f\u5ea6\u5f00\u59cb\uff0c\u5e76\u5728\u9002\u5e94\u540e\u9010\u6e10\u52a0\u5feb\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u9694\u79bb\u56f0\u96be\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u201c\u6559\u7a0b\u201d\u4e2d\uff0c\u63a5\u8fd1\u5c3e\u58f0\u7684\u90e8\u5206\u6709\u4e00\u8fde\u4e32\u5feb\u901f\u97f3\u7b26\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5f88\u68d8\u624b\u3002\u91cd\u590d\u8fd9\u4e00\u90e8\u5206\u6709\u52a9\u4e8e\u638c\u63e1\u65f6\u95f4\u3002\u6b64\u5916\uff0c\u89c2\u770b\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u7684\u6e38\u620f\u89c6\u9891\u53ef\u4ee5\u4e86\u89e3\u9ad8\u6548\u7684\u7b56\u7565\u3002"}, {"question": "FNF vs Touhou \u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6570\uff1f", "answer": "FNF vs Touhou \u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51c6\u786e\u7387\u548c\u8fde\u51fb\u500d\u6570\u3002\u6bcf\u6b21\u4f60\u51c6\u786e\u5730\u51fb\u4e2d\u4e00\u4e2a\u97f3\u7b26\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u8fde\u7eed\u51fb\u4e2d\u97f3\u7b26\u4f1a\u589e\u52a0\u4f60\u7684\u8fde\u51fb\u500d\u6570\uff0c\u4ece\u800c\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u51fb\u4e2d 10 \u4e2a\u97f3\u7b26\u800c\u6ca1\u6709\u9519\u8fc7\u4f1a\u6bd4\u5728\u4e2d\u95f4\u9519\u8fc7\u51e0\u4e2a\u97f3\u7b26\u800c\u51fb\u4e2d 10 \u4e2a\u97f3\u7b26\u5f97\u5230\u66f4\u9ad8\u7684\u5206\u6570\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5206\u6570\uff0c\u5e94\u8ffd\u6c42\u5b8c\u7f8e\u51c6\u786e\u7387\u548c\u4fdd\u6301\u8f83\u957f\u7684\u8fde\u51fb\u3002\u5229\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u6539\u8fdb\u4f60\u5728\u7279\u5b9a\u6b4c\u66f2\u4e0a\u7684\u65f6\u95f4\u611f\u548c\u51c6\u786e\u7387\u3002\u6b64\u5916\uff0c\u8bf7\u6ce8\u610f\u201c\u5b8c\u7f8e\u201d\u8bc4\u4ef7\uff0c\u8fd9\u662f\u5bf9\u97f3\u7b26\u7684\u6700\u9ad8\u8bc4\u4ef7\u3002\u5e76\u5c1d\u8bd5\u6301\u7eed\u83b7\u5f97\u5b83\u3002"}, {"question": "FNF vs Touhou \u4e0e\u539f\u59cb FNF \u6e38\u620f\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u4e0e\u539f\u59cb FNF \u6e38\u620f\u76f8\u6bd4\uff0cFNF vs Touhou \u5f15\u5165\u4e86\u4e00\u4e9b\u72ec\u7279\u7684\u5143\u7d20\u3002\u9996\u5148\uff0c\u89d2\u8272\u548c\u6b4c\u66f2\u6765\u81ea\u4e1c\u65b9 Project \u7cfb\u5217\uff0c\u8fd9\u5e26\u6765\u4e0d\u540c\u7684\u5ba1\u7f8e\u548c\u97f3\u4e50\u98ce\u683c\u3002\u4f8b\u5982\uff0c\u6b4c\u66f2\u201cU.N. Owen Was Her\uff1f\u201d\u662f\u70ed\u95e8\u4e1c\u65b9\u6b4c\u66f2\u7684\u7ffb\u5531\u3002\u5176\u6b21\uff0c\u6e38\u620f\u673a\u5236\u5305\u542b\u4e86\u989d\u5916\u7684\u529f\u80fd\uff0c\u4f8b\u5982\u7279\u6b8a\u52a8\u4f5c\u548c\u72ec\u7279\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u53cd\u6620\u4e1c\u65b9\u5b87\u5b99\u3002\u6700\u540e\uff0c\u96be\u5ea6\u66f2\u7ebf\u9488\u5bf9 FNF \u548c\u4e1c\u65b9\u7c89\u4e1d\u91cf\u8eab\u5b9a\u5236\uff0c\u63d0\u4f9b\u719f\u6089\u548c\u65b0\u6311\u6218\u7684\u7ed3\u5408\u3002\u8fd9\u4e9b\u5dee\u5f02\u8ba9 FNF vs Touhou \u6210\u4e3a\u4e86\u4e24\u5927\u7cfb\u5217\u73a9\u5bb6\u7684\u65b0\u9c9c\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211 FNF vs Touhou \u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\uff1f", "answer": "\u8f6c\u79fb FNF vs Touhou \u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u9700\u8981\u51e0\u4e2a\u6b65\u9aa4\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u5f53\u524d\u8bbe\u5907\u4e0a\u627e\u5230\u5b58\u6863\u6587\u4ef6\u3002\u8fd9\u901a\u5e38\u5728\u6e38\u620f\u5b89\u88c5\u76ee\u5f55\u4e0b\u7684\u540d\u4e3a\u201c\u5b58\u6863\u201d\u7684\u6587\u4ef6\u5939\u4e2d\u3002\u6b65\u9aa4\u4e8c\uff1a\u5c06\u6b64\u5b58\u6863\u6587\u4ef6\u590d\u5236\u5230\u4e91\u5b58\u50a8\u670d\u52a1\u6216 USB \u9a71\u52a8\u5668\u4e0a\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5 FNF vs Touhou\uff0c\u5e76\u7528\u4f60\u590d\u5236\u7684\u5b58\u6863\u6587\u4ef6\u66ff\u6362\u9ed8\u8ba4\u5b58\u6863\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ece PC \u79fb\u52a8\u5230 Mac\uff0c\u8bf7\u786e\u4fdd\u5b58\u6863\u6587\u4ef6\u683c\u5f0f\u517c\u5bb9\u3002\u6b64\u65b9\u6cd5\u53ef\u786e\u4fdd\u4f60\u7684\u5df2\u89e3\u9501\u6b4c\u66f2\u3001\u9ad8\u5206\u548c\u8bbe\u7f6e\u53ef\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4fdd\u5b58\u3002"}, {"question": "FNF vs Touhou \u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "FNF vs Touhou \u5145\u6ee1\u4e86\u81f4\u656c FNF \u548c\u4e1c\u65b9\u7cfb\u5217\u7684\u9690\u85cf\u5f69\u86cb\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u9690\u85cf\u89d2\u8272\u201c\u739b\u4e3d\u838e\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u6e38\u620f\u4e2d\u7684\u7279\u5b9a\u52a8\u4f5c\u5e8f\u5217\u6765\u89e3\u9501\u3002\u8981\u627e\u5230\u5979\uff0c\u8bf7\u5728\u6e38\u620f\u4e2d\u4ee5\u56f0\u96be\u96be\u5ea6\u73a9\u6b4c\u66f2\u201cBad Apple\u201d\uff0c\u5e76\u5728\u4e0d\u6f0f\u6389\u4efb\u4f55\u97f3\u7b26\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5168\u90e8\u8fde\u51fb\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u6d89\u53ca\u53ef\u4ee5\u8bbf\u95ee\u7684\u79d8\u5bc6\u7b49\u7ea7\uff0c\u53ef\u4ee5\u901a\u8fc7\u8f93\u5165\u4e3b\u83dc\u5355\u4e0a\u7684\u7279\u5b9a\u6309\u952e\u7ec4\u5408\u6765\u8bbf\u95ee\u3002\u8fd9\u4e9b\u9690\u85cf\u529f\u80fd\u4e3a\u6709\u5fc3\u73a9\u5bb6\u6dfb\u52a0\u4e86\u989d\u5916\u7684\u53d1\u73b0\u548c\u5956\u52b1\u3002"}, {"question": "\u4e3a\u4ec0\u4e48 FNF vs Touhou \u4e2d\u67d0\u4e9b\u6b4c\u66f2\u5177\u6709\u72ec\u7279\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u4ee5\u53ca\u5982\u4f55\u4e3a\u5b83\u4eec\u505a\u597d\u51c6\u5907\uff1f", "answer": "FNF vs Touhou \u4e2d\u67d0\u4e9b\u6b4c\u66f2\u5177\u6709\u72ec\u7279\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u4ee5\u4f53\u73b0\u6b4c\u66f2\u7684\u89d2\u8272\u548c\u4e3b\u9898\u3002\u4f8b\u5982\uff0c\u6b4c\u66f2\u201cNecrofantasia\u201d \u5177\u6709\u5feb\u901f\u4e14\u4e0d\u7a33\u5b9a\u7684\u97f3\u7b26\u5e8f\u5217\uff0c\u6a21\u62df\u539f\u4e1c\u65b9\u6b4c\u66f2\u7684\u6df7\u4e71\u6027\u8d28\u3002\u4e3a\u4e86\u5e94\u5bf9\u8fd9\u4e9b\u6a21\u5f0f\uff0c\u8bf7\u5728\u8f83\u4f4e\u96be\u5ea6\u4e0b\u7ec3\u4e60\u6b4c\u66f2\uff0c\u4ee5\u9002\u5e94\u8282\u594f\u548c\u65f6\u95f4\u3002\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u9694\u79bb\u548c\u91cd\u590d\u6311\u6218\u6027\u90e8\u5206\u3002\u6b64\u5916\uff0c\u89c2\u770b\u6559\u7a0b\u6216\u6e38\u620f\u89c6\u9891\u53ef\u4ee5\u63d0\u4f9b\u6709\u5173\u5982\u4f55\u5e94\u5bf9\u8fd9\u4e9b\u72ec\u7279\u6a21\u5f0f\u7684\u89c6\u89c9\u63d0\u793a\u3002\u4e86\u89e3\u6b4c\u66f2\u7684\u7ed3\u6784\u5e76\u9884\u6d4b\u97f3\u7b26\u7684\u53d8\u5316\uff0c\u8fd9\u662f\u638c\u63e1\u8fd9\u4e9b\u5173\u5361\u7684\u5173\u952e\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u786c\u4ef6\u8bbe\u7f6e\uff0c\u4ee5\u4fbf\u5728 FNF vs Touhou \u4e2d\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u4f18\u5316 FNF vs Touhou \u7684\u786c\u4ef6\u8bbe\u7f6e\u53ef\u4ee5\u663e\u8457\u6539\u5584\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u663e\u5361\u9a71\u52a8\u7a0b\u5e8f\u662f\u6700\u65b0\u7684\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u6e32\u67d3\u95ee\u9898\u3002\u5176\u6b21\uff0c\u8c03\u6574\u6e38\u620f\u5185\u8bbe\u7f6e\u4ee5\u5339\u914d\u4f60\u7684\u786c\u4ef6\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9047\u5230\u5ef6\u8fdf\uff0c\u5219\u964d\u4f4e\u5206\u8fa8\u7387\u5e76\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u89c6\u89c9\u6548\u679c\u3002\u7b2c\u4e09\uff0c\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u6709\u7ebf\u8fde\u63a5\u800c\u4e0d\u662f Wi-Fi \u53ef\u4ee5\u51cf\u5c11\u8f93\u5165\u5ef6\u8fdf\uff0c\u8fd9\u5bf9\u4e8e\u8282\u594f\u6e38\u620f\u81f3\u5173\u91cd\u8981\u3002\u5b9a\u671f\u6e05\u6d01\u4f60\u7684\u8bbe\u5907\u5e76\u786e\u4fdd\u5b83\u6ca1\u6709\u6076\u610f\u8f6f\u4ef6\u4e5f\u80fd\u5e26\u6765\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002"}, {"question": "FNF vs Touhou \u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u514b\u670d\u5b83\u4eec\u7684\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "FNF vs Touhou \u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u901a\u5e38\u5305\u542b\u590d\u6742\u7684\u97f3\u7b26\u6a21\u5f0f\u548c\u9ad8\u901f\u5e8f\u5217\u3002\u5176\u4e2d\u4e00\u4e2a\u5173\u5361\u662f\u201cU.N. Owen Was Her\uff1f\u201d\uff0c\u5b83\u4ee5\u5feb\u901f\u4e14\u4e0d\u53ef\u9884\u6d4b\u7684\u97f3\u7b26\u800c\u95fb\u540d\u3002\u8981\u514b\u670d\u8fd9\u4e9b\u5173\u5361\uff0c\u6b65\u9aa4\u4e00\uff1a\u5728\u8f83\u4f4e\u96be\u5ea6\u4e0b\u7ec3\u4e60\u6b4c\u66f2\uff0c\u4ee5\u4e86\u89e3\u8282\u594f\u548c\u97f3\u7b26\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u4ee5\u63d0\u9ad8\u4f60\u7684\u53cd\u5e94\u65f6\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u4e13\u95e8\u5173\u6ce8\u6700\u56f0\u96be\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u201cU.N. Owen Was Her\uff1f\u201d\u7684\u6700\u7ec8\u90e8\u5206\u6709\u4e00\u7cfb\u5217\u9700\u8981\u7cbe\u786e\u65f6\u95f4\u7684\u5feb\u901f\u97f3\u7b26\u3002\u91cd\u590d\u6b64\u90e8\u5206\u6709\u52a9\u4e8e\u638c\u63e1\u5e8f\u5217\u3002\u6b64\u5916\uff0c\u5728\u6e38\u620f\u4e2d\u4fdd\u6301\u51b7\u9759\u548c\u4e13\u6ce8\u7684\u5fc3\u6001\u53ef\u4ee5\u63d0\u9ad8\u4f60\u7684\u8868\u73b0\u3002"}, {"question": "FNF vs Touhou \u4e2d\u54ea\u4e9b\u89d2\u8272\u62e5\u6709\u72ec\u7279\u7684\u6280\u80fd\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "FNF vs Touhou \u4e2d\u7684\u4e00\u4e9b\u89d2\u8272\u62e5\u6709\u72ec\u7279\u7684\u6280\u80fd\uff0c\u53ef\u4ee5\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u4f8b\u5982\uff0c\u201c\u857e\u7c73\u201d\u6709\u4e00\u4e2a\u7279\u6b8a\u52a8\u4f5c\uff0c\u5982\u679c\u9519\u8fc7\u4e86\u97f3\u7b26\uff0c\u53ef\u4ee5\u81ea\u52a8\u5b8c\u6210\u6b4c\u66f2\u7684\u4e00\u90e8\u5206\uff0c\u4e3a\u56f0\u96be\u5173\u5361\u63d0\u4f9b\u5b89\u5168\u7f51\u3002\u53e6\u4e00\u4f4d\u89d2\u8272\u201c\u54b2\u591c\u201d\u53ef\u4ee5\u6682\u65f6\u51cf\u6162\u97f3\u7b26\u901f\u5ea6\uff0c\u7ed9\u4f60\u66f4\u591a\u53cd\u5e94\u65f6\u95f4\u3002\u8fd9\u4e9b\u6280\u80fd\u53ef\u4ee5\u901a\u8fc7\u5728\u6e38\u620f\u4e2d\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\u6765\u6fc0\u6d3b\uff0c\u4f8b\u5982\u4fdd\u6301\u9ad8\u8fde\u51fb\u6216\u8fde\u7eed\u51fb\u4e2d\u4e00\u5b9a\u6570\u91cf\u7684\u97f3\u7b26\u3002\u4e86\u89e3\u6bcf\u4e2a\u89d2\u8272\u7684\u80fd\u529b\u53ca\u5176\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u4eec\uff0c\u53ef\u4ee5\u5728\u6311\u6218\u5173\u5361\u4e2d\u7ed9\u4f60\u4e00\u4e2a\u4f18\u52bf\u3002"}]
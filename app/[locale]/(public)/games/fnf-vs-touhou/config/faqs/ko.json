[{"question": "\ucd08\uc2ec\uc790\uac00 FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8\uc801\uc778 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \uba3c\uc800 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8 \ub610\ub294 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ucd9c\ucc98\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc124\uce58\uac00 \uc644\ub8cc\ub418\uba74 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud0a4 \ubc14\uc778\ub529\uc744 \uc790\uc2e0\uc5d0\uac8c \ub9de\uac8c \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \ubc29\ud5a5\ud0a4\ub97c \ubc29\ud5a5\ud0a4\ub85c, 'Z'\uc640 'X'\ub97c \ub3d9\uc791\ud0a4\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \uc120\ud638\ud569\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc2dc\uc791\ud558\uc5ec \ub9ac\ub4ec \uae30\ubc18 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ub290\uaef4\ubcf4\uc2ed\uc2dc\uc624. \uc790\uc2e0\uac10\uc744 \uac16\uae30 \uc704\ud574 \uc26c\uc6b4 \ub09c\uc774\ub3c4\uc5d0\uc11c \ucc98\uc74c \uba87 \uace1\uc73c\ub85c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \uafb8\uc900\ud568\uc774 \uc911\uc694\ud558\ubbc0\ub85c \uc2dc\uac04\uacfc \ubc18\uc751 \uc18d\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uac8c\uc784\uc744 \ud558\uc2ed\uc2dc\uc624."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uace0\uae09 \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uace0\uae09 \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uace1\uc758 \ud328\ud134\uc744 \uc554\uae30\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uac01 \ub808\ubca8\ub9c8\ub2e4 \ubc18\ubcf5\ub418\ub294 \uace0\uc720\ud55c \uc74c\ud45c \uc21c\uc11c\uac00 \uc788\uc2b5\ub2c8\ub2e4. STEP2: \uac8c\uc784 \uc18d\ub3c4\ub97c \uc810\uc9c4\uc801\uc73c\ub85c \ub192\uc774\uc2ed\uc2dc\uc624. \ud3b8\uc548\ud574\uc9c8 \ub54c\uae4c\uc9c0 \uc18d\ub3c4\ub97c \ub0ae\ucd94\uace0 \uc810\ucc28 \ub192\uc774\uc2ed\uc2dc\uc624. STEP3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ubd84\ub9ac\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ud29c\ud1a0\ub9ac\uc5bc' \uace1\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 \ubd80\ubd84\uc5d0\ub294 \uc5f0\uc18d\uc801\uc778 \uc74c\ud45c\uac00 \uc787\ub530\ub77c \ub098\uc640 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc139\uc158\uc744 \ubc18\ubcf5\ud558\uba74 \ud0c0\uc774\ubc0d\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub610\ud55c \uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\uc758 \uac8c\uc784 \uc601\uc0c1\uc744 \uc2dc\uccad\ud558\uba74 \ud6a8\uc728\uc801\uc778 \uc804\ub7b5\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5bb\uac8c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\ub3c4\uc640 \ucf64\ubcf4 \uacf1\uc148\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc74c\ud45c\ub97c \uc815\ud655\ud558\uac8c \ub9de\ud788\uba74 \uc810\uc218\uac00 \uc99d\uac00\ud558\uace0 \uc5f0\uc18d\uc801\uc778 \ub9de\ud798\uc740 \ucf64\ubcf4 \uacf1\uc148\uc744 \ub192\uc5ec \uc810\uc218\ub97c \ud06c\uac8c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\uac1c\uc758 \uc74c\ud45c\ub97c \uc5f0\uc18d\uc73c\ub85c \ub193\uce58\uc9c0 \uc54a\uace0 \ub9de\ud788\uba74 \uc911\uac04\uc5d0 \ub193\uce5c \uc74c\ud45c\uac00 \uc788\ub294 10\uac1c\uc758 \uc74c\ud45c\ub97c \ub9de\ud788\ub294 \uac83\ubcf4\ub2e4 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc644\ubcbd\ud55c \uc815\ud655\ub3c4\ub97c \ubaa9\ud45c\ub85c \ud558\uace0 \uae34 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \ud2b9\uc815 \uace1\uc5d0\uc11c \uc2dc\uac04\uacfc \uc815\ud655\ub3c4\ub97c \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, \uc74c\ud45c\uc5d0 \ub300\ud55c \ucd5c\uace0 \uc810\uc218\uc778 'Sick' \ub4f1\uae09\uc5d0 \uc720\uc758\ud558\uace0 \uc9c0\uc18d\uc801\uc73c\ub85c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ub178\ub825\ud558\uc2ed\uc2dc\uc624."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc640 \uc6d0\ub798 FNF \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub294 \uc6d0\ub798 FNF \uac8c\uc784\uacfc \ube44\uad50\ud558\uc5ec \uc5ec\ub7ec \uac00\uc9c0 \ub3c5\ud2b9\ud55c \uc694\uc18c\ub97c \ub3c4\uc785\ud569\ub2c8\ub2e4. \uccab\uc9f8, \uce90\ub9ad\ud130\uc640 \ub178\ub798\ub294 \ud1a0\uc6b0\ud638 \ud504\ub85c\uc81d\ud2b8 \uc2dc\ub9ac\uc988\uc5d0\uc11c \uac00\uc838\uc654\uae30 \ub54c\ubb38\uc5d0 \ub2e4\ub978 \ubbf8\uc801 \ubc0f \uc74c\uc545\uc801 \uc2a4\ud0c0\uc77c\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'U.N. Owen Was Her?' \uace1\uc740 \uc778\uae30 \uc788\ub294 \ud1a0\uc6b0\ud638 \ud2b8\ub799\uc758 \ub9ac\ubbf9\uc2a4\uc785\ub2c8\ub2e4. \ub458\uc9f8, \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \ud2b9\uc218 \ub3d9\uc791 \ubc0f \ud1a0\uc6b0\ud638 \uc138\uacc4\uad00\uc744 \ubc18\uc601\ud558\ub294 \ub3c5\ud2b9\ud55c \uc74c\ud45c \ud328\ud134\uacfc \uac19\uc740 \ucd94\uac00 \uae30\ub2a5\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ub09c\uc774\ub3c4 \uace1\uc120\uc740 FNF\uc640 \ud1a0\uc6b0\ud638 \ud32c \ubaa8\ub450\uc5d0\uac8c \ub9de\ucdb0\uc838 \uce5c\uc219\ud558\uace0 \uc0c8\ub85c\uc6b4 \ub3c4\uc804\uc758 \ud63c\ud569\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc73c\ub85c \uc778\ud574 FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub294 \ub450 \ud504\ub79c\ucc28\uc774\uc988\uc758 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc9c4\ucc99 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc9c4\ucc99 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \ub2e8\uacc4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc774\uac83\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud1a0\ub9ac\uc758 '\uc800\uc7a5'\uc774\ub77c\ub294 \ud3f4\ub354\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. STEP2: \uc774 \uc800\uc7a5 \ud30c\uc77c\uc744 \ud074\ub77c\uc6b0\ub4dc \uc2a4\ud1a0\ub9ac\uc9c0 \uc11c\ube44\uc2a4 \ub610\ub294 USB \ub4dc\ub77c\uc774\ube0c\ub85c \ubcf5\uc0ac\ud558\uc2ed\uc2dc\uc624. STEP3: \uc0c8 \uae30\uae30\uc5d0\uc11c FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub97c \uc124\uce58\ud558\uace0 \uae30\ubcf8 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubcf5\uc0ac\ud55c \ud30c\uc77c\ub85c \uad50\uccb4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c Mac\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc800\uc7a5 \ud30c\uc77c \ud615\uc2dd\uc774 \ud638\ud658\ub418\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ub41c \ub178\ub798, \ub192\uc740 \uc810\uc218 \ubc0f \uc124\uc815\uc740 \uae30\uae30 \uac04\uc5d0 \ubcf4\uc874\ub429\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\ub294 FNF \ubc0f \ud1a0\uc6b0\ud638 \uc2dc\ub9ac\uc988\ub97c \uae30\ub9ac\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784\uc5d0\uc11c \ud2b9\uc815 \ub3d9\uc791 \uc21c\uc11c\ub97c \uc644\ub8cc\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130 '\ub9c8\ub9ac\uc0ac'\uc785\ub2c8\ub2e4. \uadf8\ub140\ub97c \ucc3e\uc73c\ub824\uba74 \ub09c\uc774\ub3c4\uac00 \ub192\uc740 'Bad Apple' \ub178\ub798\ub97c \ud50c\ub808\uc774\ud558\uace0 \ubaa8\ub4e0 \uc74c\ud45c\ub97c \ub193\uce58\uc9c0 \uc54a\uace0 \uc644\ubcbd\ud55c \ucf64\ubcf4\ub97c \ub2ec\uc131\ud558\uc2ed\uc2dc\uc624. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ud0a4 \uc870\ud569\uc744 \uc785\ub825\ud558\uc5ec \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ub808\ubca8\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \ubc1c\uacac\uacfc \ubcf4\uc0c1\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \ud2b9\uc815 \ub178\ub798\uac00 \uace0\uc720\ud55c \uc74c\ud45c \ud328\ud134\uc744 \uac16\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ub300\ube44\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \ud2b9\uc815 \ub178\ub798\ub294 \uc6d0\uace1\uc758 \ud2b9\uc131\uacfc \ud14c\ub9c8\ub97c \ubc18\uc601\ud558\uae30 \uc704\ud574 \uace0\uc720\ud55c \uc74c\ud45c \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Necrofantasia' \ub178\ub798\ub294 \uc6d0\ub798 \ud1a0\uc6b0\ud638 \ud2b8\ub799\uc758 \ud63c\ub780\uc2a4\ub7ec\uc6b4 \uc131\uaca9\uc744 \ubaa8\ubc29\ud558\ub294 \ube60\ub974\uace0 \ubd88\uaddc\uce59\uc801\uc778 \uc74c\ud45c \uc21c\uc11c\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud328\ud134\uc5d0 \ub300\ube44\ud558\ub824\uba74 \uace1\uc744 \ub0ae\uc740 \ub09c\uc774\ub3c4\ub85c \uc5f0\uc2b5\ud558\uc5ec \ub9ac\ub4ec\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ubd84\ub9ac\ud558\uace0 \ubc18\ubcf5\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \ud29c\ud1a0\ub9ac\uc5bc \ub610\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \ube44\ub514\uc624\ub97c \ubcf4\uba74 \uc774\ub7ec\ud55c \uace0\uc720\ud55c \ud328\ud134\uc5d0 \uc811\uadfc\ud558\ub294 \ubc29\ubc95\uc5d0 \ub300\ud55c \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace1\uc758 \uad6c\uc870\ub97c \uc774\ud574\ud558\uace0 \uc74c\ud45c \ubcc0\ud654\ub97c \uc608\uc0c1\ud558\ub294 \uac83\uc774 \uc774\ub7ec\ud55c \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc5d0\uc11c \ucd5c\uc0c1\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \ud558\ub4dc\uc6e8\uc5b4 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc5d0\uc11c \ud558\ub4dc\uc6e8\uc5b4 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab\uc9f8, \ub80c\ub354\ub9c1 \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uadf8\ub798\ud53d \ub4dc\ub77c\uc774\ubc84\uac00 \ucd5c\uc2e0 \uc0c1\ud0dc\uc778\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \ud558\ub4dc\uc6e8\uc5b4 \uae30\ub2a5\uc5d0 \ub9de\ucdb0 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\uc5f0\uc774 \ubc1c\uc0dd\ud558\uba74 \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \ubd88\ud544\uc694\ud55c \uc2dc\uac01 \ud6a8\uacfc\ub97c \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uc14b\uc9f8, \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc544 \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, Wi-Fi \ub300\uc2e0 \uc720\uc120 \uc5f0\uacb0\uc744 \uc0ac\uc6a9\ud558\uba74 \uc785\ub825 \uc9c0\uc5f0\uc774 \uc904\uc5b4\ub4e4 \uc218 \uc788\uc73c\uba70 \uc774\ub294 \ub9ac\ub4ec \uac8c\uc784\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uae30\uae30\ub97c \uc815\uae30\uc801\uc73c\ub85c \uccad\uc18c\ud558\uace0 \ub9ec\uc6e8\uc5b4\ub85c\ubd80\ud130 \uc548\uc804\ud558\uac8c \uc720\uc9c0\ud558\uba74 \ub354 \uc6d0\ud65c\ud55c \uc131\ub2a5\uc5d0 \uae30\uc5ec\ud569\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub97c \uc774\uae30\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \uc885\uc885 \ubcf5\uc7a1\ud55c \uc74c\ud45c \ud328\ud134\uacfc \uace0\uc18d \uc2dc\ud000\uc2a4\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uadf8\ub7ec\ud55c \ub808\ubca8 \uc911 \ud558\ub098\ub294 \ube60\ub974\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \uc74c\ud45c\ub85c \uc54c\ub824\uc9c4 'U.N. Owen Was Her?'\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub808\ubca8\uc744 \uc774\uae30\ub824\uba74 STEP1: \uace1\uc744 \ub0ae\uc740 \ub09c\uc774\ub3c4\ub85c \uc5f0\uc2b5\ud558\uc5ec \ub9ac\ub4ec\uacfc \uc74c\ud45c \uc704\uce58\ub97c \uc774\ud574\ud558\uc2ed\uc2dc\uc624. STEP2: \ubc18\uc751 \uc2dc\uac04\uc744 \ub192\uc774\ub824\uba74 \uc810\ucc28\uc801\uc73c\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. STEP3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'U.N. Owen Was Her?'\uc758 \ub9c8\uc9c0\ub9c9 \ubd80\ubd84\uc5d0\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \uc77c\ub828\uc758 \ube60\ub978 \uc74c\ud45c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc139\uc158\uc744 \ubc18\ubcf5\ud558\uba74 \uc2dc\ud000\uc2a4\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784 \uc911\uc5d0 \ucc28\ubd84\ud558\uace0 \uc9d1\uc911\ub41c \ub9c8\uc74c\uac00\uc9d0\uc744 \uc720\uc9c0\ud558\uba74 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc5b4\ub5a4 \uce90\ub9ad\ud130\uac00 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "FNF \ub300 \ud1a0\uc6b0\ud638\uc6b0\uc758 \uc5ec\ub7ec \uce90\ub9ad\ud130\ub294 \ub3c5\ud2b9\ud55c \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub808\uc774\ubb34'\ub294 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0\uc11c \uc548\uc804\ub9dd\uc744 \uc81c\uacf5\ud558\ub294 \uc74c\ud45c\ub97c \ub193\uce5c \uacbd\uc6b0 \uace1\uc758 \uc77c\ubd80\ub97c \uc790\ub3d9\uc73c\ub85c \uc644\ub8cc\ud558\ub294 \ud2b9\uc218 \ub3d9\uc791\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uce90\ub9ad\ud130\uc778 '\uc0ac\ucfe0\uc57c'\ub294 \uc77c\uc2dc\uc801\uc73c\ub85c \uc74c\ud45c \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc5b4 \ub354 \ub9ce\uc740 \ubc18\uc751 \uc2dc\uac04\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2a5\ub825\uc740 \ub192\uc740 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uac70\ub098 \ud2b9\uc815 \uac1c\uc218\uc758 \uc74c\ud45c\ub97c \uc5f0\uc18d\uc73c\ub85c \ub9de\ud788\ub294 \uac83\uacfc \uac19\uc740 \uac8c\uc784 \uc911 \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud558\uc5ec \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \uce90\ub9ad\ud130\uc758 \ub2a5\ub825\uc744 \uc774\ud574\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \uc774\ud574\ud558\uba74 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
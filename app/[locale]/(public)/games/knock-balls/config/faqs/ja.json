[{"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5de6\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u3063\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30ea\u30fc\u30ca\u5185\u3092\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u300eA\u300f\u30dc\u30bf\u30f3\u3001\u57fa\u672c\u7684\u306a\u653b\u6483\u3092\u884c\u3046\u306b\u306f\u300eB\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u6700\u521d\u306e\u30dc\u30c3\u30c8\u3092\u5012\u3059\u3053\u3068\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306e\u7df4\u7fd2\u3092\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3068\u653b\u6483\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u3057\u304f\u5408\u308f\u305b\u308b\u3053\u3068\u306f\u3001\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u306e\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u3067\u52dd\u5229\u3059\u308b\u305f\u3081\u306e\u4e3b\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u653b\u6483\u3068\u30b8\u30e3\u30f3\u30d7\u3092\u7e4b\u3052\u308b\u3053\u3068\u3067\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3055\u307e\u3056\u307e\u306a\u30dc\u30c3\u30c8\u3084\u30dc\u30b9\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u3073\u3001\u5f7c\u3089\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3057\u3066\u3001\u5bfe\u6226\u76f8\u624b\u3092\u51fa\u3057\u629c\u304f\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30dc\u30c3\u30c8\u5de5\u5834\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30b3\u30f3\u30dc\u3092\u4f7f\u3046\u3053\u3068\u3067\u3001\u8907\u6570\u306e\u30dc\u30c3\u30c8\u3092\u52b9\u7387\u7684\u306b\u6392\u9664\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u304c\u30b3\u30f3\u30dc\u653b\u6483\u3092\u91cd\u8996\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u7279\u306b\u30b3\u30f3\u30dc\u653b\u6483\u3068\u3044\u3063\u305f\u5de7\u307f\u306a\u30d7\u30ec\u30a4\u3092\u8912\u7f8e\u3067\u8a55\u4fa1\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b3\u30f3\u30dc\u5185\u306e\u9023\u7d9a\u30d2\u30c3\u30c8\u3059\u308b\u3054\u3068\u306b\u30b9\u30b3\u30a2\u500d\u7387\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5358\u72ec\u306e\u30d2\u30c3\u30c8\u306b\u983c\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u653b\u6483\u3092\u7e4b\u3052\u308b\u3088\u3046\u306b\u4fc3\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30015\u30d2\u30c3\u30c8\u306e\u30b3\u30f3\u30dc\u306f\u30015\u56de\u306e\u500b\u5225\u306e\u30d2\u30c3\u30c8\u306b\u6bd4\u3079\u3066\u30b9\u30b3\u30a2\u304c\u500d\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u9b45\u529b\u7684\u306b\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u3067\u306f\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4e00\u6642\u7684\u306a\u7121\u6575\u3092\u63d0\u4f9b\u3057\u3001\u53cd\u6483\u3092\u6050\u308c\u308b\u3053\u3068\u306a\u304f\u653b\u6483\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u306f\u79fb\u52d5\u901f\u5ea6\u3092\u9ad8\u3081\u3001\u653b\u6483\u3092\u304b\u308f\u3057\u3001\u653b\u6483\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u3068\u308b\u3053\u3068\u3092\u5bb9\u6613\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30b9\u6226\u4e2d\u306b\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u653b\u6483\u306b\u96c6\u4e2d\u3067\u304d\u308b\u305f\u3081\u6709\u5229\u306b\u306a\u308a\u307e\u3059\u3002\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u5e38\u306b\u6226\u7565\u7684\u306a\u77ac\u9593\u306b\u884c\u52d5\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30dc\u30c3\u30c8AI\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u3069\u306e\u3088\u3046\u306b\u9069\u5fdc\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30dc\u30c3\u30c8AI\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u9069\u5fdc\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3042\u306a\u305f\u304c\u6210\u9577\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30dc\u30c3\u30c8\u306f\u3088\u308a\u653b\u6483\u7684\u306b\u306a\u308a\u3001\u3088\u308a\u8907\u96d1\u306a\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u4e0a\u7d1a\u30a2\u30ea\u30fc\u30ca\u300f\u3067\u306f\u3001\u30dc\u30c3\u30c8\u306f\u3042\u306a\u305f\u306e\u653b\u6483\u3092\u304b\u308f\u3057\u3001\u3042\u306a\u305f\u306e\u52d5\u304d\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u8ffd\u3044\u8a70\u3081\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u9069\u5fdc\u578b\u306eAI\u306f\u3001\u7d4c\u9a13\u30ec\u30d9\u30eb\u306b\u95a2\u4fc2\u306a\u304f\u3001\u30b2\u30fc\u30e0\u304c\u5e38\u306b\u6311\u6226\u7684\u3067\u9b45\u529b\u7684\u306a\u307e\u307e\u306b\u306a\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306f\u597d\u5947\u5fc3\u65fa\u76db\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u8912\u7f8e\u3067\u4e0e\u3048\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3044\u3063\u3071\u3044\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u3088\u3046\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30dc\u30fc\u30eb\u300f\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u300e\u30dc\u30c3\u30c8\u5de5\u5834\u300f\u30ec\u30d9\u30eb\u306e\u96a0\u3055\u308c\u305f\u901a\u8def\u3092\u63a2\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b4\u30fc\u30eb\u30c7\u30f3\u30dc\u30fc\u30eb\u306f\u3001\u53ce\u96c6\u3059\u308b\u3068\u4e00\u6642\u7684\u306b\u30b9\u30b3\u30a2\u500d\u7387\u304c\u4e0a\u6607\u3057\u307e\u3059\u3002\u305d\u308c\u3092\u63a2\u3059\u306b\u306f\u3001\u4e0d\u81ea\u7136\u306b\u5272\u308c\u305f\u58c1\u3092\u63a2\u3057\u3001\u5145\u96fb\u3055\u308c\u305f\u653b\u6483\u3092\u4f7f\u7528\u3057\u3066\u305d\u308c\u3092\u7a81\u7834\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b2\u30fc\u30e0\u306e\u9685\u3005\u307e\u3067\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u3088\u3046\u306a\u9a5a\u304d\u304c\u305f\u304f\u3055\u3093\u898b\u3064\u304b\u308a\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u81ea\u5206\u306e\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u3042\u306a\u305f\u306e\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u73fe\u5728\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u3053\u306e\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u79fb\u884c\u306b\u3088\u3063\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u5192\u967a\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30a2\u30ea\u30fc\u30ca\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u610f\u7fa9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u30a2\u30ea\u30fc\u30ca\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5f62\u4f5c\u308b\u4e0a\u3067\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u5404\u30a2\u30ea\u30fc\u30ca\u306f\u3001\u8fd1\u63a5\u6226\u95d8\u306e\u305f\u3081\u306e\u72ed\u3044\u901a\u8def\u3084\u3001\u5c04\u6483\u6226\u306e\u305f\u3081\u306e\u5e83\u3044\u7a7a\u9593\u306a\u3069\u3001\u7279\u5b9a\u306e\u8ab2\u984c\u3092\u5ff5\u982d\u306b\u7f6e\u3044\u3066\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30dc\u30c3\u30c8\u5de5\u5834\u300f\u30a2\u30ea\u30fc\u30ca\u306b\u306f\u3001\u3042\u306a\u305f\u306e\u52d5\u304d\u3092\u52a9\u3051\u308b\u304b\u59a8\u3052\u308b\u30b3\u30f3\u30d9\u30e4\u30fc\u30d9\u30eb\u30c8\u304c\u3042\u308a\u3001\u6226\u95d8\u306b\u6226\u7565\u6027\u306e\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u5404\u30a2\u30ea\u30fc\u30ca\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u8853\u7684\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u3055\u307e\u3056\u307e\u306a\u30dc\u30c3\u30c8\u306e\u7a2e\u985e\u306f\u3001\u30b2\u30fc\u30e0\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u3055\u307e\u3056\u307e\u306a\u30dc\u30c3\u30c8\u306e\u7a2e\u985e\u306f\u3001\u7570\u306a\u308b\u5bfe\u51e6\u6226\u7565\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u4e00\u90e8\u306e\u30dc\u30c3\u30c8\u306f\u901f\u3044\u304c\u8106\u304f\u3001\u4ed6\u306e\u30dc\u30c3\u30c8\u306f\u9045\u3044\u304c\u9632\u5fa1\u304c\u5805\u56fa\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30bf\u30f3\u30af\u30dc\u30c3\u30c8\u300f\u306f\u8907\u6570\u306e\u30d2\u30c3\u30c8\u306b\u8010\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u5f8c\u308d\u304b\u3089\u306e\u653b\u6483\u306b\u306f\u8106\u5f31\u3067\u3059\u3002\u30dc\u30c3\u30c8\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u306f\u3001\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u3068\u6a5f\u654f\u3055\u3092\u6d3b\u7528\u3057\u3066\u901f\u3044\u30dc\u30c3\u30c8\u3092\u51fa\u3057\u629c\u304d\u3001\u88c5\u7532\u306e\u70b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u88c5\u7532\u306e\u30dc\u30c3\u30c8\u3092\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u96a0\u3055\u308c\u305f\u8ab2\u984c\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306e\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ce\u30c3\u30af\u30dc\u30fc\u30eb\u306e\u96a0\u3055\u308c\u305f\u8ab2\u984c\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306f\u3001\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8ab2\u984c\u306f\u3001\u6642\u9593\u5236\u9650\u5185\u3067\u7279\u5b9a\u6570\u306e\u30dc\u30c3\u30c8\u3092\u5012\u3059\u3053\u3068\u306a\u3069\u3001\u5f93\u6765\u3068\u306f\u7570\u306a\u308b\u65b9\u6cd5\u3067\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u306b\u6311\u6226\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u300f\u3092\u5b8c\u6210\u3059\u308b\u3068\u3001\u6c38\u4e45\u7684\u306a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u304c\u5831\u916c\u3068\u3057\u3066\u6388\u4e0e\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5831\u916c\u306f\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u697d\u3057\u304f\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u3092\u63a2\u6c42\u3057\u3066\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u8ffd\u52a0\u306e\u30a4\u30f3\u30bb\u30f3\u30c6\u30a3\u30d6\u3082\u63d0\u4f9b\u3057\u307e\u3059\u3002"}]
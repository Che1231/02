[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \uc81c\uc5b4\ub97c \ub9c8\uc2a4\ud130\ud574\uc57c \ud569\ub2c8\ub2e4. \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc544\ub808\ub098\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 'A' \ubc84\ud2bc\uc744, \uae30\ubcf8 \uacf5\uaca9\uc744 \ud558\ub824\uba74 'B' \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc7a5\uc560\ubb3c\uc744 \ud1b5\uacfc\ud558\uace0 \ucd08\uae30 \ubd07\ub4e4\uc744 \uc81c\uc555\ud558\uc5ec \uc774\ub7ec\ud55c \uc81c\uc5b4\ub97c \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\ud504\uc640 \uacf5\uaca9\uc758 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucd94\ub294 \uac83\uc774 \uc131\uacf5\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04 \ud6c4 \ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \uc9c4\ud589\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc5d0\uc11c 100\uc2dc\uac04\uc744 \ubcf4\ub0b8 \ud6c4, \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uacf5\uaca9\uacfc \uc810\ud504\ub97c \uc5f0\uacb0\ud558\uc5ec \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc744 \ub9c8\uc2a4\ud130\ud569\ub2c8\ub2e4. STEP2: \uc11c\ub85c \ub2e4\ub978 \ubd07\uacfc \ubcf4\uc2a4\uc758 \ud328\ud134\uc744 \ud30c\uc545\ud558\uc5ec \uacf5\uaca9\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. STEP3: '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\uc640 \uac19\uc740 \ub2a5\ub825\uce58\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc0c1\ub300\ubc29\uc744 \uc81c\uc555\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubd07 \ud329\ud1a0\ub9ac' \ub808\ubca8\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc88b\uc740 \ucf64\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \ubd07\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \ucf64\ubcf4 \uacf5\uaca9\uc744 \uc120\ud638\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc219\ub828\ub41c \ud50c\ub808\uc774, \ud2b9\ud788 \ucf64\ubcf4 \uacf5\uaca9\uc744 \ubcf4\uc0c1\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucf64\ubcf4\uc5d0\uc11c \uc5f0\uc18d\uc801\uc778 \ud0c0\uaca9\uc740 \uc810\uc218 \ubc30\uc728\uc744 \ub192\uc774\ubbc0\ub85c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e8\uc77c \ud0c0\uaca9\uc5d0 \uc758\uc874\ud558\uae30\ubcf4\ub2e4 \uacf5\uaca9\uc744 \uc5f0\uc18d\uc801\uc73c\ub85c \uc774\uc5b4\uac00\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\uc5f0\ud0c0 \ucf64\ubcf4\ub294 5\uac1c\uc758 \uac1c\ubcc4 \ud0c0\uaca9\uacfc \ube44\uad50\ud558\uc5ec \uc810\uc218\uac00 \ub450 \ubc30\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc740 \uac8c\uc784\uc744 \ub354\uc6b1 \ub9e4\ub825\uc801\uc73c\ub85c \ub9cc\ub4e4 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub2a5\ub825\uce58\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \ub2a5\ub825\uce58\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. '\uc274\ub4dc' \ub2a5\ub825\uce58\ub294 \uc77c\uc2dc\uc801\uc778 \ubb34\uc801 \uc0c1\ud0dc\ub97c \uc81c\uacf5\ud558\uc5ec \ubc18\uaca9\uc758 \ub450\ub824\uc6c0 \uc5c6\uc774 \uacf5\uaca9\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub294 \uc774\ub3d9 \uc18d\ub3c4\ub97c \ub192\uc5ec \uacf5\uaca9\uc744 \ud53c\ud558\uace0 \ud0c0\uaca9\uc744 \uc704\ud55c \uc704\uce58\ub97c \uc120\uc810\ud558\uae30 \uc27d\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4\uc804\uc5d0\uc11c '\uc274\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uba74 \uacf5\uaca9\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \uc0c1\ud669\uc744 \uc720\ub9ac\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2a5\ub825\uce58 \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ud56d\uc0c1 \uc804\ub7b5\uc801\uc778 \uc21c\uac04\uc5d0 \ub2a5\ub825\uce58\ub97c \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc758 \ubd07 AI\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uc5d0 \uc5b4\ub5bb\uac8c \uc801\uc751\ud569\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc758 \ubd07 AI\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uc5d0 \uc801\uc751\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc9c4\ud589\ud558\uba74\uc11c \ubd07\uc740 \ub354\uc6b1 \uacf5\uaca9\uc801\uc774 \ub418\uace0 \ub354 \ubcf5\uc7a1\ud55c \uacf5\uaca9 \ud328\ud134\uc744 \uc0ac\uc6a9\ud558\uac8c \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uace0\uae09 \uc544\ub808\ub098'\uc5d0\uc11c \ubd07\uc740 \uacf5\uaca9\uc744 \ud53c\ud558\uace0 \ub3d9\uc791\uc744 \uc870\uc815\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\ub97c \ubab0\uc544\ubd99\uc774\uae30 \uc2dc\uc791\ud560 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc801\uc751\ud615 AI\ub294 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uad00\uacc4\uc5c6\uc774 \uac8c\uc784\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc5b4\ub824\uc6b0\uba74\uc11c\ub3c4 \ub9e4\ub825\uc801\uc73c\ub85c \uc720\uc9c0\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc5d0\ub294 \ud638\uae30\uc2ec \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 '\uace8\ub4e0 \ubcfc'\uc774\uba70, '\ubd07 \ud329\ud1a0\ub9ac' \ub808\ubca8\uc758 \uc228\uaca8\uc9c4 \uae38\uc744 \ud0d0\ud5d8\ud558\uc5ec \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uace8\ub4e0 \ubcfc\uc740 \uc218\uc9d1 \uc2dc \uc77c\uc2dc\uc801\uc778 \uc810\uc218 \ubc30\uc728\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucc3e\uc73c\ub824\uba74 \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \uade0\uc5f4\uc774 \uc788\ub294 \ubcbd\uc744 \ucc3e\uace0 \ucda9\uc804\ub41c \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubd80\uc218\uc2ed\uc2dc\uc624. \uac8c\uc784\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \ub9ce\uc740 \ub180\ub77c\uc6b4 \ubc1c\uacac\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub178\ud06c \ubcfc\uc988\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub178\ud06c \ubcfc\uc988 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ud604\uc7ac \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ucf58\uc194\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ud1b5\ud574 \uc544\ubb34\ub7f0 \uc9c4\ud589 \uc0c1\ud669\ub3c4 \uc783\uc9c0 \uc54a\uace0 \ubaa8\ud5d8\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc758 \uc544\ub808\ub098 \ub808\uc774\uc544\uc6c3\uc740 \ubb34\uc2a8 \uc758\ubbf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc758 \uc544\ub808\ub098 \ub808\uc774\uc544\uc6c3\uc740 \uac8c\uc784 \ud658\uacbd\uc744 \ud615\uc131\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uac01 \uc544\ub808\ub098\ub294 \uadfc\uc811 \uc804\ud22c\ub97c \uc704\ud55c \uc881\uc740 \ubcf5\ub3c4\ub098 \uc6d0\uac70\ub9ac \uacf5\uaca9\uc744 \uc704\ud55c \ub113\uc740 \uacf5\uac04\uacfc \uac19\uc740 \ud2b9\uc815\ud55c \ub3c4\uc804\uc744 \uc5fc\ub450\uc5d0 \ub450\uace0 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubd07 \ud329\ud1a0\ub9ac' \uc544\ub808\ub098\ub294 \uc774\ub3d9\uc5d0 \ub3c4\uc6c0\uc774 \ub418\uac70\ub098 \ubc29\ud574\uac00 \ub420 \uc218 \uc788\ub294 \ucee8\ubca0\uc774\uc5b4 \ubca8\ud2b8\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud558\uc5ec \uc804\ud22c\uc5d0 \uc804\ub7b5\uc801 \uc694\uc18c\ub97c \ub354\ud569\ub2c8\ub2e4. \uac01 \uc544\ub808\ub098\uc758 \ub808\uc774\uc544\uc6c3\uc744 \uc774\ud574\ud558\uba74 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc758 \uc11c\ub85c \ub2e4\ub978 \ubd07 \uc720\ud615\uc740 \uac8c\uc784 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc758 \uc11c\ub85c \ub2e4\ub978 \ubd07 \uc720\ud615\uc740 \uc774\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \ub2e4\uc591\ud55c \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ubd07\uc740 \ube60\ub974\uc9c0\ub9cc \uc57d\ud558\uace0, \ub2e4\ub978 \ubd07\uc740 \ub290\ub9ac\uc9c0\ub9cc \ubc29\uc5b4\ub825\uc774 \uac15\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud0f1\ud06c \ubd07'\uc740 \uc5ec\ub7ec \ubc88\uc758 \uacf5\uaca9\uc5d0\ub3c4 \ubc84\ud2f0\uc9c0\ub9cc \ub4a4\uc5d0\uc11c \uacf5\uaca9\uc744 \ubc1b\uc73c\uba74 \ucde8\uc57d\ud569\ub2c8\ub2e4. \ubd07 \uc720\ud615\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\ub294 \uac83\uc774 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ube60\ub978 \ubd07\uc744 \uc81c\uc555\ud558\uae30 \uc704\ud574 \uc18d\ub3c4\uc640 \ubbfc\ucca9\uc131\uc744 \uc0ac\uc6a9\ud558\uace0, \ubc29\uc5b4\ub825\uc774 \uac15\ud55c \ubd07\uc744 \uc81c\uc555\ud558\uae30 \uc704\ud574 \uc57d\uc810\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub178\ud06c \ubcfc\uc988\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uace0\uc720\ud55c \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc4c\ub9b0\uc9c0\ub294 \uc885\uc885 \ud2b9\ubcc4\ud55c \uc81c\uc57d \uc870\uac74 \ud558\uc5d0\uc11c \ubd07\uc744 \ud2b9\uc815 \uac1c\uc218\ub9cc\ud07c \uc81c\ud55c\ub41c \uc2dc\uac04 \uc548\uc5d0 \ubb3c\ub9ac\uce58\ub294 \uac83\uacfc \uac19\uc774 \ube44\uc804\ud1b5\uc801\uc778 \ubc29\ubc95\uc73c\ub85c \uc219\ub828\ub3c4\ub97c \uc2dc\ud5d8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud53c\ub4dc\uc2a4\ud130 \ucc4c\ub9b0\uc9c0'\ub97c \uc644\ub8cc\ud558\uba74 \uc601\uad6c\uc801\uc778 \uc18d\ub3c4 \ubd80\uc2a4\ud130\uac00 \ubcf4\uc0c1\uc73c\ub85c \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcf4\uc0c1\uc740 \uac8c\uc784\uc744 \ub354\uc6b1 \uc990\uac81\uac8c \ub9cc\ub4e4 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784\uc744 \ud0d0\ud5d8\ud558\uace0 \ub9c8\uc2a4\ud130\ud558\ub3c4\ub85d \ucd94\uac00\uc801\uc778 \ub3d9\uae30\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u57f7\u884c\u57fa\u672c\u6295\u7403\u52d5\u4f5c\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u57f7\u884c\u57fa\u672c\u6295\u7403\u52d5\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5f9e\u6295\u7403\u9078\u55ae\u4e2d\u9078\u64c7\u6295\u7403\u985e\u578b\uff08\u4f8b\u5982\uff1a\u5feb\u901f\u7403\uff09\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u756b\u9762\u4e0a\u7684\u6e96\u5fc3\u7784\u6e96\u6295\u7403\u65b9\u5411\u3002\u6b65\u9a5f3 - \u5728\u9069\u7576\u7684\u6642\u6a5f\u6309\u4e0b\u6295\u7403\u6309\u9215\u57f7\u884c\u3002\u4f8b\u5982\uff0c\u6642\u6a5f\u638c\u63e1\u5f97\u597d\u7684\u5feb\u901f\u7403\u901f\u5ea6\u53ef\u9054\u6bcf\u5c0f\u664295\u82f1\u91cc\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u6295\u98db\u93e2\uff0c\u7cbe\u6e96\u5ea6\u548c\u6642\u6a5f\u81f3\u95dc\u91cd\u8981\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6700\u4f73\u7684\u6253\u64ca\u7b56\u7565\u6709\u54ea\u4e9b\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6709\u6548\u7684\u6253\u64ca\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u6ce8\u610f\u6295\u624b\u52d5\u4f5c\uff0c\u9810\u6e2c\u7403\u7a2e\u3002\u6b65\u9a5f2 - \u4f9d\u64da\u7403\u7684\u4f4d\u7f6e\u8abf\u6574\u68d2\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f3 - \u5728\u6700\u4f73\u6642\u6a5f\u63ee\u68d2\uff0c\u4ee5\u9054\u5230\u6700\u5927\u5a01\u529b\u3002\u4f8b\u5982\uff0c\u5728\u66f2\u7403\u4e0a\u5b8c\u7f8e\u6642\u6a5f\u63ee\u68d2\uff0c\u53ef\u4ee5\u64ca\u51fa\u5168\u58d8\u6253\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u7784\u6e96\u9ad8\u8655\uff1b\u66f2\u7403 - \u7784\u6e96\u4f4e\u8655\uff1b\u6ed1\u7403 - \u7784\u6e96\u4e2d\u9593\u4f4d\u7f6e\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7403\u54e1\u9ad4\u529b\u70ba\u4f55\u91cd\u8981\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\uff0c\u7403\u54e1\u9ad4\u529b\u6703\u5f71\u97ff\u901f\u5ea6\u548c\u6e96\u78ba\u5ea6\u7b49\u8868\u73fe\u6307\u6a19\u3002\u9ad4\u529b\u4e0d\u8db3\u6703\u5c0e\u81f4\u6295\u7403\u8b8a\u6162\uff0c\u64ca\u7403\u529b\u91cf\u6e1b\u5f31\u3002\u4f8b\u5982\uff0c\u9ad4\u529b\u4e0d\u8db3\u7684\u6295\u624b\u53ef\u80fd\u5c07\u5feb\u901f\u7403\u6295\u51fa\u6bcf\u5c0f\u6642\u50c585\u82f1\u91cc\u800c\u975e95\u82f1\u91cc\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9ad4\u529b\u689d \u2192 \u8868\u73fe\u6307\u6a19 \u2192 \u904a\u6232\u7d50\u679c\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u7ba1\u7406\u7403\u968a\u540d\u55ae\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u7ba1\u7406\u7403\u968a\u540d\u55ae\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u5206\u6790\u7403\u54e1\u6578\u64da\uff0c\u8b58\u5225\u512a\u52e2\u548c\u5f31\u52e2\u3002\u6b65\u9a5f2 - \u8f2a\u63db\u7403\u54e1\u4ee5\u7dad\u6301\u6700\u4f73\u9ad4\u529b\u6c34\u5e73\u3002\u6b65\u9a5f3 - \u4f9d\u64da\u5c0d\u624b\u7b56\u7565\u8abf\u6574\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5c07\u5f37\u6253\u8005\u5b89\u6392\u5728\u6700\u5f8c\u4e00\u540d\u6253\u64ca\u4f4d\u7f6e\uff0c\u53ef\u4ee5\u6700\u5927\u5316\u5f97\u5206\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b9\u6848A - \u4fdd\u7559\u5148\u767c\u7403\u54e1\uff1b\u65b9\u6848B - \u8f2a\u63db\u66ff\u88dc\u7403\u54e1\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u63d0\u4f9b\u591a\u7a2e\u904a\u6232\u6a21\u5f0f\uff1a\u7df4\u7fd2\u8cfd\u3001\u8cfd\u5b63\u8cfd\u548c\u7dda\u4e0a\u8cfd\u3002\u7df4\u7fd2\u8cfd\u662f\u4e00\u5834\u55ae\u7368\u7684\u6bd4\u8cfd\uff0c\u8cfd\u5b63\u8cfd\u5247\u6db5\u84cb\u591a\u5834\u6bd4\u8cfd\u4e26\u8ffd\u8e64\u6578\u64da\uff0c\u800c\u7dda\u4e0a\u8cfd\u5247\u5141\u8a31\u5be6\u6642\u7af6\u722d\u3002\u4f8b\u5982\uff0c\u5728\u8cfd\u5b63\u6a21\u5f0f\u4e2d\uff0c\u7403\u54e1\u6578\u64da\u6703\u96a8\u8457\u6642\u9593\u7d2f\u7a4d\uff0c\u5f71\u97ff\u672a\u4f86\u7684\u8868\u73fe\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u7df4\u7fd2\u8cfd\u5c31\u50cf\u4e00\u5834\u53cb\u8abc\u8cfd\uff0c\u8cfd\u5b63\u8cfd\u5c31\u50cf\u4e00\u5834\u99ac\u62c9\u677e\uff0c\u7dda\u4e0a\u8cfd\u5c31\u50cf\u4e00\u5834\u9326\u6a19\u8cfd\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u63d0\u5347\u6295\u7403\u6e96\u78ba\u5ea6\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u63d0\u5347\u6295\u7403\u6e96\u78ba\u5ea6\u9700\u8981\uff1a\u6b65\u9a5f1 - \u7df4\u7fd2\u4e0d\u540c\u985e\u578b\u7684\u6295\u7403\uff0c\u7406\u89e3\u5176\u8ecc\u8de1\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u8a13\u7df4\u6a21\u5f0f\u4f86\u7cbe\u9032\u4f60\u7684\u6642\u6a5f\u638c\u63e1\u3002\u6b65\u9a5f3 - \u5206\u6790\u5c0d\u624b\u7684\u6253\u64ca\u50be\u5411\uff0c\u8abf\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u719f\u7df4\u638c\u63e1\u66f2\u7403\u53ef\u4ee5\u8b93\u6253\u8005\u66f4\u96e3\u9810\u6e2c\u7403\u7684\u8def\u5f91\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u76f4\u7dda\uff1b\u66f2\u7403 - \u5411\u4e0b\u5f27\u7dda\uff1b\u6ed1\u7403 - \u6a6b\u5411\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u6709\u4f55\u610f\u7fa9\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u6703\u5f71\u97ff\u904a\u6232\u7684\u52d5\u614b\u3002\u4e0b\u96e8\u6703\u4f7f\u7403\u8b8a\u6ed1\uff0c\u964d\u4f4e\u6295\u7403\u901f\u5ea6\u548c\u6e96\u78ba\u5ea6\uff0c\u800c\u98a8\u5247\u6703\u6539\u8b8a\u7403\u7684\u98db\u884c\u8ecc\u8de1\u3002\u4f8b\u5982\uff0c\u5f37\u52c1\u7684\u9006\u98a8\u53ef\u80fd\u6703\u5c07\u6f5b\u5728\u7684\u5168\u58d8\u6253\u8b8a\u6210\u98db\u7403\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5929\u6c23\u72c0\u6cc1 \u2192 \u7403\u7684\u884c\u70ba \u2192 \u904a\u6232\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u4f60\u7684\u68d2\u7403\u4e4b\u661f\u904a\u6232\u9032\u5ea6\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u4f60\u7684\u6578\u64da\u3002\u6b65\u9a5f3 - \u5728\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u5132\u5b58\u6a94\u3002\u4f8b\u5982\uff0c\u5f9e iPhone \u8f49\u79fb\u5230 Android \u88dd\u7f6e\uff0c\u53ef\u4ee5\u4fdd\u7559\u4f60\u6240\u6709\u7684\u6578\u64da\u548c\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b9\u6848A - \u96f2\u7aef\u5132\u5b58\uff1b\u65b9\u6848B - \u624b\u52d5\u5099\u4efd\u3002]"}, {"question": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\uff0c\u6211\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u53ef\u4ee5\u767c\u73fe\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u5305\u542b\u96b1\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u79d8\u5bc6\u7403\u54e1\u80fd\u529b\u548c\u7a00\u6709\u88dd\u5099\u3002\u4f8b\u5982\uff0c\u96b1\u85cf\u80fd\u529b\u53ef\u80fd\u5141\u8a31\u6295\u624b\u6295\u51fa\u6ed1\u7403\uff0c\u9019\u5c0d\u65bc\u6253\u8005\u4f86\u8aaa\u5f88\u96e3\u64ca\u4e2d\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u767c\u73fe\u9019\u4e9b\u529f\u80fd\u5c31\u50cf\u5728\u96fb\u5f71\u4e2d\u5c0b\u627e\u5f69\u86cb\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u54ea\u4e9b\u7403\u54e1\u5c6c\u6027\u6700\u95dc\u9375\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6700\u95dc\u9375\u7684\u7403\u54e1\u5c6c\u6027\u662f\u901f\u5ea6\u3001\u529b\u91cf\u548c\u6e96\u78ba\u5ea6\u3002\u901f\u5ea6\u5f71\u97ff\u8dd1\u58d8\u548c\u5b88\u5099\uff0c\u529b\u91cf\u5f71\u97ff\u64ca\u7403\u8ddd\u96e2\uff0c\u800c\u6e96\u78ba\u5ea6\u6c7a\u5b9a\u6295\u7403\u6548\u679c\u3002\u4f8b\u5982\uff0c\u64c1\u6709\u9ad8\u529b\u91cf\u7684\u7403\u54e1\u66f4\u5bb9\u6613\u64ca\u51fa\u5168\u58d8\u6253\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u901f\u5ea6 - \u8dd1\u58d8\uff1b\u529b\u91cf - \u6253\u64ca\uff1b\u6e96\u78ba\u5ea6 - \u6295\u7403\u3002]"}]
[{"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ud22c\uad6c\ub294 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ud22c\uad6c\ub97c \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ud22c\uad6c \uba54\ub274\uc5d0\uc11c \ud22c\uad6c \uc885\ub958(\uc608: \uc9c1\uad6c)\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \ud654\uba74 \uc0c1\uc758 \uc870\uc900\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud22c\uad6c\ub97c \uc870\uc900\ud569\ub2c8\ub2e4. STEP3 - \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ud22c\uad6c \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud0c0\uc774\ubc0d\uc774 \uc88b\uc740 \uc9c1\uad6c\ub294 \uc2dc\uc18d 95\ub9c8\uc77c\uae4c\uc9c0 \ub098\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud65c\uc3d8\uae30\uc640 \uac19\uc73c\uba70 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud0c0\uaca9 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \ud0c0\uaca9\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \ud22c\uc218\uc758 \uc6c0\uc9c1\uc784\uc744 \ubcf4\uace0 \ud22c\uad6c \uc885\ub958\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. STEP2 - \ud22c\uad6c \uc704\uce58\uc5d0 \ub530\ub77c \ubc30\ud2b8\ub97c \uc704\uce58\uc2dc\ud0b5\ub2c8\ub2e4. STEP3 - \ucd5c\ub300 \ud30c\uc6cc\ub97c \uc704\ud574 \ucd5c\uc801\uc758 \uc2dc\uc810\uc5d0 \uc2a4\uc719\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucee4\ube0c\ubcfc\uc5d0 \uc644\ubcbd\ud558\uac8c \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd98 \uc2a4\uc719\uc740 \ud648\ub7f0\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc9c1\uad6c - \ub192\uc774 \uc870\uc900, \ucee4\ube0c\ubcfc - \ub0ae\uac8c \uc870\uc900, \uc2ac\ub77c\uc774\ub354 - \uc911\uc559 \uc870\uc900.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uc120\uc218 \uccb4\ub825\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uc120\uc218 \uccb4\ub825\uc740 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uacfc \uac19\uc740 \uc131\ub2a5 \uc9c0\ud45c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uccb4\ub825\uc774 \ub0ae\uc73c\uba74 \ud22c\uad6c \uc18d\ub3c4\uac00 \ub290\ub824\uc9c0\uace0 \ud0c0\uaca9\ub825\uc774 \uc57d\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825\uc774 \ub0ae\uc740 \ud22c\uc218\ub294 \uc2dc\uc18d 95\ub9c8\uc77c \ub300\uc2e0 85\ub9c8\uc77c\ub85c \uc9c1\uad6c\ub97c \ub358\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uccb4\ub825 \ubc14 \u2192 \uc131\ub2a5 \uc9c0\ud45c \u2192 \uac8c\uc784 \uacb0\uacfc.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud300 \ub85c\uc2a4\ud130\ub97c \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud558\ub098\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud300 \ub85c\uc2a4\ud130\ub97c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: STEP1 - \uc120\uc218\uc758 \ud1b5\uacc4\ub97c \ubd84\uc11d\ud558\uc5ec \uac15\uc810\uacfc \uc57d\uc810\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2 - \uc120\uc218\ub97c \uad50\uccb4\ud558\uc5ec \uccb4\ub825 \uc218\uc900\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. STEP3 - \uc0c1\ub300 \uc804\ub7b5\uc5d0 \ub530\ub77c \ud3ec\uc9c0\uc158\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud074\ub9b0\uc5c5 \uc790\ub9ac\uc5d0 \ud30c\uc6cc \ud788\ud130\ub97c \ubc30\uce58\ud558\uba74 \ub4dd\uc810\uc744 \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc635\uc158 A - \uc120\ubc1c \uc720\uc9c0, \uc635\uc158 B - \uad50\uccb4 \uc120\uc218 \uad50\ub300\ub85c \uc6b4\uc601.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0 \uac8c\uc784 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\ub294 \uc804\uc2dc, \uc2dc\uc98c, \uc628\ub77c\uc778 \ub4f1 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc804\uc2dc \ubaa8\ub4dc\ub294 \ub2e8\uc77c \uac8c\uc784\uc774\uace0, \uc2dc\uc98c \ubaa8\ub4dc\ub294 \uc5ec\ub7ec \uac8c\uc784\uc5d0 \uac78\uccd0 \ud1b5\uacc4\ub97c \ucd94\uc801\ud558\uba70, \uc628\ub77c\uc778 \ubaa8\ub4dc\ub294 \uc2e4\uc2dc\uac04 \uacbd\uc7c1\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2dc\uc98c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc120\uc218 \ud1b5\uacc4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ub204\uc801\ub418\uc5b4 \ubbf8\ub798 \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc804\uc2dc \ubaa8\ub4dc\ub294 \uce5c\uc120 \uacbd\uae30, \uc2dc\uc98c \ubaa8\ub4dc\ub294 \ub9c8\ub77c\ud1a4, \uc628\ub77c\uc778 \ubaa8\ub4dc\ub294 \ud1a0\ub108\uba3c\ud2b8\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud22c\uad6c \uc815\ud655\uc131\uc744 \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ud22c\uad6c \uc815\ud655\uc131\uc744 \ub192\uc774\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: STEP1 - \ub2e4\uc591\ud55c \ud22c\uad6c \uc885\ub958\ub97c \uc5f0\uc2b5\ud558\uc5ec \uadf8 \uada4\uc801\uc744 \uc774\ud574\ud569\ub2c8\ub2e4. STEP2 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uc5f0\ub9c8\ud569\ub2c8\ub2e4. STEP3 - \uc0c1\ub300\uc758 \ud0c0\uaca9 \uacbd\ud5a5\uc744 \ubd84\uc11d\ud558\uc5ec \uc804\ub7b5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucee4\ube0c\ubcfc\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \ud0c0\uc790\ub4e4\uc774 \uacf5\uc758 \uada4\uc801\uc744 \uc608\uce21\ud558\uae30 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc9c1\uad6c - \uc9c1\uc120, \ucee4\ube0c\ubcfc - \uc544\ub798\ucabd \uace1\uc120, \uc2ac\ub77c\uc774\ub354 - \uc606\uc73c\ub85c \uc6c0\uc9c1\uc784.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5a4 \uc758\ubbf8\uac00 \uc788\ub098\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \ub3d9\ud5a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ube44\uac00 \uc624\uba74 \uacf5\uc774 \ubbf8\ub044\ub7ec\uc6cc\uc838 \ud22c\uad6c \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc774 \ub5a8\uc5b4\uc9c0\uace0, \ubc14\ub78c\uc774 \ubd88\uba74 \uacf5\uc758 \uada4\uc801\uc774 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ud55c \uc5ed\ud48d\uc740 \uc7a0\uc7ac\uc801\uc778 \ud648\ub7f0\uc744 \ud50c\ub77c\uc774\uc544\uc6c3\uc73c\ub85c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub0a0\uc528 \uc870\uac74 \u2192 \uacf5\uc758 \uc6c0\uc9c1\uc784 \u2192 \uac8c\uc784 \uc804\ub7b5.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8 \uae30\uae30\uc5d0 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: STEP1 - \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. STEP3 - \uc0c8 \uae30\uae30\uc5d0 \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android \uae30\uae30\ub85c \uc774\uc804\ud558\uba74 \ubaa8\ub4e0 \ud1b5\uacc4\uc640 \uc131\ucde8\ub3c4\uac00 \uc720\uc9c0\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc635\uc158 A - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5, \uc635\uc158 B - \uc218\ub3d9 \ubc31\uc5c5.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc120\uc218 \ub2a5\ub825\uacfc \ud76c\uadc0 \uc7a5\ube44\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc228\uaca8\uc9c4 \ub2a5\ub825\uc73c\ub85c \ud22c\uc218\uac00 \ud0c0\uc790\uac00 \uce58\uae30 \uc5b4\ub824\uc6b4 \ucee4\ud130\ubcfc\uc744 \ub358\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uc601\ud654 \uc18d \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uc120\uc218 \ud2b9\uc9d5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc57c\uad6c\uc2a4\ud0c0\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uc120\uc218 \ud2b9\uc9d5\uc740 \uc18d\ub3c4, \ud30c\uc6cc, \uc815\ud655\uc131\uc785\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \uc8fc\ub8e8\uc640 \uc218\ube44\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uace0, \ud30c\uc6cc\ub294 \ud0c0\uaca9 \uac70\ub9ac\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc815\ud655\uc131\uc740 \ud22c\uad6c \ud6a8\uacfc\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc6cc\uac00 \ub192\uc740 \uc120\uc218\ub294 \ub354 \ub9ce\uc740 \ud648\ub7f0\uc744 \uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc18d\ub3c4 - \uc8fc\ub8e8, \ud30c\uc6cc - \ud0c0\uaca9, \uc815\ud655\uc131 - \ud22c\uad6c.]"}]
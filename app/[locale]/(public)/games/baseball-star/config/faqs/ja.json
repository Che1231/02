[{"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u57fa\u672c\u7684\u306a\u6295\u7403\u306f\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u57fa\u672c\u7684\u306a\u6295\u7403\u3092\u884c\u3046\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d4\u30c3\u30c1\u30f3\u30b0\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u6295\u7403\u306e\u7a2e\u985e\uff08\u4f8b\u3048\u3070\u3001\u30b9\u30c8\u30ec\u30fc\u30c8\uff09\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u753b\u9762\u4e0a\u306e\u7167\u6e96\u5668\u3092\u4f7f\u3063\u3066\u6295\u7403\u3092\u76ee\u6a19\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u6295\u7403\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u5b9f\u884c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30b9\u30c8\u30ec\u30fc\u30c8\u306f\u6642\u901f95\u30de\u30a4\u30eb\u306b\u9054\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u7684\u3092\u5c04\u308b\u3088\u3046\u306a\u30c0\u30fc\u30c4\u306e\u6295\u7403\u306e\u3088\u3046\u306b\u3001\u6b63\u78ba\u3055\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u52b9\u679c\u7684\u306a\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u306f\u3001\u6b21\u306e\u624b\u9806\u3092\u542b\u307f\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d4\u30c3\u30c1\u30e3\u30fc\u306e\u30e2\u30fc\u30b7\u30e7\u30f3\u3092\u898b\u3066\u3001\u6295\u7403\u306e\u7a2e\u985e\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6295\u7403\u306e\u4f4d\u7f6e\u306b\u5408\u308f\u305b\u3066\u30d0\u30c3\u30c8\u306e\u4f4d\u7f6e\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u5927\u306e\u30d1\u30ef\u30fc\u3092\u767a\u63ee\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u632f\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb\u306b\u5b8c\u74a7\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u632f\u308c\u3070\u3001\u30db\u30fc\u30e0\u30e9\u30f3\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b9\u30c8\u30ec\u30fc\u30c8\u30dc\u30fc\u30eb-\u9ad8\u304f\u72d9\u3046\u3001\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb-\u4f4e\u304f\u72d9\u3046\u3001\u30b9\u30e9\u30a4\u30c0\u30fc-\u771f\u3093\u4e2d\u72d9\u3046\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u9078\u624b\u306e\u30b9\u30bf\u30df\u30ca\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u9078\u624b\u306e\u30b9\u30bf\u30df\u30ca\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3084\u6b63\u78ba\u6027\u3068\u3044\u3063\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u304c\u4f4e\u3044\u3068\u3001\u6295\u7403\u901f\u5ea6\u304c\u9045\u304f\u306a\u308a\u3001\u6253\u6483\u3082\u5f31\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30bf\u30df\u30ca\u306e\u4f4e\u3044\u30d4\u30c3\u30c1\u30e3\u30fc\u306f\u3001\u6642\u901f95\u30de\u30a4\u30eb\u3067\u306f\u306a\u304f\u3001\u6642\u901f85\u30de\u30a4\u30eb\u3067\u30b9\u30c8\u30ec\u30fc\u30c8\u3092\u6295\u3052\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30bf\u30df\u30ca\u30b2\u30fc\u30b8\u2192\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u6307\u6a19\u2192\u30b2\u30fc\u30e0\u7d50\u679c\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u30c1\u30fc\u30e0\u306e\u767b\u9332\u9078\u624b\u3092\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3057\u307e\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u30c1\u30fc\u30e0\u306e\u767b\u9332\u9078\u624b\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9078\u624b\u306e\u7d71\u8a08\u30c7\u30fc\u30bf\u5206\u6790\u3092\u884c\u3044\u3001\u5f37\u307f\u3084\u5f31\u307f\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30bf\u30df\u30ca\u30ec\u30d9\u30eb\u3092\u6700\u9069\u306b\u4fdd\u3064\u305f\u3081\u306b\u3001\u9078\u624b\u3092\u30ed\u30fc\u30c6\u30fc\u30b7\u30e7\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u6226\u7565\u306b\u5408\u308f\u305b\u3066\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f37\u529b\u6253\u8005\u3092\u30af\u30ea\u30fc\u30f3\u30ca\u30c3\u30d7\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u5f97\u70b9\u529b\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A-\u5148\u767a\u3092\u7dad\u6301\u3001\u30aa\u30d7\u30b7\u30e7\u30f3B-\u30d9\u30f3\u30c1\u9078\u624b\u3092\u30ed\u30fc\u30c6\u30fc\u30b7\u30e7\u30f3\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u306b\u306f\u3001\u7df4\u7fd2\u8a66\u5408\u3001\u30b7\u30fc\u30ba\u30f3\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u8907\u6570\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u7df4\u7fd2\u8a66\u5408\u306f\u5358\u4e00\u306e\u8a66\u5408\u3001\u30b7\u30fc\u30ba\u30f3\u306f\u8907\u6570\u306e\u8a66\u5408\u3067\u7d71\u8a08\u3092\u8ffd\u8de1\u3057\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u306f\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u5bfe\u6226\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30fc\u30ba\u30f3\u30e2\u30fc\u30c9\u3067\u306f\u3001\u9078\u624b\u306e\u7d71\u8a08\u306f\u6642\u9593\u3068\u3068\u3082\u306b\u84c4\u7a4d\u3055\u308c\u3001\u5c06\u6765\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u7df4\u7fd2\u8a66\u5408\u306f\u89aa\u7766\u8a66\u5408\u3001\u30b7\u30fc\u30ba\u30f3\u306f\u30de\u30e9\u30bd\u30f3\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u306f\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u30d4\u30c3\u30c1\u30f3\u30b0\u306e\u6b63\u78ba\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u30d4\u30c3\u30c1\u30f3\u30b0\u306e\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3055\u307e\u3056\u307e\u306a\u6295\u7403\u306e\u7a2e\u985e\u3092\u5b9f\u8df5\u3057\u3066\u3001\u305d\u306e\u8ecc\u9053\u306b\u3064\u3044\u3066\u7406\u89e3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5fae\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u6253\u6483\u50be\u5411\u3092\u5206\u6790\u3057\u3001\u6226\u7565\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb\u3092\u7fd2\u5f97\u3059\u308c\u3070\u3001\u6253\u8005\u304c\u30dc\u30fc\u30eb\u306e\u30b3\u30fc\u30b9\u3092\u4e88\u6e2c\u3057\u3065\u3089\u304f\u306a\u308a\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b9\u30c8\u30ec\u30fc\u30c8\u30dc\u30fc\u30eb-\u4e00\u76f4\u7dda\u3001\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb-\u4e0b\u964d\u30a2\u30fc\u30c1\u3001\u30b9\u30e9\u30a4\u30c0\u30fc-\u6a2a\u65b9\u5411\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306a\u610f\u5473\u3092\u6301\u3061\u307e\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u96e8\u306f\u30dc\u30fc\u30eb\u3092\u6ed1\u308a\u3084\u3059\u304f\u3057\u3001\u6295\u7403\u901f\u5ea6\u3068\u6b63\u78ba\u6027\u3092\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u4e00\u65b9\u3001\u98a8\u306f\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u5909\u5316\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f37\u3044\u8ffd\u3044\u98a8\u306f\u3001\u6f5c\u5728\u7684\u306a\u30db\u30fc\u30e0\u30e9\u30f3\u3092\u30d5\u30e9\u30a4\u30a2\u30a6\u30c8\u306b\u5909\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5929\u5019\u6761\u4ef6\u2192\u30dc\u30fc\u30eb\u306e\u6319\u52d5\u2192\u30b2\u30fc\u30e0\u6226\u7565\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3057\u3066\u3082\u3001\u3059\u3079\u3066\u306e\u7d71\u8a08\u30c7\u30fc\u30bf\u3068\u5b9f\u7e3e\u306f\u7dad\u6301\u3055\u308c\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A-\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3001\u30aa\u30d7\u30b7\u30e7\u30f3B-\u624b\u52d5\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u306b\u306f\u3001\u79d8\u5bc6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u80fd\u529b\u3084\u30ec\u30a2\u306a\u88c5\u5099\u3068\u3044\u3063\u305f\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96a0\u3055\u308c\u305f\u80fd\u529b\u306b\u3088\u308a\u3001\u30d4\u30c3\u30c1\u30e3\u30fc\u306f\u6253\u8005\u306b\u96e3\u3057\u304f\u3055\u305b\u308b\u30ca\u30c3\u30af\u30eb\u30dc\u30fc\u30eb\u3092\u6295\u3052\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306f\u3001\u6620\u753b\u306e\u4e2d\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u6700\u3082\u91cd\u8981\u306a\u9078\u624b\u306e\u5c5e\u6027\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u91ce\u7403\u30b9\u30bf\u30fc\u3067\u6700\u3082\u91cd\u8981\u306a\u9078\u624b\u306e\u5c5e\u6027\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u30d1\u30ef\u30fc\u3001\u6b63\u78ba\u6027\u3067\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u306f\u8d70\u5841\u3068\u5b88\u5099\u306b\u5f71\u97ff\u3057\u3001\u30d1\u30ef\u30fc\u306f\u6253\u6483\u8ddd\u96e2\u306b\u5f71\u97ff\u3057\u3001\u6b63\u78ba\u6027\u306f\u30d4\u30c3\u30c1\u30f3\u30b0\u306e\u6709\u52b9\u6027\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30ef\u30fc\u304c\u9ad8\u3044\u9078\u624b\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30db\u30fc\u30e0\u30e9\u30f3\u3092\u6253\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b9\u30d4\u30fc\u30c9-\u8d70\u5841\u3001\u30d1\u30ef\u30fc-\u6253\u6483\u3001\u6b63\u78ba\u6027-\u6295\u7403\u3002]"}]
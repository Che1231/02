[{"question": "\u041a\u0430\u043a \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u0431\u0440\u043e\u0441\u043e\u043a \u0432 Baseball Star?", "answer": "\u0427\u0442\u043e\u0431\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u0431\u0440\u043e\u0441\u043e\u043a \u0432 Baseball Star, \u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u044d\u0442\u0438\u043c \u0448\u0430\u0433\u0430\u043c: \u0428\u0410\u0413 1 - \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0438\u043f \u0431\u0440\u043e\u0441\u043a\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u043c\u044f\u0447) \u0438\u0437 \u043c\u0435\u043d\u044e \u0431\u0440\u043e\u0441\u043a\u043e\u0432. \u0428\u0410\u0413 2 - \u041d\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043c\u044f\u0447 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043c\u0435\u0442\u043a\u0438 \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435. \u0428\u0410\u0413 3 - \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0431\u0440\u043e\u0441\u043a\u0430 \u0432 \u043d\u0443\u0436\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0431\u0440\u043e\u0441\u043e\u043a. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0445\u043e\u0440\u043e\u0448\u043e \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0439 \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u043c\u044f\u0447 \u043c\u043e\u0436\u0435\u0442 \u0434\u043e\u0441\u0442\u0438\u0433\u0430\u0442\u044c \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0434\u043e 95 \u043c\u0438\u043b\u044c \u0432 \u0447\u0430\u0441. [\u0410\u043d\u0430\u043b\u043e\u0433\u0438\u044f: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435, \u0447\u0442\u043e \u0432\u044b \u0431\u0440\u043e\u0441\u0430\u0435\u0442\u0435 \u0434\u0440\u043e\u0442\u0438\u043a, \u0433\u0434\u0435 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u0432\u0440\u0435\u043c\u044f \u2013 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u043b\u0443\u0447\u0448\u0438\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0434\u043b\u044f \u0438\u0433\u0440\u044b \u0432 \u0431\u0435\u0439\u0441\u0431\u043e\u043b \u0432 Baseball Star?", "answer": "\u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0438\u0433\u0440\u0430 \u0432 \u0431\u0435\u0439\u0441\u0431\u043e\u043b \u0432 Baseball Star \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442: \u0428\u0410\u0413 1 - \u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0440\u0430\u0437\u0431\u0435\u0433\u043e\u043c \u043f\u0438\u0442\u0447\u0435\u0440\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0442\u0438\u043f \u0431\u0440\u043e\u0441\u043a\u0430. \u0428\u0410\u0413 2 - \u041f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0431\u0438\u0442\u0443 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u0431\u0440\u043e\u0441\u043a\u0430. \u0428\u0410\u0413 3 - \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0443\u0434\u0430\u0440\u0430 \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u043b\u043e\u0439. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0439 \u0443\u0434\u0430\u0440 \u043f\u043e \u043a\u0440\u0438\u0432\u043e\u0439 \u043c\u044f\u0447\u0443 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u0434\u043e\u043c\u0430\u0448\u043d\u0435\u043c\u0443 \u0431\u0435\u0433\u0443. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u043c\u044f\u0447 \u2013 \u041d\u0430\u0432\u043e\u0434\u0438\u0442\u0435 \u0432\u044b\u0441\u043e\u043a\u043e, \u041a\u0440\u0438\u0432\u043e\u0439 \u043c\u044f\u0447 \u2013 \u041d\u0430\u0432\u043e\u0434\u0438\u0442\u0435 \u043d\u0438\u0437\u043a\u043e, \u0421\u043b\u0430\u0439\u0434\u0435\u0440 \u2013 \u041d\u0430\u0432\u043e\u0434\u0438\u0442\u0435 \u043f\u043e \u0446\u0435\u043d\u0442\u0440\u0443.]"}, {"question": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430 \u0432\u0430\u0436\u043d\u0430 \u0432 Baseball Star?", "answer": "\u0412\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430 \u0432 Baseball Star \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0442\u0430\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438, \u043a\u0430\u043a \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c. \u041d\u0438\u0437\u043a\u0430\u044f \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043a \u0431\u043e\u043b\u0435\u0435 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u043c \u0431\u0440\u043e\u0441\u043a\u0430\u043c \u0438 \u0431\u043e\u043b\u0435\u0435 \u0441\u043b\u0430\u0431\u044b\u043c \u0443\u0434\u0430\u0440\u0430\u043c. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0438\u0442\u0447\u0435\u0440 \u0441 \u043d\u0438\u0437\u043a\u043e\u0439 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c\u044e \u043c\u043e\u0436\u0435\u0442 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u043c\u044f\u0447 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e 85 \u043c\u0438\u043b\u044c \u0432 \u0447\u0430\u0441 \u0432\u043c\u0435\u0441\u0442\u043e 95 \u043c\u0438\u043b\u044c \u0432 \u0447\u0430\u0441. [\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430: \u041f\u0430\u043d\u0435\u043b\u044c \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u0438 \u2192 \u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u2192 \u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0438\u0433\u0440\u044b.]"}, {"question": "\u041a\u0430\u043a \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u043e\u0441\u0442\u0430\u0432\u043e\u043c \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 Baseball Star?", "answer": "\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0441\u0442\u0430\u0432\u043e\u043c \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 Baseball Star \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442: \u0428\u0410\u0413 1 - \u0410\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0438 \u0441\u043b\u0430\u0431\u044b\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u044b. \u0428\u0410\u0413 2 - \u041c\u0435\u043d\u044f\u0439\u0442\u0435 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u0438. \u0428\u0410\u0413 3 - \u041a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0443\u0434\u0430\u0440\u043d\u0438\u043a\u0430 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u00ab\u0432\u044b\u0431\u0438\u0432\u0430\u044e\u0449\u0435\u0433\u043e\u00bb \u043c\u043e\u0436\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u0435\u0436\u0435\u043a. [\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: \u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0410 \u2013 \u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0411 \u2013 \u041f\u043e\u043c\u0435\u043d\u044f\u0442\u044c \u0437\u0430\u043f\u0430\u0441\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432.]"}, {"question": "\u0412 \u0447\u0435\u043c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0440\u0435\u0436\u0438\u043c\u0430\u043c\u0438 \u0438\u0433\u0440\u044b \u0432 Baseball Star?", "answer": "Baseball Star \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u0438\u0433\u0440\u044b: \u0412\u044b\u0441\u0442\u0430\u0432\u043e\u0447\u043d\u044b\u0439, \u0421\u0435\u0437\u043e\u043d\u043d\u044b\u0439 \u0438 \u041e\u043d\u043b\u0430\u0439\u043d. \u0412\u044b\u0441\u0442\u0430\u0432\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u2013 \u044d\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0433\u0440\u0430, \u0421\u0435\u0437\u043e\u043d\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0438\u0433\u0440 \u0441\u043e \u0441\u043b\u0435\u0436\u0435\u043d\u0438\u0435\u043c \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u043e\u0439, \u0430 \u041e\u043d\u043b\u0430\u0439\u043d \u0440\u0435\u0436\u0438\u043c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u0421\u0435\u0437\u043e\u043d\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0438\u0433\u0440\u043e\u043a\u0430 \u043d\u0430\u043a\u0430\u043f\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0435\u043c, \u0447\u0442\u043e \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0431\u0443\u0434\u0443\u0449\u0443\u044e \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. [\u0410\u043d\u0430\u043b\u043e\u0433\u0438\u044f: \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044c\u0442\u0435, \u0447\u0442\u043e \u0412\u044b\u0441\u0442\u0430\u0432\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u2013 \u044d\u0442\u043e \u0442\u043e\u0432\u0430\u0440\u0438\u0449\u0435\u0441\u043a\u0430\u044f \u0438\u0433\u0440\u0430, \u0421\u0435\u0437\u043e\u043d\u043d\u044b\u0439 \u2013 \u043c\u0430\u0440\u0430\u0444\u043e\u043d, \u0430 \u041e\u043d\u043b\u0430\u0439\u043d \u2013 \u0442\u0443\u0440\u043d\u0438\u0440.]"}, {"question": "\u041a\u0430\u043a \u044f \u043c\u043e\u0433\u0443 \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u0431\u0440\u043e\u0441\u043a\u043e\u0432 \u0432 Baseball Star?", "answer": "\u0414\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438 \u0431\u0440\u043e\u0441\u043a\u043e\u0432 \u0432 Baseball Star \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e: \u0428\u0410\u0413 1 - \u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u0440\u0430\u0437\u043d\u044b\u0435 \u0442\u0438\u043f\u044b \u0431\u0440\u043e\u0441\u043a\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u0438\u0445 \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u0438. \u0428\u0410\u0413 2 - \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043e\u0447\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u043d\u0430\u0432\u044b\u043a\u0438. \u0428\u0410\u0413 3 - \u0410\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u0438 \u0443\u0434\u0430\u0440\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0441\u0432\u043e\u0438\u0432 \u043a\u0440\u0438\u0432\u043e\u0439 \u043c\u044f\u0447, \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u0442\u0440\u0443\u0434\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0443 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u044e \u043c\u044f\u0447\u0430. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u043c\u044f\u0447 \u2013 \u041f\u0440\u044f\u043c\u043e\u0439, \u041a\u0440\u0438\u0432\u043e\u0439 \u043c\u044f\u0447 \u2013 \u041f\u043e \u043d\u0438\u0441\u0445\u043e\u0434\u044f\u0449\u0435\u0439 \u0434\u0443\u0433\u0435, \u0421\u043b\u0430\u0439\u0434\u0435\u0440 \u2013 \u041f\u043e\u0431\u043e\u0447\u043d\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044e.]"}, {"question": "\u041a\u0430\u043a\u043e\u0432\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u043e\u0433\u043e\u0434\u044b \u0432 Baseball Star?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u043e\u0433\u043e\u0434\u044b \u0432 Baseball Star \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0443 \u0438\u0433\u0440\u044b. \u0414\u043e\u0436\u0434\u044c \u043c\u043e\u0436\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043c\u044f\u0447 \u0441\u043a\u043e\u043b\u044c\u0437\u043a\u0438\u043c, \u0441\u043d\u0438\u0437\u0438\u0432 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0438 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0431\u0440\u043e\u0441\u043a\u043e\u0432, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u0432\u0435\u0442\u0435\u0440 \u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u044e \u043c\u044f\u0447\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u043d\u044b\u0439 \u0432\u0435\u0442\u0435\u0440 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0439 \u0431\u0435\u0433 \u0432 \u0432\u044b\u0431\u0438\u0432\u0430\u043d\u0438\u0435. [\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430: \u041f\u043e\u0433\u043e\u0434\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u2192 \u041f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u044f\u0447\u0430 \u2192 \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f \u0438\u0433\u0440\u044b.]"}, {"question": "\u041a\u0430\u043a \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 Baseball Star \u043d\u0430 \u043d\u043e\u0432\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e?", "answer": "\u0414\u043b\u044f \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u0432 Baseball Star: \u0428\u0410\u0413 1 - \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e \u0432\u044b \u0432\u043e\u0448\u043b\u0438 \u0432 \u0442\u0443 \u0436\u0435 \u0443\u0447\u0435\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u043e\u0431\u043e\u0438\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445. \u0428\u0410\u0413 2 - \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043e\u0431\u043b\u0430\u0447\u043d\u043e\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445. \u0428\u0410\u0413 3 - \u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0444\u0430\u0439\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u043d\u0430 \u043d\u043e\u0432\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0441 iPhone \u043d\u0430 Android \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442 \u0432\u0441\u044e \u0432\u0430\u0448\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f. [\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: \u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0410 \u2013 \u041e\u0431\u043b\u0430\u0447\u043d\u043e\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435, \u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0411 \u2013 \u0420\u0443\u0447\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 Baseball Star?", "answer": "Baseball Star \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u0440\u0435\u0434\u043a\u043e\u0435 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u043a\u0440\u044b\u0442\u0430\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u043f\u0438\u0442\u0447\u0435\u0440\u0443 \u0431\u0440\u043e\u0441\u0438\u0442\u044c \u043c\u044f\u0447 \u00abknuckleball\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u0440\u0443\u0434\u043d\u043e \u043f\u043e\u0439\u043c\u0430\u0442\u044c \u0431\u0438\u0442\u043e\u0439. [\u0410\u043d\u0430\u043b\u043e\u0433\u0438\u044f: \u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u044d\u0442\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u043f\u043e\u0445\u043e\u0436\u0435 \u043d\u0430 \u043f\u043e\u0438\u0441\u043a \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0445 \u044f\u0438\u0446 \u0432 \u0444\u0438\u043b\u044c\u043c\u0435.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u044b \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0432\u0430\u0436\u043d\u044b \u0432 Baseball Star?", "answer": "\u0421\u0430\u043c\u044b\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u044b \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432 Baseball Star \u2013 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c, \u0441\u0438\u043b\u0430 \u0438 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c. \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0431\u0435\u0433 \u043f\u043e \u0431\u0430\u0437\u0430\u043c \u0438 \u0438\u0433\u0440\u0443 \u0432 \u043f\u043e\u043b\u0435, \u0441\u0438\u043b\u0430 \u2013 \u043d\u0430 \u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0443\u0434\u0430\u0440\u043e\u0432, \u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043f\u0438\u0442\u0447\u0435\u0440\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0433\u0440\u043e\u043a \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0441\u0438\u043b\u043e\u0439 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u043d\u043e\u0441\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0431\u0435\u0433\u043e\u0432. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u2013 \u0411\u0435\u0433 \u043f\u043e \u0431\u0430\u0437\u0430\u043c, \u0421\u0438\u043b\u0430 \u2013 \u0423\u0434\u0430\u0440\u044b, \u0422\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u2013 \u0411\u0440\u043e\u0441\u043a\u0438.]"}]
[{"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u8fdb\u884c\u57fa\u672c\u6295\u7403\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u8fdb\u884c\u57fa\u672c\u6295\u7403\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u4ece\u6295\u7403\u83dc\u5355\u4e2d\u9009\u62e9\u6295\u7403\u7c7b\u578b\uff08\u4f8b\u5982\uff0c\u5feb\u901f\u7403\uff09\u3002\u6b65\u9aa42 - \u4f7f\u7528\u5c4f\u5e55\u4e0a\u7684\u51c6\u661f\u7784\u51c6\u6295\u7403\u3002\u6b65\u9aa43 - \u5728\u9002\u5f53\u7684\u65f6\u673a\u6309\u4e0b\u6295\u7403\u6309\u94ae\u6267\u884c\u6295\u7403\u3002\u4f8b\u5982\uff0c\u65f6\u673a\u628a\u63e1\u597d\u7684\u5feb\u901f\u7403\u53ef\u4ee5\u8fbe\u5230\u6bcf\u5c0f\u65f695\u82f1\u91cc\u7684\u901f\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u60f3\u8c61\u6210\u6295\u98de\u9556\uff0c\u7cbe\u51c6\u548c\u65f6\u673a\u81f3\u5173\u91cd\u8981\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6700\u4f73\u7684\u51fb\u7403\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6709\u6548\u7684\u51fb\u7403\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41 - \u6ce8\u610f\u6295\u624b\u52a8\u4f5c\uff0c\u9884\u6d4b\u6295\u7403\u7c7b\u578b\u3002\u6b65\u9aa42 - \u6839\u636e\u6295\u7403\u4f4d\u7f6e\u8c03\u6574\u68d2\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa43 - \u5728\u6700\u4f73\u65f6\u673a\u6325\u68d2\uff0c\u4ee5\u83b7\u5f97\u6700\u5927\u529b\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u66f2\u7ebf\u7403\u4e0a\u5b8c\u7f8e\u65f6\u673a\u6325\u68d2\u53ef\u4ee5\u51fb\u51fa\u5168\u5792\u6253\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u7784\u51c6\u9ad8\u5904\uff0c\u66f2\u7ebf\u7403 - \u7784\u51c6\u4f4e\u5904\uff0c\u6ed1\u7403 - \u7784\u51c6\u4e2d\u95f4\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7403\u5458\u4f53\u529b\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7403\u5458\u4f53\u529b\u4f1a\u5f71\u54cd\u901f\u5ea6\u548c\u51c6\u786e\u6027\u7b49\u6027\u80fd\u6307\u6807\u3002\u4f53\u529b\u4f4e\u4f1a\u4f7f\u6295\u7403\u53d8\u6162\uff0c\u51fb\u7403\u65e0\u529b\u3002\u4f8b\u5982\uff0c\u4f53\u529b\u4f4e\u7684\u6295\u624b\u53ef\u80fd\u53ea\u80fd\u6295\u51fa\u6bcf\u5c0f\u65f685\u82f1\u91cc\u7684\u5feb\u901f\u7403\uff0c\u800c\u4e0d\u662f95\u82f1\u91cc\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u4f53\u529b\u6761 \u2192 \u6027\u80fd\u6307\u6807 \u2192 \u6e38\u620f\u7ed3\u679c\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u7ba1\u7406\u7403\u961f\u7684\u9635\u5bb9\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u7ba1\u7406\u7403\u961f\u7684\u9635\u5bb9\u5305\u62ec\uff1a\u6b65\u9aa41 - \u5206\u6790\u7403\u5458\u6570\u636e\uff0c\u8bc6\u522b\u4f18\u52bf\u548c\u52a3\u52bf\u3002\u6b65\u9aa42 - \u8f6e\u6362\u7403\u5458\uff0c\u4fdd\u6301\u4f53\u529b\u6c34\u5e73\u6700\u4f73\u3002\u6b65\u9aa43 - \u6839\u636e\u5bf9\u624b\u7b56\u7565\u8c03\u6574\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5c06\u5f3a\u6253\u8005\u5b89\u6392\u5728\u8865\u5792\u4f4d\u7f6e\uff0c\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5f97\u5206\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A - \u4fdd\u7559\u5148\u53d1\u7403\u5458\uff0c\u65b9\u6848B - \u8f6e\u6362\u66ff\u8865\u7403\u5458\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u63d0\u4f9b\u591a\u79cd\u6e38\u620f\u6a21\u5f0f\uff1a\u7ec3\u4e60\u6a21\u5f0f\u3001\u8d5b\u5b63\u6a21\u5f0f\u548c\u5728\u7ebf\u6a21\u5f0f\u3002\u7ec3\u4e60\u6a21\u5f0f\u662f\u5355\u573a\u6e38\u620f\uff0c\u8d5b\u5b63\u6a21\u5f0f\u8de8\u8d8a\u591a\u573a\u6bd4\u8d5b\u5e76\u8ffd\u8e2a\u6570\u636e\uff0c\u5728\u7ebf\u6a21\u5f0f\u5141\u8bb8\u5b9e\u65f6\u5bf9\u6297\u3002\u4f8b\u5982\uff0c\u5728\u8d5b\u5b63\u6a21\u5f0f\u4e2d\uff0c\u7403\u5458\u6570\u636e\u4f1a\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u79ef\u7d2f\uff0c\u5f71\u54cd\u672a\u6765\u7684\u8868\u73b0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u7ec3\u4e60\u6a21\u5f0f\u60f3\u8c61\u6210\u4e00\u573a\u53cb\u8c0a\u8d5b\uff0c\u5c06\u8d5b\u5b63\u6a21\u5f0f\u60f3\u8c61\u6210\u4e00\u573a\u9a6c\u62c9\u677e\uff0c\u5c06\u5728\u7ebf\u6a21\u5f0f\u60f3\u8c61\u6210\u4e00\u573a\u9526\u6807\u8d5b\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u63d0\u9ad8\u6295\u7403\u51c6\u786e\u6027\uff1f", "answer": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u63d0\u9ad8\u6295\u7403\u51c6\u786e\u6027\u9700\u8981\uff1a\u6b65\u9aa41 - \u7ec3\u4e60\u4e0d\u540c\u7c7b\u578b\u7684\u6295\u7403\uff0c\u4e86\u89e3\u5b83\u4eec\u7684\u8f68\u8ff9\u3002\u6b65\u9aa42 - \u4f7f\u7528\u8bad\u7ec3\u6a21\u5f0f\u6765\u78e8\u7ec3\u4f60\u7684\u8282\u594f\u3002\u6b65\u9aa43 - \u5206\u6790\u5bf9\u624b\u7684\u51fb\u7403\u4e60\u60ef\uff0c\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u638c\u63e1\u66f2\u7ebf\u7403\u53ef\u4ee5\u4f7f\u51fb\u7403\u624b\u66f4\u96be\u4ee5\u9884\u6d4b\u7403\u7684\u8def\u7ebf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u76f4\u7ebf\uff0c\u66f2\u7ebf\u7403 - \u5411\u4e0b\u5f27\u7ebf\uff0c\u6ed1\u7403 - \u4fa7\u5411\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u6709\u4f55\u610f\u4e49\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u4f1a\u5f71\u54cd\u6e38\u620f\u52a8\u6001\u3002\u96e8\u5929\u4f1a\u4f7f\u7403\u53d8\u6ed1\uff0c\u964d\u4f4e\u6295\u7403\u901f\u5ea6\u548c\u51c6\u786e\u6027\uff0c\u98ce\u4f1a\u6539\u53d8\u7403\u7684\u8f68\u8ff9\u3002\u4f8b\u5982\uff0c\u5f3a\u70c8\u7684\u9006\u98ce\u53ef\u80fd\u4f1a\u5c06\u6f5c\u5728\u7684\u5168\u5792\u6253\u53d8\u6210\u98de\u7403\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5929\u6c14\u72b6\u51b5 \u2192 \u7403\u7684\u8fd0\u884c\u8f68\u8ff9 \u2192 \u6e38\u620f\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u5c06\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u4f60\u7684\u68d2\u7403\u4e4b\u661f\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u53f7\u3002\u6b65\u9aa42 - \u4f7f\u7528\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u4e0a\u4f20\u4f60\u7684\u6570\u636e\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u4fdd\u5b58\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5c06\u6e38\u620f\u4ece iPhone \u8f6c\u79fb\u5230 Android \u8bbe\u5907\uff0c\u53ef\u4ee5\u4fdd\u7559\u4f60\u6240\u6709\u6570\u636e\u548c\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A - \u4e91\u7aef\u4fdd\u5b58\uff0c\u65b9\u6848B - \u624b\u52a8\u5907\u4efd\u3002]"}, {"question": "\u5728\u68d2\u7403\u4e4b\u661f\u4e2d\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u5305\u542b\u9690\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u79d8\u5bc6\u7403\u5458\u80fd\u529b\u548c\u7a00\u6709\u88c5\u5907\u3002\u4f8b\u5982\uff0c\u9690\u85cf\u80fd\u529b\u53ef\u80fd\u5141\u8bb8\u6295\u624b\u6295\u51fa\u96be\u4ee5\u51fb\u6253\u7684\u66f2\u7403\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53d1\u73b0\u8fd9\u4e9b\u529f\u80fd\u5c31\u50cf\u5728\u7535\u5f71\u4e2d\u627e\u5230\u5f69\u86cb\u4e00\u6837\u3002]"}, {"question": "\u68d2\u7403\u4e4b\u661f\u4e2d\u54ea\u4e9b\u7403\u5458\u5c5e\u6027\u6700\u91cd\u8981\uff1f", "answer": "\u68d2\u7403\u4e4b\u661f\u4e2d\u6700\u91cd\u8981\u7684\u7403\u5458\u5c5e\u6027\u662f\u901f\u5ea6\u3001\u529b\u91cf\u548c\u51c6\u786e\u6027\u3002\u901f\u5ea6\u5f71\u54cd\u8dd1\u5792\u548c\u63a5\u7403\uff0c\u529b\u91cf\u5f71\u54cd\u51fb\u7403\u8ddd\u79bb\uff0c\u51c6\u786e\u6027\u51b3\u5b9a\u6295\u7403\u6548\u679c\u3002\u4f8b\u5982\uff0c\u529b\u91cf\u9ad8\u7684\u7403\u5458\u53ef\u4ee5\u51fb\u51fa\u66f4\u591a\u5168\u5792\u6253\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u901f\u5ea6 - \u8dd1\u5792\uff0c\u529b\u91cf - \u51fb\u7403\uff0c\u51c6\u786e\u6027 - \u6295\u7403\u3002]"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1 Bad Ice Cream 3 \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1 Bad Ice Cream 3 \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1) \u4f7f\u7528\u65b9\u5411\u9375\u79fb\u52d5\u4f60\u7684\u89d2\u8272\u5728\u51b0\u683c\u5b50\u4e0a\u3002\u6b65\u9a5f 2) \u6309\u7a7a\u683c\u9375\u5275\u5efa\u51b0\u584a\uff0c\u53ef\u4ee5\u7528\u65bc\u56f0\u4f4f\u6575\u4eba\u6216\u5275\u9020\u8def\u5f91\u3002\u6b65\u9a5f 3) \u6536\u96c6\u6c34\u679c\u4f86\u7a4d\u5206\u4e26\u89e3\u9396\u65b0\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728 1 \u95dc\u4e2d\uff0c\u4f7f\u7528\u51b0\u584a\u56f0\u4f4f\u7d05\u8272\u6575\u4eba\u4e26\u6536\u96c6\u6240\u6709\u860b\u679c\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u51b0\u584a\u60f3\u50cf\u6210\u53ef\u4ee5\u7b56\u7565\u6027\u5730\u64fa\u653e\u4f86\u63a7\u5236\u6230\u5834\u7684\u7246\u58c1\u3002]"}, {"question": "\u5728 Bad Ice Cream 3 \u7684\u9ad8\u7d1a\u95dc\u5361\u4e2d\uff0c\u751f\u5b58\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Bad Ice Cream 3 \u7684\u9ad8\u7d1a\u95dc\u5361\u4e2d\u751f\u5b58\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\uff1a\u6b65\u9a5f 1) \u59cb\u7d42\u95dc\u6ce8\u6575\u4eba\u7684\u79fb\u52d5\u6a21\u5f0f\u4e26\u9810\u6e2c\u4ed6\u5011\u7684\u8def\u5f91\u3002\u6b65\u9a5f 2) \u4f7f\u7528\u51b0\u584a\u5275\u9020\u5b89\u5168\u5340\u57df\u4e26\u907f\u514d\u88ab\u903c\u5230\u89d2\u843d\u3002\u6b65\u9a5f 3) \u512a\u5148\u6536\u96c6\u8f03\u96e3\u5230\u9054\u7684\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u5728 5 \u95dc\u4e2d\uff0c\u512a\u5148\u6536\u96c6\u53f3\u4e0a\u89d2\u7684\u9999\u8549\uff0c\u5728\u6575\u4eba\u9760\u8fd1\u592a\u591a\u4e4b\u524d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u8207\u65e9\u671f\u95dc\u5361\u5f37\u8abf\u901f\u5ea6\u4e0d\u540c\uff0c\u9ad8\u7d1a\u95dc\u5361\u9700\u8981\u8010\u5fc3\u548c\u7cbe\u78ba\u7684\u6642\u6a5f\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc Bad Ice Cream 3 \u7684\u7a4d\u5206\u7cfb\u7d71\u6703\u5728\u4e0d\u540c\u7684\u95dc\u5361\u6709\u6240\u4e0d\u540c\uff1f\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u4ed6\u5011\u7684\u7a4d\u5206\uff1f", "answer": "Bad Ice Cream 3 \u7684\u7a4d\u5206\u7cfb\u7d71\u6709\u6240\u4e0d\u540c\uff0c\u56e0\u70ba\u4e0d\u540c\u7684\u6c34\u679c\u6709\u4e0d\u540c\u7684\u7a4d\u5206\u503c\uff0c\u67d0\u4e9b\u95dc\u5361\u9084\u6709\u96b1\u85cf\u7684\u734e\u52f5\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u7a4d\u5206\uff1a\u6b65\u9a5f 1) \u6536\u96c6\u76e1\u53ef\u80fd\u591a\u7684\u9ad8\u50f9\u503c\u6c34\u679c\uff0c\u4f8b\u5982\u8349\u8393\u548c\u9cf3\u68a8\u3002\u6b65\u9a5f 2) \u5feb\u901f\u5b8c\u6210\u95dc\u5361\u4ee5\u7372\u5f97\u6642\u9593\u734e\u52f5\u3002\u6b65\u9a5f 3) \u5c0b\u627e\u96e3\u4ee5\u5230\u9054\u5340\u57df\u7684\u96b1\u85cf\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u5728 3 \u95dc\u4e2d\uff0c\u51b0\u584a\u7246\u5f8c\u9762\u85cf\u8457\u4e00\u500b\u96b1\u85cf\u7684\u897f\u74dc\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u7a4d\u5206\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6c34\u679c\u7a4d\u5206\uff1a\u860b\u679c - 10 \u5206\uff0c\u9999\u8549 - 20 \u5206\uff0c\u8349\u8393 - 50 \u5206\uff0c\u897f\u74dc - 100 \u5206\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Bad Ice Cream 3 \u4e2d\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u6280\u5de7\u4f86\u667a\u52dd\u66f4\u5f37\u5927\u7684\u6575\u4eba\uff1f", "answer": "\u5728 Bad Ice Cream 3 \u4e2d\u667a\u52dd\u66f4\u5f37\u5927\u7684\u6575\u4eba\u7684\u5148\u9032\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9a5f 1) \u4f7f\u7528\u51b0\u584a\u5275\u5efa\u8ff7\u5bae\uff0c\u4f7f\u6575\u4eba\u6df7\u6dc6\u4e26\u56f0\u4f4f\u4ed6\u5011\u3002\u6b65\u9a5f 2) \u5f15\u8a98\u6575\u4eba\u9032\u5165\u53ef\u4ee5\u8f15\u9b06\u63a7\u5236\u7684\u89d2\u843d\u3002\u6b65\u9a5f 3) \u5728\u6575\u4eba\u9760\u8fd1\u4e4b\u524d\uff0c\u6e96\u78ba\u63a7\u5236\u4f60\u7684\u52d5\u4f5c\u4f86\u6536\u96c6\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u5728 7 \u95dc\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u904e\u5275\u5efa\u4e00\u500b\u4e4b\u5b57\u5f62\u51b0\u584a\u5716\u6848\u4f86\u56f0\u4f4f\u85cd\u8272\u6575\u4eba\u3002[\u6d41\u7a0b\u5716\u89e3: \u79fb\u52d5\u6a21\u5f0f\uff1a\u73a9\u5bb6 \u2192 \u51b0\u584a \u2192 \u6575\u4eba\u88ab\u56f0\u4f4f \u2192 \u6536\u96c6\u6c34\u679c\u3002]"}, {"question": "\u96a8\u8457\u73a9\u5bb6\u7684\u9032\u5ea6\uff0cBad Ice Cream 3 \u7684\u95dc\u5361\u8a2d\u8a08\u5982\u4f55\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u6311\u6230\u73a9\u5bb6\uff1f", "answer": "\u96a8\u8457\u73a9\u5bb6\u7684\u9032\u5ea6\uff0cBad Ice Cream 3 \u7684\u95dc\u5361\u8a2d\u8a08\u5f15\u5165\u4e86\u65b0\u7684\u6311\u6230\uff1a\u6b65\u9a5f 1) \u65e9\u671f\u95dc\u5361\u91cd\u9ede\u5728\u65bc\u57fa\u672c\u79fb\u52d5\u548c\u6c34\u679c\u6536\u96c6\u3002\u6b65\u9a5f 2) \u4e2d\u7d1a\u95dc\u5361\u5f15\u5165\u4e86\u66f4\u591a\u6575\u4eba\u548c\u8907\u96dc\u7684\u51b0\u584a\u7b56\u7565\u3002\u6b65\u9a5f 3) \u9ad8\u7d1a\u95dc\u5361\u5177\u6709\u901f\u5ea6\u66f4\u5feb\u7684\u6575\u4eba\u548c\u96b1\u85cf\u7684\u8def\u5f91\u3002\u4f8b\u5982\uff0c10 \u95dc\u9700\u8981\u7cbe\u78ba\u7684\u51b0\u584a\u653e\u7f6e\uff0c\u624d\u80fd\u5728\u6575\u4eba\u7684\u8ff7\u5bae\u4e2d\u7a7f\u68ad\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u95dc\u5361\u60f3\u50cf\u6210\u4e00\u500b\u96a8\u8457\u9032\u5ea6\u8b8a\u5f97\u66f4\u8907\u96dc\u7684\u8b0e\u984c\u3002]"}, {"question": "\u5728 Bad Ice Cream 3 \u4e2d\uff0c\u5982\u4f55\u6700\u6709\u6548\u5730\u5229\u7528\u51b0\u584a\u4ee5\u9054\u6210\u653b\u64ca\u548c\u9632\u79a6\uff1f", "answer": "\u5728 Bad Ice Cream 3 \u4e2d\uff0c\u51b0\u584a\u53ef\u4ee5\u7528\u65bc\u653b\u64ca\u548c\u9632\u79a6\uff1a\u6b65\u9a5f 1) \u5728\u653b\u64ca\u4e0a\uff0c\u4f7f\u7528\u51b0\u584a\u56f0\u4f4f\u6575\u4eba\u548c\u5275\u9020\u901a\u5f80\u96e3\u4ee5\u5230\u9054\u6c34\u679c\u7684\u8def\u5f91\u3002\u6b65\u9a5f 2) \u5728\u9632\u79a6\u4e0a\uff0c\u5efa\u7acb\u5c4f\u969c\u4f86\u4fdd\u8b77\u81ea\u5df1\u514d\u53d7\u6575\u4eba\u7684\u653b\u64ca\u3002\u6b65\u9a5f 3) \u5c07\u9019\u5169\u7a2e\u7b56\u7565\u7d50\u5408\u8d77\u4f86\uff0c\u56f0\u4f4f\u6575\u4eba\uff0c\u7136\u5f8c\u5b89\u5168\u5730\u6536\u96c6\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u5728 4 \u95dc\u4e2d\uff0c\u4f7f\u7528\u51b0\u584a\u56f0\u4f4f\u7da0\u8272\u6575\u4eba\uff0c\u540c\u6642\u6536\u96c6\u6afb\u6843\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u653b\u64ca\u7528\u9014\uff1a\u56f0\u4f4f\u6575\u4eba\uff1b\u9632\u79a6\u7528\u9014\uff1a\u5275\u9020\u5b89\u5168\u5340\u57df\u3002]"}, {"question": "\u5982\u4f55\u78ba\u4fdd\u5728 Bad Ice Cream 3 \u4e2d\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u5207\u63db\u6642\u904a\u6232\u80fd\u5920\u9806\u66a2\u9032\u884c\uff1f", "answer": "\u8981\u78ba\u4fdd\u5728 Bad Ice Cream 3 \u4e2d\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u5207\u63db\u6642\u904a\u6232\u80fd\u5920\u9806\u66a2\u9032\u884c\uff1a\u6b65\u9a5f 1) \u78ba\u4fdd\u4f60\u7684\u904a\u6232\u9032\u5ea6\u5132\u5b58\u5230\u96f2\u7aef\u6216\u9023\u7d50\u7684\u5e33\u6236\u3002\u6b65\u9a5f 2) \u6aa2\u67e5\u88dd\u7f6e\u662f\u5426\u7b26\u5408\u904a\u6232\u7684\u6700\u4f4e\u7cfb\u7d71\u9700\u6c42\u3002\u6b65\u9a5f 3) \u719f\u6089\u65b0\u88dd\u7f6e\u4e0a\u7684\u63a7\u5236\u65b9\u6848\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9e\u96fb\u8166\u79fb\u5230\u624b\u6a5f\uff0c\u900f\u904e\u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\u4f86\u9069\u61c9\u89f8\u63a7\u63a7\u5236\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u88dd\u7f6e\u9700\u6c42\uff1a\u96fb\u8166 - Windows 7 \u4ee5\u4e0a\uff0c\u624b\u6a5f - Android 5.0 \u4ee5\u4e0a\uff0ciOS 10.0 \u4ee5\u4e0a\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Bad Ice Cream 3 \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Bad Ice Cream 3 \u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u5305\u62ec\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u6c34\u679c\uff0c\u53ef\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1a\u6b65\u9a5f 1) \u63a2\u7d22\u5730\u5716\u7684\u6bcf\u500b\u89d2\u843d\uff0c\u5c0b\u627e\u96b1\u85cf\u7684\u6c34\u679c\uff0c\u4f8b\u5982\u91d1\u860b\u679c\u3002\u6b65\u9a5f 2) \u6eff\u8db3\u7279\u5b9a\u689d\u4ef6\u5b8c\u6210\u67d0\u4e9b\u95dc\u5361\uff0c\u89e3\u9396\u79d8\u5bc6\u968e\u6bb5\u3002\u6b65\u9a5f 3) \u4f7f\u7528\u51b0\u584a\u4f86\u63ed\u793a\u96b1\u85cf\u7684\u8def\u5f91\u3002\u4f8b\u5982\uff0c\u5728 8 \u95dc\u4e2d\uff0c\u5728\u7279\u5b9a\u4f4d\u7f6e\u653e\u7f6e\u51b0\u584a\u6703\u986f\u9732\u901a\u5f80\u984d\u5916\u95dc\u5361\u7684\u96b1\u85cf\u901a\u9053\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u96b1\u85cf\u5167\u5bb9\u60f3\u50cf\u6210\u904a\u6232\u4e2d\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u4ed4\u7d30\u7684\u63a2\u7d22\u3002]"}, {"question": "Bad Ice Cream 3 \u7684\u6575\u4eba AI \u5982\u4f55\u9069\u61c9\u73a9\u5bb6\u7684\u7b56\u7565\uff0c\u73a9\u5bb6\u53ef\u4ee5\u505a\u4e9b\u4ec0\u9ebc\u4f86\u53cd\u5236\uff1f", "answer": "Bad Ice Cream 3 \u7684\u6575\u4eba AI \u6703\u900f\u904e\u5b78\u7fd2\u73a9\u5bb6\u7684\u79fb\u52d5\u6a21\u5f0f\u4e26\u8b8a\u5f97\u66f4\u5177\u4fb5\u7565\u6027\uff1a\u6b65\u9a5f 1) \u983b\u7e41\u5730\u6539\u8b8a\u4f60\u7684\u79fb\u52d5\u6a21\u5f0f\u4f86\u6df7\u6dc6 AI\u3002\u6b65\u9a5f 2) \u4f7f\u7528\u51b0\u584a\u5275\u9020\u4e0d\u53ef\u9810\u6e2c\u7684\u8def\u5f91\u3002\u6b65\u9a5f 3) \u4fdd\u6301\u79fb\u52d5\uff0c\u907f\u514d\u5728\u540c\u4e00\u5340\u57df\u505c\u7559\u592a\u4e45\u3002\u4f8b\u5982\uff0c\u5728 9 \u95dc\uff0c\u5982\u679c\u4f60\u53cd\u8986\u4f7f\u7528\u76f8\u540c\u7684\u7b56\u7565\uff0cAI \u5c07\u958b\u59cb\u9810\u6e2c\u4f60\u7684\u52d5\u4f5c\u3002[\u6d41\u7a0b\u5716\u89e3: \u73a9\u5bb6\u79fb\u52d5 \u2192 AI \u9810\u6e2c \u2192 \u53cd\u5236\u7b56\u7565 \u2192 \u56f0\u4f4f\u6575\u4eba\u3002]"}, {"question": "Bad Ice Cream 3 \u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e0d\u540c\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Bad Ice Cream 3 \u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u76ee\u6a19\u548c\u52d5\u614b\u4e0a\u6709\u6240\u5340\u5225\uff1a\u6b65\u9a5f 1) \u55ae\u4eba\u6a21\u5f0f\u5074\u91cd\u65bc\u500b\u4eba\u6280\u80fd\u548c\u7b56\u7565\u3002\u6b65\u9a5f 2) \u591a\u4eba\u6a21\u5f0f\u5f15\u5165\u4e86\u5408\u4f5c\u548c\u7af6\u722d\u5143\u7d20\u3002\u6b65\u9a5f 3) \u591a\u4eba\u95dc\u5361\u901a\u5e38\u6709\u66f4\u591a\u6575\u4eba\uff0c\u9700\u8981\u5718\u968a\u5408\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5408\u4f5c\u56f0\u4f4f\u6575\u4eba\u4e26\u66f4\u6709\u6548\u7387\u5730\u6536\u96c6\u6c34\u679c\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u55ae\u4eba\u6a21\u5f0f\uff1a\u500b\u4eba\u7b56\u7565\uff1b\u591a\u4eba\u6a21\u5f0f\uff1a\u5718\u968a\u5354\u8abf\u3002]"}]
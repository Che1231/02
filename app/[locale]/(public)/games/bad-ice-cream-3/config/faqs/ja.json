[{"question": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u7d20\u65e9\u304f\u7fd2\u5f97\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30a4\u30b9\u30b0\u30ea\u30c3\u30c9\u4e0a\u3067\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u3066\u3001\u6575\u3092\u6355\u307e\u3048\u305f\u308a\u3001\u901a\u8def\u3092\u4f5c\u3063\u305f\u308a\u3067\u304d\u308b\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u30d5\u30eb\u30fc\u30c4\u3092\u96c6\u3081\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u3092\u958b\u653e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u8d64\u3044\u6575\u3092\u6355\u307e\u3048\u3001\u3059\u3079\u3066\u306e\u30ea\u30f3\u30b4\u3092\u96c6\u3081\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\uff1a\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u3001\u6226\u5834\u3092\u6226\u7565\u7684\u306b\u652f\u914d\u3059\u308b\u305f\u3081\u306e\u58c1\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u5e38\u306b\u6575\u306e\u52d5\u304d\u3092\u6ce8\u610f\u6df1\u304f\u89b3\u5bdf\u3057\u3001\u305d\u306e\u884c\u52d5\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u5b89\u5168\u306a\u30a8\u30ea\u30a2\u3092\u4f5c\u308a\u3001\u8ffd\u3044\u8a70\u3081\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u6700\u521d\u306b\u3001\u5c4a\u304d\u306b\u304f\u3044\u30d5\u30eb\u30fc\u30c4\u3092\u512a\u5148\u7684\u306b\u96c6\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u6575\u304c\u8fd1\u3059\u304e\u3066\u3057\u307e\u3046\u524d\u306b\u3001\u53f3\u4e0a\u9685\u306b\u3042\u308b\u30d0\u30ca\u30ca\u3092\u96c6\u4e2d\u306b\u3057\u307e\u3057\u3087\u3046\u3002[\u6bd4\u8f03\uff1a\u521d\u671f\u30ec\u30d9\u30eb\u3067\u306f\u30b9\u30d4\u30fc\u30c9\u304c\u91cd\u8981\u3067\u3059\u304c\u3001\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5fcd\u8010\u529b\u3068\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u304c\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u7570\u306a\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u304c\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u7570\u306a\u308b\u306e\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d5\u30eb\u30fc\u30c4\u304c\u7570\u306a\u308b\u30dd\u30a4\u30f3\u30c8\u4fa1\u5024\u3092\u6301\u3063\u3066\u3044\u308b\u3053\u3068\u3001\u307e\u305f\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306b\u96a0\u3055\u308c\u305f\u30dc\u30fc\u30ca\u30b9\u304c\u3042\u308b\u305f\u3081\u3067\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u53ef\u80fd\u306a\u9650\u308a\u3001\u3044\u3061\u3054\u3084\u30d1\u30a4\u30ca\u30c3\u30d7\u30eb\u306a\u3069\u306e\u9ad8\u5f97\u70b9\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u6642\u9593\u3092\u6709\u52b9\u6d3b\u7528\u3057\u3001\u3059\u3070\u3084\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3066\u3001\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u5230\u9054\u3057\u306b\u304f\u3044\u5834\u6240\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u30d5\u30eb\u30fc\u30c4\u3092\u63a2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u306e\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u308c\u305f\u30b9\u30a4\u30ab\u304c\u3042\u308a\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8868\uff1a\u30d5\u30eb\u30fc\u30c4\u30dd\u30a4\u30f3\u30c8\uff1a\u30ea\u30f3\u30b4-10\u3001\u30d0\u30ca\u30ca-20\u3001\u30a4\u30c1\u30b4-50\u3001\u30b9\u30a4\u30ab-100\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3067\u3088\u308a\u5f37\u529b\u306a\u6575\u3092\u51fa\u3057\u629c\u304f\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3067\u3088\u308a\u5f37\u529b\u306a\u6575\u3092\u51fa\u3057\u629c\u304f\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u3001\u6575\u3092\u6df7\u4e71\u3055\u305b\u3001\u6355\u3089\u3048\u308b\u8ff7\u8def\u3092\u4f5c\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u6575\u3092\u30b3\u30fc\u30ca\u30fc\u306b\u8a98\u5c0e\u3057\u3066\u3001\u7c21\u5358\u306b\u5c01\u3058\u8fbc\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u6575\u304c\u8fd1\u3065\u304d\u305d\u3046\u306b\u306a\u3063\u305f\u76f4\u524d\u306b\u3001\u30d5\u30eb\u30fc\u30c4\u3092\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u96c6\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u30b8\u30b0\u30b6\u30b0\u578b\u306e\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f5c\u3063\u3066\u3001\u9752\u3044\u6575\u3092\u6355\u307e\u3048\u3089\u308c\u307e\u3059\u3002[\u56f3\uff1a\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u2192\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u2192\u6575\u306e\u6355\u7372\u2192\u30d5\u30eb\u30fc\u30c4\u306e\u53d6\u5f97\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308b\u8ab2\u984c\u3092\u63d0\u793a\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u65b0\u305f\u306a\u8ab2\u984c\u3092\u63d0\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u521d\u671f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3068\u30d5\u30eb\u30fc\u30c4\u306e\u53ce\u96c6\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u4e2d\u7d1a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u6575\u304c\u767b\u5834\u3057\u3001\u8907\u96d1\u306a\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u306e\u6226\u7565\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6575\u306e\u52d5\u304d\u304c\u901f\u304f\u306a\u308a\u3001\u96a0\u3055\u308c\u305f\u901a\u8def\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u6575\u306e\u8ff7\u8def\u3092\u9032\u3080\u305f\u3081\u306b\u3001\u6b63\u78ba\u306a\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u914d\u7f6e\u304c\u5fc5\u8981\u3067\u3059\u3002[\u4f8b\u3048\uff1a\u30ec\u30d9\u30eb\u3092\u3001\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u3088\u308a\u8907\u96d1\u306b\u306a\u308b\u30d1\u30ba\u30eb\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3067\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u3067\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u6709\u52b9\u6d3b\u7528\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u3067\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u653b\u6483\u7684\u306b\u3001\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u6575\u3092\u6355\u307e\u3048\u3001\u5c4a\u304d\u306b\u304f\u3044\u30d5\u30eb\u30fc\u30c4\u3078\u306e\u901a\u8def\u3092\u4f5c\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u9632\u5fa1\u7684\u306b\u3001\u6575\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306e\u58c1\u3092\u4f5c\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u6575\u3092\u6355\u307e\u3048\u3001\u5b89\u5168\u306b\u30d5\u30eb\u30fc\u30c4\u3092\u96c6\u3081\u308b\u3068\u3044\u3046\u4e21\u65b9\u306e\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb4\u3067\u306f\u3001\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u7dd1\u306e\u6575\u3092\u6355\u307e\u3048\u306a\u304c\u3089\u3001\u30c1\u30a7\u30ea\u30fc\u3092\u96c6\u3081\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u653b\u6483\u7684\u4f7f\u7528\uff1a\u6575\u3092\u6355\u7372\uff1b\u9632\u5fa1\u7684\u4f7f\u7528\uff1a\u5b89\u5168\u306a\u30a8\u30ea\u30a2\u306e\u4f5c\u6210\u3002]"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u304c\u30af\u30e9\u30a6\u30c9\u307e\u305f\u306f\u30ea\u30f3\u30af\u3055\u308c\u305f\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u4fdd\u5b58\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u30c7\u30d0\u30a4\u30b9\u304c\u30b2\u30fc\u30e0\u306e\u6700\u4f4e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306e\u64cd\u4f5c\u65b9\u6cd5\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u30bf\u30c3\u30c1\u64cd\u4f5c\u306b\u6163\u308c\u307e\u3059\u3002[\u8868\uff1a\u30c7\u30d0\u30a4\u30b9\u8981\u4ef6\uff1aPC - Windows 7\u4ee5\u4e0a\u3001\u30e2\u30d0\u30a4\u30eb - Android 5.0\u4ee5\u4e0a\u3001iOS 10.0\u4ee5\u4e0a\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u306f\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3068\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u73cd\u3057\u3044\u30d5\u30eb\u30fc\u30c4\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u63a2\u7d22\u3057\u3066\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30a2\u30c3\u30d7\u30eb\u306a\u3069\u306e\u96a0\u308c\u305f\u30d5\u30eb\u30fc\u30c4\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3057\u3066\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3001\u79d8\u5bc6\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u3001\u96a0\u3055\u308c\u305f\u901a\u8def\u3092\u958b\u793a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb8\u3067\u306f\u3001\u7279\u5b9a\u306e\u4f4d\u7f6e\u306b\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u7f6e\u304f\u3053\u3068\u3067\u3001\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u3078\u306e\u96a0\u3057\u901a\u8def\u304c\u73fe\u308c\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u3001\u5fb9\u5e95\u7684\u306a\u63a2\u7d22\u3092\u5831\u3044\u308b\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u6575\u306eAI\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u9069\u5fdc\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u5bfe\u6297\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u6575\u306eAI\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u3092\u5b66\u7fd2\u3057\u3001\u3088\u308a\u653b\u6483\u7684\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09AI\u3092\u6df7\u4e71\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u983b\u7e41\u306b\u52d5\u304d\u3092\u5909\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u30a2\u30a4\u30b9\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u4e88\u6e2c\u3067\u304d\u306a\u3044\u7d4c\u8def\u3092\u4f5c\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u52d5\u304d\u7d9a\u3051\u3001\u4e00\u3064\u306e\u5834\u6240\u306b\u9577\u304f\u3068\u3069\u307e\u308a\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb9\u3067\u306f\u3001\u540c\u3058\u6226\u7565\u3092\u7e70\u308a\u8fd4\u3059\u3068\u3001AI\u306f\u3042\u306a\u305f\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u59cb\u3081\u307e\u3059\u3002[\u56f3\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u2192AI\u306e\u4e88\u6e2c\u2192\u5bfe\u6297\u6226\u7565\u2192\u6575\u306e\u6355\u7372\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30a2\u30a4\u30b9\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e03\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u76ee\u7684\u3068\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u304c\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u500b\u3005\u306e\u30b9\u30ad\u30eb\u3068\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u5354\u529b\u3068\u7af6\u4e89\u7684\u306a\u8981\u7d20\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30ec\u30d9\u30eb\u306f\u901a\u5e38\u3001\u6575\u304c\u591a\u304f\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5354\u529b\u3057\u3066\u6575\u3092\u6355\u307e\u3048\u3001\u3088\u308a\u52b9\u7387\u7684\u306b\u30d5\u30eb\u30fc\u30c4\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\uff1a\u30bd\u30ed\u6226\u7565\uff1b\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\uff1a\u30c1\u30fc\u30e0\u9023\u643a\u3002]"}]
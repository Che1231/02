[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff09\u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\u4f60\u7684\u89d2\u8272\u5728\u51b0\u5757\u7f51\u683c\u4e0a\u3002\u6b65\u9aa42\uff09\u6309\u4e0b\u7a7a\u683c\u952e\u521b\u5efa\u51b0\u5757\uff0c\u53ef\u7528\u4e8e\u56f0\u4f4f\u654c\u4eba\u6216\u521b\u9020\u8def\u5f84\u3002\u6b65\u9aa43\uff09\u6536\u96c6\u6c34\u679c\u5f97\u5206\u5e76\u89e3\u9501\u65b0\u5173\u5361\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u51b0\u5757\u56f0\u4f4f\u7ea2\u8272\u654c\u4eba\u5e76\u6536\u96c6\u6240\u6709\u82f9\u679c\u3002 [\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u51b0\u5757\u5c31\u50cf\u4f60\u53ef\u4ee5\u7528\u6765\u6218\u7565\u6027\u63a7\u5236\u6218\u573a\u7684\u5899\u58c1\u3002]"}, {"question": "\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u7684\u9ad8\u7ea7\u5173\u5361\u4e2d\uff0c\u751f\u5b58\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u7684\u9ad8\u7ea7\u5173\u5361\u4e2d\u751f\u5b58\u9700\u8981\u6218\u7565\u89c4\u5212\uff1a\u6b65\u9aa41\uff09\u65f6\u523b\u5173\u6ce8\u654c\u4eba\u7684\u79fb\u52a8\u6a21\u5f0f\u5e76\u9884\u6d4b\u4ed6\u4eec\u7684\u8def\u5f84\u3002\u6b65\u9aa42\uff09\u4f7f\u7528\u51b0\u5757\u521b\u5efa\u5b89\u5168\u533a\u57df\u5e76\u907f\u514d\u88ab\u903c\u5230\u89d2\u843d\u3002\u6b65\u9aa43\uff09\u4f18\u5148\u6536\u96c6\u8f83\u96be\u83b7\u53d6\u7684\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u5173\u5361\u4e2d\uff0c\u5728\u654c\u4eba\u9760\u8fd1\u4e4b\u524d\uff0c\u5148\u96c6\u4e2d\u7cbe\u529b\u6536\u96c6\u53f3\u4e0a\u89d2\u7684\u9999\u8549\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0e\u65e9\u671f\u5173\u5361\u4ee5\u901f\u5ea6\u4e3a\u5173\u952e\u4e0d\u540c\uff0c\u9ad8\u7ea7\u5173\u5361\u9700\u8981\u8010\u5fc3\u548c\u7cbe\u786e\u7684\u65f6\u673a\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u4f1a\u56e0\u5173\u5361\u800c\u5f02\uff0c\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u56e0\u5173\u5361\u800c\u5f02\uff0c\u8fd9\u662f\u56e0\u4e3a\u4e0d\u540c\u7684\u6c34\u679c\u5177\u6709\u4e0d\u540c\u7684\u5206\u6570\u503c\uff0c\u5e76\u4e14\u67d0\u4e9b\u5173\u5361\u6709\u9690\u85cf\u7684\u5956\u52b1\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff1a\u6b65\u9aa41\uff09\u5c3d\u53ef\u80fd\u591a\u5730\u6536\u96c6\u9ad8\u4ef7\u503c\u6c34\u679c\uff0c\u4f8b\u5982\u8349\u8393\u548c\u83e0\u841d\u3002\u6b65\u9aa42\uff09\u5feb\u901f\u5b8c\u6210\u5173\u5361\u4ee5\u83b7\u5f97\u65f6\u95f4\u5956\u52b1\u3002\u6b65\u9aa43\uff09\u5bfb\u627e\u9690\u85cf\u5728\u96be\u4ee5\u5230\u8fbe\u533a\u57df\u7684\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\u5173\u5361\u4e2d\uff0c\u5899\u540e\u9690\u85cf\u7740\u4e00\u4e2a\u897f\u74dc\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5f97\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6c34\u679c\u5206\u6570\uff1a\u82f9\u679c - 10 \u5206\uff0c\u9999\u8549 - 20 \u5206\uff0c\u8349\u8393 - 50 \u5206\uff0c\u897f\u74dc - 100 \u5206\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u6765\u667a\u53d6\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u66f4\u5f3a\u5927\u7684\u654c\u4eba\uff1f", "answer": "\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u667a\u53d6\u66f4\u5f3a\u5927\u7684\u654c\u4eba\uff0c\u9ad8\u7ea7\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9aa41\uff09\u4f7f\u7528\u51b0\u5757\u521b\u9020\u8ff7\u5bab\uff0c\u4f7f\u654c\u4eba\u611f\u5230\u56f0\u60d1\u5e76\u5c06\u5176\u56f0\u4f4f\u3002\u6b65\u9aa42\uff09\u5f15\u8bf1\u654c\u4eba\u8fdb\u5165\u89d2\u843d\uff0c\u5728\u90a3\u91cc\u53ef\u4ee5\u8f7b\u677e\u63a7\u5236\u4ed6\u4eec\u3002\u6b65\u9aa43\uff09\u5728\u654c\u4eba\u9760\u8fd1\u4e4b\u524d\u53ca\u65f6\u79fb\u52a8\u6765\u6536\u96c6\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u57287\u7ea7\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u521b\u5efa\u952f\u9f7f\u5f62\u51b0\u5757\u56fe\u6848\u6765\u56f0\u4f4f\u84dd\u8272\u7684\u654c\u4eba\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u79fb\u52a8\u6a21\u5f0f\uff1a\u73a9\u5bb6\u2192\u51b0\u5757\u2192\u654c\u4eba\u88ab\u56f0\u4f4f\u2192\u6536\u96c6\u6c34\u679c\u3002]"}, {"question": "\u968f\u7740\u73a9\u5bb6\u7684\u8fdb\u6b65\uff0c\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u5173\u5361\u8bbe\u8ba1\u662f\u5982\u4f55\u6311\u6218\u73a9\u5bb6\u7684\uff1f", "answer": "\u968f\u7740\u73a9\u5bb6\u7684\u8fdb\u6b65\uff0c\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u5173\u5361\u8bbe\u8ba1\u4f1a\u5f15\u5165\u65b0\u7684\u6311\u6218\uff1a\u6b65\u9aa41\uff09\u65e9\u671f\u5173\u5361\u4fa7\u91cd\u4e8e\u57fa\u672c\u79fb\u52a8\u548c\u6c34\u679c\u6536\u96c6\u3002\u6b65\u9aa42\uff09\u4e2d\u671f\u5173\u5361\u5f15\u5165\u4e86\u66f4\u591a\u654c\u4eba\u548c\u590d\u6742\u7684\u51b0\u5757\u7b56\u7565\u3002\u6b65\u9aa43\uff09\u9ad8\u7ea7\u5173\u5361\u7684\u654c\u4eba\u66f4\u5feb\uff0c\u5e76\u4e14\u6709\u9690\u85cf\u7684\u8def\u5f84\u3002\u4f8b\u5982\uff0c10\u7ea7\u5173\u5361\u9700\u8981\u7cbe\u786e\u7684\u51b0\u5757\u6446\u653e\uff0c\u624d\u80fd\u5728\u654c\u4eba\u7684\u8ff7\u5bab\u4e2d\u7a7f\u884c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5173\u5361\u60f3\u8c61\u6210\u4e00\u4e2a\u968f\u7740\u4f60\u7684\u8fdb\u6b65\u800c\u53d8\u5f97\u8d8a\u6765\u8d8a\u590d\u6742\u7684\u8c1c\u9898\u3002]"}, {"question": "\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u5730\u5229\u7528\u51b0\u5757\u8fdb\u884c\u653b\u9632\u4e24\u7aef\uff1f", "answer": "\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\uff0c\u51b0\u5757\u53ef\u4ee5\u6709\u6548\u5730\u7528\u4e8e\u653b\u9632\u4e24\u7aef\uff1a\u6b65\u9aa41\uff09\u8fdb\u653b\u65b9\u9762\uff0c\u4f7f\u7528\u51b0\u5757\u6765\u56f0\u4f4f\u654c\u4eba\uff0c\u5e76\u521b\u5efa\u901a\u5f80\u96be\u4ee5\u89e6\u53ca\u6c34\u679c\u7684\u8def\u5f84\u3002\u6b65\u9aa42\uff09\u9632\u5fa1\u65b9\u9762\uff0c\u521b\u5efa\u5c4f\u969c\u6765\u4fdd\u62a4\u81ea\u5df1\u514d\u53d7\u654c\u4eba\u653b\u51fb\u3002\u6b65\u9aa43\uff09\u901a\u8fc7\u56f0\u4f4f\u654c\u4eba\u5e76\u7136\u540e\u5b89\u5168\u5730\u6536\u96c6\u6c34\u679c\u6765\u7ed3\u5408\u8fd9\u4e24\u79cd\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u57284\u7ea7\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u51b0\u5757\u56f0\u4f4f\u7eff\u8272\u654c\u4eba\uff0c\u540c\u65f6\u6536\u96c6\u6a31\u6843\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8fdb\u653b\u7528\u9014\uff1a\u56f0\u4f4f\u654c\u4eba\uff1b\u9632\u5fa1\u7528\u9014\uff1a\u521b\u5efa\u5b89\u5168\u533a\u57df\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u5e73\u6ed1\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u5e73\u6ed1\u7684\u6e38\u620f\u4f53\u9a8c\uff1a\u6b65\u9aa41\uff09\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u5df2\u4fdd\u5b58\u5230\u4e91\u7aef\u6216\u94fe\u63a5\u8d26\u6237\u3002\u6b65\u9aa42\uff09\u68c0\u67e5\u8bbe\u5907\u662f\u5426\u7b26\u5408\u6e38\u620f\u7684\u6700\u4f4e\u7cfb\u7edf\u8981\u6c42\u3002\u6b65\u9aa43\uff09\u719f\u6089\u65b0\u8bbe\u5907\u4e0a\u7684\u63a7\u5236\u65b9\u6848\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ecePC\u79fb\u52a8\u5230\u624b\u673a\uff0c\u8bf7\u901a\u8fc7\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\u6765\u9002\u5e94\u89e6\u63a7\u63a7\u5236\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8bbe\u5907\u8981\u6c42\uff1aPC - Windows 7+\uff0c\u624b\u673a - Android 5.0+\uff0ciOS 10.0+\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u5305\u62ec\u79d8\u5bc6\u5173\u5361\u548c\u7a00\u6709\u6c34\u679c\uff0c\u80fd\u591f\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1a\u6b65\u9aa41\uff09\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u4ee5\u627e\u5230\u9690\u85cf\u7684\u6c34\u679c\uff0c\u4f8b\u5982\u9ec4\u91d1\u82f9\u679c\u3002\u6b65\u9aa42\uff09\u5728\u7279\u5b9a\u6761\u4ef6\u4e0b\u5b8c\u6210\u67d0\u4e9b\u5173\u5361\uff0c\u4ee5\u89e3\u9501\u79d8\u5bc6\u5173\u5361\u3002\u6b65\u9aa43\uff09\u4f7f\u7528\u51b0\u5757\u6765\u63ed\u793a\u9690\u85cf\u8def\u5f84\u3002\u4f8b\u5982\uff0c\u57288\u7ea7\u5173\u5361\u4e2d\uff0c\u5728\u7279\u5b9a\u4f4d\u7f6e\u653e\u7f6e\u4e00\u4e2a\u51b0\u5757\uff0c\u4f1a\u63ed\u793a\u901a\u5f80\u5956\u52b1\u5173\u5361\u7684\u9690\u85cf\u901a\u9053\u3002 [\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u9690\u85cf\u5185\u5bb9\u89c6\u4e3a\u5956\u52b1\u4ed4\u7ec6\u63a2\u7d22\u7684\u5f69\u86cb\u3002]"}, {"question": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u654c\u4ebaAI\u5982\u4f55\u9002\u5e94\u73a9\u5bb6\u7684\u7b56\u7565\uff0c\u73a9\u5bb6\u53c8\u80fd\u505a\u4e9b\u4ec0\u4e48\u6765\u53cd\u5236\uff1f", "answer": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u654c\u4ebaAI\u4f1a\u901a\u8fc7\u5b66\u4e60\u73a9\u5bb6\u7684\u79fb\u52a8\u6a21\u5f0f\u5e76\u53d8\u5f97\u66f4\u5177\u653b\u51fb\u6027\u6765\u9002\u5e94\uff1a\u6b65\u9aa41\uff09\u9891\u7e41\u6539\u53d8\u4f60\u7684\u79fb\u52a8\u6a21\u5f0f\u4ee5\u8ff7\u60d1AI\u3002\u6b65\u9aa42\uff09\u4f7f\u7528\u51b0\u5757\u6765\u521b\u9020\u4e0d\u53ef\u9884\u6d4b\u7684\u8def\u5f84\u3002\u6b65\u9aa43\uff09\u4fdd\u6301\u79fb\u52a8\uff0c\u907f\u514d\u957f\u65f6\u95f4\u505c\u7559\u5728\u4e00\u4e2a\u533a\u57df\u3002\u4f8b\u5982\uff0c\u57289\u7ea7\u5173\u5361\u4e2d\uff0c\u5982\u679c\u4f60\u53cd\u590d\u4f7f\u7528\u76f8\u540c\u7684\u7b56\u7565\uff0cAI\u5c31\u4f1a\u5f00\u59cb\u9884\u6d4b\u4f60\u7684\u52a8\u4f5c\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u73a9\u5bb6\u79fb\u52a8\u2192AI\u9884\u6d4b\u2192\u53cd\u5236\u7b56\u7565\u2192\u56f0\u4f4f\u654c\u4eba\u3002]"}, {"question": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u533a\u522b\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u300a\u574f\u51b0\u6dc7\u6dcb3\u300b\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u76ee\u6807\u548c\u52a8\u6001\u65b9\u9762\u6709\u6240\u4e0d\u540c\uff1a\u6b65\u9aa41\uff09\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u4e2a\u4eba\u6280\u80fd\u548c\u7b56\u7565\u3002\u6b65\u9aa42\uff09\u591a\u4eba\u6a21\u5f0f\u5f15\u5165\u4e86\u5408\u4f5c\u548c\u7ade\u4e89\u5143\u7d20\u3002\u6b65\u9aa43\uff09\u591a\u4eba\u5173\u5361\u901a\u5e38\u6709\u66f4\u591a\u7684\u654c\u4eba\uff0c\u9700\u8981\u56e2\u961f\u5408\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\uff0c\u73a9\u5bb6\u53ef\u4ee5\u534f\u540c\u5408\u4f5c\u6765\u56f0\u4f4f\u654c\u4eba\u5e76\u66f4\u9ad8\u6548\u5730\u6536\u96c6\u6c34\u679c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\uff1a\u5355\u4eba\u7b56\u7565\uff1b\u591a\u4eba\u6a21\u5f0f\uff1a\u56e2\u961f\u534f\u8c03\u3002]"}]
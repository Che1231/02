[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1) \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc544\uc774\uc2a4 \uadf8\ub9ac\ub4dc \uc704\uc5d0\uc11c \uc774\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4. STEP2) \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \ub9cc\ub4e4\uc5b4 \uc801\uc744 \uac00\ub450\uac70\ub098 \uacbd\ub85c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. STEP3) \uacfc\uc77c\uc744 \uc218\uc9d1\ud558\uc5ec \uc810\uc218\ub97c \uc5bb\uace0 \uc0c8\ub85c\uc6b4 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 1\uc5d0\uc11c \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube68\uac04\uc0c9 \uc801\uc744 \uac00\ub450\uace0 \ubaa8\ub4e0 \uc0ac\uacfc\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc804\uc7a5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc81c\uc5b4\ud560 \uc218 \uc788\ub294 \ubcbd\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1) \ud56d\uc0c1 \uc801\uc758 \uc774\ub3d9 \ud328\ud134\uc744 \uc8fc\uc2dc\ud558\uace0 \uadf8\ub4e4\uc758 \uacbd\ub85c\ub97c \uc608\uce21\ud558\uc138\uc694. STEP2) \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc548\uc804 \uad6c\uc5ed\uc744 \ub9cc\ub4e4\uace0 \uad81\uc9c0\uc5d0 \ubab0\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc138\uc694. STEP3) \uba3c\uc800 \ub2ff\uae30 \uc5b4\ub824\uc6b4 \uacfc\uc77c\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c\ub294 \uc801\uc774 \ub108\ubb34 \uac00\uae4c\uc6cc\uc9c0\uae30 \uc804\uc5d0 \uc624\ub978\ucabd \uc0c1\ub2e8 \ucf54\ub108\uc758 \ubc14\ub098\ub098\ub97c \ubaa8\uc73c\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \uc811\uadfc \ubc29\uc2dd \ube44\uad50: \ucd08\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uc18d\ub3c4\uac00 \uc911\uc694\ud558\uc9c0\ub9cc, \uace0\uae09 \ub808\ubca8\uc5d0\uc11c\ub294 \uc778\ub0b4\uc640 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \ub808\ubca8\ub9c8\ub2e4 \ub2e4\ub978 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \ub808\ubca8\ub9c8\ub2e4 \ub2e4\ub978 \uc774\uc720\ub294 \uc11c\ub85c \ub2e4\ub978 \uacfc\uc77c\uc774 \ub2e4\ub978 \uc810\uc218\ub97c \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \uc228\uaca8\uc9c4 \ubcf4\ub108\uc2a4\uac00 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694. STEP1) \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \uace0\uac00\uce58 \uacfc\uc77c(\ub538\uae30, \ud30c\uc778\uc560\ud50c \ub4f1)\uc744 \uc218\uc9d1\ud558\uc138\uc694. STEP2) \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uc5ec \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc73c\uc138\uc694. STEP3) \ub2ff\uae30 \uc5b4\ub824\uc6b4 \uacf3\uc5d0 \uc788\ub294 \uc228\uaca8\uc9c4 \uacfc\uc77c\uc744 \ucc3e\uc544\ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3\uc5d0\uc11c\ub294 \uc544\uc774\uc2a4 \ube14\ub85d \ubcbd \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc218\ubc15\uc774 \uc788\uc5b4 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uacfc\uc77c \uc810\uc218: \uc0ac\uacfc - 10, \ubc14\ub098\ub098 - 20, \ub538\uae30 - 50, \uc218\ubc15 - 100.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \ub354 \uac15\ub825\ud55c \uc801\uc744 \uc18d\uc774\uae30 \uc704\ud574 \ud50c\ub808\uc774\uc5b4\uac00 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \ub354 \uac15\ub825\ud55c \uc801\uc744 \uc18d\uc774\uae30 \uc704\ud55c \uace0\uae09 \uae30\uc220\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1) \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \ud63c\ub780\uc2a4\ub7fd\uac8c \ud558\uace0 \uac00\ub450\ub294 \ubbf8\ub85c\ub97c \ub9cc\ub4dc\uc138\uc694. STEP2) \uc801\uc744 \uc27d\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\ub294 \ubaa8\uc11c\ub9ac\ub85c \uc720\uc778\ud558\uc138\uc694. STEP3) \uc801\uc774 \ub2e4\uac00\uc624\uae30 \uc9c1\uc804\uc5d0 \uacfc\uc77c\uc744 \uc218\uc9d1\ud558\uae30 \uc704\ud574 \ub3d9\uc791\uc744 \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\uc11c\ub294 \ud30c\ub780\uc0c9 \uc801\uc744 \uc544\uc774\uc2a4 \ube14\ub85d\uc758 \uc9c0\uadf8\uc7ac\uadf8 \ud328\ud134\uc744 \ub9cc\ub4e4\uc5b4 \uac00\ub458 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\ub3d9 \ud328\ud134: \ud50c\ub808\uc774\uc5b4 \u2192 \uc544\uc774\uc2a4 \ube14\ub85d \u2192 \uc801 \uac00\ub450\uae30 \u2192 \uacfc\uc77c \uc218\uc9d1.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \ub2e4\ub978 \ub3c4\uc804\uc744 \uc81c\uc2dc\ud569\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uc0c8\ub85c\uc6b4 \ub3c4\uc804\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4. STEP1) \ucd08\ubc18 \ub808\ubca8\uc740 \uae30\ubcf8\uc801\uc778 \uc774\ub3d9 \ubc0f \uacfc\uc77c \uc218\uc9d1\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. STEP2) \uc911\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \ub354 \ub9ce\uc740 \uc801\uacfc \ubcf5\uc7a1\ud55c \uc544\uc774\uc2a4 \ube14\ub85d \uc804\ub7b5\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. STEP3) \uace0\uae09 \ub808\ubca8\uc5d0\uc11c\ub294 \uc801\uc758 \uc774\ub3d9 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\uace0 \uc228\uaca8\uc9c4 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c\ub294 \uc801\uc758 \ubbf8\ub85c\ub97c \ud5e4\uccd0\ub098\uac00\uae30 \uc704\ud574 \uc815\ud655\ud55c \uc544\uc774\uc2a4 \ube14\ub85d \ubc30\uce58\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub808\ubca8\uc744 \uc9c4\ud589\ud560\uc218\ub85d \ub354\uc6b1 \ubcf5\uc7a1\ud574\uc9c0\ub294 \ud37c\uc990\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \uacf5\uaca9\uacfc \ubc29\uc5b4 \ubaa8\ub450\uc5d0 \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \uc544\uc774\uc2a4 \ube14\ub85d\uc740 \uacf5\uaca9\uacfc \ubc29\uc5b4 \ubaa8\ub450\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1) \uacf5\uaca9\uc801\uc73c\ub85c, \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \uac00\ub450\uace0 \ub2ff\uae30 \uc5b4\ub824\uc6b4 \uacfc\uc77c\ub85c \uac00\ub294 \uae38\uc744 \ub9cc\ub4dc\uc138\uc694. STEP2) \ubc29\uc5b4\uc801\uc73c\ub85c, \ub4e4\uc5b4\uc624\ub294 \uc801\uc744 \ub9c9\uae30 \uc704\ud55c \uc7a5\ubcbd\uc744 \ub9cc\ub4dc\uc138\uc694. STEP3) \uc801\uc744 \uac00\ub450\uace0 \uc548\uc804\ud558\uac8c \uacfc\uc77c\uc744 \uc218\uc9d1\ud558\uc5ec \ub450 \uac00\uc9c0 \uc804\ub7b5\uc744 \uacb0\ud569\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 4\uc5d0\uc11c\ub294 \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub179\uc0c9 \uc801\uc744 \uac00\ub450\uace0 \ub538\uae30\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc811\uadfc \ubc29\uc2dd \ube44\uad50: \uacf5\uaca9\uc801 \uc0ac\uc6a9: \uc801 \uac00\ub450\uae30; \ubc29\uc5b4\uc801 \uc0ac\uc6a9: \uc548\uc804 \uad6c\uc5ed \uc0dd\uc131.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30 \uac04 \uc804\ud658 \uc2dc \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30 \uac04 \uc804\ud658 \uc2dc \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694. STEP1) \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud074\ub77c\uc6b0\ub4dc \ub610\ub294 \uc5f0\uacb0\ub41c \uacc4\uc815\uc5d0 \uc800\uc7a5\ud558\uc138\uc694. STEP2) \uae30\uae30\uac00 \uac8c\uc784\uc758 \ucd5c\uc18c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP3) \uc0c8 \uae30\uae30\uc758 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uc744 \uc219\uc9c0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ucd08\ubc18 \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud130\uce58 \ucee8\ud2b8\ub864\uc5d0 \uc801\uc751\ud558\uc138\uc694. [\uc124\uc815 \ub300\uc870\ud45c: \uae30\uae30 \uc694\uad6c \uc0ac\ud56d: PC - Windows 7 \uc774\uc0c1, \ubaa8\ubc14\uc77c - Android 5.0 \uc774\uc0c1, iOS 10.0 \uc774\uc0c1.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \uacbd\ud5d8\uc740 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc5d0\ub294 \ube44\ubc00 \ub808\ubca8\uacfc \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud76c\uadc0 \uacfc\uc77c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1) \ub9f5\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uc5ec \uae08\uc0c9 \uc0ac\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uacfc\uc77c\uc744 \ucc3e\uc73c\uc138\uc694. STEP2) \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud558\uc5ec \ud2b9\uc815 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \ube44\ubc00 \ub2e8\uacc4\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4. STEP3) \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ub4dc\ub7ec\ub0b4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 8\uc5d0\uc11c\ub294 \ud2b9\uc815 \uc704\uce58\uc5d0 \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \ub9cc\ub4e4\uba74 \ubcf4\ub108\uc2a4 \ub808\ubca8\ub85c \ud1b5\ud558\ub294 \uc228\uaca8\uc9c4 \ud1b5\ub85c\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ucca0\uc800\ud55c \ud0d0\ud5d8\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc73c\ub85c \uc5ec\uae30\uc138\uc694.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc801 AI\ub294 \ud50c\ub808\uc774\uc5b4 \uc804\ub7b5\uc5d0 \uc5b4\ub5bb\uac8c \uc801\uc751\ud558\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub300\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc801 AI\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc774\ub3d9 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uace0 \ub354 \uacf5\uaca9\uc801\uc73c\ub85c \ubcc0\ud654\ud568\uc73c\ub85c\uc368 \uc801\uc751\ud569\ub2c8\ub2e4. STEP1) AI\ub97c \ud63c\ub780\uc2a4\ub7fd\uac8c \ud558\ub824\uba74 \uc774\ub3d9 \ud328\ud134\uc744 \uc790\uc8fc \ubc14\uafb8\uc138\uc694. STEP2) \uc544\uc774\uc2a4 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uacbd\ub85c\ub97c \ub9cc\ub4dc\uc138\uc694. STEP3) \uacc4\uc18d \uc6c0\uc9c1\uc774\uace0 \ud55c \uacf3\uc5d0 \ub108\ubb34 \uc624\ub798 \uba38\ubb3c\uc9c0 \ub9c8\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 9\uc5d0\uc11c\ub294 \uac19\uc740 \uc804\ub7b5\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 AI\uac00 \ud50c\ub808\uc774\uc5b4\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uae30 \uc2dc\uc791\ud560 \uac83\uc785\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud50c\ub808\uc774\uc5b4 \uc774\ub3d9 \u2192 AI \uc608\uce21 \u2192 \ub300\uc751 \uc804\ub7b5 \u2192 \uc801 \uac00\ub450\uae30.]"}, {"question": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uac13 \uc544\uc774\uc2a4\ud06c\ub9bc 3\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ubaa9\ud45c\uc640 \uc5ed\ud559\uc774 \ub2e4\ub985\ub2c8\ub2e4. STEP1) \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\ub294 \uac1c\uc778\uc801\uc778 \uae30\uc220\uacfc \uc804\ub7b5\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. STEP2) \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \ud611\ub825\uc801\uc774\uace0 \uacbd\uc7c1\uc801\uc778 \uc694\uc18c\ub97c \ub3c4\uc785\ud569\ub2c8\ub2e4. STEP3) \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ub808\ubca8\uc5d0\ub294 \uc885\uc885 \uc801\uc774 \ub354 \ub9ce\uc73c\uba70 \ud300\uc6cc\ud06c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud611\ub825\ud558\uc5ec \uc801\uc744 \uac00\ub450\uace0 \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uacfc\uc77c\uc744 \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc811\uadfc \ubc29\uc2dd \ube44\uad50: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4: \uc194\ub85c \uc804\ub7b5; \uba40\ud2f0\ud50c\ub808\uc774\uc5b4: \ud300 \ud611\ub825.]"}]
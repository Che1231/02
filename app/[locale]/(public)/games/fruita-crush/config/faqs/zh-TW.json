[{"question": "\u5982\u4f55\u4f5c\u70ba\u65b0\u624b\u5b8c\u6210\u6c34\u679c\u6d3e\u5c0d\u7684\u7b2c\u4e00\u95dc\uff1f", "answer": "\u8981\u5b8c\u6210\u6c34\u679c\u6d3e\u5c0d\u7684\u7b2c\u4e00\u95dc\uff0c\u91cd\u9ede\u5728\u65bc\u9023\u7e8c\u914d\u5c0d\u4e09\u500b\u76f8\u540c\u7684\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u914d\u5c0d\u4e09\u500b\u860b\u679c\uff0c\u5373\u53ef\u5c07\u5b83\u5011\u5f9e\u76e4\u9762\u4e0a\u6e05\u9664\u3002\u6b65\u9a5f\u4e00\uff1a\u6383\u63cf\u76e4\u9762\u5c0b\u627e\u5bb9\u6613\u914d\u5c0d\u7684\u6c34\u679c\u3002\u6b65\u9a5f\u4e8c\uff1a\u512a\u5148\u914d\u5c0d\u76e4\u9762\u5e95\u90e8\u7684\u6c34\u679c\uff0c\u5f15\u767c\u9023\u9396\u53cd\u61c9\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u5269\u4e0b\u7684\u52d5\u4f5c\u6e05\u9664\u4efb\u4f55\u5269\u9918\u7684\u6c34\u679c\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u6709\u6548\u5229\u7528\u52d5\u4f5c\uff0c\u4e26\u5e6b\u52a9\u4f60\u9806\u5229\u9032\u5c55\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u758a\u7a4d\u6728\uff1b\u4f60\u6e05\u9664\u5e95\u90e8\u7684\u7a4d\u6728\u8d8a\u591a\uff0c\u4e0a\u9762\u5c31\u8d8a\u6709\u53ef\u80fd\u51fa\u73fe\u66f4\u591a\u6a5f\u6703\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6c34\u679c\u6d3e\u5c0d\u7684\u4e00\u4e9b\u95dc\u5361\u6709\u7279\u6b8a\u7684\u969c\u7919\u7269\uff0c\u4ee5\u53ca\u5982\u4f55\u514b\u670d\u5b83\u5011\uff1f", "answer": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u7684\u7279\u6b8a\u969c\u7919\u7269\uff0c\u4f8b\u5982\u51b0\u584a\u6216\u9396\u4f4f\u7684\u6c34\u679c\uff0c\u589e\u52a0\u4e86\u96e3\u5ea6\uff0c\u9700\u8981\u7b56\u7565\u601d\u8003\u3002\u4f8b\u5982\uff0c\u8981\u6253\u7834\u51b0\u584a\uff0c\u5247\u9700\u8981\u914d\u5c0d\u8207\u5176\u76f8\u9130\u7684\u6c34\u679c\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u8a8d\u969c\u7919\u7269\u7684\u985e\u578b\u3002\u6b65\u9a5f\u4e8c\uff1a\u8a08\u5283\u5728\u969c\u7919\u7269\u9644\u8fd1\u9032\u884c\u914d\u5c0d\u3002\u6b65\u9a5f\u4e09\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u4f7f\u7528\u9053\u5177\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u96d6\u7136\u5728\u51b0\u584a\u9644\u8fd1\u914d\u5c0d\u6709\u6548\uff0c\u4f46\u4f7f\u7528\u70b8\u5f48\u9053\u5177\u53ef\u4ee5\u4e00\u6b21\u6e05\u9664\u591a\u500b\u969c\u7919\u7269\uff0c\u70ba\u66f4\u8271\u96e3\u7684\u6311\u6230\u7bc0\u7701\u52d5\u4f5c\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u597d\u7528\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u555f\u52d5\u5b83\u5011\uff1f", "answer": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u6700\u597d\u7684\u9053\u5177\u5305\u62ec\u70b8\u5f48\u548c\u5f69\u8679\u6c34\u679c\u3002\u7576\u6709\u591a\u500b\u969c\u7919\u7269\u805a\u96c6\u5728\u4e00\u8d77\u6642\uff0c\u555f\u52d5\u70b8\u5f48\u9053\u5177\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5b83\u4f86\u6e05\u9664\u4e00\u7fa4\u51b0\u584a\u3002\u5f69\u8679\u6c34\u679c\u975e\u5e38\u9069\u5408\u6e05\u9664\u6240\u6709\u4e00\u7a2e\u985e\u578b\u7684\u6c34\u679c\uff0c\u5c24\u5176\u662f\u5728\u76e4\u9762\u96dc\u4e82\u7121\u7ae0\u6642\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u70b8\u5f48 - \u6e05\u9664 3x3 \u5340\u57df\uff1b\u5f69\u8679\u6c34\u679c - \u6e05\u9664\u6240\u6709\u9078\u5b9a\u985e\u578b\u7684\u6c34\u679c\u3002]"}, {"question": "\u5982\u4f55\u5728\u6c34\u679c\u6d3e\u5c0d\u7684\u9650\u6642\u95dc\u5361\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u8981\u5728\u9650\u6642\u95dc\u5361\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u91cd\u9ede\u5728\u65bc\u5275\u9020\u9023\u9396\u53cd\u61c9\u3002\u4f8b\u5982\uff0c\u914d\u5c0d\u56db\u500b\u6c34\u679c\u4ee5\u5275\u9020\u4e00\u6b21\u6e05\u9664\u7dda\u7684\u9053\u5177\uff0c\u7136\u5f8c\u4f7f\u7528\u5b83\u4f86\u5f15\u767c\u9023\u9396\u53cd\u61c9\u3002\u6b65\u9a5f\u4e00\uff1a\u5c0b\u627e\u53ef\u80fd\u7522\u751f\u9053\u5177\u7684\u914d\u5c0d\u7d44\u5408\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u6c34\u679c\u6700\u591a\u7684\u5340\u57df\u555f\u52d5\u9053\u5177\u3002\u6b65\u9a5f\u4e09\uff1a\u8fc5\u901f\u7e7c\u7e8c\u914d\u5c0d\u4ee5\u7dad\u6301\u52d5\u80fd\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5176\u8996\u70ba\u591a\u7c73\u8afe\u9aa8\u724c\u6548\u61c9\uff1b\u6bcf\u500b\u52d5\u4f5c\u90fd\u61c9\u8a72\u70ba\u4e0b\u4e00\u500b\u52d5\u4f5c\u505a\u597d\u6e96\u5099\uff0c\u4ee5\u7372\u5f97\u6700\u5927\u7684\u5f71\u97ff\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u6700\u9069\u5408\u5728\u6c34\u679c\u6d3e\u5c0d\u7684\u9ad8\u96e3\u5ea6\u95dc\u5361\u4e2d\u6e05\u9664\u6311\u6230\uff1f", "answer": "\u5728\u6c34\u679c\u6d3e\u5c0d\u7684\u9ad8\u96e3\u5ea6\u95dc\u5361\u4e2d\uff0c\u512a\u5148\u8003\u616e\u76e1\u65e9\u6e05\u9664\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u500b\u6709\u591a\u500b\u88ab\u9396\u4f4f\u7684\u6c34\u679c\u7684\u95dc\u5361\u4e2d\uff0c\u9996\u5148\u96c6\u4e2d\u7cbe\u529b\u89e3\u9396\u5b83\u5011\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u6790\u76e4\u9762\uff0c\u8b58\u5225\u95dc\u9375\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e8c\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u4f86\u6e05\u9664\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u6700\u5f8c\u7684\u6e05\u7406\u968e\u6bb5\u5132\u5b58\u52d5\u4f5c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u96d6\u7136\u91cd\u9ede\u653e\u5728\u969c\u7919\u7269\u4e0a\u81f3\u95dc\u91cd\u8981\uff0c\u4f46\u5728\u6c34\u679c\u548c\u969c\u7919\u7269\u4e4b\u9593\u5e73\u8861\u52d5\u4f5c\uff0c\u78ba\u4fdd\u7a69\u5b9a\u9032\u5c55\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u7d44\u5408\u7cfb\u7d71\u7684\u89d2\u8272\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u89f8\u767c\u5b83\uff1f", "answer": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u7684\u7d44\u5408\u7cfb\u7d71\u6703\u5c07\u9023\u7e8c\u914d\u5c0d\u7684\u5206\u6578\u76f8\u4e58\u3002\u70ba\u6709\u6548\u89f8\u767c\u5b83\uff0c\u76ee\u6a19\u662f\u9023\u9396\u914d\u5c0d\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u76e4\u9762\u5e95\u90e8\u7684\u6c34\u679c\u7fa4\uff0c\u5c0e\u81f4\u4e0a\u9762\u7684\u6c34\u679c\u6389\u843d\u4e26\u7522\u751f\u65b0\u7684\u914d\u5c0d\u7d44\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u898f\u5283\u5c07\u5c0e\u81f4\u9023\u9396\u53cd\u61c9\u7684\u914d\u5c0d\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u9053\u5177\u4f86\u5ef6\u9577\u7d44\u5408\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u76e4\u9762\u6d3b\u8e8d\u4ee5\u6700\u5927\u5316\u7d44\u5408\u6f5b\u529b\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6e05\u9664\u5e95\u90e8\u7684\u6c34\u679c\u2192\u9023\u9396\u914d\u5c0d\u2192\u7d44\u5408\u500d\u6578\u555f\u52d5\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5c0d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u4e0d\u540c\u52d5\u4f5c\u7684\u5f97\u5206\uff1f", "answer": "\u6c34\u679c\u6d3e\u5c0d\u7684\u8a08\u5206\u7cfb\u7d71\u6839\u64da\u914d\u5c0d\u7684\u6c34\u679c\u6578\u91cf\u548c\u914d\u5c0d\u985e\u578b\u4f86\u9812\u767c\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u914d\u5c0d\u4e09\u500b\u6c34\u679c\u7372\u5f97 100 \u5206\uff0c\u800c\u914d\u5c0d\u56db\u500b\u6c34\u679c\u5247\u7372\u5f97 200 \u5206\u3002\u7d44\u5408\u6703\u5c07\u5f97\u5206\u4e58\u4ee5\u9023\u7e8c\u914d\u5c0d\u7684\u6b21\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a3 \u500b\u6c34\u679c\u914d\u5c0d - 100 \u5206\uff1b4 \u500b\u6c34\u679c\u914d\u5c0d - 200 \u5206\uff1b\u7d44\u5408\u4e58\u6578 - x2\u3001x3 \u7b49\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u6c34\u679c\u6d3e\u5c0d\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u8a2d\u5099\u55ce\uff1f\u6b65\u9a5f\u662f\u4ec0\u9ebc\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5c07\u904a\u6232\u9023\u7d50\u5230\u793e\u4ea4\u5a92\u9ad4\u5e33\u6236\u6216\u96fb\u5b50\u90f5\u4ef6\u5730\u5740\uff0c\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u6c34\u679c\u6d3e\u5c0d\u7684\u9032\u5ea6\u3002\u6b65\u9a5f\u4e00\uff1a\u958b\u555f\u904a\u6232\u8a2d\u5b9a\u4e26\u9078\u64c7\u300c\u9023\u7d50\u5e33\u6236\u300d\u3002\u6b65\u9a5f\u4e8c\uff1a\u9078\u64c7\u60a8\u504f\u597d\u7684\u9023\u7d50\u65b9\u5f0f\uff08\u4f8b\u5982\uff0cFacebook\u3001Google\uff09\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u60a8\u65b0\u7684\u88dd\u7f6e\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u540c\u6b65\u60a8\u7684\u624b\u6a5f\u806f\u7d61\u4eba\uff1b\u4e00\u65e6\u9023\u7d50\uff0c\u60a8\u7684\u9032\u5ea6\u5c31\u80fd\u5728\u4efb\u4f55\u5730\u65b9\u5b58\u53d6\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5c0d\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u95dc\u5361\u6216\u79d8\u5bc6\u529f\u80fd\u53ef\u80fd\u88ab\u73a9\u5bb6\u932f\u904e\uff1f", "answer": "\u662f\u7684\uff0c\u6c34\u679c\u6d3e\u5c0d\u5305\u542b\u96b1\u85cf\u95dc\u5361\uff0c\u5728\u5b8c\u6210\u67d0\u4e9b\u91cc\u7a0b\u7891\u5f8c\u5c31\u6703\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210 50 \u95dc\u53ef\u80fd\u6703\u63ed\u793a\u4e00\u500b\u79d8\u5bc6\u6311\u6230\u3002\u6b64\u5916\uff0c\u6709\u4e9b\u95dc\u5361\u9084\u6709\u4e00\u4e9b\u96b1\u85cf\u76ee\u6a19\uff0c\u4f8b\u5982\u6e05\u9664\u7279\u5b9a\u6578\u91cf\u7684\u7279\u5b9a\u6c34\u679c\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u7559\u610f\u95dc\u5361\u8aaa\u660e\u4e2d\u7684\u7d30\u5fae\u63d0\u793a\uff0c\u9019\u53ef\u80fd\u6703\u6697\u793a\u96b1\u85cf\u7684\u529f\u80fd\u3002]"}]
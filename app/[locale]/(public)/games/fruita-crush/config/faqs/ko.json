[{"question": "\ucc98\uc74c \uc2dc\uc791\ud558\ub294 \uc0ac\ub78c\uc774 Fruita Crush\uc758 \uccab \ubc88\uc9f8 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc644\ub8cc\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Fruita Crush\uc758 \uccab \ubc88\uc9f8 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc77c\ub82c\ub85c \uc138 \uac1c\uc758 \uac19\uc740 \uacfc\uc77c\uc744 \ub9de\ucd94\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \uc0ac\uacfc\ub97c \ub9de\ucd94\uc5b4 \ubcf4\ub4dc\uc5d0\uc11c \uc81c\uac70\ud569\ub2c8\ub2e4. STEP1: \uc26c\uc6b4 \ub9e4\uce58\ub97c \uc704\ud574 \ubcf4\ub4dc\ub97c \uc2a4\uce94\ud569\ub2c8\ub2e4. STEP2: \uc5f0\uc1c4 \ubc18\uc751\uc744 \uc720\ubc1c\ud558\uae30 \uc704\ud574 \uc544\ub798\ucabd\uc758 \ub9e4\uce58\ub97c \uc6b0\uc120\ud569\ub2c8\ub2e4. STEP3: \ub0a8\uc740 \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub0a8\uc740 \uacfc\uc77c\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc740 \uc6c0\uc9c1\uc784\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uace0 \uc6d0\ud65c\ud558\uac8c \uc9c4\ud589\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ube14\ub85d\uc744 \uc313\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uae30\uc800\ubd80\uc5d0\uc11c \ub354 \ub9ce\uc740 \uac83\uc744 \uc81c\uac70\ud560\uc218\ub85d \uc704\ucabd\uc5d0\uc11c \ub354 \ub9ce\uc740 \uae30\ud68c\uac00 \uc5f4\ub9bd\ub2c8\ub2e4.]"}, {"question": "Fruita Crush\uc758 \uc77c\ubd80 \ub808\ubca8\uc5d0 \ud2b9\ubcc4\ud55c \uc7a5\uc560\ubb3c\uc774 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Fruita Crush\uc758 \ud2b9\ubcc4\ud55c \uc7a5\uc560\ubb3c, \uc608\ub97c \ub4e4\uc5b4 \uc5bc\uc74c \ube14\ub85d\uc774\ub098 \uc7a0\uae34 \uacfc\uc77c\uc740 \ubcf5\uc7a1\uc131\uc744 \ub354\ud558\uace0 \uc804\ub7b5\uc801\uc778 \uc0ac\uace0\ub97c \uc694\uad6c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5bc\uc74c \ube14\ub85d\uc744 \ubd80\uc218\ub824\uba74 \uadf8 \uc8fc\ubcc0\uc758 \uacfc\uc77c\uc744 \ub9de\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc7a5\uc560\ubb3c\uc758 \uc885\ub958\ub97c \uc2dd\ubcc4\ud569\ub2c8\ub2e4. STEP2: \uc7a5\uc560\ubb3c \uadfc\ucc98\uc5d0\uc11c \ub9e4\uce58 \uacc4\ud68d\uc744 \uc138\uc6c1\ub2c8\ub2e4. STEP3: \ud544\uc694\ud55c \uacbd\uc6b0 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \uc5bc\uc74c \ube14\ub85d \uadfc\ucc98\uc758 \ub9e4\uce58\uac00 \ud6a8\uacfc\uc801\uc774\uc9c0\ub9cc, \ud3ed\ud0c4 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uba74 \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uc7a5\uc560\ubb3c\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \ub354 \uc5b4\ub824\uc6b4 \ucc4c\ub9b0\uc9c0\uc5d0 \uc6c0\uc9c1\uc784\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Fruita Crush\uc5d0\uc11c \uc0ac\uc6a9\ud558\uae30 \uac00\uc7a5 \uc88b\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \ud65c\uc131\ud654\ud574\uc57c \ud558\ub098\uc694?", "answer": "Fruita Crush\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc5d0\ub294 \ud3ed\ud0c4\uacfc \ubb34\uc9c0\uac1c \uacfc\uc77c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uc7a5\uc560\ubb3c\uc774 \ud568\uaed8 \uc788\ub294 \uacbd\uc6b0 \ud3ed\ud0c4\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5bc\uc74c \ube14\ub85d \uadf8\ub8f9\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ubb34\uc9c0\uac1c \uacfc\uc77c\uc740 \ubcf4\ub4dc\uac00 \ubcf5\uc7a1\ud560 \ub54c \ud2b9\ud788 \ud55c \uc885\ub958\uc758 \ubaa8\ub4e0 \uacfc\uc77c\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc801\ud569\ud569\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \ud3ed\ud0c4 \u2013 3x3 \uc601\uc5ed \uc81c\uac70; \ubb34\uc9c0\uac1c \uacfc\uc77c \u2013 \uc120\ud0dd\ud55c \uc885\ub958\uc758 \ubaa8\ub4e0 \uacfc\uc77c \uc81c\uac70.]"}, {"question": "\uc2dc\uac04 \uc81c\ud55c \ub808\ubca8\uc5d0\uc11c Fruita Crush \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2dc\uac04 \uc81c\ud55c \ub808\ubca8\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5f0\uc1c4 \ubc18\uc751\uc744 \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub124 \uac1c\uc758 \uacfc\uc77c\uc744 \ub9de\ucd94\uc5b4 \ub77c\uc778 \ud074\ub9ac\uc5b4 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ub9cc\ub4e4\uace0, \uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5f0\uc1c4 \ubc18\uc751\uc744 \uc720\ubc1c\ud569\ub2c8\ub2e4. STEP1: \uac15\ud654 \uc544\uc774\ud15c\uc744 \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc7a0\uc7ac\uc801 \ub9e4\uce58\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \uac00\uc7a5 \ub9ce\uc740 \uacfc\uc77c\uc774 \uc788\ub294 \uc9c0\uc5ed\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP3:  momentum\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ube60\ub974\uac8c \ub9e4\uce58\ub97c \uacc4\uc18d\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub3c4\ubbf8\ub178 \ud6a8\uacfc\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01 \uc6c0\uc9c1\uc784\uc740 \ucd5c\ub300 \uc601\ud5a5\uc744 \uc704\ud574 \ub2e4\uc74c \uc6c0\uc9c1\uc784\uc744 \uc124\uc815\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "Fruita Crush\uc758 \uace0\ub09c\uc774\ub3c4 \ucc4c\ub9b0\uc9c0 \ud074\ub9ac\uc5b4\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Fruita Crush\uc758 \uace0\ub09c\uc774\ub3c4 \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \ucd08\uae30 \uc7a5\uc560\ubb3c \uc81c\uac70\ub97c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uac1c\uc758 \uc7a0\uae34 \uacfc\uc77c\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c \uba3c\uc800 \uc7a0\uae08\uc744 \ud574\uc81c\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP1: \ubcf4\ub4dc\ub97c \ubd84\uc11d\ud558\uc5ec \uc8fc\uc694 \uc7a5\uc560\ubb3c\uc744 \uc2dd\ubcc4\ud569\ub2c8\ub2e4. STEP2: \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub4e4\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. STEP3: \ub9c8\ubb34\ub9ac \uc791\uc5c5\uc744 \uc704\ud574 \uc6c0\uc9c1\uc784\uc744 \ub0a8\uaca8\ub461\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \uc7a5\uc560\ubb3c\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\uc774 \uc911\uc694\ud558\uc9c0\ub9cc, \uacfc\uc77c\uacfc \uc7a5\uc560\ubb3c\uc744 \ud574\uacb0\ud558\ub294 \uc6c0\uc9c1\uc784\uc744 \uade0\ud615 \uc788\uac8c \uc0ac\uc6a9\ud558\uba74 \uc548\uc815\uc801\uc778 \uc9c4\ud589\uc774 \ubcf4\uc7a5\ub429\ub2c8\ub2e4.]"}, {"question": "Fruita Crush\uc758 \uc870\ud569 \uc2dc\uc2a4\ud15c\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uc720\ubc1c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Fruita Crush\uc758 \uc870\ud569 \uc2dc\uc2a4\ud15c\uc740 \uc5f0\uc18d\uc801\uc778 \ub9e4\uce58\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \ubc30\uc218\ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc720\ubc1c\ud558\ub824\uba74 \uc5f0\uc1c4 \ub9e4\uce58\ub97c \ubaa9\ud45c\ub85c \ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc544\ub798\ucabd\uc758 \uacfc\uc77c \uadf8\ub8f9\uc744 \uc81c\uac70\ud558\uc5ec \uc704\uc758 \uacfc\uc77c\uc774 \ub5a8\uc5b4\uc9c0\uace0 \uc0c8\ub85c\uc6b4 \ub9e4\uce58\ub97c \ub9cc\ub4dc\ub294 \uc5f0\uc1c4 \ubc18\uc751\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP1: \uc5f0\uc1c4 \ubc18\uc751\uc744 \uc720\ubc1c\ud560 \ub9e4\uce58\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. STEP2: \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc870\ud569\uc744 \uc5f0\uc7a5\ud569\ub2c8\ub2e4. STEP3: \ubcf4\ub4dc\ub97c \ud65c\uc131\ud654 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud558\uc5ec \uc870\ud569 \uc7a0\uc7ac\ub825\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc544\ub798 \uacfc\uc77c \uc81c\uac70 \u2192 \uc5f0\uc1c4 \ub9e4\uce58 \u2192 \uc870\ud569 \ubc30\uc218 \ud65c\uc131\ud654.]"}, {"question": "Fruita Crush\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc11c\ub85c \ub2e4\ub978 \uc791\uc5c5\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud558\ub098\uc694?", "answer": "Fruita Crush\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub9de\ucd98 \uacfc\uc77c\uc758 \uc218\uc640 \ub9e4\uce58 \uc720\ud615\uc5d0 \ub530\ub77c \uc810\uc218\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \uacfc\uc77c\uc744 \ub9de\ucd94\uba74 100\uc810, \ub124 \uac1c\uc758 \uacfc\uc77c\uc744 \ub9de\ucd94\uba74 200\uc810\uc785\ub2c8\ub2e4. \uc5f0\uc18d\uc801\uc778 \ub9e4\uce58\ub85c \uc774\ub8e8\uc5b4\uc9c0\ub294 \uc870\ud569\uc740 \uc810\uc218\ub97c \uc5f0\uc18d \ub9e4\uce58 \uc218\uc5d0 \ub530\ub77c \ubc30\uc218\ud569\ub2c8\ub2e4. [\uad6c\uc131\ud45c: 3\uac1c \uacfc\uc77c \ub9e4\uce58 - 100\uc810, 4\uac1c \uacfc\uc77c \ub9e4\uce58 - 200\uc810; \uc870\ud569 \ubc30\uc218 - x2, x3 \ub4f1.]"}, {"question": "Fruita Crush\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694? \uadf8\ub807\ub2e4\uba74 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub124, Fruita Crush\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc744 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815\uc774\ub098 \uc774\uba54\uc77c \uacc4\uc815\uacfc \uc5f0\uacb0\ud558\uc5ec \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uac8c\uc784 \uc124\uc815\uc744 \uc5f4\uace0 '\uacc4\uc815 \uc5f0\uacb0'\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2: \uc120\ud638\ud558\ub294 \uc5f0\uacb0 \ubc29\ubc95(\uc608: Facebook, Google)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3: \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c8 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud734\ub300\uc804\ud654 \uc5f0\ub77d\ucc98 \ub3d9\uae30\ud654\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc5f0\uacb0\ub418\uba74 \uc5b4\ub514\uc11c\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Fruita Crush\uc5d0 \ud50c\ub808\uc774\uc5b4\uac00 \ub193\uce60 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \ube44\ubc00 \uae30\ub2a5\uc774 \uc788\ub098\uc694?", "answer": "\ub124, Fruita Crush\uc5d0\ub294 \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud55c \ud6c4 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 50\uac1c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \ube44\ubc00 \ucc4c\ub9b0\uc9c0\uac00 \uacf5\uac1c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \ud2b9\uc815 \uacfc\uc77c\uc758 \ud2b9\uc815 \uac1c\uc218\ub97c \uc81c\uac70\ud558\ub294 \uac83\uacfc \uac19\uc774 \uc228\uaca8\uc9c4 \ubaa9\ud45c\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uae30\ub2a5 \ud0d0\uc0c9: \ub808\ubca8 \uc124\uba85\uc5d0\uc11c \ubbf8\ubb18\ud55c \ub2e8\uc11c\ub97c \uc0b4\ud3b4\ubcf4\uba74 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc74c\uc744 \uc54c \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.]"}]
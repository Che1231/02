[{"question": "\u65b0\u624b\u5982\u4f55\u5b8c\u6210\u6c34\u679c\u6d3e\u5bf9\u7b2c\u4e00\u5173\uff1f", "answer": "\u8981\u5b8c\u6210\u6c34\u679c\u6d3e\u5bf9\u7684\u7b2c\u4e00\u5173\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5c06\u4e09\u4e2a\u76f8\u540c\u7684\u6c34\u679c\u8fde\u6210\u4e00\u6392\u3002\u4f8b\u5982\uff0c\u5c06\u4e09\u4e2a\u82f9\u679c\u5339\u914d\u4ee5\u6e05\u9664\u5b83\u4eec\u3002\u6b65\u9aa41\uff1a\u626b\u63cf\u8bc6\u522b\u7b80\u5355\u7684\u5339\u914d\u3002\u6b65\u9aa42\uff1a\u4f18\u5148\u8003\u8651\u5e95\u90e8\u7684\u5339\u914d\u4ee5\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5269\u4f59\u7684\u79fb\u52a8\u6765\u6e05\u9664\u4efb\u4f55\u5269\u4f59\u7684\u6c34\u679c\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u6709\u6548\u5229\u7528\u79fb\u52a8\u6b21\u6570\uff0c\u5e76\u5e2e\u52a9\u60a8\u987a\u5229\u8fdb\u6b65\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u5806\u53e0\u79ef\u6728\uff1b\u4f60\u6e05\u9664\u7684\u5e95\u5c42\u8d8a\u591a\uff0c\u4e0a\u9762\u7684\u673a\u4f1a\u5c31\u8d8a\u591a\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u67d0\u4e9b\u5173\u5361\u4e3a\u4ec0\u4e48\u4f1a\u6709\u7279\u6b8a\u969c\u788d\u7269\uff0c\u4ee5\u53ca\u5982\u4f55\u514b\u670d\u5b83\u4eec\uff1f", "answer": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u7684\u7279\u6b8a\u969c\u788d\u7269\uff0c\u4f8b\u5982\u51b0\u5757\u6216\u9501\u5b9a\u6c34\u679c\uff0c\u589e\u52a0\u4e86\u590d\u6742\u6027\uff0c\u9700\u8981\u7b56\u7565\u6027\u601d\u8003\u3002\u4f8b\u5982\uff0c\u8981\u6253\u7834\u51b0\u5757\uff0c\u9700\u8981\u5339\u914d\u4e0e\u51b0\u5757\u76f8\u90bb\u7684\u6c34\u679c\u3002\u6b65\u9aa41\uff1a\u8bc6\u522b\u969c\u788d\u7269\u7c7b\u578b\u3002\u6b65\u9aa42\uff1a\u89c4\u5212\u969c\u788d\u7269\u9644\u8fd1\u7684\u5339\u914d\u3002\u6b65\u9aa43\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u4f7f\u7528\u9053\u5177\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u5728\u51b0\u5757\u9644\u8fd1\u5339\u914d\u6709\u6548\uff0c\u4f46\u4f7f\u7528\u70b8\u5f39\u9053\u5177\u53ef\u4ee5\u4e00\u6b21\u6e05\u9664\u591a\u4e2a\u969c\u788d\u7269\uff0c\u4e3a\u66f4\u68d8\u624b\u7684\u6311\u6218\u8282\u7701\u79fb\u52a8\u6b21\u6570\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u597d\u7528\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u6fc0\u6d3b\u5b83\u4eec\uff1f", "answer": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u6700\u597d\u7684\u9053\u5177\u5305\u62ec\u70b8\u5f39\u548c\u5f69\u8679\u6c34\u679c\u3002\u5f53\u591a\u4e2a\u969c\u788d\u7269\u805a\u96c6\u5728\u4e00\u8d77\u65f6\uff0c\u6fc0\u6d3b\u70b8\u5f39\u9053\u5177\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5b83\u6765\u6e05\u9664\u4e00\u7ec4\u51b0\u5757\u3002\u5f69\u8679\u6c34\u679c\u975e\u5e38\u9002\u5408\u6e05\u9664\u6240\u6709\u4e00\u79cd\u7c7b\u578b\u7684\u6c34\u679c\uff0c\u5c24\u5176\u662f\u5728\u6e38\u620f\u76d8\u6742\u4e71\u65e0\u7ae0\u65f6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u70b8\u5f39 - \u6e05\u9664 3x3 \u533a\u57df\uff1b\u5f69\u8679\u6c34\u679c - \u6e05\u9664\u6240\u6709\u9009\u5b9a\u7c7b\u578b\u7684\u6c34\u679c\u3002]"}, {"question": "\u5982\u4f55\u5728\u6c34\u679c\u6d3e\u5bf9\u7684\u9650\u65f6\u5173\u5361\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u8981\u5728\u9650\u65f6\u5173\u5361\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u521b\u5efa\u8fde\u9501\u53cd\u5e94\u3002\u4f8b\u5982\uff0c\u5339\u914d\u56db\u4e2a\u6c34\u679c\u4ee5\u521b\u5efa\u6d88\u9664\u4e00\u884c\u7684\u9053\u5177\uff0c\u7136\u540e\u4f7f\u7528\u5b83\u6765\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\u3002\u6b65\u9aa41\uff1a\u5bfb\u627e\u53ef\u80fd\u521b\u5efa\u9053\u5177\u7684\u6f5c\u5728\u5339\u914d\u3002\u6b65\u9aa42\uff1a\u5728\u6c34\u679c\u6700\u591a\u7684\u533a\u57df\u6fc0\u6d3b\u9053\u5177\u3002\u6b65\u9aa43\uff1a\u7ee7\u7eed\u5feb\u901f\u5339\u914d\u4ee5\u4fdd\u6301\u52bf\u5934\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u5f53\u4f5c\u591a\u7c73\u8bfa\u9aa8\u724c\u6548\u5e94\uff1b\u6bcf\u4e00\u6b21\u79fb\u52a8\u90fd\u5e94\u8be5\u4e3a\u6700\u5927\u5f71\u54cd\u8bbe\u7f6e\u4e0b\u4e00\u6b21\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u6700\u9002\u5408\u6e05\u9664\u6c34\u679c\u6d3e\u5bf9\u7684\u9ad8\u7ea7\u6311\u6218\uff1f", "answer": "\u5728\u6c34\u679c\u6d3e\u5bf9\u7684\u9ad8\u7ea7\u6311\u6218\u4e2d\uff0c\u4f18\u5148\u8003\u8651\u5c3d\u65e9\u6e05\u9664\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u5173\u5361\u4e2d\u6709\u591a\u4e2a\u88ab\u9501\u5b9a\u7684\u6c34\u679c\uff0c\u9996\u5148\u4e13\u6ce8\u4e8e\u89e3\u9501\u5b83\u4eec\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u6e38\u620f\u76d8\uff0c\u8bc6\u522b\u5173\u952e\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u6765\u6e05\u9664\u5b83\u4eec\u3002\u6b65\u9aa43\uff1a\u5c06\u79fb\u52a8\u6b21\u6570\u7559\u4f5c\u6700\u7ec8\u6e05\u7406\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u4e13\u6ce8\u4e8e\u969c\u788d\u7269\u81f3\u5173\u91cd\u8981\uff0c\u4f46\u5728\u6e05\u9664\u6c34\u679c\u548c\u969c\u788d\u7269\u4e4b\u95f4\u5e73\u8861\u79fb\u52a8\u6b21\u6570\u5c06\u786e\u4fdd\u7a33\u5b9a\u8fdb\u6b65\u3002]"}, {"question": "\u7ec4\u5408\u7cfb\u7edf\u5728\u6c34\u679c\u6d3e\u5bf9\u4e2d\u626e\u6f14\u4ec0\u4e48\u89d2\u8272\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u89e6\u53d1\u5b83\uff1f", "answer": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u7684\u7ec4\u5408\u7cfb\u7edf\u4f1a\u5c06\u8fde\u7eed\u5339\u914d\u7684\u5206\u6570\u8fdb\u884c\u4e58\u79ef\u3002\u4e3a\u4e86\u6709\u6548\u89e6\u53d1\u5b83\uff0c\u76ee\u6807\u662f\u5b9e\u73b0\u8fde\u9501\u5339\u914d\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u5e95\u90e8\u7684\u6c34\u679c\u7ec4\uff0c\u5bfc\u81f4\u4e0a\u9762\u7684\u6c34\u679c\u843d\u4e0b\uff0c\u5e76\u521b\u5efa\u65b0\u7684\u5339\u914d\u3002\u6b65\u9aa41\uff1a\u89c4\u5212\u80fd\u591f\u5f15\u53d1\u8fde\u9501\u53cd\u5e94\u7684\u5339\u914d\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u9053\u5177\u6765\u5ef6\u4f38\u7ec4\u5408\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u6e38\u620f\u76d8\u6d3b\u8dc3\u4ee5\u6700\u5927\u5316\u7ec4\u5408\u6f5c\u529b\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6e05\u9664\u5e95\u5c42\u6c34\u679c \u2192 \u8fde\u9501\u5339\u914d \u2192 \u7ec4\u5408\u4e58\u6570\u6fc0\u6d3b\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5bf9\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u8ba1\u7b97\u4e0d\u540c\u64cd\u4f5c\u7684\u5206\u6570\uff1f", "answer": "\u6c34\u679c\u6d3e\u5bf9\u7684\u8bc4\u5206\u7cfb\u7edf\u6839\u636e\u5339\u914d\u7684\u6c34\u679c\u6570\u91cf\u548c\u5339\u914d\u7c7b\u578b\u6388\u4e88\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5339\u914d\u4e09\u4e2a\u6c34\u679c\u5f97 100 \u5206\uff0c\u800c\u5339\u914d\u56db\u4e2a\u6c34\u679c\u5f97 200 \u5206\u3002\u7ec4\u5408\u4f1a\u5c06\u5206\u6570\u4e58\u4ee5\u8fde\u7eed\u5339\u914d\u7684\u6570\u91cf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a3 \u4e2a\u6c34\u679c\u5339\u914d - 100 \u5206\uff1b4 \u4e2a\u6c34\u679c\u5339\u914d - 200 \u5206\uff1b\u7ec4\u5408\u4e58\u6570 - x2\u3001x3 \u7b49\u3002]"}, {"question": "\u6211\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6c34\u679c\u6d3e\u5bf9\u7684\u8fdb\u5ea6\uff0c\u4ee5\u53ca\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u5e10\u6237\u6216\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u6765\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6c34\u679c\u6d3e\u5bf9\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u6253\u5f00\u6e38\u620f\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u94fe\u63a5\u5e10\u6237\u201d\u3002\u6b65\u9aa42\uff1a\u9009\u62e9\u60a8\u9996\u9009\u7684\u94fe\u63a5\u65b9\u5f0f\uff08\u4f8b\u5982\uff0cFacebook\u3001Google\uff09\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u540c\u4e00\u5e10\u6237\u5728\u60a8\u7684\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u540c\u6b65\u60a8\u7684\u624b\u673a\u901a\u8baf\u5f55\uff1b\u4e00\u65e6\u94fe\u63a5\uff0c\u60a8\u7684\u8fdb\u5ea6\u5728\u4efb\u4f55\u5730\u65b9\u90fd\u53ef\u8bbf\u95ee\u3002]"}, {"question": "\u6c34\u679c\u6d3e\u5bf9\u4e2d\u662f\u5426\u5b58\u5728\u73a9\u5bb6\u53ef\u80fd\u9519\u8fc7\u7684\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\u529f\u80fd\uff1f", "answer": "\u662f\u7684\uff0c\u6c34\u679c\u6d3e\u5bf9\u5305\u542b\u9690\u85cf\u5173\u5361\uff0c\u5728\u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u540e\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210 50 \u5173\uff0c\u53ef\u80fd\u4f1a\u63ed\u793a\u4e00\u4e2a\u79d8\u5bc6\u6311\u6218\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5173\u5361\u8fd8\u6709\u9690\u85cf\u76ee\u6807\uff0c\u4f8b\u5982\u6e05\u9664\u7279\u5b9a\u6570\u91cf\u7684\u7279\u5b9a\u7c7b\u578b\u7684\u6c34\u679c\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5bc6\u5207\u5173\u6ce8\u5173\u5361\u63cf\u8ff0\u4e2d\u7684\u7ec6\u5fae\u63d0\u793a\uff0c\u8fd9\u53ef\u80fd\u6697\u793a\u9690\u85cf\u529f\u80fd\u3002]"}]
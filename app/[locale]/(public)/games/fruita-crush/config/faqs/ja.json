[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u30af\u30ea\u30a2\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u540c\u3058\u7a2e\u985e\u306e\u30d5\u30eb\u30fc\u30c4\u3092\uff13\u3064\u4e26\u3079\u3066\u4e00\u81f4\u3055\u305b\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\uff13\u3064\u306e\u30ea\u30f3\u30b4\u3092\u4e00\u81f4\u3055\u305b\u3066\u30dc\u30fc\u30c9\u304b\u3089\u6d88\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u7c21\u5358\u306a\u4e00\u81f4\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u30ab\u30b9\u30b1\u30fc\u30c9\u3092\u5f15\u304d\u8d77\u3053\u3059\u305f\u3081\u306b\u3001\u4e0b\u306e\u307b\u3046\u306e\u4e00\u81f4\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u6b8b\u308a\u306e\u52d5\u304d\u3092\u4f7f\u3063\u3066\u3001\u6b8b\u308a\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u6d88\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3067\u3001\u52d5\u304d\u3092\u52b9\u7387\u7684\u306b\u4f7f\u3044\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u6b69\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u30d6\u30ed\u30c3\u30af\u3092\u7a4d\u307f\u91cd\u306d\u308b\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\u57fa\u76e4\u3067\u30af\u30ea\u30a2\u3059\u308b\u3082\u306e\u304c\u591a\u3051\u308c\u3070\u591a\u3044\u307b\u3069\u3001\u4e0a\u306b\u591a\u304f\u306e\u6a5f\u4f1a\u304c\u958b\u3051\u307e\u3059\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u306b\u7279\u5225\u306a\u969c\u5bb3\u7269\u304c\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u514b\u670d\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u7279\u5225\u306a\u969c\u5bb3\u7269\u3001\u4f8b\u3048\u3070\u6c37\u306e\u30d6\u30ed\u30c3\u30af\u3084\u30ed\u30c3\u30af\u3055\u308c\u305f\u30d5\u30eb\u30fc\u30c4\u306f\u3001\u8907\u96d1\u3055\u3092\u52a0\u3048\u3001\u6226\u7565\u7684\u306a\u601d\u8003\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6c37\u306e\u30d6\u30ed\u30c3\u30af\u3092\u58ca\u3059\u305f\u3081\u306b\u3001\u305d\u308c\u3089\u306e\u96a3\u63a5\u3059\u308b\u30d5\u30eb\u30fc\u30c4\u3092\u4e00\u81f4\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u969c\u5bb3\u7269\u306e\u7a2e\u985e\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u969c\u5bb3\u7269\u306e\u8fd1\u304f\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u5fc5\u8981\u3067\u3042\u308c\u3070\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6c37\u306e\u30d6\u30ed\u30c3\u30af\u306e\u8fd1\u304f\u3067\u4e00\u81f4\u3055\u305b\u308b\u3053\u3068\u306f\u6709\u52b9\u3067\u3059\u304c\u3001\u7206\u5f3e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u3046\u3053\u3068\u3067\u3001\u8907\u6570\u306e\u969c\u5bb3\u7269\u3092\u4e00\u5ea6\u306b\u30af\u30ea\u30a2\u3057\u3001\u3088\u308a\u56f0\u96e3\u306a\u6311\u6226\u306e\u305f\u3081\u306b\u52d5\u304d\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u4f7f\u7528\u3059\u308b\u6700\u826f\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3044\u3064\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u6700\u9ad8\u306e\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u3001\u7206\u5f3e\u3068\u8679\u8272\u306e\u30d5\u30eb\u30fc\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u8907\u6570\u306e\u969c\u5bb3\u7269\u304c\u96c6\u307e\u3063\u3066\u3044\u308b\u3068\u304d\u306b\u7206\u5f3e\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u4e00\u307e\u3068\u307e\u308a\u306e\u6c37\u306e\u30d6\u30ed\u30c3\u30af\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u8679\u8272\u306e\u30d5\u30eb\u30fc\u30c4\u306f\u3001\u7279\u306b\u30dc\u30fc\u30c9\u304c\u6df7\u96d1\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u3001\u3042\u308b\u7a2e\u985e\u306e\u3059\u3079\u3066\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u7406\u60f3\u7684\u3067\u3059\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u7206\u5f3e - 3x3\u306e\u30a8\u30ea\u30a2\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059; \u8679\u8272\u306e\u30d5\u30eb\u30fc\u30c4 - \u9078\u629e\u3057\u305f\u7a2e\u985e\u306e\u3059\u3079\u3066\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002]"}, {"question": "\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30ec\u30d9\u30eb\u3067\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30ec\u30d9\u30eb\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u9023\u9396\u53cd\u5fdc\u3092\u8d77\u3053\u3059\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\uff14\u3064\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u4e00\u81f4\u3055\u305b\u3066\u30e9\u30a4\u30f3\u30af\u30ea\u30a2\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u308a\u3001\u305d\u306e\u5f8c\u3001\u30ab\u30b9\u30b1\u30fc\u30c9\u3092\u5f15\u304d\u8d77\u3053\u3059\u305f\u3081\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u751f\u307f\u51fa\u3059\u53ef\u80fd\u6027\u306e\u3042\u308b\u4e00\u81f4\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u6700\u3082\u591a\u304f\u306e\u30d5\u30eb\u30fc\u30c4\u304c\u3042\u308b\u5834\u6240\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u52e2\u3044\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u7d20\u65e9\u304f\u4e00\u81f4\u3057\u7d9a\u3051\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u30c9\u30df\u30ce\u52b9\u679c\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5404\u52d5\u304d\u306f\u3001\u6700\u5927\u306e\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u6b21\u306e\u52d5\u304d\u3092\u8a2d\u5b9a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u9ad8\u30ec\u30d9\u30eb\u306e\u6311\u6226\u3092\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u9ad8\u30ec\u30d9\u30eb\u306e\u6311\u6226\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u65e9\u671f\u306b\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u30ed\u30c3\u30af\u3055\u308c\u305f\u30d5\u30eb\u30fc\u30c4\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6700\u521d\u306b\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30dc\u30fc\u30c9\u3092\u5206\u6790\u3057\u3066\u3001\u4e3b\u8981\u306a\u969c\u5bb3\u7269\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u6226\u7565\u7684\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u6700\u7d42\u7684\u306a\u7247\u4ed8\u3051\u306e\u305f\u3081\u306b\u52d5\u304d\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u969c\u5bb3\u7269\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u304c\u3001\u30d5\u30eb\u30fc\u30c4\u3068\u969c\u5bb3\u7269\u306e\u30af\u30ea\u30a2\u306b\u52d5\u304d\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u7740\u5b9f\u306b\u9032\u6b69\u3092\u78ba\u4fdd\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30b3\u30de\u30f3\u30c9\u30b7\u30b9\u30c6\u30e0\u306e\u5f79\u5272\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3092\u52b9\u679c\u7684\u306b\u5f15\u304d\u8d77\u3053\u3059\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30b3\u30de\u30f3\u30c9\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u9023\u7d9a\u3059\u308b\u4e00\u81f4\u306e\u30b9\u30b3\u30a2\u304c\u4e57\u7b97\u3055\u308c\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u5f15\u304d\u8d77\u3053\u3059\u305f\u3081\u306b\u306f\u3001\u30ab\u30b9\u30b1\u30fc\u30c9\u306b\u306a\u308b\u4e00\u81f4\u3092\u76ee\u6307\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e0b\u306e\u30d5\u30eb\u30fc\u30c4\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u4e0a\u306e\u30d5\u30eb\u30fc\u30c4\u304c\u843d\u3061\u3066\u304d\u3066\u65b0\u3057\u3044\u4e00\u81f4\u3092\u751f\u307f\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30ab\u30b9\u30b1\u30fc\u30c9\u3092\u5f15\u304d\u8d77\u3053\u3059\u4e00\u81f4\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u30b3\u30de\u30f3\u30c9\u3092\u5ef6\u9577\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u30dc\u30fc\u30c9\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u4fdd\u3061\u3001\u30b3\u30de\u30f3\u30c9\u306e\u6f5c\u5728\u80fd\u529b\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3057\u307e\u3059\u3002[\u6d41\u7a0b\u56fe\u89e3: \u4e0b\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u30af\u30ea\u30a2 \u2192 \u30ab\u30b9\u30b1\u30fc\u30c9\u304c\u8d77\u3053\u308b\u4e00\u81f4 \u2192 \u30b3\u30de\u30f3\u30c9\u500d\u7387\u306e\u6d3b\u6027\u5316\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30a2\u30af\u30b7\u30e7\u30f3\u306b\u5bfe\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u4e00\u81f4\u3057\u305f\u30d5\u30eb\u30fc\u30c4\u306e\u6570\u3068\u4e00\u81f4\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\uff13\u3064\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u4e00\u81f4\u3055\u305b\u308b\u3068\uff11\uff10\uff10\u30dd\u30a4\u30f3\u30c8\u3001\uff14\u3064\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u4e00\u81f4\u3055\u305b\u308b\u3068\uff12\uff10\uff10\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u3002\u30b3\u30de\u30f3\u30c9\u306f\u3001\u9023\u7d9a\u3059\u308b\u4e00\u81f4\u306e\u6570\u306b\u3088\u3063\u3066\u30b9\u30b3\u30a2\u3092\u4e57\u7b97\u3057\u307e\u3059\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \uff13\u3064\u306e\u30d5\u30eb\u30fc\u30c4\u306e\u4e00\u81f4 - \uff11\uff10\uff10\u30dd\u30a4\u30f3\u30c8; \uff14\u3064\u306e\u30d5\u30eb\u30fc\u30c4\u306e\u4e00\u81f4 - \uff12\uff10\uff10\u30dd\u30a4\u30f3\u30c8; \u30b3\u30de\u30f3\u30c9\u306e\u500d\u7387 - x2\u3001x3\u306a\u3069\u3002]"}, {"question": "\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u306e\u624b\u9806\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306f\u30e1\u30fc\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3092\u958b\u304d\u3001\u300e\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u597d\u307f\u306b\u5fdc\u3058\u3066\u30ea\u30f3\u30af\u65b9\u6cd5\u3092\u9078\u629e\u3057\u307e\u3059\uff08\u4f8b\uff1aFacebook\u3001Google\uff09\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u96fb\u8a71\u306e\u9023\u7d61\u5148\u3092\u540c\u671f\u3055\u305b\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u30ea\u30f3\u30af\u3059\u308b\u3068\u3001\u3069\u3053\u3067\u3082\u9032\u6357\u72b6\u6cc1\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3084\u7279\u5225\u306a\u6a5f\u80fd\u306f\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306b\u5b58\u5728\u3057\u307e\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u3092\u898b\u9003\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d5\u30eb\u30fc\u30c4\u30af\u30e9\u30c3\u30b7\u30e5\u306b\u306f\u3001\u7279\u5b9a\u306e\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u3092\u5b8c\u4e86\u3057\u305f\u5f8c\u306b\u958b\u304f\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u305b\u305a\u306b\uff15\uff10\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u6311\u6226\u304c\u958b\u304b\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u7a2e\u985e\u306e\u30d5\u30eb\u30fc\u30c4\u3092\u7279\u5b9a\u306e\u6570\u3060\u3051\u30af\u30ea\u30a2\u3059\u308b\u3001\u3068\u3044\u3063\u305f\u3001\u96a0\u3055\u308c\u305f\u76ee\u6a19\u3092\u6301\u3064\u30ec\u30d9\u30eb\u3082\u3042\u308a\u307e\u3059\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u30ec\u30d9\u30eb\u306e\u8aac\u660e\u306b\u3042\u308b\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3057\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u306f\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306e\u5146\u5019\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002]"}]
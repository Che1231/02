[{"question": "FNF Flip-Side\u3092\u521d\u5fc3\u8005\u3068\u3057\u3066\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF Flip-Side\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u899a\u3048\u308b\uff1a\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30ce\u30fc\u30c4\u3092\u53e9\u304d\u307e\u3059\u3002STEP2 - \u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u300e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u300f\u30e2\u30fc\u30c9\u304b\u3089\u59cb\u3081\u307e\u3059\u3002STEP3 - \u81ea\u4fe1\u3092\u7bc9\u304f\u305f\u3081\u306b\u3001\u300e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u300f\u3084\u300e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30fb\u30ea\u30df\u30c3\u30af\u30b9\u300f\u306e\u3088\u3046\u306a\u7c21\u5358\u306a\u96e3\u6613\u5ea6\u30c8\u30e9\u30c3\u30af\u3067\u7df4\u7fd2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30fb\u30ea\u30df\u30c3\u30af\u30b9\u300f\u3067\u306f\u30ce\u30fc\u30c4\u304c\u9045\u304f\u3001\u3088\u308a\u8a31\u5bb9\u7bc4\u56f2\u304c\u5e83\u3044\u305f\u3081\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002\u8a2d\u5b9a\u3067\u30ce\u30fc\u30c4\u306e\u901f\u5ea6\u3068\u30ad\u30fc\u30d0\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u81ea\u5206\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "FNF Flip-Side\u3067\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF Flip-Side\u3067\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u6226\u7565\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1 - \u30ce\u30fc\u30c4\u3060\u3051\u3067\u306a\u304f\u3001\u97f3\u697d\u306e\u30ea\u30ba\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002STEP2 - \u96e3\u3057\u3044\u90e8\u5206\u306b\u5230\u9054\u3059\u308b\u307e\u3067\u3001\u300e\u7df4\u7fd2\u30e2\u30fc\u30c9\u300f\u3092\u4f7f\u7528\u3057\u3066\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002STEP3 - \u8a2d\u5b9a\u3067\u30ce\u30fc\u30c4\u306e\u901f\u5ea6\u3092\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u901f\u5ea6\u304c\u9045\u3044\u65b9\u304c\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300eFlip-Side Showdown\u300f\u306e\u66f2\u3067\u306f\u3001\u9ad8\u901f\u306a\u30ce\u30fc\u30c4\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u7df4\u7fd2\u306b\u3088\u308a\u3001\u6b63\u78ba\u6027\u3092\u5927\u5e45\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30e1\u30c8\u30ed\u30ce\u30fc\u30e0\u30a2\u30d7\u30ea\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d3\u30fc\u30c8\u3092\u5185\u9762\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4f4e\u4fa1\u683c\u306ePC\u3067FNF Flip-Side\u306e\u4f53\u9a13\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u4f4e\u4fa1\u683c\u306ePC\u3067FNF Flip-Side\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u30aa\u30d7\u30b7\u30e7\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u3001\u4f8b\u3048\u3070\u89e3\u50cf\u5ea6\u3092\u4e0b\u3052\u305f\u308a\u3001\u5f71\u3092\u7121\u52b9\u5316\u3057\u305f\u308a\u3057\u307e\u3059\u3002STEP2 - \u4e0d\u8981\u306a\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u30aa\u30d5\u306b\u3057\u3066\u3001\u30b7\u30b9\u30c6\u30e0\u30ea\u30bd\u30fc\u30b9\u3092\u89e3\u653e\u3057\u307e\u3059\u3002STEP3 - \u5229\u7528\u53ef\u80fd\u306a\u5834\u5408\u3001\u300e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30e2\u30fc\u30c9\u300f\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306e\u8ca0\u8377\u304c\u8efd\u6e1b\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u89e3\u50cf\u5ea6\u3092720p\u306b\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u306a\u304f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8efd\u91cf\u306a\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u3055\u3089\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "FNF Flip-Side\u3067\u7c21\u5358\u306a\u96e3\u6613\u5ea6\u304b\u3089\u96e3\u3057\u3044\u96e3\u6613\u5ea6\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF Flip-Side\u3067\u7c21\u5358\u306a\u96e3\u6613\u5ea6\u304b\u3089\u96e3\u3057\u3044\u96e3\u6613\u5ea6\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u6bb5\u968e\u7684\u306a\u7df4\u7fd2\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1 - \u5f37\u56fa\u306a\u57fa\u790e\u3092\u7bc9\u304f\u305f\u3081\u306b\u3001\u7c21\u5358\u306a\u96e3\u6613\u5ea6\u3067\u5168\u3066\u306e\u30c8\u30e9\u30c3\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002STEP2 - \u4e2d\u96e3\u5ea6\u306b\u9032\u3093\u3067\u3001\u53cd\u5fdc\u6642\u9593\u3068\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3057\u3087\u3046\u3002STEP3 - \u300e\u7df4\u7fd2\u30e2\u30fc\u30c9\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u96e3\u3057\u3044\u90e8\u5206\u306b\u5230\u9054\u3059\u308b\u307e\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300eFlip-Side Frenzy\u300f\u306e\u66f2\u3067\u306f\u3001\u4e2d\u96e3\u5ea6\u306e\u8907\u96d1\u306a\u30ce\u30fc\u30c4\u30d1\u30bf\u30fc\u30f3\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u96e3\u3057\u3044\u96e3\u6613\u5ea6\u3067\u306e\u30b9\u30d4\u30fc\u30c9\u30a2\u30c3\u30d7\u306b\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u52d5\u753b\u3092\u898b\u308b\u3053\u3068\u3067\u3001\u8cb4\u91cd\u306a\u77e5\u898b\u3092\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "FNF Flip-Side\u3068\u30aa\u30ea\u30b8\u30ca\u30eb\u306eFriday Night Funkin'\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF Flip-Side\u306f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u306eFriday Night Funkin'\u304b\u3089\u3044\u304f\u3064\u304b\u306e\u4e3b\u8981\u306a\u9055\u3044\u3092\u5c0e\u5165\u3057\u3066\u3044\u307e\u3059\u3002STEP1 - \u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u30c8\u30e9\u30c3\u30af\uff1aFlip-Side\u306f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u306e\u30b2\u30fc\u30e0\u306b\u306f\u306a\u3044\u30e6\u30cb\u30fc\u30af\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u97f3\u697d\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002STEP2 - \u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\uff1aFlip-Side\u306b\u306f\u3001\u300eFlip\u300f\u3068\u3044\u3046\u6a5f\u80fd\uff08\u30ce\u30fc\u30c4\u30d1\u30bf\u30fc\u30f3\u3092\u52d5\u7684\u306b\u5909\u66f4\u3059\u308b\uff09\u306e\u3088\u3046\u306a\u65b0\u3057\u3044\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002STEP3 - \u30d3\u30b8\u30e5\u30a2\u30eb\u3068\u30aa\u30fc\u30c7\u30a3\u30aa\u306e\u5
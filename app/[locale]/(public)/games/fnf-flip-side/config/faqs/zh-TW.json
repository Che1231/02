[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624b FNF Flip-Side \u521d\u5b78\u8005\u7248\u672c\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b FNF Flip-Side\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u6309\u9375\uff0c\u914d\u5408\u97f3\u6a02\u7bc0\u594f\u9ede\u64ca\u97f3\u7b26\u3002\u6b65\u9a5f2 - \u5f9e\u300e\u6559\u5b78\u300f\u6a21\u5f0f\u958b\u59cb\uff0c\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f3 - \u7df4\u7fd2\u7c21\u55ae\u96e3\u5ea6\u66f2\u76ee\uff0c\u4f8b\u5982\u300e\u6559\u5b78\u300f\u6216\u300e\u6559\u5b78\u91cd\u88fd\u300f\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6559\u5b78\u91cd\u88fd\u300f\u4e2d\uff0c\u97f3\u7b26\u8f03\u6162\u4e14\u5bb9\u932f\u7387\u66f4\u9ad8\uff0c\u975e\u5e38\u9069\u5408\u521d\u5b78\u8005\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u8a2d\u5b9a\u8abf\u6574\u97f3\u7b26\u901f\u5ea6\u548c\u9375\u76e4\u7d81\u5b9a\uff0c\u4ee5\u7b26\u5408\u60a8\u7684\u559c\u597d\u3002"}, {"question": "\u63d0\u9ad8 FNF Flip-Side \u7cbe\u78ba\u5ea6\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u63d0\u9ad8 FNF Flip-Side \u7684\u6e96\u78ba\u5ea6\u9700\u8981\u7d50\u5408\u7df4\u7fd2\u548c\u7b56\u7565\u3002\u6b65\u9a5f1 - \u95dc\u6ce8\u97f3\u6a02\u7bc0\u594f\u800c\u975e\u50c5\u50c5\u97f3\u7b26\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u300e\u7df4\u7fd2\u6a21\u5f0f\u300f\u53cd\u8986\u7df4\u7fd2\u56f0\u96e3\u90e8\u5206\uff0c\u76f4\u5230\u719f\u7df4\u3002\u6b65\u9a5f3 - \u8abf\u6574\u8a2d\u5b9a\u4e2d\u7684\u97f3\u7b26\u901f\u5ea6\u81f3\u8212\u9069\u7684\u6c34\u5e73\uff1b\u8f03\u6162\u7684\u901f\u5ea6\u6709\u52a9\u65bc\u96c6\u4e2d\u7cbe\u529b\u65bc\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u5728\u300eFlip-Side Showdown\u300f\u66f2\u76ee\u4e2d\uff0c\u7df4\u7fd2\u5feb\u901f\u7684\u97f3\u7b26\u5e8f\u5217\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u6e96\u78ba\u5ea6\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u7bc0\u62cd\u5668\u61c9\u7528\u7a0b\u5f0f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5167\u5316\u7bc0\u62cd\u3002"}, {"question": "\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u624d\u80fd\u512a\u5316\u4f4e\u7aef\u96fb\u8166\u4e0a\u7684 FNF Flip-Side \u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u8981\u512a\u5316\u4f4e\u7aef\u96fb\u8166\u4e0a\u7684 FNF Flip-Side\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5728\u9078\u9805\u83dc\u55ae\u4e2d\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4f8b\u5982\u964d\u4f4e\u89e3\u6790\u5ea6\u4e26\u7981\u7528\u9670\u5f71\u3002\u6b65\u9a5f2 - \u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u6b65\u9a5f3 - \u5982\u679c\u53ef\u7528\uff0c\u8acb\u4f7f\u7528\u300e\u6548\u80fd\u6a21\u5f0f\u300f\uff0c\u4ee5\u964d\u4f4e\u5716\u5f62\u8ca0\u8f09\u3002\u4f8b\u5982\uff0c\u5c07\u89e3\u6790\u5ea6\u964d\u4f4e\u81f3 720p \u53ef\u4ee5\u986f\u8457\u63d0\u5347\u6548\u80fd\uff0c\u800c\u4e0d\u6703\u5927\u5e45\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u8f15\u91cf\u7d1a\u4f5c\u696d\u7cfb\u7d71\u53ef\u4ee5\u9032\u4e00\u6b65\u63d0\u5347\u6548\u80fd\u3002"}, {"question": "\u5982\u4f55\u5728 FNF Flip-Side \u4e2d\u5f9e\u7c21\u55ae\u96e3\u5ea6\u8f49\u63db\u81f3\u56f0\u96e3\u96e3\u5ea6\uff1f", "answer": "\u5728 FNF Flip-Side \u4e2d\u5f9e\u7c21\u55ae\u96e3\u5ea6\u8f49\u63db\u81f3\u56f0\u96e3\u96e3\u5ea6\u9700\u8981\u5faa\u5e8f\u6f38\u9032\u7684\u7df4\u7fd2\u548c\u7b56\u7565\u3002\u6b65\u9a5f1 - \u5f9e\u638c\u63e1\u6240\u6709\u7c21\u55ae\u96e3\u5ea6\u7684\u66f2\u76ee\u958b\u59cb\uff0c\u5efa\u7acb\u5805\u5be6\u7684\u57fa\u790e\u3002\u6b65\u9a5f2 - \u8f49\u81f3\u4e2d\u7b49\u96e3\u5ea6\uff0c\u5c08\u6ce8\u65bc\u63d0\u5347\u60a8\u7684\u53cd\u61c9\u6642\u9593\u548c\u6e96\u78ba\u5ea6\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u300e\u7df4\u7fd2\u6a21\u5f0f\u300f\u4f86\u6311\u6230\u56f0\u96e3\u96e3\u5ea6\u7684\u8907\u96dc\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5728\u300eFlip-Side Frenzy\u300f\u66f2\u76ee\u4e2d\uff0c\u5728\u4e2d\u7b49\u96e3\u5ea6\u7df4\u7fd2\u8907\u96dc\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u53ef\u4ee5\u70ba\u60a8\u6e96\u5099\u5728\u56f0\u96e3\u96e3\u5ea6\u4e0b\u66f4\u9ad8\u7684\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u89c0\u770b\u5c08\u696d\u73a9\u5bb6\u7684\u904a\u6232\u5f71\u7247\u53ef\u4ee5\u63d0\u4f9b\u5bf6\u8cb4\u7684\u898b\u89e3\u3002"}, {"question": "FNF Flip-Side \u548c\u539f\u7248 Friday Night Funkin' \u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF Flip-Side \u8207\u539f\u7248 Friday Night Funkin' \u6709\u5e7e\u500b\u4e3b\u8981\u5dee\u7570\u3002\u6b65\u9a5f1 - \u65b0\u89d2\u8272\u548c\u66f2\u76ee\uff1aFlip-Side \u64c1\u6709\u539f\u7248\u904a\u6232\u4e2d\u6c92\u6709\u7684\u65b0\u89d2\u8272\u548c\u97f3\u6a02\u3002\u6b65\u9a5f2 - \u904a\u6232\u6a5f\u5236\uff1aFlip-Side \u5305\u542b\u65b0\u7684\u6a5f\u5236\uff0c\u4f8b\u5982\u300e\u7ffb\u8f49\u300f\u529f\u80fd\uff0c\u6703\u52d5\u614b\u6539\u8b8a\u97f3\u7b26\u6a21\u5f0f\u3002\u6b65\u9a5f3 - \u8996\u89ba\u548c\u97f3\u6548\u589e\u5f37\uff1aFlip-Side \u63d0\u4f9b\u6539\u9032\u7684\u5716\u5f62\u548c\u97f3\u6548\u8a2d\u8a08\u3002\u4f8b\u5982\uff0c\u300eFlip-Side Showdown\u300f\u66f2\u76ee\u5c55\u793a\u4e86\u65b0\u7684\u6a5f\u5236\uff0c\u5176\u52d5\u614b\u97f3\u7b26\u6a21\u5f0f\u548c\u7368\u7279\u7684\u8996\u89ba\u6548\u679c\u3002\u6b64\u5916\uff0cFlip-Side \u7684\u96e3\u5ea6\u66f2\u7dda\u66f4\u5177\u6311\u6230\u6027\uff0c\u66f4\u80fd\u5438\u5f15\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u5728 FNF Flip-Side \u7684\u540c\u4e00\u500b\u66f2\u76ee\u4e2d\u5206\u6578\u5dee\u7570\u5982\u6b64\u4e4b\u5927\uff1f", "answer": "\u60a8\u5728 FNF Flip-Side \u4e2d\u7684\u5206\u6578\u5dee\u7570\u53ef\u80fd\u662f\u7531\u4ee5\u4e0b\u5e7e\u500b\u56e0\u7d20\u9020\u6210\u7684\u3002\u6b65\u9a5f1 - \u6642\u9593\u6e96\u78ba\u6027\uff1a\u5b8c\u7f8e\u64ca\u4e2d\u97f3\u7b26\uff08Sick\uff09\u8207\u7565\u5fae\u504f\u96e2\uff08\u597d\uff09\u6703\u5f71\u97ff\u60a8\u7684\u5206\u6578\u3002\u6b65\u9a5f2 - \u9023\u64ca\u500d\u6578\uff1a\u4fdd\u6301\u9ad8\u9023\u64ca\u6578\uff08\u4e0d\u6f0f\u6389\u97f3\u7b26\uff09\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\u3002\u6b65\u9a5f3 - \u96e3\u6613\u5ea6\uff1a\u8f03\u9ad8\u7684\u96e3\u5ea6\u5305\u542b\u66f4\u591a\u97f3\u7b26\uff0c\u56e0\u6b64\u6709\u66f4\u9ad8\u7684\u6f5b\u5728\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300eFlip-Side Frenzy\u300f\u4e2d\uff0c\u6f0f\u6389\u4e00\u500b\u97f3\u7b26\u5c31\u6703\u65b7\u958b\u9023\u64ca\uff0c\u986f\u8457\u964d\u4f4e\u60a8\u7684\u5206\u6578\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u300e\u7df4\u7fd2\u6a21\u5f0f\u300f\u4f86\u5b8c\u7f8e\u4f60\u7684\u6642\u9593\u63a7\u5236\uff0c\u53ef\u4ee5\u6700\u5927\u7a0b\u5ea6\u5730\u6e1b\u5c11\u5206\u6578\u6ce2\u52d5\u3002"}, {"question": "FNF Flip-Side \u7684\u8a08\u5206\u7cfb\u7d71\u904b\u4f5c\u65b9\u5f0f\u70ba\u4f55\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5206\u6578\uff1f", "answer": "FNF Flip-Side \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\u3002\u6b65\u9a5f1 - \u97f3\u7b26\u6e96\u78ba\u5ea6\uff1a\u5b8c\u7f8e\u6642\u6a5f\u64ca\u4e2d\u97f3\u7b26\uff08Sick\uff09\u5f97\u5206\u6bd4\u7565\u6709\u504f\u5dee\uff08\u597d\uff09\u66f4\u9ad8\u3002\u6b65\u9a5f2 - \u9023\u64ca\u500d\u6578\uff1a\u6bcf\u6b21\u9023\u7e8c\u7684\u64ca\u4e2d\u90fd\u6703\u589e\u52a0\u60a8\u7684\u9023\u64ca\u6578\uff0c\u4e26\u76f8\u61c9\u5730\u4e58\u4ee5\u60a8\u7684\u5206\u6578\u3002\u6b65\u9a5f3 - \u6f0f\u6389\u97f3\u7b26\uff1a\u6f0f\u6389\u4e00\u500b\u97f3\u7b26\u6703\u91cd\u7f6e\u60a8\u7684\u9023\u64ca\uff0c\u964d\u4f4e\u60a8\u7684\u6f5b\u5728\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300eFlip-Side Showdown\u300f\u4e2d\uff0c\u5b8c\u7f8e\u6642\u6a5f\u64ca\u4e2d\u6240\u6709\u97f3\u7b26\u53ef\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\uff0c\u800c\u6f0f\u6389\u4e00\u500b\u97f3\u7b26\u5c31\u6703\u5927\u5e45\u964d\u4f4e\u3002\u6b64\u5916\uff0c\u8f03\u9ad8\u7684\u96e3\u5ea6\u7b49\u7d1a\u5305\u542b\u66f4\u591a\u97f3\u7b26\uff0c\u63d0\u4f9b\u66f4\u9ad8\u7684\u6f5b\u5728\u5206\u6578\u3002"}, {"question": "\u4e0d\u540c\u5e73\u53f0\u4e0a FNF Flip-Side \u9806\u66a2\u904b\u884c\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF Flip-Side \u7684\u7cfb\u7d71\u9700\u6c42\u56e0\u5e73\u53f0\u800c\u7570\u3002\u6b65\u9a5f1 - \u96fb\u8166\uff1a\u6700\u4f4e\u9700\u6c42\u5305\u62ec\u96d9\u6838\u5fc3\u8655\u7406\u5668\u30012GB \u8a18\u61b6\u9ad4\u548c DirectX 9 \u76f8\u5bb9\u7684\u986f\u793a\u5361\u3002\u6b65\u9a5f2 - \u79fb\u52d5\u88dd\u7f6e\uff1a\u5c0d\u65bc Android \u548c iOS\uff0c\u5efa\u8b70\u88dd\u7f6e\u81f3\u5c11\u5177\u6709 2GB \u8a18\u61b6\u9ad4\u548c Android 5.0/iOS 10 \u4ee5\u4e0a\u7248\u672c\u3002\u6b65\u9a5f3 - \u4e3b\u6a5f\uff1a\u5728 Nintendo Switch \u7b49\u4e3b\u6a5f\u4e0a\uff0c\u904a\u6232\u5728\u6a19\u6e96\u8a2d\u5b9a\u4e0b\u904b\u4f5c\u9806\u66a2\u3002\u4f8b\u5982\uff0c\u5728\u5177\u5099 Intel i3 \u8655\u7406\u5668\u548c 4GB \u8a18\u61b6\u9ad4\u7684\u96fb\u8166\u4e0a\uff0cFNF Flip-Side \u5728 720p \u89e3\u6790\u5ea6\u4e0b\u904b\u884c\u9806\u66a2\u3002\u6b64\u5916\uff0c\u4f7f\u7528 SSD \u53ef\u4ee5\u7e2e\u77ed\u8f09\u5165\u6642\u9593\u3002"}, {"question": "\u5982\u4f55\u5c07 FNF Flip-Side \u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u8f49\u79fb FNF Flip-Side \u9032\u5ea6\u9700\u8981\u5e7e\u500b\u6b65\u9a5f\u3002\u6b65\u9a5f1 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\uff1a\u5982\u679c\u904a\u6232\u652f\u63f4\u96f2\u7aef\u5132\u5b58\uff0c\u8acb\u5728\u8a2d\u5b9a\u4e2d\u555f\u7528\u5b83\u3002\u6b65\u9a5f2 - \u624b\u52d5\u5099\u4efd\uff1a\u627e\u5230\u88dd\u7f6e\u4e0a\u7684\u5132\u5b58\u6a94\uff08\u901a\u5e38\u5728\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\uff09\uff0c\u4e26\u5c07\u5176\u8907\u88fd\u5230\u65b0\u7684\u88dd\u7f6e\u3002\u6b65\u9a5f3 - \u9084\u539f\uff1a\u5c07\u5132\u5b58\u6a94\u653e\u7f6e\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u5c0d\u61c9\u7684\u76ee\u9304\u4e2d\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\uff0c\u5132\u5b58\u6a94\u901a\u5e38\u4f4d\u65bc\u300eAppData\u300f\u8cc7\u6599\u593e\u4e2d\u3002\u6b64\u5916\uff0c\u4f7f\u7528 USB \u96a8\u8eab\u789f\u6216 Google \u96f2\u7aef\u786c\u789f\u7b49\u96f2\u7aef\u5132\u5b58\u670d\u52d9\u53ef\u4ee5\u4fc3\u9032\u8f49\u79fb\u3002"}, {"question": "\u6211\u5728 FNF Flip-Side \u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "FNF Flip-Side \u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u6b65\u9a5f1 - \u79d8\u5bc6\u66f2\u76ee\uff1a\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u8f38\u5165\u5bc6\u78bc\u53ef\u4ee5\u89e3\u9396\u67d0\u4e9b\u66f2\u76ee\u3002\u6b65\u9a5f2 - \u96b1\u85cf\u89d2\u8272\uff1a\u5728\u7279\u5b9a\u66f2\u76ee\u4e2d\u7372\u5f97\u9ad8\u5206\u53ef\u4ee5\u89e3\u9396\u67d0\u4e9b\u89d2\u8272\u3002\u6b65\u9a5f3 - \u8996\u89ba\u5f69\u86cb\uff1a\u6ce8\u610f\u80cc\u666f\u7d30\u7bc0\u548c\u52d5\u756b\uff0c\u4ee5\u7372\u5f97\u5176\u4ed6\u904a\u6232\u6216\u6d41\u884c\u6587\u5316\u7684\u5fae\u5999\u81f4\u656c\u3002\u4f8b\u5982\uff0c\u5728\u300eFlip-Side Showdown\u300f\u4e2d\uff0c\u7372\u5f97\u5b8c\u7f8e\u5206\u6578\u53ef\u4ee5\u89e3\u9396\u5177\u6709\u7368\u7279\u5c0d\u767d\u7684\u79d8\u5bc6\u89d2\u8272\u3002\u6b64\u5916\uff0c\u63a2\u7d22\u904a\u6232\u6a94\u6848\u53ef\u4ee5\u767c\u73fe\u96b1\u85cf\u8cc7\u7522\u548c\u672a\u4f7f\u7528\u7684\u5167\u5bb9\u3002"}]
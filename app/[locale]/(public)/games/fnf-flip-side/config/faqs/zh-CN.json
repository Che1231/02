[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624bFNF Flip-Side\u65b0\u624b\u6559\u7a0b\uff1f", "answer": "\u5feb\u901f\u4e0a\u624bFNF Flip-Side\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4\u4e00 - \u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528\u65b9\u5411\u952e\u6216WASD\u952e\uff0c\u6839\u636e\u97f3\u4e50\u8282\u594f\u51fb\u6253\u97f3\u7b26\u3002\u6b65\u9aa4\u4e8c - \u4ece\"\u6559\u7a0b\"\u6a21\u5f0f\u5f00\u59cb\uff0c\u4e86\u89e3\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa4\u4e09 - \u5728\u7b80\u5355\u7684\u66f2\u76ee\u6bd4\u5982\"\u6559\u7a0b\"\u6216\"\u6559\u7a0b\u91cd\u5236\"\u4e0a\u7ec3\u4e60\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002\u4f8b\u5982\uff0c\u5728\"\u6559\u7a0b\u91cd\u5236\"\u4e2d\uff0c\u97f3\u7b26\u901f\u5ea6\u8f83\u6162\u4e14\u66f4\u6709\u5bb9\u9519\u6027\uff0c\u975e\u5e38\u9002\u5408\u65b0\u624b\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u914d\u7f6e\u8bbe\u7f6e\u6765\u8c03\u6574\u97f3\u7b26\u901f\u5ea6\u548c\u6309\u952e\u7ed1\u5b9a\uff0c\u4ee5\u6ee1\u8db3\u60a8\u7684\u559c\u597d\u3002"}, {"question": "\u63d0\u9ad8FNF Flip-Side\u51c6\u786e\u7387\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u63d0\u9ad8FNF Flip-Side\u7684\u51c6\u786e\u7387\u9700\u8981\u7ed3\u5408\u7ec3\u4e60\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00 - \u4e13\u6ce8\u4e8e\u97f3\u4e50\u7684\u8282\u594f\uff0c\u800c\u4e0d\u662f\u4ec5\u4ec5\u5173\u6ce8\u97f3\u7b26\u3002\u6b65\u9aa4\u4e8c - \u4f7f\u7528\"\u7ec3\u4e60\u6a21\u5f0f\"\u53cd\u590d\u7ec3\u4e60\u56f0\u96be\u90e8\u5206\uff0c\u76f4\u5230\u638c\u63e1\u4e3a\u6b62\u3002\u6b65\u9aa4\u4e09 - \u8c03\u6574\u8bbe\u7f6e\u4e2d\u7684\u97f3\u7b26\u901f\u5ea6\u5230\u4e00\u4e2a\u8212\u9002\u7684\u6c34\u5e73\uff1b\u8f83\u6162\u7684\u901f\u5ea6\u53ef\u4ee5\u5e2e\u52a9\u60a8\u4e13\u6ce8\u4e8e\u8282\u594f\u3002\u4f8b\u5982\uff0c\u5728\"Flip-Side Showdown\"\u66f2\u76ee\u4e2d\uff0c\u7ec3\u4e60\u5feb\u901f\u7684\u97f3\u7b26\u7ec4\u5408\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u51c6\u786e\u7387\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u8282\u62cd\u5668\u5e94\u7528\u7a0b\u5e8f\u53ef\u4ee5\u5e2e\u52a9\u60a8\u5185\u5316\u8282\u594f\u3002"}, {"question": "\u4e3a\u4e86\u4f18\u5316FNF Flip-Side\u5728\u4f4e\u914d\u7f6e\u7535\u8111\u4e0a\u7684\u4f53\u9a8c\uff0c\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316FNF Flip-Side\u5728\u4f4e\u7aefPC\u4e0a\u7684\u6027\u80fd\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4\u4e00 - \u5728\u9009\u9879\u83dc\u5355\u4e2d\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4f8b\u5982\u964d\u4f4e\u5206\u8fa8\u7387\u548c\u7981\u7528\u9634\u5f71\u3002\u6b65\u9aa4\u4e8c - \u5173\u95ed\u4e0d\u5fc5\u8981\u7684\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\uff0c\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6b65\u9aa4\u4e09 - \u5982\u679c\u53ef\u7528\uff0c\u8bf7\u4f7f\u7528\"\u6027\u80fd\u6a21\u5f0f\"\uff0c\u5b83\u53ef\u4ee5\u51cf\u5c11\u56fe\u5f62\u8d1f\u8f7d\u3002\u4f8b\u5982\uff0c\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230720p\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6027\u80fd\uff0c\u800c\u4e0d\u4f1a\u5bf9\u6e38\u620f\u4f53\u9a8c\u9020\u6210\u91cd\u5927\u5f71\u54cd\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u8f7b\u91cf\u7ea7\u64cd\u4f5c\u7cfb\u7edf\u53ef\u4ee5\u8fdb\u4e00\u6b65\u63d0\u9ad8\u6027\u80fd\u3002"}, {"question": "\u5982\u4f55\u5728FNF Flip-Side\u4e2d\u4ece\u7b80\u5355\u96be\u5ea6\u8fc7\u6e21\u5230\u56f0\u96be\u96be\u5ea6\uff1f", "answer": "\u5728FNF Flip-Side\u4e2d\u4ece\u7b80\u5355\u96be\u5ea6\u8fc7\u6e21\u5230\u56f0\u96be\u96be\u5ea6\u9700\u8981\u5faa\u5e8f\u6e10\u8fdb\u7684\u7ec3\u4e60\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00 - \u4ece\u638c\u63e1\u6240\u6709\u7b80\u5355\u96be\u5ea6\u7684\u66f2\u76ee\u5f00\u59cb\uff0c\u5efa\u7acb\u575a\u5b9e\u7684\u57fa\u7840\u3002\u6b65\u9aa4\u4e8c - \u8f6c\u5230\u4e2d\u7b49\u96be\u5ea6\uff0c\u4e13\u6ce8\u4e8e\u63d0\u9ad8\u60a8\u7684\u53cd\u5e94\u65f6\u95f4\u548c\u51c6\u786e\u7387\u3002\u6b65\u9aa4\u4e09 - \u4f7f\u7528\"\u7ec3\u4e60\u6a21\u5f0f\"\u6765\u5e94\u5bf9\u56f0\u96be\u96be\u5ea6\u4e2d\u7684\u6311\u6218\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5728\"Flip-Side Frenzy\"\u66f2\u76ee\u4e2d\uff0c\u5728\u4e2d\u7b49\u96be\u5ea6\u4e0a\u7ec3\u4e60\u590d\u6742\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u53ef\u4ee5\u5e2e\u52a9\u60a8\u4e3a\u56f0\u96be\u96be\u5ea6\u4e2d\u589e\u52a0\u7684\u901f\u5ea6\u505a\u597d\u51c6\u5907\u3002\u6b64\u5916\uff0c\u89c2\u770b\u4e13\u5bb6\u73a9\u5bb6\u7684\u6e38\u620f\u89c6\u9891\u53ef\u4ee5\u63d0\u4f9b\u5b9d\u8d35\u7684\u89c1\u89e3\u3002"}, {"question": "FNF Flip-Side\u548c\u539f\u7248Friday Night Funkin' \u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "FNF Flip-Side\u4e0e\u539f\u7248Friday Night Funkin'\u5f15\u5165\u4e86\u51e0\u4e2a\u5173\u952e\u5dee\u5f02\u3002\u6b65\u9aa4\u4e00 - \u65b0\u89d2\u8272\u548c\u66f2\u76ee\uff1aFlip-Side\u62e5\u6709\u539f\u7248\u6e38\u620f\u4e2d\u6ca1\u6709\u7684\u65b0\u89d2\u8272\u548c\u97f3\u4e50\u3002\u6b65\u9aa4\u4e8c - \u6e38\u620f\u673a\u5236\uff1aFlip-Side\u5305\u542b\u65b0\u7684\u673a\u5236\uff0c\u4f8b\u5982\"\u7ffb\u8f6c\"\u529f\u80fd\uff0c\u5b83\u4f1a\u52a8\u6001\u5730\u6539\u53d8\u97f3\u7b26\u6a21\u5f0f\u3002\u6b65\u9aa4\u4e09 - \u56fe\u5f62\u548c\u97f3\u9891\u589e\u5f3a\uff1aFlip-Side\u63d0\u4f9b\u6539\u8fdb\u7684\u56fe\u5f62\u548c\u58f0\u97f3\u8bbe\u8ba1\u3002\u4f8b\u5982\uff0c\"Flip-Side Showdown\"\u66f2\u76ee\u5c55\u793a\u4e86\u5176\u52a8\u6001\u97f3\u7b26\u6a21\u5f0f\u548c\u72ec\u7279\u7684\u89c6\u89c9\u6548\u679c\u7684\u65b0\u673a\u5236\u3002\u6b64\u5916\uff0cFlip-Side\u5177\u6709\u66f4\u5177\u6311\u6218\u6027\u7684\u96be\u5ea6\u66f2\u7ebf\uff0c\u5438\u5f15\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5728FNF Flip-Side\u540c\u4e00\u66f2\u76ee\u4e0a\u7684\u5206\u6570\u6ce2\u52a8\u8fd9\u4e48\u5927\uff1f", "answer": "FNF Flip-Side\u4e2d\u5206\u6570\u6ce2\u52a8\u7684\u539f\u56e0\u6709\u5f88\u591a\u3002\u6b65\u9aa4\u4e00 - \u8282\u594f\u51c6\u786e\u6027\uff1a\u5b8c\u7f8e\u51fb\u6253\u97f3\u7b26\uff08Sick\uff09\u4e0e\u7a0d\u5fae\u504f\u79bb\uff08Good\uff09\u4f1a\u5f71\u54cd\u60a8\u7684\u5206\u6570\u3002\u6b65\u9aa4\u4e8c - \u8fde\u51fb\u500d\u7387\uff1a\u4fdd\u6301\u9ad8\u8fde\u51fb\u6570\uff08\u4e0d\u6f0f\u6389\u97f3\u7b26\uff09\u4f1a\u589e\u52a0\u60a8\u7684\u5206\u6570\u3002\u6b65\u9aa4\u4e09 - \u96be\u5ea6\u7b49\u7ea7\uff1a\u66f4\u9ad8\u7684\u96be\u5ea6\u5305\u542b\u66f4\u591a\u97f3\u7b26\uff0c\u56e0\u6b64\u5177\u6709\u66f4\u9ad8\u7684\u6f5c\u5728\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\"Flip-Side Frenzy\"\u4e2d\uff0c\u6f0f\u6389\u4e00\u4e2a\u97f3\u7b26\u5c31\u4f1a\u6253\u65ad\u4f60\u7684\u8fde\u51fb\uff0c\u5e76\u663e\u8457\u964d\u4f4e\u4f60\u7684\u5206\u6570\u3002\u6b64\u5916\uff0c\u4f7f\u7528\"\u7ec3\u4e60\u6a21\u5f0f\"\u6765\u78e8\u7ec3\u60a8\u7684\u8282\u594f\u53ef\u4ee5\u5e2e\u52a9\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u5206\u6570\u5dee\u5f02\u3002"}, {"question": "FNF Flip-Side\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "FNF Flip-Side\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\u3002\u6b65\u9aa4\u4e00 - \u97f3\u7b26\u51c6\u786e\u7387\uff1a\u5b8c\u7f8e\u51fb\u4e2d\u97f3\u7b26\uff08Sick\uff09\u6bd4\u7a0d\u5fae\u504f\u79bb\uff08Good\uff09\u5f97\u5206\u66f4\u9ad8\u3002\u6b65\u9aa4\u4e8c - \u8fde\u51fb\u500d\u7387\uff1a\u6bcf\u6b21\u8fde\u7eed\u51fb\u4e2d\u90fd\u4f1a\u589e\u52a0\u60a8\u7684\u8fde\u51fb\u6570\uff0c\u4ece\u800c\u589e\u52a0\u60a8\u7684\u5206\u6570\u3002\u6b65\u9aa4\u4e09 - \u6f0f\u6389\u97f3\u7b26\uff1a\u6f0f\u6389\u4e00\u4e2a\u97f3\u7b26\u4f1a\u91cd\u7f6e\u8fde\u51fb\uff0c\u964d\u4f4e\u60a8\u7684\u6f5c\u5728\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5728\"Flip-Side Showdown\"\u4e2d\uff0c\u5b8c\u7f8e\u51fb\u4e2d\u6240\u6709\u97f3\u7b26\u53ef\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5206\u6570\uff0c\u800c\u6f0f\u6389\u4e00\u4e2a\u5219\u4f1a\u663e\u8457\u964d\u4f4e\u5b83\u3002\u6b64\u5916\uff0c\u66f4\u9ad8\u7684\u96be\u5ea6\u7b49\u7ea7\u5305\u542b\u66f4\u591a\u97f3\u7b26\uff0c\u63d0\u4f9b\u66f4\u9ad8\u7684\u6f5c\u5728\u5206\u6570\u3002"}, {"question": "FNF Flip-Side\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u6d41\u7545\u8fd0\u884c\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "FNF Flip-Side\u7684\u7cfb\u7edf\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u6b65\u9aa4\u4e00 - PC\uff1a\u6700\u4f4e\u8981\u6c42\u5305\u62ec\u53cc\u6838\u5904\u7406\u5668\u30012GB RAM\u548c\u517c\u5bb9DirectX 9\u7684GPU\u3002\u6b65\u9aa4\u4e8c - \u79fb\u52a8\u7aef\uff1a\u5bf9\u4e8eAndroid\u548ciOS\uff0c\u5efa\u8bae\u4f7f\u7528\u81f3\u5c112GB RAM\u548cAndroid 5.0/iOS 10\u53ca\u4ee5\u4e0a\u7248\u672c\u7684\u8bbe\u5907\u3002\u6b65\u9aa4\u4e09 - \u6e38\u620f\u4e3b\u673a\uff1a\u5728Nintendo Switch\u7b49\u6e38\u620f\u4e3b\u673a\u4e0a\uff0c\u8be5\u6e38\u620f\u5728\u6807\u51c6\u8bbe\u7f6e\u4e0b\u8fd0\u884c\u6d41\u7545\u3002\u4f8b\u5982\uff0c\u5728\u914d\u5907\u82f1\u7279\u5c14i3\u5904\u7406\u5668\u548c4GB RAM\u7684PC\u4e0a\uff0cFNF Flip-Side\u53ef\u4ee5\u5728720p\u5206\u8fa8\u7387\u4e0b\u6d41\u7545\u8fd0\u884c\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u56fa\u6001\u786c\u76d8\u53ef\u4ee5\u51cf\u5c11\u52a0\u8f7d\u65f6\u95f4\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684FNF Flip-Side\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5c06FNF Flip-Side\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u9700\u8981\u51e0\u4e2a\u6b65\u9aa4\u3002\u6b65\u9aa4\u4e00 - \u4f7f\u7528\u4e91\u5b58\u6863\uff1a\u5982\u679c\u6e38\u620f\u652f\u6301\u4e91\u5b58\u6863\uff0c\u8bf7\u5728\u8bbe\u7f6e\u4e2d\u542f\u7528\u5b83\u3002\u6b65\u9aa4\u4e8c - \u624b\u52a8\u5907\u4efd\uff1a\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\u627e\u5230\u5b58\u6863\u6587\u4ef6\uff08\u901a\u5e38\u5728\u6e38\u620f\u5b89\u88c5\u76ee\u5f55\u4e2d\uff09\uff0c\u5e76\u5c06\u5b83\u4eec\u590d\u5236\u5230\u65b0\u8bbe\u5907\u4e0a\u3002\u6b65\u9aa4\u4e09 - \u6062\u590d\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u7684\u76f8\u5e94\u76ee\u5f55\u4e2d\u653e\u7f6e\u5b58\u6863\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u5b58\u6863\u6587\u4ef6\u901a\u5e38\u4f4d\u4e8e\"AppData\"\u6587\u4ef6\u5939\u4e2d\u3002\u6b64\u5916\uff0c\u4f7f\u7528U\u76d8\u6216\u4e91\u5b58\u50a8\u670d\u52a1\uff08\u5982Google Drive\uff09\u53ef\u4ee5\u4fc3\u8fdb\u4f20\u8f93\u3002"}, {"question": "\u5728FNF Flip-Side\u4e2d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "FNF Flip-Side\u5145\u6ee1\u4e86\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u6b65\u9aa4\u4e00 - \u79d8\u5bc6\u66f2\u76ee\uff1a\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u8f93\u5165\u4f5c\u5f0a\u7801\u53ef\u4ee5\u89e3\u9501\u67d0\u4e9b\u66f2\u76ee\u3002\u6b65\u9aa4\u4e8c - \u9690\u85cf\u89d2\u8272\uff1a\u901a\u8fc7\u5728\u7279\u5b9a\u66f2\u76ee\u4e0a\u83b7\u5f97\u9ad8\u5206\u53ef\u4ee5\u89e3\u9501\u67d0\u4e9b\u89d2\u8272\u3002\u6b65\u9aa4\u4e09 - \u89c6\u89c9\u5f69\u86cb\uff1a\u5173\u6ce8\u80cc\u666f\u7ec6\u8282\u548c\u52a8\u753b\uff0c\u4ee5\u53d1\u73b0\u5bf9\u5176\u4ed6\u6e38\u620f\u6216\u6d41\u884c\u6587\u5316\u7684\u5fae\u5999\u81f4\u656c\u3002\u4f8b\u5982\uff0c\u5728\"Flip-Side Showdown\"\u4e2d\uff0c\u83b7\u5f97\u5b8c\u7f8e\u5f97\u5206\u53ef\u4ee5\u89e3\u9501\u5177\u6709\u72ec\u7279\u5bf9\u8bdd\u7684\u79d8\u5bc6\u89d2\u8272\u3002\u6b64\u5916\uff0c\u63a2\u7d22\u6e38\u620f\u7684\u6587\u4ef6\u53ef\u4ee5\u63ed\u793a\u9690\u85cf\u7684\u8d44\u4ea7\u548c\u672a\u4f7f\u7528\u7684\u5185\u5bb9\u3002"}]
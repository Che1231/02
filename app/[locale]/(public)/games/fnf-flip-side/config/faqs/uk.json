[{"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u0448\u0432\u0438\u0434\u043a\u043e \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0433\u0440\u0443 FNF Flip-Side \u044f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a?", "answer": "\u0429\u043e\u0431 \u0448\u0432\u0438\u0434\u043a\u043e \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0433\u0440\u0443 FNF Flip-Side, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457: \u041a\u0420\u041e\u041a 1 \u2013 \u041e\u0437\u043d\u0430\u0439\u043e\u043c\u0442\u0435\u0441\u044f \u0437 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c\u0438 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438: \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u0430\u0431\u043e \u043a\u043b\u0430\u0432\u0456\u0448\u0456 WASD, \u0449\u043e\u0431 \u0432\u0447\u0430\u0441\u043d\u043e \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u0442\u0438 \u043d\u043e\u0442\u0438 \u043f\u0456\u0434 \u043c\u0443\u0437\u0438\u043a\u0443. \u041a\u0420\u041e\u041a 2 \u2013 \u041d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u043e\u0439\u0434\u0456\u0442\u044c \u0440\u0435\u0436\u0438\u043c \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\", \u0449\u043e\u0431 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u0442\u0438 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0443 \u0433\u0440\u0438. \u041a\u0420\u041e\u041a 3 \u2013 \u041f\u043e\u0442\u0440\u0435\u043d\u0443\u0439\u0442\u0435\u0441\u044f \u043d\u0430 \u043b\u0435\u0433\u043a\u0438\u0445 \u0442\u0440\u0435\u043a\u0430\u0445, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\" \u0430\u0431\u043e \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f Remix\", \u0449\u043e\u0431 \u043d\u0430\u0431\u0443\u0442\u0438 \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u0456 Remix\" \u043d\u043e\u0442\u0438 \u043f\u043e\u0432\u0456\u043b\u044c\u043d\u0456\u0448\u0456 \u0442\u0430 \u043f\u0440\u043e\u0449\u0430\u044e\u0442\u044c \u043f\u043e\u043c\u0438\u043b\u043a\u0438, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u0439\u043e\u0433\u043e \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0434\u043b\u044f \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457, \u0449\u043e\u0431 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043d\u043e\u0442 \u0442\u0430 \u043f\u0440\u0438\u0432'\u044f\u0437\u043a\u0443 \u043a\u043b\u0430\u0432\u0456\u0448 \u0437\u0430 \u0432\u043b\u0430\u0441\u043d\u0438\u043c \u0431\u0430\u0436\u0430\u043d\u043d\u044f\u043c."}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457, \u0449\u043e\u0431 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0443 \u0433\u0440\u0456 FNF Flip-Side?", "answer": "\u041f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456 \u0443 \u0433\u0440\u0456 FNF Flip-Side \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u043f\u043e\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0442\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457. \u041a\u0420\u041e\u041a 1 \u2013 \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0440\u0438\u0442\u043c\u0456 \u043c\u0443\u0437\u0438\u043a\u0438, \u0430 \u043d\u0435 \u043b\u0438\u0448\u0435 \u043d\u0430 \u043d\u043e\u0442\u0430\u0445. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0440\u0435\u0436\u0438\u043c \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\", \u0449\u043e\u0431 \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438, \u0434\u043e\u043a\u0438 \u043d\u0435 \u043e\u043f\u0430\u043d\u0443\u0454\u0442\u0435 \u0457\u0445. \u041a\u0420\u041e\u041a 3 \u2013 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043d\u043e\u0442 \u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u0434\u043e \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f; \u043c\u0435\u043d\u0448\u0430 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044c \u043d\u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u0442\u0440\u0435\u043a\u0443 \"Flip-Side Showdown\" \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u0448\u0432\u0438\u0434\u043a\u0438\u0445 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u043d\u043e\u0442 \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043c\u0435\u0442\u0440\u043e\u043d\u043e\u043c\u0430 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u0432\u0456\u0434\u0447\u0443\u0442\u0438 \u0440\u0438\u0442\u043c."}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0435\u043d\u0456 \u0441\u043b\u0456\u0434 \u0437\u043c\u0456\u043d\u0438\u0442\u0438, \u0449\u043e\u0431 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0443 FNF Flip-Side \u043d\u0430 \u0441\u043b\u0430\u0431\u043a\u043e\u043c\u0443 \u041f\u041a?", "answer": "\u0429\u043e\u0431 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0443 FNF Flip-Side \u043d\u0430 \u0441\u043b\u0430\u0431\u043a\u043e\u043c\u0443 \u041f\u041a, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457: \u041a\u0420\u041e\u041a 1 \u2013 \u0417\u043c\u0435\u043d\u0448\u0456\u0442\u044c \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043e\u043a, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u043c\u0435\u043d\u0448\u0456\u0442\u044c \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u0443 \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0432\u0438\u043c\u043a\u043d\u0456\u0442\u044c \u0442\u0456\u043d\u0456. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u043a\u043b\u044e\u0447\u0456\u0442\u044c \u0437\u0430\u0439\u0432\u0456 \u0444\u043e\u043d\u043e\u0432\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438, \u0449\u043e\u0431 \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438. \u041a\u0420\u041e\u041a 3 \u2013 \u042f\u043a\u0449\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0440\u0435\u0436\u0438\u043c \"\u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f\", \u044f\u043a\u0438\u0439 \u0437\u043c\u0435\u043d\u0448\u0443\u0454 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0435 \u043d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u043d\u0438\u0436\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u043e\u0457 \u0437\u0434\u0430\u0442\u043d\u043e\u0441\u0442\u0456 \u0434\u043e 720p \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0431\u0435\u0437 \u0441\u0443\u0442\u0442\u0454\u0432\u043e\u0433\u043e \u0432\u043f\u043b\u0438\u0432\u0443 \u043d\u0430 \u043f\u0440\u043e\u0446\u0435\u0441 \u0433\u0440\u0438. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043b\u0435\u0433\u043a\u043e\u0457 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0439\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043c\u043e\u0436\u0435 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e \u043f\u043e\u043b\u0456\u043f\u0448\u0438\u0442\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c."}, {"question": "\u042f\u043a \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432\u0456\u0434 \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0434\u043e \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0432 \u0433\u0440\u0456 FNF Flip-Side?", "answer": "\u041f\u0435\u0440\u0435\u0445\u0456\u0434 \u0432\u0456\u0434 \u043b\u0435\u0433\u043a\u043e\u0433\u043e \u0434\u043e \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0432 \u0433\u0440\u0456 FNF Flip-Side \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 \u0442\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e. \u041a\u0420\u041e\u041a 1 \u2013 \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0437 \u043e\u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u0432\u0441\u0456\u043c\u0430 \u0442\u0440\u0435\u043a\u0430\u043c\u0438 \u043d\u0430 \u043b\u0435\u0433\u043a\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043c\u0456\u0446\u043d\u0443 \u043e\u0441\u043d\u043e\u0432\u0443. \u041a\u0420\u041e\u041a 2 \u2013 \u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u0434\u043e \u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u0456 \u0447\u0430\u0441\u0443 \u0440\u0435\u0430\u043a\u0446\u0456\u0457 \u0442\u0430 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0440\u0435\u0436\u0438\u043c \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\", \u0449\u043e\u0431 \u043f\u043e\u0434\u043e\u043b\u0430\u0442\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438 \u043d\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432 \u0442\u0440\u0435\u043a\u0443 \"Flip-Side Frenzy\" \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u0445 \u043f\u0430\u0442\u0435\u0440\u043d\u0456\u0432 \u043d\u043e\u0442 \u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u043c\u043e\u0436\u0435 \u043f\u0456\u0434\u0433\u043e\u0442\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0441 \u0434\u043e \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u043d\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u043c\u0443. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0432\u0456\u0434\u0435\u043e\u0456\u0433\u043e\u0440 \u0435\u043a\u0441\u043f\u0435\u0440\u0442\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043c\u043e\u0436\u0435 \u043d\u0430\u0434\u0430\u0442\u0438 \u0446\u0456\u043d\u043d\u0456 \u043f\u043e\u0440\u0430\u0434\u0438."}, {"question": "\u0423 \u0447\u043e\u043c\u0443 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 FNF Flip-Side \u0442\u0430 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u043c Friday Night Funkin'?", "answer": "FNF Flip-Side \u0432\u043d\u043e\u0441\u0438\u0442\u044c \u043a\u0456\u043b\u044c\u043a\u0430 \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u0445 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0435\u0439 \u0432\u0456\u0434 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e Friday Night Funkin'. \u041a\u0420\u041e\u041a 1 \u2013 \u041d\u043e\u0432\u0456 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0456 \u0442\u0430 \u0442\u0440\u0435\u043a\u0438: Flip-Side \u043c\u0430\u0454 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0456\u0432 \u0442\u0430 \u043c\u0443\u0437\u0438\u043a\u0443, \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u0456 \u0432 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0456\u0439 \u0433\u0440\u0456. \u041a\u0420\u041e\u041a 2 \u2013 \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u0433\u0440\u0438: Flip-Side \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u043d\u043e\u0432\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a \u0444\u0443\u043d\u043a\u0446\u0456\u044f \"\u041f\u0435\u0440\u0435\u0432\u0435\u0440\u0442\u0430\u043d\u043d\u044f\", \u044f\u043a\u0430 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u043e \u0437\u043c\u0456\u043d\u044e\u0454 \u043f\u0430\u0442\u0435\u0440\u043d\u0438 \u043d\u043e\u0442. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0456 \u0442\u0430 \u0437\u0432\u0443\u043a\u043e\u0432\u0456 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f: Flip-Side \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0435 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u0432\u0443\u043a\u043e\u0432\u0438\u0439 \u0434\u0438\u0437\u0430\u0439\u043d. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0442\u0440\u0435\u043a \"Flip-Side Showdown\" \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0443\u0454 \u043d\u043e\u0432\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438 \u0437 \u0434\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0438\u043c\u0438 \u043f\u0430\u0442\u0435\u0440\u043d\u0430\u043c\u0438 \u043d\u043e\u0442 \u0442\u0430 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0435\u0444\u0435\u043a\u0442\u0430\u043c\u0438. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, Flip-Side \u043c\u0430\u0454 \u0431\u0456\u043b\u044c\u0448 \u0441\u043a\u043b\u0430\u0434\u043d\u0443 \u043a\u0440\u0438\u0432\u0443 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456, \u043f\u0440\u0438\u0432\u0430\u0431\u043b\u0438\u0432\u0443 \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432."}, {"question": "\u0427\u043e\u043c\u0443 \u043c\u0456\u0439 \u0431\u0430\u043b \u0442\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043e\u0434\u043d\u043e\u043c\u0443 \u0456 \u0442\u043e\u043c\u0443 \u0436 \u0442\u0440\u0435\u043a\u0443 \u0432 FNF Flip-Side?", "answer": "\u0412\u0430\u0448 \u0431\u0430\u043b \u0443 FNF Flip-Side \u043c\u043e\u0436\u0435 \u0437\u043c\u0456\u043d\u044e\u0432\u0430\u0442\u0438\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u043a\u0456\u043b\u044c\u043a\u0430 \u0444\u0430\u043a\u0442\u043e\u0440\u0456\u0432. \u041a\u0420\u041e\u041a 1 \u2013 \u0422\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0432\u043b\u0443\u0447\u0435\u043d\u044c: \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043d\u043e\u0442 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e (\u0427\u0443\u0434\u043e\u0432\u043e) \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043e \u0437 \u043b\u0435\u0433\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0430\u0445\u043e\u043c (\u0414\u043e\u0431\u0440\u0435) \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0432\u0430\u0448 \u0431\u0430\u043b. \u041a\u0420\u041e\u041a 2 \u2013 \u041c\u043d\u043e\u0436\u043d\u0438\u043a \u043a\u043e\u043c\u0431\u043e: \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u043a\u043e\u043c\u0431\u043e, \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u044e\u0447\u0438 \u043d\u043e\u0442\u0438, \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0432\u0430\u0448 \u0431\u0430\u043b. \u041a\u0420\u041e\u041a 3 \u2013 \u0420\u0456\u0432\u0435\u043d\u044c \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456: \u041d\u0430 \u0432\u0438\u0449\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u043e\u0442, \u0430 \u043e\u0442\u0436\u0435, \u0432\u0438\u0449\u0438\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u0438\u0439 \u0431\u0430\u043b. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \"Flip-Side Frenzy\" \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u0456\u0454\u0457 \u043d\u043e\u0442\u0438 \u043c\u043e\u0436\u0435 \u0440\u043e\u0437\u0456\u0440\u0432\u0430\u0442\u0438 \u043a\u043e\u043c\u0431\u043e \u0442\u0430 \u0437\u043d\u0430\u0447\u043d\u043e \u0437\u043d\u0438\u0437\u0438\u0442\u0438 \u0432\u0430\u0448 \u0431\u0430\u043b. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0440\u0435\u0436\u0438\u043c\u0443 \"\u0422\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\" \u0434\u043b\u044f \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u043e\u0457 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043c\u0456\u043d\u0456\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u043b\u0438\u0432\u0430\u043d\u043d\u044f \u0431\u0430\u043b\u0456\u0432."}, {"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0432 FNF Flip-Side, \u0456 \u0449\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0438\u0439 \u0431\u0430\u043b?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0432 FNF Flip-Side \u0431\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u0445. \u041a\u0420\u041e\u041a 1 \u2013 \u0422\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0432\u043b\u0443\u0447\u0435\u043d\u044c: \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u043d\u043e\u0442 \u0437 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0447\u0430\u0441\u043e\u043c (\u0427\u0443\u0434\u043e\u0432\u043e) \u0434\u0430\u0454 \u0432\u0438\u0449\u0438\u0439 \u0431\u0430\u043b, \u043d\u0456\u0436 \u0442\u0440\u043e\u0445\u0438 \u043f\u0440\u043e\u043c\u0430\u0445 (\u0414\u043e\u0431\u0440\u0435). \u041a\u0420\u041e\u041a 2 \u2013 \u041c\u043d\u043e\u0436\u043d\u0438\u043a \u043a\u043e\u043c\u0431\u043e: \u043a\u043e\u0436\u043d\u0435 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0435 \u0432\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0432\u0430\u0448\u0435 \u043a\u043e\u043c\u0431\u043e, \u043c\u043d\u043e\u0436\u0430\u0447\u0438 \u0432\u0430\u0448 \u0431\u0430\u043b. \u041a\u0420\u041e\u041a 3 \u2013 \u041f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0439 \u043d\u043e\u0442\u0438: \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u043d\u043e\u0442\u0438 \u0441\u043a\u0438\u0434\u0430\u0454 \u043a\u043e\u043c\u0431\u043e, \u0437\u043c\u0435\u043d\u0448\u0443\u044e\u0447\u0438 \u0432\u0430\u0448 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u0438\u0439 \u0431\u0430\u043b. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432 \u0442\u0440\u0435\u043a\u0443 \"Flip-Side Showdown\" \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u0445 \u043d\u043e\u0442 \u0437 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0447\u0430\u0441\u043e\u043c \u043c\u043e\u0436\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448 \u0431\u0430\u043b, \u0442\u043e\u0434\u0456 \u044f\u043a \u043f\u0440\u043e\u043f\u0443\u0441\u043a \u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u0456\u0454\u0457 \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u0437\u043d\u0438\u0437\u0438\u0442\u0438 \u0439\u043e\u0433\u043e. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u0449\u0456 \u0440\u0456\u0432\u043d\u0456 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u043c\u0430\u044e\u0442\u044c \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u043e\u0442, \u0449\u043e \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u0432\u0438\u0449\u0438\u0439 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u0438\u0439 \u0431\u0430\u043b."}, {"question": "\u042f\u043a\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0432\u0438\u043c\u043e\u0433\u0438 \u0434\u043b\u044f \u043f\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443 FNF Flip-Side \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0432\u0438\u043c\u043e\u0433\u0438 \u0434\u043b\u044f FNF Flip-Side \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c\u0441\u044f \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0438. \u041a\u0420\u041e\u041a 1 \u2013 \u041f\u041a: \u041c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0456 \u0432\u0438\u043c\u043e\u0433\u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0434\u0432\u043e\u044f\u0434\u0435\u0440\u043d\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u043e\u0440, 2 \u0413\u0411 \u041e\u0417\u041f \u0442\u0430 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u043e\u0440, \u0441\u0443\u043c\u0456\u0441\u043d\u0438\u0439 \u0437 DirectX 9. \u041a\u0420\u041e\u041a 2 \u2013 \u041c\u043e\u0431\u0456\u043b\u044c\u043d\u0456: \u0434\u043b\u044f Android \u0442\u0430 iOS \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0437 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 2 \u0413\u0411 \u041e\u0417\u041f \u0442\u0430 Android 5.0/iOS 10. \u041a\u0420\u041e\u041a 3 \u2013 \u041a\u043e\u043d\u0441\u043e\u043b\u0456: \u043d\u0430 \u043a\u043e\u043d\u0441\u043e\u043b\u044f\u0445, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a Nintendo Switch, \u0433\u0440\u0430 \u043f\u0440\u0430\u0446\u044e\u0454 \u043f\u043b\u0430\u0432\u043d\u043e \u0437 \u0442\u0438\u043f\u043e\u0432\u0438\u043c\u0438 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u041f\u041a \u0437 \u043f\u0440\u043e\u0446\u0435\u0441\u043e\u0440\u043e\u043c Intel i3 \u0442\u0430 4 \u0413\u0411 \u041e\u0417\u041f FNF Flip-Side \u043f\u0440\u0430\u0446\u044e\u0454 \u043f\u043b\u0430\u0432\u043d\u043e \u0437 \u0440\u043e\u0437\u0434\u0456\u043b\u044c\u043d\u043e\u044e \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044e 720p. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f SSD \u043c\u043e\u0436\u0435 \u0437\u043c\u0435\u043d\u0448\u0438\u0442\u0438 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 FNF Flip-Side \u0437 \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e \u043d\u0430 \u0456\u043d\u0448\u0438\u0439?", "answer": "\u041f\u0435\u0440\u0435\u043d\u043e\u0441 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443 FNF Flip-Side \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u043a\u0440\u043e\u043a\u0456\u0432. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f: \u044f\u043a\u0449\u043e \u0433\u0440\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u0445\u043c\u0430\u0440\u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f, \u0432\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445. \u041a\u0420\u041e\u041a 2 \u2013 \u0420\u0443\u0447\u043d\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u043a\u043e\u043f\u0456\u044f: \u0437\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0444\u0430\u0439\u043b\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 (\u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0437\u0456 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0433\u0440\u0438) \u0442\u0430 \u0441\u043a\u043e\u043f\u0456\u044e\u0439\u0442\u0435 \u0457\u0445 \u043d\u0430 \u043d\u043e\u0432\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f: \u043f\u043e\u043c\u0456\u0441\u0442\u0456\u0442\u044c \u0444\u0430\u0439\u043b\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0432 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043d\u0430 \u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u041f\u041a \u0444\u0430\u0439\u043b\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u044f\u0442\u044c\u0441\u044f \u0432 \u043f\u0430\u043f\u0446\u0456 \"AppData\". \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f USB-\u043d\u0430\u043a\u043e\u043f\u0438\u0447\u0443\u0432\u0430\u0447\u0430 \u0430\u0431\u043e \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0441\u0445\u043e\u0432\u0438\u0449\u0430, \u044f\u043a Google \u0414\u0438\u0441\u043a, \u043c\u043e\u0436\u0435 \u043f\u043e\u043b\u0435\u0433\u0448\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f."}, {"question": "\u042f\u043a\u0456 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0430\u0431\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0432 FNF Flip-Side?", "answer": "FNF Flip-Side \u0440\u044f\u0441\u043d\u0456\u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044f\u043c\u0438 \u0442\u0430 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u044f\u0439\u0446\u044f\u043c\u0438. \u041a\u0420\u041e\u041a 1 \u2013 \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0456 \u0442\u0440\u0435\u043a\u0438: \u0434\u0435\u044f\u043a\u0456 \u0442\u0440\u0435\u043a\u0438 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u044e\u0442\u044c\u0441\u044f \u0448\u043b\u044f\u0445\u043e\u043c \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043f\u0435\u0432\u043d\u0438\u0445 \u0437\u0430\u0432\u0434\u0430\u043d\u044c \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f \u043a\u043e\u0434\u043e\u0432\u0438\u0445 \u0441\u043b\u0456\u0432. \u041a\u0420\u041e\u041a 2 \u2013 \u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0456: \u043f\u0435\u0432\u043d\u0456 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0456 \u0448\u043b\u044f\u0445\u043e\u043c \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0432\u0438\u0441\u043e\u043a\u0438\u0445 \u0431\u0430\u043b\u0456\u0432 \u043d\u0430 \u043f\u0435\u0432\u043d\u0438\u0445 \u0442\u0440\u0435\u043a\u0430\u0445. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0456 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f: \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0434\u0435\u0442\u0430\u043b\u0456 \u0444\u043e\u043d\u0443 \u0442\u0430 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u0457 \u0434\u043b\u044f \u0442\u043e\u043d\u043a\u0438\u0445 \u043d\u0430\u0442\u044f\u043a\u0456\u0432 \u043d\u0430 \u0456\u043d\u0448\u0456 \u0456\u0433\u0440\u0438 \u0430\u0431\u043e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0443 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0443. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432 \u0442\u0440\u0435\u043a\u0443 \"Flip-Side Showdown\" \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0431\u0430\u043b\u0443 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454 \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u0437 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u0434\u0456\u0430\u043b\u043e\u0433\u0430\u043c\u0438. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0444\u0430\u0439\u043b\u0456\u0432 \u0433\u0440\u0438 \u043c\u043e\u0436\u0435 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438 \u0442\u0430 \u043d\u0435\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0439 \u0432\u043c\u0456\u0441\u0442."}]
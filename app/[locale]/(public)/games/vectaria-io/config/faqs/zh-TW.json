[{"question": "\u65b0\u624b\u5982\u4f55\u958b\u59cb\u4f7f\u7528 Vectaria.io \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "Vectaria.io \u65b0\u624b\u9996\u5148\u61c9\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u904a\u6232\u4e3b\u8981\u4f7f\u7528 WASD \u9375\u9032\u884c\u79fb\u52d5\uff0c\u4ee5\u53ca\u6ed1\u9f20\u9032\u884c\u7784\u6e96\u548c\u5c04\u64ca\u3002\u4f8b\u5982\uff0c\u6309\u4e0b\u300eW\u300f\u9375\u53ef\u4f7f\u89d2\u8272\u5411\u524d\u79fb\u52d5\uff0c\u800c\u9ede\u64ca\u5de6\u9375\u53ef\u767c\u5c04\u6b66\u5668\u3002\u6b64\u5916\uff0c\u300e\u7a7a\u683c\u9375\u300f\u7528\u65bc\u8df3\u8e8d\uff0c\u5c0d\u65bc\u5730\u5716\u7684\u79fb\u52d5\u81f3\u95dc\u91cd\u8981\u3002\u5efa\u8b70\u82b1\u4e00\u4e9b\u6642\u9593\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\u3002\u70ba\u4e86\u66f4\u597d\u5730\u7406\u89e3\uff0c\u9019\u88e1\u6709\u4e00\u500b\u5feb\u901f\u53c3\u8003\u5217\u8868\uff1a [W\uff1a\u524d\u9032\uff0cS\uff1a\u5f8c\u9000\uff0cA\uff1a\u5de6\uff0cD\uff1a\u53f3\uff0c\u7a7a\u683c\u9375\uff1a\u8df3\u8e8d\uff0c\u5de6\u9375\u9ede\u64ca\uff1a\u5c04\u64ca]\u3002\u9019\u4e9b\u57fa\u790e\u77e5\u8b58\u5c07\u6709\u52a9\u65bc\u4f60\u6709\u6548\u5730\u9032\u884c\u5730\u5716\u79fb\u52d5\u548c\u6230\u9b25\u3002"}, {"question": "\u7d93\u9a57\u8d85\u904e 100 \u5c0f\u6642\u7684 Vectaria.io \u73a9\u5bb6\uff0c\u751f\u5b58\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0d\u65bc\u5728 Vectaria.io \u64c1\u6709\u8d85\u904e 100 \u5c0f\u6642\u904a\u6232\u7d93\u9a57\u7684\u8001\u624b\u73a9\u5bb6\u4f86\u8aaa\uff0c\u751f\u5b58\u53d6\u6c7a\u65bc\u5148\u9032\u7684\u7b56\u7565\u3002\u6b65\u9a5f 1\uff1a\u5730\u5716\u610f\u8b58 - \u59cb\u7d42\u6ce8\u610f\u5468\u570d\u74b0\u5883\uff0c\u4e26\u5229\u7528\u5730\u5716\u9810\u6e2c\u6575\u4eba\u7684\u79fb\u52d5\u3002\u6b65\u9a5f 2\uff1a\u8cc7\u6e90\u7ba1\u7406 - \u6709\u6548\u5730\u7ba1\u7406\u5f48\u85e5\u548c\u88dc\u8840\u5305\u3002\u4f8b\u5982\uff0c\u7576\u8840\u91cf\u4f4e\u65bc 50% \u6642\uff0c\u512a\u5148\u62fe\u53d6\u88dc\u8840\u5305\u3002\u6b65\u9a5f 3\uff1a\u5718\u968a\u5354\u8abf - \u8207\u5718\u968a\u6e9d\u901a\uff0c\u57f7\u884c\u5354\u8abf\u7684\u653b\u64ca\u3002\u53ca\u6642\u5be6\u65bd\u7684\u4f0f\u64ca\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u64da\u9ede\u300d\u5730\u5716\u4e2d\uff0c\u8b93\u5718\u968a\u4f54\u64da\u9ad8\u5730\u53ef\u4ee5\u7372\u5f97\u6230\u7565\u512a\u52e2\u3002\u5be6\u65bd\u9019\u4e9b\u7b56\u7565\u5c07\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u7387\u548c\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728 Vectaria.io \u4e2d\u4e86\u89e3\u50b7\u5bb3\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728 Vectaria.io \u4e2d\u4e86\u89e3\u50b7\u5bb3\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u7684\u6230\u9b25\u6548\u7387\u3002\u6bcf\u7a2e\u6b66\u5668\u90fd\u6709\u7279\u5b9a\u7684\u50b7\u5bb3\u503c\u548c\u5c04\u901f\u3002\u4f8b\u5982\uff0c\u300c\u7b49\u96e2\u5b50\u6b65\u69cd\u300d\u6bcf\u767c\u5c04\u64ca\u9020\u6210 25 \u9ede\u50b7\u5bb3\uff0c\u4e14\u5c04\u901f\u5f88\u5feb\uff0c\u4f7f\u5176\u975e\u5e38\u9069\u5408\u8fd1\u8ddd\u96e2\u6230\u9b25\u3002\u6b64\u5916\uff0c\u7206\u982d\u9020\u6210\u96d9\u500d\u50b7\u5bb3\uff0c\u6240\u4ee5\u7784\u6e96\u6575\u4eba\u7684\u982d\u90e8\u53ef\u4ee5\u5feb\u901f\u6d88\u6ec5\u6575\u4eba\u3002\u4ee5\u4e0b\u662f\u50b7\u5bb3\u6bd4\u8f03\u8868\uff1a [\u7b49\u96e2\u5b50\u6b65\u69cd\uff1a\u6bcf\u767c 25 \u9ede\u50b7\u5bb3\uff0c\u72d9\u64ca\u6b65\u69cd\uff1a\u6bcf\u767c 100 \u9ede\u50b7\u5bb3\uff0c\u6563\u5f48\u69cd\uff1a\u6bcf\u767c 50 \u9ede\u50b7\u5bb3]\u3002\u638c\u63e1\u9019\u4e9b\u6a5f\u5236\uff0c\u4f60\u5c31\u80fd\u70ba\u6bcf\u7a2e\u60c5\u6cc1\u9078\u64c7\u6b63\u78ba\u7684\u6b66\u5668\uff0c\u4e26\u6700\u5927\u5316\u4f60\u7684\u50b7\u5bb3\u8f38\u51fa\u3002"}, {"question": "Vectaria.io \u4e2d\u54ea\u4e9b\u904a\u6232\u6d3b\u52d5\u70ba\u6210\u5c31\u7375\u4eba\u63d0\u4f9b\u4e86\u6700\u4f73\u56de\u5831\uff1f", "answer": "\u5c0d\u65bc Vectaria.io \u7684\u6210\u5c31\u7375\u4eba\u4f86\u8aaa\uff0c\u67d0\u4e9b\u904a\u6232\u6d3b\u52d5\u63d0\u4f9b\u4e86\u6700\u4f73\u56de\u5831\u3002\u4f8b\u5982\uff0c\u300c\u6bcf\u5468\u734e\u91d1\u300d\u6d3b\u52d5\uff0c\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u53ef\u7372\u5f97\u7368\u5bb6\u5916\u89c0\u548c\u9ad8\u7d1a\u5bf6\u7269\u3002\u53e6\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u6d3b\u52d5\u662f\u300c\u5b63\u7bc0\u6027\u9326\u6a19\u8cfd\u300d\uff0c\u8868\u73fe\u6700\u4f73\u7684\u73a9\u5bb6\u5c07\u8d0f\u5f97\u7a00\u6709\u6b66\u5668\u548c\u7f8e\u5bb9\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u8d0f\u5f97\u300c\u5b63\u7bc0\u6027\u9326\u6a19\u8cfd\u300d\u53ef\u4ee5\u7372\u5f97\u300c\u9ec3\u91d1\u4e4b\u5203\u300d\uff0c\u9019\u662f\u4e00\u6b3e\u5099\u53d7\u8ffd\u6367\u7684\u8fd1\u6230\u6b66\u5668\u3002\u8981\u6700\u5927\u5316\u60a8\u7684\u56de\u5831\uff0c\u8acb\u5c08\u6ce8\u65bc\u9019\u4e9b\u6d3b\u52d5\u4e26\u76f8\u61c9\u5730\u8a08\u5283\u60a8\u7684\u904a\u6232\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u56de\u5831\u6bd4\u8f03\uff1a [\u6bcf\u5468\u734e\u91d1\uff1a\u5916\u89c0\u548c\u5bf6\u7269\uff0c\u5b63\u7bc0\u6027\u9326\u6a19\u8cfd\uff1a\u7a00\u6709\u6b66\u5668\u548c\u7f8e\u5bb9\u7269\u54c1]\u3002\u53c3\u8207\u9019\u4e9b\u6d3b\u52d5\u5c07\u5e6b\u52a9\u4f60\u6536\u96c6\u5927\u91cf\u7a00\u6709\u7269\u54c1\u3002"}, {"question": "Vectaria.io \u7684\u914d\u5c0d\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f\u70ba\u4ec0\u9ebc\u5b83\u5c0d\u516c\u5e73\u7af6\u8cfd\u5f88\u91cd\u8981\uff1f", "answer": "Vectaria.io \u7684\u914d\u5c0d\u7cfb\u7d71\u65e8\u5728\u901a\u904e\u5c07\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5c0d\u4f86\u78ba\u4fdd\u516c\u5e73\u7af6\u8cfd\u3002\u8a72\u7cfb\u7d71\u4f7f\u7528ELO \u7b49\u7d1a\uff0c\u7372\u52dd\u6703\u63d0\u5347\u7b49\u7d1a\uff0c\u8f38\u7403\u5247\u6703\u964d\u4f4e\u7b49\u7d1a\u3002\u4f8b\u5982\uff0cELO \u7b49\u7d1a\u70ba 1500 \u7684\u73a9\u5bb6\u5c07\u8207 1400-1600 \u7bc4\u570d\u5167\u7684\u5176\u4ed6\u73a9\u5bb6\u5339\u914d\u3002\u9019\u5c07\u9632\u6b62\u65b0\u624b\u73a9\u5bb6\u9762\u5c0d\u8001\u624b\u73a9\u5bb6\uff0c\u5f9e\u800c\u5275\u9020\u4e00\u500b\u5e73\u8861\u4e14\u6109\u5feb\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4ee5\u4e0b\u662f\u7528\u6d41\u7a0b\u5716\u986f\u793a\u7684\u914d\u5c0d\u904e\u7a0b\uff1a [\u73a9\u5bb6\u6392\u968a \u2192 ELO \u7b49\u7d1a\u6aa2\u67e5 \u2192 \u5339\u914d\u5f62\u6210 \u2192 \u904a\u6232\u958b\u59cb]\u3002\u4e86\u89e3\u6b64\u7cfb\u7d71\u5c07\u5e6b\u52a9\u73a9\u5bb6\u8a55\u4f30\u81ea\u5df1\u7684\u9032\u5ea6\uff0c\u4e26\u52aa\u529b\u63d0\u9ad8\u81ea\u8eab\u6c34\u5e73\uff0c\u78ba\u4fdd\u904a\u6232\u74b0\u5883\u65e2\u5177\u6709\u7af6\u722d\u6027\u53c8\u516c\u5e73\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u88dd\u5099\u4ee5\u61c9\u5c0d Vectaria.io \u4e2d\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u7684\u9700\u6c42\uff1f", "answer": "\u5728 Vectaria.io \u4e2d\u512a\u5316\u88dd\u5099\u4ee5\u9069\u61c9\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\uff0c\u6d89\u53ca\u5e7e\u500b\u6b65\u9a5f\u3002\u6b65\u9a5f 1\uff1a\u5206\u6790\u904a\u6232\u6a21\u5f0f - \u5c0d\u300c\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\u300d\u4f86\u8aaa\uff0c\u512a\u5148\u9078\u64c7\u9ad8\u50b7\u5bb3\u548c\u9ad8\u5c04\u901f\u7684\u6b66\u5668\u3002\u6b65\u9a5f 2\uff1a\u81ea\u8a02\u4f60\u7684\u88dd\u5099 - \u88dd\u5099\u53ef\u63d0\u5347\u6b66\u5668\u6027\u80fd\u7684\u9644\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u300c\u7a81\u64ca\u6b65\u69cd\u300d\u4e0a\u6dfb\u52a0\u300c\u7d05\u9ede\u7784\u6e96\u93e1\u300d\u53ef\u4ee5\u63d0\u9ad8\u6e96\u78ba\u6027\u3002\u6b65\u9a5f 3\uff1a\u6e2c\u8a66\u548c\u8abf\u6574 - \u73a9\u5e7e\u5834\u6bd4\u8cfd\u4ee5\u67e5\u770b\u88dd\u5099\u7684\u8868\u73fe\uff0c\u4e26\u9032\u884c\u5fc5\u8981\u7684\u8abf\u6574\u3002\u4f8b\u5982\uff0c\u5728\u300c\u596a\u65d7\u300d\u6a21\u5f0f\u4e2d\uff0c\u5305\u542b\u77ed\u7a0b\u548c\u9577\u7a0b\u6b66\u5668\u7684\u5e73\u8861\u88dd\u5099\u53ef\u4ee5\u6709\u6548\u3002\u4ee5\u4e0b\u662f\u88dd\u5099\u6bd4\u8f03\uff1a [\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\uff1a\u9ad8\u50b7\u5bb3\u6b66\u5668\uff0c\u596a\u65d7\uff1a\u5e73\u8861\u88dd\u5099]\u3002\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\u5c07\u5e6b\u52a9\u4f60\u70ba\u5404\u7a2e\u904a\u6232\u6a21\u5f0f\u91cf\u8eab\u5b9a\u88fd\u88dd\u5099\uff0c\u78ba\u4fdd\u6700\u4f73\u8868\u73fe\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Vectaria.io \u4e2d\u5c07 PC \u9032\u5ea6\u9077\u79fb\u81f3\u624b\u6a5f\uff1f", "answer": "\u5728 Vectaria.io \u4e2d\u5c07 PC \u9032\u5ea6\u9077\u79fb\u5230\u624b\u6a5f\u662f\u4e00\u500b\u7c21\u55ae\u7684\u904e\u7a0b\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u7136\u5f8c\uff0c\u700f\u89bd\u300c\u5e33\u6236\u8a2d\u5b9a\u300d\u9078\u55ae\u4e26\u9078\u64c7\u300c\u540c\u6b65\u9032\u5ea6\u300d\u3002\u9019\u5c07\u628a\u4f60\u7684\u7576\u524d\u9032\u5ea6\u4e0a\u50b3\u5230\u96f2\u7aef\u3002\u5728\u4f60\u7684\u624b\u6a5f\u88dd\u7f6e\u4e0a\uff0c\u4f7f\u7528\u540c\u4e00\u500b\u5e33\u6236\u767b\u9304\u4e26\u518d\u6b21\u9078\u64c7\u300c\u540c\u6b65\u9032\u5ea6\u300d\u4ee5\u4e0b\u8f09\u4f60\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 PC \u4e0a\u89e3\u9396\u4e86\u300c\u7cbe\u82f1\u72d9\u64ca\u624b\u300d\u5916\u89c0\uff0c\u540c\u6b65\u5f8c\u5b83\u5c07\u6703\u51fa\u73fe\u5728\u4f60\u7684\u624b\u6a5f\u5e33\u6236\u4e0a\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u6b65\u9a5f\uff1a [\u6b65\u9a5f 1\uff1a\u5728 PC \u4e0a\u767b\u9304 \u2192 \u6b65\u9a5f 2\uff1a\u540c\u6b65\u9032\u5ea6 \u2192 \u6b65\u9a5f 3\uff1a\u5728\u624b\u6a5f\u4e0a\u767b\u9304 \u2192 \u6b65\u9a5f 4\uff1a\u540c\u6b65\u9032\u5ea6]\u3002\u9019\u500b\u7121\u7e2b\u904e\u7a0b\u5141\u8a31\u4f60\u5728\u4efb\u4f55\u5e73\u53f0\u4e0a\u7e7c\u7e8c\u904a\u6232\uff0c\u800c\u4e0d\u6703\u5931\u53bb\u4f60\u7684\u6210\u5c31\u3002"}, {"question": "Vectaria.io \u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f\u73a9\u5bb6\u5982\u4f55\u767c\u73fe\u5b83\u5011\uff1f", "answer": "Vectaria.io \u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u9a5a\u559c\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300c\u53e4\u4ee3\u795e\u5edf\u300d\u5730\u5716\u4e2d\u7684\u300c\u79d8\u5bc6\u623f\u9593\u300d\uff0c\u901a\u904e\u5c04\u64ca\u7279\u5b9a\u9806\u5e8f\u7684\u7246\u58c1\u7b26\u865f\u5373\u53ef\u9032\u5165\u3002\u88e1\u9762\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u7a00\u6709\u5bf6\u7269\u548c\u7368\u7279\u6b66\u5668\u5916\u89c0\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u300c\u958b\u767c\u8005\u7b46\u8a18\u300d\uff0c\u6563\u4f48\u5728\u5404\u5730\u5716\u4e2d\uff0c\u63d0\u4f9b\u5c0d\u904a\u6232\u88fd\u4f5c\u7684\u898b\u89e3\u3002\u8981\u767c\u73fe\u9019\u4e9b\uff0c\u8acb\u63a2\u7d22\u5730\u5716\u7684\u6bcf\u500b\u89d2\u843d\uff0c\u4e26\u8207\u4e0d\u5c0b\u5e38\u7684\u7269\u54c1\u4e92\u52d5\u3002\u4ee5\u4e0b\u662f\u5df2\u77e5\u5f69\u86cb\u6e05\u55ae\uff1a [\u79d8\u5bc6\u623f\u9593\uff1a\u53e4\u4ee3\u795e\u5edf\uff0c\u958b\u767c\u8005\u7b46\u8a18\uff1a\u591a\u500b\u5730\u5716]\u3002\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u4e26\u63d0\u4f9b\u5bf6\u8cb4\u7684\u56de\u5831\u3002"}, {"question": "Vectaria.io \u7684\u6392\u540d\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u9032\u5ea6\u548c\u6bd4\u8cfd\u7d50\u679c\uff1f", "answer": "Vectaria.io \u7684\u6392\u540d\u7cfb\u7d71\u986f\u8457\u5f71\u97ff\u73a9\u5bb6\u9032\u5ea6\u548c\u6bd4\u8cfd\u7d50\u679c\u3002\u73a9\u5bb6\u6839\u64da\u4ed6\u5011\u7684\u8868\u73fe\u6392\u540d\uff0c\u66f4\u9ad8\u6392\u540d\u5c07\u89e3\u9396\u7368\u5bb6\u734e\u52f5\u548c\u8a8d\u53ef\u3002\u4f8b\u5982\uff0c\u9054\u5230\u300c\u947d\u77f3\u300d\u7b49\u7d1a\u53ef\u4ee5\u7372\u5f97\u53c3\u52a0\u7279\u5225\u9326\u6a19\u8cfd\u548c\u7a00\u6709\u7f8e\u5bb9\u7269\u54c1\u7684\u8cc7\u683c\u3002\u8a72\u7cfb\u7d71\u9084\u5f71\u97ff\u914d\u5c0d\uff0c\u56e0\u70ba\u66f4\u9ad8\u6392\u540d\u7684\u73a9\u5bb6\u6703\u8207\u540c\u7b49\u6280\u80fd\u7684\u5c0d\u624b\u5c0d\u6c7a\u3002\u9019\u78ba\u4fdd\u4e86\u7af6\u722d\u6027\u6bd4\u8cfd\uff0c\u4e26\u9f13\u52f5\u6301\u7e8c\u6539\u9032\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u9032\u5ea6\u6d41\u7a0b\u5716\uff1a [\u73a9\u5bb6\u8868\u73fe \u2192 \u7b49\u7d1a\u9ede\u8a08\u7b97 \u2192 \u7b49\u7d1a\u63d0\u5347 \u2192 \u7368\u5bb6\u734e\u52f5]\u3002\u4e86\u89e3\u6392\u540d\u7cfb\u7d71\u5c07\u5e6b\u52a9\u73a9\u5bb6\u8a2d\u5b9a\u76ee\u6a19\uff0c\u4e26\u52aa\u529b\u8ffd\u6c42\u66f4\u9ad8\u7684\u6210\u5c31\uff0c\u63d0\u5347\u6574\u9ad4\u9ad4\u9a57\u3002"}, {"question": "\u5728 Vectaria.io \u4e2d\u6709\u6548\u7ba1\u7406\u904a\u6232\u8ca8\u5e63\u548c\u8cc7\u6e90\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Vectaria.io \u4e2d\u6709\u6548\u5730\u7ba1\u7406\u904a\u6232\u8ca8\u5e63\u548c\u8cc7\u6e90\u5c0d\u65bc\u9577\u671f\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u512a\u5148\u5c07\u8ca8\u5e63\u82b1\u5728\u6b66\u5668\u548c\u9644\u4ef6\u7b49\u5fc5\u8981\u7269\u54c1\u4e0a\uff0c\u800c\u4e0d\u662f\u5916\u89c0\u5347\u7d1a\u3002\u4f8b\u5982\uff0c\u6295\u8cc7\u8cfc\u8cb7\u300c\u9ad8\u5bb9\u91cf\u5f48\u5323\u300d\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u6230\u9b25\u6548\u7387\u3002\u5176\u6b21\uff0c\u53c3\u8207\u6d3b\u52d5\u4e26\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u4ee5\u8cfa\u53d6\u984d\u5916\u8cc7\u6e90\u3002\u6700\u5f8c\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8cfc\u8cb7\uff0c\u4e26\u5132\u84c4\u8ca8\u5e63\u4ee5\u8cfc\u8cb7\u9ad8\u50f9\u503c\u7269\u54c1\u3002\u4ee5\u4e0b\u662f\u8cc7\u6e90\u7ba1\u7406\u8868\uff1a [\u5fc5\u8981\u7269\u54c1\uff1a\u6b66\u5668\u548c\u9644\u4ef6\uff0c\u9078\u9805\u7269\u54c1\uff1a\u5916\u89c0\u5347\u7d1a\uff0c\u984d\u5916\u8cc7\u6e90\uff1a\u6d3b\u52d5\u548c\u6311\u6230]\u3002\u9075\u5faa\u9019\u4e9b\u6700\u4f73\u505a\u6cd5\uff0c\u60a8\u53ef\u4ee5\u6700\u5927\u5316\u904a\u6232\u8ca8\u5e63\u548c\u8cc7\u6e90\uff0c\u8b93\u60a8\u59cb\u7d42\u70ba\u5373\u5c07\u5230\u4f86\u7684\u6311\u6230\u505a\u597d\u6e96\u5099\u3002"}]
[{"question": "Vectaria.io\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u64cd\u4f5c\u306f\u3069\u306e\u3088\u3046\u306b\u958b\u59cb\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Vectaria.io\u3092\u59cb\u3081\u308b\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u3001\u307e\u305a\u57fa\u672c\u64cd\u4f5c\u306b\u6163\u308c\u3066\u304a\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001\u79fb\u52d5\u306bWASD\u30ad\u30fc\u3001\u7167\u6e96\u3068\u5c04\u6483\u306b\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cW\u300d\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u524d\u9032\u3057\u3001\u5de6\u306e\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u6b66\u5668\u304c\u767a\u5c04\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u300d\u306f\u30b8\u30e3\u30f3\u30d7\u306b\u4f7f\u7528\u3055\u308c\u3001\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3067\u6642\u9593\u3092\u8cbb\u3084\u3059\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3088\u308a\u7406\u89e3\u3092\u6df1\u3081\u308b\u305f\u3081\u306b\u3001\u7c21\u5358\u306a\u53c2\u7167\u8868\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\uff1a[W\uff1a\u524d\u9032\u3001S\uff1a\u5f8c\u9000\u3001A\uff1a\u5de6\u3001D\uff1a\u53f3\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\uff1a\u30b8\u30e3\u30f3\u30d7\u3001\u5de6\u30af\u30ea\u30c3\u30af\uff1a\u5c04\u6483]\u3002\u3053\u306e\u57fa\u790e\u77e5\u8b58\u306f\u3001\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3057\u3001\u6226\u95d8\u306b\u53c2\u52a0\u3059\u308b\u4e0a\u3067\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Vectaria.io\u3067100\u6642\u9593\u4e
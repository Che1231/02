[{"question": "\u65b0\u624b\u5982\u4f55\u5165\u95e8Vectaria.io\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "Vectaria.io\u7684\u65b0\u624b\u73a9\u5bb6\u5e94\u9996\u5148\u719f\u6089\u57fa\u672c\u64cd\u4f5c\u3002\u8be5\u6e38\u620f\u4e3b\u8981\u4f7f\u7528WASD\u952e\u8fdb\u884c\u79fb\u52a8\uff0c\u9f20\u6807\u8fdb\u884c\u7784\u51c6\u548c\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u6309\u4e0b'W'\u952e\u4f7f\u89d2\u8272\u5411\u524d\u79fb\u52a8\uff0c\u5de6\u952e\u70b9\u51fb\u9f20\u6807\u53d1\u5c04\u6b66\u5668\u3002\u6b64\u5916\uff0c\u7a7a\u683c\u952e\u7528\u4e8e\u8df3\u8dc3\uff0c\u8fd9\u5bf9\u4e8e\u5728\u5730\u56fe\u4e2d\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u5efa\u8bae\u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u82b1\u4e00\u4e9b\u65f6\u95f4\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\u3002\u4e3a\u4e86\u66f4\u597d\u5730\u7406\u89e3\uff0c\u4ee5\u4e0b\u662f\u4e00\u4e2a\u5feb\u901f\u53c2\u8003\u8868\uff1a [W\uff1a\u5411\u524d\uff0cS\uff1a\u5411\u540e\uff0cA\uff1a\u5411\u5de6\uff0cD\uff1a\u5411\u53f3\uff0c\u7a7a\u683c\u952e\uff1a\u8df3\u8dc3\uff0c\u5de6\u952e\u70b9\u51fb\uff1a\u5c04\u51fb]\u3002\u8fd9\u4e9b\u57fa\u7840\u77e5\u8bc6\u5c06\u5e2e\u52a9\u4f60\u6709\u6548\u5730\u8fdb\u884c\u5bfc\u822a\u548c\u6218\u6597\u3002"}, {"question": "\u5bf9\u4e8e\u62e5\u6709\u8d85\u8fc7100\u5c0f\u65f6\u6e38\u620f\u7ecf\u9a8c\u7684\u73a9\u5bb6\u6765\u8bf4\uff0cVectaria.io\u4e2d\u751f\u5b58\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u5728Vectaria.io\u4e2d\u62e5\u6709\u8d85\u8fc7100\u5c0f\u65f6\u6e38\u620f\u7ecf\u9a8c\u7684\u8001\u73a9\u5bb6\u6765\u8bf4\uff0c\u751f\u5b58\u7684\u5173\u952e\u5728\u4e8e\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u5730\u56fe\u610f\u8bc6\u2014\u2014\u65f6\u523b\u6ce8\u610f\u5468\u56f4\u73af\u5883\uff0c\u5e76\u5229\u7528\u5730\u56fe\u9884\u6d4b\u654c\u4eba\u7684\u884c\u52a8\u3002\u6b65\u9aa42\uff1a\u8d44\u6e90\u7ba1\u7406\u2014\u2014\u6709\u6548\u5730\u7ba1\u7406\u4f60\u7684\u5f39\u836f\u548c\u533b\u7597\u5305\u3002\u4f8b\u5982\uff0c\u5f53\u4f60\u7684\u751f\u547d\u503c\u4f4e\u4e8e50%\u65f6\uff0c\u4f18\u5148\u62fe\u53d6\u533b\u7597\u5305\u3002\u6b65\u9aa43\uff1a\u56e2\u961f\u534f\u4f5c\u2014\u2014\u4e0e\u4f60\u7684\u56e2\u961f\u6c9f\u901a\uff0c\u6267\u884c\u534f\u8c03\u7684\u653b\u51fb\u3002\u65f6\u673a\u6070\u5f53\u7684\u4f0f\u51fb\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u524d\u54e8\u201d\u5730\u56fe\u4e2d\uff0c\u8ba9\u4f60\u7684\u56e2\u961f\u5360\u636e\u9ad8\u5730\u53ef\u4ee5\u83b7\u5f97\u6218\u7565\u4f18\u52bf\u3002\u8fd0\u7528\u8fd9\u4e9b\u7b56\u7565\u5c06\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u7387\u548c\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728Vectaria.io\u4e2d\u7406\u89e3\u4f24\u5bb3\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728Vectaria.io\u4e2d\u7406\u89e3\u4f24\u5bb3\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u5728\u6218\u6597\u4e2d\u7684\u6709\u6548\u6027\u3002\u6bcf\u79cd\u6b66\u5668\u90fd\u6709\u7279\u5b9a\u7684\u4f24\u5bb3\u503c\u548c\u5c04\u51fb\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u201c\u7b49\u79bb\u5b50\u6b65\u67aa\u201d\u6bcf\u53d1\u9020\u621025\u70b9\u4f24\u5bb3\uff0c\u5e76\u5177\u6709\u9ad8\u5c04\u51fb\u901f\u5ea6\uff0c\u4f7f\u5176\u975e\u5e38\u9002\u5408\u8fd1\u8ddd\u79bb\u6218\u6597\u3002\u6b64\u5916\uff0c\u7206\u5934\u4f24\u5bb3\u662f\u53cc\u500d\u7684\uff0c\u6240\u4ee5\u7784\u51c6\u5934\u90e8\u53ef\u4ee5\u8fc5\u901f\u6d88\u706d\u654c\u4eba\u3002\u4ee5\u4e0b\u662f\u4f24\u5bb3\u6bd4\u8f83\u8868\uff1a[\u7b49\u79bb\u5b50\u6b65\u67aa\uff1a\u6bcf\u53d125\u70b9\u4f24\u5bb3\uff0c\u72d9\u51fb\u6b65\u67aa\uff1a\u6bcf\u53d1100\u70b9\u4f24\u5bb3\uff0c\u9730\u5f39\u67aa\uff1a\u6bcf\u53d150\u70b9\u4f24\u5bb3]\u3002\u638c\u63e1\u8fd9\u4e9b\u673a\u5236\uff0c\u4f60\u53ef\u4ee5\u6839\u636e\u4e0d\u540c\u7684\u60c5\u51b5\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\uff0c\u6700\u5927\u5316\u4f60\u7684\u4f24\u5bb3\u8f93\u51fa\u3002"}, {"question": "Vectaria.io\u4e2d\u54ea\u4e9b\u6e38\u620f\u4e8b\u4ef6\u4e3a\u6210\u5c31\u730e\u624b\u63d0\u4f9b\u4e86\u6700\u4f73\u5956\u52b1\uff1f", "answer": "\u5bf9\u4e8eVectaria.io\u4e2d\u7684\u6210\u5c31\u730e\u624b\u6765\u8bf4\uff0c\u67d0\u4e9b\u6e38\u620f\u4e8b\u4ef6\u63d0\u4f9b\u4e86\u6700\u4f73\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u201c\u6bcf\u5468\u60ac\u8d4f\u201d\u6d3b\u52a8\uff0c\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u53ef\u83b7\u5f97\u72ec\u5bb6\u76ae\u80a4\u548c\u9ad8\u9636\u6218\u5229\u54c1\u3002\u53e6\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u4e8b\u4ef6\u662f\u201c\u5b63\u8282\u6027\u9526\u6807\u8d5b\u201d\uff0c\u5176\u4e2d\u8868\u73b0\u6700\u4f73\u7684\u73a9\u5bb6\u5c06\u83b7\u5f97\u7a00\u6709\u6b66\u5668\u548c\u88c5\u9970\u54c1\u3002\u4f8b\u5982\uff0c\u8d62\u5f97\u201c\u5b63\u8282\u6027\u9526\u6807\u8d5b\u201d\u53ef\u4ee5\u83b7\u5f97\u201c\u9ec4\u91d1\u4e4b\u5203\u201d\uff0c\u4e00\u79cd\u975e\u5e38\u53d7\u8ffd\u6367\u7684\u8fd1\u6218\u6b66\u5668\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f60\u7684\u5956\u52b1\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u4e8b\u4ef6\u5e76\u76f8\u5e94\u5730\u89c4\u5212\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\u3002\u4ee5\u4e0b\u662f\u5956\u52b1\u6bd4\u8f83\uff1a[\u6bcf\u5468\u60ac\u8d4f\uff1a\u76ae\u80a4\u548c\u6218\u5229\u54c1\uff0c\u5b63\u8282\u6027\u9526\u6807\u8d5b\uff1a\u7a00\u6709\u6b66\u5668\u548c\u88c5\u9970\u54c1]\u3002\u53c2\u4e0e\u8fd9\u4e9b\u4e8b\u4ef6\u5c06\u5e2e\u52a9\u4f60\u79ef\u7d2f\u4ee4\u4eba\u5370\u8c61\u6df1\u523b\u7684\u7a00\u6709\u7269\u54c1\u6536\u85cf\u3002"}, {"question": "Vectaria.io\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4e3a\u4ec0\u4e48\u8fd9\u5bf9\u516c\u5e73\u6e38\u620f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "Vectaria.io\u7684\u5339\u914d\u7cfb\u7edf\u65e8\u5728\u901a\u8fc7\u5c06\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5bf9\u6765\u4fdd\u8bc1\u516c\u5e73\u6e38\u620f\u3002\u8be5\u7cfb\u7edf\u4f7f\u7528ELO\u7b49\u7ea7\uff0c\u83b7\u80dc\u4f1a\u63d0\u5347\u7b49\u7ea7\uff0c\u5931\u8d25\u5219\u4f1a\u964d\u4f4e\u7b49\u7ea7\u3002\u4f8b\u5982\uff0cELO\u7b49\u7ea7\u4e3a1500\u7684\u73a9\u5bb6\u5c06\u4e0e1400-1600\u8303\u56f4\u5185\u7684\u5176\u4ed6\u73a9\u5bb6\u5339\u914d\u3002\u8fd9\u5c06\u9632\u6b62\u65b0\u624b\u73a9\u5bb6\u4e0e\u8001\u73a9\u5bb6\u5bf9\u6218\uff0c\u4ece\u800c\u521b\u9020\u4e00\u4e2a\u5e73\u8861\u4e14\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4ee5\u4e0b\u662f\u5339\u914d\u6d41\u7a0b\u56fe\uff1a[\u73a9\u5bb6\u961f\u5217 \u2192 ELO\u7b49\u7ea7\u68c0\u67e5 \u2192 \u5339\u914d\u5f62\u6210 \u2192 \u6e38\u620f\u5f00\u59cb]\u3002\u7406\u89e3\u8fd9\u4e2a\u7cfb\u7edf\u6709\u52a9\u4e8e\u73a9\u5bb6\u8861\u91cf\u81ea\u5df1\u7684\u8fdb\u6b65\u5e76\u52aa\u529b\u6539\u8fdb\uff0c\u786e\u4fdd\u6e38\u620f\u73af\u5883\u65e2\u6709\u7ade\u4e89\u6027\uff0c\u53c8\u80fd\u505a\u5230\u516c\u5e73\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u4f60\u7684\u88c5\u8f7d\u914d\u7f6e\u4ee5\u9002\u5e94Vectaria.io\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u7684\u9700\u6c42\uff1f", "answer": "\u4f18\u5316\u4f60\u7684\u88c5\u8f7d\u914d\u7f6e\u4ee5\u9002\u5e94Vectaria.io\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u7684\u9700\u6c42\u9700\u8981\u51e0\u4e2a\u6b65\u9aa4\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u6e38\u620f\u6a21\u5f0f\u2014\u2014\u5bf9\u4e8e\u201c\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u201d\uff0c\u4f18\u5148\u9009\u62e9\u5177\u6709\u9ad8\u4f24\u5bb3\u548c\u9ad8\u5c04\u901f\u7684\u6b66\u5668\u3002\u6b65\u9aa42\uff1a\u81ea\u5b9a\u4e49\u4f60\u7684\u88c5\u8f7d\u914d\u7f6e\u2014\u2014\u88c5\u5907\u80fd\u589e\u5f3a\u6b66\u5668\u6027\u80fd\u7684\u9644\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u201c\u7a81\u51fb\u6b65\u67aa\u201d\u4e0a\u6dfb\u52a0\u201c\u7ea2\u70b9\u7784\u51c6\u955c\u201d\u53ef\u4ee5\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u6b65\u9aa43\uff1a\u6d4b\u8bd5\u548c\u8c03\u6574\u2014\u2014\u8fdb\u884c\u51e0\u573a\u6bd4\u8d5b\u4ee5\u89c2\u5bdf\u4f60\u7684\u88c5\u8f7d\u914d\u7f6e\u7684\u6027\u80fd\uff0c\u5e76\u8fdb\u884c\u5fc5\u8981\u7684\u8c03\u6574\u3002\u4f8b\u5982\uff0c\u5728\u201c\u593a\u65d7\u201d\u6a21\u5f0f\u4e2d\uff0c\u5177\u6709\u77ed\u7a0b\u548c\u957f\u7a0b\u6b66\u5668\u6df7\u5408\u7684\u5e73\u8861\u88c5\u8f7d\u914d\u7f6e\u53ef\u80fd\u6709\u6548\u3002\u4ee5\u4e0b\u662f\u88c5\u8f7d\u914d\u7f6e\u6bd4\u8f83\uff1a[\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\uff1a\u9ad8\u4f24\u5bb3\u6b66\u5668\uff0c\u593a\u65d7\uff1a\u5e73\u8861\u88c5\u8f7d\u914d\u7f6e]\u3002\u9075\u5faa\u8fd9\u4e9b\u6b65\u9aa4\u5c06\u5e2e\u52a9\u4f60\u6839\u636e\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u7684\u9700\u6c42\u5b9a\u5236\u4f60\u7684\u88c5\u8f7d\u914d\u7f6e\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Vectaria.io\u4e2d\u5c06PC\u7aef\u8fdb\u5ea6\u8fc1\u79fb\u5230\u79fb\u52a8\u7aef\uff1f", "answer": "\u5728Vectaria.io\u4e2d\u5c06PC\u7aef\u7684\u8fdb\u5ea6\u8fc1\u79fb\u5230\u79fb\u52a8\u7aef\u662f\u4e00\u4e2a\u7b80\u5355\u7684\u8fc7\u7a0b\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u7136\u540e\uff0c\u5bfc\u822a\u5230\u201c\u8d26\u6237\u8bbe\u7f6e\u201d\u83dc\u5355\uff0c\u9009\u62e9\u201c\u540c\u6b65\u8fdb\u5ea6\u201d\u3002\u8fd9\u4f1a\u5c06\u4f60\u7684\u5f53\u524d\u8fdb\u5ea6\u4e0a\u4f20\u5230\u4e91\u7aef\u3002\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u767b\u5f55\uff0c\u5e76\u518d\u6b21\u9009\u62e9\u201c\u540c\u6b65\u8fdb\u5ea6\u201d\u6765\u4e0b\u8f7d\u4f60\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u7aef\u89e3\u9501\u4e86\u201c\u7cbe\u82f1\u72d9\u51fb\u624b\u201d\u76ae\u80a4\uff0c\u90a3\u4e48\u5728\u540c\u6b65\u540e\uff0c\u5b83\u5c06\u5728\u4f60\u7684\u79fb\u52a8\u7aef\u8d26\u6237\u4e2d\u53ef\u7528\u3002\u4ee5\u4e0b\u662f\u5206\u6b65\u6307\u5357\uff1a[\u6b65\u9aa41\uff1a\u5728PC\u4e0a\u767b\u5f55 \u2192 \u6b65\u9aa42\uff1a\u540c\u6b65\u8fdb\u5ea6 \u2192 \u6b65\u9aa43\uff1a\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u767b\u5f55 \u2192 \u6b65\u9aa44\uff1a\u540c\u6b65\u8fdb\u5ea6]\u3002\u8fd9\u4e00\u65e0\u7f1d\u8fc7\u7a0b\u5141\u8bb8\u4f60\u5728\u4efb\u4f55\u5e73\u53f0\u4e0a\u7ee7\u7eed\u6e38\u620f\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4f60\u7684\u6210\u5c31\u3002"}, {"question": "Vectaria.io\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "Vectaria.io\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u523a\u6fc0\u3002\u4e00\u4e2a\u8457\u540d\u7684\u5f69\u86cb\u662f\u201c\u53e4\u4ee3\u795e\u6bbf\u201d\u5730\u56fe\u4e2d\u7684\u201c\u79d8\u5bc6\u623f\u95f4\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5c04\u51fb\u7279\u5b9a\u987a\u5e8f\u7684\u5899\u58c1\u7b26\u53f7\u6765\u8bbf\u95ee\u3002\u5728\u91cc\u9762\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u7a00\u6709\u6218\u5229\u54c1\u548c\u72ec\u7279\u7684\u6b66\u5668\u76ae\u80a4\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u201c\u5f00\u53d1\u4eba\u5458\u6ce8\u91ca\u201d\uff0c\u6563\u5e03\u5728\u5404\u4e2a\u5730\u56fe\u4e2d\uff0c\u53ef\u4ee5\u6d1e\u5bdf\u6e38\u620f\u7684\u521b\u4f5c\u8fc7\u7a0b\u3002\u4e3a\u4e86\u53d1\u73b0\u8fd9\u4e9b\uff0c\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u5e76\u4e0e\u4e0d\u5bfb\u5e38\u7684\u7269\u4f53\u4e92\u52a8\u3002\u4ee5\u4e0b\u662f\u5df2\u77e5\u7684\u5f69\u86cb\u5217\u8868\uff1a[\u79d8\u5bc6\u623f\u95f4\uff1a\u53e4\u4ee3\u795e\u6bbf\uff0c\u5f00\u53d1\u4eba\u5458\u6ce8\u91ca\uff1a\u591a\u4e2a\u5730\u56fe]\u3002\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u73cd\u5b9d\u53ef\u4ee5\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u5e76\u63d0\u4f9b\u6709\u4ef7\u503c\u7684\u5956\u52b1\u3002"}, {"question": "Vectaria.io\u7684\u6392\u884c\u699c\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u8fdb\u6b65\u548c\u6bd4\u8d5b\u7ed3\u679c\uff1f", "answer": "Vectaria.io\u7684\u6392\u884c\u699c\u7cfb\u7edf\u4f1a\u663e\u8457\u5f71\u54cd\u73a9\u5bb6\u7684\u8fdb\u6b65\u548c\u6bd4\u8d5b\u7ed3\u679c\u3002\u73a9\u5bb6\u7684\u6392\u540d\u57fa\u4e8e\u4ed6\u4eec\u7684\u8868\u73b0\uff0c\u66f4\u9ad8\u7b49\u7ea7\u7684\u6392\u540d\u5c06\u89e3\u9501\u72ec\u5bb6\u5956\u52b1\u548c\u8ba4\u53ef\u3002\u4f8b\u5982\uff0c\u8fbe\u5230\u201c\u94bb\u77f3\u201d\u7b49\u7ea7\u5c06\u83b7\u5f97\u53c2\u4e0e\u7279\u6b8a\u9526\u6807\u8d5b\u548c\u83b7\u5f97\u7a00\u6709\u88c5\u9970\u54c1\u7684\u8d44\u683c\u3002\u8be5\u7cfb\u7edf\u8fd8\u4f1a\u5f71\u54cd\u5339\u914d\uff0c\u56e0\u4e3a\u66f4\u9ad8\u7b49\u7ea7\u7684\u73a9\u5bb6\u5c06\u88ab\u5339\u914d\u5230\u6280\u80fd\u76f8\u4f3c\u7684\u5bf9\u624b\u3002\u8fd9\u786e\u4fdd\u4e86\u6bd4\u8d5b\u7684\u7ade\u4e89\u6027\uff0c\u5e76\u9f13\u52b1\u6301\u7eed\u6539\u8fdb\u3002\u4ee5\u4e0b\u662f\u8fdb\u5ea6\u6d41\u7a0b\u56fe\uff1a[\u73a9\u5bb6\u8868\u73b0 \u2192 \u7b49\u7ea7\u79ef\u5206\u8ba1\u7b97 \u2192 \u7b49\u7ea7\u63d0\u5347 \u2192 \u72ec\u5bb6\u5956\u52b1]\u3002\u7406\u89e3\u6392\u884c\u699c\u7cfb\u7edf\u6709\u52a9\u4e8e\u73a9\u5bb6\u8bbe\u5b9a\u76ee\u6807\u5e76\u4e89\u53d6\u66f4\u9ad8\u7684\u6210\u5c31\uff0c\u4ece\u800c\u63d0\u5347\u4ed6\u4eec\u7684\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728Vectaria.io\u4e2d\u6709\u6548\u7ba1\u7406\u6e38\u620f\u8d27\u5e01\u548c\u8d44\u6e90\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Vectaria.io\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6e38\u620f\u8d27\u5e01\u548c\u8d44\u6e90\u5bf9\u4e8e\u957f\u671f\u6210\u529f\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f18\u5148\u5c06\u8d27\u5e01\u82b1\u5728\u6b66\u5668\u548c\u9644\u4ef6\u7b49\u5fc5\u8981\u7269\u54c1\u4e0a\uff0c\u800c\u4e0d\u662f\u88c5\u9970\u54c1\u5347\u7ea7\u3002\u4f8b\u5982\uff0c\u6295\u8d44\u201c\u9ad8\u5bb9\u91cf\u5f39\u5323\u201d\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6218\u6597\u6548\u7387\u3002\u5176\u6b21\uff0c\u53c2\u4e0e\u6d3b\u52a8\u5e76\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u4ee5\u83b7\u5f97\u989d\u5916\u8d44\u6e90\u3002\u6700\u540e\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8d2d\u4e70\uff0c\u5e76\u5c06\u8d27\u5e01\u7559\u7ed9\u9ad8\u4ef7\u503c\u7269\u54c1\u3002\u4ee5\u4e0b\u662f\u8d44\u6e90\u7ba1\u7406\u8868\u683c\uff1a[\u5fc5\u8981\u7269\u54c1\uff1a\u6b66\u5668\u548c\u9644\u4ef6\uff0c\u53ef\u9009\u7269\u54c1\uff1a\u88c5\u9970\u54c1\u5347\u7ea7\uff0c\u989d\u5916\u8d44\u6e90\uff1a\u6d3b\u52a8\u548c\u6311\u6218]\u3002\u9075\u5faa\u8fd9\u4e9b\u6700\u4f73\u5b9e\u8df5\uff0c\u4f60\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u5229\u7528\u6e38\u620f\u8d27\u5e01\u548c\u8d44\u6e90\uff0c\u786e\u4fdd\u4f60\u6c38\u8fdc\u4e3a\u672a\u6765\u7684\u6311\u6218\u505a\u597d\u51c6\u5907\u3002"}]
[{"question": "Vectaria.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ucc98\uc74c \ubc30\uc6b0\ub294 \uc0ac\ub78c\uc740 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "Vectaria.io\ub97c \ucc98\uc74c \uc811\ud558\ub294 \ubd84\ub4e4\uc740 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \uc8fc\ub85c WASD \ud0a4\ub97c \uc774\ub3d9, \ub9c8\uc6b0\uc2a4\ub97c \uc870\uc900 \ubc0f \uc0ac\uaca9\uc5d0 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'W' \ud0a4\ub97c \ub204\ub974\uba74 \uce90\ub9ad\ud130\uac00 \uc55e\uc73c\ub85c \uc774\ub3d9\ud558\uace0, \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uba74 \ubb34\uae30\ub97c \ubc1c\uc0ac\ud569\ub2c8\ub2e4. \ub610\ud55c, '\uc2a4\ud398\uc774\uc2a4\ubc14'\ub294 \ub9f5\uc744 \uc774\ub3d9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc810\ud504 \uae30\ub2a5\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\uc5d0\uc11c \uc2dc\uac04\uc744 \ud560\uc560\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud574 \ube60\ub978 \ucc38\uace0\ud45c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4: [W: \uc55e\uc73c\ub85c \uc774\ub3d9, S: \ub4a4\ub85c \uc774\ub3d9, A: \uc67c\ucabd, D: \uc624\ub978\ucabd, \uc2a4\ud398\uc774\uc2a4\ubc14: \uc810\ud504, \uc67c\ucabd \ud074\ub9ad: \uc0ac\uaca9]. \uc774 \uae30\ubcf8\uc801\uc778 \uc9c0\uc2dd\uc740 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 Vectaria.io\ub97c \uc990\uae34 \uc720\uc800\ub4e4\uc744 \uc704\ud55c \uc0dd\uc874 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 Vectaria.io\ub97c \uc990\uae34 \uacbd\ud5d8 \ub9ce\uc740 \uc720\uc800\ub4e4\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc758\uc874\ud574\uc57c \uc0dd\uc874\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc9c0\ub3c4 \uc778\uc9c0 - \uc8fc\ubcc0 \ud658\uacbd\uc744 \ud56d\uc0c1 \ud30c\uc545\ud558\uace0 \uc9c0\ub3c4\ub97c \ud65c\uc6a9\ud558\uc5ec \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud574\uc57c \ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc790\uc6d0 \uad00\ub9ac - \ud0c4\uc57d\uacfc \uccb4\ub825 \ud3ec\uc158\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825\uc774 50% \ubbf8\ub9cc\uc77c \ub54c\ub294 \uccb4\ub825 \ud3ec\uc158\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc90d\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud300 \ud611\ub825 - \ud300\uc6d0\ub4e4\uacfc \uc18c\ud1b5\ud558\uc5ec \uc870\uc9c1\uc801\uc778 \uacf5\uaca9\uc744 \uc2e4\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uc801\uc808\ud55c \uae30\uc2b5\uc740 \uc804\ud669\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc804\ucd08\uae30\uc9c0' \uc9c0\ub3c4\uc5d0\uc11c \ud300\uc744 \uace0\uc9c0\ub300\uc5d0 \ubc30\uce58\ud558\uba74 \uc804\ub7b5\uc801\uc778 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \ud65c\uc6a9\ud558\uba74 \uc0dd\uc874\uc728\uacfc \uc804\ubc18\uc801\uc778 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc5d0\uc11c \ud53c\ud574 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc5d0\uc11c \ud53c\ud574 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ud22c\uc5d0\uc11c \ud6a8\uc728\uc131\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ubb34\uae30\ub294 \ud2b9\uc815 \ud53c\ud574\ub7c9\uacfc \uc0ac\uaca9 \uc18d\ub3c4\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud50c\ub77c\uc988\ub9c8 \ub77c\uc774\ud50c'\uc740 25\uc758 \ud53c\ud574\ub7c9\uc744 \ucd08\ub2f9 \ub9ce\uc740 \ud69f\uc218\ub85c \ubc1c\uc0ac\ud558\uc5ec \uadfc\uc811 \uc804\ud22c\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ub610\ud55c, \ud5e4\ub4dc\uc0f7\uc740 2\ubc30\uc758 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ub530\ub77c\uc11c \ud5e4\ub4dc\uc0f7\uc744 \ub178\ub9ac\ub294 \uac83\uc774 \uc801\uc744 \uc2e0\uc18d\ud558\uac8c \uc81c\uac70\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ud53c\ud574\ub7c9 \ube44\uad50\ud45c\uc785\ub2c8\ub2e4: [\ud50c\ub77c\uc988\ub9c8 \ub77c\uc774\ud50c: \uc0f7\ub2f9 25 \ud53c\ud574, \uc2a4\ub098\uc774\ud37c \ub77c\uc774\ud50c: \uc0f7\ub2f9 100 \ud53c\ud574, \uc0b0\ud0c4\ucd1d: \uc0f7\ub2f9 50 \ud53c\ud574]. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud568\uc73c\ub85c\uc368 \uac01 \uc0c1\ud669\uc5d0 \uc801\ud569\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uace0 \ucd5c\ub300\ud55c\uc758 \ud53c\ud574\ub97c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc5d0\uc11c \uc131\ucde8 \ud0d0\uad6c\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uac8c\uc784 \uc774\ubca4\ud2b8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc5d0\uc11c \uc131\ucde8 \ud0d0\uad6c\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \ud2b9\uc815 \uac8c\uc784 \uc774\ubca4\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc8fc\uac04 \ubcf4\uc0c1' \uc774\ubca4\ud2b8\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \ub3c5\uc810 \uc2a4\ud0a8\uacfc \uace0\uae09 \ud68d\ub4dd\ud488\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc8fc\ubaa9\ud560\ub9cc\ud55c \uc774\ubca4\ud2b8\ub294 '\uc2dc\uc98c \ud1a0\ub108\uba3c\ud2b8'\uc785\ub2c8\ub2e4. \ud0d1 \ud50c\ub808\uc774\uc5b4\ub294 \ud76c\uadc0 \ubb34\uae30\uc640 \uc678\ud615 \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2dc\uc98c \ud1a0\ub108\uba3c\ud2b8'\uc5d0\uc11c \uc6b0\uc2b9\ud558\uba74 '\ud669\uae08\uac80'\uacfc \uac19\uc740 \uc778\uae30 \uc788\ub294 \uadfc\uc811 \ubb34\uae30\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\uc0c1\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\uc5d0 \uc9d1\uc911\ud558\uace0 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uadf8\uc5d0 \ub9de\ucdb0 \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \ub2e4\uc74c\uc740 \ubcf4\uc0c1 \ube44\uad50\ud45c\uc785\ub2c8\ub2e4: [\uc8fc\uac04 \ubcf4\uc0c1: \uc2a4\ud0a8 \ubc0f \ud68d\ub4dd\ud488, \uc2dc\uc98c \ud1a0\ub108\uba3c\ud2b8: \ud76c\uadc0 \ubb34\uae30 \ubc0f \uc678\ud615 \uc544\uc774\ud15c]. \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uba74 \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ub9ce\uc774 \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc720\uc0ac\ud55c \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \ub9e4\uce6d\ud558\uc5ec \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc2b9\ub9ac \uc2dc \uc99d\uac00\ud558\uace0 \ud328\ubc30 \uc2dc \uac10\uc18c\ud558\ub294 ELO \uc810\uc218\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, ELO \uc810\uc218\uac00 1500\uc778 \ud50c\ub808\uc774\uc5b4\ub294 1400~1600\ub300\uc758 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub429\ub2c8\ub2e4. \uc774\ub294 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc640 \ub9c8\uc8fc\uce58\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uc5ec \uade0\ud615 \uc788\uace0 \uc990\uac70\uc6b4 \uac8c\uc784 \ud658\uacbd\uc744 \uc870\uc131\ud569\ub2c8\ub2e4. \ub9e4\uce6d \ud504\ub85c\uc138\uc2a4\uc758 \ud750\ub984\ub3c4\ub97c \ubcf4\uc5ec\ub4dc\ub9bd\ub2c8\ub2e4: [\ud50c\ub808\uc774\uc5b4 \ub300\uae30\uc5f4 \u2192 ELO \uc810\uc218 \ud655\uc778 \u2192 \ub9e4\uce6d \ud615\uc131 \u2192 \uac8c\uc784 \uc2dc\uc791]. \uc774 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud30c\uc545\ud558\uace0 \ud5a5\uc0c1\uc744 \uc704\ud574 \ub178\ub825\ud560 \uc218 \uc788\uc73c\uba70, \uacbd\uc7c1\uc801\uc774\uba74\uc11c\ub3c4 \uacf5\uc815\ud55c \ud658\uacbd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0 \ub9de\ucdb0 \ub85c\ub4dc\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0 \ub9de\ucdb0 \ub85c\ub4dc\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \uba87 \uac00\uc9c0 \ub2e8\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac8c\uc784 \ubaa8\ub4dc \ubd84\uc11d - '\ud300 \ub370\uc2a4\ub9e4\uce58'\uc758 \uacbd\uc6b0, \ub192\uc740 \ud53c\ud574\ub7c9\uacfc \uc0ac\uaca9 \uc18d\ub3c4\ub97c \uac00\uc9c4 \ubb34\uae30\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ub85c\ub4dc\uc544\uc6c3 \ub9de\ucda4 \uc124\uc815 - \uac8c\uc784 \ubb34\uae30\uc758 \uc131\ub2a5\uc744 \ub192\uc774\ub294 \ubd80\ucc29\ubb3c\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uad8c\ucd1d'\uc5d0 '\uc801\uc0c9 \uc810 \uc0ac\uc774\ud2b8'\ub97c \ucd94\uac00\ud558\uba74 \uc815\ud655\ub3c4\uac00 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud14c\uc2a4\ud2b8 \ubc0f \uc870\uc815 - \uba87 \ubc88\uc758 \ub9e4\uce58\ub97c \ud50c\ub808\uc774\ud558\uc5ec \ub85c\ub4dc\uc544\uc6c3\uc758 \uc131\ub2a5\uc744 \ud655\uc778\ud558\uace0 \ud544\uc694\ud55c \uc870\uc815\uc744 \ud569\ub2c8\ub2e4. '\uae43\ubc1c \ud68d\ub4dd'\uc758 \uacbd\uc6b0, \ub2e8\uac70\ub9ac \ubc0f \uc7a5\uac70\ub9ac \ubb34\uae30\ub97c \ud63c\ud569\ud55c \uade0\ud615 \uc7a1\ud78c \ub85c\ub4dc\uc544\uc6c3\uc774 \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub85c\ub4dc\uc544\uc6c3 \ube44\uad50\ud45c\uc785\ub2c8\ub2e4: [\ud300 \ub370\uc2a4\ub9e4\uce58: \ub192\uc740 \ud53c\ud574\ub7c9 \ubb34\uae30, \uae43\ubc1c \ud68d\ub4dd: \uade0\ud615 \uc7a1\ud78c \ub85c\ub4dc\uc544\uc6c3]. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \ubc1c\ud718\ud558\ub3c4\ub85d \ub85c\ub4dc\uc544\uc6c3\uc744 \ub9de\ucda4 \uc124\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc5d0\uc11c PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc5d0\uc11c PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud55c \ud504\ub85c\uc138\uc2a4\uc785\ub2c8\ub2e4. \uba3c\uc800 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c '\uacc4\uc815 \uc124\uc815' \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc774 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc5c5\ub85c\ub4dc\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uace0 \ub2e4\uc2dc '\uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654'\ub97c \uc120\ud0dd\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c '\uc5d8\ub9ac\ud2b8 \uc2a4\ub098\uc774\ud37c' \uc2a4\ud0a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud588\uc73c\uba74 \ub3d9\uae30\ud654 \ud6c4 \ubaa8\ubc14\uc77c \uacc4\uc815\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4: [1\ub2e8\uacc4: PC\uc5d0\uc11c \ub85c\uadf8\uc778 \u2192 2\ub2e8\uacc4: \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654 \u2192 3\ub2e8\uacc4: \ubaa8\ubc14\uc77c\uc5d0 \ub85c\uadf8\uc778 \u2192 4\ub2e8\uacc4: \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654]. \uc774 \uac04\ud3b8\ud55c \ud504\ub85c\uc138\uc2a4\ub97c \ud1b5\ud574 \uc5b4\ub5a4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c\ub3c4 \uac8c\uc784\uc744 \uacc4\uc18d \uc9c4\ud589\ud558\uba74\uc11c \uc131\uacfc\ub97c \uc783\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc5d0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "Vectaria.io\uc5d0\ub294 \ud765\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uace0\ub300 \uc2e0\uc804' \uc9c0\ub3c4\uc758 '\ube44\ubc00 \ubc29'\uc785\ub2c8\ub2e4. \ud2b9\uc815 \ubcbd \uae30\ud638\uc758 \uc21c\uc11c\ub300\ub85c \uc0ac\uaca9\ud558\uba74 \ub4e4\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc548\uc5d0\ub294 \ud76c\uadc0 \ud68d\ub4dd\ud488\uacfc \ub3c5\ud2b9\ud55c \ubb34\uae30 \uc2a4\ud0a8\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uc5ec\ub7ec \uc9c0\ub3c4\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 '\uac1c\ubc1c\uc790 \uba54\ubaa8'\uc785\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uac8c\uc784 \uc81c\uc791\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ucc3e\uc73c\ub824\uba74 \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc774\ud55c \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e4\uc74c\uc740 \uc54c\ub824\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ubaa9\ub85d\uc785\ub2c8\ub2e4: [\ube44\ubc00 \ubc29: \uace0\ub300 \uc2e0\uc804, \uac1c\ubc1c\uc790 \uba54\ubaa8: \uc5ec\ub7ec \uc9c0\ub3c4]. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ucc3e\uc73c\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uac00\uce58 \uc788\ub294 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc758 \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \ub9e4\uce58 \uacb0\uacfc\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Vectaria.io\uc758 \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \ub9e4\uce58 \uacb0\uacfc\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc131\ub2a5\uc5d0 \ub530\ub77c \ub4f1\uae09\uc774 \ub9e4\uaca8\uc9c0\uba70, \ub192\uc740 \ub4f1\uae09\uc5d0\uc11c\ub294 \ub3c5\uc810 \ubcf4\uc0c1\uacfc \uc778\uc815\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub2e4\uc774\uc544\ubaac\ub4dc' \ub7ad\ud06c\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ud2b9\ubcc4 \ud1a0\ub108\uba3c\ud2b8\uc640 \ud76c\uadc0 \uc678\ud615 \uc544\uc774\ud15c\uc744 \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc774 \uc2dc\uc2a4\ud15c\uc740 \ub9e4\uce6d\uc5d0\ub3c4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub7ad\ud0b9\uc774 \ub192\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \ube44\uc2b7\ud55c \uc2e4\ub825\uc758 \uc0c1\ub300\uc640 \ub300\uacb0\ud569\ub2c8\ub2e4. \uc774\ub294 \uacbd\uc7c1\uc801\uc778 \ub9e4\uce58\ub97c \ubcf4\uc7a5\ud558\uace0 \uc9c0\uc18d\uc801\uc778 \uac1c\uc120\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uc9c4\ud589 \ud750\ub984\ub3c4\uc785\ub2c8\ub2e4: [\ud50c\ub808\uc774\uc5b4 \uc131\ub2a5 \u2192 \ub7ad\ud06c \ud3ec\uc778\ud2b8 \uacc4\uc0b0 \u2192 \ub7ad\ud06c \uc2b9\uae09 \u2192 \ub3c5\uc810 \ubcf4\uc0c1]. \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ubaa9\ud45c\ub97c \uc124\uc815\ud558\uace0 \ub354 \ub192\uc740 \uc131\ucde8\ub97c \uc704\ud574 \ub178\ub825\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Vectaria.io\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\uc640 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vectaria.io\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\uc640 \uc790\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uc7a5\uae30\uc801\uc778 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800, \ud1b5\ud654\ub97c \uc678\ud615 \uc5c5\uadf8\ub808\uc774\ub4dc \ub300\uc2e0 \ubb34\uae30\uc640 \ubd80\ucc29\ubb3c\uacfc \uac19\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub300\uc6a9\ub7c9 \ud0c4\ucc3d'\uc744 \uad6c\uc785\ud558\uba74 \uc804\ud22c \ud6a8\uc728\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub450 \ubc88\uc9f8\ub85c, \uc774\ubca4\ud2b8 \ucc38\uc5ec \ubc0f \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\ub97c \ud1b5\ud574 \ucd94\uac00 \uc790\uc6d0\uc744 \ud68d\ub4dd\ud558\uc2ed\uc2dc\uc624. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ubd88\ud544\uc694\ud55c \uad6c\ub9e4\ub97c \ud53c\ud558\uace0 \uace0\uac00\uc758 \uc544\uc774\ud15c\uc744 \uc704\ud574 \ud1b5\ud654\ub97c \uc808\uc57d\ud558\uc2ed\uc2dc\uc624. \uc790\uc6d0 \uad00\ub9ac \ud45c\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4: [\ud544\uc218 \uc544\uc774\ud15c: \ubb34\uae30 \ubc0f \ubd80\ucc29\ubb3c, \uc120\ud0dd \uc0ac\ud56d \uc544\uc774\ud15c: \uc678\ud615 \uc5c5\uadf8\ub808\uc774\ub4dc, \ucd94\uac00 \uc790\uc6d0: \uc774\ubca4\ud2b8 \ubc0f \ucc4c\ub9b0\uc9c0]. \uc774\ub7ec\ud55c \ucd5c\uace0\uc758 \ubc29\ubc95\uc744 \ub530\ub974\uba74 \uac8c\uc784 \ub0b4 \ud1b5\ud654\uc640 \uc790\uc6d0\uc744 \ucd5c\ub300\ud55c \ud65c\uc6a9\ud558\uc5ec \uc55e\uc73c\ub85c \ub2e4\uac00\uc62c \uc5b4\ub824\uc6c0\uc5d0 \ub300\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
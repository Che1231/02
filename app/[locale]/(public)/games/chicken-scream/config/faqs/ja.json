[{"question": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u57fa\u672c\u64cd\u4f5c\u306b\u306f\u3001\u79fb\u52d5\u3001\u30b8\u30e3\u30f3\u30d7\u3001\u305d\u3057\u3066\u3042\u306a\u305f\u306e\u53eb\u3073\u80fd\u529b\u306e\u4f7f\u7528\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001\u65b9\u5411\u30ad\u30fc\u307e\u305f\u306f\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3001\u305d\u3057\u3066\u6575\u3092\u5a01\u5687\u3057\u305f\u308a\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u3084\u308a\u53d6\u308a\u3057\u305f\u308a\u3059\u308b\u305f\u3081\u306b\u300eS\u300f\u30ad\u30fc\u3067\u53eb\u3073\u307e\u3059\u3002\u5b9f\u4f8b\u3068\u3057\u3066\u3001\u30ed\u30c3\u30af\u3055\u308c\u305f\u30c9\u30a2\u306b\u51fa\u304f\u308f\u3057\u305f\u3068\u304d\u3001\u305d\u306e\u8fd1\u304f\u306b\u53eb\u3076\u3068\u3001\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u4f5c\u52d5\u3057\u3066\u30c9\u30a2\u304c\u958b\u304f\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u89e3\u8aac\uff1a\u3042\u306a\u305f\u306e\u53eb\u3073\u3092\u3001\u5358\u306a\u308b\u30c9\u30a2\u3092\u958b\u3051\u308b\u9375\u3060\u3051\u3067\u306a\u304f\u3001\u65b0\u305f\u306a\u6226\u7565\u306e\u9375\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u6700\u9069\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u521d\u671f\u8a2d\u5b9a\u3067\u3069\u306e\u3088\u3046\u306a\u8a2d\u5b9a\u3092\u884c\u3046\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u6700\u9069\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u307e\u305a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306e\u554f\u984c\u3092\u907f\u3051\u308b\u305f\u3081\u3001\u30e2\u30cb\u30bf\u306e\u30cd\u30a4\u30c6\u30a3\u30d6\u8a2d\u5b9a\u306b\u5408\u308f\u305b\u305f\u89e3\u50cf\u5ea6\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002\u97f3\u697d\u3068\u52b9\u679c\u97f3\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u30b5\u30a6\u30f3\u30c9\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3001\u826f\u3044\u51fa\u767a\u70b9\u306f70%\u306e\u97f3\u697d\u306890%\u306e\u52b9\u679c\u97f3\u3067\u3059\u3002\u3088\u308a\u8fc5\u901f\u306a\u5fdc\u7b54\u6642\u9593\u306e\u305f\u3081\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u30e1\u30cb\u30e5\u30fc\u3067\u300e\u30af\u30a4\u30c3\u30af\u30b9\u30af\u30ea\u30fc\u30e0\u300f\u3092\u6709\u52b9\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u8a2d\u5b9a\u4e00\u89a7\u8868\uff1a\u89e3\u50cf\u5ea6\uff1a\u30cd\u30a4\u30c6\u30a3\u30d6\u3001\u97f3\u697d\uff1a70%\u3001\u52b9\u679c\u97f3\uff1a90%\u3001\u30af\u30a4\u30c3\u30af\u30b9\u30af\u30ea\u30fc\u30e0\uff1a\u6709\u52b9]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u53eb\u3073\u80fd\u529b\u3092\u4f7f\u7528\u3059\u308b\u969b\u306b\u3001\u306a\u305c\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u53eb\u3073\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u3057\u304f\u5408\u308f\u305b\u308b\u3053\u3068\u306f\u3001\u305d\u306e\u52b9\u679c\u3068\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u671f\u9593\u306e\u4e21\u65b9\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6575\u304c\u653b\u6483\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u3061\u3087\u3046\u3069\u53eb\u3076\u3068\u3001\u6575\u3092\u4e00\u6642\u7684\u306b\u52d5\u3051\u306a\u304f\u3057\u3001\u53cd\u6483\u3057\u305f\u308a\u3001\u9003\u3052\u51fa\u3059\u6a5f\u4f1a\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8aa4\u308b\u3068\u3001\u81ea\u5206\u81ea\u8eab\u304c\u5371\u967a\u306a\u72b6\u6cc1\u306b\u9665\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u6575\u306e\u63a5\u8fd1\u2192\u653b\u6483\u306e\u5408\u56f3\u5f85\u3061\u2192\u53eb\u3073\u306e\u5b9f\u884c\u2192\u6575\u306e\u30b9\u30bf\u30f3\u2192\u53cd\u6483\uff0f\u8131\u51fa]"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u6295\u8cc7\u5bfe\u52b9\u679c\u304c\u6700\u3082\u9ad8\u3044\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u3001\u30ea\u30bd\u30fc\u30b9\u306e\u4f7f\u7528\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6575\u304c\u3088\u308a\u5206\u6563\u3059\u308b\u5f8c\u7d9a\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u53eb\u3073\u306e\u7bc4\u56f2\u3092\u30d1\u30ef\u30fc\u3088\u308a\u3082\u5148\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u304c\u3088\u308a\u6709\u76ca\u306a\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u7bc4\u56f2\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u5bfe\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\uff1a\u7bc4\u56f2\u306f\u52b9\u679c\u7bc4\u56f2\u3092\u5e83\u3052\u3001\u30d1\u30ef\u30fc\u306f\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u5f37\u3059\u308b\uff1b\u5e83\u3044\u6575\u914d\u7f6e\u306b\u306f\u7bc4\u56f2\u304c\u597d\u307e\u3057\u3044\u3002]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u63a1\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3001\u5b89\u5168\u306a\u5834\u6240\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f37\u529b\u306a\u653b\u6483\u3092\u4e2d\u65ad\u3059\u308b\u305f\u3081\u306b\u3001\u3042\u306a\u305f\u306e\u53eb\u3073\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30b9\u304c\u3088\u308a\u653b\u6483\u7684\u306b\u306a\u308b\u6700\u7d42\u30d5\u30a7\u30fc\u30ba\u306e\u305f\u3081\u306b\u3001\u4f53\u529b\u85ac\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u89e3\u8aac\uff1a\u30dc\u30b9\u6226\u3092\u3001\u6210\u529f\u306e\u30ab\u30ae\u3068\u306a\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30ea\u30ba\u30e0\u306e\u3042\u308b\u30c0\u30f3\u30b9\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u80fd\u529b\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u3042\u306a\u305f\u306e\u751f\u5b58\u6027\u3068\u6575\u306e\u5236\u5fa1\u80fd\u529b\u3092\u9ad8\u3081\u308b\u80fd\u529b\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a8\u30b3\u30fc\u30b9\u30af\u30ea\u30fc\u30e0\u300f\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u3042\u306a\u305f\u306e\u53eb\u3073\u304c\u8907\u6570\u306e\u6575\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u3089\u308c\u308b\u305f\u3081\u3001\u5bc6\u96c6\u3057\u305f\u30a8\u30ea\u30a2\u3067\u975e\u5e38\u306b\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u3002[\u8a2d\u5b9a\u4e00\u89a7\u8868\uff1a\u30a8\u30b3\u30fc\u30b9\u30af\u30ea\u30fc\u30e0\uff1a\u5f71\u97ff\u3092\u53d7\u3051\u308b\u6575\u306e\u6570\u5897\u52a0\uff1b\u6301\u7d9a\u6642\u9593\uff1a\u30b9\u30bf\u30f3\u6642\u9593\u306e\u5ef6\u9577\uff1b\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\uff1a\u53eb\u3073\u306e\u9593\u9694\u306e\u77ed\u7e2e]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u6575\u306eAI\u884c\u52d5\u3092\u652f\u914d\u3059\u308b\u6839\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u6575AI\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8fd1\u63a5\u3068\u884c\u52d5\u306b\u3088\u3063\u3066\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u72b6\u614b\u30d9\u30fc\u30b9\u306e\u30b7\u30b9\u30c6\u30e0\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6575\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u691c\u77e5\u3059\u308b\u307e\u3067\u30d1\u30c8\u30ed\u30fc\u30eb\u3057\u3001\u305d\u308c\u304b\u3089\u653b\u6483\u30e2\u30fc\u30c9\u306b\u5207\u308a\u66ff\u308f\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d1\u30c8\u30ed\u30fc\u30eb\u30e2\u30fc\u30c9\u2192\u691c\u77e5\u2192\u653b\u6483\u30e2\u30fc\u30c9\u2192\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u306b\u57fa\u3065\u304f\u653b\u6483\uff0f\u64a4\u9000]"}, {"question": "\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u30ea\u30bd\u30fc\u30b9\u306e\u5165\u624b\u53ef\u80fd\u6027\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u96e3\u6613\u5ea6\u304c\u4e0a\u304c\u308b\u3068\u3001\u30ea\u30bd\u30fc\u30b9\u306f\u3088\u308a\u8cb4\u91cd\u306b\u306a\u308a\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3088\u308a\u9ad8\u3044\u96e3\u6613\u5ea6\u3067\u306f\u4f53\u529b\u85ac\u3084\u53eb\u3073\u306e\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u306e\u983b\u5ea6\u304c\u5c11\u306a\u304f\u306a\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30a2\u30a4\u30c6\u30e0\u306b\u983c\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30b9\u30ad\u30eb\u306b\u983c\u308b\u3053\u3068\u3092\u4f59\u5100\u306a\u304f\u3055\u308c\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u7c21\u5358\uff1a\u8c4a\u5bcc\u306a\u30ea\u30bd\u30fc\u30b9\uff1b\u666e\u901a\uff1a\u30d0\u30e9\u30f3\u30b9\u304c\u826f\u3044\uff1b\u56f0\u96e3\uff1a\u30ea\u30bd\u30fc\u30b9\u304c\u5c11\u306a\u304f\u3001\u30b9\u30ad\u30eb\u3078\u306e\u4f9d\u5b58\u5ea6\u304c\u9ad8\u3044]"}, {"question": "PC\u7248\u306e\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306b\u3088\u3063\u3066\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u5f8c\u3001\u30af\u30e9\u30a6\u30c9\u306b\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3057\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30ed\u30fc\u30c9\u3057\u3066\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u89e3\u8aac\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63a5\u7d9a\u3059\u308b\u6a4b\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c1\u30ad\u30f3\u30b9\u30af\u30ea\u30fc\u30e0\u306b\u306f\u8907\u6570\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u7279\u5b9a\u306e\u53eb\u3073\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b9f\u884c\u3059\u308b\u3068\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u96a0\u3057\u30ec\u30d9\u30eb\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30ec\u30d9\u30eb\u3067\u306f\u30e6\u30cb\u30fc\u30af\u306a\u6311\u6226\u3068\u5831\u916c\u304c\u63d0\u4f9b\u3055\u308c\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6df1\u307f\u3092\u4e0e\u3048\u307e\u3059\u3002[\u6bd4\u55a9\u89e3\u8aac\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306f\u3001\u5192\u967a\u3092\u8c4a\u304b\u306a\u3082\u306e\u306b\u3059\u308b\u96a0\u3057\u5b9d\u7269\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002]"}]
[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ud589\ub3d9\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8 \ub3d9\uc791\uc5d0\ub294 \uc774\ub3d9, \uc810\ud504 \ubc0f \uc6b8\uc74c\uc18c\ub9ac \uc0ac\uc6a9\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uc774\ub3d9\ud558\ub824\uba74 \ud654\uc0b4\ud45c \ud0a4\ub098 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc810\ud504\ud558\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uace0 \"S\" \ud0a4\ub97c \ub20c\ub7ec \uc801\uc774\ub098 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc608\ub85c \uc7a0\uae34 \ubb38\uc744 \ub9cc\ub0ac\uc744 \ub54c, \ubb38 \uadfc\ucc98\uc5d0\uc11c \uc6b8\uc74c\uc18c\ub9ac\ub97c \uc9c0\ub974\uba74 \ubb38\uc744 \uc5f4 \uae30\uad6c\uac00 \uc791\ub3d9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc6b8\uc74c\uc18c\ub9ac\ub97c \ubb38\ubfd0\ub9cc \uc544\ub2c8\ub77c \uc0c8\ub85c\uc6b4 \uc804\ub7b5\uae4c\uc9c0 \uc5f4\ub9ac\ub294 \uc5f4\uc1e0\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ucd5c\uc801\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \ucd08\uae30 \uc124\uc815\ud574\uc57c \ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd5c\uc801\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uba3c\uc800 \uadf8\ub798\ud53d \ubb38\uc81c\ub97c \ud53c\ud558\uae30 \uc704\ud574 \ubaa8\ub2c8\ud130\uc758 \uae30\ubcf8 \uc124\uc815\uacfc \uc77c\uce58\ud558\ub3c4\ub85d \ud574\uc0c1\ub3c4\ub97c \uc124\uc815\ud558\uc138\uc694. \uc74c\ud5a5 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc74c\uc545\uacfc \ud6a8\uacfc\ub97c \uc870\ud654\uc2dc\ud0a4\uc138\uc694. \uc88b\uc740 \uc2dc\uc791\uc810\uc740 \uc74c\uc545 70%, \uc0ac\uc6b4\ub4dc \ud6a8\uacfc 90%\uc785\ub2c8\ub2e4. \uc81c\uc5b4 \uba54\ub274\uc5d0\uc11c \"\ube60\ub978 \ube44\uba85\"\uc744 \ud65c\uc131\ud654\ud558\uc5ec \ubc18\uc751 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uc138\uc694. [\uc124\uc815 \ub300\uc870\ud45c: \ud574\uc0c1\ub3c4: \uae30\ubcf8; \uc74c\uc545: 70%; \uc0ac\uc6b4\ub4dc \ud6a8\uacfc: 90%; \ube60\ub978 \ube44\uba85: \ud65c\uc131\ud654]"}, {"question": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uc6b8\uc74c\uc18c\ub9ac \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud560 \ub54c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6b8\uc74c\uc18c\ub9ac \ud0c0\uc774\ubc0d\uc740 \ud6a8\uacfc\uc131\uacfc \ucfe8\ud0c0\uc784\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc774 \uacf5\uaca9\ud558\ub824\ub294 \uc21c\uac04 \ubc14\ub85c \uc6b8\uc74c\uc18c\ub9ac\ub97c \uc9c0\ub974\uba74 \uc801\uc744 \uae30\uc808\uc2dc\ucf1c \ubc18\uaca9\ud558\uac70\ub098 \ub3c4\ub9dd\uce60 \uae30\ud68c\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc774 \ub9de\uc9c0 \uc54a\ub294 \uc6b8\uc74c\uc18c\ub9ac\ub294 \ub2f9\uc2e0\uc744 \ucde8\uc57d\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uadf8\ub9bc: \uc801 \uc811\uadfc -> \uacf5\uaca9 \uc2e0\ud638 \ub300\uae30 -> \uc6b8\uc74c\uc18c\ub9ac \uc2e4\ud589 -> \uc801 \uae30\uc808 -> \ubc18\uaca9/\ud0c8\ucd9c]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4\uc5d0\ub294 \ud22c\uc790 \ub300\ube44 \uc218\uc775\ub960\uc774 \uac00\uc7a5 \ub192\uc740 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc21c\uc704\ub85c \uc815\ud558\uc5ec \uc790\uc6d0 \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc774 \ub354 \ub113\uac8c \ubd84\uc0b0\ub418\ub294 \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c \uc6b8\uc74c\uc18c\ub9ac\uc758 \uc0ac\uc815\uac70\ub9ac \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uba3c\uc800 \ud558\ub294 \uac83\uc774 \ub2a5\ub825 \uac15\ud654\ubcf4\ub2e4 \ub354 \uc720\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc194\ub8e8\uc158 \ube44\uad50: \uc0ac\uc815\uac70\ub9ac \uc5c5\uadf8\ub808\uc774\ub4dc \ub300 \ub2a5\ub825 \uc5c5\uadf8\ub808\uc774\ub4dc: \uc0ac\uc815\uac70\ub9ac\ub294 \uc601\ud5a5 \ubc94\uc704\ub97c \uc99d\uac00\uc2dc\ud0a4\uace0, \ub2a5\ub825\uc740 \ud53c\ud574\ub7c9\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4; \uc0ac\uc815\uac70\ub9ac\uac00 \ubd84\uc0b0\ub41c \uc801\uc5d0\uac8c \ub354 \uc720\ub9ac\ud569\ub2c8\ub2e4.]"}, {"question": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud574 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uad00\ucc30\ud558\uace0 \uc548\uc804\ud55c \uc9c0\uc5ed\uc744 \ucc3e\uc73c\uc138\uc694. 2\ub2e8\uacc4: \uc6b8\uc74c\uc18c\ub9ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcf4\uc2a4\uc758 \uac15\ub825\ud55c \uacf5\uaca9\uc744 \ubc29\ud574\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubcf4\uc2a4\uac00 \ub354 \uacf5\uaca9\uc801\uc73c\ub85c \ubcc0\ud558\ub294 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0 \uac74\uac15 \ud68c\ubcf5 \uc544\uc774\ud15c\uc744 \uc808\uc57d\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ubcf4\uc2a4\uc804\uc744 \ud0c0\uc774\ubc0d\uacfc \ub9ac\ub4ec\uc774 \uc911\uc694\ud55c \ucda4\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uc804\ub7b5\uc801\uc778 \uc774\uc810\uc744 \uc704\ud574 \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \ub2a5\ub825\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc0dd\uc874\ub825\uacfc \uc81c\uc555\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub2a5\ub825\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\ubc18\ud5a5 \uc6b8\uc74c\uc18c\ub9ac\" \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \uc6b8\uc74c\uc18c\ub9ac\uac00 \uc5ec\ub7ec \uba85\uc758 \uc801\uc5d0\uac8c \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\uc73c\ubbc0\ub85c \ud63c\uc7a1\ud55c \uc9c0\uc5ed\uc5d0\uc11c \ub9e4\uc6b0 \uadc0\uc911\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ubc18\ud5a5 \uc6b8\uc74c\uc18c\ub9ac: \uc801\uc911 \uc801 \uc218 \uc99d\uac00; \uc9c0\uc18d \uc2dc\uac04: \uae30\uc808 \uc2dc\uac04 \uc5f0\uc7a5; \ucfe8\ud0c0\uc784: \uc6b8\uc74c\uc18c\ub9ac \uc0ac\uc774 \uc9c0\uc5f0 \uac10\uc18c]"}, {"question": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uc801 AI \ud589\ub3d9\uc744 \uc9c0\ubc30\ud558\ub294 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc758 \uc801 AI\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uadfc\uc811\uc131\uacfc \ud589\ub3d9\uc5d0 \uc758\ud574 \ud2b8\ub9ac\uac70\ub418\ub294 \uc0c1\ud0dc \uae30\ubc18 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uac10\uc9c0\ud560 \ub54c\uae4c\uc9c0 \uc21c\ucc30\ud558\ub2e4\uac00 \uacf5\uaca9 \ubaa8\ub4dc\ub85c \uc804\ud658\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uadf8\ub9bc: \uc21c\ucc30 \ubaa8\ub4dc > \uac10\uc9c0 > \uacf5\uaca9 \ubaa8\ub4dc > \ud50c\ub808\uc774\uc5b4 \ud589\ub3d9\uc5d0 \uae30\ubc18\ud55c \uacf5\uaca9/\ud6c4\ud1f4]"}, {"question": "\uac8c\uc784\uc758 \ub09c\uc774\ub3c4 \uc870\uc815\uc774 \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \uc790\uc6d0 \uac00\uc6a9\uc131\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub09c\uc774\ub3c4\uac00 \ub192\uc544\uc9c0\uba74 \uc790\uc6d0\uc774 \ubd80\uc871\ud574\uc9c0\ubbc0\ub85c \ub354\uc6b1 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\ub09c\uc774\ub3c4\uc5d0\uc11c\ub294 \uac74\uac15 \ud68c\ubcf5 \uc544\uc774\ud15c\uacfc \uc6b8\uc74c\uc18c\ub9ac \ucfe8\ud0c0\uc784\uc774 \uc801\uc5b4\uc9c0\ubbc0\ub85c \ud50c\ub808\uc774\uc5b4\ub294 \uc18c\ubaa8\ud488\uc5d0 \uc758\uc874\ud558\uae30\ubcf4\ub2e4 \uae30\uc220\uc5d0 \ub354 \ub9ce\uc774 \uc758\uc874\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \uc194\ub8e8\uc158 \ube44\uad50: \uc26c\uc6c0: \ud48d\ubd80\ud55c \uc790\uc6d0; \ubcf4\ud1b5: \uade0\ud615; \uc5b4\ub824\uc6c0: \ubd80\uc871\ud55c \uc790\uc6d0, \uae30\uc220 \uc758\uc874 \uc99d\uac00]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc\uc73c\ub85c \ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc608, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud6c4 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ud558\uace0, \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ub85c\ub4dc\ud558\uc5ec \uc911\ub2e8\ub41c \uc9c0\uc810\ubd80\ud130 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc11c\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5f0\uacb0\ud558\ub294 \ub2e4\ub9ac\uac00\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc774\uac83\ub4e4\uc774 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub2ed \uc6b8\uc74c\uc18c\ub9ac \uac8c\uc784\uc5d0\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \uc6b8\uc74c\uc18c\ub9ac \uc21c\uc11c\ub97c \uc218\ud589\ud558\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \uac19\uc740 \uc5ec\ub7ec \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ub808\ubca8\uc740 \ub3c5\ud2b9\ud55c \ub09c\uad00\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud558\ub294 \uac83\uc740 \ubaa8\ud5d8\uc5d0 \ud48d\uc131\ud568\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
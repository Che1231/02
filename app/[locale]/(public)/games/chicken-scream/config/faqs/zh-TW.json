[{"question": "\u60f3\u8acb\u554f\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728\u300a\u96de\u53eb\u8072\u300b\u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5305\u542b\u79fb\u52d5\u3001\u8df3\u8e8d\u4ee5\u53ca\u4f7f\u7528\u4f60\u7684\u5c16\u53eb\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u79fb\u52d5\u53ef\u4ee5\u4f7f\u7528\u65b9\u5411\u9375\u6216\u6416\u687f\u3002\u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u8e8d\uff0c\u6309\u4e0b\u300eS\u300f\u9375\u5c16\u53eb\uff0c\u9019\u53ef\u4ee5\u5687\u9000\u6575\u4eba\u6216\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u5be6\u969b\u61c9\u7528\u7bc4\u4f8b\uff1a\u7576\u4f60\u9047\u5230\u9396\u4f4f\u7684\u9580\u6642\uff0c\u5728\u9580\u9644\u8fd1\u5c16\u53eb\u53ef\u4ee5\u89f8\u767c\u6a5f\u5236\u6253\u958b\u5b83\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u4f60\u7684\u5c16\u53eb\u8072\u60f3\u50cf\u6210\u9470\u5319\uff0c\u4e0d\u50c5\u80fd\u6253\u958b\u9580\uff0c\u4e5f\u80fd\u89e3\u9396\u65b0\u7684\u7b56\u7565\u3002]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u70ba\u7372\u5f97\u6700\u4f73\u904a\u6232\u9ad4\u9a57\uff0c\u6211\u61c9\u8a72\u8a2d\u5b9a\u54ea\u4e9b\u521d\u59cb\u8a2d\u5b9a\uff1f", "answer": "\u70ba\u4e86\u7372\u5f97\u6700\u4f73\u904a\u6232\u9ad4\u9a57\uff0c\u9996\u5148\u8acb\u5c07\u89e3\u6790\u5ea6\u8a2d\u5b9a\u70ba\u8207\u60a8\u7684\u87a2\u5e55\u539f\u751f\u89e3\u6790\u5ea6\u76f8\u7b26\uff0c\u4ee5\u907f\u514d\u756b\u9762\u554f\u984c\u3002\u8abf\u6574\u97f3\u6548\u8a2d\u5b9a\uff0c\u5e73\u8861\u97f3\u6a02\u548c\u97f3\u6548\uff1b\u4e00\u500b\u597d\u7684\u8d77\u9ede\u662f\u97f3\u6a0270%\uff0c\u97f3\u654890%\u3002\u5728\u63a7\u5236\u9078\u55ae\u4e2d\u555f\u7528\u300e\u5feb\u901f\u5c16\u53eb\u300f\uff0c\u4ee5\u7372\u5f97\u66f4\u5feb\u7684\u53cd\u61c9\u6642\u9593\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u89e3\u6790\u5ea6\uff1a\u539f\u751f\uff1b\u97f3\u6a02\u97f3\u91cf\uff1a70%\uff1b\u97f3\u6548\u97f3\u91cf\uff1a90%\uff1b\u5feb\u901f\u5c16\u53eb\uff1a\u555f\u7528]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u5c16\u53eb\u80fd\u529b\u7684\u6642\u6a5f\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u6b63\u78ba\u5730\u638c\u63e1\u5c16\u53eb\u6642\u6a5f\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u5c16\u53eb\u7684\u6709\u6548\u6027\u548c\u51b7\u537b\u6642\u9593\u3002\u4f8b\u5982\uff0c\u7576\u6575\u4eba\u5373\u5c07\u653b\u64ca\u6642\u5c16\u53eb\uff0c\u53ef\u4ee5\u8b93\u6575\u4eba\u6688\u7729\uff0c\u7d66\u4f60\u53cd\u64ca\u6216\u9003\u8dd1\u7684\u6a5f\u6703\u3002\u5c16\u53eb\u6642\u6a5f\u4e0d\u5c0d\uff0c\u5247\u53ef\u80fd\u8b93\u4f60\u8655\u65bc\u5371\u96aa\u5883\u5730\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6575\u4eba\u63a5\u8fd1 \u2192 \u7b49\u5019\u653b\u64ca\u4fe1\u865f \u2192 \u5be6\u65bd\u5c16\u53eb \u2192 \u6688\u7729\u6575\u4eba \u2192 \u53cd\u64ca/\u9003\u8dd1]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u73a9\u8d85\u904e100\u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\uff1f", "answer": "\u5728\u73a9\u4e86\u8d85\u904e100\u5c0f\u6642\u5f8c\uff0c\u96c6\u4e2d\u7cbe\u529b\u512a\u5316\u8cc7\u6e90\u7684\u4f7f\u7528\uff0c\u512a\u5148\u5347\u7d1a\u80fd\u63d0\u4f9b\u6700\u4f73\u56de\u5831\u7684\u5347\u7d1a\u3002\u4f8b\u5982\uff0c\u5728\u6575\u4eba\u5206\u6563\u7684\u5f8c\u671f\u95dc\u5361\u4e2d\uff0c\u5347\u7d1a\u4f60\u7684\u5c16\u53eb\u7bc4\u570d\uff0c\u800c\u4e0d\u662f\u5c16\u53eb\u5a01\u529b\uff0c\u53ef\u80fd\u6703\u66f4\u6709\u6548\u76ca\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u5347\u7d1a\u7bc4\u570d vs. \u5a01\u529b\uff1a\u7bc4\u570d\u589e\u52a0\u5f71\u97ff\u7bc4\u570d\uff0c\u5a01\u529b\u589e\u52a0\u50b7\u5bb3\uff1b\u5c0d\u65bc\u5206\u6563\u7684\u6575\u4eba\u800c\u8a00\uff0c\u7bc4\u570d\u512a\u65bc\u5a01\u529b\u3002]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u6253\u6557\u6700\u7d42boss\uff1f", "answer": "\u8981\u6253\u6557\u6700\u7d42boss\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u89c0\u5bdfboss\u7684\u653b\u64ca\u6a21\u5f0f\uff0c\u627e\u5230\u5b89\u5168\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u4f60\u7684\u5c16\u53eb\u8072\u4e2d\u65b7boss\u7684\u5f37\u529b\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u5c07\u751f\u547d\u85e5\u5291\u5132\u5099\u5728boss\u8b8a\u5f97\u66f4\u5177\u4fb5\u7565\u6027\u7684\u6700\u7d42\u968e\u6bb5\u4f7f\u7528\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07boss\u7684\u6230\u9b25\u8996\u70ba\u4e00\u5834\u821e\u8e48\uff0c\u6642\u6a5f\u548c\u7bc0\u594f\u662f\u6210\u529f\u7684\u95dc\u9375\u3002]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u70ba\u4e86\u7372\u5f97\u7b56\u7565\u512a\u52e2\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u80fd\u529b\uff1f", "answer": "\u512a\u5148\u5347\u7d1a\u80fd\u63d0\u5347\u4f60\u7684\u751f\u5b58\u80fd\u529b\u548c\u63a7\u5236\u6575\u4eba\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u300e\u8ff4\u97ff\u5c16\u53eb\u300f\uff0c\u8b93\u4f60\u7684\u5c16\u53eb\u8072\u5f71\u97ff\u591a\u500b\u6575\u4eba\uff0c\u5728\u64c1\u64e0\u7684\u5340\u57df\u4e2d\u975e\u5e38\u5bf6\u8cb4\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8ff4\u97ff\u5c16\u53eb\uff1a\u589e\u52a0\u53d7\u5f71\u97ff\u6575\u4eba\u6578\u91cf\uff1b\u6301\u7e8c\u6642\u9593\uff1a\u5ef6\u9577\u6688\u7729\u6642\u9593\uff1b\u51b7\u537b\u6642\u9593\uff1a\u7e2e\u77ed\u5c16\u53eb\u9593\u9694]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u6a5f\u5236\u652f\u914d\u8457\u6575\u4ebaAI\u7684\u884c\u70ba\uff1f", "answer": "\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\u7684\u6575\u4ebaAI\u57fa\u65bc\u72c0\u614b\u7cfb\u7d71\u904b\u4f5c\uff0c\u73a9\u5bb6\u7684\u63a5\u8fd1\u548c\u884c\u52d5\u6703\u89f8\u767c\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u6575\u4eba\u6703\u5de1\u908f\uff0c\u76f4\u5230\u5075\u6e2c\u5230\u73a9\u5bb6\uff0c\u7136\u5f8c\u8f49\u63db\u70ba\u4fb5\u7565\u6a21\u5f0f\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5de1\u908f\u6a21\u5f0f \u2192 \u5075\u6e2c \u2192 \u4fb5\u7565\u6a21\u5f0f \u2192 \u57fa\u65bc\u73a9\u5bb6\u884c\u52d5\u7684\u653b\u64ca/\u64a4\u9000]"}, {"question": "\u904a\u6232\u96e3\u5ea6\u63d0\u5347\u5982\u4f55\u5f71\u97ff\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\u7684\u8cc7\u6e90\u7372\u53d6\uff1f", "answer": "\u96a8\u8457\u96e3\u5ea6\u7684\u63d0\u5347\uff0c\u8cc7\u6e90\u8b8a\u5f97\u66f4\u7a00\u5c11\uff0c\u9700\u8981\u66f4\u5468\u8a73\u7684\u898f\u5283\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u96e3\u5ea6\u4e0b\uff0c\u751f\u547d\u85e5\u5291\u548c\u5c16\u53eb\u51b7\u537b\u6642\u9593\u6e1b\u5c11\uff0c\u8feb\u4f7f\u73a9\u5bb6\u66f4\u4f9d\u8cf4\u6280\u5de7\uff0c\u800c\u4e0d\u662f\u6d88\u8017\u54c1\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u5bb9\u6613\uff1a\u8cc7\u6e90\u8c50\u5bcc\uff1b\u666e\u901a\uff1a\u5e73\u8861\uff1b\u56f0\u96e3\uff1a\u8cc7\u6e90\u7a00\u5c11\uff0c\u66f4\u4f9d\u8cf4\u6280\u5de7]"}, {"question": "\u6211\u80fd\u5c07\u300a\u96de\u53eb\u8072\u300bPC\u7248\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\u55ce\uff1f", "answer": "\u53ef\u4ee5\uff0c\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u8f49\u79fb\u9032\u5ea6\u3002\u8acb\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u865f\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\u5b8c\u6210\u4e00\u95dc\u5f8c\uff0c\u5c07\u9032\u5ea6\u5132\u5b58\u5230\u96f2\u7aef\uff0c\u7136\u5f8c\u5728\u624b\u6a5f\u88dd\u7f6e\u4e0a\u8f09\u5165\uff0c\u7e7c\u7e8c\u672a\u5b8c\u6210\u7684\u90e8\u5206\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u96f2\u7aef\u5132\u5b58\u60f3\u50cf\u6210\u4e00\u5ea7\u9023\u63a5\u4e0d\u540c\u88dd\u7f6e\u904a\u6232\u9ad4\u9a57\u7684\u6a4b\u6881\u3002]"}, {"question": "\u5728\u300a\u96de\u53eb\u8072\u300b\u904a\u6232\u4e2d\uff0c\u6709\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u96de\u53eb\u8072\u300b\u5305\u542b\u4e00\u4e9b\u5f69\u86cb\uff0c\u4f8b\u5982\uff0c\u5728\u4e3b\u9078\u55ae\u4e2d\u57f7\u884c\u7279\u5b9a\u9806\u5e8f\u7684\u5c16\u53eb\u8072\uff0c\u53ef\u4ee5\u9032\u5165\u96b1\u85cf\u95dc\u5361\u3002\u6b64\u95dc\u5361\u63d0\u4f9b\u7368\u7279\u7684\u6311\u6230\u548c\u734e\u52f5\uff0c\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u767c\u73fe\u5f69\u86cb\u5c31\u50cf\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u85cf\uff0c\u8c50\u5bcc\u4e86\u4f60\u7684\u5192\u96aa\u65c5\u7a0b\u3002]"}]
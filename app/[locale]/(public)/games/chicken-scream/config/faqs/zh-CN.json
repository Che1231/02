[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u6267\u884c\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u79fb\u52a8\u3001\u8df3\u8dc3\u548c\u4f7f\u7528\u4f60\u7684\u5c16\u53eb\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u8981\u79fb\u52a8\uff0c\u8bf7\u4f7f\u7528\u65b9\u5411\u952e\u6216\u64cd\u7eb5\u6746\u3002\u6309\u4e0b\u7a7a\u683c\u952e\u8df3\u8dc3\uff0c\u6309\u4e0b'S'\u952e\u5c16\u53eb\uff0c\u8fd9\u53ef\u4ee5\u5413\u8dd1\u654c\u4eba\u6216\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u4e00\u4e2a\u5b9e\u9645\u7684\u4f8b\u5b50\u662f\u5f53\u4f60\u9047\u5230\u9501\u7740\u7684\u95e8\u65f6\uff0c\u5728\u95e8\u9644\u8fd1\u5c16\u53eb\u53ef\u4ee5\u89e6\u53d1\u673a\u5236\u6253\u5f00\u5b83\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u4f60\u7684\u5c16\u53eb\u58f0\u60f3\u8c61\u6210\u4e00\u628a\u94a5\u5319\uff0c\u5b83\u4e0d\u4ec5\u80fd\u6253\u5f00\u95e8\uff0c\u8fd8\u80fd\u89e3\u9501\u65b0\u7684\u7b56\u7565\u3002]"}, {"question": "\u4e3a\u4e86\u83b7\u5f97\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\uff0c\u6211\u5e94\u8be5\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u914d\u7f6e\u54ea\u4e9b\u521d\u59cb\u8bbe\u7f6e\uff1f", "answer": "\u4e3a\u4e86\u83b7\u5f97\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\uff0c\u9996\u5148\u5c06\u4f60\u7684\u5206\u8fa8\u7387\u8bbe\u7f6e\u4e3a\u4e0e\u663e\u793a\u5668\u539f\u751f\u5206\u8fa8\u7387\u76f8\u5339\u914d\uff0c\u4ee5\u907f\u514d\u56fe\u5f62\u95ee\u9898\u3002\u8c03\u6574\u58f0\u97f3\u8bbe\u7f6e\u4ee5\u5e73\u8861\u97f3\u4e50\u548c\u97f3\u6548\uff1b\u4e00\u4e2a\u4e0d\u9519\u7684\u8d77\u70b9\u662f\u97f3\u4e50\u97f3\u91cf\u4e3a 70%\uff0c\u97f3\u6548\u97f3\u91cf\u4e3a 90%\u3002\u5728\u63a7\u5236\u83dc\u5355\u4e2d\u542f\u7528\u201c\u5feb\u901f\u5c16\u53eb\u201d\uff0c\u4ee5\u83b7\u5f97\u66f4\u5feb\u7684\u54cd\u5e94\u65f6\u95f4\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u5206\u8fa8\u7387: \u539f\u751f; \u97f3\u4e50\u97f3\u91cf: 70%; \u97f3\u6548\u97f3\u91cf: 90%; \u5feb\u901f\u5c16\u53eb: \u542f\u7528]"}, {"question": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u4f7f\u7528\u5c16\u53eb\u6280\u80fd\u65f6\uff0c\u4e3a\u4ec0\u4e48\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u6b63\u786e\u638c\u63e1\u5c16\u53eb\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u6280\u80fd\u7684\u6709\u6548\u6027\u4ee5\u53ca\u51b7\u5374\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5f53\u654c\u4eba\u5373\u5c06\u653b\u51fb\u65f6\u5c16\u53eb\u53ef\u4ee5\u4f7f\u4ed6\u4eec\u6655\u7729\uff0c\u7ed9\u4f60\u53cd\u51fb\u6216\u9003\u8dd1\u7684\u673a\u4f1a\u3002\u65f6\u673a\u4e0d\u5f53\u7684\u5c16\u53eb\u4f1a\u4f7f\u4f60\u53d8\u5f97\u8106\u5f31\u3002[\u6d41\u7a0b\u56fe\u89e3: \u654c\u4eba\u9760\u8fd1 -> \u7b49\u5f85\u653b\u51fb\u4fe1\u53f7 -> \u6267\u884c\u5c16\u53eb -> \u6655\u7729\u654c\u4eba -> \u53cd\u51fb/\u9003\u8dd1]"}, {"question": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u73a9\u8d85\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u9ad8\u6548\u5730\u7ba1\u7406\u8d44\u6e90\uff1f", "answer": "\u5728\u73a9\u8d85\u8fc7 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u4f18\u5316\u8d44\u6e90\u4f7f\u7528\uff0c\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u56de\u62a5\u7387\u6700\u9ad8\u7684\u5347\u7ea7\u9879\u76ee\u3002\u4f8b\u5982\uff0c\u5728\u654c\u4eba\u5206\u5e03\u66f4\u5e7f\u7684\u540e\u671f\u5173\u5361\u4e2d\uff0c\u5347\u7ea7\u5c16\u53eb\u6280\u80fd\u7684\u8303\u56f4\uff0c\u800c\u4e0d\u662f\u5347\u7ea7\u5b83\u7684\u5a01\u529b\uff0c\u53ef\u80fd\u66f4\u6709\u76ca\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5347\u7ea7\u8303\u56f4\u4e0e\u5a01\u529b: \u8303\u56f4\u589e\u52a0\u5f71\u54cd\u533a\u57df\uff0c\u5a01\u529b\u589e\u52a0\u4f24\u5bb3; \u5bf9\u4e8e\u5206\u5e03\u5f0f\u654c\u4eba\u6765\u8bf4\uff0c\u8303\u56f4\u5347\u7ea7\u66f4\u53ef\u53d6\u3002]"}, {"question": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u91c7\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u51fb\u8d25\u6700\u7ec8\u7684boss\uff1f", "answer": "\u8981\u51fb\u8d25\u6700\u7ec8\u7684boss\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u89c2\u5bdfboss\u7684\u653b\u51fb\u6a21\u5f0f\u5e76\u627e\u5230\u5b89\u5168\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u4f60\u7684\u5c16\u53eb\u6765\u6253\u65ad\u5176\u5f3a\u5927\u7684\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u5728boss\u53d8\u5f97\u66f4\u52a0\u51f6\u731b\u7684\u6700\u7ec8\u9636\u6bb5\u4fdd\u7559\u751f\u547d\u836f\u6c34\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06boss\u6218\u89c6\u4e3a\u4e00\u573a\u821e\u8e48\uff0c\u65f6\u673a\u548c\u8282\u594f\u662f\u6210\u529f\u7684\u5173\u952e\u3002]"}, {"question": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\uff0c\u4e3a\u4e86\u83b7\u5f97\u6218\u7565\u4f18\u52bf\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u589e\u5f3a\u4f60\u751f\u5b58\u80fd\u529b\u548c\u7fa4\u4f53\u63a7\u5236\u80fd\u529b\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u201c\u56de\u58f0\u5c16\u53eb\u201d\u53ef\u4ee5\u8ba9\u4f60\u7684\u5c16\u53eb\u5f71\u54cd\u591a\u540d\u654c\u4eba\uff0c\u8fd9\u5728\u4eba\u7fa4\u5bc6\u96c6\u7684\u533a\u57df\u975e\u5e38\u5b9d\u8d35\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u56de\u58f0\u5c16\u53eb: \u589e\u52a0\u53d7\u5f71\u54cd\u7684\u654c\u4eba\u6570\u91cf; \u6301\u7eed\u65f6\u95f4: \u5ef6\u957f\u6655\u7729\u65f6\u95f4; \u51b7\u5374\u65f6\u95f4: \u51cf\u5c11\u5c16\u53eb\u4e4b\u95f4\u7684\u5ef6\u8fdf]"}, {"question": "\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u7684\u654c\u4ebaAI\u884c\u4e3a\u80cc\u540e\u9075\u5faa\u54ea\u4e9b\u57fa\u672c\u673a\u5236\uff1f", "answer": "\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u7684\u654c\u4ebaAI\u8fd0\u4f5c\u5728\u57fa\u4e8e\u72b6\u6001\u7684\u7cfb\u7edf\u4e2d\uff0c\u73a9\u5bb6\u7684\u63a5\u8fd1\u548c\u884c\u52a8\u4f1a\u89e6\u53d1\u5176\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u654c\u4eba\u4f1a\u5728\u4fa6\u6d4b\u5230\u73a9\u5bb6\u4e4b\u524d\u5de1\u903b\uff0c\u7136\u540e\u5207\u6362\u5230\u653b\u51fb\u6a21\u5f0f\u3002[\u6d41\u7a0b\u56fe\u89e3: \u5de1\u903b\u6a21\u5f0f -> \u4fa6\u6d4b -> \u653b\u51fb\u6a21\u5f0f -> \u57fa\u4e8e\u73a9\u5bb6\u884c\u52a8\u7684\u653b\u51fb/\u64a4\u9000]"}, {"question": "\u6e38\u620f\u96be\u5ea6\u63d0\u5347\u5982\u4f55\u5f71\u54cd\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\u7684\u8d44\u6e90\u53ef\u7528\u6027\uff1f", "answer": "\u968f\u7740\u96be\u5ea6\u7684\u63d0\u5347\uff0c\u8d44\u6e90\u53d8\u5f97\u66f4\u52a0\u7a00\u7f3a\uff0c\u9700\u8981\u66f4\u5468\u5bc6\u7684\u89c4\u5212\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u96be\u5ea6\u4e0b\uff0c\u751f\u547d\u836f\u6c34\u548c\u5c16\u53eb\u6280\u80fd\u7684\u51b7\u5374\u65f6\u95f4\u4f1a\u66f4\u5c11\uff0c\u8feb\u4f7f\u73a9\u5bb6\u66f4\u591a\u5730\u4f9d\u8d56\u6280\u80fd\uff0c\u800c\u4e0d\u662f\u6d88\u8017\u54c1\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u7b80\u5355: \u8d44\u6e90\u4e30\u5bcc; \u666e\u901a: \u5e73\u8861; \u56f0\u96be: \u8d44\u6e90\u7a00\u7f3a\uff0c\u66f4\u4f9d\u8d56\u6280\u80fd]"}, {"question": "\u6211\u53ef\u4ee5\u5728PC\u5e73\u53f0\u548c\u79fb\u52a8\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u300a\u5c16\u53eb\u9e21\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u8fdb\u5ea6\u53ef\u4ee5\u901a\u8fc7\u4e91\u4fdd\u5b58\u8fdb\u884c\u8f6c\u79fb\u3002\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5728PC\u5e73\u53f0\u4e0a\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u540e\uff0c\u5c06\u4f60\u7684\u8fdb\u5ea6\u4fdd\u5b58\u5230\u4e91\u7aef\uff0c\u7136\u540e\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u52a0\u8f7d\u5b83\uff0c\u7ee7\u7eed\u4f60\u4e4b\u524d\u7684\u8fdb\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u4e91\u4fdd\u5b58\u60f3\u8c61\u6210\u4e00\u5ea7\u6865\u6881\uff0c\u8fde\u63a5\u4f60\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u6e38\u620f\u4f53\u9a8c\u3002]"}, {"question": "\u5728\u300a\u5c16\u53eb\u9e21\u300b\u4e2d\uff0c\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5c16\u53eb\u9e21\u300b\u5305\u542b\u4e00\u4e9b\u5f69\u86cb\uff0c\u4f8b\u5982\uff0c\u901a\u8fc7\u5728\u4e3b\u83dc\u5355\u4e2d\u6267\u884c\u7279\u5b9a\u987a\u5e8f\u7684\u5c16\u53eb\uff0c\u53ef\u4ee5\u8bbf\u95ee\u4e00\u4e2a\u9690\u85cf\u5173\u5361\u3002\u8fd9\u4e2a\u5173\u5361\u63d0\u4f9b\u4e86\u72ec\u7279\u7684\u6311\u6218\u548c\u5956\u52b1\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u53d1\u73b0\u5f69\u86cb\u5c31\u50cf\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\uff0c\u4e30\u5bcc\u4e86\u4f60\u7684\u5192\u9669\u3002]"}]
[{"question": "Cleverdle\u662f\u5982\u4f55\u6307\u5bfc\u65b0\u73a9\u5bb6\u5b8c\u6210\u521d\u59cb\u8bbe\u7f6e\u7684\uff1f", "answer": "Cleverdle\u63d0\u4f9b\u4e86\u4e00\u4e2a\u5168\u9762\u7684\u6559\u7a0b\uff0c\u6307\u5bfc\u65b0\u73a9\u5bb6\u5b8c\u6210\u521d\u59cb\u8bbe\u7f6e\u8fc7\u7a0b\u3002\u6559\u7a0b\u5305\u542b\u9010\u6b65\u8bf4\u660e\uff0c\u4ecb\u7ecd\u5982\u4f55\u6d4f\u89c8\u6e38\u620f\u754c\u9762\u3001\u81ea\u5b9a\u4e49\u8bbe\u7f6e\u4ee5\u53ca\u7406\u89e3\u57fa\u672c\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u5c06\u88ab\u5f15\u5bfc\u8bbe\u7f6e\u9996\u9009\u8bed\u8a00\u5e76\u8c03\u6574\u97f3\u9891\u8bbe\u7f6e\uff0c\u7136\u540e\u518d\u5f00\u59cb\u7b2c\u4e00\u573a\u6bd4\u8d5b\u3002\u8fd9\u4fdd\u8bc1\u4e86\u6d41\u7545\u7684\u5165\u95e8\u4f53\u9a8c\uff0c\u5e76\u5e2e\u52a9\u73a9\u5bb6\u4ece\u4e00\u5f00\u59cb\u5c31\u611f\u5230\u8212\u9002\u3002"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u638c\u63e1Cleverdle\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u638c\u63e1Cleverdle\u9700\u8981\u8fd0\u7528\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u6a21\u5f0f\u8bc6\u522b\u3001\u9ad8\u6548\u8d44\u6e90\u7ba1\u7406\u4ee5\u53ca\u4f18\u5316\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u8bc6\u522b\u6e38\u620f\u4e2d\u91cd\u590d\u51fa\u73b0\u7684\u6a21\u5f0f\uff0c\u4ee5\u9884\u6d4b\u7ed3\u679c\u3002\u6b65\u9aa4\u4e8c\uff1a\u660e\u667a\u5730\u7ba1\u7406\u8d44\u6e90\uff0c\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u6536\u76ca\u6700\u5927\u7684\u9879\u76ee\u3002\u6b65\u9aa4\u4e09\uff1a\u6301\u7eed\u6539\u8fdb\u4f60\u7684\u6e38\u620f\u673a\u5236\uff0c\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002\u4f8b\u5982\uff0c\u59cb\u7ec8\u5e94\u7528\u8fd9\u4e9b\u7b56\u7565\u7684\u73a9\u5bb6\u901a\u5e38\u4f1a\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u5e76\u89e3\u9501\u7a00\u6709\u6210\u5c31\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3Cleverdle\u4e2d\u7684\u6570\u503c\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3Cleverdle\u4e2d\u7684\u6570\u503c\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u6e38\u620f\u6548\u7387\u548c\u6210\u529f\u7387\u3002\u6e38\u620f\u673a\u5236\u5305\u542b\u590d\u6742\u7684\u8ba1\u7b97\uff0c\u51b3\u5b9a\u8d44\u6e90\u5206\u914d\u3001\u4f24\u5bb3\u8f93\u51fa\u548c\u8fdb\u5ea6\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u77e5\u9053\u4f55\u65f6\u6700\u4f73\u4f7f\u7528\u5f3a\u529b\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u8868\u73b0\u3002\u901a\u8fc7\u638c\u63e1\u8fd9\u4e9b\u673a\u5236\uff0c\u73a9\u5bb6\u53ef\u4ee5\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\uff0c\u4ece\u800c\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u548c\u66f4\u4ee4\u4eba\u6109\u60a6\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8fc1\u79fb\u4ed6\u4eec\u7684Cleverdle\u6570\u636e\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5229\u7528\u6e38\u620f\u7684\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8fc1\u79fbCleverdle\u6570\u636e\u3002\u6b64\u529f\u80fd\u5141\u8bb8\u73a9\u5bb6\u5728\u591a\u53f0\u8bbe\u5907\u4e0a\u540c\u6b65\u4ed6\u4eec\u7684\u8fdb\u5ea6\u3001\u6210\u5c31\u548c\u8bbe\u7f6e\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u7535\u8111\u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u7136\u540e\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u7ee7\u7eed\u8fdb\u884c\uff0c\u65e0\u7f1d\u8854\u63a5\u3002\u4e3a\u6b64\uff0c\u8bf7\u786e\u4fdd\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\uff0c\u5e76\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u542f\u7528\u4e91\u7aef\u4fdd\u5b58\u9009\u9879\u3002"}, {"question": "\u73a9\u5bb6\u5728Cleverdle\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u4e0d\u90a3\u4e48\u663e\u773c\u7684\u5730\u65b9\u5e76\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6765\u53d1\u73b0Cleverdle\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u6709\u79d8\u5bc6\u5173\u5361\u548c\u7a00\u6709\u7269\u54c1\uff0c\u53ea\u80fd\u901a\u8fc7\u89e3\u51b3\u590d\u6742\u7684\u8c1c\u9898\u6216\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u624d\u80fd\u627e\u5230\u3002\u4e00\u4e2a\u4f8b\u5b50\u662f\u9690\u85cf\u5728\u504f\u50fb\u5730\u7262\u4e2d\u7684\u201c\u91d1\u94a5\u5319\u201d\uff0c\u5b83\u53ef\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u7684\u5b9d\u7bb1\u3002\u4e3a\u4e86\u63ed\u5f00\u8fd9\u4e9b\u79d8\u5bc6\uff0c\u73a9\u5bb6\u5e94\u8be5\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u4e16\u754c\uff0c\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u7b56\u7565\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728Cleverdle\u4e2d\uff0c\u4e3a\u4e86\u83b7\u5f97\u6700\u4f73\u4f53\u9a8c\uff0c\u5e94\u8be5\u9996\u5148\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\uff1f", "answer": "\u65b0\u73a9\u5bb6\u4e3a\u4e86\u83b7\u5f97\u6700\u4f73\u4f53\u9a8c\uff0c\u5e94\u8be5\u9996\u5148\u8c03\u6574\u63a7\u5236\u7075\u654f\u5ea6\u3001\u97f3\u9891\u97f3\u91cf\u548c\u56fe\u5f62\u8bbe\u7f6e\u3002\u4f8b\u5982\uff0c\u5c06\u63a7\u5236\u7075\u654f\u5ea6\u8bbe\u7f6e\u4e3a\u8212\u9002\u7684\u6c34\u5e73\u53ef\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u800c\u8c03\u6574\u97f3\u9891\u97f3\u91cf\u5219\u589e\u5f3a\u4e86\u6c89\u6d78\u611f\u3002\u6b64\u5916\uff0c\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u8f83\u4f4e\u7684\u8bbe\u5907\u4e0a\u7684\u6027\u80fd\u3002\u8fd9\u4e9b\u8c03\u6574\u6709\u52a9\u4e8e\u521b\u5efa\u4e2a\u6027\u5316\u4e14\u6109\u60a6\u7684\u6e38\u620f\u73af\u5883\uff0c\u6ee1\u8db3\u4e2a\u4eba\u559c\u597d\u3002"}, {"question": "Cleverdle\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "Cleverdle\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51c6\u786e\u6027\u3001\u901f\u5ea6\u548c\u8d44\u6e90\u7ba1\u7406\u7684\u7ed3\u5408\u3002\u73a9\u5bb6\u5b8c\u6210\u4efb\u52a1\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u8d8a\u9ad8\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728\u6700\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u5173\u5361\uff0c\u4e14\u4e0d\u4f7f\u7528\u4efb\u4f55\u5f3a\u529b\u9053\u5177\uff0c\u5219\u53ef\u83b7\u5f97\u6700\u9ad8\u5206\u3002\u6b64\u5916\uff0c\u9ad8\u6548\u7684\u8d44\u6e90\u7ba1\u7406\uff0c\u4f8b\u5982\u8282\u7701\u751f\u547d\u836f\u5242\uff0c\u4e5f\u53ef\u63d0\u5347\u6700\u7ec8\u5f97\u5206\u3002\u4e86\u89e3\u8fd9\u4e9b\u56e0\u7d20\uff0c\u73a9\u5bb6\u53ef\u4ee5\u6709\u6548\u5236\u5b9a\u7b56\u7565\uff0c\u5e76\u4e89\u53d6\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u5728Cleverdle\u4e2d\u63d0\u9ad8\u6e38\u620f\u6548\u7387\u7684\u6700\u6709\u6548\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u63d0\u9ad8Cleverdle\u6e38\u620f\u6548\u7387\u7684\u6700\u6709\u6548\u65b9\u6cd5\u5305\u62ec\u638c\u63e1\u63a7\u5236\u3001\u4f18\u5316\u8d44\u6e90\u4f7f\u7528\u4ee5\u53ca\u5229\u7528\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa4\u4e00\uff1a\u7ec3\u4e60\u63a7\u5236\uff0c\u786e\u4fdd\u5feb\u901f\u548c\u51c6\u786e\u7684\u53cd\u5e94\u3002\u6b65\u9aa4\u4e8c\uff1a\u901a\u8fc7\u9884\u5148\u8ba1\u5212\u548c\u4f18\u5148\u9009\u62e9\u5fc5\u8981\u7684\u5347\u7ea7\u6765\u4f18\u5316\u8d44\u6e90\u4f7f\u7528\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u6e38\u620f\u673a\u5236\uff0c\u5982\u8fde\u51fb\u548c\u5f3a\u529b\u9053\u5177\uff0c\u6700\u5927\u5316\u8f93\u51fa\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8fde\u51fb\u94fe\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u5b8c\u6210\u5173\u5361\u6240\u9700\u7684\u65f6\u95f4\uff0c\u4ece\u800c\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0Cleverdle\u7684\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u8fd9\u4e9b\u6210\u5c31\u63d0\u4f9b\u54ea\u4e9b\u5956\u52b1\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\uff08\u901a\u5e38\u4e0d\u660e\u663e\u7684\uff09\u4efb\u52a1\u6216\u6ee1\u8db3\u72ec\u7279\u6761\u4ef6\u6765\u53d1\u73b0Cleverdle\u7684\u9690\u85cf\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u9690\u85cf\u6210\u5c31\u9700\u8981\u73a9\u5bb6\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u51fb\u8d25\u4e00\u4e2a\u9996\u9886\u3002\u8fd9\u4e9b\u6210\u5c31\u901a\u5e38\u63d0\u4f9b\u7a00\u6709\u5956\u52b1\uff0c\u4f8b\u5982\u72ec\u5bb6\u76ae\u80a4\u3001\u6e38\u620f\u5185\u8d27\u5e01\u6216\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u7684\u7279\u6b8a\u7269\u54c1\u3002\u4e3a\u4e86\u627e\u5230\u8fd9\u4e9b\u6210\u5c31\uff0c\u73a9\u5bb6\u5e94\u8be5\u63a2\u7d22\u6240\u6709\u6e38\u620f\u65b9\u9762\uff0c\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884cCleverdle\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u8fd0\u884cCleverdle\u7684\u7cfb\u7edf\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u5728PC\u4e0a\uff0c\u6e38\u620f\u9700\u8981\u81f3\u5c11\u82f1\u7279\u5c14i5\u5904\u7406\u5668\u30018GB\u5185\u5b58\u548c\u914d\u59072GB\u663e\u5b58\u7684\u72ec\u7acb\u663e\u5361\u3002\u5bf9\u4e8e\u79fb\u52a8\u8bbe\u5907\uff0c\u5efa\u8bae\u4f7f\u7528\u5185\u5b58\u81f3\u5c114GB\u7684\u8bbe\u5907\u4ee5\u53caAndroid 8.0\u6216iOS 12\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ad8\u7aef\u667a\u80fd\u624b\u673a\uff08\u5982iPhone 12\uff09\u7684\u73a9\u5bb6\u53ef\u4ee5\u4eab\u53d7\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u800c\u4f7f\u7528\u65e7\u8bbe\u5907\u7684\u73a9\u5bb6\u53ef\u80fd\u9700\u8981\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002"}]
[{"question": "Cleverdle \u5982\u4f55\u6307\u5c0e\u65b0\u73a9\u5bb6\u5b8c\u6210\u521d\u59cb\u8a2d\u5b9a\u6d41\u7a0b\uff1f", "answer": "Cleverdle \u63d0\u4f9b\u4e00\u500b\u5168\u9762\u7684\u6559\u5b78\uff0c\u5f15\u5c0e\u65b0\u73a9\u5bb6\u5b8c\u6210\u521d\u59cb\u8a2d\u5b9a\u6d41\u7a0b\u3002\u6559\u5b78\u5305\u542b\u9010\u6b65\u8aaa\u660e\u5982\u4f55\u700f\u89bd\u904a\u6232\u4ecb\u9762\u3001\u81ea\u5b9a\u7fa9\u8a2d\u5b9a\u4ee5\u53ca\u77ad\u89e3\u57fa\u672c\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u5c07\u88ab\u5f15\u5c0e\u8a2d\u5b9a\u5176\u504f\u597d\u7684\u8a9e\u8a00\u548c\u8abf\u6574\u97f3\u6548\u8a2d\u5b9a\uff0c\u7136\u5f8c\u624d\u80fd\u958b\u59cb\u7b2c\u4e00\u5834\u904a\u6232\u3002\u9019\u78ba\u4fdd\u4e86\u9806\u66a2\u7684\u5165\u9580\u9ad4\u9a57\uff0c\u4e26\u5e6b\u52a9\u73a9\u5bb6\u5f9e\u4e00\u958b\u59cb\u5c31\u611f\u5230\u8212\u9069\u3002"}, {"question": "\u5728\u904a\u6232\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u638c\u63e1 Cleverdle \u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u904a\u6232\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u638c\u63e1 Cleverdle \u9700\u8981\u904b\u7528\u5148\u9032\u7b56\u7565\uff0c\u4f8b\u5982\u6a21\u5f0f\u8b58\u5225\u3001\u6709\u6548\u8cc7\u6e90\u7ba1\u7406\u548c\u6700\u4f73\u5316\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u8b58\u5225\u904a\u6232\u4e2d\u7684\u91cd\u8907\u6a21\u5f0f\uff0c\u4ee5\u9810\u6e2c\u7d50\u679c\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u512a\u5148\u5347\u7d1a\u5c0d\u73a9\u5bb6\u6709\u6700\u5927\u597d\u8655\u7684\u7269\u54c1\uff0c\u660e\u667a\u5730\u7ba1\u7406\u8cc7\u6e90\u3002\u6b65\u9a5f\u4e09\uff1a\u6301\u7e8c\u7cbe\u9032\u4f60\u7684\u904a\u6232\u6a5f\u5236\uff0c\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002\u4f8b\u5982\uff0c\u6301\u7e8c\u904b\u7528\u9019\u4e9b\u7b56\u7565\u7684\u73a9\u5bb6\u7d93\u5e38\u80fd\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u548c\u89e3\u9396\u7a00\u6709\u6210\u5c31\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u77ad\u89e3 Cleverdle \u7684\u6578\u5b57\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u77ad\u89e3 Cleverdle \u4e2d\u7684\u6578\u503c\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u904a\u6232\u6548\u7387\u548c\u6210\u529f\u3002\u904a\u6232\u7684\u6a5f\u5236\u6d89\u53ca\u8907\u96dc\u7684\u8a08\u7b97\uff0c\u6c7a\u5b9a\u8cc7\u6e90\u5206\u914d\u3001\u50b7\u5bb3\u8f38\u51fa\u548c\u9032\u5ea6\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u77e5\u9053\u4f55\u6642\u6700\u4f73\u5316\u4f7f\u7528\u5f37\u5316\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u8868\u73fe\u3002\u900f\u904e\u638c\u63e1\u9019\u4e9b\u6a5f\u5236\uff0c\u73a9\u5bb6\u53ef\u4ee5\u505a\u51fa\u660e\u667a\u7684\u6c7a\u5b9a\uff0c\u5f9e\u800c\u7372\u5f97\u66f4\u597d\u7684\u7d50\u679c\u548c\u66f4\u4ee4\u4eba\u6eff\u610f\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07 Cleverdle \u8cc7\u6599\u9077\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07 Cleverdle \u8cc7\u6599\u9077\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u3002\u6b64\u529f\u80fd\u5141\u8a31\u73a9\u5bb6\u5728\u591a\u500b\u88dd\u7f6e\u4e4b\u9593\u540c\u6b65\u4ed6\u5011\u7684\u9032\u5ea6\u3001\u6210\u5c31\u548c\u8a2d\u5b9a\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u96fb\u8166\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u4e26\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u9806\u5229\u7e7c\u7e8c\u3002\u70ba\u6b64\uff0c\u8acb\u78ba\u4fdd\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\uff0c\u4e26\u4e14\u5728\u8a2d\u5b9a\u9078\u55ae\u4e2d\u555f\u7528\u96f2\u7aef\u5132\u5b58\u9078\u9805\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Cleverdle \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u767c\u73fe\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u63a2\u7d22\u4e0d\u592a\u660e\u986f\u7684\u5340\u57df\u548c\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u4f86\u767c\u73fe Cleverdle \u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u6709\u4e9b\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u9053\u5177\u53ea\u80fd\u900f\u904e\u89e3\u958b\u8907\u96dc\u8b0e\u984c\u6216\u9054\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u624d\u80fd\u627e\u5230\u3002\u4e00\u500b\u4f8b\u5b50\u662f\u85cf\u5728\u504f\u9060\u5730\u7262\u4e2d\u7684\u300c\u9ec3\u91d1\u9470\u5319\u300d\uff0c\u53ef\u958b\u555f\u4e00\u500b\u7279\u6b8a\u7684\u5bf6\u7bb1\u3002\u70ba\u4e86\u63ed\u958b\u9019\u4e9b\u79d8\u5bc6\uff0c\u73a9\u5bb6\u61c9\u8a72\u5fb9\u5e95\u63a2\u7d22\u904a\u6232\u4e16\u754c\uff0c\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728 Cleverdle \u4e2d\uff0c\u70ba\u4e86\u7372\u5f97\u6700\u4f73\u9ad4\u9a57\uff0c\u61c9\u8a72\u5148\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\uff1f", "answer": "\u65b0\u73a9\u5bb6\u61c9\u8a72\u5148\u8abf\u6574 Cleverdle \u4e2d\u7684\u63a7\u5236\u9748\u654f\u5ea6\u3001\u97f3\u6548\u97f3\u91cf\u548c\u5716\u5f62\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u5c07\u63a7\u5236\u9748\u654f\u5ea6\u8abf\u6574\u5230\u8212\u9069\u7684\u6c34\u5e73\uff0c\u78ba\u4fdd\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u800c\u8abf\u6574\u97f3\u6548\u97f3\u91cf\u5247\u589e\u5f37\u904a\u6232\u6c89\u6d78\u611f\u3002\u6b64\u5916\uff0c\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u53ef\u4ee5\u63d0\u5347\u8f03\u4f4e\u6548\u80fd\u88dd\u7f6e\u7684\u904a\u6232\u6548\u80fd\u3002\u9019\u4e9b\u8abf\u6574\u6709\u52a9\u65bc\u5efa\u7acb\u4e00\u500b\u5ba2\u88fd\u5316\u4e14\u6109\u5feb\u7684\u904a\u6232\u74b0\u5883\uff0c\u4ee5\u7b26\u5408\u500b\u4eba\u559c\u597d\u3002"}, {"question": "Cleverdle \u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5206\u6578\uff1f", "answer": "Cleverdle \u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u6e96\u78ba\u5ea6\u3001\u901f\u5ea6\u548c\u8cc7\u6e90\u7ba1\u7406\u7684\u7d9c\u5408\u8003\u91cf\u3002\u73a9\u5bb6\u5b8c\u6210\u4efb\u52d9\u7684\u901f\u5ea6\u8d8a\u5feb\uff0c\u6e96\u78ba\u5ea6\u8d8a\u9ad8\uff0c\u5206\u6578\u5c31\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728\u6700\u77ed\u6642\u9593\u5167\u5b8c\u6210\u95dc\u5361\uff0c\u4e14\u4e0d\u4f7f\u7528\u4efb\u4f55\u5f37\u5316\u9053\u5177\uff0c\u5c07\u7372\u5f97\u6700\u9ad8\u5206\u6578\u3002\u6b64\u5916\uff0c\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\uff0c\u4f8b\u5982\u7bc0\u7d04\u6cbb\u7642\u85e5\u5291\uff0c\u4e5f\u80fd\u63d0\u5347\u6700\u7d42\u5206\u6578\u3002\u77ad\u89e3\u9019\u4e9b\u56e0\u7d20\uff0c\u73a9\u5bb6\u53ef\u4ee5\u6709\u6548\u5236\u5b9a\u7b56\u7565\uff0c\u4e26\u4ee5\u66f4\u9ad8\u7684\u5206\u6578\u70ba\u76ee\u6a19\u3002"}, {"question": "\u5728 Cleverdle \u4e2d\u63d0\u5347\u904a\u6232\u6548\u7387\u6700\u6709\u6548\u7684\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Cleverdle \u4e2d\u63d0\u5347\u904a\u6232\u6548\u7387\u6700\u6709\u6548\u7684\u65b9\u6cd5\u5305\u62ec\u7cbe\u901a\u63a7\u5236\u3001\u512a\u5316\u8cc7\u6e90\u4f7f\u7528\u548c\u5229\u7528\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f\u4e00\uff1a\u7df4\u7fd2\u63a7\u5236\uff0c\u4ee5\u78ba\u4fdd\u5feb\u901f\u548c\u6e96\u78ba\u7684\u53cd\u61c9\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u63d0\u524d\u898f\u5283\u548c\u512a\u5148\u5347\u7d1a\u91cd\u8981\u7269\u54c1\uff0c\u512a\u5316\u8cc7\u6e90\u4f7f\u7528\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u904a\u6232\u6a5f\u5236\uff0c\u4f8b\u5982\u9023\u64ca\u548c\u5f37\u5316\u9053\u5177\uff0c\u4ee5\u6700\u5927\u5316\u8f38\u51fa\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9023\u64ca\u53ef\u4ee5\u986f\u8457\u7e2e\u77ed\u5b8c\u6210\u95dc\u5361\u6240\u9700\u7684\u6642\u9593\uff0c\u5f9e\u800c\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u767c\u73fe Cleverdle \u7684\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5b83\u5011\u63d0\u4f9b\u54ea\u4e9b\u734e\u52f5\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u4e14\u901a\u5e38\u4e0d\u986f\u773c\u7684\u4efb\u52d9\u6216\u6eff\u8db3\u7368\u7279\u7684\u689d\u4ef6\u4f86\u767c\u73fe Cleverdle \u7684\u96b1\u85cf\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u96b1\u85cf\u6210\u5c31\u8981\u6c42\u73a9\u5bb6\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\u64ca\u6557\u4e00\u500b\u9996\u9818\u3002\u9019\u4e9b\u6210\u5c31\u901a\u5e38\u6703\u63d0\u4f9b\u7a00\u6709\u7684\u734e\u52f5\uff0c\u4f8b\u5982\u7368\u5bb6\u5916\u89c0\u3001\u904a\u6232\u5167\u8ca8\u5e63\u6216\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u7684\u7279\u6b8a\u7269\u54c1\u3002\u70ba\u4e86\u627e\u5230\u9019\u4e9b\u6210\u5c31\uff0c\u73a9\u5bb6\u61c9\u8a72\u63a2\u7d22\u6240\u6709\u904a\u6232\u65b9\u9762\uff0c\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u904b\u884c Cleverdle \u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u904b\u884c Cleverdle \u7684\u7cfb\u7d71\u9700\u6c42\u5404\u6709\u4e0d\u540c\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u904a\u6232\u81f3\u5c11\u9700\u8981 Intel i5 \u8655\u7406\u5668\u30018GB \u8a18\u61b6\u9ad4\u548c\u914d\u5099 2GB VRAM \u7684\u7368\u7acb\u986f\u793a\u5361\u3002\u5c0d\u65bc\u884c\u52d5\u88dd\u7f6e\uff0c\u5efa\u8b70\u4f7f\u7528\u81f3\u5c11 4GB \u8a18\u61b6\u9ad4\uff0c\u4e26\u904b\u884c Android 8.0 \u6216 iOS 12 \u4ee5\u4e0a\u7684\u7cfb\u7d71\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ad8\u968e\u667a\u6167\u578b\u624b\u6a5f\uff0c\u4f8b\u5982 iPhone 12 \u7684\u73a9\u5bb6\u53ef\u4ee5\u4eab\u53d7\u5230\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u800c\u4f7f\u7528\u8f03\u820a\u88dd\u7f6e\u7684\u73a9\u5bb6\u5247\u53ef\u80fd\u9700\u8981\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\u3002"}]
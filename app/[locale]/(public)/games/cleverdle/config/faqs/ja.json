[{"question": "Cleverdle\u306f\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u521d\u671f\u8a2d\u5b9a\u30d7\u30ed\u30bb\u30b9\u3092\u901a\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u6848\u5185\u3057\u307e\u3059\u304b\uff1f", "answer": "Cleverdle\u306f\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u521d\u671f\u8a2d\u5b9a\u30d7\u30ed\u30bb\u30b9\u3092\u901a\u3057\u3066\u6848\u5185\u3059\u308b\u305f\u3081\u306e\u5305\u62ec\u7684\u306a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u306e\u64cd\u4f5c\u65b9\u6cd5\u3001\u8a2d\u5b9a\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u65b9\u6cd5\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u306b\u95a2\u3059\u308b\u624b\u9806\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u306e\u30b2\u30fc\u30e0\u3092\u958b\u59cb\u3059\u308b\u524d\u306b\u3001\u597d\u307f\u306e\u8a00\u8a9e\u3092\u8a2d\u5b9a\u3057\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u3088\u3046\u306b\u6848\u5185\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30aa\u30f3\u30dc\u30fc\u30c7\u30a3\u30f3\u30b0\u4f53\u9a13\u304c\u5b9f\u73fe\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u304b\u3089\u5feb\u9069\u306b\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Cleverdle\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Cleverdle\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u3001\u52b9\u7387\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u6700\u9069\u5316\u3068\u3044\u3063\u305f\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u7e70\u308a\u8fd4\u3057\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3057\u3001\u7d50\u679c\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u3082\u5927\u304d\u306a\u30e1\u30ea\u30c3\u30c8\u3092\u3082\u305f\u3089\u3059\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3053\u3068\u3067\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u7d99\u7d9a\u7684\u306b\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u6d17\u7df4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u5e38\u306b\u9069\u7528\u3057\u3066\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u901a\u5e38\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u3001\u73cd\u3057\u3044\u5b9f\u7e3e\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002"}, {"question": "Cleverdle\u3067\u6570\u5024\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Cleverdle\u3067\u6570\u5024\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u30b2\u30fc\u30e0\u306e\u52b9\u7387\u6027\u3068\u6210\u529f\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u306e\u5272\u308a\u5f53\u3066\u3001\u30c0\u30e1\u30fc\u30b8\u91cf\u3001\u9032\u884c\u901f\u5ea6\u3092\u6c7a\u5b9a\u3059\u308b\u8907\u96d1\u306a\u8a08\u7b97\u3092\u542b\u3093\u3067\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u7b97\u3059\u308b\u65b9\u6cd5\u3092\u77e5\u3063\u3066\u3044\u308b\u3068\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u826f\u3044\u7d50\u679c\u3068\u3088\u308a\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u3064\u306a\u304c\u308b\u3001\u60c5\u5831\u3092\u57fa\u306b\u3057\u305f\u6c7a\u5b9a\u3092\u4e0b\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Cleverdle\u306e\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001Cleverdle\u306e\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3001\u5b9f\u7e3e\u3001\u8a2d\u5b9a\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306fPC\u3067\u30b2\u30fc\u30e0\u3092\u958b\u59cb\u3057\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3092\u884c\u3046\u306b\u306f\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6709\u52b9\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Cleverdle\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Cleverdle\u3067\u3001\u76ee\u7acb\u305f\u306a\u3044\u9818\u57df\u3092\u63a2\u691c\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u8ab2\u984c\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u305f\u308a\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3084\u73cd\u3057\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96a0\u308c\u6d1e\u7a9f\u306b\u3042\u308b\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30ad\u30fc\u300f\u306f\u3001\u7279\u5225\u306a\u5b9d\u7bb1\u3092\u958b\u3051\u308b\u9375\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u691c\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u6700\u9069\u306a\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001Cleverdle\u3067\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u306b\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u6700\u9069\u306a\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u306bCleverdle\u306e\u5236\u5fa1\u611f\u5ea6\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u30ec\u30d9\u30eb\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u64cd\u4f5c\u611f\u5ea6\u3092\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3057\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u30ec\u30d9\u30eb\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u6ca1\u5165\u611f\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u6027\u80fd\u306e\u4f4e\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8abf\u6574\u306b\u3088\u308a\u3001\u500b\u3005\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u30d1\u30fc\u30bd\u30ca\u30e9\u30a4\u30ba\u3055\u308c\u3001\u697d\u3057\u3044\u30b2\u30fc\u30e0\u74b0\u5883\u304c\u5275\u9020\u3055\u308c\u307e\u3059\u3002"}, {"question": "Cleverdle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Cleverdle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u6027\u3001\u901f\u5ea6\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30bf\u30b9\u30af\u3092\u65e9\u304f\u6b63\u78ba\u306b\u5b8c\u4e86\u3059\u308b\u307b\u3069\u3001\u30b9\u30b3\u30a2\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u6700\u77ed\u6642\u9593\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u6700\u5927\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u5065\u5eb7\u56de\u5fa9\u85ac\u3092\u7bc0\u7d04\u3059\u308b\u306a\u3069\u3001\u52b9\u7387\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3082\u6700\u7d42\u30b9\u30b3\u30a2\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u7684\u306b\u52b9\u679c\u7684\u306b\u884c\u52d5\u3057\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u305b\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Cleverdle\u3067\u30b2\u30fc\u30e0\u306e\u52b9\u7387\u6027\u3092\u9ad8\u3081\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "Cleverdle\u3067\u30b2\u30fc\u30e0\u306e\u52b9\u7387\u6027\u3092\u9ad8\u3081\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u3001\u64cd\u4f5c\u306e\u7fd2\u5f97\u3001\u30ea\u30bd\u30fc\u30b9\u306e\u6700\u9069\u5316\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u6d3b\u7528\u3067\u3059\u3002\u624b\u98061\uff1a\u8fc5\u901f\u304b\u3064\u6b63\u78ba\u306a\u53cd\u5fdc\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u64cd\u4f5c\u3092\u7df4\u7fd2\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98062\uff1a\u5fc5\u8981\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3053\u3068\u3067\u3001\u30ea\u30bd\u30fc\u30b9\u4f7f\u7528\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30b3\u30f3\u30dc\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u6d3b\u7528\u3057\u3066\u3001\u6210\u679c\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u5fc5\u8981\u306a\u6642\u9593\u3092\u5927\u5e45\u306b\u77ed\u7e2e\u3067\u304d\u308b\u305f\u3081\u3001\u52b9\u7387\u6027\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306fCleverdle\u306e\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u3092\u3069\u306e\u3088\u3046\u306b\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306a\u5831\u916c\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7279\u5b9a\u306e\u3001\u3057\u3070\u3057\u3070\u96a0\u308c\u305f\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3001\u30e6\u30cb\u30fc\u30af\u306a\u57fa\u6e96\u3092\u6e80\u305f\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001Cleverdle\u306e\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u79d8\u8535\u306e\u5b9f\u7e3e\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30dc\u30b9\u3092\u5012\u3059\u3053\u3068\u3092\u8981\u6c42\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5b9f\u7e3e\u306f\u901a\u5e38\u3001\u9650\u5b9a\u7684\u306a\u30b9\u30ad\u30f3\u3001\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3001\u307e\u305f\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u7279\u5225\u306a\u30a2\u30a4\u30c6\u30e0\u306a\u3069\u306e\u30ec\u30a2\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5b9f\u7e3e\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u306e\u3042\u3089\u3086\u308b\u5074\u9762\u3092\u63a2\u691c\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u8a66\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u3067Cleverdle\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Cleverdle\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001\u30b2\u30fc\u30e0\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u5c11\u306a\u304f\u3068\u3082Intel i5\u30d7\u30ed\u30bb\u30c3\u30b5\u30018GB\u306eRAM\u30012GB VRAM\u306e\u5c02\u7528\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u5834\u5408\u3001\u5c11\u306a\u304f\u3068\u30824GB\u306eRAM\u3068Android 8.0\u307e\u305f\u306fiOS 12\u642d\u8f09\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone 12\u306e\u3088\u3046\u306a\u30cf\u30a4\u30a8\u30f3\u30c9\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}]
[{"question": "Cleverdle\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \ucd08\uae30 \uc124\uc815 \uacfc\uc815\uc744 \ud1b5\ud574 \uc5b4\ub5bb\uac8c \uc548\ub0b4\ud569\ub2c8\uae4c?", "answer": "Cleverdle\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \ucd08\uae30 \uc124\uc815 \uacfc\uc815\uc744 \uc548\ub0b4\ud558\ub294 \ud3ec\uad04\uc801\uc778 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uac8c\uc784 \uc778\ud130\ud398\uc774\uc2a4\ub97c \ud0d0\uc0c9\ud558\uace0 \uc124\uc815\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\uace0 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc5d0 \ub300\ud55c \ub2e8\uacc4\ubcc4 \uc9c0\uce68\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uccab \ubc88\uc9f8 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \uae30\ubcf8 \uc5b8\uc5b4\ub97c \uc124\uc815\ud558\uace0 \uc624\ub514\uc624 \uc124\uc815\uc744 \uc870\uc815\ud558\ub294 \ub370 \uc548\ub0b4\ub429\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc6d0\ud65c\ud55c \uc628\ubcf4\ub529 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud558\uace0 \ud50c\ub808\uc774\uc5b4\uac00 \ucc98\uc74c\ubd80\ud130 \ud3b8\uc548\ud568\uc744 \ub290\ub07c\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04\uc758 \uac8c\uc784 \ud50c\ub808\uc774 \ud6c4 Cleverdle\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc758 \uac8c\uc784 \ud50c\ub808\uc774 \ud6c4 Cleverdle\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc740 \ud328\ud134 \uc778\uc2dd, \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac \ubc0f \uac8c\uc784 \ud50c\ub808\uc774 \uba54\ucee4\ub2c8\uc998 \ucd5c\uc801\ud654\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. STEP1: \uac8c\uc784\uc5d0\uc11c \ubc18\ubcf5\ub418\ub294 \ud328\ud134\uc744 \uc2dd\ubcc4\ud558\uc5ec \uacb0\uacfc\ub97c \uc608\uce21\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2: \uac00\uc7a5 \ud070 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc5b4 \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud569\ub2c8\ub2e4. STEP3: \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \uac8c\uc784 \ud50c\ub808\uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uac1c\uc120\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc801\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\uace0 \ud76c\uadc0\ud55c \uc5c5\uc801\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4."}, {"question": "Cleverdle\uc5d0\uc11c \uc22b\uc790 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Cleverdle\uc5d0\uc11c \uc22b\uc790 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \ud6a8\uc728\uc131\uacfc \uc131\uacf5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \uc790\uc6d0 \ud560\ub2f9, \ud53c\ud574\ub7c9 \ubc0f \uc9c4\ud589 \uc18d\ub3c4\ub97c \uacb0\uc815\ud558\ub294 \ubcf5\uc7a1\ud55c \uacc4\uc0b0\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud560 \ucd5c\uc801\uc758 \uc2dc\uae30\ub97c \uacc4\uc0b0\ud558\ub294 \ubc29\ubc95\uc744 \uc54c\uba74 \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ub9c8\uc2a4\ud130\ud568\uc73c\ub85c\uc368 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \ub098\uc740 \uacb0\uacfc\uc640 \ubcf4\ub2e4 \ubcf4\ub78c\uc788\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc774\ub044\ub294 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Cleverdle \ub370\uc774\ud130\ub97c \uc5b4\ub5bb\uac8c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ud65c\uc6a9\ud558\uc5ec \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Cleverdle \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669, \uc5c5\uc801 \ubc0f \uc124\uc815\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uace0 \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\ub824\uba74 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uace0 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc774 \ud65c\uc131\ud654\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "Cleverdle\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70 \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 Cleverdle\uc5d0\uc11c \ub35c \uba85\ud655\ud55c \uc601\uc5ed\uc744 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf5\uc7a1\ud55c \ud37c\uc990\uc744 \ud480\uac70\ub098 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc744 \ub2ec\uc131\ud568\uc73c\ub85c\uc368 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ub808\ubca8\uacfc \ud76c\uadc0 \uc544\uc774\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud558\ub098\uc758 \uc608\ub294 \uc678\ub534 \uac10\uc625\uc5d0 \uc228\uaca8\uc9c4 '\uace8\ub4e0 \ud0a4'\ub85c \ud2b9\ubcc4\ud55c \ubcf4\ubb3c \uc0c1\uc790\ub97c \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \uc138\uacc4\ub97c \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \uc2dc\ub3c4\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ucd5c\uc801\uc758 \uacbd\ud5d8\uc744 \uc704\ud574 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 Cleverdle\uc5d0\uc11c \uba3c\uc800 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \ucd5c\uc801\uc758 \uacbd\ud5d8\uc744 \uc704\ud574 Cleverdle\uc5d0\uc11c \uba3c\uc800 \ucee8\ud2b8\ub864 \ubbfc\uac10\ub3c4, \uc624\ub514\uc624 \ub808\ubca8 \ubc0f \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucee8\ud2b8\ub864 \ubbfc\uac10\ub3c4\ub97c \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c \uc124\uc815\ud558\uba74 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\uace0, \uc624\ub514\uc624 \ub808\ubca8\uc744 \uc870\uc815\ud558\uba74 \ubab0\uc785\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \ub610\ud55c, \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \uc131\ub2a5\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uae30\uae30\uc5d0\uc11c \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc740 \uac1c\ubcc4 \uc120\ud638\ub3c4\uc5d0 \ub9de\ucdb0 \uac1c\uc778\ud654\ub418\uace0 \uc990\uac70\uc6b4 \uac8c\uc784 \ud658\uacbd\uc744 \ub9cc\ub4dc\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Cleverdle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Cleverdle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \uc790\uc6d0 \uad00\ub9ac\uc758 \uc870\ud569\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \uc791\uc5c5\uc744 \ub354 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \uc644\ub8cc\ud560\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8\uc744 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 \ucd5c\ub2e8 \uc2dc\uac04 \ub0b4\uc5d0 \uc644\ub8cc\ud558\uba74 \ucd5c\uace0 \uc810\uc218\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ubcf4\uac74 \ud3ec\uc158\uc744 \uc808\uc57d\ud558\ub294 \uac83\uacfc \uac19\uc740 \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\ub3c4 \ucd5c\uc885 \uc810\uc218\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ud6a8\uacfc\uc801\uc73c\ub85c \uc804\ub7b5\uc744 \uc138\uc6b0\uace0 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubaa9\ud45c\ub85c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Cleverdle\uc5d0\uc11c \uac8c\uc784 \ud50c\ub808\uc774 \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Cleverdle\uc5d0\uc11c \uac8c\uc784 \ud50c\ub808\uc774 \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc5d0\ub294 \ucee8\ud2b8\ub864 \ub9c8\uc2a4\ud130\ub9c1, \uc790\uc6d0 \uc0ac\uc6a9 \ucd5c\uc801\ud654 \ubc0f \uac8c\uc784 \uba54\ucee4\ub2c8\uc998 \ud65c\uc6a9\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1: \ube60\ub974\uace0 \uc815\ud655\ud55c \ubc18\uc751\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP2: \ubbf8\ub9ac \uacc4\ud68d\ud558\uace0 \ud544\uc218 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc5b4 \uc790\uc6d0 \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. STEP3: \ucf64\ubcf4 \ubc0f \ud30c\uc6cc\uc5c5\uacfc \uac19\uc740 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud65c\uc6a9\ud558\uc5ec \ucd9c\ub825\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucf64\ubcf4 \uccb4\uc778\uc744 \uc0ac\uc6a9\ud558\uba74 \ub808\ubca8 \uc644\ub8cc \uc2dc\uac04\uc744 \ud06c\uac8c \uc904\uc5ec \ud6a8\uc728\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Cleverdle\uc758 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc744 \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5a4 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc815, \uc885\uc885 \uc54c\ub824\uc9c0\uc9c0 \uc54a\uc740 \uc791\uc5c5\uc744 \uc644\ub8cc\ud558\uac70\ub098 \uace0\uc720\ud55c \uae30\uc900\uc744 \ucda9\uc871\ud558\uc5ec Cleverdle\uc758 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uac00\uc9c0 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc740 \uc544\ubb34\ub7f0 \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\uace0 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc5c5\uc801\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub3c5\uc810 \uc2a4\ud0a8, \uac8c\uc784 \ub0b4 \ud1b5\ud654 \ub610\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud2b9\ubcc4\ud55c \uc544\uc774\ud15c\uacfc \uac19\uc740 \ud76c\uadc0\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc5c5\uc801\uc744 \ucc3e\uc73c\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ubaa8\ub4e0 \uac8c\uc784 \uce21\uba74\uc744 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc2dc\ub3c4\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Cleverdle\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Cleverdle\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c \uac8c\uc784\uc740 \uc801\uc5b4\ub3c4 \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c, 8GB RAM \ubc0f 2GB VRAM\uc774 \uc788\ub294 \uc804\uc6a9 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc758 \uacbd\uc6b0 \uc801\uc5b4\ub3c4 4GB RAM \ubc0f Android 8.0 \ub610\ub294 iOS 12\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone 12\uc640 \uac19\uc740 \uace0\uae09 \uc2a4\ub9c8\ud2b8\ud3f0\uc744 \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc990\uae38 \uc218 \uc788\uc9c0\ub9cc, \uad6c\ud615 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucdb0\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
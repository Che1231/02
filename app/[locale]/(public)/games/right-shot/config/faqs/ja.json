[{"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u3068\u7167\u6e96\u7528\u306e\u30de\u30a6\u30b9\u3092\u6163\u308c\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3067\u9759\u6b62\u6a19\u7684\u306b\u6483\u3061\u8fbc\u3080\u7df4\u7fd2\u3092\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u3092\u8a66\u3057\u3066\u3001\u305d\u308c\u305e\u308c\u306e\u53d6\u308a\u6271\u3044\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u30af\u30a4\u30c3\u30af\u30d5\u30a1\u30a4\u30a2\u30d4\u30b9\u30c8\u30eb\u300f\u306f\u300e\u30d8\u30d3\u30fc\u30e9\u30a4\u30d5\u30eb\u300f\u3068\u6bd4\u3079\u3066\u5c04\u6483\u901f\u5ea6\u306f\u901f\u3044\u3067\u3059\u304c\u3001\u30c0\u30e1\u30fc\u30b8\u306f\u4f4e\u3044\u3067\u3059\u3002\u6b66\u5668\u306e\u7d71\u8a08\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u8a2d\u5b9a\u8868\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002[\u30d4\u30b9\u30c8\u30eb\uff1a\u5c04\u6483\u901f\u5ea6=\u9ad8\u901f\u3001\u30c0\u30e1\u30fc\u30b8=\u4f4e] [\u30e9\u30a4\u30d5\u30eb\uff1a\u5c04\u6483\u901f\u5ea6=\u4e2d\u901f\u3001\u30c0\u30e1\u30fc\u30b8=\u9ad8]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u6210\u529f\u3059\u308b\u305f\u3081\u306b\u3001\u30de\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u7406\u89e3\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u30de\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u6226\u7565\u7684\u306a\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u53d6\u308b\u3053\u3068\u3001\u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3001\u91cd\u8981\u306a\u30a8\u30ea\u30a2\u3092\u5236\u5727\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u90fd\u5e02\u306e\u6df7\u4e71\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u9ad8\u5730\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u624b\u9806\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ab\u30b9\u30bf\u30e0\u30b2\u30fc\u30e0\u3067\u30de\u30c3\u30d7\u3092\u3058\u3063\u304f\u308a\u3068\u63a2\u7d22\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9698\u8def\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u9663\u5730\u3001\u56de\u5fa9\u85ac\u306e\u4f4d\u7f6e\u3092\u7279\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u306e\u77e5\u8b58\u3092\u4f7f\u3063\u3066\u3001\u81ea\u5206\u306e\u30eb\u30fc\u30c8\u3068\u5f85\u3061\u4f0f\u305b\u5834\u6240\u3092\u8a08\u753b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30de\u30c3\u30d7\u3092\u30c1\u30a7\u30b9\u76e4\u3068\u8003\u3048\u3001\u99d2\uff08\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\uff09\u3092\u9069\u5207\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u30c1\u30a7\u30c3\u30af\u30e1\u30a4\u30c8\uff08\u52dd\u5229\uff09\u306b\u7e4b\u3052\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u5f3e\u85ac\u3092\u7ba1\u7406\u3059\u308b\u306e\u306b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u5f3e\u85ac\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6b66\u5668\u9078\u629e\u3001\u6b63\u78ba\u6027\u3001\u72b6\u6cc1\u8a8d\u8b58\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u7570\u306a\u308b\u5f3e\u85ac\u30bf\u30a4\u30d7\u306e\u30bb\u30ab\u30f3\u30c9\u30a6\u30a7\u30dd\u30f3\u3092\u643a\u5e2f\u3057\u3001\u30d7\u30e9\u30a4\u30de\u30ea\u304c\u306a\u304f\u306a\u3063\u305f\u3089\u5207\u308a\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3092\u5f53\u3066\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3057\u3001\u5f3e\u85ac\u3092\u7bc0\u7d04\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30de\u30c3\u30d7\u4e0a\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u5f3e\u85ac\u30d1\u30c3\u30af\u3092\u62fe\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u7802\u6f20\u306e\u54e8\u6212\u57fa\u5730\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u5f3e\u85ac\u30d1\u30c3\u30af\u306f\u4e2d\u592e\u306e\u5854\u306e\u8fd1\u304f\u306b\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u5f3e\u85ac\u306e\u7a2e\u985e\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u6b21\u306e\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30d7\u30e9\u30a4\u30de\u30ea\u30a6\u30a7\u30dd\u30f3\uff1a\u5f3e\u85ac=30\u3001\u30c0\u30e1\u30fc\u30b8=\u9ad8] [\u30bb\u30ab\u30f3\u30c0\u30ea\u30a6\u30a7\u30dd\u30f3\uff1a\u5f3e\u85ac=60\u3001\u30c0\u30e1\u30fc\u30b8=\u4e2d]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306b\u6700\u9069\u306a\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5404\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u5177\u4f53\u7684\u306a\u8981\u6c42\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30c1\u30fc\u30e0\u30c7\u30b9\u30de\u30c3\u30c1\u300f\u3067\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u304c\u9ad8\u304f\u3001\u30ea\u30ed\u30fc\u30c9\u6642\u9593\u304c\u901f\u3044\u6b66\u5668\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u596a\u65d7\u6226\u300f\u3067\u306f\u3001\u6a5f\u52d5\u6027\u3068\u4e2d\u8ddd\u96e2\u6b66\u5668\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u9ad8\u30c0\u30e1\u30fc\u30b8\u3068\u5f3e\u85ac\u6570\u306e\u9593\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u596a\u65d7\u6226\u300f\u3067\u306f\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fcSMG\u300f\u306f\u7d20\u65e9\u304f\u65d7\u3092\u596a\u3046\u306e\u306b\u6700\u9069\u3067\u3059\u3002\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30c1\u30fc\u30e0\u30c7\u30b9\u30de\u30c3\u30c1\uff1a\u6b66\u5668=\u30d8\u30d3\u30fc\u30e9\u30a4\u30d5\u30eb\u3001\u30ea\u30ed\u30fc\u30c9=\u9ad8\u901f] [\u596a\u65d7\u6226\uff1a\u6b66\u5668=\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fcSMG\u3001\u6a5f\u52d5\u6027=\u9ad8]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u3001\u3069\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u6700\u3082\u7df4\u7fd2\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u7167\u6e96\u3001\u79fb\u52d5\u3001\u72b6\u6cc1\u8a8d\u8b58\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5c04\u6483\u5834\u3067\u7167\u6e96\u7df4\u7fd2\u3092\u884c\u3044\u3001\u6b63\u78ba\u6027\u3092\u9ad8\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u6a2a\u79fb\u52d5\u3084\u30b8\u30e3\u30f3\u30d7\u306a\u3069\u306e\u79fb\u52d5\u6280\u8853\u3092\u78e8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u30de\u30c3\u30d7\u3084\u30e2\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3067\u3001\u72b6\u6cc1\u8a8d\u8b58\u3092\u990a\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3067\u300e\u30af\u30a4\u30c3\u30af\u30b9\u30b3\u30fc\u30d7\u300f\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u306f\u3001\u300e\u30c1\u30fc\u30e0\u30c7\u30b9\u30de\u30c3\u30c1\u300f\u3067\u6226\u6cc1\u3092\u6709\u5229\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5bb6\u306e\u57fa\u790e\u3068\u8003\u3048\u308b\u3068\u3001\u5805\u56fa\u306a\u571f\u53f0\u304c\u306a\u3044\u3068\u3001\u69cb\u9020\uff08\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\uff09\u306f\u5d29\u58ca\u3057\u3066\u3057\u307e\u3046\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30ad\u30eb\u30d9\u30fc\u30b9\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u3068\u30c1\u30fc\u30e0\u69cb\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3053\u308c\u307e\u3067\u306e\u8a66\u5408\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u30e9\u30f3\u30af\u4ed8\u3051\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5e73\u5747\u7684\u306a\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u304c\u985e\u4f3c\u3059\u308b\u30c1\u30fc\u30e0\u3092\u4f5c\u6210\u3057\u3088\u3046\u3068\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30ec\u30a4\u6642\u9593\u3084\u6700\u8fd1\u306e\u6210\u7e3e\u306a\u3069\u3082\u8003\u616e\u3057\u3066\u3001\u5bfe\u6226\u76f8\u624b\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u30ad\u30eb\u30c7\u30b9\u6bd4\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u540c\u69d8\u306b\u719f\u7df4\u3057\u305f\u76f8\u624b\u3068\u5bfe\u6226\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u30de\u30c3\u30c1\u30f3\u30b0\u30d7\u30ed\u30bb\u30b9\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306e\u4ee5\u4e0b\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\u3002[\u30d7\u30ec\u30a4\u30e4\u30fc\u7d71\u8a08\u2192\u30b9\u30ad\u30eb\u30e9\u30f3\u30ad\u30f3\u30b0\u2192\u30c1\u30fc\u30e0\u69cb\u6210\u2192\u30de\u30c3\u30c1\u4f5c\u6210]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u6b66\u5668\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u6b66\u5668\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b66\u5668\u306e\u7a2e\u985e\u3068\u5fc5\u8981\u306a\u8cc7\u6e90\u306b\u57fa\u3065\u3044\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30e9\u30a4\u30de\u30ea\u6b66\u5668\u306f\u3001\u5927\u5e45\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u5fc5\u8981\u306a\u5e0c\u5c11\u306a\u7d20\u6750\u3092\u983b\u7e41\u306b\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bb\u30ab\u30f3\u30c0\u30ea\u6b66\u5668\u306f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u983b\u7e41\u306b\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u5897\u5f37\u306f\u50c5\u304b\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u6b8a\u6b66\u5668\u306f\u72ec\u81ea\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30d1\u30b9\u3092\u6301\u3063\u3066\u3044\u3066\u3001\u305d\u306e\u6a5f\u80fd\u3092\u5927\u5e45\u306b\u5909\u66f4\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d7\u30e9\u30ba\u30de\u30ad\u30e3\u30ce\u30f3\u300f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u305d\u306e\u7bc4\u56f2\u653b\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u5927\u3055\u305b\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30d1\u30b9\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u6b21\u306e\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30d7\u30e9\u30a4\u30de\u30ea\u6b66\u5668\uff1a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b3\u30b9\u30c8=\u9ad8\u3001\u52b9\u679c=\u5927] [\u30bb\u30ab\u30f3\u30c0\u30ea\u6b66\u5668\uff1a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b3\u30b9\u30c8=\u4f4e\u3001\u52b9\u679c=\u5c0f]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u3078\u306e\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u65b9\u6cd5\u306f\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u3067PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u3078\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1aPC\u7248\u306e\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a2\u30ab\u30a6\u30f3\u30c8\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3001\u300e\u30b3\u30f3\u30bd\u30fc\u30eb\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u753b\u9762\u306e\u6307\u793a\u306b\u5f93\u3063\u3066\u79fb\u884c\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u300e\u30a8\u30ea\u30fc\u30c8\u30b9\u30ca\u30a4\u30d1\u30fc\u300f\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u5834\u5408\u306f\u3001\u79fb\u884c\u5f8c\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u3082\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u30d7\u30ed\u30bb\u30b9\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306e\u4ee5\u4e0b\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\uff1a[PC\u30a2\u30ab\u30a6\u30f3\u30c8\u2192\u30b3\u30f3\u30bd\u30fc\u30eb\u30ea\u30f3\u30af\u2192\u79fb\u884c\u5b8c\u4e86]"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u300e\u53e4\u4ee3\u907a\u8de1\u300f\u30de\u30c3\u30d7\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u300e\u53e4\u4ee3\u907a\u8de1\u300f\u30de\u30c3\u30d7\u306b\u306f\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7834\u58ca\u53ef\u80fd\u306a\u58c1\u306e\u5f8c\u308d\u306b\u3042\u308b\u96a0\u3057\u901a\u8def\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u53e4\u4ee3\u306e\u50cf\u3068\u5bfe\u8a71\u3057\u3066\u3001\u79d8\u5bc6\u306e\u5b9d\u7bb1\u3092\u767a\u898b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u74b0\u5883\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u3066\u3001\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u3092\u958b\u653e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u4e2d\u592e\u306e\u30aa\u30d9\u30ea\u30b9\u30af\u306b\u3042\u308b\u8a18\u53f7\u3092\u63c3\u3048\u308b\u3053\u3068\u3067\u3001\u30e6\u30cb\u30fc\u30af\u306a\u6b66\u5668\u30b9\u30ad\u30f3\u304c\u5165\u624b\u3067\u304d\u308b\u79d8\u5bc6\u306e\u90e8\u5c4b\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u57cb\u8535\u3055\u308c\u305f\u5b9d\u7269\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u63a2\u7d22\u3059\u308c\u3070\u3059\u308b\u307b\u3069\u3001\u3088\u308a\u8c4a\u304b\u306a\u5831\u916c\u304c\u5f97\u3089\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u52d5\u7684\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30e9\u30a4\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u52d5\u7684\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u6226\u7565\u306b\u8907\u96d1\u3055\u3092\u52a0\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u96e8\u306e\u5834\u5408\u3001\u8996\u754c\u304c\u5236\u9650\u3055\u308c\u3001\u9060\u8ddd\u96e2\u6b66\u5668\u306e\u52b9\u679c\u304c\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7802\u5d50\u306e\u5834\u5408\u3001\u79fb\u52d5\u901f\u5ea6\u304c\u4f4e\u4e0b\u3057\u3001\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u304c\u6709\u5229\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6674\u5929\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u6226\u7565\u304c\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u767a\u63ee\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5c71\u5cb3\u5ce0\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u7a81\u767a\u7684\u306a\u5439\u96ea\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8fd1\u63a5\u6226\u95d8\u306b\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u3092\u4f59\u5100\u306a\u304f\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u6c17\u8c61\u52b9\u679c\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u96e8\uff1a\u8996\u754c=\u4f4e\u3001\u6226\u7565=\u8fd1\u63a5\u6226\u95d8] [\u7802\u5d50\uff1a\u79fb\u52d5=\u9045\u3001\u6226\u7565=\u9632\u5fa1] [\u6674\u5929\uff1a\u8996\u754c=\u9ad8\u3001\u6226\u7565=\u6700\u9069]"}]
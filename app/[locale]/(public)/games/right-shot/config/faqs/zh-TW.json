[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u719f\u6089\u79fb\u52d5\u9375\uff08WASD\uff09\u548c\u6ed1\u9f20\u7784\u6e96\u3002\u6b65\u9a5f2\uff1a\u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u5c04\u64ca\u975c\u6b62\u76ee\u6a19\u3002\u6b65\u9a5f3\uff1a\u5617\u8a66\u4e0d\u540c\u6b66\u5668\uff0c\u4e86\u89e3\u5b83\u5011\u7368\u7279\u7684\u64cd\u63a7\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u300c\u5feb\u901f\u624b\u69cd\u300d\u7684\u5c04\u901f\u8f03\u5feb\uff0c\u4f46\u50b7\u5bb3\u8f03\u4f4e\uff0c\u800c\u300c\u91cd\u578b\u6b65\u69cd\u300d\u7684\u5c04\u901f\u4e2d\u7b49\uff0c\u4f46\u50b7\u5bb3\u8f03\u9ad8\u3002\u8acb\u53c3\u8003\u4e0b\u8868\u6bd4\u8f03\u6b66\u5668\u6578\u64da\uff1a[\u624b\u69cd\uff1a\u5c04\u901f=\u9ad8\uff0c\u50b7\u5bb3=\u4f4e] [\u6b65\u69cd\uff1a\u5c04\u901f=\u4e2d\uff0c\u50b7\u5bb3=\u9ad8]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u5730\u5716\u4f48\u5c40\u5c0d\u65bc\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u6210\u529f\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\uff0c\u4e86\u89e3\u5730\u5716\u4f48\u5c40\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u73a9\u5bb6\u6230\u7565\u6027\u5730\u4f48\u7f6e\u81ea\u5df1\uff0c\u9810\u6e2c\u6575\u4eba\u7684\u52d5\u4f5c\u4e26\u63a7\u5236\u95dc\u9375\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728\u300c\u57ce\u5e02\u6df7\u4e82\u300d\u5730\u5716\u4e2d\uff0c\u77e5\u9053\u9ad8\u5730\u4f4d\u7f6e\u53ef\u4ee5\u70ba\u60a8\u5e36\u4f86\u986f\u8457\u512a\u52e2\u3002\u4ee5\u4e0b\u5206\u6b65\u9a5f\u8aaa\u660e\uff1a\u6b65\u9a5f1\uff1a\u82b1\u6642\u9593\u5728\u81ea\u5b9a\u7fa9\u904a\u6232\u4e2d\u63a2\u7d22\u5730\u5716\u3002\u6b65\u9a5f2\uff1a\u8b58\u5225\u9698\u53e3\u3001\u72d9\u64ca\u9ede\u548c\u88dc\u7d66\u5305\u4f4d\u7f6e\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u9019\u4e9b\u77e5\u8b58\u4f86\u898f\u5283\u8def\u7dda\u548c\u4f0f\u64ca\u9ede\u3002\u5c07\u5730\u5716\u60f3\u50cf\u6210\u68cb\u76e4\uff1b\u6b63\u78ba\u64fa\u653e\u68cb\u5b50\uff08\u60a8\u7684\u89d2\u8272\uff09\u53ef\u4ee5\u5c0e\u81f4\u5c07\u6b7b\uff08\u52dd\u5229\uff09\u3002"}, {"question": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\uff0c\u7ba1\u7406\u5f48\u85e5\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u5f48\u85e5\u9700\u8981\u7d50\u5408\u6b66\u5668\u9078\u64c7\u3001\u6e96\u78ba\u6027\u548c\u60c5\u5883\u610f\u8b58\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u651c\u5e36\u4f7f\u7528\u4e0d\u540c\u5f48\u85e5\u985e\u578b\u7684\u526f\u6b66\u5668\uff0c\u5728\u4e3b\u6b66\u5668\u5f48\u85e5\u7528\u76e1\u6642\u5207\u63db\u3002\u6b65\u9a5f2\uff1a\u7784\u6e96\u982d\u90e8\u64ca\u6bba\u4f86\u6700\u5927\u5316\u50b7\u5bb3\u4e26\u7bc0\u7d04\u5f48\u85e5\u3002\u6b65\u9a5f3\uff1a\u64bf\u8d77\u5730\u5716\u4e0a\u6563\u4f48\u7684\u5f48\u85e5\u5305\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u64da\u9ede\u300d\u5730\u5716\u4e2d\uff0c\u5f48\u85e5\u5305\u901a\u5e38\u4f4d\u65bc\u4e2d\u5fc3\u5854\u9644\u8fd1\u3002\u8acb\u53c3\u95b1\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f03\u5f48\u85e5\u985e\u578b\uff1a[\u4e3b\u6b66\u5668\uff1a\u5f48\u85e5=30\uff0c\u50b7\u5bb3=\u9ad8] [\u526f\u6b66\u5668\uff1a\u5f48\u85e5=60\uff0c\u50b7\u5bb3=\u4e2d]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e2d\u512a\u5316\u88dd\u5099\uff1f", "answer": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\u512a\u5316\u88dd\u5099\u9700\u8981\u4e86\u89e3\u6bcf\u500b\u904a\u6232\u6a21\u5f0f\u7684\u5177\u9ad4\u9700\u6c42\u3002\u6b65\u9a5f1\uff1a\u5c0d\u65bc\u300c\u5718\u968a\u6b7b\u4ea1\u8cfd\u300d\uff0c\u512a\u5148\u9078\u64c7\u50b7\u5bb3\u9ad8\u4e14 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430\u5feb\u7684\u6b66\u5668\u3002\u6b65\u9a5f2\uff1a\u5728\u300c\u596a\u65d7\u300d\u904a\u6232\u6a21\u5f0f\u4e2d\uff0c\u91cd\u9ede\u653e\u5728\u6a5f\u52d5\u6027\u548c\u4e2d\u7a0b\u6b66\u5668\u3002\u6b65\u9a5f3\uff1a\u5c0d\u65bc\u300c\u751f\u5b58\u6a21\u5f0f\u300d\uff0c\u5728\u9ad8\u50b7\u5bb3\u548c\u5f48\u85e5\u5bb9\u91cf\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u5728\u300c\u596a\u65d7\u300d\u6a21\u5f0f\u4e2d\uff0c\u300c\u75be\u901f\u885d\u92d2 SMG\u300d\u975e\u5e38\u9069\u5408\u5feb\u901f\u596a\u65d7\u3002\u8acb\u53c3\u8003\u4e0b\u8868\u6bd4\u8f03\u88dd\u5099\uff1a[\u5718\u968a\u6b7b\u4ea1\u8cfd\uff1a\u6b66\u5668=\u91cd\u578b\u6b65\u69cd\uff0c \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430=\u5feb] [\u596a\u65d7\uff1a\u6b66\u5668=\u75be\u901f\u885d\u92d2 SMG\uff0c\u6a5f\u52d5\u6027=\u9ad8]"}, {"question": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u9700\u8981\u6700\u591a\u7684\u7df4\u7fd2\u624d\u80fd\u7cbe\u901a\uff1f", "answer": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u4e2d\u7cbe\u901a\u904a\u6232\u6a5f\u5236\u9700\u8981\u5c08\u6ce8\u65bc\u7784\u6e96\u3001\u79fb\u52d5\u548c\u60c5\u5883\u610f\u8b58\u3002\u6b65\u9a5f1\uff1a\u5728\u5c04\u64ca\u7bc4\u570d\u7df4\u7fd2\u7784\u6e96\u4ee5\u63d0\u9ad8\u6e96\u78ba\u6027\u3002\u6b65\u9a5f2\uff1a\u7df4\u7fd2\u4f8b\u5982\u5074\u8eab\u548c\u8df3\u8e8d\u7b49\u79fb\u52d5\u6280\u5de7\u4ee5\u8eb2\u907f\u6575\u65b9\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u901a\u904e\u73a9\u4e0d\u540c\u5730\u5716\u548c\u6a21\u5f0f\u4f86\u57f9\u990a\u60c5\u5883\u610f\u8b58\u3002\u4f8b\u5982\uff0c\u638c\u63e1\u4f7f\u7528\u72d9\u64ca\u6b65\u69cd\u7684\u300c\u5feb\u901f\u7784\u6e96\u300d\u6280\u5de7\u53ef\u4ee5\u5728\u300c\u5718\u968a\u6b7b\u4ea1\u8cfd\u300d\u4e2d\u626d\u8f49\u5c40\u52e2\u3002\u8acb\u5c07\u9019\u4e9b\u6a5f\u5236\u8996\u70ba\u623f\u5c4b\u7684\u57fa\u790e\uff1b\u6c92\u6709\u5805\u5be6\u7684\u57fa\u790e\uff0c\u7d50\u69cb\uff08\u60a8\u7684\u904a\u6232\u73a9\u6cd5\uff09\u5c31\u6703\u5d29\u584c\u3002"}, {"question": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u914d\u5c0d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u914d\u5c0d\u7cfb\u7d71\u901a\u904e\u7d50\u5408\u57fa\u65bc\u6280\u80fd\u7684\u6392\u540d\u548c\u5718\u968a\u7d44\u6210\u6f14\u7b97\u6cd5\u4f86\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f1\uff1a\u73a9\u5bb6\u6839\u64da\u5148\u524d\u6bd4\u8cfd\u7684\u8868\u73fe\u9032\u884c\u6392\u540d\u3002\u6b65\u9a5f2\uff1a\u7cfb\u7d71\u5617\u8a66\u7d44\u6210\u5e73\u5747\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u5718\u968a\u3002\u6b65\u9a5f3\uff1a\u5b83\u9084\u6703\u8003\u616e\u904a\u6232\u6642\u9593\u548c\u6700\u8fd1\u7684\u8868\u73fe\u4f86\u8abf\u6574\u5339\u914d\u3002\u4f8b\u5982\uff0c\u64c1\u6709\u9ad8\u6bba\u50b7\u6bd4\u7684\u73a9\u5bb6\u5c07\u8207\u6280\u80fd\u76f8\u4f3c\u7684\u5c0d\u624b\u914d\u5c0d\u3002\u8acb\u53c3\u8003\u4ee5\u4e0b\u6d41\u7a0b\u5716\u4e86\u89e3\u914d\u5c0d\u6d41\u7a0b\uff1a[\u73a9\u5bb6\u7d71\u8a08\u2192\u6280\u80fd\u6392\u540d\u2192\u5718\u968a\u7d44\u6210\u2192\u6bd4\u8cfd\u5275\u5efa]"}, {"question": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u6839\u64da\u6b66\u5668\u985e\u578b\u548c\u6240\u9700\u7684\u8cc7\u6e90\u800c\u7570\u3002\u6b65\u9a5f1\uff1a\u4e3b\u6b66\u5668\u901a\u5e38\u9700\u8981\u7a00\u6709\u6750\u6599\u624d\u80fd\u9032\u884c\u986f\u8457\u5347\u7d1a\u3002\u6b65\u9a5f2\uff1a\u526f\u6b66\u5668\u53ef\u4ee5\u66f4\u983b\u7e41\u5730\u5347\u7d1a\uff0c\u4f46\u63d0\u5347\u5e45\u5ea6\u8f03\u5c0f\u3002\u6b65\u9a5f3\uff1a\u7279\u6b8a\u6b66\u5668\u64c1\u6709\u7368\u7279\u7684\u5347\u7d1a\u9014\u5f91\uff0c\u53ef\u4ee5\u986f\u8457\u6539\u8b8a\u5176\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u300c\u7b49\u96e2\u5b50\u70ae\u300d\u6703\u589e\u52a0\u5176\u7bc4\u570d\u50b7\u5bb3\u3002\u8acb\u53c3\u8003\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f03\u5347\u7d1a\u9014\u5f91\uff1a[\u4e3b\u6b66\u5668\uff1a\u5347\u7d1a\u8cbb\u7528=\u9ad8\uff0c\u6548\u679c=\u986f\u8457] [\u526f\u6b66\u5668\uff1a\u5347\u7d1a\u8cbb\u7528=\u4f4e\uff0c\u6548\u679c=\u6b21\u8981]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07\u5728PC\u4e0a\u7684\u9032\u5ea6\u9077\u79fb\u5230\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u904a\u6232\u4e3b\u6a5f\u7248\u672c\uff1f", "answer": "\u5c07 PC \u9032\u5ea6\u9077\u79fb\u5230\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u904a\u6232\u4e3b\u6a5f\u7248\u672c\u9700\u8981\u9023\u7d50\u60a8\u7684\u904a\u6232\u5e33\u6236\u5230\u901a\u7528\u7684\u904a\u6232\u5e33\u6236\u3002\u6b65\u9a5f1\uff1a\u767b\u5165\u60a8\u5728 PC \u7248\u672c\u4e0a\u7684\u904a\u6232\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u524d\u5f80\u5e33\u6236\u8a2d\u5b9a\u4e26\u9078\u64c7\u300c\u9023\u7d50\u904a\u6232\u4e3b\u6a5f\u5e33\u6236\u300d\u3002\u6b65\u9a5f3\uff1a\u6309\u7167\u87a2\u5e55\u4e0a\u7684\u6307\u793a\u5b8c\u6210\u9077\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728 PC \u4e0a\u89e3\u9396\u4e86\u300c\u7cbe\u82f1\u72d9\u64ca\u624b\u300d\u76ae\u819a\uff0c\u5247\u9077\u79fb\u5f8c\u8a72\u76ae\u819a\u5c07\u5728\u904a\u6232\u4e3b\u6a5f\u4e0a\u53ef\u7528\u3002\u8acb\u53c3\u8003\u4ee5\u4e0b\u6d41\u7a0b\u5716\u4e86\u89e3\u6d41\u7a0b\uff1a[PC \u5e33\u6236 \u2192 \u9023\u7d50\u904a\u6232\u4e3b\u6a5f \u2192 \u9077\u79fb\u5b8c\u6210]"}, {"question": "\u5728\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u300c\u9060\u53e4\u907a\u8de1\u300d\u5730\u5716\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u300c\u9060\u53e4\u907a\u8de1\u300d\u5730\u5716\u5145\u6eff\u4e86\u96b1\u85cf\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u6b65\u9a5f1\uff1a\u5c0b\u627e\u53ef\u7834\u58de\u7246\u58c1\u5f8c\u7684\u96b1\u85cf\u901a\u9053\u3002\u6b65\u9a5f2\uff1a\u8207\u53e4\u4ee3\u96d5\u50cf\u4e92\u52d5\u4ee5\u63ed\u793a\u79d8\u5bc6\u85cf\u5bf6\u7bb1\u3002\u6b65\u9a5f3\uff1a\u89e3\u6c7a\u74b0\u5883\u8b0e\u984c\u4ee5\u89e3\u9396\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5c07\u4e2d\u5fc3\u65b9\u5c16\u7891\u4e0a\u7684\u7b26\u865f\u8abf\u6574\u5230\u7279\u5b9a\u4f4d\u7f6e\u53ef\u4ee5\u63ed\u793a\u5305\u542b\u7368\u7279\u6b66\u5668\u76ae\u819a\u7684\u96b1\u85cf\u623f\u9593\u3002\u5c07\u9019\u4e9b\u5f69\u86cb\u8996\u70ba\u57cb\u85cf\u7684\u5bf6\u85cf\uff1b\u60a8\u63a2\u7d22\u5f97\u8d8a\u591a\uff0c\u734e\u52f5\u5c31\u8d8a\u8c50\u539a\u3002"}, {"question": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u52d5\u614b\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u7b56\u7565\uff1f", "answer": "\u300a\u53f3\u69cd\u6c7a\u52dd\u300b\u7684\u52d5\u614b\u5929\u6c23\u7cfb\u7d71\u70ba\u904a\u6232\u7b56\u7565\u589e\u6dfb\u8907\u96dc\u6027\u3002\u6b65\u9a5f1\uff1a\u5728\u96e8\u5929\uff0c\u80fd\u898b\u5ea6\u964d\u4f4e\uff0c\u4f7f\u9060\u7a0b\u6b66\u5668\u7684\u6548\u529b\u964d\u4f4e\u3002\u6b65\u9a5f2\uff1a\u5728\u6c99\u5875\u66b4\u4e2d\uff0c\u79fb\u52d5\u901f\u5ea6\u6e1b\u6162\uff0c\u6709\u5229\u65bc\u9632\u5b88\u3002\u6b65\u9a5f3\uff1a\u6674\u5929\u5141\u8a31\u6240\u6709\u7b56\u7565\u6700\u4f73\u5316\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5c71\u8def\u300d\u5730\u5716\u4e2d\uff0c\u7a81\u5982\u5176\u4f86\u7684\u66b4\u98a8\u96ea\u53ef\u80fd\u6703\u8feb\u4f7f\u73a9\u5bb6\u8f49\u5411\u8fd1\u8ddd\u96e2\u6230\u9b25\u3002\u8acb\u53c3\u8003\u4e0b\u8868\u6bd4\u8f03\u5929\u6c23\u6548\u61c9\uff1a [\u96e8\uff1a\u80fd\u898b\u5ea6 = \u4f4e\uff0c\u7b56\u7565 = \u8fd1\u6230] [\u6c99\u5875\u66b4\uff1a\u79fb\u52d5\u901f\u5ea6 = \u6162\uff0c\u7b56\u7565 = \u9632\u5b88] [\u6674\u5929\uff1a\u80fd\u898b\u5ea6=\u9ad8\uff0c\u7b56\u7565 = \u6700\u4f73]"}]
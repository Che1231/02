[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1Right Shot\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1Right Shot\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u9f20\u6807\u7784\u51c6\u3002\u6b65\u9aa42\uff1a\u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u5c04\u51fb\u9759\u6b62\u76ee\u6807\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4f7f\u7528\u4e0d\u540c\u6b66\u5668\uff0c\u4e86\u89e3\u5b83\u4eec\u72ec\u7279\u7684\u64cd\u63a7\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u201c\u5feb\u901f\u624b\u67aa\u201d\u7684\u5c04\u51fb\u901f\u5ea6\u6bd4\u201c\u91cd\u578b\u6b65\u67aa\u201d\u5feb\uff0c\u4f46\u4f24\u5bb3\u8f83\u4f4e\u3002\u4f7f\u7528\u4e0b\u9762\u7684\u914d\u7f6e\u8868\u6bd4\u8f83\u6b66\u5668\u5c5e\u6027\uff1a[\u624b\u67aa\uff1a\u5c04\u51fb\u901f\u5ea6=\u9ad8\uff0c\u4f24\u5bb3=\u4f4e] [\u6b65\u67aa\uff1a\u5c04\u51fb\u901f\u5ea6=\u4e2d\uff0c\u4f24\u5bb3=\u9ad8]"}, {"question": "\u4e3a\u4ec0\u4e48\u4e86\u89e3\u5730\u56fe\u5e03\u5c40\u5bf9\u4e8eRight Shot\u7684\u6210\u529f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728Right Shot\u4e2d\u4e86\u89e3\u5730\u56fe\u5e03\u5c40\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u8ba9\u73a9\u5bb6\u6218\u7565\u6027\u5730\u90e8\u7f72\u81ea\u5df1\uff0c\u9884\u6d4b\u654c\u4eba\u7684\u884c\u52a8\uff0c\u5e76\u63a7\u5236\u5173\u952e\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u6df7\u4e71\u201d\u5730\u56fe\u4e2d\uff0c\u77e5\u9053\u9ad8\u5730\u4f4d\u7f6e\u53ef\u4ee5\u7ed9\u4f60\u5e26\u6765\u663e\u8457\u7684\u4f18\u52bf\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u5faa\u5e8f\u6e10\u8fdb\u7684\u65b9\u6cd5\uff1a\u6b65\u9aa41\uff1a\u82b1\u65f6\u95f4\u5728\u81ea\u5b9a\u4e49\u6e38\u620f\u4e2d\u63a2\u7d22\u5730\u56fe\u3002\u6b65\u9aa42\uff1a\u8bc6\u522b\u5173\u952e\u70b9\u3001\u72d9\u51fb\u70b9\u548c\u8865\u7ed9\u5305\u4f4d\u7f6e\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u8fd9\u4e9b\u77e5\u8bc6\u89c4\u5212\u4f60\u7684\u8def\u7ebf\u548c\u4f0f\u51fb\u70b9\u3002\u628a\u5730\u56fe\u60f3\u8c61\u6210\u68cb\u76d8\uff1b\u6b63\u786e\u5730\u6446\u653e\u4f60\u7684\u68cb\u5b50\uff08\u4f60\u7684\u89d2\u8272\uff09\u53ef\u4ee5\u5bfc\u81f4\u5c06\u519b\uff08\u80dc\u5229\uff09"}, {"question": "\u5728Right Shot\u4e2d\u7ba1\u7406\u5f39\u836f\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Right Shot\u4e2d\u6709\u6548\u7ba1\u7406\u5f39\u836f\u9700\u8981\u7ed3\u5408\u6b66\u5668\u9009\u62e9\u3001\u51c6\u786e\u6027\u548c\u60c5\u5883\u610f\u8bc6\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u643a\u5e26\u4e00\u79cd\u4e0d\u540c\u5f39\u836f\u7c7b\u578b\u7684\u6b21\u8981\u6b66\u5668\uff0c\u5f53\u4f60\u7684\u4e3b\u8981\u6b66\u5668\u5f39\u836f\u7528\u5b8c\u65f6\u8fdb\u884c\u5207\u6362\u3002\u6b65\u9aa42\uff1a\u7784\u51c6\u5934\u90e8\u4ee5\u6700\u5927\u5316\u4f24\u5bb3\u5e76\u8282\u7701\u5f39\u836f\u3002\u6b65\u9aa43\uff1a\u6361\u8d77\u5730\u56fe\u4e0a\u6563\u843d\u7684\u5f39\u836f\u5305\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u524d\u54e8\u201d\u5730\u56fe\u4e2d\uff0c\u5f39\u836f\u5305\u901a\u5e38\u4f4d\u4e8e\u4e2d\u5fc3\u5854\u9644\u8fd1\u3002\u4f7f\u7528\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f83\u5f39\u836f\u7c7b\u578b\uff1a[\u4e3b\u6b66\u5668\uff1a\u5f39\u836f=30\uff0c\u4f24\u5bb3=\u9ad8] [\u526f\u6b66\u5668\uff1a\u5f39\u836f=60\uff0c\u4f24\u5bb3=\u4e2d]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Right Shot\u4e2d\u4f18\u5316\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u7684\u88c5\u5907\uff1f", "answer": "\u5728Right Shot\u4e2d\u4f18\u5316\u4f60\u7684\u88c5\u5907\u9700\u8981\u4e86\u89e3\u6bcf\u79cd\u6e38\u620f\u6a21\u5f0f\u7684\u5177\u4f53\u9700\u6c42\u3002\u6b65\u9aa41\uff1a\u5bf9\u4e8e\u201c\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u201d\uff0c\u4f18\u5148\u9009\u62e9\u5177\u6709\u9ad8\u4f24\u5bb3\u548c\u5feb\u901f\u88c5\u586b\u65f6\u95f4\u7684\u6b66\u5668\u3002\u6b65\u9aa42\uff1a\u5728\u201c\u593a\u65d7\u201d\u4e2d\uff0c\u6ce8\u91cd\u673a\u52a8\u6027\u548c\u4e2d\u7a0b\u6b66\u5668\u3002\u6b65\u9aa43\uff1a\u5bf9\u4e8e\u201c\u751f\u5b58\u6a21\u5f0f\u201d\uff0c\u5e73\u8861\u9ad8\u4f24\u5bb3\u548c\u5f39\u836f\u5bb9\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u201c\u593a\u65d7\u201d\u4e2d\uff0c\u201c\u75be\u901f\u51b2\u950b\u6b65\u67aa\u201d\u975e\u5e38\u9002\u5408\u5feb\u901f\u593a\u53d6\u65d7\u5e1c\u3002\u4f7f\u7528\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f83\u88c5\u5907\uff1a[\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\uff1a\u6b66\u5668=\u91cd\u578b\u6b65\u67aa\uff0c\u88c5\u586b\u901f\u5ea6=\u5feb] [\u593a\u65d7\uff1a\u6b66\u5668=\u75be\u901f\u51b2\u950b\u6b65\u67aa\uff0c\u673a\u52a8\u6027=\u9ad8]"}, {"question": "Right Shot\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u9700\u8981\u6295\u5165\u6700\u591a\u7ec3\u4e60\u624d\u80fd\u638c\u63e1\uff1f", "answer": "\u5728Right Shot\u4e2d\u7cbe\u901a\u6e38\u620f\u673a\u5236\u9700\u8981\u4e13\u6ce8\u4e8e\u7784\u51c6\u3001\u79fb\u52a8\u548c\u60c5\u5883\u610f\u8bc6\u3002\u6b65\u9aa41\uff1a\u5728\u5c04\u51fb\u573a\u7ec3\u4e60\u4f60\u7684\u7784\u51c6\u4ee5\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u6b65\u9aa42\uff1a\u7ec3\u4e60\u8bf8\u5982\u8d70\u4f4d\u548c\u8df3\u8dc3\u4e4b\u7c7b\u7684\u79fb\u52a8\u6280\u5de7\u4ee5\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u5728\u4e0d\u540c\u5730\u56fe\u548c\u6a21\u5f0f\u4e2d\u8fdb\u884c\u6e38\u620f\u6765\u57f9\u517b\u60c5\u5883\u610f\u8bc6\u3002\u4f8b\u5982\uff0c\u7cbe\u901a\u72d9\u51fb\u6b65\u67aa\u7684\u201c\u5feb\u901f\u7784\u51c6\u201d\u6280\u5de7\u53ef\u4ee5\u5728\u201c\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u201d\u4e2d\u626d\u8f6c\u4e7e\u5764\u3002\u5c06\u8fd9\u4e9b\u673a\u5236\u89c6\u4e3a\u623f\u5b50\u7684\u57fa\u77f3\uff1b\u5982\u679c\u6ca1\u6709\u575a\u5b9e\u7684\u57fa\u7840\uff0c\u7ed3\u6784\uff08\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\uff09\u5c06\u4f1a\u574d\u584c\u3002"}, {"question": "Right Shot\u4e2d\u7684\u5339\u914d\u7cfb\u7edf\u5982\u4f55\u786e\u4fdd\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Right Shot\u4e2d\u7684\u5339\u914d\u7cfb\u7edf\u901a\u8fc7\u7ed3\u5408\u57fa\u4e8e\u6280\u80fd\u7684\u7b49\u7ea7\u548c\u56e2\u961f\u7ec4\u6210\u7b97\u6cd5\u6765\u786e\u4fdd\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41\uff1a\u73a9\u5bb6\u6839\u636e\u4ed6\u4eec\u5728\u5148\u524d\u6bd4\u8d5b\u4e2d\u7684\u8868\u73b0\u83b7\u5f97\u7b49\u7ea7\u3002\u6b65\u9aa42\uff1a\u7cfb\u7edf\u5c1d\u8bd5\u521b\u5efa\u56e2\u961f\uff0c\u4f7f\u5e73\u5747\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u3002\u6b65\u9aa43\uff1a\u5b83\u8fd8\u4f1a\u8003\u8651\u6e38\u620f\u65f6\u95f4\u548c\u8fd1\u671f\u8868\u73b0\u7b49\u56e0\u7d20\u6765\u8c03\u6574\u5339\u914d\u3002\u4f8b\u5982\uff0c\u5177\u6709\u9ad8\u51fb\u6740\u6bd4\u7684\u73a9\u5bb6\u5c06\u4e0e\u5177\u6709\u76f8\u4f3c\u6280\u80fd\u6c34\u5e73\u7684\u5bf9\u624b\u8fdb\u884c\u5339\u914d\u3002\u4f7f\u7528\u4ee5\u4e0b\u6d41\u7a0b\u56fe\u4e86\u89e3\u5339\u914d\u6d41\u7a0b\uff1a[\u73a9\u5bb6\u7edf\u8ba1 \u2192 \u6280\u80fd\u7b49\u7ea7 \u2192 \u56e2\u961f\u7ec4\u6210 \u2192 \u5339\u914d\u521b\u5efa]"}, {"question": "Right Shot\u4e2d\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Right Shot\u4e2d\u7684\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u56e0\u6b66\u5668\u7c7b\u578b\u548c\u6240\u9700\u7684\u8d44\u6e90\u800c\u5f02\u3002\u6b65\u9aa41\uff1a\u4e3b\u6b66\u5668\u901a\u5e38\u9700\u8981\u7a00\u6709\u6750\u6599\u624d\u80fd\u8fdb\u884c\u91cd\u5927\u5347\u7ea7\u3002\u6b65\u9aa42\uff1a\u6b21\u8981\u6b66\u5668\u53ef\u4ee5\u66f4\u9891\u7e41\u5730\u5347\u7ea7\uff0c\u4f46\u63d0\u5347\u5e45\u5ea6\u8f83\u5c0f\u3002\u6b65\u9aa43\uff1a\u7279\u6b8a\u6b66\u5668\u5177\u6709\u72ec\u7279\u7684\u5347\u7ea7\u8def\u5f84\uff0c\u53ef\u4ee5\u6781\u5927\u5730\u6539\u53d8\u5176\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u201c\u7b49\u79bb\u5b50\u70ae\u201d\u4f1a\u589e\u52a0\u5176\u8303\u56f4\u4f24\u5bb3\u3002\u4f7f\u7528\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f83\u5347\u7ea7\u8def\u5f84\uff1a[\u4e3b\u6b66\u5668\uff1a\u5347\u7ea7\u6210\u672c=\u9ad8\uff0c\u6548\u679c=\u91cd\u5927] [\u526f\u6b66\u5668\uff1a\u5347\u7ea7\u6210\u672c=\u4f4e\uff0c\u6548\u679c=\u6b21\u8981]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06Right Shot PC\u7248\u672c\u7684\u6e38\u620f\u8fdb\u5ea6\u8fc1\u79fb\u5230\u6e38\u620f\u4e3b\u673a\uff1f", "answer": "\u5c06Right Shot PC\u7248\u672c\u7684\u6e38\u620f\u8fdb\u5ea6\u8fc1\u79fb\u5230\u6e38\u620f\u4e3b\u673a\u9700\u8981\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u914d\u7f6e\u6587\u4ef6\u3002\u6b65\u9aa41\uff1a\u767b\u5f55\u4f60\u7684PC\u7248\u672c\u6e38\u620f\u8d26\u6237\u3002\u6b65\u9aa42\uff1a\u5bfc\u822a\u5230\u8d26\u6237\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u94fe\u63a5\u6e38\u620f\u4e3b\u673a\u8d26\u6237\u201d\u3002\u6b65\u9aa43\uff1a\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u6307\u793a\u5b8c\u6210\u8fc1\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u4e0a\u89e3\u9501\u4e86\u201c\u7cbe\u82f1\u72d9\u51fb\u624b\u201d\u76ae\u80a4\uff0c\u5219\u8fc1\u79fb\u540e\u8be5\u76ae\u80a4\u4f1a\u5728\u4f60\u7684\u4e3b\u673a\u4e0a\u53ef\u7528\u3002\u4f7f\u7528\u4ee5\u4e0b\u6d41\u7a0b\u56fe\u4e86\u89e3\u8be5\u6d41\u7a0b\uff1a[PC\u8d26\u6237 \u2192 \u94fe\u63a5\u4e3b\u673a \u2192 \u8fc1\u79fb\u5b8c\u6210]"}, {"question": "\u5728Right Shot\u7684\u201c\u53e4\u4ee3\u9057\u8ff9\u201d\u5730\u56fe\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "Right Shot\u7684\u201c\u53e4\u4ee3\u9057\u8ff9\u201d\u5730\u56fe\u5145\u6ee1\u4e86\u5956\u52b1\u63a2\u7d22\u7684\u9690\u85cf\u5f69\u86cb\u3002\u6b65\u9aa41\uff1a\u5bfb\u627e\u53ef\u7834\u574f\u5899\u58c1\u540e\u9762\u7684\u9690\u85cf\u901a\u9053\u3002\u6b65\u9aa42\uff1a\u4e0e\u53e4\u4ee3\u96d5\u50cf\u4e92\u52a8\u4ee5\u63ed\u793a\u79d8\u5bc6\u5b9d\u85cf\u3002\u6b65\u9aa43\uff1a\u89e3\u51b3\u73af\u5883\u8c1c\u9898\u4ee5\u89e3\u9501\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5bf9\u4e2d\u5fc3\u65b9\u5c16\u7891\u4e0a\u7684\u7b26\u53f7\u8fdb\u884c\u5bf9\u9f50\u53ef\u4ee5\u63ed\u793a\u4e00\u4e2a\u5305\u542b\u72ec\u7279\u6b66\u5668\u76ae\u80a4\u7684\u9690\u85cf\u623f\u95f4\u3002\u5c06\u8fd9\u4e9b\u5f69\u86cb\u89c6\u4e3a\u57cb\u85cf\u7684\u5b9d\u85cf\uff1b\u4f60\u63a2\u7d22\u5f97\u8d8a\u591a\uff0c\u5956\u52b1\u5c31\u8d8a\u4e30\u5bcc\u3002"}, {"question": "Right Shot\u4e2d\u7684\u52a8\u6001\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u7b56\u7565\uff1f", "answer": "Right Shot\u4e2d\u7684\u52a8\u6001\u5929\u6c14\u7cfb\u7edf\u4e3a\u6e38\u620f\u7b56\u7565\u589e\u6dfb\u4e86\u4e00\u5c42\u590d\u6742\u6027\u3002\u6b65\u9aa41\uff1a\u4e0b\u96e8\u65f6\uff0c\u80fd\u89c1\u5ea6\u964d\u4f4e\uff0c\u4f7f\u8fdc\u7a0b\u6b66\u5668\u6548\u679c\u964d\u4f4e\u3002\u6b65\u9aa42\uff1a\u6c99\u66b4\u671f\u95f4\uff0c\u79fb\u52a8\u901f\u5ea6\u964d\u4f4e\uff0c\u6709\u5229\u4e8e\u9632\u5b88\u3002\u6b65\u9aa43\uff1a\u6674\u5929\u5141\u8bb8\u6240\u6709\u7b56\u7565\u53d1\u6325\u6700\u4f73\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5c71\u8def\u201d\u5730\u56fe\u4e2d\uff0c\u7a81\u7136\u7684\u66b4\u98ce\u96ea\u53ef\u80fd\u4f1a\u8feb\u4f7f\u73a9\u5bb6\u6539\u4e3a\u8fd1\u6218\u3002\u4f7f\u7528\u4ee5\u4e0b\u914d\u7f6e\u8868\u6bd4\u8f83\u5929\u6c14\u6548\u5e94\uff1a[\u96e8\uff1a\u80fd\u89c1\u5ea6=\u4f4e\uff0c\u7b56\u7565=\u8fd1\u6218] [\u6c99\u66b4\uff1a\u79fb\u52a8\u901f\u5ea6=\u6162\uff0c\u7b56\u7565=\u9632\u5fa1] [\u6674\u5929\uff1a\u80fd\u89c1\u5ea6=\u9ad8\uff0c\u7b56\u7565=\u6700\u4f73]"}]
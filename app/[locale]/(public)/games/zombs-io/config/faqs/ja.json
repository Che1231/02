[{"question": "Zombs.io\u3092\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u307e\u3059\u304b\uff1f", "answer": "Zombs.io\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u30b2\u30fc\u30e0\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u300c\u30d7\u30ec\u30a4\u300d\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u30de\u30c3\u30d7\u4e0a\u306e\u30e9\u30f3\u30c0\u30e0\u306a\u5834\u6240\u306b\u30b9\u30dd\u30fc\u30f3\u3057\u307e\u3059\u3002\u6700\u521d\u306e\u76ee\u6a19\u306f\u3001\u6728\u3084\u5ca9\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u6728\u6750\u3084\u77f3\u306a\u3069\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u8cc7\u6e90\u3092\u4f7f\u3063\u3066\u3001[\u69cb\u7bc9]\u30e1\u30cb\u30e5\u30fc\u3092\u9078\u629e\u3057\u3001\u58c1\u3084\u30c9\u30a2\u3092\u914d\u7f6e\u3057\u3066\u57fa\u5730\u3092\u5efa\u8a2d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30be\u30f3\u30d3\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306b\u5c0f\u3055\u306a\u6728\u306e\u58c1\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u8cc7\u6e90\u3092\u3088\u308a\u65e9\u304f\u96c6\u3081\u308b\u305f\u3081\u306b\u3001\u65a7\u3084\u30d4\u30c3\u30b1\u30eb\u306a\u3069\u306e\u30c4\u30fc\u30eb\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u591c\u306b\u306a\u308b\u524d\u306b\u3001\u30be\u30f3\u30d3\u304c\u3088\u308a\u653b\u6483\u7684\u306b\u306a\u308b\u524d\u306b\u3001\u5b89\u5168\u306a\u57fa\u5730\u3092\u5efa\u8a2d\u3057\u3001\u5fc5\u9808\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Zombs.io\u3067\u6700\u521d\u306e\u591c\u3092\u751f\u304d\u5ef6\u3073\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Zombs.io\u3067\u6700\u521d\u306e\u591c\u3092\u751f\u304d\u5ef6\u3073\u308b\u306b\u306f\u3001\u8a08\u753b\u7684\u306a\u884c\u52d5\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u663c\u9593\u306b\u6728\u6750\u3084\u77f3\u306a\u3069\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u307e\u3059\u3002STEP2\uff1a\u58c1\u3068\u30c9\u30a2\u306e\u3042\u308b\u5b89\u5168\u306a\u57fa\u5730\u3092\u5efa\u8a2d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30013x3\u306e\u6728\u88fd\u306e\u58c1\u306b1\u3064\u306e\u5165\u308a\u53e3\u304c\u3042\u308b\u306e\u304c\u826f\u3044\u30b9\u30bf\u30fc\u30c8\u3067\u3059\u3002STEP3\uff1a\u6728\u88fd\u69cd\u306a\u3069\u306e\u6b66\u5668\u3092\u30af\u30e9\u30d5\u30c8\u3057\u3066\u81ea\u5206\u81ea\u8eab\u3092\u5b88\u308a\u307e\u3059\u3002\u591c\u306b\u306a\u308b\u3068\u3001\u57fa\u5730\u306e\u4e2d\u306b\u3044\u3066\u3001\u6b66\u5668\u3092\u4f7f\u3063\u3066\u30be\u30f3\u30d3\u3092\u6483\u9000\u3057\u307e\u3059\u3002\u591c\u306b\u306a\u308b\u3068\u30be\u30f3\u30d3\u306f\u3088\u308a\u653b\u6483\u7684\u304b\u3064\u591a\u6570\u306b\u306a\u308b\u306e\u3067\u3001\u5916\u306b\u51fa\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u9032\u6357\u306b\u5408\u308f\u305b\u3066\u3001\u57fa\u5730\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3068\u3088\u308a\u826f\u3044\u6b66\u5668\u306e\u30af\u30e9\u30d5\u30c8\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Zombs.io\u3067\u6700\u3082\u91cd\u8981\u306a\u8cc7\u6e90\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u53ce\u96c6\u3057\u307e\u3059\u304b\uff1f", "answer": "Zombs.io\u3067\u6700\u3082\u91cd\u8981\u306a\u8cc7\u6e90\u306f\u6728\u6750\u3001\u77f3\u3001\u91d1\u3067\u3059\u3002\u6728\u6750\u306f\u3001\u58c1\u306e\u5efa\u8a2d\u3084\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u306e\u4f5c\u6210\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u6728\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u6728\u6750\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u77f3\u306f\u3001\u3088\u308a\u5f37\u529b\u306a\u30c4\u30fc\u30eb\u306e\u4f5c\u6210\u3084\u57fa\u5730\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u5ca9\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u53ce\u96c6\u3067\u304d\u307e\u3059\u3002\u91d1\u306f\u3001\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u3084\u53d6\u5f15\u306b\u4f7f\u7528\u3055\u308c\u308b\u5e0c\u5c11\u306a\u8cc7\u6e90\u3067\u3059\u3002\u91d1\u9271\u8108\u3092\u63a1\u6398\u3059\u308b\u304b\u3001\u7279\u5b9a\u306e\u30be\u30f3\u30d3\u3092\u5012\u3059\u3053\u3068\u3067\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306e\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u5b89\u5168\u306a\u57fa\u5730\u3092\u5efa\u8a2d\u3057\u3001\u65a7\u3084\u30d4\u30c3\u30b1\u30eb\u306a\u3069\u306e\u5fc5\u9808\u30c4\u30fc\u30eb\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u305f\u3081\u306b\u3001\u6728\u6750\u3068\u77f3\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Zombs.io\u3067\u9632\u5fa1\u529b\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u57fa\u5730\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Zombs.io\u3067\u57fa\u5730\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u58c1\u3001\u30c9\u30a2\u3001\u30c8\u30e9\u30c3\u30d7\u306e\u6226\u7565\u7684\u306a\u914d\u7f6e\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u5c0f\u3055\u306a\u56f2\u307e\u308c\u305f\u30a8\u30ea\u30a2\u30921\u3064\u306e\u5165\u308a\u53e3\u3067\u59cb\u3081\u307e\u3059\u3002STEP2\uff1a\u8907\u6570\u306e\u9632\u885b\u7dda\u3092\u5f62\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u57fa\u5730\u306e\u5468\u56f2\u306b\u58c1\u3092\u5c64\u72b6\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5916\u5074\u306e\u58c1\u30925x5\u3001\u5185\u50
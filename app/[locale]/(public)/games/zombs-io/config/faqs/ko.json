[{"question": "\ucd08\ubcf4\uc790\uac00 Zombs.io\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "Zombs.io\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uac8c\uc784 \uc6f9\uc0ac\uc774\ud2b8\ub85c \uc774\ub3d9\ud558\uc5ec '\ud50c\ub808\uc774'\ub97c \ud074\ub9ad\ud569\ub2c8\ub2e4. \ub9f5\uc758 \uc784\uc758 \uc704\uce58\uc5d0 \uc0dd\uc131\ub429\ub2c8\ub2e4. \ucc98\uc74c \ubaa9\ud45c\ub294 \ub098\ubb34\uc640 \ubc14\uc704\ub97c \ud074\ub9ad\ud558\uc5ec \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. '\uac74\uc124' \uba54\ub274\ub97c \uc120\ud0dd\ud558\uace0 \ubcbd\uacfc \ubb38\uc744 \ubc30\uce58\ud558\uc5ec \uae30\uc9c0\ub97c \uac74\uc124\ud558\ub294 \ub370 \uc774\ub7ec\ud55c \uc790\uc6d0\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc880\ube44\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \uc791\uc740 \ub098\ubb34 \ubcbd\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694. \uc790\uc6d0\uc744 \ub354 \ube60\ub974\uac8c \ubaa8\uc73c\uae30 \uc704\ud574 \ub3c4\ub07c\uc640 \uace1\uad2d\uc774\uc640 \uac19\uc740 \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. \ucd08\ubcf4\uc790\ub85c\uc11c \ubc24\uc774 \ub418\uae30 \uc804\uc5d0 \uc548\uc804\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud558\uace0 \ud544\uc218 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ubc24\uc774 \ub418\uba74 \uc880\ube44\uac00 \ub354 \uacf5\uaca9\uc801\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."}, {"question": "Zombs.io\uc5d0\uc11c \uccab \ubc88\uc9f8 \ubc24\uc744 \uc0b4\uc544\ub0a8\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Zombs.io\uc5d0\uc11c \uccab \ubc88\uc9f8 \ubc24\uc744 \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ub0ae \ub3d9\uc548 \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: \ubcbd\uacfc \ubb38\uc73c\ub85c \uc548\uc804\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3x3 \ub098\ubb34 \ubcbd\uc5d0 \ub2e8 \ud558\ub098\uc758 \ucd9c\uc785\uad6c\uac00 \uc788\ub294 \uac83\uc774 \uc88b\uc740 \uc2dc\uc791\uc785\ub2c8\ub2e4. STEP3: \ubaa9\uc7ac \ucc3d\uc744 \ub9cc\ub4e4\uc5b4 \uc790\uc2e0\uc744 \ubc29\uc5b4\ud569\ub2c8\ub2e4. \ubc24\uc5d0\ub294 \uae30\uc9c0 \uc548\uc5d0 \uba38\ubb3c\ub7ec \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc880\ube44\ub97c \ub9c9\uc544\ub0b4\uc138\uc694. \ubc24\uc5d0\ub294 \uc880\ube44\uac00 \ub354 \uacf5\uaca9\uc801\uc774\uace0 \ub9ce\uae30 \ub54c\ubb38\uc5d0 \ubc16\uc73c\ub85c \ub098\uac00\uc9c0 \ub9c8\uc138\uc694. \uc9c4\ud589\ud558\uba74\uc11c \uae30\uc9c0\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uace0 \ub354 \ub098\uc740 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \uc0bc\uc73c\uc138\uc694."}, {"question": "Zombs.io\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uc790\uc6d0\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc218\uc9d1\ud574\uc57c \ud558\ub098\uc694?", "answer": "Zombs.io\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uc790\uc6d0\uc740 \ub098\ubb34, \ub3cc, \uae08\uc785\ub2c8\ub2e4. \ub098\ubb34\ub294 \ubcbd\uc744 \uac74\uc124\ud558\uace0 \uae30\ubcf8 \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub098\ubb34\ub294 \ub098\ubb34\ub97c \ud074\ub9ad\ud558\uc5ec \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3cc\uc740 \ub354 \uac15\ub825\ud55c \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\uace0 \uae30\uc9c0\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ubc14\uc704\ub97c \ud074\ub9ad\ud558\uc5ec \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae08\uc740 \uace0\uae09 \uc81c\uc791 \ubc0f \uac70\ub798\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ud76c\uadc0 \uc790\uc6d0\uc785\ub2c8\ub2e4. \uae08\uad11\uc11d\uc744 \ucc44\uad74\ud558\uac70\ub098 \ud2b9\uc815 \uc880\ube44\ub97c \ucc98\uce58\ud558\uc5ec \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \ucd08\ubc18\uc5d0\ub294 \uc548\uc804\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud558\uace0 \ub3c4\ub07c\uc640 \uace1\uad2d\uc774\uc640 \uac19\uc740 \ud544\uc218 \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\uae30 \uc704\ud574 \ub098\ubb34\uc640 \ub3cc\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694."}, {"question": "Zombs.io\uc5d0\uc11c \ubc29\uc5b4\ub825\uc744 \ub192\uc774\uae30 \uc704\ud574 \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Zombs.io\uc5d0\uc11c \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \ubcbd, \ubb38 \ubc0f \ud568\uc815\uc758 \uc804\ub7b5\uc801 \ubc30\uce58\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. STEP1: \uc791\uace0 \ud3d0\uc1c4\ub41c \uacf5\uac04\uc5d0 \ub2e8 \ud558\ub098\uc758 \ucd9c\uc785\uad6c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. STEP2: \uc5ec\ub7ec \ubc29\uc5b4\uc120\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \ubcbd\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5x5 \ubc14\uae65 \ubcbd\uc5d0 3x3 \uc548\ucabd \ubcbd\uc744 \ucd94\uac00\ud558\uba74 \ub354 \ub098\uc740 \ubcf4\ud638\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. STEP3: \uc880\ube44\ub97c \uc9c0\uc5f0\uc2dc\ud0a4\uae30 \uc704\ud574 \ucd9c\uc785\uad6c \uadfc\ucc98\uc5d0 \ubabb \uac19\uc740 \ud568\uc815\uc744 \ubc30\uce58\ud569\ub2c8\ub2e4. \ub610\ud55c \uc81c\uc791\uc18c\uc640 \ucc3d\uace0\ub294 \uc548\ucabd \ubcbd \uc548\uc5d0 \ubcf4\uad00\ud558\uc5ec \ubcf4\ud638\ud558\uc2ed\uc2dc\uc624. \uc9c4\ud589\ud558\uba74\uc11c \ubcbd\uc744 \ub3cc\uc774\ub098 \uae08\uc18d\uacfc \uac19\uc740 \ub354 \uac15\ub825\ud55c \uc7ac\ub8cc\ub85c \uc815\uae30\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud569\ub2c8\ub2e4."}, {"question": "Zombs.io\uc758 \uace0\uae09 \uc81c\uc791 \uae30\uc220\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Zombs.io\uc758 \uace0\uae09 \uc81c\uc791\uc5d0\ub294 \uac15\ub825\ud55c \ubb34\uae30, \ub3c4\uad6c \ubc0f \uae30\uc9c0 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ub9cc\ub4dc\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1: \ucc44\uad74 \ub610\ub294 \uc880\ube44 \ucc98\uce58\ub97c \ud1b5\ud574 \uae08\uacfc \ubcf4\uc11d\uacfc \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: \uc81c\uc791 \uba54\ub274\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc790\uc6d0\uc744 \uae30\ubcf8 \uc7ac\ub8cc\uc640 \uacb0\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae08 \ub3c4\ub07c\ub97c \uc81c\uc791\ud558\ub824\uba74 \ub098\ubb34\uc640 \uae08\uc774 \ud544\uc694\ud558\uba70, \uc774\ub294 \uc218\uc9d1 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3: \ub2e4\ub978 \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ub808\uc2dc\ud53c\ub97c \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. \uace0\uae09 \uc81c\uc791\uc740 \ub354 \ub098\uc740 \ubc29\uc5b4\uc640 \uc790\uc6d0 \ud6a8\uc728\uc131\uc744 \uc81c\uacf5\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc744 \uc9c4\ud589\ud558\uba74\uc11c \ub3c4\uad6c\uc640 \ubb34\uae30\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc744 \ud56d\uc0c1 \uc6b0\uc120\uc21c\uc704\ub85c \uc0bc\uc73c\uc138\uc694."}, {"question": "\uc65c Zombs.io\uc5d0\uc11c \uac70\ub798\uac00 \uc911\uc694\ud558\uba70, \uc5b4\ub5bb\uac8c \uadf8 \uc774\uc810\uc744 \uadf9\ub300\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Zombs.io\uc5d0\uc11c \uac70\ub798\ub294 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc5bb\uace0 \uceec\ub809\uc158\uc744 \uc644\uc131\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \ub9f5\uc5d0\uc11c \uac70\ub798\uc18c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc5ec\ubd84\uc758 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc5ec \uae08\uacfc \ubcf4\uc11d\uacfc \uac19\uc740 \ud76c\uadc0\ud55c \ud488\ubaa9\uacfc \uad50\ud658\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 100\uac1c\uc758 \ub098\ubb34\ub97c 10\uac1c\uc758 \uae08\uacfc \uad50\ud658\ud558\uba74 \uace0\uae09 \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uac70\ub798\uac00 \ubc14\ub00c\ubbc0\ub85c \uac70\ub798\uc18c\ub97c \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud569\ub2c8\ub2e4. \ud48d\ubd80\ud558\uac8c \ubcf4\uc720\ud55c \uc790\uc6d0\uc744 \uc5bb\uae30 \uc5b4\ub824\uc6b4 \uc790\uc6d0\uacfc \uad50\ud658\ud558\uc5ec \ucd5c\ub300 \uc774\uc810\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc18d\ud654\ud558\uace0 \ub354 \uac15\ub825\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Zombs.io\uc758 \uc880\ube44 \uc0dd\uc131 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Zombs.io\uc758 \uc880\ube44 \uc0dd\uc131 \uba54\ucee4\ub2c8\uc998\uc740 \uc2dc\uac04\uacfc \ud50c\ub808\uc774\uc5b4 \ud65c\ub3d9\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub0ae\uc5d0\ub294 \uc880\ube44\uac00 \ub4dc\ubb3c\uac8c \uc0dd\uc131\ub418\uace0 \uc57d\ud569\ub2c8\ub2e4. \ubc24\uc5d0\ub294 \uc0dd\uc131 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\uace0 \uac15\ub825\ud55c \uc880\ube44\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub0ae\uc5d0\ub294 \uae30\ubcf8 \uc880\ube44\ub97c \ub9cc\ub0a0 \uc218 \uc788\uc9c0\ub9cc, \ubc24\uc5d0\ub294 \ube60\ub974\uac8c \uc774\ub3d9\ud558\uac70\ub098 \uc7a5\uac11\uc744 \ub080 \uc880\ube44\ub97c \ub9cc\ub0a0 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc880\ube44\ub294 \ud50c\ub808\uc774\uc5b4\uc640 \uadf8\ub4e4\uc758 \uae30\uc9c0 \uadfc\ucc98\uc5d0 \uc0dd\uc131\ub418\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uad00\ub9ac\ud558\ub824\uba74 \ud2b9\ud788 \ubc24\uc5d0 \uae30\uc9c0\uac00 \uc798 \ubc29\uc5b4\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uc790\uc6d0 \uc218\uc9d1 \ubc0f \uae30\uc9c0 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \uacc4\ud68d\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Zombs.io\uc758 \ub2e4\uc591\ud55c \uc880\ube44 \uc720\ud615\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Zombs.io\uc5d0\ub294 \uac01\uac01 \uace0\uc720\ud55c \ud589\ub3d9\uacfc \uac15\uc810\uc744 \uac00\uc9c4 \uc5ec\ub7ec \uc880\ube44 \uc720\ud615\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ubcf8 \uc880\ube44\ub294 \ub290\ub9ac\uace0 \uccb4\ub825\uc774 \ub0ae\uc544 \ucc98\ub9ac\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \ube60\ub978 \uc880\ube44\ub294 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\uace0 \uc81c\ub54c \ucc98\ub9ac\ud558\uc9c0 \uc54a\uc73c\uba74 \ub2f9\uc2e0\uc744 \uc555\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc7a5\uac11 \uc880\ube44\ub294 \uccb4\ub825\uc774 \ub192\uace0 \ub354 \uac15\ub825\ud55c \ubb34\uae30\ub85c \ucc98\uce58\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \uc880\ube44\uc5d0\ub294 \uae30\ubcf8 \ubaa9\uc7ac \ucc3d\uc774 \ucda9\ubd84\ud560 \uc218 \uc788\uc9c0\ub9cc \uc7a5\uac11 \uc880\ube44\uc5d0\ub294 \ub3cc\uc774\ub098 \uae08 \ucc3d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \uac01 \uc720\ud615\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ucc98\ub9ac\ud558\uae30 \uc704\ud55c \uc801\uc808\ud55c \ubc29\uc5b4\uc640 \ubb34\uae30\ub97c \uc900\ube44\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Zombs.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uac8c\uc784\uc758 \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Zombs.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \uba54\ub274\uc758 '\uc800\uc7a5' \ubc84\ud2bc\uc744 \ud074\ub9ad\ud569\ub2c8\ub2e4. STEP2: \uc0dd\uc131\ub41c \uc800\uc7a5 \ucf54\ub4dc\ub97c \ubcf5\uc0ac\ud569\ub2c8\ub2e4. STEP3: \uc0c8 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 '\ub85c\ub4dc'\ub97c \ud074\ub9ad\ud55c \ub2e4\uc74c \uc800\uc7a5 \ucf54\ub4dc\ub97c \ubd99\uc5ec\ub123\uc2b5\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\ub97c \ud1b5\ud574 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc9c4\ud589 \uc0c1\ud669\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud588\ub2e4\uac00 \ub098\uc911\uc5d0 \ud734\ub300\uc804\ud654\ub85c \uc804\ud658\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \uc5ec\ub7ec \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "Zombs.io\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Zombs.io\uc5d0\ub294 \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub9f5\uc758 \ub4dc\ubb38 \uc704\uce58\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 '\uace8\ub4e0 \ud2b8\ub9ac'\uc785\ub2c8\ub2e4. \ubca0\uba74 \ud070 \uc591\uc758 \uae08\uacfc \ub098\ubb34\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ube44\ubc00\uc740 \uac00\ub054 \ub098\ud0c0\ub098 \ubcf4\uc11d\uc774\ub098 \uace0\uae09 \ub3c4\uad6c\uc640 \uac19\uc740 \ud76c\uadc0\ud55c \ud488\ubaa9\uc744 \ud3ec\ud568\ud558\ub294 '\ubbf8\uc2a4\ud130\ub9ac \uc0c1\uc790'\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubbf8\uc2a4\ud130\ub9ac \uc0c1\uc790\ub97c \ucc3e\uc544 \uc5f4\uba74 \uae08 \ub3c4\ub07c\ub97c \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \uc790\uc6d0 \uc218\uc9d1\ub7c9\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9f5\uc744 \uba74\ubc00\ud788 \ud0d0\uc0c9\ud558\uace0 \uace0\uc720\ud55c \uc694\uc18c\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\uc5ec \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]